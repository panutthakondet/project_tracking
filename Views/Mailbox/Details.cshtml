@model ProjectTracking.Models.MailboxDetailsViewModel

@{
    ViewData["Title"] = "Mail Details";
}

@functions {
    string SenderName(ProjectTracking.Models.MailboxMessage message)
        => message.SenderEmployee?.EmpName ?? message.SenderUser?.Username ?? "ระบบ";
}

<style>
    .mail-detail { padding-top: 0; }
    .mail-hero {
        border-radius: 24px;
        padding: 28px 32px;
        margin-bottom: 20px;
        color: #fff;
        background: linear-gradient(135deg, #10233f 0%, #113c58 58%, #0f8f84 100%);
        box-shadow: 0 16px 34px rgba(15, 35, 64, .18);
        display:flex;
        justify-content:space-between;
        gap:18px;
        align-items:flex-start;
    }
    .mail-hero h1 { font-weight:1000; font-size:clamp(2rem, 3vw, 3rem); margin:6px 0 12px; overflow-wrap:anywhere; }
    .mail-eyebrow { color:#9ff4e6; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
    .mail-meta { color:rgba(255,255,255,.78); font-weight:850; display:flex; flex-wrap:wrap; gap:12px; }
    .mail-actions { display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end; }
    .mail-btn {
        min-height:46px;
        min-width:150px;
        border-radius:999px;
        border:1px solid #cbd8e8;
        padding:10px 18px;
        font-weight:1000;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        text-decoration:none;
        background:#fff;
        color:#10233f;
    }
    .mail-btn.primary { background:linear-gradient(135deg, #28d6c5, #108a7c); color:#fff; border-color:transparent; }
    .mail-btn.ghost { background:rgba(255,255,255,.08); color:#fff; border-color:rgba(255,255,255,.42); }
    .mail-panel {
        background:#fff;
        border:1px solid #d9e4f2;
        border-radius:22px;
        padding:24px;
        box-shadow:0 14px 34px rgba(16,35,63,.08);
        margin-bottom:18px;
    }
    .mail-panel h3 { color:#10233f; font-weight:1000; margin-bottom:14px; }
    .mail-body {
        min-height:120px;
        white-space:pre-wrap;
        color:#10233f;
        font-weight:850;
        line-height:1.55;
        background:#f8fbff;
        border:1px solid #d9e4f2;
        border-radius:18px;
        padding:18px;
    }
    .report-box {
        border-left:5px solid #25c6b8;
        background:#fbfffe;
        border-radius:18px;
        padding:18px;
        color:#10233f;
        font-weight:900;
    }
    .attachment-list { display:grid; gap:10px; margin-top:12px; }
    .attachment-row {
        border:1px solid #d9e4f2;
        border-radius:16px;
        padding:12px 14px;
        display:flex;
        justify-content:space-between;
        gap:12px;
        align-items:center;
        color:#10233f;
        font-weight:900;
    }
    .forward-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:10px; }
    .recipient-option {
        display:flex;
        gap:12px;
        border:1px solid #d9e4f2;
        border-radius:16px;
        padding:12px 14px;
        background:#fbfdff;
        cursor:pointer;
    }
    .recipient-name { color:#10233f; font-weight:1000; }
    .recipient-position { color:#64748b; font-weight:800; font-size:.86rem; display:block; }
    .forward-textarea {
        width:100%;
        min-height:110px;
        border:1px solid #cbd8e8;
        border-radius:16px;
        padding:13px 16px;
        color:#10233f;
        font-weight:800;
        margin:12px 0;
    }
    @@media (max-width:780px) {
        .mail-hero { display:grid; }
        .mail-actions, .mail-btn { width:100%; }
    }
</style>

<div class="container mail-detail">
    <section class="mail-hero">
        <div>
            <div class="mail-eyebrow">@Model.Message.MessageType</div>
            <h1>@Model.Message.Subject</h1>
            <div class="mail-meta">
                <span>จาก: @SenderName(Model.Message)</span>
                <span>@Model.Message.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>
        <div class="mail-actions">
            <a class="mail-btn ghost" asp-action="Index">กล่องจดหมาย</a>
            <a class="mail-btn ghost" asp-action="Sent">จดหมายที่ส่ง</a>
        </div>
    </section>

    <section class="mail-panel">
        <h3>ข้อความ</h3>
        <div class="mail-body">@(string.IsNullOrWhiteSpace(Model.Message.Body) ? "-" : Model.Message.Body)</div>
    </section>

    @if (Model.Report != null)
    {
        <section class="mail-panel">
            <h3>รายงานที่แนบมากับจดหมาย</h3>
            <div class="report-box">
                <div>@Model.Report.Subject</div>
                <div class="text-muted mt-2">@Model.Report.WeekStart?.ToString("dd/MM/yyyy") - @Model.Report.WeekEnd?.ToString("dd/MM/yyyy")</div>
                <div class="mt-3">
                    <a class="mail-btn primary" asp-controller="WeeklyReports" asp-action="Details" asp-route-id="@Model.Report.ReportId">เปิดรายงาน</a>
                </div>
            </div>

            <div class="attachment-list">
                @if (!Model.Attachments.Any())
                {
                    <div class="text-muted fw-bold mt-2">ไม่มีไฟล์แนบ</div>
                }
                else
                {
                    @foreach (var attachment in Model.Attachments)
                    {
                        <div class="attachment-row">
                            <span>@attachment.FileName</span>
                            <a class="mail-btn primary" style="min-width:120px;" asp-controller="WeeklyReports" asp-action="DownloadAttachment" asp-route-id="@attachment.AttachmentId">ดาวน์โหลด</a>
                        </div>
                    }
                }
            </div>
        </section>

        @if (Model.CanForward)
        {
            <section class="mail-panel">
                <h3>ส่งต่อรายงาน</h3>
                <form asp-controller="WeeklyReports" asp-action="Forward" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="reportId" value="@Model.Report.ReportId" />
                    <div class="forward-grid">
                        @foreach (var user in Model.Users)
                        {
                            <label class="recipient-option">
                                <input type="checkbox" name="selectedUserIds" value="@user.UserId" />
                                <span>
                                    <span class="recipient-name">@user.DisplayName</span>
                                    <span class="recipient-position">@user.Position (@user.Username)</span>
                                </span>
                            </label>
                        }
                    </div>
                    <textarea class="forward-textarea" name="messageBody" placeholder="ข้อความถึงผู้รับ"></textarea>
                    <div class="mail-actions">
                        <button type="submit" class="mail-btn primary">ส่งต่อรายงาน</button>
                    </div>
                </form>
            </section>
        }
    }
</div>

@model IEnumerable<ProjectTracking.Models.TestScenario>

@using Microsoft.AspNetCore.Http
@using ProjectTracking.Helpers

@{
    string StatusTextClass(string status)
    {
        return TestScenarioDisplay.NormalizeStatus(status) switch
        {
            "PASSED" => "is-success",
            "FAILED" => "is-danger",
            "READY"  => "is-primary",
            _        => "is-muted"
        };
    }

    var list = Model?.ToList() ?? new List<ProjectTracking.Models.TestScenario>();
}

@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

<style>
    /* Make table wide enough to scroll when needed */
    .scenario-table {
        min-width: 1600px;
        table-layout: fixed;
        border-collapse: separate;
        border-spacing: 0;
        --row-col: 60px;
        --code-col: 110px;
        --title-col: 260px;
    }

    /* Sticky first columns */
    .sticky-col-0 {
        position: sticky;
        left: 0;
        z-index: 5;
        background: #fff;
        border-right: 1px solid #dee2e6;
    }
    .sticky-col {
        position: sticky;
        left: calc(var(--row-col) + 1px);
        z-index: 5;
        background: #fff;
        border-right: 1px solid #dee2e6;
    }
    .sticky-col-2 {
        position: sticky;
        left: calc(var(--row-col) + var(--code-col) + 2px);
        z-index: 5;
        background: #fff;
        border-right: 1px solid #dee2e6;
        box-shadow: 2px 0 5px -2px rgba(0,0,0,0.12);
    }

    th.sticky-col-0, td.sticky-col-0 {
        width: var(--row-col);
        min-width: var(--row-col);
        max-width: var(--row-col);
    }
    th.sticky-col, td.sticky-col {
        width: var(--code-col);
        min-width: var(--code-col);
        max-width: var(--code-col);
    }
    th.sticky-col-2, td.sticky-col-2 {
        width: var(--title-col);
        min-width: var(--title-col);
        max-width: var(--title-col);
    }

    /* Keep header above body */
    thead th { position: sticky; top: 0; z-index: 7; background: #f8f9fa; }

    /* Group header row (normal, not sticky) */
    .group-header-row td {
        background: #eef3ff;
        font-weight: 600;
        border-bottom: 2px solid #cfe0ff;
    }

    /* Ensure sticky body cells stay above striped rows */
    tbody td.sticky-col-0, tbody td.sticky-col, tbody td.sticky-col-2 { z-index: 3; }

    /* Improve readability for long text */
    .multiline-cell { white-space: pre-line; vertical-align: top; }

    .nowrap-cell { white-space: nowrap; }

    /* Header area */
    .page-header-card { border: 1px solid #e9ecef; border-radius: 10px; background: #fff; }
    .page-header-card .card-body { padding: 16px; }
    .toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }

    /* Colored table header */
    .scenario-table thead th {
        background-color: #0d6efd !important;
        color: #ffffff;
        text-align: center;
        vertical-align: middle;
    }

    /* Center specific columns */
    .text-center-col {
        text-align: center;
        vertical-align: middle;
    }

    .drag-handle {
        font-size: 16px;
    }

    /* Hover highlight for rows (safe add, no impact existing layout) */
    .scenario-table tbody tr:hover td {
        background-color: #fff8cc !important;
        transition: background-color 0.2s ease-in-out;
    }

    /* Keep group header visually distinct */
    .group-header-row:hover td {
        background-color: #eef3ff !important;
    }

    /* Sticky columns highlight stronger */
    tbody tr:hover td.sticky-col-0,
    tbody tr:hover td.sticky-col,
    tbody tr:hover td.sticky-col-2 {
        background-color: #ffe69c !important;
    }

    .scenario-card-groups {
        display: grid;
        gap: 18px;
    }

    .scenario-group-card {
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 22px;
        box-shadow: 0 12px 28px rgba(15, 35, 64, .08);
        overflow: hidden;
    }

    .scenario-group-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 18px;
        background: linear-gradient(180deg, #f8fafc, #eef6fb);
        border-bottom: 1px solid #d8e3ef;
    }

    .scenario-group-title {
        color: #10233f;
        font-size: 1.02rem;
        font-weight: 900;
        margin: 0;
    }

    .scenario-group-count {
        color: #0f766e;
        background: rgba(20, 184, 166, .14);
        border-radius: 999px;
        padding: 4px 10px;
        font-weight: 900;
        white-space: nowrap;
    }

    .scenario-card-list {
        display: grid;
        gap: 12px;
        padding: 16px;
    }

    .scenario-card {
        background: #fff;
        border: 1px solid #dbeafe;
        border-left: 5px solid #14b8a6;
        border-radius: 18px;
        padding: 16px;
        box-shadow: 0 8px 22px rgba(15, 35, 64, .06);
    }

    .scenario-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .scenario-card-title {
        min-width: 0;
    }

    .scenario-code {
        color: #0f766e;
        font-size: .82rem;
        font-weight: 900;
        letter-spacing: .02em;
    }

    .scenario-title {
        color: #10233f;
        font-size: 1.05rem;
        font-weight: 900;
        line-height: 1.35;
    }

    .scenario-drag-handle {
        flex: 0 0 auto;
        width: 34px;
        height: 34px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #062b2f;
        background: rgba(20, 184, 166, .18);
        cursor: grab;
        font-weight: 900;
    }

    .scenario-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
    }

    .scenario-pill {
        color: #334155;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: .84rem;
        font-weight: 800;
    }

    .scenario-status-text,
    .scenario-status-summary {
        display: inline;
        min-width: 0;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        font-weight: 900;
        line-height: 1.35;
        white-space: normal;
    }

    .scenario-status-text {
        flex: 0 0 auto;
        font-size: .96rem;
        text-align: right;
    }

    .scenario-status-summary {
        font-size: .92rem;
    }

    .scenario-status-text.is-success,
    .scenario-status-summary.is-success {
        color: #16a34a;
    }

    .scenario-status-text.is-danger,
    .scenario-status-summary.is-danger {
        color: #ef4444;
    }

    .scenario-status-text.is-primary,
    .scenario-status-summary.is-primary {
        color: #2563eb;
    }

    .scenario-status-text.is-muted,
    .scenario-status-summary.is-muted {
        color: #64748b;
    }

    .scenario-detail-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .scenario-detail-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 12px;
        min-width: 0;
    }

    .scenario-detail-box--precondition {
        background: linear-gradient(180deg, rgba(20, 184, 166, .13), rgba(240, 253, 250, .92));
        border-color: rgba(20, 184, 166, .28);
    }

    .scenario-detail-box--steps {
        background: linear-gradient(180deg, rgba(37, 99, 235, .11), rgba(239, 246, 255, .92));
        border-color: rgba(37, 99, 235, .24);
    }

    .scenario-detail-box--expected {
        background: linear-gradient(180deg, rgba(245, 158, 11, .13), rgba(255, 251, 235, .92));
        border-color: rgba(245, 158, 11, .28);
    }

    .scenario-detail-box--precondition .scenario-detail-label {
        color: #0f766e;
    }

    .scenario-detail-box--steps .scenario-detail-label {
        color: #2563eb;
    }

    .scenario-detail-box--expected .scenario-detail-label {
        color: #b45309;
    }

    .scenario-detail-label {
        color: #64748b;
        font-size: .82rem;
        font-weight: 900;
        margin-bottom: 6px;
    }

    .scenario-detail-text {
        color: #10233f;
        font-weight: 700;
        line-height: 1.45;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .scenario-card-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
        padding-top: 12px;
        border-top: 1px solid #e2e8f0;
    }

    .scenario-group-picker {
        padding: 14px;
        border: 1px solid #d8e2ef;
        border-radius: 16px;
        background: #f8fafc;
    }

    .scenario-group-picker__controls {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 10px;
        align-items: stretch;
    }

    .scenario-group-picker__controls .btn {
        min-width: 92px;
        font-weight: 900;
    }

    .scenario-selected-groups {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        min-height: 44px;
        margin-top: 12px;
    }

    .scenario-selected-group {
        max-width: 100%;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px 8px 12px;
        border: 1px solid rgba(20, 184, 166, .28);
        border-radius: 999px;
        color: #0f766e;
        background: rgba(20, 184, 166, .12);
        font-size: .94rem;
        font-weight: 650;
        line-height: 1.25;
        letter-spacing: 0;
        text-shadow: none;
        -webkit-font-smoothing: antialiased;
    }

    .scenario-selected-group > span {
        min-width: 0;
        overflow-wrap: anywhere;
        font-weight: 650;
        text-shadow: none;
    }

    .scenario-group-remove {
        flex: 0 0 auto;
        width: 24px;
        height: 24px;
        border: 1px solid #ef4444;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #ef4444;
        background: #fff;
        font-size: 18px;
        font-weight: 900;
        line-height: 1;
    }

    .scenario-group-remove:hover,
    .scenario-group-remove:focus {
        color: #be123c;
        border-color: #be123c;
        background: #fff5f5;
    }

    .scenario-group-empty {
        width: 100%;
        min-height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        color: #64748b;
        background: #fff;
        font-weight: 800;
    }

    @@media (max-width: 992px) {
        .scenario-detail-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .scenario-card-head,
        .scenario-group-header {
            flex-direction: column;
            align-items: stretch;
        }

        .scenario-card-actions {
            justify-content: stretch;
        }

        .scenario-group-picker__controls {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">Test Scenarios</h2>
        <p class="index-subtitle">จัดการ Scenario ทดสอบแยกตามโครงการและกลุ่ม Template</p>
    </div>
</div>

<div class="page-header-card mb-4">
    <div class="card-body">
        <form id="scenarioFilterForm" method="get">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">📁 โครงการ</label>
                    @{
                        int? selProject = null;
                        if (ViewBag.SelectedProject != null)
                        {
                            selProject = Convert.ToInt32(ViewBag.SelectedProject);
                        }
                    }
                    <select name="projectId"
                            class="form-select"
                            onchange="this.form.submit()">
                        <option value="">-- เลือกโครงการ --</option>
                        @if (ViewBag.Projects != null)
                        {
                            foreach (var p in ViewBag.Projects)
                            {
                                <option value="@p.ProjectId"
                                        selected="@(selProject == p.ProjectId ? "selected" : null)">
                                    @p.ProjectDisplayName
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">Select Group</label>
                    @{
                        var selectedGroupIds = ViewBag.SelectedGroupIds as IEnumerable<int> ?? Enumerable.Empty<int>();
                        var selectedGroupIdSet = selectedGroupIds.ToHashSet();
                    }
                    <div class="scenario-group-picker" data-group-picker>
                        <div class="scenario-group-picker__controls">
                            <select class="form-select" data-group-select>
                                <option value="">-- แสดงทุก Group --</option>
                                @if (ViewBag.Groups != null)
                                {
                                    foreach (var g in ViewBag.Groups)
                                    {
                                        <option value="@g.group_id"
                                                data-label="@g.group_name"
                                                data-selected="@(selectedGroupIdSet.Contains(g.group_id) ? "true" : "false")">
                                            @g.group_name
                                        </option>
                                    }
                                }
                            </select>
                            <button type="button" class="btn btn-outline-primary btn-pill" data-group-add>
                                เพิ่ม
                            </button>
                        </div>
                        <div class="scenario-selected-groups" data-group-list></div>
                        <div data-group-filter-inputs></div>
                        <div data-group-import-inputs></div>
                    </div>
                    <small class="form-hint">ไม่เลือก Group = แสดงทั้งหมด เลือกทีละ Group กดเพิ่มเพื่อกรอง/Import/Preview PDF</small>
                </div>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.SelectedProject != null)
{
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="toolbar">

            @if (CanMenu("TestScenarios.Create"))
            {
                <a asp-action="Create"
                   asp-route-projectId="@ViewBag.SelectedProject"
                   asp-route-groupId="@ViewBag.SelectedGroup"
                   class="btn btn-success"
                   title="เพิ่ม Test Scenario เฉพาะโครงการนี้">
                    Create Scenario
                </a>
            }
            else
            {
                <button class="btn btn-success" disabled title="ไม่มีสิทธิ์ Create">
                    Create Scenario
                </button>
            }

            @if (CanMenu("TestScenarios.Import"))
            {
                <form id="importTemplatesForm"
                      asp-action="ImportTemplates"
                      method="post"
                      style="display:inline;"
                      onsubmit="return importSelectedGroups();">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@ViewBag.SelectedProject" />
                    <button type="submit"
                            class="btn btn-primary"
                            title="Import Template">
                        Import Templates
                    </button>
                </form>
            }
            else
            {
                <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์ Import">
                    Import Templates
                </button>
            }

            @if (CanMenu("TestScenarios.DeleteAll"))
            {
                <form asp-action="DeleteAll"
                      asp-route-projectId="@ViewBag.SelectedProject"
                      method="post"
                      style="display:inline;"
                      onsubmit="return confirm('ลบ Test Scenario ทั้งหมดของโครงการนี้? การกระทำนี้ไม่สามารถย้อนกลับได้');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger" title="ลบทั้งหมด">Delete All</button>
                </form>
            }
            else
            {
                <button class="btn btn-danger" disabled title="ไม่มีสิทธิ์ลบทั้งหมด">
                    Delete All
                </button>
            }

            @if (CanMenu("TestScenarios.Export"))
            {
                <button type="button"
                        class="btn btn-outline-primary"
                        title="Preview PDF"
                        onclick="previewPdf()">
                    👁 Preview PDF
                </button>
            }
            else
            {
                <button class="btn btn-outline-secondary" disabled title="ไม่มีสิทธิ์ Preview">
                    👁 Preview PDF
                </button>
            }

        </div>

        <div class="d-flex flex-wrap gap-3">
            <span class="scenario-status-summary is-muted">ทั้งหมด: @list.Count</span>
            <span class="scenario-status-summary is-success">@TestScenarioDisplay.StatusText("PASSED"): @list.Count(x => x.status == "PASSED")</span>
            <span class="scenario-status-summary is-danger">@TestScenarioDisplay.StatusText("FAILED"): @list.Count(x => x.status == "FAILED")</span>
            <span class="scenario-status-summary is-primary">@TestScenarioDisplay.StatusText("READY"): @list.Count(x => TestScenarioDisplay.NormalizeStatus(x.status) == "READY")</span>
        </div>
    </div>

    <div class="scenario-card-groups">
        @{ var rowNo = 1; }
        @foreach (var grp in list.GroupBy(x => x.Group?.group_name ?? "No Group"))
        {
            <section class="scenario-group-card">
                <div class="scenario-group-header">
                    <h3 class="scenario-group-title">Group : @grp.Key</h3>
                    <span class="scenario-group-count">@grp.Count() รายการ</span>
                </div>

                <div class="scenario-card-list" data-group="@grp.Key">
                    @foreach (var item in grp)
                    {
                        <article class="scenario-card" data-id="@item.scenario_id" data-group="@grp.Key">
                            <div class="scenario-card-head">
                                <div class="d-flex align-items-start gap-2">
                                    @if (CanMenu("TestScenarios.Sort"))
                                    {
                                        <span class="scenario-drag-handle" title="ลากเพื่อสลับลำดับ">☰</span>
                                    }
                                    <div class="scenario-card-title">
                                        <div class="scenario-code">#@rowNo · @item.scenario_code</div>
                                        <div class="scenario-title">@item.title</div>
                                    </div>
                                </div>
                                <span class="scenario-status-text @StatusTextClass(item.status)">@TestScenarioDisplay.StatusText(item.status)</span>
                            </div>

                            <div class="scenario-meta">
                                <span class="scenario-pill">Priority: @item.priority</span>
                                <span class="scenario-pill">Created: @item.created_at.ToString("dd/MM/yyyy HH:mm")</span>
                                <span class="scenario-pill">Updated: @(item.updated_at?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
                            </div>

                            <div class="scenario-detail-grid">
                                <div class="scenario-detail-box scenario-detail-box--precondition">
                                    <div class="scenario-detail-label">Precondition</div>
                                    <div class="scenario-detail-text">@(string.IsNullOrWhiteSpace(item.precondition) ? "-" : item.precondition)</div>
                                </div>
                                <div class="scenario-detail-box scenario-detail-box--steps">
                                    <div class="scenario-detail-label">Steps</div>
                                    <div class="scenario-detail-text">@item.steps</div>
                                </div>
                                <div class="scenario-detail-box scenario-detail-box--expected">
                                    <div class="scenario-detail-label">Expected Result</div>
                                    <div class="scenario-detail-text">@item.expected_result</div>
                                </div>
                            </div>

                            <div class="scenario-card-actions">
                                @if (CanMenu("TestScenarios.Edit"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.scenario_id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="แก้ไข">
                                        Edit
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                        Edit
                                    </button>
                                }

                                @if (CanMenu("TestScenarios.Delete"))
                                {
                                    <form asp-action="Delete"
                                          asp-route-id="@item.scenario_id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this scenario?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="ลบ">
                                            Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                        Delete
                                    </button>
                                }
                            </div>
                        </article>

                        rowNo++;
                    }
                </div>
            </section>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        กรุณาเลือก Group และโครงการก่อน เพื่อดู/เพิ่ม Test Scenario
    </div>
}
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (!@CanMenu("TestScenarios.Sort").ToString().ToLower()) return;

        document.querySelectorAll(".scenario-card-list").forEach(function (listEl) {
            new Sortable(listEl, {
                animation: 150,
                handle: ".scenario-drag-handle",
                ghostClass: "bg-light",

                onEnd: function () {
                    const order = [];

                    listEl.querySelectorAll(".scenario-card[data-id]").forEach((card, index) => {
                        order.push({
                            id: card.dataset.id,
                            sort: index + 1
                        });
                    });

                    fetch("/TestScenarios/UpdateSort", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(order)
                    });
                }
            });
        });
    });

    const selectedGroups = new Map();

    function initScenarioGroupPicker() {
        const picker = document.querySelector('[data-group-picker]');
        if (!picker) return;

        const select = picker.querySelector('[data-group-select]');
        const addButton = picker.querySelector('[data-group-add]');
        const list = picker.querySelector('[data-group-list]');
        const filterForm = document.getElementById('scenarioFilterForm');
        const filterInputs = picker.querySelector('[data-group-filter-inputs]');
        const importInputs = picker.querySelector('[data-group-import-inputs]');

        function findOption(value) {
            return Array.from(select.options).find(option => option.value === value);
        }

        function syncInputs() {
            filterInputs.innerHTML = '';
            importInputs.innerHTML = '';
            selectedGroups.forEach((label, id) => {
                const filterInput = document.createElement('input');
                filterInput.type = 'hidden';
                filterInput.name = 'groupIds';
                filterInput.value = id;
                filterInputs.appendChild(filterInput);

                const importInput = document.createElement('input');
                importInput.type = 'hidden';
                importInput.name = 'groupIds';
                importInput.value = id;
                importInput.setAttribute('form', 'importTemplatesForm');
                importInputs.appendChild(importInput);
            });
        }

        function applyGroupFilter() {
            syncInputs();
            filterForm?.submit();
        }

        function render() {
            list.innerHTML = '';

            if (selectedGroups.size === 0) {
                const empty = document.createElement('div');
                empty.className = 'scenario-group-empty';
                empty.textContent = 'แสดงทุก Group';
                list.appendChild(empty);
                syncInputs();
                return;
            }

            selectedGroups.forEach((label, id) => {
                const chip = document.createElement('span');
                chip.className = 'scenario-selected-group';

                const text = document.createElement('span');
                text.textContent = label;

                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'scenario-group-remove';
                remove.setAttribute('aria-label', `ลบ ${label}`);
                remove.dataset.removeGroup = id;
                remove.textContent = '×';

                chip.appendChild(text);
                chip.appendChild(remove);
                list.appendChild(chip);
            });

            syncInputs();
        }

        function clearGroups() {
            selectedGroups.clear();
            Array.from(select.options).forEach(option => option.disabled = false);
            select.value = '';
            render();
        }

        function addGroup(value, shouldSubmit = false) {
            if (!value) {
                clearGroups();
                if (shouldSubmit) applyGroupFilter();
                return;
            }

            if (selectedGroups.has(value)) return;

            const option = findOption(value);
            if (!option) return;

            const label = option.dataset.label || option.textContent.trim();
            selectedGroups.set(value, label);
            option.disabled = true;
            select.value = '';
            render();

            if (shouldSubmit) applyGroupFilter();
        }

        addButton?.addEventListener('click', function () {
            addGroup(select.value, true);
        });

        select?.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                addGroup(select.value, true);
            }
        });

        list?.addEventListener('click', function (event) {
            const button = event.target.closest('[data-remove-group]');
            if (!button) return;

            const id = button.dataset.removeGroup;
            selectedGroups.delete(id);

            const option = findOption(id);
            if (option) option.disabled = false;

            render();
            applyGroupFilter();
        });

        Array.from(select.options)
            .filter(option => option.dataset.selected === 'true')
            .forEach(option => addGroup(option.value));

        render();
    }

    function importSelectedGroups() {
        if (selectedGroups.size === 0) {
            alert('กรุณาเลือก Group อย่างน้อย 1 รายการก่อน Import');
            return false;
        }

        return confirm(`Import Templates จาก ${selectedGroups.size} Group ที่เลือกเข้าโครงการนี้?`);
    }

    function previewPdf() {
        const projectId = '@ViewBag.SelectedProject';

        if (!projectId) {
            alert('กรุณาเลือก Project ก่อน');
            return;
        }

        let url = `/TestScenarios/ExportPdf?projectId=${projectId}`;

        selectedGroups.forEach((label, id) => {
                url += `&groupIds=${id}`;
            });

        window.open(url, '_blank');
    }

    initScenarioGroupPicker();
</script>

@model ProjectTracking.Models.TestScenario

@using ProjectTracking.Helpers

@{
    ViewData["Title"] = "ปรับสถานะการทดสอบ";
    var project = ViewBag.Project as ProjectTracking.Models.Project;
    var attachments = ViewBag.Attachments as IEnumerable<TestScenarioAttachment>
        ?? Enumerable.Empty<TestScenarioAttachment>();
    var returnUrl = (ViewBag.ReturnUrl as string)
        ?? Url.Action("Index", "TestScenarios", new { projectId = Model.project_id });
}

<style>
    .scenario-result-summary {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
        padding: 20px;
        border: 1px solid #b9e4f7;
        background: var(--bs-body-bg, #fff);
    }

    .scenario-result-summary__code {
        color: #64748b;
        font-size: .88rem;
        font-weight: 500;
    }

    .scenario-result-summary h3 {
        margin: 4px 0 8px;
        color: var(--bs-body-color, #102f3a);
        font-size: 1.2rem;
        font-weight: 600;
    }

    .scenario-result-summary p {
        margin: 0;
        color: #607782;
    }

    .scenario-result-summary__type {
        align-self: start;
        color: #075985;
        font-weight: 600;
    }

    .scenario-result-form {
        margin-top: 16px;
    }

    .scenario-result-grid {
        display: grid;
        grid-template-columns: minmax(220px, .38fr) minmax(0, 1fr);
        gap: 18px;
    }

    .scenario-evidence-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 14px;
        margin-top: 12px;
    }

    .scenario-evidence-item {
        position: relative;
        min-width: 0;
        padding: 10px;
        border: 1px solid #cbdde5;
        background: var(--bs-body-bg, #fff);
    }

    .scenario-evidence-item img {
        width: 100%;
        height: 145px;
        object-fit: cover;
        background: #eef6f9;
    }

    .scenario-evidence-item__name {
        display: block;
        margin-top: 8px;
        color: var(--bs-body-color, #102f3a);
        font-size: .84rem;
        overflow-wrap: anywhere;
    }

    .scenario-evidence-item__delete {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: 8px;
        color: #c62828;
        font-size: .82rem;
    }

    @@media (max-width: 760px) {
        .scenario-result-summary,
        .scenario-result-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">Test Scenario · @Model.scenario_code</span>
        <h2 class="index-title">ปรับสถานะการทดสอบ</h2>
        <p class="index-subtitle">บันทึกผลทดสอบ หมายเหตุ และ Evidence โดยไม่แก้ข้อมูล Scenario</p>
    </div>
</div>

<section class="scenario-result-summary">
    <div>
        <span class="scenario-result-summary__code">@(project?.ProjectDisplayName ?? "-")</span>
        <h3>@Model.title</h3>
        <p>
            @(Model.Group?.Control?.control_name ?? "ยังไม่กำหนด Control")
            · @(Model.Group?.group_name ?? "ไม่ระบุ Group")
        </p>
    </div>
    <span class="scenario-result-summary__type">ผู้ทดสอบ: @Model.scenario_type</span>
</section>

<form asp-action="UpdateStatus"
      method="post"
      enctype="multipart/form-data"
      class="pt-form-card scenario-result-form"
      onsubmit="return confirm('ยืนยันการบันทึกผลการทดสอบหรือไม่?');">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="scenario_id" />
    <input type="hidden" name="returnUrl" value="@returnUrl" />

    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="scenario-result-grid">
            <div class="form-group">
                <label asp-for="status">สถานะ</label>
                <select asp-for="status" class="form-control" required>
                    <option value="READY">@TestScenarioDisplay.StatusText("READY")</option>
                    <option value="PASSED">@TestScenarioDisplay.StatusText("PASSED")</option>
                    <option value="FAILED">@TestScenarioDisplay.StatusText("FAILED")</option>
                </select>
                <span asp-validation-for="status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="remark">Remark</label>
                <textarea asp-for="remark"
                          class="form-control"
                          rows="4"
                          placeholder="ระบุผลการทดสอบ ปัญหาที่พบ หรือหมายเหตุเพิ่มเติม"></textarea>
            </div>
        </div>

        <div class="form-group mt-3">
            <label>แนบรูปภาพ (เพิ่ม/อัปเดต Evidence)</label>
            <input type="file"
                   name="files"
                   multiple
                   accept="image/*"
                   class="form-control"
                   data-paste-image-upload />
            <small class="text-muted d-block mt-2">
                เลือกได้หลายรูป หรือ Copy รูป/Screenshot แล้วกด Ctrl+V / Cmd+V เพื่อวาง
            </small>
        </div>

        <div class="mt-4">
            <h5 class="mb-2">Evidence ปัจจุบัน (@attachments.Count())</h5>
            @if (attachments.Any())
            {
                <div class="scenario-evidence-grid">
                    @foreach (var image in attachments)
                    {
                        <div class="scenario-evidence-item">
                            <a href="@image.FilePath" target="_blank" rel="noopener">
                                <img src="@image.FilePath" alt="@(image.FileName ?? "Evidence")" />
                            </a>
                            <span class="scenario-evidence-item__name">@(image.FileName ?? "Evidence")</span>
                            <label class="scenario-evidence-item__delete">
                                <input type="checkbox"
                                       name="deleteAttachmentIds"
                                       value="@image.AttachmentId" />
                                ลบรูปนี้เมื่อบันทึก
                            </label>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">ยังไม่มี Evidence</p>
            }
        </div>

        <div class="pt-form-actions">
            <a href="@returnUrl" class="btn btn-outline-secondary">กลับ</a>
            <button type="submit" class="btn btn-primary">บันทึกผลการทดสอบ</button>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/paste-image-upload.js" asp-append-version="true"></script>
}

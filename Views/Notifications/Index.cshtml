@model ProjectTracking.ViewModels.NotificationPageViewModel
@{
    ViewData["Title"] = "Notifications";
    var pageModel = Model ?? new ProjectTracking.ViewModels.NotificationPageViewModel();
    var isAdmin = pageModel.IsAdmin;

    string TextTone(string? value) => (value ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "danger",
        "URGENT" => "danger",
        "HIGH" => "danger",
        "TODO" => "muted",
        "IN PROGRESS" => "warning",
        "IN_PROGRESS" => "warning",
        "WAIT TEST" => "info",
        "WAIT_TEST" => "info",
        "MEDIUM" => "warning",
        "LOW" => "success",
        "DONE" => "success",
        "FIXED" => "success",
        "PASS" => "success",
        "RESOLVED" => "success",
        "อ่านแล้ว" => "success",
        "ยังไม่อ่าน" => "danger",
        "ส่งงวดงานแล้ว" => "success",
        "อนุมัติจ่ายเงินแล้ว" => "success",
        "กำลังดำเนินการ" => "warning",
        "วางแผน" => "info",
        _ => "muted"
    };
}

<style>
    .notification-page {
        padding: 4px 0 28px;
    }

    .notification-hero {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        background: linear-gradient(135deg, #10284a, #174c5b);
        color: #fff;
        border-radius: 24px;
        padding: 28px 32px;
        box-shadow: 0 18px 36px rgba(15, 40, 74, .18);
        margin-bottom: 18px;
    }

    .notification-eyebrow {
        color: #9ff8ef;
        font-size: .82rem;
        font-weight: 900;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .notification-hero h1 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3.4rem);
        font-weight: 900;
        letter-spacing: 0;
        line-height: 1.05;
    }

    .notification-hero p {
        margin: 10px 0 0;
        color: #cfe0f2;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .notification-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .notification-actions .btn {
        min-width: 150px;
        border-radius: 999px;
        font-weight: 900;
        padding: 10px 18px;
    }

    .notification-groups {
        display: grid;
        gap: 18px;
    }

    .notification-group {
        background: rgba(255, 255, 255, .72);
        border: 1px solid #dbe6f3;
        border-radius: 24px;
        padding: 14px;
        box-shadow: 0 14px 30px rgba(15, 40, 74, .08);
    }

    .notification-group-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 12px;
        padding: 4px 4px 10px;
        border-bottom: 1px solid #e2eaf5;
    }

    .notification-group-title {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        color: #10223e;
        font-size: 1.22rem;
        font-weight: 900;
    }

    .notification-group-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 14px;
        background: #e0f7f3;
    }

    .notification-group.followup .notification-group-icon {
        background: #e0f2fe;
    }

    .notification-group-count {
        color: #64748b;
        font-weight: 900;
    }

    .notification-coop-groups {
        display: grid;
        gap: 14px;
    }

    .notification-coop-group {
        background: rgba(248, 250, 252, .76);
        border: 1px solid #e2eaf5;
        border-radius: 20px;
        padding: 12px;
    }

    .notification-coop-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
        color: #10223e;
        font-weight: 900;
    }

    .notification-coop-name {
        min-width: 0;
        overflow-wrap: anywhere;
        line-height: 1.3;
    }

    .notification-coop-count {
        color: #64748b;
        font-size: .92rem;
        white-space: nowrap;
    }

    .notification-list {
        display: grid;
        gap: 12px;
    }

    .notification-card {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(220px, auto);
        gap: 14px;
        align-items: start;
        background: #fff;
        border: 1px solid #dbe6f3;
        border-left: 6px solid #f59e0b;
        border-radius: 20px;
        padding: 14px 16px;
        color: #10223e;
        text-decoration: none;
        box-shadow: 0 12px 26px rgba(15, 40, 74, .08);
    }

    .notification-card.danger {
        border-left-color: #f43f5e;
    }

    .notification-card.is-read {
        opacity: .68;
    }

    .notification-card:hover {
        color: #10223e;
        transform: translateY(-1px);
        box-shadow: 0 16px 30px rgba(15, 40, 74, .12);
    }

    .notification-card-main {
        min-width: 0;
    }

    .notification-title {
        margin: 0;
        font-size: 1.08rem;
        font-weight: 900;
        line-height: 1.28;
    }

    .notification-project {
        margin: 5px 0 0;
        color: #64748b;
        font-weight: 800;
        line-height: 1.35;
        font-size: .93rem;
    }

    .notification-people {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 18px;
        margin-top: 8px;
        color: #718096;
        font-size: .9rem;
        font-weight: 800;
    }

    .notification-people strong {
        color: #17324d;
        font-weight: 900;
    }

    .notification-side {
        display: grid;
        gap: 7px;
        justify-items: end;
        text-align: right;
    }

    .notification-date {
        color: #17324d;
        font-size: .95rem;
        font-weight: 900;
    }

    .notification-status-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .notification-status-text,
    .notification-severity {
        font-size: .9rem;
        font-weight: 900;
        line-height: 1.2;
        white-space: nowrap;
    }

    .notification-status-text.danger,
    .notification-severity.danger {
        color: #e11d48;
    }

    .notification-status-text.warning,
    .notification-severity.warning {
        color: #d97706;
    }

    .notification-status-text.info {
        color: #0284c7;
    }

    .notification-status-text.success {
        color: #059669;
    }

    .notification-status-text.muted,
    .notification-severity.normal {
        color: #64748b;
    }

    .notification-empty {
        background: #fff;
        border: 1px dashed #c9d7e8;
        border-radius: 20px;
        padding: 40px 22px;
        text-align: center;
        color: #64748b;
        font-weight: 800;
    }

    @@media (max-width: 720px) {
        .notification-hero,
        .notification-card {
            grid-template-columns: 1fr;
        }

        .notification-hero {
            display: block;
            padding: 24px 20px;
        }

        .notification-actions {
            justify-content: flex-start;
            margin-top: 18px;
        }

        .notification-actions .btn {
            width: 100%;
        }

        .notification-group-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .notification-side {
            justify-items: start;
            text-align: left;
        }

        .notification-status-row {
            justify-content: flex-start;
        }
    }
</style>

<div class="notification-page">
    <section class="notification-hero">
        <div>
            <div class="notification-eyebrow">ProjectTracking</div>
            <h1>แจ้งเตือนงาน</h1>
            <p>งานเสี่ยงล่าช้าและงานล่าช้า @(isAdmin ? "ของทุกคนในระบบ" : "ของคุณ")</p>
        </div>
        <div class="notification-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Dashboard</a>
        </div>
    </section>

    @if (pageModel.TotalCount == 0)
    {
        @if (ViewBag.SyncError != null)
        {
            <div class="alert alert-danger fw-bold mb-3">
                Sync แจ้งเตือนไม่สำเร็จ: @ViewBag.SyncError
            </div>
        }
        <div class="notification-empty">ยังไม่มีงานเสี่ยงล่าช้าหรืองานล่าช้าในตอนนี้</div>
    }
    else
    {
        @if (ViewBag.SyncError != null)
        {
            <div class="alert alert-danger fw-bold mb-3">
                Sync แจ้งเตือนไม่สำเร็จ: @ViewBag.SyncError
            </div>
        }
        <div class="notification-groups">
            @foreach (var group in pageModel.Groups)
            {
                <section class="notification-group @group.Tone">
                    <div class="notification-group-header">
                        <h2 class="notification-group-title">
                            <span class="notification-group-icon">@group.Icon</span>
                            @group.Label
                        </h2>
                        <div class="notification-group-count">
                            ทั้งหมด @group.TotalCount รายการ
                            @if (group.UnreadCount > 0)
                            {
                                <span> / ยังไม่อ่าน @group.UnreadCount รายการ</span>
                            }
                        </div>
                    </div>
                    <div class="notification-coop-groups">
                        @foreach (var coopGroup in group.CoopGroups)
                        {
                            <section class="notification-coop-group">
                                <div class="notification-coop-header">
                                    <span class="notification-coop-name">@coopGroup.CoopName</span>
                                    <span class="notification-coop-count">@coopGroup.Items.Count รายการ</span>
                                </div>
                                <div class="notification-list">
                                    @foreach (var item in coopGroup.Items)
                                    {
                                        <a class="notification-card @item.Severity @(item.IsRead ? "is-read" : "")"
                                           asp-controller="Notifications"
                                           asp-action="Open"
                                           asp-route-id="@item.NotificationId">
                                            <div class="notification-card-main">
                                                <h3 class="notification-title">@item.Title</h3>
                                                <p class="notification-project">@item.ProjectName</p>
                                                <div class="notification-people">
                                                    <span><strong>BA:</strong> @item.BaName</span>
                                                    <span><strong>ผู้รับผิดชอบ:</strong> @item.OwnerName</span>
                                                </div>
                                            </div>
                                            <div class="notification-side">
                                                <div class="notification-date">@item.DateText</div>
                                                <div class="notification-status-row">
                                                    <span class="notification-severity @item.Severity">@item.SeverityText</span>
                                                    <span class="notification-status-text @TextTone(item.StatusText)">@item.StatusText</span>
                                                    @if (!string.IsNullOrWhiteSpace(item.ExtraStatusText) && item.ExtraStatusText != "-")
                                                    {
                                                        <span class="notification-status-text @TextTone(item.ExtraStatusText)">@item.ExtraStatusText</span>
                                                    }
                                                    <span class="notification-status-text @TextTone(item.IsRead ? "อ่านแล้ว" : "ยังไม่อ่าน")">
                                                        @(item.IsRead ? "อ่านแล้ว" : "ยังไม่อ่าน")
                                                    </span>
                                                </div>
                                            </div>
                                        </a>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

@model ProjectTracking.ViewModels.PhaseWorkloadViewModel

@{
    ViewData["Title"] = "ปริมาณงานทีม";
    var items = Model?.Items ?? new List<ProjectTracking.ViewModels.PhaseWorkloadItemViewModel>();

    int year = ViewBag.Year;
    int yearTo = ViewBag.YearTo ?? year;
    int month = ViewBag.Month;
    int monthTo = ViewBag.MonthTo ?? month;
    string viewMode = ViewBag.ViewMode as string ?? "day";
    bool isWeeklyMode = string.Equals(viewMode, "week", StringComparison.OrdinalIgnoreCase);

    var th = new System.Globalization.CultureInfo("th-TH");
    var firstDay = new DateTime(year, month, 1);
    var endDay = new DateTime(yearTo, monthTo, DateTime.DaysInMonth(yearTo, monthTo));
    var timelineColumns = new List<(DateTime Start, DateTime End, string YearText, string MonthText, string MainText, string SubText, bool IsToday, bool IsWeekend, bool IsNewYear)>();
    var columnWidth = isWeeklyMode ? 44 : 40;

    if (isWeeklyMode)
    {
        var cursorMonth = new DateTime(year, month, 1);
        var lastMonth = new DateTime(yearTo, monthTo, 1);

        while (cursorMonth <= lastMonth)
        {
            var monthEnd = new DateTime(cursorMonth.Year, cursorMonth.Month, DateTime.DaysInMonth(cursorMonth.Year, cursorMonth.Month));

            for (int weekNo = 1; weekNo <= 4; weekNo++)
            {
                var weekStartDay = weekNo switch
                {
                    1 => 1,
                    2 => 8,
                    3 => 15,
                    _ => 22
                };
                var weekStart = new DateTime(cursorMonth.Year, cursorMonth.Month, weekStartDay);
                var weekEnd = weekNo < 4 ? weekStart.AddDays(6) : monthEnd;

                timelineColumns.Add((
                    weekStart,
                    weekEnd,
                    (weekStart.Year + 543).ToString(),
                    weekStart.ToString("MMM", th),
                    weekNo.ToString(),
                    $"{weekStart:dd} - {weekEnd:dd}",
                    DateTime.Today >= weekStart.Date && DateTime.Today <= weekEnd.Date,
                    false,
                    weekStart.Month == 1 && weekNo == 1
                ));
            }

            cursorMonth = cursorMonth.AddMonths(1);
        }
    }
    else
    {
        var totalDays = (endDay - firstDay).Days + 1;

        for (int i = 0; i < totalDays; i++)
        {
            var date = firstDay.AddDays(i);

            timelineColumns.Add((
                date,
                date,
                (date.Year + 543).ToString(),
                date.ToString("MMM", th),
                date.Day.ToString(),
                date.ToString("ddd", th),
                date.Date == DateTime.Today,
                date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday,
                date.Month == 1 && date.Day == 1
            ));
        }
    }

    string selectedEmpId = Context.Request.Query["empId"].ToString();

    var employees = items
        .GroupBy(x => new
        {
            x.EmpId,
            x.EmpName
        })
        .OrderBy(x => x.Key.EmpName)
        .ToList();

    string NormalizeStatus(string? status) => (status ?? "").Trim().ToUpperInvariant();

    string WorkStatusColor(string? state)
    {
        return NormalizeStatus(state) switch
        {
            "DONE" => "#A3E4B5",
            "IN_PROGRESS" => "#FFE69C",
            _ => "#FFE69C"
        };
    }

    string TypeLabel(string? type) => NormalizeStatus(type) switch
    {
        "ISSUE" => "Issue",
        "SUPPORT" => "Support",
        _ => "Assigns"
    };
}

<div class="container-fluid px-2 px-md-3 d-flex justify-content-center workload-page-wrap">

    <div class="card shadow-sm border-0" style="max-width: 100%;">
        <div class="card-body">

            <div class="mb-3">
                <div class="index-hero">
                    <div class="index-hero__content">
                        <span class="index-eyebrow">ProjectTracking</span>
                        <h2 class="index-title">ปริมาณงานทีม</h2>
                        <p class="index-subtitle">ดูภาระงานของทีมตามช่วงวันที่และผู้รับผิดชอบ</p>
                    </div>

                    <div class="index-actions workload-legend">
                        <a class="btn btn-outline-light btn-pill" asp-controller="Home" asp-action="Index" title="กลับ Dashboard">
                            Dashboard
                        </a>
                    </div>
                </div>

                <div class="filter-toolbar d-flex align-items-center mt-3">
                    <div class="workload-status-row">
                        <span class="workload-status-row-title">สถานะ</span>
                        <span class="workload-status-label done">DONE</span>
                        <span class="workload-status-label progress">IN_PROGRESS</span>
                        <span class="workload-status-divider"></span>
                        <span class="workload-status-row-title">ประเภท</span>
                        <span class="workload-type-chip phase">Assigns</span>
                        <span class="workload-type-chip issue">Issue</span>
                        <span class="workload-type-chip support">Support</span>
                    </div>

                    <form id="filterForm"
                          method="get"
                          class="d-flex align-items-center gap-2 mb-0 employee-filter-wrap"
                          style="width:auto; flex:none;">

                        <input type="hidden" name="viewMode" value="@viewMode" />

                        <label class="fw-bold mb-0 text-nowrap">
                            ผู้รับผิดชอบ
                        </label>

                        <div class="workload-filter-control is-employee">
                            <select id="empFilter"
                                    name="empId"
                                    class="form-select emp-select-fixed"
                                    onchange="this.form.submit()">

                                <option value="">
                                    -- ทั้งหมด --
                                </option>

                                @foreach (var emp in employees)
                                {
                                    <option value="@emp.Key.EmpId"
                                            selected="@(selectedEmpId == emp.Key.EmpId.ToString())">
                                        @emp.Key.EmpName
                                    </option>
                                }

                            </select>
                        </div>

                        <label class="fw-bold mb-0 text-nowrap">ปี</label>

                        <div class="workload-filter-control is-year">
                            <select name="year"
                                    class="form-select workload-filter-select"
                                    form="filterForm">
                            @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 3; y++)
                            {
                                <option value="@y" selected="@(year == y)">@(y + 543)</option>
                            }
                            </select>
                        </div>

                        <label class="fw-bold mb-0 text-nowrap">เดือน</label>

                        <div class="workload-filter-control is-month">
                            <select name="month"
                                    class="form-select workload-filter-select month-select"
                                    form="filterForm">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(month == m)">
                                    @(new DateTime(year, m, 1).ToString("MMMM", th))
                                </option>
                            }
                            </select>
                        </div>

                        <label class="fw-bold mb-0 text-nowrap">ถึงปี</label>

                        <div class="workload-filter-control is-year">
                            <select name="yearTo"
                                    class="form-select workload-filter-select"
                                    form="filterForm">
                            @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 3; y++)
                            {
                                <option value="@y" selected="@(yearTo == y)">@(y + 543)</option>
                            }
                            </select>
                        </div>

                        <label class="fw-bold mb-0 text-nowrap">ถึงเดือน</label>

                        <div class="workload-filter-control is-month">
                            <select name="monthTo"
                                    class="form-select workload-filter-select month-select"
                                    form="filterForm">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(monthTo == m)">
                                    @(new DateTime(year, m, 1).ToString("MMMM", th))
                                </option>
                            }
                            </select>
                        </div>

                        <button type="submit"
                                form="filterForm"
                                class="btn btn-primary toolbar-btn">
                            แสดง
                        </button>

                    </form>
                    <div class="workload-toolbar">
                    </div>
                </div>

            </div>

            <div class="workload-table-topbar">
                <div class="workload-view-tabs" aria-label="เลือกมุมมอง">
                    <a class="workload-view-tab @(!isWeeklyMode ? "is-active" : "")"
                       asp-action="Index"
                       asp-route-empId="@selectedEmpId"
                       asp-route-year="@year"
                       asp-route-month="@month"
                       asp-route-yearTo="@yearTo"
                       asp-route-monthTo="@monthTo"
                       asp-route-viewMode="day">
                        รายวัน
                    </a>

                    <a class="workload-view-tab @(isWeeklyMode ? "is-active" : "")"
                       asp-action="Index"
                       asp-route-empId="@selectedEmpId"
                       asp-route-year="@year"
                       asp-route-month="@month"
                       asp-route-yearTo="@yearTo"
                       asp-route-monthTo="@monthTo"
                       asp-route-viewMode="week">
                        รายสัปดาห์
                    </a>
                </div>
            </div>

            <div class="table-responsive workload-responsive-wrap">

                <table class="table table-bordered align-middle text-center workload-table">

                    <thead class="is-grouped @(isWeeklyMode ? "is-weekly" : "is-daily")">
                        @{
                            var yearHeaderTones = new[]
                            {
                                new { Start = "#e0f7f4", End = "#ccfbf1", Text = "#0f766e", Border = "#8ddfd2" },
                                new { Start = "#dbeafe", End = "#eff6ff", Text = "#1d4ed8", Border = "#93c5fd" },
                                new { Start = "#ede9fe", End = "#f5f3ff", Text = "#6d28d9", Border = "#c4b5fd" },
                                new { Start = "#fef3c7", End = "#fffbeb", Text = "#b45309", Border = "#fcd34d" }
                            };

                            var monthHeaderTones = new[]
                            {
                                new { Head = "#d9f7ef", Body = "#f0fdfa", Text = "#0f766e", Border = "#8ddfd2" },
                                new { Head = "#dbeafe", Body = "#eff6ff", Text = "#1d4ed8", Border = "#93c5fd" },
                                new { Head = "#ede9fe", Body = "#f5f3ff", Text = "#6d28d9", Border = "#c4b5fd" },
                                new { Head = "#fef3c7", Body = "#fffbeb", Text = "#b45309", Border = "#fcd34d" },
                                new { Head = "#ffe4e6", Body = "#fff1f2", Text = "#be123c", Border = "#fda4af" },
                                new { Head = "#cffafe", Body = "#ecfeff", Text = "#0e7490", Border = "#67e8f9" },
                                new { Head = "#dcfce7", Body = "#f0fdf4", Text = "#15803d", Border = "#86efac" },
                                new { Head = "#f1f5f9", Body = "#f8fafc", Text = "#334155", Border = "#cbd5e1" }
                            };

                            var timelineYearGroups = timelineColumns
                                .GroupBy(column => column.Start.Year)
                                .Select((group, index) => new
                                {
                                    YearText = (group.Key + 543).ToString(),
                                    Count = group.Count(),
                                    Tone = yearHeaderTones[index % yearHeaderTones.Length]
                                })
                                .ToList();

                            var timelineMonthGroups = timelineColumns
                                .GroupBy(column => new { column.Start.Year, column.Start.Month })
                                .Select((group, index) => new
                                {
                                    group.Key.Year,
                                    group.Key.Month,
                                    MonthText = group.First().Start.ToString("MMM", th),
                                    Count = group.Count(),
                                    Tone = monthHeaderTones[index % monthHeaderTones.Length]
                                })
                                .ToList();

                            var monthToneMap = timelineMonthGroups
                                .ToDictionary(
                                    group => $"{group.Year}-{group.Month}",
                                    group => group.Tone);
                        }

                        <tr>
                            <th class="sticky-employee-col grouped-sticky-employee" rowspan="3" style="min-width:320px; width:320px;">
                                ผู้รับผิดชอบ
                            </th>

                            @foreach (var yearGroup in timelineYearGroups)
                            {
                                <th class="workload-year-header"
                                    colspan="@yearGroup.Count"
                                    style="--year-start:@yearGroup.Tone.Start; --year-end:@yearGroup.Tone.End; --year-text:@yearGroup.Tone.Text; --year-border:@yearGroup.Tone.Border;">
                                    @yearGroup.YearText
                                </th>
                            }
                        </tr>

                        <tr>
                            @foreach (var monthGroup in timelineMonthGroups)
                            {
                                <th class="workload-month-header"
                                    colspan="@monthGroup.Count"
                                    style="--month-head:@monthGroup.Tone.Head; --month-body:@monthGroup.Tone.Body; --month-text:@monthGroup.Tone.Text; --month-border:@monthGroup.Tone.Border;">
                                    @monthGroup.MonthText
                                </th>
                            }
                        </tr>

                        <tr>
                            @foreach (var column in timelineColumns)
                            {
                                var titleText = isWeeklyMode
                                    ? $"{column.Start:dd/MM/yyyy} - {column.End:dd/MM/yyyy}"
                                    : $"{column.Start:dd/MM/yyyy} {column.SubText}";
                                var monthTone = monthToneMap[$"{column.Start.Year}-{column.Start.Month}"];

                                <th class="timeline-header @(isWeeklyMode ? "week-column-header" : "day-column-header") @(column.IsToday ? "today-column-header" : "") @(column.IsWeekend ? "weekend-column" : "") @(column.IsNewYear ? "newyear-column" : "")"
                                    title="@titleText"
                                    style="min-width:@(columnWidth)px; width:@(columnWidth)px; position:relative; --month-head:@monthTone.Head; --month-body:@monthTone.Body; --month-text:@monthTone.Text; --month-border:@monthTone.Border;">
                                    @column.MainText
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var emp in employees
                            .Where(e => string.IsNullOrEmpty(selectedEmpId)
                                || e.Key.EmpId.ToString() == selectedEmpId))
                        {
                            var empWorks = items
                                .Where(x => x.EmpId == emp.Key.EmpId)
                                .OrderBy(x => x.ProjectName)
                                .ThenBy(x => x.StartDate)
                                .ThenBy(x => x.SortOrder)
                                .ToList();

                            var workRows = empWorks
                                .GroupBy(x => $"{x.WorkType}-{x.ItemId}")
                                .Select(g => g.First())
                                .ToList();

                            foreach (var work in workRows)
                            {
                                <tr>

                                    <td class="text-start bg-light phase-project-cell work-type-@work.WorkTypeClass">
                                        @if (work == workRows.First())
                                        {
                                            <div class="fw-bold mb-2">👤 @emp.Key.EmpName</div>
                                        }

                                        <div class="mb-1">
                                            <span class="workload-type-chip @work.WorkTypeClass">@TypeLabel(work.WorkType)</span>
                                            <span class="workload-status-text status-@NormalizeStatus(work.WorkState).ToLowerInvariant().Replace("_", "-")">@work.Status</span>
                                        </div>

                                        <div class="fw-bold" style="font-size:13px;color:#1f2937;line-height:1.2;">
                                            @work.ProjectName
                                        </div>

                                        <div style="font-size:12px;color:#6b7280;line-height:1.2;">
                                            🏷️ @work.Title
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(work.Detail) && work.Detail != work.Title)
                                        {
                                            <div style="font-size:11px;color:#64748b;line-height:1.25; margin-top:3px;">
                                                @work.Detail
                                            </div>
                                        }

                                        <div style="font-size:11px;color:#6b7280;line-height:1.3; margin-top:4px;">
                                            📅 @(work.StartDate?.ToString("dd MMM yy", new System.Globalization.CultureInfo("th-TH")))
                                            -
                                            @(work.EndDate?.ToString("dd MMM yy", new System.Globalization.CultureInfo("th-TH")))
                                        </div>
                                        @if (work.PeriodStartDate.HasValue || work.PeriodEndDate.HasValue)
                                        {
                                            <div style="font-size:11px;color:#7c3aed;line-height:1.3; margin-top:3px;">
                                                🗓️ งวดงาน:
                                                @(work.PeriodStartDate?.ToString("dd MMM yy", new System.Globalization.CultureInfo("th-TH")) ?? "-")
                                                -
                                                @(work.PeriodEndDate?.ToString("dd MMM yy", new System.Globalization.CultureInfo("th-TH")) ?? "-")
                                            </div>
                                        }
                                    </td>

                                    @foreach (var column in timelineColumns)
                                    {
                                        bool isWorking = work.StartDate.HasValue
                                            && work.EndDate.HasValue
                                            && work.StartDate.Value.Date <= column.End.Date
                                            && work.EndDate.Value.Date >= column.Start.Date;

                                        string bgColor = WorkStatusColor(work.WorkState);

                                        <td class="timeline-cell p-0 align-middle @(isWeeklyMode ? "week-column-cell" : "") @(column.IsToday ? "today-column" : "") @(column.IsWeekend ? "weekend-column" : "") @(column.IsNewYear ? "newyear-column" : "")"
                                            style="min-width:@(columnWidth)px; width:@(columnWidth)px;">
                                            @if (isWorking)
                                            {
                                                <a href="@work.Url"
                                                   class="text-decoration-none d-block h-100">

                                                    <div class="work-item connected-work @work.WorkTypeClass"
                                                         style="background:@bgColor">
                                                    </div>
                                                </a>
                                            }
                                        </td>
                                    }

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

@section Styles {
<style>
    .workload-table th {
        background: linear-gradient(180deg,#f8fafc,#eef2f7);
        vertical-align: middle;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 10;
        font-size: 13px;
        font-weight: 700;
        border-bottom: 2px solid #dee2e6;
    }

    .sticky-employee-col {
        position: sticky;
        left: 0;
        z-index: 20 !important;
        background: linear-gradient(180deg,#f8fafc,#eef2f7) !important;
        box-shadow: 4px 0 8px rgba(0,0,0,.04);
    }

    .workload-table {
        width: max-content !important;
        min-width: max-content;
        table-layout: fixed;
        border-collapse: collapse !important;
        border-spacing: 0 !important;
    }

    .timeline-cell {
        height: 60px;
        min-width: 34px;
        width: 34px;
        padding: 0 !important;
        vertical-align: middle !important;
        background: #fff;
        position: relative;
        border-left: 1px solid #edf1f5 !important;
        border-right: 1px solid #edf1f5 !important;
    }

    .timeline-header.week-column-header {
        min-width: 44px;
        width: 44px;
    }

    .timeline-header.day-column-header {
        min-width: 40px;
        width: 40px;
    }

    .week-column-cell {
        min-width: 44px;
        width: 44px;
    }

    .workload-table thead.is-grouped th {
        background: #f8fafc !important;
        border: 1px solid #cbd5e1 !important;
        border-bottom: 1px solid #cbd5e1 !important;
        color: #111827;
        padding: 0 !important;
        line-height: 1 !important;
        min-height: 0 !important;
        position: static !important;
        text-align: center;
        box-shadow: none;
    }

    .workload-table thead.is-grouped tr:nth-child(1) {
        height: 26px;
    }

    .workload-table thead.is-grouped tr:nth-child(2) {
        height: 30px;
    }

    .workload-table thead.is-grouped tr:nth-child(3) {
        height: 28px;
    }

    .workload-table thead.is-grouped .workload-year-header {
        height: 26px;
        background: linear-gradient(180deg, var(--year-start, #e0f7f4) 0%, var(--year-end, #ccfbf1) 100%) !important;
        border-color: var(--year-border, #8ddfd2) !important;
        color: var(--year-text, #0f766e);
        font-size: 15px;
        font-weight: 900;
        z-index: 12;
    }

    .workload-table thead.is-grouped .workload-month-header {
        height: 30px;
        background: var(--month-head, #e0f7f4) !important;
        border-color: var(--month-border, #cbd5e1) !important;
        color: var(--month-text, #0f766e);
        font-size: 14px;
        font-weight: 900;
        z-index: 12;
    }

    .workload-table thead.is-grouped .week-column-header,
    .workload-table thead.is-grouped .day-column-header {
        height: 28px;
        background: var(--month-body, #f7fbfc) !important;
        border-color: var(--month-border, #cbd5e1) !important;
        color: var(--month-text, #102443);
        font-size: 13px;
        font-weight: 900;
        z-index: 12;
    }

    .workload-table thead.is-grouped .grouped-sticky-employee {
        background: linear-gradient(180deg, #f8fafc 0%, #eef6f8 100%) !important;
        border-color: #cbd5e1 !important;
        color: #102443;
        vertical-align: middle !important;
        position: sticky !important;
        left: 0;
        top: auto !important;
        height: 84px;
        font-size: 14px;
        z-index: 24 !important;
    }

    .workload-table thead.is-grouped .today-column-header {
        background: #d9f7ef !important;
        color: #0f766e;
        box-shadow: inset 0 0 0 2px #0f766e;
    }

    .workload-table tbody tr td {
        border-top: 1px solid #edf1f5 !important;
        border-bottom: 1px solid #edf1f5 !important;
    }

    .work-item {
        border-radius: 0;
        height: 30px;
        min-height: 30px;
        margin: 0 !important;
        transition: .15s ease;
        border: 0;
        position: relative;
        top: 50%;
        transform: translateY(-50%);
    }

    .work-item:hover {
        transform: translateY(calc(-50% - 1px));
        box-shadow: 0 4px 12px rgba(0,0,0,.14);
    }

    .connected-work {
        width: calc(100% + 2px);
        margin-left: -1px;
        border-radius: 0;
        position: relative;
        z-index: 2;
    }

    .connected-work.issue {
        box-shadow: inset 0 0 0 2px rgba(244, 63, 94, .18);
    }

    .connected-work.support {
        box-shadow: inset 0 0 0 2px rgba(245, 158, 11, .2);
    }

    .phase-project-cell {
        min-width: 320px;
        width: 320px;
        max-width: 320px;
        vertical-align: middle;
        background: #fbfcfd !important;
        border-right: 2px solid #e9ecef;
        padding: 10px 14px !important;
        position: sticky;
        left: 0;
        z-index: 5;
        box-shadow: 4px 0 8px rgba(0,0,0,.04);
    }

    .phase-project-cell.work-type-phase {
        border-left: 4px solid #14b8a6 !important;
    }

    .phase-project-cell.work-type-issue {
        border-left: 4px solid #f43f5e !important;
    }

    .phase-project-cell.work-type-support {
        border-left: 4px solid #f59e0b !important;
    }

    .workload-type-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 22px;
        padding: 0 8px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 900;
        line-height: 1;
        white-space: nowrap;
    }

    .workload-type-chip.phase {
        color: #0f766e;
        background: rgba(20, 184, 166, .16);
    }

    .workload-type-chip.issue {
        color: #be123c;
        background: rgba(244, 63, 94, .14);
    }

    .workload-type-chip.support {
        color: #b45309;
        background: rgba(245, 158, 11, .17);
    }

    .workload-status-text {
        display: inline-flex;
        margin-left: 5px;
        font-size: 11px;
        font-weight: 900;
        vertical-align: middle;
    }

    .workload-status-text.status-done {
        color: #0f8f5f;
    }

    .workload-status-text.status-in-progress {
        color: #b7790b;
    }

    .weekend-column {
        background: #f8fafc !important;

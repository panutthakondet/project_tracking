@model ProjectTracking.ViewModels.PhaseWorkloadViewModel

@{
    ViewData["Title"] = "ปริมาณงานทีม";
    var items = Model?.Items ?? new List<ProjectTracking.ViewModels.PhaseWorkloadItemViewModel>();

    int year = ViewBag.Year;
    int yearTo = ViewBag.YearTo ?? year;
    int month = ViewBag.Month;
    int monthTo = ViewBag.MonthTo ?? month;

    var firstDay = new DateTime(year, month, 1);
    var endDay = new DateTime(yearTo, monthTo, DateTime.DaysInMonth(yearTo, monthTo));
    var totalDays = (endDay - firstDay).Days + 1;

    string selectedEmpId = Context.Request.Query["empId"].ToString();

    var employees = items
        .GroupBy(x => new
        {
            x.EmpId,
            x.EmpName
        })
        .OrderBy(x => x.Key.EmpName)
        .ToList();

    string NormalizeStatus(string? status) => (status ?? "").Trim().ToUpperInvariant();

    string WorkStatusColor(string? state)
    {
        return NormalizeStatus(state) switch
        {
            "DONE" => "#A3E4B5",
            "IN_PROGRESS" => "#FFE69C",
            _ => "#FFE69C"
        };
    }

    string TypeLabel(string? type) => NormalizeStatus(type) switch
    {
        "ISSUE" => "Issue",
        "SUPPORT" => "Support",
        _ => "Assigns"
    };
}

<div class="container-fluid px-2 px-md-3 d-flex justify-content-center workload-page-wrap">

    <div class="card shadow-sm border-0" style="max-width: 100%;">
        <div class="card-body">

            <div class="mb-3">
                <div class="index-hero">
                    <div class="index-hero__content">
                        <span class="index-eyebrow">ProjectTracking</span>
                        <h2 class="index-title">ปริมาณงานทีม</h2>
                        <p class="index-subtitle">ดูภาระงานของทีมตามช่วงวันที่และผู้รับผิดชอบ</p>
                    </div>

                    <div class="index-actions workload-legend">
                        <a class="btn btn-outline-light btn-pill" asp-controller="Home" asp-action="Index" title="กลับ Dashboard">
                            Dashboard
                        </a>
                    </div>
                </div>

                <div class="filter-toolbar d-flex align-items-center mt-3">
                    <div class="workload-status-row">
                        <span class="workload-status-row-title">สถานะ</span>
                        <span class="workload-status-label done">DONE</span>
                        <span class="workload-status-label progress">IN_PROGRESS</span>
                        <span class="workload-status-divider"></span>
                        <span class="workload-status-row-title">ประเภท</span>
                        <span class="workload-type-chip phase">Assigns</span>
                        <span class="workload-type-chip issue">Issue</span>
                        <span class="workload-type-chip support">Support</span>
                    </div>

                    <form id="filterForm"
                          method="get"
                          class="d-flex align-items-center gap-2 mb-0 employee-filter-wrap"
                          style="width:auto; flex:none;">

                        <input type="hidden" name="year" value="@year" />

                        <label class="fw-bold mb-0 text-nowrap">
                            ผู้รับผิดชอบ
                        </label>

                        <div class="workload-filter-control is-employee">
                            <select id="empFilter"
                                    name="empId"
                                    class="form-select emp-select-fixed"
                                    onchange="this.form.submit()">

                                <option value="">
                                    -- ทั้งหมด --
                                </option>

                                @foreach (var emp in employees)
                                {
                                    <option value="@emp.Key.EmpId"
                                            selected="@(selectedEmpId == emp.Key.EmpId.ToString())">
                                        @emp.Key.EmpName
                                    </option>
                                }

                            </select>
                        </div>

                        <label class="fw-bold mb-0 text-nowrap">ปี</label>

                        <div class="workload-filter-control is-year">
                            <select name="year"
                                    class="form-select workload-filter-select"
                                    form="filterForm">
                            @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 3; y++)
                            {
                                <option value="@y" selected="@(year == y)">@(y + 543)</option>
                            }
                            </select>
                        </div>

                        <label class="fw-bold mb-0 text-nowrap">เดือน</label>

                        <div class="workload-filter-control is-month">
                            <select name="month"
                                    class="form-select workload-filter-select month-select"
                                    form="filterForm">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(month == m)">
                                    @(new DateTime(year, m, 1).ToString("MMMM", new System.Globalization.CultureInfo("th-TH")))
                                </option>
                            }
                            </select>
                        </div>

                        <label class="fw-bold mb-0 text-nowrap">ถึงปี</label>

                        <div class="workload-filter-control is-year">
                            <select name="yearTo"
                                    class="form-select workload-filter-select"
                                    form="filterForm">
                            @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 3; y++)
                            {
                                <option value="@y" selected="@(yearTo == y)">@(y + 543)</option>
                            }
                            </select>
                        </div>

                        <label class="fw-bold mb-0 text-nowrap">ถึงเดือน</label>

                        <div class="workload-filter-control is-month">
                            <select name="monthTo"
                                    class="form-select workload-filter-select month-select"
                                    form="filterForm">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(monthTo == m)">
                                    @(new DateTime(year, m, 1).ToString("MMMM", new System.Globalization.CultureInfo("th-TH")))
                                </option>
                            }
                            </select>
                        </div>

                        <button type="submit"
                                form="filterForm"
                                class="btn btn-primary toolbar-btn">
                            แสดง
                        </button>

                    </form>
                    <div class="workload-toolbar">
                    </div>
                </div>

            </div>

            <div class="table-responsive workload-responsive-wrap">

                <table class="table table-bordered align-middle text-center workload-table">

                    <thead>
                        <tr>
                            <th class="sticky-employee-col" style="min-width:320px; width:320px;">
                                ผู้รับผิดชอบ
                            </th>

                            @for (int i = 0; i < totalDays; i++)
                            {
                                var date = firstDay.AddDays(i);
                                bool isToday = date.Date == DateTime.Today;
                                bool isWeekend = date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday;
                                bool isNewYear = date.Month == 1 && date.Day == 1;

                                <th class="@(isToday ? "today-column-header" : "") @(isWeekend ? "weekend-column" : "") @(isNewYear ? "newyear-column" : "")"
                                    style="min-width:40px; width:40px; position:relative;">

                                    <div style="font-size:9px;color:#64748b;line-height:1; margin-bottom:2px;">
                                        @(date.Year + 543)
                                    </div>

                                    <div style="font-size:10px;font-weight:700;color:#2563eb;line-height:1; margin-bottom:2px; white-space:nowrap;">
                                        @date.ToString("MMM", new System.Globalization.CultureInfo("th-TH"))
                                    </div>

                                    <div>@date.Day</div>

                                    <small class="text-muted" style="font-size:10px;">
                                        @date.ToString("ddd")
                                    </small>
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var emp in employees
                            .Where(e => string.IsNullOrEmpty(selectedEmpId)
                                || e.Key.EmpId.ToString() == selectedEmpId))
                        {
                            var empWorks = items
                                .Where(x => x.EmpId == emp.Key.EmpId)
                                .OrderBy(x => x.ProjectName)
                                .ThenBy(x => x.StartDate)
                                .ThenBy(x => x.SortOrder)
                                .ToList();

                            var workRows = empWorks
                                .GroupBy(x => $"{x.WorkType}-{x.ItemId}")
                                .Select(g => g.First())
                                .ToList();

                            foreach (var work in workRows)
                            {
                                <tr>

                                    <td class="text-start bg-light phase-project-cell work-type-@work.WorkTypeClass">
                                        @if (work == workRows.First())
                                        {
                                            <div class="fw-bold mb-2">👤 @emp.Key.EmpName</div>
                                        }

                                        <div class="mb-1">
                                            <span class="workload-type-chip @work.WorkTypeClass">@TypeLabel(work.WorkType)</span>
                                            <span class="workload-status-text status-@NormalizeStatus(work.WorkState).ToLowerInvariant().Replace("_", "-")">@work.Status</span>
                                        </div>

                                        <div class="fw-bold" style="font-size:13px;color:#1f2937;line-height:1.2;">
                                            @work.ProjectName
                                        </div>

                                        <div style="font-size:12px;color:#6b7280;line-height:1.2;">
                                            🏷️ @work.Title
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(work.Detail) && work.Detail != work.Title)
                                        {
                                            <div style="font-size:11px;color:#64748b;line-height:1.25; margin-top:3px;">
                                                @work.Detail
                                            </div>
                                        }

                                        <div style="font-size:11px;color:#6b7280;line-height:1.3; margin-top:4px;">
                                            📅 @(work.StartDate?.ToString("dd MMM yy", new System.Globalization.CultureInfo("th-TH")))
                                            -
                                            @(work.EndDate?.ToString("dd MMM yy", new System.Globalization.CultureInfo("th-TH")))
                                        </div>
                                        @if (work.PeriodStartDate.HasValue || work.PeriodEndDate.HasValue)
                                        {
                                            <div style="font-size:11px;color:#7c3aed;line-height:1.3; margin-top:3px;">
                                                🗓️ งวดงาน:
                                                @(work.PeriodStartDate?.ToString("dd MMM yy", new System.Globalization.CultureInfo("th-TH")) ?? "-")
                                                -
                                                @(work.PeriodEndDate?.ToString("dd MMM yy", new System.Globalization.CultureInfo("th-TH")) ?? "-")
                                            </div>
                                        }
                                    </td>

                                    @for (int i = 0; i < totalDays; i++)
                                    {
                                        var currentDate = firstDay.AddDays(i);
                                        bool isToday = currentDate.Date == DateTime.Today;
                                        bool isWeekend = currentDate.DayOfWeek == DayOfWeek.Saturday || currentDate.DayOfWeek == DayOfWeek.Sunday;
                                        bool isNewYear = currentDate.Month == 1 && currentDate.Day == 1;

                                        bool isWorking = work.StartDate.HasValue
                                            && work.EndDate.HasValue
                                            && currentDate >= work.StartDate.Value
                                            && currentDate <= work.EndDate.Value;

                                        string bgColor = WorkStatusColor(work.WorkState);

                                        <td class="timeline-cell p-0 align-middle @(isToday ? "today-column" : "") @(isWeekend ? "weekend-column" : "") @(isNewYear ? "newyear-column" : "")">
                                            @if (isWorking)
                                            {
                                                <a href="@work.Url"
                                                   class="text-decoration-none d-block h-100">

                                                    <div class="work-item connected-work @work.WorkTypeClass"
                                                         style="background:@bgColor">
                                                    </div>
                                                </a>
                                            }
                                        </td>
                                    }

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<style>
    .workload-table th {
        background: linear-gradient(180deg,#f8fafc,#eef2f7);
        vertical-align: middle;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 10;
        font-size: 13px;
        font-weight: 700;
        border-bottom: 2px solid #dee2e6;
    }

    .sticky-employee-col {
        position: sticky;
        left: 0;
        z-index: 20 !important;
        background: linear-gradient(180deg,#f8fafc,#eef2f7) !important;
        box-shadow: 4px 0 8px rgba(0,0,0,.04);
    }

    .workload-table {
        min-width: max-content;
    }

    .timeline-cell {
        height: 60px;
        min-width: 34px;
        width: 34px;
        padding: 0 !important;
        vertical-align: middle !important;
        background: #fff;
        position: relative;
        border-left: 1px solid #edf1f5 !important;
        border-right: 1px solid #edf1f5 !important;
    }

    .workload-table tbody tr td {
        border-top: 1px solid #edf1f5 !important;
        border-bottom: 1px solid #edf1f5 !important;
    }

    .work-item {
        border-radius: 0;
        height: 30px;
        min-height: 30px;
        margin: 0 !important;
        transition: .15s ease;
        border: 0;
        position: relative;
        top: 50%;
        transform: translateY(-50%);
    }

    .work-item:hover {
        transform: translateY(calc(-50% - 1px));
        box-shadow: 0 4px 12px rgba(0,0,0,.14);
    }

    .connected-work {
        width: calc(100% + 2px);
        margin-left: -1px;
        border-radius: 0;
        position: relative;
        z-index: 2;
    }

    .connected-work.issue {
        box-shadow: inset 0 0 0 2px rgba(244, 63, 94, .18);
    }

    .connected-work.support {
        box-shadow: inset 0 0 0 2px rgba(245, 158, 11, .2);
    }

    .phase-project-cell {
        min-width: 320px;
        width: 320px;
        max-width: 320px;
        vertical-align: middle;
        background: #fbfcfd !important;
        border-right: 2px solid #e9ecef;
        padding: 10px 14px !important;
        position: sticky;
        left: 0;
        z-index: 5;
        box-shadow: 4px 0 8px rgba(0,0,0,.04);
    }

    .phase-project-cell.work-type-phase {
        border-left: 4px solid #14b8a6 !important;
    }

    .phase-project-cell.work-type-issue {
        border-left: 4px solid #f43f5e !important;
    }

    .phase-project-cell.work-type-support {
        border-left: 4px solid #f59e0b !important;
    }

    .workload-type-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 22px;
        padding: 0 8px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 900;
        line-height: 1;
        white-space: nowrap;
    }

    .workload-type-chip.phase {
        color: #0f766e;
        background: rgba(20, 184, 166, .16);
    }

    .workload-type-chip.issue {
        color: #be123c;
        background: rgba(244, 63, 94, .14);
    }

    .workload-type-chip.support {
        color: #b45309;
        background: rgba(245, 158, 11, .17);
    }

    .workload-status-text {
        display: inline-flex;
        margin-left: 5px;
        font-size: 11px;
        font-weight: 900;
        vertical-align: middle;
    }

    .workload-status-text.status-done {
        color: #0f8f5f;
    }

    .workload-status-text.status-in-progress {
        color: #b7790b;
    }

    .weekend-column {
        background: #f8fafc !important;
    }
    .newyear-column {
        background: #ffe4e6 !important;
    }

    .today-column {
        background: #eef6ff !important;
        box-shadow: inset 2px 0 0 #3b82f6,
                    inset -2px 0 0 #3b82f6;
    }

    .today-column-header {
        background: linear-gradient(180deg,#dbeafe,#bfdbfe) !important;
        color: #1d4ed8 !important;
        box-shadow: inset 2px 0 0 #3b82f6,
                    inset -2px 0 0 #3b82f6;
    }

    .workload-legend {
        margin-top: -2px;
    }

    .filter-toolbar {
        flex-direction: column;
        align-items: stretch !important;
        gap: 8px;
    }

    .workload-status-row {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        min-height: 26px;
        padding: 0 2px;
    }

    .workload-status-row-title {
        color: #64748b;
        font-size: 13px;
        font-weight: 900;
    }

    .workload-status-divider {
        width: 1px;
        height: 18px;
        background: #cbd5e1;
    }

    .workload-status-label {
        font-size: 13px;
        font-weight: 900;
        line-height: 1;
    }

    .workload-status-label.done {
        color: #0f8f5f;
    }

    .workload-status-label.progress {
        color: #b7790b;
    }
</style>


<style>
.employee-filter-wrap {
    display: inline-flex !important;
    align-items: center;
    gap: 8px !important;
    flex-wrap: wrap !important;
    flex: none !important;
    width: 100% !important;
    max-width: none !important;
    overflow: visible !important;
    white-space: nowrap;
}

.workload-filter-control {
    width: 170px !important;
    min-width: 170px !important;
    flex: 0 0 170px !important;
}

.workload-filter-control.is-year {
    width: 120px !important;
    min-width: 120px !important;
    flex-basis: 120px !important;
}

.workload-filter-control.is-employee {
    width: 280px !important;
    min-width: 280px !important;
    flex-basis: 280px !important;
}

.emp-select-fixed,
#empFilter,
.workload-filter-select {
    width: 100% !important;
    min-width: 100% !important;
    max-width: 100% !important;

    height: 34px !important;
    min-height: 34px !important;
    max-height: 34px !important;

    padding: 0 38px 0 10px !important;
    line-height: 34px !important;
    box-sizing: border-box !important;

    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

/* replaced month-select styles */
.month-select {
    width: 100% !important;
    min-width: 100% !important;
    max-width: 100% !important;

    height: 34px !important;
    min-height: 34px !important;
    max-height: 34px !important;

    padding: 0 38px 0 10px !important;
    line-height: 34px !important;
    box-sizing: border-box !important;

    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}
</style>

<style>
.workload-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: nowrap !important;
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    min-width: 0;
    scrollbar-width: thin;
    scrollbar-color: #0f766e #e8eef6;
}

.workload-toolbar::-webkit-scrollbar {
    height: 6px;
}

.workload-toolbar::-webkit-scrollbar-thumb {
    background: #0f766e;
    border-radius: 999px;
}
</style>
<style>
/* ============================
   Responsive
============================ */
@@media (max-width: 1200px) {
    .phase-project-cell,
    .sticky-employee-col {
        min-width: 280px !important;
        width: 280px !important;
        max-width: 280px !important;
    }
}

@@media (max-width: 992px) {
    .workload-responsive-wrap {
        overflow-x: auto !important;
        overflow-y: hidden !important;
        -webkit-overflow-scrolling: touch;
    }

    .workload-table {
        min-width: max-content !important;
        width: max-content !important;
        table-layout: auto;
    }
    .filter-toolbar {
        overflow: visible !important;
        white-space: normal !important;
    }

    .employee-filter-wrap {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 10px !important;
        width: 100% !important;
        min-width: unset !important;
        white-space: normal !important;
    }

    .phase-project-cell,
    .sticky-employee-col {
        min-width: 220px !important;
        width: 220px !important;
        max-width: 220px !important;
    }

    .timeline-cell {
        min-width: 30px;
        width: 30px;
    }
}

@@media (max-width: 768px) {
    .workload-responsive-wrap {
        overflow-x: auto !important;
        overflow-y: hidden !important;
        -webkit-overflow-scrolling: touch;
    }

    .workload-table {
        min-width: max-content !important;
        width: max-content !important;
        table-layout: auto;
    }
    .workload-page-wrap .card-body {
        padding: 12px !important;
    }

    .filter-toolbar {
        overflow: visible !important;
    }

    .employee-filter-wrap {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 10px !important;
        align-items: end;
        width: 100% !important;
    }

    .employee-filter-wrap > div {
        flex: 1 1 160px !important;
        min-width: 160px !important;
    }

    .employee-filter-wrap > .workload-filter-control,
    .employee-filter-wrap > .workload-filter-control.is-employee {
        flex: 1 1 180px !important;
        min-width: 180px !important;
        width: auto !important;
    }

    .employee-filter-wrap button {
        width: 100%;
        min-height: 38px;
        margin-top: 4px;
    }

    .employee-filter-wrap label,
    .employee-filter-wrap span {
        width: 100%;
        margin-bottom: -4px;
    }

    .phase-project-cell,
    .sticky-employee-col {
        min-width: 200px !important;
        width: 200px !important;
        max-width: 200px !important;
        padding: 8px 10px !important;
    }

    /* ลดความสูง header วันที่ */
    .workload-table th small {
        display: none;
    }

    .workload-table th div:first-child {
        display: none;
    }

    .timeline-cell {
        min-width: 20px;
        width: 20px;
        height: 48px;
    }

    .work-item {
        height: 24px;
        min-height: 24px;
    }

    .workload-table th {
        font-size: 11px;
    }

    .workload-table td {
        font-size: 12px;
    }

    .employee-filter-wrap label {
        font-size: 12px;
    }
}

main.route-controller-phaseworkload {
    overflow-x: clip;
}

.workload-page-wrap {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
}

.workload-page-wrap > .card {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    overflow: hidden !important;
}

.workload-responsive-wrap {
    width: 100% !important;
    max-width: 100% !important;
}

@@media (max-width: 992px) {
    .workload-page-wrap.container-fluid {
        padding-left: 8px !important;
        padding-right: 8px !important;
    }

    .workload-page-wrap > .card {
        width: 100% !important;
        max-width: 100% !important;
        overflow: visible !important;
    }
}

@@media (max-width: 768px) {
    .phase-project-cell,
    .sticky-employee-col {
        min-width: 120px !important;
        width: 120px !important;
        max-width: 120px !important;
        font-size: 11px !important;
        padding: 6px !important;
    }

    .timeline-cell {
        min-width: 16px !important;
        width: 16px !important;
    }
}

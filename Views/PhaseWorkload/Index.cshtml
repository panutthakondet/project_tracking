@model ProjectTracking.ViewModels.PhaseWorkloadViewModel

@{
    ViewData["Title"] = "ปริมาณงานทีม";
    var items = Model?.Items ?? new List<ProjectTracking.ViewModels.PhaseWorkloadItemViewModel>();

    int year = ViewBag.Year;
    int yearTo = ViewBag.YearTo ?? year;
    int month = ViewBag.Month;
    int monthTo = ViewBag.MonthTo ?? month;
    int? selectedCoopId = ViewBag.SelectedCoopId as int?;
    int? selectedProjectId = ViewBag.SelectedProjectId as int?;
    var coopOptions = ViewBag.CoopOptions as IEnumerable<ProjectTracking.Models.CntMCoop>
        ?? Enumerable.Empty<ProjectTracking.Models.CntMCoop>();
    var projectOptions = ViewBag.ProjectOptions as IEnumerable<ProjectTracking.Models.Project>
        ?? Enumerable.Empty<ProjectTracking.Models.Project>();
    const bool isWeeklyMode = true;

    var th = new System.Globalization.CultureInfo("th-TH");
    var selectedPeriodStart = $"{year:D4}-{month:D2}";
    var selectedPeriodEnd = $"{yearTo:D4}-{monthTo:D2}";
    var periodYears = Enumerable.Range(DateTime.Today.Year - 1, 3)
        .Append(year)
        .Append(yearTo)
        .Distinct()
        .OrderBy(value => value)
        .ToList();
    var timelineColumns = new List<(DateTime Start, DateTime End, string YearText, string MonthText, string MainText, string SubText, bool IsToday, bool IsWeekend, bool IsNewYear)>();
    const int columnWidth = 32;
    var cursorMonth = new DateTime(year, month, 1);
    var lastMonth = new DateTime(yearTo, monthTo, 1);

    while (cursorMonth <= lastMonth)
    {
            var monthEnd = new DateTime(cursorMonth.Year, cursorMonth.Month, DateTime.DaysInMonth(cursorMonth.Year, cursorMonth.Month));

            for (int weekNo = 1; weekNo <= 4; weekNo++)
            {
                var weekStartDay = weekNo switch
                {
                    1 => 1,
                    2 => 8,
                    3 => 15,
                    _ => 22
                };
                var weekStart = new DateTime(cursorMonth.Year, cursorMonth.Month, weekStartDay);
                var weekEnd = weekNo < 4 ? weekStart.AddDays(6) : monthEnd;

                timelineColumns.Add((
                    weekStart,
                    weekEnd,
                    (weekStart.Year + 543).ToString(),
                    weekStart.ToString("MMM", th),
                    weekNo.ToString(),
                    $"{weekStart:dd} - {weekEnd:dd}",
                    DateTime.Today >= weekStart.Date && DateTime.Today <= weekEnd.Date,
                    false,
                    weekStart.Month == 1 && weekNo == 1
                ));
            }

        cursorMonth = cursorMonth.AddMonths(1);
    }

    string selectedEmpId = ViewBag.SelectedEmpId as string ?? Context.Request.Query["empId"].ToString();

    var employees = items
        .GroupBy(x => new
        {
            x.EmpId,
            x.EmpName
        })
        .OrderBy(x => x.Key.EmpName)
        .ToList();

    string NormalizeStatus(string? status) => (status ?? "").Trim().ToUpperInvariant();

    string StatusLabel(string? status) => NormalizeStatus(status) switch
    {
        "DONE" => "เสร็จสิ้น",
        "IN_PROGRESS" => "กำลังดำเนินการ",
        _ => string.IsNullOrWhiteSpace(status) ? "-" : status.Trim()
    };

    string WorkStatusColor(string? state)
    {
        return NormalizeStatus(state) switch
        {
            "DONE" => "#A3E4B5",
            "IN_PROGRESS" => "#FFE69C",
            _ => "#FFE69C"
        };
    }

    var todayText = DateTime.Today.ToString("dddd 'ที่' d MMMM yyyy", th);
}

<div class="container-fluid px-2 px-md-3 workload-page-wrap">

    <div class="workload-calendar-card">
        <div class="workload-calendar-toolbar">
            <div class="workload-calendar-heading">
                <span class="workload-calendar-date">@todayText</span>
                <div>
                    <span class="workload-calendar-eyebrow">ProjectTracking</span>
                    <strong class="workload-calendar-title">ปริมาณงานทีม</strong>
                    <span class="workload-calendar-subtitle">ดูภาระงานของทีมตามช่วงวันที่และผู้รับผิดชอบ</span>
                </div>
            </div>

            <div class="workload-calendar-actions" aria-label="Workload actions">
                <a class="workload-calendar-action"
                   asp-controller="ProjectPhases"
                   asp-action="Index"
                   asp-route-projectId="@selectedProjectId"
                   title="กลับไปหน้า ProjectPhases">
                    กลับไป ProjectPhases
                </a>
                <a class="workload-calendar-action" asp-controller="Home" asp-action="Index" title="กลับ Dashboard">
                    Dashboard
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 workload-content-card" style="max-width: 100%;">
        <div class="card-body">

            <div class="mb-3">

                <div class="filter-toolbar d-flex align-items-center">
                    <form id="filterForm"
                          method="get"
                          class="d-flex align-items-center gap-2 mb-0 employee-filter-wrap"
                          style="width:auto; flex:none;">

                        <div class="workload-filter-grid">
                            <label class="workload-filter-field is-coop" for="coopFilter">
                                <span>🏢 สหกรณ์</span>
                                <select id="coopFilter"
                                        name="coopId"
                                        class="form-select workload-filter-select"
                                        data-autosubmit="true">
                                    <option value="">-- ทั้งหมด --</option>
                                    @foreach (var coop in coopOptions)
                                    {
                                        <option value="@coop.CoopId" selected="@(selectedCoopId == coop.CoopId)">
                                            @coop.CoopName
                                        </option>
                                    }
                                </select>
                            </label>

                            <label class="workload-filter-field is-project" for="projectFilter">
                                <span>📁 โครงการ</span>
                                <select id="projectFilter"
                                        name="projectId"
                                        class="form-select workload-filter-select"
                                        data-autosubmit="true">
                                    <option value="">-- ทั้งหมด --</option>
                                    @foreach (var project in projectOptions)
                                    {
                                        <option value="@project.ProjectId" selected="@(selectedProjectId == project.ProjectId)">
                                            @project.ProjectName
                                        </option>
                                    }
                                </select>
                            </label>

                            <label class="workload-filter-field is-employee" for="empFilter">
                                <span>ผู้รับผิดชอบ</span>
                                <select id="empFilter"
                                        name="empId"
                                        class="form-select emp-select-fixed"
                                        data-autosubmit="true">

                                    <option value="">
                                        -- ทั้งหมด --
                                    </option>

                                    @foreach (var emp in employees)
                                    {
                                        <option value="@emp.Key.EmpId"
                                                selected="@(selectedEmpId == emp.Key.EmpId.ToString())">
                                            @emp.Key.EmpName
                                        </option>
                                    }

                                </select>
                            </label>

                            <label class="workload-filter-field is-period is-start-period">
                                <span>เดือนเริ่ม</span>
                                <select name="periodStart"
                                        class="form-select workload-filter-select"
                                        form="filterForm"
                                        data-autosubmit="true">
                                @foreach (var periodYear in periodYears)
                                {
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        var optionValue = $"{periodYear:D4}-{m:D2}";
                                        var optionDate = new DateTime(periodYear, m, 1);
                                        <option value="@optionValue" selected="@(selectedPeriodStart == optionValue)">
                                            @optionDate.ToString("MMMM yyyy", th)
                                        </option>
                                    }
                                }
                                </select>
                            </label>

                            <label class="workload-filter-field is-period is-end-period">
                                <span>ถึงเดือน</span>
                                <select name="periodEnd"
                                        class="form-select workload-filter-select"
                                        form="filterForm"
                                        data-autosubmit="true">
                                @foreach (var periodYear in periodYears)
                                {
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        var optionValue = $"{periodYear:D4}-{m:D2}";
                                        var optionDate = new DateTime(periodYear, m, 1);
                                        <option value="@optionValue" selected="@(selectedPeriodEnd == optionValue)">
                                            @optionDate.ToString("MMMM yyyy", th)
                                        </option>
                                    }
                                }
                                </select>
                            </label>
                        </div>

                    </form>
                    <div class="workload-toolbar">
                    </div>
                </div>

            </div>

            <div class="workload-table-topbar">
                <div class="workload-status-row">
                    <span class="workload-status-row-title">สถานะ</span>
                    <span class="workload-status-label done">เสร็จสิ้น</span>
                    <span class="workload-status-label progress">กำลังดำเนินการ</span>
                </div>
            </div>

            <div class="table-responsive workload-responsive-wrap">

                <table class="table table-bordered align-middle text-center workload-table">

                    <thead class="is-grouped @(isWeeklyMode ? "is-weekly" : "is-daily")">
                        @{
                            var yearHeaderTones = new[]
                            {
                                new { Start = "#e0f7f4", End = "#ccfbf1", Text = "#0f766e", Border = "#8ddfd2" },
                                new { Start = "#dbeafe", End = "#eff6ff", Text = "#1d4ed8", Border = "#93c5fd" },
                                new { Start = "#ede9fe", End = "#f5f3ff", Text = "#6d28d9", Border = "#c4b5fd" },
                                new { Start = "#fef3c7", End = "#fffbeb", Text = "#b45309", Border = "#fcd34d" }
                            };

                            var monthHeaderTones = new[]
                            {
                                new { Head = "#d9f7ef", Body = "#f0fdfa", Text = "#0f766e", Border = "#8ddfd2" },
                                new { Head = "#dbeafe", Body = "#eff6ff", Text = "#1d4ed8", Border = "#93c5fd" },
                                new { Head = "#ede9fe", Body = "#f5f3ff", Text = "#6d28d9", Border = "#c4b5fd" },
                                new { Head = "#fef3c7", Body = "#fffbeb", Text = "#b45309", Border = "#fcd34d" },
                                new { Head = "#ffe4e6", Body = "#fff1f2", Text = "#be123c", Border = "#fda4af" },
                                new { Head = "#cffafe", Body = "#ecfeff", Text = "#0e7490", Border = "#67e8f9" },
                                new { Head = "#dcfce7", Body = "#f0fdf4", Text = "#15803d", Border = "#86efac" },
                                new { Head = "#f1f5f9", Body = "#f8fafc", Text = "#334155", Border = "#cbd5e1" }
                            };

                            var timelineYearGroups = timelineColumns
                                .GroupBy(column => column.Start.Year)
                                .Select((group, index) => new
                                {
                                    YearText = (group.Key + 543).ToString(),
                                    Count = group.Count(),
                                    Tone = yearHeaderTones[index % yearHeaderTones.Length]
                                })
                                .ToList();

                            var timelineMonthGroups = timelineColumns
                                .GroupBy(column => new { column.Start.Year, column.Start.Month })
                                .Select((group, index) => new
                                {
                                    group.Key.Year,
                                    group.Key.Month,
                                    MonthText = group.First().Start.ToString("MMM", th),
                                    Count = group.Count(),
                                    Tone = monthHeaderTones[index % monthHeaderTones.Length]
                                })
                                .ToList();

                            var monthToneMap = timelineMonthGroups
                                .ToDictionary(
                                    group => $"{group.Year}-{group.Month}",
                                    group => group.Tone);
                        }

                        <tr>
                            <th class="sticky-employee-col grouped-sticky-employee" rowspan="3" style="min-width:320px; width:320px;">
                                ผู้รับผิดชอบ
                            </th>

                            @foreach (var yearGroup in timelineYearGroups)
                            {
                                <th class="workload-year-header"
                                    colspan="@yearGroup.Count"
                                    style="--year-start:@yearGroup.Tone.Start; --year-end:@yearGroup.Tone.End; --year-text:@yearGroup.Tone.Text; --year-border:@yearGroup.Tone.Border;">
                                    @yearGroup.YearText
                                </th>
                            }
                        </tr>

                        <tr>
                            @foreach (var monthGroup in timelineMonthGroups)
                            {
                                <th class="workload-month-header"
                                    colspan="@monthGroup.Count"
                                    style="--month-head:@monthGroup.Tone.Head; --month-body:@monthGroup.Tone.Body; --month-text:@monthGroup.Tone.Text; --month-border:@monthGroup.Tone.Border;">
                                    @monthGroup.MonthText
                                </th>
                            }
                        </tr>

                        <tr>
                            @foreach (var column in timelineColumns)
                            {
                                var titleText = isWeeklyMode
                                    ? $"{column.Start:dd/MM/yyyy} - {column.End:dd/MM/yyyy}"
                                    : $"{column.Start:dd/MM/yyyy} {column.SubText}";
                                var monthTone = monthToneMap[$"{column.Start.Year}-{column.Start.Month}"];

                                <th class="timeline-header @(isWeeklyMode ? "week-column-header" : "day-column-header") @(column.IsToday ? "today-column-header" : "") @(column.IsWeekend ? "weekend-column" : "") @(column.IsNewYear ? "newyear-column" : "")"
                                    title="@titleText"
                                    style="min-width:@(columnWidth)px; width:@(columnWidth)px; position:relative; --month-head:@monthTone.Head; --month-body:@monthTone.Body; --month-text:@monthTone.Text; --month-border:@monthTone.Border;">
                                    @column.MainText
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var emp in employees
                            .Where(e => string.IsNullOrEmpty(selectedEmpId)
                                || e.Key.EmpId.ToString() == selectedEmpId))
                        {
                            var empWorks = items
                                .Where(x => x.EmpId == emp.Key.EmpId)
                                .OrderBy(x => x.ProjectName)
                                .ThenBy(x => x.StartDate)
                                .ThenBy(x => x.SortOrder)
                                .ToList();

                            var workRows = empWorks
                                .GroupBy(x => $"{x.WorkType}-{x.ItemId}")
                                .Select(g => g.First())
                                .ToList();

                            foreach (var work in workRows)
                            {
                                <tr>

                                    <td class="text-start bg-light phase-project-cell work-type-@work.WorkTypeClass">
                                        @if (work == workRows.First())
                                        {
                                            <div class="fw-bold mb-2">👤 @emp.Key.EmpName</div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(work.PhasePeriodLabel))
                                        {
                                            <div class="workload-phase-period">
                                                <span>@work.PhasePeriodLabel</span>
                                                <span class="workload-status-text status-@NormalizeStatus(work.WorkState).ToLowerInvariant().Replace("_", "-")">
                                                    @StatusLabel(work.WorkState)
                                                </span>
                                            </div>
                                        }

                                        <div class="fw-bold" style="font-size:13px;color:#1f2937;line-height:1.2;">
                                            @work.ProjectName
                                        </div>

                                        <div style="font-size:12px;color:#6b7280;line-height:1.2;">
                                            🏷️ @work.Title
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(work.Detail) && work.Detail != work.Title)
                                        {
                                            <div style="font-size:11px;color:#64748b;line-height:1.25; margin-top:3px;">
                                                @work.Detail
                                            </div>
                                        }

                                        <div style="font-size:11px;color:#6b7280;line-height:1.3; margin-top:4px;">
                                            📅 @(work.StartDate?.ToString("dd MMM yy", new System.Globalization.CultureInfo("th-TH")))
                                            -
                                            @(work.EndDate?.ToString("dd MMM yy", new System.Globalization.CultureInfo("th-TH")))
                                            @if (work.PeriodEndDate.HasValue)
                                            {
                                                <span class="workload-due-date">
                                                · กำหนดส่ง
                                                @(work.PeriodEndDate?.ToString("dd MMM yy", new System.Globalization.CultureInfo("th-TH")) ?? "-")
                                                </span>
                                            }
                                        </div>
                                    </td>

                                    @foreach (var column in timelineColumns)
                                    {
                                        bool isWorking = work.StartDate.HasValue
                                            && work.EndDate.HasValue
                                            && work.StartDate.Value.Date <= column.End.Date
                                            && work.EndDate.Value.Date >= column.Start.Date;

                                        string bgColor = WorkStatusColor(work.WorkState);

                                        <td class="timeline-cell p-0 align-middle @(isWeeklyMode ? "week-column-cell" : "") @(column.IsToday ? "today-column" : "") @(column.IsWeekend ? "weekend-column" : "") @(column.IsNewYear ? "newyear-column" : "")"
                                            style="min-width:@(columnWidth)px; width:@(columnWidth)px;">
                                            @if (isWorking)
                                            {
                                                <a href="@work.Url"
                                                   class="text-decoration-none d-block h-100">

                                                    <div class="work-item connected-work @work.WorkTypeClass"
                                                         style="background:@bgColor">
                                                    </div>
                                                </a>
                                            }
                                        </td>
                                    }

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<div id="workloadLoading" class="workload-loading" role="status" aria-live="polite" aria-hidden="true">
    <div class="workload-loading-box">
        <span class="workload-loading-spinner" aria-hidden="true"></span>
        <span>กำลังโหลดข้อมูล...</span>
    </div>
</div>

@section Styles {
<style>
    .workload-loading {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(15, 23, 42, .34);
        backdrop-filter: blur(3px);
    }

    .workload-loading.is-visible {
        display: flex;
    }

    .workload-loading-box {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-width: 210px;
        min-height: 58px;
        padding: 14px 18px;
        color: #10223e;
        background: rgba(255, 255, 255, .96);
        border: 1px solid rgba(203, 213, 225, .95);
        border-radius: 18px;
        box-shadow: 0 22px 50px rgba(15, 23, 42, .22);
        font-weight: 900;
    }

    .workload-loading-spinner {
        width: 24px;
        height: 24px;
        border: 3px solid rgba(20, 184, 166, .22);
        border-top-color: #0f766e;
        border-radius: 50%;
        animation: workloadSpin .75s linear infinite;
        flex: 0 0 auto;
    }

    @@keyframes workloadSpin {
        to {
            transform: rotate(360deg);
        }
    }

    .workload-calendar-card {
        width: 100%;
        border-radius: 22px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid rgba(15, 118, 110, .18);
        box-shadow: 0 16px 38px rgba(15, 35, 64, .12);
    }

    .workload-calendar-toolbar {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        min-height: 132px;
        padding: 24px 30px;
        color: #ffffff;
        background:
            linear-gradient(135deg, rgba(16, 35, 63, .98) 0%, rgba(18, 59, 92, .95) 56%, rgba(15, 118, 110, .92) 100%);
        border-bottom: 1px solid rgba(20, 184, 166, .36);
    }

    .workload-calendar-toolbar::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            linear-gradient(90deg, rgba(255, 255, 255, .10), transparent 42%),
            repeating-linear-gradient(135deg, rgba(255,255,255,.10) 0 1px, transparent 1px 14px);
        opacity: .42;
        pointer-events: none;
    }

    .workload-calendar-toolbar > * {
        position: relative;
        z-index: 1;
    }

    .workload-calendar-heading {
        display: flex;
        align-items: center;
        gap: 20px;
        min-width: 0;
    }

    .workload-calendar-date {
        min-width: 300px;
        min-height: 68px;
        padding: 12px 20px;
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        color: #10233f;
        background: rgba(255,255,255,.95);
        box-shadow: 0 12px 26px rgba(4, 18, 38, .22);
        font-size: 1.05rem;
        font-weight: 900;
        line-height: 1.25;
        white-space: nowrap;
    }

    .workload-calendar-eyebrow {
        display: block;
        color: rgba(255,255,255,.72);
        font-size: .8rem;
        font-weight: 900;
        letter-spacing: .04em;
        text-transform: uppercase;
        line-height: 1.2;
    }

    .workload-calendar-title {
        display: block;
        color: #ffffff;
        font-size: 1.55rem;
        font-weight: 900;
        line-height: 1.12;
        margin-top: 3px;
    }

    .workload-calendar-subtitle {
        display: block;
        color: rgba(255,255,255,.78);
        font-size: .98rem;
        font-weight: 700;
        line-height: 1.3;
        margin-top: 7px;
    }

    .workload-calendar-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
    }

    .workload-calendar-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 138px;
        min-height: 46px;
        padding: 9px 18px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.45);
        color: #ffffff !important;
        background: rgba(255,255,255,.12);
        box-shadow: 0 8px 18px rgba(4, 18, 38, .16);
        font-size: .98rem;
        font-weight: 900;
        line-height: 1.15;
        text-decoration: none;
        white-space: nowrap;
        backdrop-filter: blur(8px);
        transition: transform .15s ease, filter .15s ease;
    }

    .workload-calendar-action:hover,
    .workload-calendar-action:focus {
        color: #ffffff !important;
        filter: brightness(1.06);
        transform: translateY(-1px);
    }

    @@media (max-width: 900px) {
        .workload-calendar-toolbar {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .workload-calendar-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 12px;
        }

        .workload-calendar-date {
            min-width: min(100%, 300px);
            min-height: 54px;
        }

        .workload-calendar-actions {
            width: 100%;
            justify-content: flex-start;
        }
    }

    .workload-table th {
        background: linear-gradient(180deg,#f8fafc,#eef2f7);
        vertical-align: middle;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 10;
        font-size: 13px;
        font-weight: 700;
        border-bottom: 2px solid #dee2e6;
    }

    .sticky-employee-col {
        position: sticky;
        left: 0;
        z-index: 20 !important;
        background: linear-gradient(180deg,#f8fafc,#eef2f7) !important;
        box-shadow: 4px 0 8px rgba(0,0,0,.04);
    }

    .workload-table {
        width: max-content !important;
        min-width: max-content;
        table-layout: fixed;
        border-collapse: collapse !important;
        border-spacing: 0 !important;
    }

    .timeline-cell {
        height: 60px;
        min-width: 34px;
        width: 34px;
        padding: 0 !important;
        vertical-align: middle !important;
        background: #fff;
        position: relative;
        border-left: 1px solid #edf1f5 !important;
        border-right: 1px solid #edf1f5 !important;
    }

    .timeline-header.week-column-header {
        min-width: 32px;
        width: 32px;
    }

    .timeline-header.day-column-header {
        min-width: 40px;
        width: 40px;
    }

    .week-column-cell {
        min-width: 32px;
        width: 32px;
    }

    .workload-table thead.is-grouped th {
        background: #f8fafc !important;

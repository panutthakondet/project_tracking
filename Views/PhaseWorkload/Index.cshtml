@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('filterForm');
            const loading = document.getElementById('workloadLoading');

            const showLoading = () => {
                if (!loading) return;
                loading.classList.add('is-visible');
                loading.setAttribute('aria-hidden', 'false');
            };

            if (!form) return;

            let submitTimer = null;
            form.addEventListener('submit', showLoading);

            const coopFilter = document.getElementById('coopFilter');
            const projectFilter = document.getElementById('projectFilter');
            const syncProjectPeriod = document.getElementById('syncProjectPeriod');
            coopFilter?.addEventListener('change', () => {
                if (projectFilter) projectFilter.value = '';
                if (syncProjectPeriod) syncProjectPeriod.value = 'true';
            });
            projectFilter?.addEventListener('change', () => {
                if (syncProjectPeriod) syncProjectPeriod.value = 'true';
            });

            form.querySelectorAll('[data-autosubmit="true"]').forEach((control) => {
                control.addEventListener('change', () => {
                    window.clearTimeout(submitTimer);
                    submitTimer = window.setTimeout(() => {
                        showLoading();
                        if (form.requestSubmit) {
                            form.requestSubmit();
                        } else {
                            form.submit();
                        }
                    }, 220);
                });
            });

            document.querySelectorAll('.workload-view-tab').forEach((tab) => {
                tab.addEventListener('click', showLoading);
            });

            window.addEventListener('beforeunload', showLoading);

            if ('fetch' in window) {
                window.setInterval(() => {
                    if (document.visibilityState !== 'visible') return;
                    fetch('@Url.Action("KeepAlive", "PhaseWorkload")', {
                        method: 'GET',
                        credentials: 'same-origin',
                        cache: 'no-store',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    }).catch(() => {});
                }, 240000);
            }
        })();
    </script>
}

@model List<ProjectTracking.Models.PhaseAssign>

@{
    ViewData["Title"] = "ปริมาณงานทีม";

    int year = ViewBag.Year;
    int month = ViewBag.Month;

    var firstDay = new DateTime(year, month, 1);
    int daysInMonth = DateTime.DaysInMonth(year, month);

    string selectedEmpId = Context.Request.Query["empId"].ToString();

    var employees = Model
        .Where(x => x.Employee != null)
        .GroupBy(x => new
        {
            x.EmpId,
            EmpName = x.Employee!.EmpName ?? ""
        })
        .OrderBy(x => x.Key.EmpName)
        .ToList();
}

<div class="container-fluid mt-3 d-flex justify-content-center">

    <div class="card shadow-sm border-0" style="max-width: 100%;">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3 flex-nowrap gap-2">

                <h4 class="mb-0">
                    📅 ปริมาณงานทีม
                </h4>

                <div class="d-flex align-items-center gap-2 flex-nowrap justify-content-end workload-toolbar">

                    <form method="get" class="d-flex align-items-center gap-2 mb-0 flex-nowrap employee-filter-wrap">

                        <input type="hidden" name="year" value="@year" />
                        <input type="hidden" name="month" value="@month" />

                        <label class="fw-bold mb-0 text-nowrap">
                            ผู้รับผิดชอบ
                        </label>

                        <select name="empId"
                                class="form-select form-select-sm emp-select"
                                onchange="this.form.submit()">

                            <option value="">
                                -- ทั้งหมด --
                            </option>

                            @foreach (var emp in employees)
                            {
                                <option value="@emp.Key.EmpId"
                                        selected="@(selectedEmpId == emp.Key.EmpId.ToString())">
                                    @emp.Key.EmpName
                                </option>
                            }

                        </select>

                    </form>

                    <a class="btn btn-outline-secondary"
                       href="@Url.Action("Index", new {
                           year = firstDay.AddMonths(-1).Year,
                           month = firstDay.AddMonths(-1).Month,
                           empId = selectedEmpId
                       })">
                        ← เดือนก่อน
                    </a>

                    <span class="fw-bold fs-5 mx-3">
                        @(firstDay.ToString("MMMM", new System.Globalization.CultureInfo("th-TH")) + " " + (firstDay.Year + 543))
                    </span>

                    <a class="btn btn-outline-secondary"
                       href="@Url.Action("Index", new {
                           year = firstDay.AddMonths(1).Year,
                           month = firstDay.AddMonths(1).Month,
                           empId = selectedEmpId
                       })">
                        เดือนถัดไป →
                    </a>
                </div>

            </div>

            <div class="table-responsive" style="overflow-x:auto;">

                <table class="table table-bordered align-middle text-center workload-table">

                    <thead>
                        <tr>
                            <th style="min-width:220px; width:220px;">
                                ผู้รับผิดชอบ
                            </th>

                            @for (int day = 1; day <= daysInMonth; day++)
                            {
                                var date = new DateTime(year, month, day);

                                <th style="min-width:40px; width:40px;">
                                    <div>@day</div>
                                    <small class="text-muted">
                                        @date.ToString("ddd")
                                    </small>
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var emp in employees
                            .Where(e => string.IsNullOrEmpty(selectedEmpId)
                                || e.Key.EmpId.ToString() == selectedEmpId))
                        {
                            var empWorks = Model
                                .Where(x => x.EmpId == emp.Key.EmpId)
                                .OrderBy(x => x.Phase!.ProjectId)
                                .ThenBy(x => x.Phase!.PhaseSort)
                                .ToList();

                            var phaseRows = empWorks
                                .GroupBy(x => x.AssignId)
                                .Select(g => g.First())
                                .ToList();

                            foreach (var phase in phaseRows)
                            {
                                <tr>

                                    <td class="text-start bg-light phase-project-cell">
                                        @if (phase == phaseRows.First())
                                        {
                                            <div class="fw-bold mb-2">@emp.Key.EmpName</div>
                                        }

                                        <div class="fw-bold" style="font-size:13px;color:#1f2937;line-height:1.2;">
                                            @phase.Phase?.Project?.ProjectName
                                        </div>

                                        <div style="font-size:12px;color:#6b7280;line-height:1.2;">
                                            @phase.Phase?.PhaseName
                                        </div>

                                        <div style="font-size:11px;color:#9ca3af;">
                                            👤 @phase.Role
                                        </div>

                                        <div style="font-size:11px;color:#6b7280;line-height:1.3; margin-top:4px;">
                                            📅 @(phase.PlanStart?.ToString("dd MMM yy", new System.Globalization.CultureInfo("th-TH")))
                                            -
                                            @(phase.PlanEnd?.ToString("dd MMM yy", new System.Globalization.CultureInfo("th-TH")))
                                        </div>
                                    </td>

                                    @for (int day = 1; day <= daysInMonth; day++)
                                    {
                                        var currentDate = new DateTime(year, month, day);

                                        bool isWorking = phase.PlanStart.HasValue
                                            && phase.PlanEnd.HasValue
                                            && currentDate >= phase.PlanStart.Value
                                            && currentDate <= phase.PlanEnd.Value;

                                        string bgColor = phase.WorkStatus == "DONE"
                                            ? "#A3E4B5"
                                            : "#FFE69C";

                                        <td class="timeline-cell p-0 align-middle">
                                            @if (isWorking)
                                            {
                                                <a href="/PhaseAssigns?projectId=@phase.Phase?.ProjectId&phaseId=@phase.Phase?.PhaseId"
                                                   class="text-decoration-none d-block h-100">

                                                    <div class="work-item connected-work"
                                                         style="background:@bgColor">
                                                    </div>
                                                </a>
                                            }
                                        </td>
                                    }

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<style>
    .workload-table th {
        background: linear-gradient(180deg,#f8fafc,#eef2f7);
        vertical-align: middle;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 10;
        font-size: 13px;
        font-weight: 700;
        border-bottom: 2px solid #dee2e6;
    }

    .workload-table {
        min-width: max-content;
    }

    .timeline-cell {
        height: 60px;
        min-width: 34px;
        width: 34px;
        padding: 0 !important;
        vertical-align: middle !important;
        background: #fff;
        position: relative;
        border-left: 1px solid #edf1f5 !important;
        border-right: 1px solid #edf1f5 !important;
    }

    .workload-table tbody tr td {
        border-top: 1px solid #edf1f5 !important;
        border-bottom: 1px solid #edf1f5 !important;
    }

    .work-item {
        border-radius: 0;
        height: 30px;
        min-height: 30px;
        margin: 0 !important;
        transition: .15s ease;
        border: 0;
        position: relative;
        top: 50%;
        transform: translateY(-50%);
    }

    .work-item:hover {
        transform: translateY(calc(-50% - 1px));
        box-shadow: 0 4px 12px rgba(0,0,0,.14);
    }

    .connected-work {
        width: calc(100% + 2px);
        margin-left: -1px;
        border-radius: 0;
        position: relative;
        z-index: 2;
    }

    .phase-project-cell {
        min-width: 320px;
        width: 320px;
        vertical-align: middle;
        background: #fbfcfd !important;
        border-right: 2px solid #e9ecef;
        padding: 10px 14px !important;
    }
</style>

<style>
.employee-filter-wrap {
    width: 100%;
    min-width: 360px;
    max-width: 420px;
}

.emp-select {
    width: 100% !important;
    min-width: 0 !important;
    padding-right: 55px !important;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
</style>

<style>
.workload-toolbar {
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    flex-wrap: nowrap !important;
}

.workload-toolbar::-webkit-scrollbar {
    height: 6px;
}

.workload-toolbar::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 999px;
}
</style>
@using Microsoft.AspNetCore.Http
@model IEnumerable<ProjectTracking.Models.ProjectSupportOrder>

@{
    ViewData["Title"] = "Developer Orders";

    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }

    var selectedProject = ViewBag.SelectedProject as ProjectTracking.Models.Project;
    var projects = ViewBag.Projects as IEnumerable<ProjectTracking.Models.Project> ?? Enumerable.Empty<ProjectTracking.Models.Project>();
    var hasSelectedProject = selectedProject != null;
    var orders = (Model ?? Enumerable.Empty<ProjectTracking.Models.ProjectSupportOrder>()).ToList();
    var empList = ViewBag.EmpList as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var th = new System.Globalization.CultureInfo("th-TH");

    string PriorityClass(string? priority) => (priority ?? "").Trim().ToUpperInvariant() switch
    {
        "URGENT" => "bg-danger",
        "HIGH" => "bg-danger",
        "MEDIUM" => "bg-warning text-dark",
        "LOW" => "bg-success",
        _ => "bg-secondary"
    };

    string PriorityTone(string? priority) => (priority ?? "").Trim().ToUpperInvariant() switch
    {
        "URGENT" => "is-danger",
        "HIGH" => "is-danger",
        "MEDIUM" => "is-warning",
        "LOW" => "is-success",
        _ => "is-muted"
    };

    string StatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "bg-secondary",
        "WIP" => "bg-warning text-dark",
        "FIXED" => "bg-success",
        "FAIL" => "bg-danger",
        "PASS" => "bg-success",
        "REJECT" => "bg-dark",
        _ => "bg-secondary"
    };

    string DevStatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "WIP" => "bg-warning text-dark",
        "FIXED" => "bg-success",
        _ => "bg-secondary"
    };

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string DateText(DateTime? date) => date.HasValue ? date.Value.ToString("dd MMM yyyy", th) : "-";
    string PeriodText(DateTime? start, DateTime? end) =>
        !start.HasValue && !end.HasValue ? "-" : $"{DateText(start)} - {DateText(end)}";
    string ProfileImage(ProjectTracking.Models.Employee? employee)
    {
        var path = employee?.LoginUser?.ProfileImagePath;
        if (string.IsNullOrWhiteSpace(path)) return "/images/Profile/profile.png";

        path = path.Trim();
        if (path.StartsWith("~/", StringComparison.Ordinal)) path = path[1..];
        if (!path.StartsWith("/", StringComparison.Ordinal)) path = "/" + path.TrimStart('/');
        return path;
    }
}

<style>
    .support-dev-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
    }

    .support-dev-hero {
        color: #fff;
        background:
            radial-gradient(circle at 86% 8%, rgba(20, 184, 166, .28), transparent 28%),
            linear-gradient(135deg, #10233f, #1f3b63);
        border-radius: 22px;
        padding: 22px 24px;
        margin-bottom: 16px;
        box-shadow: 0 18px 40px rgba(15, 35, 64, .18);
    }

    .support-dev-title {
        margin: 0;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 700;
        line-height: 1.25;
    }

    .support-dev-subtitle {
        color: #d8e6f7;
        font-weight: 700;
        margin: 6px 0 0;
    }

    .support-dev-filter,
    .support-dev-card,
    .support-dev-empty {
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    }

    .support-dev-filter {
        padding: 18px;
        margin-bottom: 16px;
    }

    .support-dev-filter .form-select {
        width: 100%;
        min-height: 46px;
        border-radius: 14px;
        font-weight: 800;
    }

    .support-dev-list {
        display: grid;
        gap: 14px;
    }

    .support-dev-card {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(300px, .46fr);
        overflow: hidden;
        border-left: 5px solid #94a3b8;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .support-dev-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 34px rgba(15, 35, 64, .12);
    }

    .support-dev-card.is-danger {
        border-left-color: #ef4444;
    }

    .support-dev-card.is-warning {
        border-left-color: #f59e0b;
    }

    .support-dev-card.is-success {
        border-left-color: #22c55e;
    }

    .support-dev-main,
    .support-dev-side {
        min-width: 0;
        padding: 18px;
    }

    .support-dev-side {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-end;
        gap: 14px;
        background: transparent;
        border-left: 0;
    }

    .support-dev-head {
        display: block;
        margin-bottom: 10px;
    }

    .support-dev-no {
        flex: 0 0 auto;
        min-width: 2.75rem;
        height: 2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #062b2f;
        background: rgba(20, 184, 166, .18);
        border-radius: 999px;
        font-weight: 700;
    }

    .support-dev-title-wrap {
        min-width: 0;
    }

    .support-dev-title-line {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 8px;
    }

    .support-dev-order-title {
        display: block;
        color: #0f172a;
        font-size: .98rem;
        font-weight: 700;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .support-dev-project {
        margin-top: 4px;
        color: #0f172a;
        font-size: .93rem;
        font-weight: 400;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .support-dev-detail {
        color: #0f172a;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: .93rem;
        font-weight: 400;
        line-height: 1.45;
        margin: .25rem 0 0;
        overflow-wrap: anywhere;
    }

    .support-dev-order-title strong,
    .support-dev-project strong,
    .support-dev-detail strong {
        color: #0f172a;
        font-weight: 700;
    }

    .support-dev-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 16px;
        color: #0f172a;
        font-size: .92rem;
        line-height: 1.35;
        margin-top: 8px;
        margin-bottom: 6px;
    }

    .support-dev-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        min-height: 0;
        padding: 0;
        color: #0f172a;
        background: transparent;
        border: 0;
        border-radius: 0;
        font-size: .92rem;
        font-weight: 400;
    }

    .support-dev-pill strong {
        color: #0f172a;
        font-weight: 700;
    }

    .support-dev-card-people {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        align-items: center;
        gap: 10px 18px;
        margin: 10px 0 0;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: #0f172a;
        font-size: .95rem;
        font-weight: 400;
    }

    .support-dev-card-person {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        color: #0f172a;
        font-weight: 400;
        line-height: 1.25;
    }

    .support-dev-card-person img {
        width: 36px;
        height: 36px;
        flex: 0 0 auto;
        border: 1px solid #dbe6f3;
        border-radius: 50%;
        object-fit: cover;
        background: #fff;
    }

    .support-dev-card-person span {
        overflow-wrap: anywhere;
    }

    .support-dev-card-person strong {
        color: #0f172a;
        font-weight: 600;
    }

    .support-dev-status-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin-top: 10px;
        width: 100%;
    }

    .support-dev-status-row {
        min-width: 0;
        display: inline-flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
    }

    .support-dev-status-row small {
        color: #0f172a;
        font-size: .92rem;
        font-weight: 700;
        text-transform: none;
    }

    .support-dev-status-row small::after {
        content: ":";
    }

    .support-dev-status-row .badge {
        min-height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: normal;
        line-height: 1.15;
        text-align: center;
    }

    .support-dev-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
    }

    .support-dev-empty {
        color: #64748b;
        padding: 28px;
        text-align: center;
        font-weight: 800;
    }

    @@media (max-width: 991.98px) {
        .support-dev-card {
            grid-template-columns: 1fr;
        }

        .support-dev-side {
            border-left: 0;
            border-top: 0;
            align-items: stretch;
            padding-top: 0;
        }

        .support-dev-actions {
            justify-content: flex-end;
        }
    }
</style>

<div class="support-dev-page">
    <div class="support-dev-hero index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="support-dev-title index-title">Developer Orders</h2>
            <p class="support-dev-subtitle index-subtitle">รายการงานแก้ไขสำหรับทีมพัฒนา อัปเดตสถานะและแนบหลักฐานการแก้ไข</p>
        </div>
    </div>

    <form method="get" id="supportDevFilterForm" class="support-dev-filter">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-semibold">โครงการ</label>
                <select id="projectSelect"
                        name="projectId"
                        class="form-select"
                        onchange="supportOrdersDevProjectChanged(this)">
                    <option value="">-- เลือกโครงการ --</option>
                    @foreach (var p in projects.OrderBy(x => x.Coop?.CoopName ?? "").ThenBy(x => x.ProjectName))
                    {
                        <option value="@p.ProjectId" selected="@(selectedProject?.ProjectId == p.ProjectId)">
                            @p.ProjectDisplayName
                        </option>
                    }
                </select>
            </div>
            @if (hasSelectedProject)
            {
                <div class="col-md-6">
                    <label class="form-label fw-semibold">เจ้าของงาน</label>
                    <select id="supportDevOwnerSelect" name="empId" class="form-select" onchange="supportOrdersDevOwnerChanged(this)">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (var emp in empList)
                        {
                            <option value="@emp.Value" selected="@(emp.Selected ? "selected" : null)">@emp.Text</option>
                        }
                    </select>
                </div>
            }
        </div>
    </form>

    @if (!hasSelectedProject)
    {
        <div class="support-dev-empty">
            กรุณาเลือก Project ก่อนเพื่อแสดงรายการงาน
        </div>
    }
    else if (!orders.Any())
    {
        <div class="support-dev-empty">
            ไม่พบรายการงานในโครงการนี้
        </div>
    }
    else
    {
        <div class="support-dev-list">
            @{
                var no = 1;
            }

            @foreach (var item in orders)
            {
                <article class="support-dev-card @PriorityTone(item.Priority)">
                    <section class="support-dev-main">
                        <div class="support-dev-head">
                            <div class="support-dev-title-wrap">
                                <div class="support-dev-title-line">
                                    <span class="support-dev-no">#@no</span>
                                </div>
                                <span class="support-dev-order-title"><span class="pt-list-label">หัวข้องาน:</span> <span class="pt-list-value">@TextOrDash(item.OrderTitle)</span></span>
                                <div class="support-dev-project"><span class="pt-list-label">โครงการ:</span> <span class="pt-list-value">@TextOrDash(item.Project?.ProjectDisplayName)</span></div>
                                <p class="support-dev-detail"><span class="pt-list-label">รายละเอียดงาน:</span> <span class="pt-list-value">@TextOrDash(item.OrderDetail)</span></p>
                            </div>
                        </div>

                        <div class="support-dev-meta">
                            <span class="support-dev-pill"><span class="pt-list-label">วันที่กำหนด:</span> <span class="pt-list-value">@PeriodText(item.StartDate, item.EndDate)</span></span>
                        </div>

                        <div class="support-dev-card-people">
                            <span class="support-dev-card-person">
                                <img class="pt-owner-avatar"
                                     src="@ProfileImage(item.Employee)"
                                     alt="@(item.Employee?.EmpName ?? "ผู้รับผิดชอบ")"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                <span><span class="pt-list-label">ผู้รับผิดชอบ:</span> <span class="pt-list-value">@TextOrDash(item.Employee?.EmpName)</span></span>
                            </span>
                        </div>

                        <div class="support-dev-status-grid">
                            <div class="support-dev-status-row">
                                <small class="pt-list-label">ความสำคัญ</small>
                                <span class="badge @PriorityClass(item.Priority) pt-list-value">@TextOrDash(item.Priority)</span>
                            </div>
                            <div class="support-dev-status-row">
                                <small class="pt-list-label">สถานะ</small>
                                <span class="badge @StatusClass(item.Status) pt-list-value">@TextOrDash(item.Status)</span>
                            </div>
                            <div class="support-dev-status-row">
                                <small class="pt-list-label">สถานะ Dev</small>
                                <span class="badge @DevStatusClass(item.DevStatus) pt-list-value">@TextOrDash(item.DevStatus)</span>
                            </div>
                        </div>
                    </section>

                    <aside class="support-dev-side">
                        <div class="support-dev-actions">
                            @if (CanMenu("SupportOrdersDev.Details"))
                            {
                                <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-secondary" title="ดูรายละเอียด">
                                    ดูรายละเอียด
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดูรายละเอียด">
                                    ดูรายละเอียด
                                </button>
                            }

                            @if (CanMenu("SupportOrdersDev.Edit"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-primary" title="แก้ไข/แก้บั๊ก">
                                    แก้ไข
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                    แก้ไข
                                </button>
                            }
                        </div>
                    </aside>
                </article>

                no++;
            }
        </div>
    }
</div>

<script>
function supportOrdersDevGo(projectId, empId) {
    var url = new URL('/SupportOrdersDev', window.location.origin);
    if (projectId) url.searchParams.set('projectId', projectId);
    if (empId) url.searchParams.set('empId', empId);
    window.location.href = url.pathname + url.search;
}

function supportOrdersDevProjectChanged(select) {
    supportOrdersDevGo(select ? select.value : '', '');
}

function supportOrdersDevOwnerChanged(select) {
    var projectSelect = document.getElementById('projectSelect');
    supportOrdersDevGo(projectSelect ? projectSelect.value : '', select ? select.value : '');
}

(function () {
    var projectSelect = document.getElementById('projectSelect');
    if (!projectSelect || projectSelect.dataset.supportOrdersDevReady === 'true') return;
    projectSelect.dataset.supportOrdersDevReady = 'true';
    projectSelect.addEventListener('change', function () {
        supportOrdersDevProjectChanged(projectSelect);
    });
})();
</script>

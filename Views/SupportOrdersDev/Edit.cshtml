@model ProjectTracking.Models.ProjectSupportOrder
@using System.Globalization
@using System.Linq

@{
    ViewData["Title"] = "แก้ไขงานสนับสนุน";

    var order = Model ?? new ProjectTracking.Models.ProjectSupportOrder();
    var th = new CultureInfo("th-TH");
    var beforeImages = order.Images?.ToList() ?? new List<ProjectTracking.Models.ProjectSupportImage>();
    var afterImages = order.FixImages?
        .Where(x => string.Equals(x.ImageType, "AFTER", StringComparison.OrdinalIgnoreCase))
        .ToList() ?? new List<ProjectTracking.Models.ProjectSupportFixImage>();
    var currentDevStatus = (ViewBag.CurrentDevStatus as string) ?? order.DevStatus ?? "-";

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string DateText(DateTime? value) => value?.ToString("dd MMM yyyy", th) ?? "-";

    string PriorityClass(string? priority) => (priority ?? "").Trim().ToUpperInvariant() switch
    {
        "URGENT" => "danger",
        "HIGH" => "danger",
        "MEDIUM" => "warning",
        "LOW" => "success",
        _ => "muted"
    };

    string StatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "muted",
        "WIP" => "warning",
        "FIXED" => "success",
        "FAIL" => "danger",
        "PASS" => "success",
        "REJECT" => "muted",
        _ => "muted"
    };

}

<style>
    .support-dev-edit-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
    }

    .support-dev-readonly {
        min-height: 46px;
        padding: .72rem .9rem;
        border: 1px solid #d8e3ef;
        border-radius: 14px;
        color: #10233f;
        background: #f8fbff;
        font-weight: 800;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .support-dev-readonly.is-tall {
        min-height: 110px;
        font-weight: 400;
        white-space: pre-wrap;
    }

    .support-dev-edit-page .form-select {
        width: 100%;
        min-height: 46px;
        border-radius: 14px;
        font-weight: 800;
    }

    .support-dev-current-status {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 8px;
        color: #64748b;
        font-size: .9rem;
        font-weight: 800;
    }

    .support-dev-current-status__badge {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: 4px 10px;
        border-radius: 999px;
        background: #fef3c7;
        color: #92400e;
        font-weight: 900;
    }

    .support-dev-edit-page textarea.form-control {
        min-height: 130px;
        border-radius: 14px;
        line-height: 1.5;
    }

    .status-text {
        font-weight: 900;
        letter-spacing: .01em;
    }

    .status-text.success { color: #0f8f5f; }
    .status-text.warning { color: #b7790b; }
    .status-text.info { color: #0f6fa8; }
    .status-text.danger { color: #d6294f; }
    .status-text.muted { color: #64748b; }

    .support-dev-gallery {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .support-dev-image-card {
        width: 150px;
        padding: 8px;
        border: 1px solid #d8e3ef;
        border-radius: 14px;
        background: #fff;
        text-align: center;
    }

    .support-dev-image-card img {
        width: 100%;
        height: 110px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        margin-bottom: 6px;
    }
</style>

<div class="support-dev-edit-page">
    <h3>แก้ไขงานสนับสนุน</h3>

    <form asp-action="Edit" asp-route-id="@order.OrderId" asp-route-projectId="@order.ProjectId" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="OrderId" />
        <input type="hidden" asp-for="ProjectId" />

        <div class="card shadow-sm pt-form-card">
            <div class="card-body">
                <div class="mb-3">
                    <label>Project</label>
                    <div class="support-dev-readonly">@TextOrDash(order.Project?.ProjectDisplayName)</div>
                </div>

                <div class="mb-3">
                    <label>Title</label>
                    <div class="support-dev-readonly">@TextOrDash(order.OrderTitle)</div>
                </div>

                <div class="mb-3">
                    <label>Detail</label>
                    <div class="support-dev-readonly is-tall">@TextOrDash(order.OrderDetail)</div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label>Priority</label>
                        <div class="support-dev-readonly">
                            <span class="status-text @PriorityClass(order.Priority)">@TextOrDash(order.Priority)</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label>Status</label>
                        <div class="support-dev-readonly">
                            <span class="status-text @StatusClass(order.Status)">@TextOrDash(order.Status)</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label>Dev Status</label>
                        <div class="support-dev-current-status">
                            <span>Dev Status ปัจจุบัน</span>
                            <span class="support-dev-current-status__badge">@TextOrDash(currentDevStatus)</span>
                        </div>
                        <input type="hidden" asp-for="DevStatus" value="FIXED" />
                        <div class="support-dev-readonly">
                            <span class="status-text success">FIXED - แก้เสร็จ / ส่งตรวจ</span>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label>วันที่เริ่ม</label>
                        <div class="support-dev-readonly">@DateText(order.StartDate)</div>
                    </div>

                    <div class="col-md-6">
                        <label>วันที่สิ้นสุด</label>
                        <div class="support-dev-readonly">@DateText(order.EndDate)</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="DevDetail">รายละเอียดการแก้ไข</label>
                    <textarea asp-for="DevDetail"
                              class="form-control"
                              placeholder="ระบุรายละเอียดการแก้ไข หรือหมายเหตุจากโปรแกรมเมอร์"></textarea>
                    <span asp-validation-for="DevDetail" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label>BA Images</label>
                    @if (beforeImages.Any())
                    {
                        <div class="support-dev-gallery">
                            @foreach (var img in beforeImages)
                            {
                                <div class="support-dev-image-card">
                                    <img src="@Url.Content("~" + img.FilePath)" alt="@TextOrDash(img.FileName)" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No BA images.</p>
                    }
                </div>

                <div class="mb-3">
                    <label>Upload After Fix Images</label>
                    <input type="file" name="afterFiles" class="form-control" multiple />
                </div>

                <div class="mb-3">
                    <label>Existing After Fix Images</label>
                    @if (afterImages.Any())
                    {
                        <div class="support-dev-gallery">
                            @foreach (var img in afterImages)
                            {
                                <div class="support-dev-image-card">
                                    <img src="@img.FilePath" alt="After fix image" />
                                    <div class="form-check text-start">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="deleteImageIds"
                                               value="@img.ImageId"
                                               id="del_@img.ImageId" />
                                        <label class="form-check-label text-danger" for="del_@img.ImageId">
                                            Delete
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No after fix images.</p>
                    }
                </div>

                <div class="pt-form-actions">
                    <button type="submit" class="btn btn-primary">Save Fix</button>
                    <a asp-action="Index" asp-route-projectId="@order.ProjectId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

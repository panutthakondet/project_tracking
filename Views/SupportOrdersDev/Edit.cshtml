@model ProjectTracking.Models.ProjectSupportOrder
@using System.Globalization
@using System.Linq

@{
    ViewData["Title"] = "อัปเดตการแก้ไขงาน Support";

    var order = Model ?? new ProjectTracking.Models.ProjectSupportOrder();
    var th = new CultureInfo("th-TH");
    var beforeImages = order.Images?.ToList() ?? new List<ProjectTracking.Models.ProjectSupportImage>();
    var afterImages = order.FixImages?
        .Where(x => string.Equals(x.ImageType, "AFTER", StringComparison.OrdinalIgnoreCase))
        .ToList() ?? new List<ProjectTracking.Models.ProjectSupportFixImage>();
    var gitHistories = ViewBag.GitHistories as IEnumerable<ProjectTracking.Models.ProjectSupportOrderGitHistory>
        ?? new List<ProjectTracking.Models.ProjectSupportOrderGitHistory>();
    var currentDevStatus = (ViewBag.CurrentDevStatus as string) ?? order.DevStatus ?? "-";
    var projectName = order.Project?.ProjectDisplayName ?? $"Project #{order.ProjectId}";

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string DateText(DateTime? value) => value?.ToString("dd MMM yyyy", th) ?? "-";

    string PriorityClass(string? priority) => (priority ?? "").Trim().ToUpperInvariant() switch
    {
        "URGENT" => "danger",
        "HIGH" => "danger",
        "MEDIUM" => "warning",
        "LOW" => "success",
        _ => "muted"
    };

    string StatusTone(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "status-field--open",
        "WIP" => "status-field--wip",
        "FIXED" => "status-field--fixed",
        "FAIL" => "status-field--fail",
        "PASS" => "status-field--pass",
        "REJECT" => "status-field--reject",
        _ => "status-field--neutral"
    };
}

<style>
    .support-dev-edit-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
    }

    .support-dev-readonly {
        min-height: 46px;
        padding: .72rem .9rem;
        border: 1px solid #d8e3ef;
        border-radius: 14px;
        color: #10233f;
        background: #f8fbff;
        font-weight: 800;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .support-dev-readonly.is-tall {
        min-height: 110px;
        font-weight: 400;
        white-space: pre-wrap;
    }

    .support-dev-edit-page .form-select {
        width: 100%;
        min-height: 46px;
        border-radius: 14px;
        font-weight: 800;
    }

    .support-dev-edit-page textarea.form-control {
        min-height: 130px;
        border-radius: 14px;
        line-height: 1.5;
    }

    .status-text {
        font-weight: 900;
        letter-spacing: .01em;
    }

    .status-text.success { color: #0f8f5f; }
    .status-text.warning { color: #b7790b; }
    .status-text.info { color: #0f6fa8; }
    .status-text.danger { color: #d6294f; }
    .status-text.muted { color: #64748b; }

    .pt-form-card .status-field {
        font-weight: 900 !important;
        transition: background-color .15s ease, border-color .15s ease, color .15s ease;
    }

    .pt-form-card .status-field.status-field--open {
        color: #9a3412 !important;
        background-color: #ffedd5 !important;
        border-color: #fdba74 !important;
    }

    .pt-form-card .status-field.status-field--pass,
    .pt-form-card .status-field.status-field--fixed {
        color: #166534 !important;
        background-color: #dcfce7 !important;
        border-color: #86efac !important;
    }

    .pt-form-card .status-field.status-field--fail {
        color: #be123c !important;
        background-color: #ffe4e6 !important;
        border-color: #fda4af !important;
    }

    .pt-form-card .status-field.status-field--reject {
        color: #334155 !important;
        background-color: #e2e8f0 !important;
        border-color: #94a3b8 !important;
    }

    .pt-form-card .status-field.status-field--wip {
        color: #854d0e !important;
        background-color: #fef3c7 !important;
        border-color: #fde68a !important;
    }

    .pt-form-card .status-field.status-field--neutral {
        color: #475569 !important;
        background-color: #f8fafc !important;
        border-color: #cbd5e1 !important;
    }

    .support-dev-gallery {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .support-dev-image-card {
        width: 150px;
        padding: 8px;
        border: 1px solid #d8e3ef;
        border-radius: 14px;
        background: #fff;
        text-align: center;
    }

    .support-dev-image-card img {
        width: 100%;
        height: 110px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        margin-bottom: 6px;
    }

    .dev-git-panel {
        border: 1px solid #cfe0f2;
        border-radius: 16px;
        background: linear-gradient(135deg, #f8fbff, #eff6ff);
        padding: 16px;
    }

    .dev-git-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .dev-git-title {
        margin: 0;
        color: #10233f;
        font-size: 1.05rem;
        font-weight: 900;
    }

    .dev-git-table {
        width: 100%;
        margin-bottom: 14px;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

    .dev-git-table th {
        color: #64748b !important;
        background: transparent !important;
        border: 0 !important;
        box-shadow: none !important;
        font-size: .82rem;
        font-weight: 900;
        padding: 0 10px;
    }

    .dev-git-table thead,
    .dev-git-table thead tr {
        background: transparent !important;
        border: 0 !important;
        box-shadow: none !important;
    }

    .dev-git-table td {
        padding: 10px;
        color: #10233f;
        background: #fff;
        border-top: 1px solid #dbe8f5;
        border-bottom: 1px solid #dbe8f5;
        font-weight: 800;
    }

    .dev-git-table td:first-child {
        border-left: 1px solid #dbe8f5;
        border-radius: 12px 0 0 12px;
    }

    .dev-git-table td:last-child {
        border-right: 1px solid #dbe8f5;
        border-radius: 0 12px 12px 0;
    }

    .dev-git-id {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: .86rem;
        overflow-wrap: anywhere;
    }

    .dev-git-badge {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: 4px 10px;
        border-radius: 999px;
        color: #075985;
        background: #e0f2fe;
        font-size: .82rem;
        font-weight: 900;
    }

    .dev-git-row {
        display: grid;
        grid-template-columns: minmax(150px, 180px) 1fr auto;
        gap: 10px;
        margin-bottom: 10px;
    }

    .dev-git-row .form-select,
    .dev-git-row .form-control {
        min-height: 46px;
        border-radius: 12px;
        font-weight: 800;
    }

    .dev-git-remove {
        min-width: 52px;
        border-radius: 12px;
        font-weight: 900;
    }

    .dev-git-panel.is-disabled .dev-git-new {
        opacity: .55;
        pointer-events: none;
    }

    .support-dev-empty {
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        color: #64748b;
        background: #f8fafc;
        padding: 18px;
        font-weight: 800;
        text-align: center;
        margin-bottom: 14px;
    }

    @@media (max-width: 768px) {
        .dev-git-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">อัปเดตการแก้ไขงาน Support</h2>
        <p class="index-subtitle">Support Order Dev #@order.OrderId · @projectName</p>
    </div>
</div>

<div class="support-dev-edit-page">
    <form asp-action="Edit" asp-route-id="@order.OrderId" asp-route-projectId="@order.ProjectId" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="OrderId" />
        <input type="hidden" asp-for="ProjectId" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card shadow-sm pt-form-card">
            <div class="card-body">
                <div class="mb-3">
                    <label>Project</label>
                    <div class="support-dev-readonly">@projectName</div>
                </div>

                <div class="mb-3">
                    <label>Title</label>
                    <div class="support-dev-readonly">@TextOrDash(order.OrderTitle)</div>
                </div>

                <div class="mb-3">
                    <label>Detail</label>
                    <div class="support-dev-readonly is-tall">@TextOrDash(order.OrderDetail)</div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label>เจ้าของงาน</label>
                        <div class="support-dev-readonly">@TextOrDash(order.Employee?.EmpName)</div>
                    </div>

                    <div class="col-md-4">
                        <label>Status</label>
                        <div class="support-dev-readonly status-field @StatusTone(order.Status)">@TextOrDash(order.Status)</div>
                    </div>

                    <div class="col-md-4">
                        <label>Dev Status</label>
                        <select asp-for="DevStatus"
                                asp-items="ViewBag.DevStatusList"
                                class="form-select status-field @StatusTone(order.DevStatus)"
                                data-status-tone></select>
                        <span asp-validation-for="DevStatus" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label>Priority</label>
                        <div class="support-dev-readonly">
                            <span class="status-text @PriorityClass(order.Priority)">@TextOrDash(order.Priority)</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label>วันที่เริ่ม</label>
                        <div class="support-dev-readonly">@DateText(order.StartDate)</div>
                    </div>

                    <div class="col-md-4">
                        <label>วันที่สิ้นสุด</label>
                        <div class="support-dev-readonly">@DateText(order.EndDate)</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="DevDetail">รายละเอียดการแก้ไข</label>
                    <textarea asp-for="DevDetail"
                              class="form-control"
                              placeholder="ระบุรายละเอียดการแก้ไข หรือหมายเหตุจากโปรแกรมเมอร์"></textarea>
                    <span asp-validation-for="DevDetail" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <div class="dev-git-panel" data-git-history-panel>
                        <div class="dev-git-head">
                            <h3 class="dev-git-title">ประวัติ Git</h3>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-add-git-row>
                                + เพิ่มแถว
                            </button>
                        </div>

                        @if (gitHistories.Any())
                        {
                            <table class="dev-git-table">
                                <thead>
                                    <tr>
                                        <th>ประเภท</th>
                                        <th>Git ID</th>
                                        <th>วันที่บันทึก</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in gitHistories)
                                    {
                                        <tr>
                                            <td><span class="dev-git-badge">@row.GitType</span></td>
                                            <td class="dev-git-id">@row.GitId</td>
                                            <td>@row.EntryDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="support-dev-empty">ยังไม่มีประวัติ Git</div>
                        }

                        <div class="dev-git-new" data-git-rows>
                            <div class="dev-git-row">
                                <select name="gitTypes" class="form-select">
                                    <option value="GITHUB">GITHUB</option>
                                    <option value="GITLAB">GITLAB</option>
                                </select>
                                <input type="text"
                                       name="gitIds"
                                       class="form-control"
                                       maxlength="80"
                                       placeholder="Git ID เช่น 8ba2994a809ebaea3d8f1c69e5dbd9abe8482fb2" />
                                <button type="button" class="btn btn-outline-danger dev-git-remove" data-remove-git-row>-</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label>BA Images</label>
                    @if (beforeImages.Any())
                    {
                        <div class="support-dev-gallery">
                            @foreach (var img in beforeImages)
                            {
                                <div class="support-dev-image-card">
                                    <img src="@Url.Content("~" + img.FilePath)" alt="@TextOrDash(img.FileName)" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No BA images.</p>
                    }
                </div>

                <div class="mb-3">
                    <label>Upload After Fix Images</label>
                    <input type="file" name="afterFiles" class="form-control" multiple accept="image/*" data-paste-image-upload />
                    <small class="text-muted d-block mt-2">
                        เลือกได้หลายรูป หรือ Copy รูป/Screenshot แล้วกด Ctrl+V / Cmd+V เพื่อวาง
                    </small>
                </div>

                <div class="mb-3">
                    <label>Existing After Fix Images</label>
                    @if (afterImages.Any())
                    {
                        <div class="support-dev-gallery">
                            @foreach (var img in afterImages)
                            {
                                <div class="support-dev-image-card">
                                    <img src="@img.FilePath" alt="After fix image" />
                                    <div class="form-check text-start">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="deleteImageIds"
                                               value="@img.ImageId"
                                               id="del_@img.ImageId" />
                                        <label class="form-check-label text-danger" for="del_@img.ImageId">
                                            Delete
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No after fix images.</p>
                    }
                </div>

                <div class="pt-form-actions">
                    <button type="submit" class="btn btn-primary">Save Fix</button>
                    <a asp-action="Index" asp-route-projectId="@order.ProjectId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/paste-image-upload.js" asp-append-version="true"></script>
    <script>
        const statusToneClasses = [
            'status-field--open',
            'status-field--pass',
            'status-field--fail',
            'status-field--reject',
            'status-field--wip',
            'status-field--fixed',
            'status-field--neutral'
        ];

        function statusToneClass(value) {
            switch ((value || '').trim().toUpperCase()) {
                case 'OPEN': return 'status-field--open';
                case 'PASS': return 'status-field--pass';
                case 'FAIL': return 'status-field--fail';
                case 'REJECT': return 'status-field--reject';
                case 'WIP': return 'status-field--wip';
                case 'FIXED': return 'status-field--fixed';
                default: return 'status-field--neutral';
            }
        }

        function statusToneTargets(select) {
            const wrapper = select?.nextElementSibling?.classList?.contains('pt-search-select')
                ? select.nextElementSibling
                : null;
            return [
                select,
                wrapper?.querySelector('.pt-search-select__input')
            ].filter(Boolean);
        }

        function applyStatusTone(select) {
            if (!select) return;
            const toneClass = statusToneClass(select.value);
            statusToneTargets(select).forEach(target => {
                target.classList.add('status-field');
                target.classList.remove(...statusToneClasses);
                target.classList.add(toneClass);
            });
        }

        function applyAllStatusTones() {
            document.querySelectorAll('[data-status-tone]').forEach(select => applyStatusTone(select));
        }

        document.querySelectorAll('[data-status-tone]').forEach(select => {
            select.addEventListener('change', () => setTimeout(() => applyStatusTone(select), 0));
        });
        applyAllStatusTones();
        setTimeout(applyAllStatusTones, 0);
        setTimeout(applyAllStatusTones, 100);

        new MutationObserver(applyAllStatusTones)
            .observe(document.body, { childList: true, subtree: true });

        const currentDbDevStatus = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentDevStatus));
        const canEditGitHistoryFromDb = (currentDbDevStatus || '').trim().toUpperCase() === 'WIP';

        function createGitRow() {
            const row = document.createElement('div');
            row.className = 'dev-git-row';
            row.innerHTML = `
                <select name="gitTypes" class="form-select">
                    <option value="GITHUB">GITHUB</option>
                    <option value="GITLAB">GITLAB</option>
                </select>
                <input type="text"
                       name="gitIds"
                       class="form-control"
                       maxlength="80"
                       placeholder="Git ID เช่น 8ba2994a809ebaea3d8f1c69e5dbd9abe8482fb2" />
                <button type="button" class="btn btn-outline-danger dev-git-remove" data-remove-git-row>-</button>
            `;
            return row;
        }

        function syncGitHistoryState() {
            const panel = document.querySelector('[data-git-history-panel]');
            const canEditGit = canEditGitHistoryFromDb;
            panel?.classList.toggle('is-disabled', !canEditGit);
            panel?.querySelectorAll('[name="gitTypes"], [name="gitIds"], [data-add-git-row], [data-remove-git-row]')
                .forEach(input => input.disabled = !canEditGit);
        }

        document.querySelector('[data-add-git-row]')?.addEventListener('click', () => {
            document.querySelector('[data-git-rows]')?.appendChild(createGitRow());
            syncGitHistoryState();
        });

        document.querySelector('[data-git-rows]')?.addEventListener('click', event => {
            const button = event.target.closest('[data-remove-git-row]');
            if (!button) return;

            const rows = document.querySelectorAll('.dev-git-row');
            const row = button.closest('.dev-git-row');
            if (rows.length <= 1) {
                row?.querySelectorAll('input').forEach(input => input.value = '');
                return;
            }

            row?.remove();
        });

        syncGitHistoryState();

        document.querySelector('form').addEventListener('submit', function (event) {
            const nextDevStatus = (document.getElementById('DevStatus')?.value || '').trim().toUpperCase();

            const devStatusText = currentDbDevStatus.toUpperCase() === nextDevStatus
                ? `${nextDevStatus} (คงเดิม)`
                : `${currentDbDevStatus} -> ${nextDevStatus}`;

            const confirmed = confirm([
                'กำลังบันทึกการเปลี่ยนแปลงข้อมูลงาน Support Dev',
                `Dev Status: ${devStatusText}`,
                'ยืนยันการบันทึกหรือไม่?'
            ].join('\n'));

            if (!confirmed) {
                event.preventDefault();
                event.stopImmediatePropagation();
            }
        }, true);
    </script>
}

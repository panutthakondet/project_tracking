@using ProjectTracking.Models
@{
    var torItems = ViewBag.TorItems as IEnumerable<ProjectTorItem> ?? Array.Empty<ProjectTorItem>();
    var scenarios = ViewBag.ProjectScenarios as IEnumerable<TestScenario> ?? Array.Empty<TestScenario>();
    var selectedTor = ViewBag.SelectedTorItemIds as HashSet<int> ?? new HashSet<int>();
    var selectedScenarios = ViewBag.SelectedScenarioIds as HashSet<int> ?? new HashSet<int>();
}
<div class="col-12">
    <div class="development-selection-head">
        <div>
            <label class="form-label fw-semibold mb-0">Checklist ตาม TOR</label>
            <div class="text-muted small">เลือกรายการที่ Dev ต้องตรวจให้ครบก่อนส่ง BA</div>
        </div>
        <a asp-controller="ProjectTorItems" asp-action="Index" asp-route-projectId="@ViewBag.ProjectId" class="btn btn-outline-primary btn-sm">จัดการรายการ TOR</a>
    </div>
    <div class="development-selection-list">
        @if (!torItems.Any()) { <div class="text-muted">ยังไม่มีรายการ TOR ของโครงการนี้</div> }
        @foreach (var item in torItems)
        {
            <label class="development-check-row">
                <input type="checkbox" name="torItemIds" value="@item.TorItemId" checked="@selectedTor.Contains(item.TorItemId)" />
                <span><strong>@item.TorCode</strong> @item.Title</span>
            </label>
        }
    </div>
</div>
<div class="col-12">
    <label class="form-label fw-semibold mb-0">Test Scenarios สำหรับ Dev และ BA</label>
    <div class="text-muted small mb-2">ทั้งสองฝ่ายใช้ Scenario ชุดเดียวกัน แต่ระบบเก็บผลทดสอบแยกกัน</div>
    <div class="development-selection-list">
        @if (!scenarios.Any()) { <div class="text-muted">ยังไม่มี Test Scenario ของโครงการนี้</div> }
        @foreach (var item in scenarios)
        {
            <label class="development-check-row">
                <input type="checkbox" name="scenarioIds" value="@item.scenario_id" checked="@selectedScenarios.Contains(item.scenario_id)" />
                <span><strong>@item.scenario_code</strong> @item.title</span>
            </label>
        }
    </div>
</div>

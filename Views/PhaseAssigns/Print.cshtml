@model IEnumerable<ProjectTracking.Models.PhaseAssign>
@using System.Globalization

@{
    Layout = null;
    var th = new CultureInfo("th-TH");
    var assignments = (Model ?? Enumerable.Empty<ProjectTracking.Models.PhaseAssign>())
        .OrderBy(a => a.Phase?.PhaseOrder ?? a.PhaseOrder ?? int.MaxValue)
        .ThenBy(a => a.Phase?.PeriodOrder ?? int.MaxValue)
        .ThenBy(a => a.PhaseSort ?? int.MaxValue)
        .ThenBy(a => a.AssignId)
        .ToList();
    var projectList = (ViewBag.Projects as IEnumerable<ProjectTracking.Models.Project> ?? Enumerable.Empty<ProjectTracking.Models.Project>()).ToList();
    var selectedProjectId = ViewBag.SelectedProjectId is int projectId ? projectId : (int?)null;
    var selectedProject = ViewBag.SelectedProject as ProjectTracking.Models.Project;
    var selectedCoopName = (selectedProject?.Coop?.CoopName ?? "").Trim();
    var coopList = projectList
        .Select(p => p.Coop?.CoopName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    var statusDefinitions = ViewBag.PhaseAssignStatuses as IEnumerable<ProjectTracking.Models.StatusDefinitionOption>
        ?? Enumerable.Empty<ProjectTracking.Models.StatusDefinitionOption>();
    var statusKpis = statusDefinitions
        .OrderBy(x => x.SortOrder)
        .Select((definition, index) => new
        {
            Definition = definition,
            Count = assignments.Count(a => a.StatusId == definition.StatusId
                || (!a.StatusId.HasValue && string.Equals(a.WorkStatus, definition.StatusCode, StringComparison.OrdinalIgnoreCase))),
            ClassName = index % 2 == 0 ? "" : "warning"
        })
        .ToList();
    var roleCount = assignments
        .Select(a => a.Role)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .Count();

    string FormatDate(DateTime? value)
    {
        return value?.ToString("dd MMM yyyy", th) ?? "-";
    }

    string WorkStatusClass(string? status)
    {
        return (status ?? "").Trim().ToUpperInvariant() switch
        {
            "DONE" => "status-text success",
            "IN_PROGRESS" => "status-text warning",
            _ => "status-text muted"
        };
    }

    string LogStatusText(string? status)
    {
        return (status ?? "").Trim().ToUpperInvariant() switch
        {
            "PASS" => "ผ่าน",
            "FAIL" => "แก้ไข",
            _ => string.IsNullOrWhiteSpace(status) ? "-" : status
        };
    }

    string LogStatusClass(string? status)
    {
        return (status ?? "").Trim().ToUpperInvariant() switch
        {
            "PASS" => "status-text success",
            "FAIL" => "status-text danger",
            _ => "status-text muted"
        };
    }

    string PhaseName(ProjectTracking.Models.PhaseAssign a)
    {
        return string.IsNullOrWhiteSpace(a.Phase?.PhaseName) ? "-" : a.Phase.PhaseName;
    }

    string PhasePeriod(ProjectTracking.Models.PhaseAssign a)
    {
        return a.Phase == null ? "-" : $"ส่วนที่ {a.Phase.PhaseOrder} / งวดที่ {a.Phase.PeriodOrder}";
    }
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>Assignment Report</title>
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&display=swap");
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 16px;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
        }
        .report-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }
        .report-btn {
            min-height: 34px;
            padding: 7px 13px;
            border: 1px solid #102443;
            border-radius: 999px;
            color: #102443;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 900;
            line-height: 1.1;
            text-decoration: none;
            cursor: pointer;
        }
        .report-btn.primary {
            color: #fff;
            background: #102443;
        }
        .print-header {
            margin-bottom: 12px;
            padding: 14px 16px;
            color: #fff;
            background: #102443;
        }
        .print-header h1 {
            margin: 0 0 6px;
            font-size: 22px;
        }
        .print-header div {
            color: rgba(255,255,255,.82);
            font-weight: 700;
            line-height: 1.55;
        }
        .filter-panel {
            display: grid;
            grid-template-columns: repeat(4, minmax(180px, 1fr));
            gap: 10px;
            margin-bottom: 12px;
            padding: 12px;
            border: 1px solid #d8e3ef;
            background: #f8fbff;
        }
        .field label {
            display: block;
            margin-bottom: 5px;
            color: #64748b;
            font-weight: 900;
        }
        .field select {
            width: 100%;
            min-height: 34px;
            padding: 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
        }
        .pt-native-select-hidden {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            min-height: 1px !important;
            opacity: 0 !important;
            pointer-events: none !important;
            clip-path: inset(50%) !important;
        }
        .pt-search-select {
            position: relative;
            width: 100%;
        }
        .pt-search-select__field {
            position: relative;
        }
        .pt-search-select__input {
            width: 100%;
            min-height: 34px;
            padding: 7px 38px 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            outline: none;
        }
        .pt-search-select__input:focus {
            border-color: #14b8a6;
            box-shadow: 0 0 0 3px rgba(20, 184, 166, .12);
        }        .pt-search-select__dropdown {
            position: absolute;
            left: 0;
            right: 0;
            top: calc(100% + 4px);
            z-index: 20;
            width: 100%;
            max-height: 240px;
            overflow-y: auto;
            display: none;
            border: 1px solid #d8e2ef;
            background: #fff;
            box-shadow: 0 12px 26px rgba(15, 35, 64, .14);
        }
        .pt-search-select.is-open .pt-search-select__dropdown {
            display: block;
        }
        .pt-search-select__option {
            width: 100%;
            padding: 8px 10px;
            border: 0;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.35;
            text-align: left;
            cursor: pointer;
        }
        .pt-search-select__option:hover,
        .pt-search-select__option.is-selected {
            color: #062b2f;
            background: rgba(20, 184, 166, .14);
        }
        .pt-search-select__empty {
            padding: 10px;
            color: #64748b;
            font-weight: 800;
            text-align: center;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-bottom: 12px;
        }
        .kpi {
            padding: 10px;
            border: 1px solid #d8e3ef;
            border-left: 4px solid #14b8a6;
        }
        .kpi.info { border-left-color: #258cfb; }
        .kpi.warning { border-left-color: #f59e0b; }
        .kpi span,
        .kpi small {
            display: block;
            color: #64748b;
            font-weight: 800;
        }
        .kpi strong {
            display: block;
            margin: 5px 0;
            color: #10233f;
            font-size: 20px;
            font-weight: 900;
        }
        h2 {
            margin: 14px 0 8px;
            color: #10233f;
            font-size: 16px;
            font-weight: 900;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin-bottom: 12px;
        }
        th {
            padding: 7px 6px;
            color: #fff;
            background: #102443;
            border: 1px solid rgba(255,255,255,.18);
            font-weight: 900;
            text-align: center;
        }
        td {
            padding: 7px 6px;
            border: 1px solid #d8e3ef;
            line-height: 1.45;
            vertical-align: top;
            overflow-wrap: anywhere;
        }
        tr:nth-child(even) td {
            background: #f8fbff;
        }
        .text-center {
            text-align: center;
        }
        .status-text {
            font-weight: 900;
            white-space: nowrap;
        }
        .status-text.success { color: #0f8f5f; }
        .status-text.warning { color: #b7790b; }
        .status-text.danger { color: #d6294f; }
        .status-text.muted { color: #64748b; }
        .empty {
            padding: 18px;
            border: 1px dashed #cbd5e1;
            color: #64748b;
            text-align: center;
            font-weight: 800;
        }
        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
        @@media print {
            body { padding: 0; }
            .no-print,
            .report-actions,
            .filter-panel { display: none !important; }
            h2, h3,
            .project-group-row,
            .scenario-project__header,
            .scenario-group__header,
            .phase-project-group {
                break-after: avoid;
                page-break-after: avoid;
            }
            h2 + table,
            h2 + .empty,
            h2 + .report-table-scroll,
            h3 + table,
            h3 + .empty,
            .project-group-row + tr {
                break-before: avoid;
                page-break-before: avoid;
            }
            .report-section,
            .scenario-project,
            .scenario-group,
            .project-group-row,
            .phase-project-group {
                break-inside: avoid-page;
                page-break-inside: avoid;
            }
            thead { display: table-header-group; }
            tr { page-break-inside: avoid; }
        }
        @@media (max-width: 900px) {
            .filter-panel,
            .kpi-grid {
                grid-template-columns: 1fr;
            }
        }
    
        /* Crisp typography normalization for standalone pages. */
        :root { --pt-readable-thai-font: "Noto Sans Thai", "Leelawadee UI", Tahoma, "Segoe UI", Arial, sans-serif; }
        html, body {
            font-family: var(--pt-readable-thai-font) !important;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }
        body :where(*):not(svg):not(svg *) {
            font-family: var(--pt-readable-thai-font) !important;
            font-stretch: normal !important;
            letter-spacing: 0 !important;
            text-shadow: none !important;
        }
        body :is(h1, h2, h3, h4, h5, h6, th, label, strong, b, .report-btn, .btn, .badge, .status-text, .cell-title, .project-group-name, [class*="title"], [class*="heading"], [class*="eyebrow"], [class*="status"], [class*="badge"], [class*="count"], [class*="total"], [class*="value"]) {
            font-weight: 700 !important;
        }
        body :is(p, li, td, small, em, time, .cell-sub, .detail-block div, .meta-label, .meta-value, .empty, [class*="detail"], [class*="meta"], [class*="subtitle"], [class*="description"], [class*="desc"], [class*="remark"], [class*="note"], [class*="empty"]):not(.btn):not(.badge):not(.status-text):not([class*="status-"]):not([class*="Status"]) {
            font-weight: 400 !important;
        }
</style>
@await Html.PartialAsync("_StandaloneTheme")
</head>
<body class="pt-standalone-report">
    <div class="report-actions">
        <button type="button" class="report-btn primary" onclick="window.print()">Print</button>
        <a asp-controller="Reports" asp-action="Index" class="report-btn">Report Center</a>
        <a asp-controller="Home" asp-action="Index" class="report-btn">Dashboard</a>
        @if (assignments.Any())
        {
            <a asp-action="Form"
               asp-route-id="@assignments.First().AssignId"
               target="_blank"
               class="report-btn">
                Print Form
            </a>
        }
    </div>

    <header class="print-header">
        <h1>Assignment Report</h1>
        <div>
            Cooperative: @(string.IsNullOrWhiteSpace(selectedCoopName) ? "All Cooperatives" : selectedCoopName)<br />
            Project: @(selectedProject?.ProjectDisplayName ?? "All Projects")<br />
            Employee: @(ViewBag.SelectedEmpId == null ? "All Employees" : (ViewBag.EmployeeList as IEnumerable<ProjectTracking.Models.Employee>)?.FirstOrDefault(e => e.EmpId == ViewBag.SelectedEmpId)?.EmpName ?? "-")<br />
            Role: @(string.IsNullOrWhiteSpace(ViewBag.SelectedRole as string) ? "All Roles" : ViewBag.SelectedRole)<br />
            ข้อมูล ณ @DateTime.Now.ToString("dd MMM yyyy HH:mm", th)
        </div>
    </header>

    <form method="get" class="filter-panel no-print">
        <div class="field">
            <label for="departmentId">ฝ่าย</label>
            <select id="departmentId" name="departmentId" onchange="this.form.submit()">
                <option value="">ทุกฝ่าย</option>
                @foreach (var department in (IEnumerable<ProjectTracking.Models.ProjectDepartment>)(ViewBag.ProjectDepartments ?? Enumerable.Empty<ProjectTracking.Models.ProjectDepartment>()))
                { <option value="@department.DepartmentId" selected="@(ViewBag.SelectedDepartmentId is int id && id == department.DepartmentId ? "selected" : null)">@department.DepartmentName</option> }
            </select>
        </div>
        <div class="field">
            <label for="coopFilter">Cooperative</label>
            <select id="coopFilter" data-placeholder="🔍 พิมพ์ค้นหาสหกรณ์...">
                <option value="">-- All Cooperatives --</option>
                @foreach (var coop in coopList)
                {
                    <option value="@coop" selected="@(string.Equals(selectedCoopName, coop, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@coop</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="projectId">Project</label>
            <select id="projectId" name="projectId" data-placeholder="🔍 พิมพ์ค้นหา Project..." onchange="this.form.submit()">
                <option value="">-- All Projects --</option>
                @foreach (var p in projectList)
                {
                    <option value="@p.ProjectId"
                            data-coop-name="@(p.Coop?.CoopName ?? "")"
                            selected="@(selectedProjectId == p.ProjectId ? "selected" : null)">
                        @p.ProjectDisplayName
                    </option>
                }
            </select>
        </div>

        <div class="field">
            <label for="empId">Employee</label>
            <select id="empId" name="empId" data-placeholder="🔍 พิมพ์ค้นหา Employee..." onchange="this.form.submit()">
                <option value="">-- All Employees --</option>
                @foreach (var e in ViewBag.EmployeeList)
                {
                    <option value="@e.EmpId" selected="@(ViewBag.SelectedEmpId == e.EmpId ? "selected" : null)">
                        @e.EmpName
                    </option>
                }
            </select>
        </div>

        <div class="field">
            <label for="role">Role</label>
            <select id="role" name="role" data-placeholder="🔍 พิมพ์ค้นหา Role..." onchange="this.form.submit()">
                <option value="">-- All Roles --</option>
                @foreach (var r in ViewBag.RoleList ?? new List<string>())
                {
                    <option value="@r" selected="@(ViewBag.SelectedRole == r ? "selected" : null)">
                        @r
                    </option>
                }
            </select>
        </div>
    </form>

    <section class="kpi-grid">
        <article class="kpi info">
            <span>Total Assignments</span>
            <strong>@assignments.Count</strong>
            <small>รายการมอบหมายทั้งหมด</small>
        </article>
        @foreach (var statusKpi in statusKpis)
        {
            <article class="kpi @statusKpi.ClassName">
                <span>@statusKpi.Definition.StatusCode</span>
                <strong>@statusKpi.Count</strong>
                <small>@statusKpi.Definition.StatusDesc</small>
            </article>
        }
        <article class="kpi">
            <span>Roles</span>
            <strong>@roleCount</strong>
            <small>บทบาทที่เกี่ยวข้อง</small>
        </article>
    </section>

    <h2>Assignment List</h2>
    @if (!assignments.Any())
    {
        <div class="empty">— No assignment —</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th style="width:42px;">Seq</th>
                    <th style="width:170px;">Employee</th>
                    <th style="width:100px;">ส่วน / งวด</th>
                    <th>ส่วนงาน</th>
                    <th style="width:170px;">Role</th>
                    <th style="width:92px;">Status</th>
                    <th style="width:150px;">Plan Date</th>
                    <th style="width:150px;">กำหนดส่งงวดงาน</th>
                    <th>Assign / Log</th>
                </tr>
            </thead>
            <tbody>
            @{
                var seq = 1;
            }
            @foreach (var assignment in assignments)
            {
                var lastLog = assignment.Logs?
                    .OrderByDescending(l => l.RoundNo)
                    .FirstOrDefault();

                <tr>
                    <td class="text-center">@seq</td>
                    <td>@(assignment.Employee != null ? assignment.Employee.EmpName : "-")</td>
                    <td class="text-center">@PhasePeriod(assignment)</td>
                    <td>@PhaseName(assignment)</td>
                    <td>@(string.IsNullOrWhiteSpace(assignment.Role) ? "-" : assignment.Role)</td>
                    <td class="text-center">
                        <span class="@WorkStatusClass(assignment.WorkStatus)">
                            @assignment.StatusDescription
                        </span>
                    </td>
                    <td class="text-center">@FormatDate(assignment.PlanStart) - @FormatDate(assignment.PlanEnd)</td>
                    <td class="text-center">@FormatDate(assignment.Phase?.PeriodEndDate)</td>
                    <td>
                        <div><b>Assign:</b> @(string.IsNullOrWhiteSpace(assignment.Remark) ? "-" : assignment.Remark)</div>
                        @if (lastLog != null)
                        {
                            <div>
                                <b>Log:</b>
                                <span class="@LogStatusClass(lastLog.Status)">@LogStatusText(lastLog.Status)</span>
                                @(string.IsNullOrWhiteSpace(lastLog.Remark) ? "-" : lastLog.Remark)
                            </div>
                        }
                    </td>
                </tr>

                seq++;
            }
            </tbody>
        </table>
    }

    <script>
        (function () {
            function normalize(value) {
                return (value || "").toString().trim().toLowerCase();
            }

            function getSelectedOption(select) {
                return select.options[select.selectedIndex] || null;
            }

            function hasEmptyOption(select) {
                return Array.from(select.options).some(option => option.value === "");
            }

            function dispatchSelectChange(select) {
                select.dispatchEvent(new Event("input", { bubbles: true }));
                select.dispatchEvent(new Event("change", { bubbles: true }));
            }

            function enhanceSelect(select) {
                if (!select || select.classList.contains("pt-dropdown-enhanced")) return;

                const wrapper = document.createElement("div");
                wrapper.className = "pt-search-select";

                const field = document.createElement("div");
                field.className = "pt-search-select__field";

                const input = document.createElement("input");
                input.type = "text";
                input.className = "pt-search-select__input";
                input.autocomplete = "off";
                input.placeholder = select.dataset.placeholder || getSelectedOption(select)?.text || "🔍 พิมพ์ค้นหา...";
                const dropdown = document.createElement("div");
                dropdown.className = "pt-search-select__dropdown";

                field.appendChild(input);
                wrapper.appendChild(field);
                wrapper.appendChild(dropdown);
                select.insertAdjacentElement("afterend", wrapper);
                select.classList.add("pt-dropdown-enhanced", "pt-native-select-hidden");
                select.tabIndex = -1;

                function syncInputFromSelect() {
                    const selected = getSelectedOption(select);
                    input.value = selected ? selected.text : "";
                }

                function closeDropdown() {
                    wrapper.classList.remove("is-open");
                }

                function renderOptions(filter = "") {
                    dropdown.innerHTML = "";
                    const keyword = normalize(filter);
                    const options = Array.from(select.options)
                        .filter(option => !option.disabled)
                        .filter(option => {
                            const haystack = normalize(`${option.text} ${option.value}`);
                            return !keyword || haystack.includes(keyword);
                        });

                    if (options.length === 0) {
                        const empty = document.createElement("div");
                        empty.className = "pt-search-select__empty";
                        empty.textContent = "ไม่พบข้อมูล";
                        dropdown.appendChild(empty);
                        return;
                    }

                    options.forEach(option => {
                        const item = document.createElement("button");
                        item.type = "button";
                        item.className = "pt-search-select__option";
                        if (option.value === select.value) item.classList.add("is-selected");
                        item.textContent = option.text;
                        item.addEventListener("click", function () {
                            select.value = option.value;
                            input.value = option.text;
                            closeDropdown();
                            syncInputFromSelect();
                            dispatchSelectChange(select);
                        });
                        dropdown.appendChild(item);
                    });
                }

                function openDropdown() {
                    input.value = "";
                    renderOptions(input.value);
                    wrapper.classList.add("is-open");
                }
                input.addEventListener("focus", openDropdown);
                input.addEventListener("click", openDropdown);
                input.addEventListener("input", function () {
                    renderOptions(input.value);
                    wrapper.classList.add("is-open");
                });
                input.addEventListener("keydown", function (event) {
                    if (event.key === "Escape") {
                        closeDropdown();
                        syncInputFromSelect();
                    }
                });
                select.addEventListener("change", syncInputFromSelect);
                document.addEventListener("click", function (event) {
                    if (!wrapper.contains(event.target)) {
                        closeDropdown();
                        syncInputFromSelect();
                    }
                });

                syncInputFromSelect();
            }

            // Native dropdowns: custom search-select disabled globally.


            document.querySelectorAll(".filter-panel select").forEach(enhanceSelect);

            const coopFilter = document.getElementById("coopFilter");
            const projectFilter = document.getElementById("projectId");

            function syncProjectOptionsByCoop() {
                const selectedCoop = normalize(coopFilter?.value || "");
                Array.from(projectFilter?.options || []).forEach(option => {
                    option.disabled = option.value !== "" &&
                        selectedCoop &&
                        normalize(option.dataset.coopName || "") !== selectedCoop;
                });

                const selected = projectFilter?.selectedOptions[0];
                if (selected && selected.disabled && projectFilter) {
                    projectFilter.value = "";
                    dispatchSelectChange(projectFilter);
                }
            }

            coopFilter?.addEventListener("change", syncProjectOptionsByCoop);
            syncProjectOptionsByCoop();
        })();

    </script>
</body>
</html>

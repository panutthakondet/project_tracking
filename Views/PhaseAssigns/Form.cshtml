@model ProjectTracking.Models.PhaseAssign
@using System.Globalization

@{
    Layout = null;
    var th = new CultureInfo("th-TH");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>บันทึกภายใน</title>

    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap");
        @@page {
            size: A4 portrait;
            margin-top: 14mm;
            margin-right: 16mm;
            margin-bottom: 12mm;
            margin-left: 18mm;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            color: #111;
            background: #fff;
            font-family: "TH Sarabun New", "Sarabun", "Noto Sans Thai", Tahoma, Arial, sans-serif;
            font-size: 14pt;
            font-weight: 400;
            line-height: 1.36;
        }

        .header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 2px;
        }

        .logo {
            width: 70px;
            flex: 0 0 auto;
        }

        .company {
            font-size: 9.5pt;
            line-height: 1.25;
        }

        .company b {
            font-size: 10.5pt;
            font-weight: 700;
        }

        .title {
            text-align: center;
            font-size: 18pt;
            font-weight: 500;
            margin: 10px 0 6px;
        }

        .date {
            text-align: center;
            margin-bottom: 8px;
        }

        .row {
            margin-bottom: 3px;
            line-height: 1.28;
        }

        .label {
            font-weight: 600;
        }

        .line {
            display: inline-block;
            min-width: 340px;
            border-bottom: 1px dotted #000;
            padding-left: 4px;
        }

        .text-value {
            padding-left: 4px;
            font-weight: 400;
        }

        .section {
            margin-top: 8px;
        }

        .comment-line {
            border-bottom: 1px dotted #000;
            height: 24px;
            margin-bottom: 6px;
        }


        .checkbox-row {
            margin: 8px 0;
        }

        .sign-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 18px;
            font-size: 14pt;

            page-break-inside: avoid;
            break-inside: avoid;
        }

        .sign-cell {
            border: 2px solid #000;
            padding: 10px 8px;
            text-align: center;
            vertical-align: middle;
            height: 95px;
            font-weight: 400;
        }

        .sign-full {
            height: 105px;
        }
    
        /* Crisp typography normalization for standalone pages. */
        :root { --pt-readable-thai-font: "TH Sarabun New", "Sarabun", "Noto Sans Thai", "Leelawadee UI", Tahoma, "Segoe UI", Arial, sans-serif; }
        html, body {
            font-family: var(--pt-readable-thai-font) !important;
            text-rendering: auto;
            -webkit-font-smoothing: auto;
        }
        body :where(*):not(svg):not(svg *) {
            font-family: var(--pt-readable-thai-font) !important;
            font-stretch: normal !important;
            letter-spacing: 0 !important;
            text-shadow: none !important;
        }

        hr {
            margin: 2px 0 8px;
            border: 0;
            border-top: 1px solid #111;
        }
</style>
</head>

<body onload="window.print()">

    <!-- HEADER -->
    <div class="header">
        <img src="@Url.Content("~/images/auth/logosoat.png")" class="logo" />
        <div class="company">
            <b>SO-AT SOLUTION COMPANY LIMITED</b><br />
            165/57 Ramindra Road, Monument Sub-District, Bangkhen District, Bangkok 10220<br />
            Tel. 0-2059-0511
        </div>
    </div>

    <hr />

    <div class="title">บันทึกภายใน</div>

    <div class="date">
        วันที่ @DateTime.Now.ToString("dd MMMM yyyy", th)
    </div>

    <!-- CONTENT -->
    <div class="row">
        <span class="label">เรื่อง</span>
        ขออนุมัติตรวจงานการพัฒนาระบบ เพื่อขอเข้าทดสอบระบบ
        <span class="text-value">@Model.Role</span>
    </div>

    <div class="row">
        <span class="label">ชื่อโครงการ :</span>
        <span class="text-value">@Model.Phase?.Project?.ProjectDisplayName</span>
    </div>

    <div class="row">
        <span class="label">ส่วนที่ :</span>
        <span class="text-value">@Model.Phase?.PhaseOrder</span>
    </div>

    <div class="row">
        <span class="label">งวดที่ :</span>
        <span class="text-value">@Model.Phase?.PeriodOrder</span>
    </div>

    <div class="row">
        <span class="label">รายละเอียดงานในงวด :</span>
        <span class="text-value">@Model.Role</span>
    </div>

    <div class="row">
        <span class="label">ชื่อผู้รับผิดชอบโครงการ :</span>
        <span class="text-value">@Model.Employee?.EmpName</span>
    </div>

    <div class="section">
        <div class="row"><span class="label">ชื่อลิงก์ :</span><span class="text-value">@Model.Phase?.Project?.LinkName</span></div>
        <div class="row"><span class="label">ฐานข้อมูลที่ใช้ :</span><span class="text-value">@Model.Phase?.Project?.DatabaseName</span></div>
        <div class="row"><span class="label">ทะเบียนที่ใช้ทดสอบ :</span><span class="text-value">@Model.Phase?.Project?.TestAccount</span></div>
        <div class="row"><span class="label">Remote / URL / AnyDesk / IP :</span><span class="text-value">@Model.Phase?.Project?.RemoteUrl</span></div>
    </div>

    <!-- COMMENT -->
    <div class="section">
        <div class="label">ความคิดเห็น</div>
        @{
            var logs = Model.Logs != null
                ? ((IEnumerable<ProjectTracking.Models.PhaseAssignLog>)Model.Logs)
                    .OrderBy(l => l.RoundNo)
                    .ToList()
                : new List<ProjectTracking.Models.PhaseAssignLog>();
            var lastLog = logs.OrderByDescending(l => l.RoundNo).FirstOrDefault();
        }

        @if (logs.Any())
        {
            <div class="text-value" style="margin-top:0; padding:0 8px 4px 8px; min-height:60px; line-height:1.0;">
                @foreach (var log in logs)
                {
                    var statusText = log?.Status == "PASS" ? "ผ่าน" : "แก้ไข และนำเสนอใหม่";

                    <div style="margin-bottom:0;">
                        <div style="font-weight:bold; margin-bottom:0;">
                            ครั้งที่ @(log?.RoundNo ?? 0) : @statusText
                        </div>
                        <div style="padding-left:20px; margin:0;">
                            @(string.IsNullOrWhiteSpace(log?.Remark) ? "-" : log?.Remark.Trim())
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div>
                @for (int i = 0; i < 4; i++)
                {
                    <div class="comment-line"></div>
                }
            </div>
        }
    </div>



    <!-- SIGNATURE -->
    <div style="page-break-inside: avoid; break-inside: avoid; page-break-before: auto;">
    <table class="sign-table">
        <tr>
            <td class="sign-cell">
                ลงชื่อผู้พัฒนา<br /><br />
                ( @Model.Employee?.EmpName )<br />
                ตำแหน่ง @Model.Employee?.Position
            </td>

            <td class="sign-cell">
                ลงชื่อผู้รับเข้าทดสอบ<br /><br />
                ( @ViewBag.BusinessAnalyst?.EmpName )<br />
                ตำแหน่ง Business Analyst
            </td>
        </tr>

        <tr>
            <td class="sign-cell sign-full" colspan="2">
                ลงชื่อผู้จัดการโครงการ<br /><br />
                ( นายปณัฐกรณ์เดช เมืองจันทร์ )<br />
                ตำแหน่ง ผู้จัดการโครงการ
            </td>
        </tr>
    </table>
    </div>

</body>
</html>

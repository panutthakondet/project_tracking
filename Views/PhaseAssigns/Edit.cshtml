@model ProjectTracking.Models.PhaseAssign

@{
    ViewData["Title"] = "Edit Assignment";

    DateTime? planStart = Model?.PlanStart;
    DateTime? planEnd = Model?.PlanEnd;

    var ps = planStart.GetValueOrDefault();
    var pe = planEnd.GetValueOrDefault();

    string planStartText = planStart.HasValue
        ? $"{ps:dd/MM/}{ps.Year + 543}"
        : "";

    string planEndText = planEnd.HasValue
        ? $"{pe:dd/MM/}{pe.Year + 543}"
        : "";
}

<!-- ================= HEADER ================= -->
<div class="mb-4">
    <h2 class="fw-bold">✏️ Edit Assignment</h2>
    <p class="text-muted mb-0">
        แก้ไขการมอบหมายงานของพนักงาน
    </p>
</div>

<!-- ================= FORM CARD ================= -->
<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Edit"
              asp-route-id="@(Model?.AssignId ?? 0)"
              method="post"
              onsubmit="return confirm('บันทึกการแก้ไขหรือไม่?');">

            @Html.AntiForgeryToken()

            <!-- ================= KEYS ================= -->
            <input type="hidden" asp-for="AssignId" />

            <div class="row g-3">

                <!-- ================= EMPLOYEE ================= -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        👤 Employee
                    </label>
                    <select asp-for="EmpId"
                            asp-items="ViewBag.Employees"
                            class="form-select"
                            required>
                        <option value="">-- Select Employee --</option>
                    </select>
                    <span asp-validation-for="EmpId"
                          class="text-danger"></span>
                </div>

                <!-- ================= PHASE ================= -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        🧩 Phase
                    </label>
                    <select asp-for="PhaseId"
                            asp-items="ViewBag.Phases"
                            class="form-select"
                            required>
                        <option value="">-- Select Phase --</option>
                    </select>
                    <span asp-validation-for="PhaseId" class="text-danger"></span>
                </div>

                <!-- ================= ROLE ================= -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        🎯 Role
                    </label>
                    <input asp-for="Role"
                           type="text"
                           class="form-control"
                           placeholder="Role / หน้าที่" />
                    <span asp-validation-for="Role" class="text-danger"></span>
                    <small class="text-muted">
                        * Role จะเปลี่ยนตาม Phase อัตโนมัติ (ถ้ายังไม่ได้แก้เอง) และสามารถแก้ไขเองได้
                    </small>
                </div>

                <!-- ================= PLAN START ================= -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        📅 Plan Start
                    </label>
                    <input asp-for="PlanStart"
                           type="text"
                           class="form-control thai-date"
                           id="PlanStart"
                           value="@planStartText"
                           placeholder="วว/ดด/ปปปป" />
                </div>

                <!-- ================= PLAN END ================= -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        📅 Plan End
                    </label>
                    <input asp-for="PlanEnd"
                           type="text"
                           class="form-control thai-date"
                           id="PlanEnd"
                           value="@planEndText"
                           placeholder="วว/ดด/ปปปป" />
                </div>

                <!-- ================= WORK STATUS ================= -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        📌 Status
                    </label>
                    <select asp-for="WorkStatus"
                            class="form-select">
                        <option value="IN_PROGRESS">
                            🟡 กำลังดำเนินการ
                        </option>
                        <option value="DONE">
                            ✅ เสร็จสิ้น
                        </option>
                    </select>
                </div>

                <!-- ================= REMARK ================= -->
                <div class="col-md-12">
                    <label class="form-label fw-semibold">
                        📝 Remark
                    </label>
                    <textarea asp-for="Remark"
                              class="form-control"
                              rows="4"
                              maxlength="1000"
                              placeholder="รายละเอียดเพิ่มเติม / หมายเหตุ (สูงสุด 1000 ตัวอักษร)"></textarea>
                    <small id="remarkCounter" class="text-muted">0 / 1000</small>
                </div>

            </div>

            <!-- ================= BUTTONS ================= -->
            <div class="mt-4 d-flex gap-2">
                <button type="submit"
                        class="btn btn-primary">
                    💾 Save Changes
                </button>

                <a asp-action="Index"
                   asp-route-projectId="@ViewBag.ProjectId"
                   class="btn btn-outline-secondary">
                    ↩ Back
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const phaseSelect = document.querySelector('select[name="PhaseId"], select#PhaseId');
            const roleInput = document.querySelector('input[name="Role"], input#Role');
            if (!phaseSelect || !roleInput) return;

            // Track whether the user manually customized Role.
            // Role will auto-follow Phase only if the user hasn't customized it,
            // or if Role still equals the last auto-filled value.
            let roleTouched = false;
            let lastAutoRole = '';

            function getSelectedPhaseName() {
                const opt = phaseSelect.options[phaseSelect.selectedIndex];
                if (!opt) return '';
                const text = (opt.textContent || opt.innerText || '').trim();
                // Ignore placeholder option
                if (!text || text.startsWith('--')) return '';
                return text;
            }

            // Initialize lastAutoRole: if current Role equals current PhaseName, treat it as auto.
            (function initAutoRole() {
                const curPhaseName = getSelectedPhaseName();
                const curRole = (roleInput.value || '').trim();
                if (curPhaseName && curRole && curRole === curPhaseName) {
                    lastAutoRole = curRole;
                }
            })();

            roleInput.addEventListener('input', function () {
                roleTouched = true;
                // Once user types, stop auto-tracking
                lastAutoRole = '';
                // If user clears Role, allow auto again
                if (!roleInput.value || roleInput.value.trim() === '') {
                    roleTouched = false;
                }
            });

            function applyRoleFromPhase(force) {
                const name = getSelectedPhaseName();
                if (!name) return;

                const cur = (roleInput.value || '').trim();

                // Update Role if:
                // - forced
                // - user never typed
                // - Role is empty
                // - Role equals the previous auto-filled value
                if (force || !roleTouched || cur === '' || (lastAutoRole && cur === lastAutoRole)) {
                    roleInput.value = name;
                    lastAutoRole = name;
                }
            }

            let lastPhaseValue = phaseSelect.value;
            function onPhaseChanged() {
                if (phaseSelect.value !== lastPhaseValue) {
                    lastPhaseValue = phaseSelect.value;
                    applyRoleFromPhase(false);
                }
            }

            // Sync once on load IF Role empty OR equals selected Phase name
            const initialPhaseName = getSelectedPhaseName();
            const initialRole = (roleInput.value || '').trim();
            if (initialRole === '' || (initialPhaseName && initialRole === initialPhaseName)) {
                applyRoleFromPhase(true);
            }

            // Update on phase change (native)
            phaseSelect.addEventListener('change', function () {
                lastPhaseValue = phaseSelect.value;
                applyRoleFromPhase(false);
            });

            // Update on phase change (Select2/jQuery)
            if (window.jQuery) {
                try {
                    window.jQuery(phaseSelect).on('select2:select select2:clear', function () {
                        lastPhaseValue = phaseSelect.value;
                        applyRoleFromPhase(false);
                    });
                } catch (e) {
                    // ignore
                }
            }

            // Fallback: detect programmatic changes
            setInterval(onPhaseChanged, 300);
        })();

        // Remark counter
        (function () {
            const ta = document.querySelector('textarea[name="Remark"]');
            const counter = document.getElementById('remarkCounter');
            if (!ta || !counter) return;

            function update() {
                const len = ta.value ? ta.value.length : 0;
                counter.textContent = len + ' / 1000';
                if (len > 900) {
                    counter.classList.remove('text-muted');
                    counter.classList.add('text-danger');
                } else {
                    counter.classList.remove('text-danger');
                    counter.classList.add('text-muted');
                }
            }

            ta.addEventListener('input', update);
            update();
        })();
        function convertThaiDateToIso(value) {
            if (!value || !value.trim()) return '';

            const parts = value.trim().split('/');
            if (parts.length !== 3) return value;

            let [d, m, y] = parts;

            d = d.padStart(2, '0');
            m = m.padStart(2, '0');
            y = parseInt(y, 10);

            if (y > 2400) {
                y -= 543;
            }

            return `${y}-${m}-${d}`;
        }

        function formatThaiDateInput(input) {
            if (!input) return;

            input.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');

                if (value.length > 8) {
                    value = value.substring(0, 8);
                }

                if (value.length >= 5) {
                    value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
                } else if (value.length >= 3) {
                    value = `${value.substring(0, 2)}/${value.substring(2)}`;
                }

                e.target.value = value;
            });
        }

        const planStartInput = document.getElementById('PlanStart');
        const planEndInput = document.getElementById('PlanEnd');

        formatThaiDateInput(planStartInput);
        formatThaiDateInput(planEndInput);

        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function () {
                document.querySelectorAll('.thai-date').forEach(input => {
                    input.value = convertThaiDateToIso(input.value);
                });
            });
        }
    </script>
}

@model ProjectTracking.Models.PhaseAssign

@{
    ViewData["Title"] = "แก้ไขการมอบหมายงาน";

    DateTime? planStart = Model?.PlanStart;
    DateTime? planEnd = Model?.PlanEnd;

    var ps = planStart.GetValueOrDefault();
    var pe = planEnd.GetValueOrDefault();

    string planStartText = planStart.HasValue
        ? $"{ps:dd/MM/}{ps.Year + 543}"
        : "";

    string planEndText = planEnd.HasValue
        ? $"{pe:dd/MM/}{pe.Year + 543}"
        : "";

    var requirementProjectCardDetailUrlTemplate = Url.Action("ProjectCardDetails", "RequirementBoard", new { projectId = "__PROJECT_ID__" }) ?? "";
}

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">แก้ไขการมอบหมายงาน</h2>
        <p class="index-subtitle">แก้ไขการมอบหมายงาน ผู้รับผิดชอบ แผนงาน และสถานะงาน</p>
    </div>

</div>

<div class="card shadow-sm pt-form-card">
    <div class="card-body">

        <form asp-action="Edit"
              asp-route-id="@(Model?.AssignId ?? 0)"
              method="post"
              onsubmit="return confirm('บันทึกการแก้ไขหรือไม่?');">

            @Html.AntiForgeryToken()

            <!-- ================= KEYS ================= -->
            <input type="hidden" asp-for="AssignId" />
            <input type="hidden" name="projectId" id="ProjectId" value="@ViewBag.ProjectId" />

            <div class="project-board-card-picker project-board-card-picker--button mb-3">
                <button id="RequirementCardDetailButton"
                        type="button"
                        class="btn btn-outline-primary project-board-card-detail"
                        data-detail-project-url-template="@requirementProjectCardDetailUrlTemplate"
                        data-project-field-id="ProjectId">
                    ดูรายละเอียด Project Board
                </button>
            </div>

            <div class="row g-3">

                <!-- ================= EMPLOYEE ================= -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        ผู้รับผิดชอบ
                    </label>
                    <select asp-for="EmpId"
                            asp-items="ViewBag.Employees"
                            class="form-select"
                            required>
                        <option value="">-- เลือกผู้รับผิดชอบ --</option>
                    </select>
                    <span asp-validation-for="EmpId"
                          class="text-danger"></span>
                </div>

                <!-- ================= SECTION / PERIOD ================= -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        ส่วนงาน / งวดงาน
                    </label>
                    <select asp-for="PhaseId"
                            class="form-select"
                            required
                            id="phaseSelect"
                            data-initial-phase-id="@Model?.PhaseId">
                        <option value="">-- เลือกส่วนงาน / งวดงาน --</option>

                        @if (ViewBag.PhaseItems != null)
                        {
                            foreach (var ph in ViewBag.PhaseItems)
                            {
                                var phaseStart = ph.PlanStart == null ? "" : ((DateTime)ph.PlanStart).ToString("yyyy-MM-dd");
                                var phaseEnd = ph.PlanEnd == null ? "" : ((DateTime)ph.PlanEnd).ToString("yyyy-MM-dd");
                                <option value="@ph.PhaseId"
                                        selected="@(Model?.PhaseId == ph.PhaseId)"
                                        data-role="@ph.PhaseName"
                                        data-plan-start="@phaseStart"
                                        data-plan-end="@phaseEnd"
                                        data-phase-order="@ph.PhaseOrder"
                                        data-period-order="@ph.PeriodOrder">
                                    @ph.PhaseDisplayName
                                </option>
                            }
                        }
                    </select>
                    <span asp-validation-for="PhaseId" class="text-danger"></span>
                </div>

                <!-- ================= ROLE ================= -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        งานที่รับผิดชอบ
                    </label>
                    <input asp-for="Role"
                           type="text"
                           class="form-control"
                           placeholder="ระบุงานที่รับผิดชอบ" />
                    <span asp-validation-for="Role" class="text-danger"></span>
                    <small class="text-muted">
                        * งานที่รับผิดชอบจะเปลี่ยนตามชื่อส่วนงานอัตโนมัติ ถ้ายังไม่ได้แก้เอง และสามารถแก้ไขเองได้
                    </small>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        วันที่ตามงวดงาน
                    </label>
                    <button id="UsePhaseDatesButton"
                            type="button"
                            class="btn btn-outline-info w-100"
                            title="ดึงกำหนดวันที่เริ่มและสิ้นสุดจากงวดงานที่เลือก">
                        ใช้วันที่จากงวดงาน
                    </button>
                    <small id="phaseDateHint" class="text-muted d-block mt-1">
                        ดึงจากกำหนดวันที่เริ่ม / สิ้นสุดของงวดงานที่เลือก
                    </small>
                </div>

                <!-- ================= PLAN START ================= -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        กำหนดวันที่เริ่ม
                    </label>
                    <input asp-for="PlanStart"
                           type="text"
                           class="form-control thai-date"
                           id="PlanStart"
                           value="@planStartText"
                           placeholder="วว/ดด/ปปปป" />
                </div>

                <!-- ================= PLAN END ================= -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        กำหนดวันที่สิ้นสุด
                    </label>
                    <input asp-for="PlanEnd"
                           type="text"
                           class="form-control thai-date"
                           id="PlanEnd"
                           value="@planEndText"
                           placeholder="วว/ดด/ปปปป" />
                </div>

                <!-- ================= WORK STATUS ================= -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        สถานะงาน
                    </label>
                    <select asp-for="StatusId"
                            asp-items="ViewBag.PhaseAssignStatuses"
                            class="form-select">
                        <option value="">-- เลือกสถานะ --</option>
                    </select>
                    <span asp-validation-for="StatusId" class="text-danger"></span>
                </div>

                <!-- ================= REMARK ================= -->
                <div class="col-md-12">
                    <label class="form-label fw-semibold">
                        หมายเหตุ
                    </label>
                    <textarea asp-for="Remark"
                              class="form-control"
                              rows="4"
                              maxlength="1000"
                              placeholder="รายละเอียดเพิ่มเติม / หมายเหตุ (สูงสุด 1000 ตัวอักษร)"></textarea>
                    <small id="remarkCounter" class="text-muted">0 / 1000</small>
                </div>

            </div>

            <div class="pt-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    บันทึกการแก้ไข
                </button>

                <a asp-action="Index"
                   asp-route-projectId="@ViewBag.ProjectId"
                   class="btn btn-outline-secondary">
                    กลับ
                </a>
            </div>

        </form>

    </div>
</div>

<partial name="_RequirementCardDetailModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const phaseSelect = document.querySelector('select[name="PhaseId"], select#PhaseId');
            const roleInput = document.querySelector('input[name="Role"], input#Role');
            if (!phaseSelect || !roleInput) return;

            // Track whether the user manually customized Role.
            // Role will auto-follow Phase only if the user hasn't customized it,
            // or if Role still equals the last auto-filled value.
            let roleTouched = false;
            let lastAutoRole = '';

            function getSelectedPhaseName() {
                const opt = phaseSelect.options[phaseSelect.selectedIndex];
                if (!opt) return '';
                const text = (opt.textContent || opt.innerText || '').trim();
                // Ignore placeholder option
                if (!text || text.startsWith('--')) return '';
                const separatorIndex = text.indexOf(' - ');
                return separatorIndex >= 0 ? text.substring(separatorIndex + 3).trim() : text;
            }

            // Initialize lastAutoRole: if current Role equals current PhaseName, treat it as auto.
            (function initAutoRole() {
                const curPhaseName = getSelectedPhaseName();
                const curRole = (roleInput.value || '').trim();
                if (curPhaseName && curRole && curRole === curPhaseName) {
                    lastAutoRole = curRole;
                }
            })();

            roleInput.addEventListener('input', function () {
                roleTouched = true;
                // Once user types, stop auto-tracking
                lastAutoRole = '';
                // If user clears Role, allow auto again
                if (!roleInput.value || roleInput.value.trim() === '') {
                    roleTouched = false;
                }
            });

            function applyRoleFromPhase(force) {
                const name = getSelectedPhaseName();
                if (!name) return;

                const cur = (roleInput.value || '').trim();

                // Update Role if:
                // - forced
                // - user never typed
                // - Role is empty
                // - Role equals the previous auto-filled value
                if (force || !roleTouched || cur === '' || (lastAutoRole && cur === lastAutoRole)) {
                    roleInput.value = name;
                    lastAutoRole = name;
                }
            }

            let lastPhaseValue = phaseSelect.value;
            function onPhaseChanged() {
                if (phaseSelect.value !== lastPhaseValue) {
                    lastPhaseValue = phaseSelect.value;
                    applyRoleFromPhase(false);
                }
            }

            // Sync once on load IF Role empty OR equals selected Phase name
            const initialPhaseName = getSelectedPhaseName();
            const initialRole = (roleInput.value || '').trim();
            if (initialRole === '' || (initialPhaseName && initialRole === initialPhaseName)) {
                applyRoleFromPhase(true);
            }

            // Update on phase change (native)
            phaseSelect.addEventListener('change', function () {
                lastPhaseValue = phaseSelect.value;
                applyRoleFromPhase(false);
            });

            // Update on phase change (Select2/jQuery)
            if (window.jQuery) {
                try {
                    window.jQuery(phaseSelect).on('select2:select select2:clear', function () {
                        lastPhaseValue = phaseSelect.value;
                        applyRoleFromPhase(false);
                    });
                } catch (e) {
                    // ignore
                }
            }

            // Fallback: detect programmatic changes
            setInterval(onPhaseChanged, 300);
        })();

        // Remark counter
        (function () {
            const ta = document.querySelector('textarea[name="Remark"]');
            const counter = document.getElementById('remarkCounter');
            if (!ta || !counter) return;

            function update() {
                const len = ta.value ? ta.value.length : 0;
                counter.textContent = len + ' / 1000';
                if (len > 900) {
                    counter.classList.remove('text-muted');
                    counter.classList.add('text-danger');
                } else {
                    counter.classList.remove('text-danger');
                    counter.classList.add('text-muted');
                }
            }

            ta.addEventListener('input', update);
            update();
        })();
        function convertThaiDateToIso(value) {
            if (!value || !value.trim()) return '';

            const parts = value.trim().split('/');
            if (parts.length !== 3) return value;

            let [d, m, y] = parts;

            d = d.padStart(2, '0');
            m = m.padStart(2, '0');
            y = parseInt(y, 10);

            if (y > 2400) {
                y -= 543;
            }

            return `${y}-${m}-${d}`;
        }

        function formatThaiDateInput(input) {
            if (!input) return;

            input.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');

                if (value.length > 8) {
                    value = value.substring(0, 8);
                }

                if (value.length >= 5) {
                    value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
                } else if (value.length >= 3) {
                    value = `${value.substring(0, 2)}/${value.substring(2)}`;
                }

                e.target.value = value;
            });
        }

        const planStartInput = document.getElementById('PlanStart');
        const planEndInput = document.getElementById('PlanEnd');
        const usePhaseDatesButton = document.getElementById('UsePhaseDatesButton');
        const phaseDateHint = document.getElementById('phaseDateHint');

        function toThaiDate(value) {
            if (!value || !value.trim()) return '';

            const parts = value.trim().split('-');
            if (parts.length !== 3) return value;

            const y = parseInt(parts[0], 10);
            if (!Number.isFinite(y)) return value;

            return `${parts[2]}/${parts[1]}/${y + 543}`;
        }

        function getSelectedPhaseOption() {
            const phaseSelect = document.querySelector('select[name="PhaseId"], select#phaseSelect, select#PhaseId');
            if (!phaseSelect) return null;
            return phaseSelect.options[phaseSelect.selectedIndex] || null;
        }

        function setPhaseDateHint(message, tone) {
            if (!phaseDateHint) return;
            phaseDateHint.textContent = message;
            phaseDateHint.classList.remove('text-muted', 'text-success', 'text-danger', 'text-warning');
            phaseDateHint.classList.add(tone || 'text-muted');
        }

        function applyDatesFromSelectedPhase() {
            const opt = getSelectedPhaseOption();
            if (!opt || !opt.value) {
                setPhaseDateHint('กรุณาเลือกส่วนงาน / งวดงานก่อน', 'text-danger');
                return;
            }

            const phaseStart = (opt.dataset.planStart || '').trim();
            const phaseEnd = (opt.dataset.planEnd || '').trim();

            if (!phaseStart && !phaseEnd) {
                setPhaseDateHint('งวดงานนี้ยังไม่ได้กำหนดวันที่เริ่ม / สิ้นสุด', 'text-warning');
                return;
            }

            if (planStartInput) {
                planStartInput.value = toThaiDate(phaseStart);
            }

            if (planEndInput) {
                planEndInput.value = toThaiDate(phaseEnd);
            }

            setPhaseDateHint('ใช้วันที่จากงวดงานที่เลือกแล้ว', 'text-success');
        }

        formatThaiDateInput(planStartInput);
        formatThaiDateInput(planEndInput);

        usePhaseDatesButton?.addEventListener('click', applyDatesFromSelectedPhase);

        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function () {
                document.querySelectorAll('.thai-date').forEach(input => {
                    input.value = convertThaiDateToIso(input.value);
                });
            });
        }
    </script>
}

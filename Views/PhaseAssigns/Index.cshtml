    @* Card layout for assign records *@
    var row = 1;
    var ordered = Model
        .OrderBy(a => ReadNestedInt(a, "ProjectPhase", "PhaseOrder")
                   ?? ReadNestedInt(a, "Phase", "PhaseOrder")
                   ?? ReadNestedInt(a, "PhaseOrder")
                   ?? int.MaxValue)
        .ThenBy(a => ReadNestedInt(a, "ProjectPhase", "PeriodOrder")
                  ?? ReadNestedInt(a, "Phase", "PeriodOrder")
                  ?? int.MaxValue)
        .ThenBy(a => a.PhaseSort ?? int.MaxValue)
        .ThenBy(a => a.AssignId)
        .ToList();
    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center py-4 mb-4">— No assignment —</div>
    }
    else
    {
        <div class="assign-card-list" id="assign-tbody">
        @foreach (var a in ordered)
        {
            var lastLog = a.Logs?.OrderByDescending(l => l.RoundNo).FirstOrDefault();
            var statusText = lastLog?.Status == "PASS" ? "ผ่าน" : lastLog != null ? "แก้ไข และนำเสนอใหม่" : null;
            var badgeClass = lastLog?.Status == "PASS" ? "bg-success" : lastLog != null ? "bg-warning text-dark" : "";
            var phaseOrder = ReadNestedInt(a, "ProjectPhase", "PhaseOrder")
                          ?? ReadNestedInt(a, "Phase", "PhaseOrder")
                          ?? ReadNestedInt(a, "PhaseOrder");
            var periodOrder = ReadNestedInt(a, "ProjectPhase", "PeriodOrder")
                           ?? ReadNestedInt(a, "Phase", "PeriodOrder");
            var hasPendingApproval = pendingAssignApprovalIds.Contains(a.AssignId);
            <div class="assign-card @(a.WorkStatus == "DONE" ? "is-done" : "is-progress")" data-assign-id="@a.AssignId">
                <section class="assign-card-left">
                    <div class="assign-card-header-row align-items-center mb-1">
                        <div class="min-w-0">
                            <div class="assign-title-line">
                                <span class="drag-handle" title="ลากเพื่อสลับลำดับ">☰</span>
                                <span class="assign-card-index">#@row</span>
                                @if (phaseOrder.HasValue)
                                {
                                    <span class="assign-phase-part"><strong>ส่วนที่</strong> @phaseOrder</span>
                                }
                                @if (periodOrder.HasValue)
                                {
                                    <span class="assign-phase-part"><strong>งวดที่</strong> @periodOrder</span>
                                }
                                @if (!phaseOrder.HasValue && !periodOrder.HasValue)
                                {
                                    <span class="assign-phase-part">-</span>
                                }
                            </div>
                            <div class="assign-card-phase">
                                <span class="assign-phase-name-label">ชื่องวดงาน:</span>
                                <span class="assign-phase-name-value">@GetPhaseNameSafe(a)</span>
                            </div>
                        </div>
                    </div>

                    <div class="assign-card-dates">
                        <span class="assign-meta-text">
                            <strong>กำหนดวันที่:</strong>
                            @(a.PlanStart?.ToString("dd MMM yyyy", th) ?? "-")
                            -
                            @(a.PlanEnd?.ToString("dd MMM yyyy", th) ?? "-")
                        </span>
                        <span class="assign-meta-text">
                            <strong>กำหนดส่งวันที่:</strong>
                            @(a.Phase?.PeriodEndDate?.ToString("dd MMM yyyy", th) ?? "-")
                        </span>
                    </div>
                    <div class="assign-card-role"><strong>งานที่รับผิดชอบ:</strong> <span class="text-dark">@a.Role</span></div>
                    <div class="assign-card-remark">
                        <div><b>หมายเหตุ:</b> @(string.IsNullOrWhiteSpace(a.Remark) ? "-" : a.Remark)</div>
                        <div class="text-muted"><b>บันทึกการนำเสนองาน:</b> @(lastLog == null || string.IsNullOrWhiteSpace(lastLog.Remark) ? "-" : lastLog.Remark)</div>
                    </div>

                    <div class="assign-card-people">
                        <span class="assign-card-person">
                            <img class="pt-owner-avatar"
                                 src="@ProfileImage(a.Employee)"
                                 alt="@(a.Employee?.EmpName ?? "ผู้รับผิดชอบ")"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                            <span><strong>ผู้รับผิดชอบ:</strong> @(a.Employee?.EmpName ?? "-")</span>
                        </span>
                    </div>

                    <div class="assign-status-grid">
                        <div class="assign-status-row">
                            <small>สถานะงาน:</small>
                            <span class="assign-status-badges">
                                @if (a.WorkStatus == "DONE")
                                {
                                    <span class="badge bg-success">เสร็จสิ้น</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">กำลังดำเนินการ</span>
                                }
                                @if (hasPendingApproval)
                                {
                                    <span class="badge assign-approval-pending-badge">
                                        รออนุมัติ
                                    </span>
                                }
                            </span>
                        </div>
                    </div>
                </section>

                <aside class="assign-card-right">
                    <div class="assign-card-actions">
                        @* ===== Edit ===== *@
                        @if (CanMenu("PhaseAssigns.Edit"))
                        {
                            <a asp-action="Edit" asp-route-id="@a.AssignId"
                               class="btn btn-sm btn-outline-primary"
                               title="แก้ไขข้อมูล">
                                แก้ไข
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                แก้ไข
                            </button>
                        }

                        @* ===== Delete ===== *@
                        @if (CanMenu("PhaseAssigns.Delete"))
                        {
                            <form asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.AssignId" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        title="ลบการ์ด"
                                        onclick="return confirm('ยืนยันการลบ Assign นี้?');">
                                    ลบการ์ด
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                ลบการ์ด
                            </button>
                        }

                        @* ===== PASS ===== *@
                        @if (CanMenu("PhaseAssigns.Edit"))
                        {
                            <button type="button"
                                    class="btn btn-sm btn-success"
                                    title="บันทึกผล: ผ่าน"
                                    onclick="openLogModal(@a.AssignId, 'PASS')">
                                ผ่าน
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled title="ไม่มีสิทธิ์บันทึกผ่าน">ผ่าน</button>
                        }

                        @* ===== REWORK ===== *@
                        @if (CanMenu("PhaseAssigns.Edit"))
                        {
                            <button type="button"
                                    class="btn btn-sm btn-warning"
                                    title="บันทึกผล: ปรับปรุง"
                                    onclick="openLogModal(@a.AssignId, 'REWORK')">
                                ปรับปรุง
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled title="ไม่มีสิทธิ์บันทึกปรับปรุง">ปรับปรุง</button>
                        }
                    </div>
                </aside>
            </div>
            row++;
        }
        </div>
    }

    @* Hidden table for reorder logic only (kept for SortableJS compatibility) *@
    <div style="display:none;">
        <table>
            <tbody id="assign-tbody-hidden"></tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-secondary mt-3">⬆ กรุณาเลือก Project ก่อน</div>
}

<form id="antiForgeryForm" method="post" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="modal fade phase-log-modal" id="logModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="logModalTitle">บันทึกผล (ผ่าน / ปรับปรุง)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
      </div>
      <div class="modal-body">
        <label class="form-label fw-bold">Remark</label>
        <textarea id="logRemark"
                  class="form-control"
                  rows="6"
                  maxlength="1000"
                  oninput="onRemarkInput()"
                  placeholder="พิมพ์หมายเหตุได้สูงสุด 1000 ตัวอักษร"></textarea>
        <div class="text-end text-muted mt-1">
            <span id="logCounter">0 / 1000</span>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
        <button type="button" id="logSubmitBtn" class="btn btn-primary" onclick="submitLog()">บันทึก</button>
      </div>
    </div>
  </div>
</div>

@section Scripts{
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("filterForm");

    function submitSafely() {
        setTimeout(function () {
            form?.submit();
        }, 0);
    }

    const coopFilter = document.getElementById("projectCoopFilter");
    const projectSelect = document.getElementById("hiddenProjectSelect");
    const employeeSelect = document.getElementById("hiddenEmployeeSelect");
    const projectOptions = projectSelect ? Array.from(projectSelect.options) : [];

    function syncProjectOptions() {
        const selectedCoop = (coopFilter?.value || "").toLowerCase();
        projectOptions.forEach(option => {
            const visible = option.value === "" ||
                !selectedCoop ||
                (option.dataset.coopName || "").toLowerCase() === selectedCoop;
            option.hidden = !visible;
            option.disabled = !visible;
        });

        const selected = projectSelect?.selectedOptions[0];
        if (selected && selected.disabled && projectSelect) projectSelect.value = "";
    }

    coopFilter?.addEventListener("change", function () {
        if (projectSelect) projectSelect.value = "";
        if (employeeSelect) employeeSelect.value = "";
        syncProjectOptions();
    });

    projectSelect?.addEventListener("change", function () {
        if (employeeSelect) employeeSelect.value = "";
        submitSafely();
    });

    employeeSelect?.addEventListener("change", submitSafely);
    syncProjectOptions();
});
</script>

<script>
(function () {
    const tbody = document.getElementById('assign-tbody');
    if (!tbody) return;

    const tokenEl = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
    const antiForgeryToken = tokenEl ? tokenEl.value : null;

    function refreshRowNumbers() {
        const rows = Array.from(document.querySelectorAll('.assign-card[data-assign-id]'));
        let i = 1;
        for (const r of rows) {
            const noCell = r.querySelector('.assign-card-index');
            if (noCell) {
                noCell.textContent = '#' + i;
            }
            i++;
        }
    }

    function collectAssignIds() {
        const rows = Array.from(tbody.querySelectorAll('.assign-card[data-assign-id]'));
        return rows
            .map(r => parseInt(r.getAttribute('data-assign-id') || '0', 10))
            .filter(x => Number.isFinite(x) && x > 0);
    }

    async function saveReorder() {
        const assignIds = collectAssignIds();
        if (!assignIds || assignIds.length === 0) {
            console.error('Reorder failed: empty assignIds');
            alert('บันทึกลำดับไม่สำเร็จ (Reorder)\nสาเหตุ: ไม่พบรายการ assignIds (เป็น 0 แถว)');
            return false;
        }

        // ส่งเป็น JSON array ตรง ๆ เพื่อให้ ModelBinder จับได้ทั้งกรณีที่ Controller รับเป็น int[]/List<int>
        const payload = assignIds;

        const headers = { 'Content-Type': 'application/json' };
        if (antiForgeryToken) headers['RequestVerificationToken'] = antiForgeryToken;

        const selectedProjectId = @((int?)ViewBag.SelectedProjectId ?? 0);
        const reorderUrl = '@Url.Action("Reorder", "PhaseAssigns")' + '?projectId=' + selectedProjectId;

        const res = await fetch(reorderUrl, {
            method: 'POST',
            headers,
            body: JSON.stringify(payload)
        });

        const txt = await res.text();
        if (!res.ok) {
            console.error('Reorder failed:', txt, payload);
            alert('บันทึกลำดับไม่สำเร็จ (Reorder)\n' + (txt || 'Bad Request') + '\nกรุณาเช็ค PhaseAssignsController.Reorder');
            return false;
        }

        if (txt) console.log('Reorder OK:', txt);
        return true;
    }

    Sortable.create(tbody, {
        animation: 150,
        handle: '.drag-handle',
        ghostClass: 'sortable-ghost',
        chosenClass: 'dragging-row',
        // ช่วยให้ลากแถวสุดท้าย/ขอบจอได้ง่ายขึ้น
        forceFallback: true,
        fallbackTolerance: 5,
        scroll: true,
        scrollSensitivity: 60,
        scrollSpeed: 15,
        onEnd: async function () {
            refreshRowNumbers();
            const ok = await saveReorder();
            if (!ok) {
                refreshRowNumbers();
                return;
            }
            refreshRowNumbers();
        }
    });

    refreshRowNumbers();
})();
</script>

<script>
let __logAssignId = null;
let __logStatus = null;

function prepareLogModalElement() {
    const modalEl = document.getElementById('logModal');
    if (!modalEl) return null;

    if (modalEl.parentElement !== document.body) {
        document.body.appendChild(modalEl);
    }

    document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
    document.body.classList.remove('modal-open');
    document.body.style.removeProperty('overflow');
    document.body.style.removeProperty('padding-right');

    modalEl.style.zIndex = '26010';
    return modalEl;
}

function openLogModal(assignId, status) {
    __logAssignId = assignId;
    __logStatus = (status || '').toUpperCase();

    const modalEl = prepareLogModalElement();
    if (!modalEl) return;

    const ta = document.getElementById('logRemark');
    const counter = document.getElementById('logCounter');
    const title = document.getElementById('logModalTitle');
    const submitButton = document.getElementById('logSubmitBtn');
    ta.value = '';
    counter.textContent = '0 / 1000';

    const isPass = __logStatus === 'PASS';
    title.textContent = isPass ? 'บันทึกผลผ่าน' : 'บันทึกผลปรับปรุง';

    submitButton.disabled = false;
    submitButton.textContent = 'บันทึก';
    submitButton.classList.remove('btn-primary', 'btn-success', 'btn-warning', 'text-dark');
    submitButton.classList.add(isPass ? 'btn-success' : 'btn-warning');
    if (!isPass) submitButton.classList.add('text-dark');

    const modal = bootstrap.Modal.getOrCreateInstance(modalEl, {
        backdrop: true,
        keyboard: true
    });
    modal.show();

    window.setTimeout(function () {
        modalEl.style.zIndex = '26010';
        document.querySelectorAll('.modal-backdrop').forEach(function (backdrop) {
            backdrop.style.zIndex = '26000';
        });
    }, 0);
}

function onRemarkInput() {
    const ta = document.getElementById('logRemark');
    const counter = document.getElementById('logCounter');
    const len = ta.value.length;
    counter.textContent = `${len} / 1000`;
}

function submitLog() {
    const ta = document.getElementById('logRemark');
    const remark = ta.value || '';
    const submitButton = document.getElementById('logSubmitBtn');
    const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value;
    const headers = {
        'Content-Type': 'application/x-www-form-urlencoded'
    };
    const body = new URLSearchParams();

    body.append('assignId', __logAssignId);
    body.append('status', __logStatus);
    body.append('remark', remark);

    if (token) {
        headers['RequestVerificationToken'] = token;
    }

    submitButton.disabled = true;
    submitButton.textContent = 'กำลังบันทึก...';

    fetch('@Url.Action("SaveLog", "PhaseAssigns")', {
        method: 'POST',
        headers,
        body
    })
    .then(async res => {
        const text = await res.text();
        let data = null;

        try {
            data = text ? JSON.parse(text) : null;
        } catch {
            data = { message: text };
        }

        if (!res.ok) {
            throw new Error(data?.message || 'บันทึกไม่สำเร็จ');
        }

        return data;
    })
    .then(data => {
        if (data && data.success) {
            alert('บันทึกสำเร็จ (รอบ ' + data.round + ')');
            location.reload();
        } else {
            submitButton.disabled = false;
            submitButton.textContent = 'บันทึก';
            alert(data?.message || 'บันทึกไม่สำเร็จ');
        }
    })
    .catch((error) => {
        submitButton.disabled = false;
        submitButton.textContent = 'บันทึก';
        alert(error?.message || 'เกิดข้อผิดพลาด');
    });
}
</script>
}

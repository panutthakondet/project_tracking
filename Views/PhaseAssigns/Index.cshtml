        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">บันทึกข้อมูลการมอบหมายงาน</h2>
        <p class="index-subtitle">จัดการการมอบหมายงานของพนักงานในแต่ละโครงการ</p>
    </div>

    @if (selectedProject != null)
    {
        <div class="index-actions">
            <a asp-controller="ProjectPhases"
               asp-action="Index"
               asp-route-projectId="@selectedProject.ProjectId"
               class="btn btn-outline-secondary"
               title="กลับไปจัดการแผนงานและงวดงาน">
                แผนงานและงวดงาน
            </a>

            <button id="RequirementCardDetailButton"
                    type="button"
                    class="btn btn-outline-primary project-board-card-detail"
                    data-detail-project-url-template="@requirementProjectCardDetailUrlTemplate"
                    data-project-field-id="hiddenProjectSelect"
                    title="เปิดดูรายละเอียด Project Board">
                รายละเอียด Project Board
            </button>

            @if (CanMenu("ProjectIssues.Index"))
            {
                <a asp-controller="ProjectIssues"
                   asp-action="Index"
                   asp-route-projectId="@selectedProject.ProjectId"
                   class="btn btn-outline-danger"
                   title="เปิดปัญหาของโครงการนี้">
                    ปัญหาโครงการ
                </a>
            }
            else
            {
                <button class="btn btn-outline-secondary" disabled title="ไม่มีสิทธิ์เปิดปัญหาโครงการ">
                    ปัญหาโครงการ
                </button>
            }

            @if (CanMenu("PhaseAssigns.Create"))
            {
                <a asp-action="Create"
                   asp-route-projectId="@selectedProject.ProjectId"
                   class="btn btn-primary"
                   title="เพิ่มการมอบหมายงาน">
                    เพิ่มการมอบหมาย
                </a>
            }
            else
            {
                <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์เพิ่มการมอบหมายงาน">
                    เพิ่มการมอบหมาย
                </button>
            }

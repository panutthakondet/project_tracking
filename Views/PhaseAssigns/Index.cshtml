@model IEnumerable<ProjectTracking.Models.PhaseAssign>

@using System.Globalization
@using Microsoft.AspNetCore.Http
@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

@{
    ViewData["Title"] = "บันทึกข้อมูลการมอบหมายงาน";
    var th = new CultureInfo("th-TH");
    var selectedProject = ViewBag.SelectedProject;
    var selectedProjectId = (int?)ViewBag.SelectedProjectId;
    var pendingAssignApprovalIds = ViewBag.PendingAssignApprovalIds as ISet<int> ?? new HashSet<int>();
    var projectOptions = ViewBag.Projects as IEnumerable<ProjectTracking.Models.Project>
                         ?? Enumerable.Empty<ProjectTracking.Models.Project>();
    var selectedProjectCoopName = ((selectedProject as ProjectTracking.Models.Project)?.Coop?.CoopName ?? "").Trim();
    var projectCoopOptions = projectOptions
        .Select(p => p.Coop?.CoopName?.Trim())
        .Where(name => !string.IsNullOrWhiteSpace(name))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(name => name)
        .ToList();
    var requirementProjectCardDetailUrlTemplate = Url.Action("ProjectCardDetails", "RequirementBoard", new { projectId = "__PROJECT_ID__" }) ?? "";
}

@functions {
    private static string? ReadNestedString(object? obj, params string[] path)
    {
        if (obj == null) return null;
        object? cur = obj;
        foreach (var seg in path)
        {
            if (cur == null) return null;
            var t = cur.GetType();
            var p = t.GetProperty(seg);
            if (p == null) return null;
            cur = p.GetValue(cur);
        }
        return cur?.ToString();
    }

    private static int? ReadNestedInt(object? obj, params string[] path)
    {
        var s = ReadNestedString(obj, path);
        if (string.IsNullOrWhiteSpace(s)) return null;
        return int.TryParse(s, out var v) ? v : (int?)null;
    }

    private static string GetPhaseNameSafe(object a)
    {
        var v = ReadNestedString(a, "ProjectPhase", "PhaseName")
             ?? ReadNestedString(a, "Phase", "PhaseName")
             ?? ReadNestedString(a, "ProjectPhase", "phase_name")
             ?? ReadNestedString(a, "Phase", "phase_name")
             ?? ReadNestedString(a, "PhaseName")
             ?? ReadNestedString(a, "phase_name");

        return string.IsNullOrWhiteSpace(v) ? "-" : v!;
    }

    private static string GetPhasePeriodSafe(object a)
    {
        var phaseOrder = ReadNestedInt(a, "ProjectPhase", "PhaseOrder")
                      ?? ReadNestedInt(a, "Phase", "PhaseOrder")
                      ?? ReadNestedInt(a, "PhaseOrder");

        var periodOrder = ReadNestedInt(a, "ProjectPhase", "PeriodOrder")
                       ?? ReadNestedInt(a, "Phase", "PeriodOrder");

        if (!phaseOrder.HasValue && !periodOrder.HasValue) return "-";
        if (!periodOrder.HasValue) return $"ส่วนที่ {phaseOrder}";
        if (!phaseOrder.HasValue) return $"งวดที่ {periodOrder}";
        return $"ส่วนที่ {phaseOrder} / งวดที่ {periodOrder}";
    }

    private static string ProfileImage(ProjectTracking.Models.Employee? employee)
    {
        var path = employee?.LoginUser?.ProfileImagePath;
        if (string.IsNullOrWhiteSpace(path)) return "/images/Profile/profile.png";

        path = path.Trim();
        if (path.StartsWith("~/", StringComparison.Ordinal)) path = path[1..];
        if (!path.StartsWith("/", StringComparison.Ordinal)) path = "/" + path.TrimStart('/');
        return path;
    }
}


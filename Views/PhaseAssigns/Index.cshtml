@model IEnumerable<ProjectTracking.Models.PhaseAssign>

@using System.Globalization
@using Microsoft.AspNetCore.Http
@{
    bool CanMenu(string key)
    {
        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Contains(key);
    }
}

@{
    ViewData["Title"] = "บันทึกข้อมูลการมอบหมายงาน";
    var th = new CultureInfo("th-TH");

    var empColorMap = new Dictionary<int, string>();
    var pastelColors = new[]
    {
        "#f8f9fa",
        "#e9f5ff",
        "#eafaf1",
        "#fff4e6",
        "#f3e8ff",
        "#e7f1ff",
        "#fef7e0"
    };
    var colorIndex = 0;
}

@functions {
    private static string? ReadNestedString(object? obj, params string[] path)
    {
        if (obj == null) return null;
        object? cur = obj;
        foreach (var seg in path)
        {
            if (cur == null) return null;
            var t = cur.GetType();
            var p = t.GetProperty(seg);
            if (p == null) return null;
            cur = p.GetValue(cur);
        }
        return cur?.ToString();
    }

    private static int? ReadNestedInt(object? obj, params string[] path)
    {
        var s = ReadNestedString(obj, path);
        if (string.IsNullOrWhiteSpace(s)) return null;
        return int.TryParse(s, out var v) ? v : (int?)null;
    }

    private static string GetPhaseNameSafe(object a)
    {
        var v = ReadNestedString(a, "ProjectPhase", "PhaseName")
             ?? ReadNestedString(a, "Phase", "PhaseName")
             ?? ReadNestedString(a, "ProjectPhase", "phase_name")
             ?? ReadNestedString(a, "Phase", "phase_name")
             ?? ReadNestedString(a, "PhaseName")
             ?? ReadNestedString(a, "phase_name");

        return string.IsNullOrWhiteSpace(v) ? "-" : v!;
    }
}

<style>
.table-hover tbody tr:hover > * { background-color: inherit !important; }
.table tbody tr > td { background-color: inherit !important; }

.sticky-col { position: sticky; z-index: 3; background-clip: padding-box; }
.sticky-1 { left: 0; width:70px; min-width:70px; max-width:70px; }
.sticky-2 { left: 70px; width:280px; min-width:280px; max-width:280px; }

thead .sticky-col { z-index: 5; }

.table-assign { table-layout: fixed; }
.table-assign th, .table-assign td { vertical-align: middle; }
.table-assign .col-phase { width:240px; }
.table-assign .col-role { width:220px; }
.table-assign .col-period { width:380px; white-space: nowrap; }
.table-assign .col-remark { width:360px; }
.table-assign .col-action { width:190px; }

.table-assign td { word-break: break-word; }
.table-assign .nowrap { white-space: nowrap; }

.dragging-row { opacity: .65; }
.sortable-ghost { opacity: .35; }
.drag-handle { font-weight: 700; }
</style>

<div class="mb-3">
    <h2 class="fw-bold">👥 บันทึกข้อมูลการมอบหมายงาน</h2>
    <p class="text-muted mb-0">จัดการการมอบหมายงาน (Assign) ของพนักงานในแต่ละโครงการ</p>
</div>

<form method="get" class="row g-3 mb-4" id="filterForm">
    <div class="col-md-4">
        <label class="form-label fw-bold">📁 Project</label>
        <select name="projectId" id="projectSelect" class="form-select">
            <option value="">-- Select Project --</option>
            @foreach (var p in ((IEnumerable<dynamic>)ViewBag.Projects)
                                .OrderBy(x => x.EndDate ?? DateTime.MaxValue))
            {
                if (ViewBag.SelectedProject?.ProjectId == p.ProjectId)
                {
                    <option value="@p.ProjectId" selected>@p.ProjectName</option>
                }
                else
                {
                    <option value="@p.ProjectId">@p.ProjectName</option>
                }
            }
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label fw-bold">👤 Employee</label>
        <select name="empId" id="empSelect" class="form-select" @(ViewBag.SelectedProject == null ? "disabled" : "")>
            <option value="">-- All Employees --</option>
            @foreach (var e in ViewBag.EmployeeList)
            {
                if (ViewBag.SelectedEmpId == e.EmpId)
                {
                    <option value="@e.EmpId" selected>@e.EmpName</option>
                }
                else
                {
                    <option value="@e.EmpId">@e.EmpName</option>
                }
            }
        </select>
    </div>
</form>

@if (ViewBag.SelectedProject != null)
{
    <style>
    /* Card-style layout for assign cards */
    .assign-card-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .assign-card {
        border-radius: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05), 0 0.5px 1.5px rgba(0,0,0,0.03);
        background: #fff;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: row;
        align-items: stretch;
        min-height: 1px;
        transition: box-shadow .15s;
        border: 1px solid #ececec;
        position: relative;
    }
    .assign-card.dragging-row, .assign-card.sortable-ghost {
        opacity: 0.60;
        box-shadow: 0 2px 16px rgba(0,0,0,0.11);
    }
    .assign-card .assign-card-left {
        flex: 1 1 0;
        min-width: 0;
        padding: 1rem 1.25rem 1rem 1rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: inherit;
        border-radius: 1rem 0 0 1rem;
    }
    .assign-card .assign-card-right {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-end;
        min-width: 160px;
        padding: 1rem 1.25rem 1rem 0.75rem;
        background: inherit;
        border-radius: 0 1rem 1rem 0;
    }
    .assign-card-header-row {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 0.5rem 1rem;
        width: 100%;
    }
    .assign-card-emp {
        font-weight: 600;
        font-size: 1.07rem;
        word-break: break-word;
        margin-right: 0.5em;
    }
    .assign-card-phase {
        font-size: 1rem;
        color: #5c5c5c;
        font-weight: 500;
        margin-top: 0.1em;
    }
    .assign-card-index {
        font-weight: 700;
        font-size: 1.02rem;
        color: #4b4b4b;
        margin-right: 0.5em;
        min-width: 2.5em;
        display: inline-flex;
        align-items: center;
    }
    .assign-card .drag-handle {
        cursor: grab;
        margin-right: 0.75em;
        font-size: 1.15em;
        color: #888;
        user-select: none;
    }
    .assign-card-dates {
        font-size: 0.97rem;
        color: #2b2b2b;
        margin-top: 0.2em;
        margin-bottom: 0.5em;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75em 2em;
    }
    .assign-card-role {
        font-size: 0.97rem;
        color: #555;
        font-weight: 500;
        margin-bottom: 0.2em;
    }
    .assign-card-remark {
        font-size: 0.96rem;
        margin-bottom: 0.2em;
        margin-top: 0.2em;
    }
    .assign-card-log-badge {
        margin-right: 0.5em;
        font-size: 0.98rem;
        vertical-align: middle;
    }
    .assign-card-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4em;
        margin-top: 0.5em;
        align-items: center;
    }
    .assign-card-status-badge {
        font-size: 1.01rem;
        padding: 0.35em 1.1em;
        border-radius: 1.5em;
        font-weight: 600;
        margin-bottom: 0.25em;
        white-space: nowrap;
    }
    .assign-card .assign-card-right {
        min-width: 175px;
        max-width: 220px;
    }
    @@media (max-width: 768px) {
        .assign-card {
            flex-direction: column;
        }
        .assign-card .assign-card-left, .assign-card .assign-card-right {
            border-radius: 1rem !important;
            padding: 1rem 1.1rem;
        }
        .assign-card .assign-card-right {
            align-items: stretch;
            min-width: 0;
        }
    }
    </style>

    <div class="d-flex align-items-stretch gap-3 mb-3" style="flex-wrap:wrap;">
        <div style="flex:1 1 0; min-width:0;">
            <div class="card border-0 shadow-sm rounded-3 p-3 px-4 h-100" style="background:#f7fafd;">
                <div class="fw-bold" style="font-size:1.12rem;line-height:1.5;">
                    📌 Project :
                    <span style="word-break:break-word;">@ViewBag.SelectedProject.ProjectName</span>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2" style="flex-wrap:wrap;">
            <a asp-controller="ProjectPhases"
               asp-action="Index"
               asp-route-projectId="@ViewBag.SelectedProject.ProjectId"
               class="btn btn-outline-secondary px-4"
               title="กลับไปจัดการ Phase"
               style="font-size:1.07rem;">
                ↩ Project Phases
            </a>

            @if (CanMenu("PhaseAssigns.Create"))
            {
                <a asp-action="Create"
                   asp-route-projectId="@ViewBag.SelectedProject.ProjectId"
                   class="btn btn-primary px-4"
                   title="เพิ่มการมอบหมายงาน"
                   style="font-size:1.07rem;">
                    ➕ Add Assign
                </a>
            }
            else
            {
                <button class="btn btn-primary px-4"
                        disabled
                        title="ไม่มีสิทธิ์เพิ่มการมอบหมายงาน"
                        style="font-size:1.07rem;">
                    ➕ Add Assign
                </button>
            }
        </div>
    </div>

    @* Card layout for assign records *@
    var row = 1;
    var ordered = Model
        .OrderBy(a => a.PhaseSort ?? int.MaxValue)
        .ThenBy(a => ReadNestedInt(a, "ProjectPhase", "PhaseOrder")
                  ?? ReadNestedInt(a, "Phase", "PhaseOrder")
                  ?? ReadNestedInt(a, "PhaseOrder")
                  ?? int.MaxValue)
        .ThenBy(a => a.AssignId)
        .ToList();
    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center py-4 mb-4">— No assignment —</div>
    }
    else
    {
        <div class="assign-card-list" id="assign-tbody">
        @foreach (var a in ordered)
        {
            if (!empColorMap.ContainsKey(a.EmpId))
            {
                empColorMap[a.EmpId] = pastelColors[colorIndex % pastelColors.Length];
                colorIndex++;
            }
            var bg = empColorMap[a.EmpId];
            var lastLog = a.Logs?.OrderByDescending(l => l.RoundNo).FirstOrDefault();
            var statusText = lastLog?.Status == "PASS" ? "ผ่าน" : lastLog != null ? "แก้ไข และนำเสนอใหม่" : null;
            var badgeClass = lastLog?.Status == "PASS" ? "bg-success" : lastLog != null ? "bg-warning text-dark" : "";
            <div class="assign-card" data-assign-id="@a.AssignId" style="background-color:@bg;">
                <div class="assign-card-left">
                    <div class="assign-card-header-row align-items-center mb-1">
                        <span class="drag-handle" title="ลากเพื่อสลับลำดับ">☰</span>
                        <span class="assign-card-index">#@row</span>
                        <span class="assign-card-emp">👤 @a.Employee?.EmpName</span>
                    </div>
                    <div class="assign-card-phase">@GetPhaseNameSafe(a)</div>
                    <div class="assign-card-dates mt-2">
                        <div>
                            <span class="fw-semibold text-primary">Plan Date</span>
                            @(a.PlanStart?.ToString("dd MMM yyyy", th) ?? "-")
                            <span class="mx-1">–</span>
                            @(a.PlanEnd?.ToString("dd MMM yyyy", th) ?? "-")
                        </div>
                        <div>
                            <span class="fw-semibold text-secondary">Period Date</span>
                            @(a.Phase?.PeriodStartDate?.ToString("dd MMM yyyy", th) ?? "-")
                            <span class="mx-1">–</span>
                            @(a.Phase?.PeriodEndDate?.ToString("dd MMM yyyy", th) ?? "-")
                        </div>
                    </div>
                    <div class="assign-card-role">Role: <span class="text-dark">@a.Role</span></div>
                    <div class="assign-card-remark">
                        @if (lastLog != null)
                        {
                            <span class="assign-card-log-badge badge @badgeClass">@statusText</span>
                            <span><b>Log:</b> @(string.IsNullOrWhiteSpace(lastLog.Remark) ? "-" : lastLog.Remark)</span>
                            <br />
                            <span class="text-muted"><b>Assign:</b> @(string.IsNullOrWhiteSpace(a.Remark) ? "-" : a.Remark)</span>
                        }
                        else
                        {
                            <span><b>Assign:</b> @(string.IsNullOrWhiteSpace(a.Remark) ? "-" : a.Remark)</span>
                        }
                    </div>
                    <div class="assign-card-actions">
                        @* ===== Edit ===== *@
                        @if (CanMenu("PhaseAssigns.Edit"))
                        {
                            <a asp-action="Edit" asp-route-id="@a.AssignId"
                               class="btn btn-sm btn-outline-primary"
                               title="แก้ไขข้อมูล (Edit)">
                                ✏️
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                ✏️
                            </button>
                        }

                        @* ===== Delete ===== *@
                        @if (CanMenu("PhaseAssigns.Delete"))
                        {
                            <form asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.AssignId" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        title="ลบข้อมูล (Delete)"
                                        onclick="return confirm('ยืนยันการลบ Assign นี้?');">
                                    🗑
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                🗑
                            </button>
                        }

                        @* ===== PASS ===== *@
                        @if (CanMenu("PhaseAssigns.Edit"))
                        {
                            <button type="button"
                                    class="btn btn-sm btn-success"
                                    title="บันทึกผล: ผ่านงาน (PASS)"
                                    onclick="openLogModal(@a.AssignId, 'PASS')">
                                ✅
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled title="ไม่มีสิทธิ์บันทึก PASS">✅</button>
                        }

                        @* ===== REWORK ===== *@
                        @if (CanMenu("PhaseAssigns.Edit"))
                        {
                            <button type="button"
                                    class="btn btn-sm btn-warning"
                                    title="บันทึกผล: แก้ไขใหม่ (REWORK)"
                                    onclick="openLogModal(@a.AssignId, 'REWORK')">
                                🔁
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled title="ไม่มีสิทธิ์บันทึก REWORK">🔁</button>
                        }
                    </div>
                </div>
                <div class="assign-card-right">
                    @if (a.WorkStatus == "DONE")
                    {
                        <span class="assign-card-status-badge badge bg-success">
                            ✅ เสร็จสิ้น
                        </span>
                    }
                    else
                    {
                        <span class="assign-card-status-badge badge bg-warning text-dark">
                            🟡 กำลังดำเนินการ
                        </span>
                    }
                </div>
            </div>
            row++;
        }
        </div>
    }

    @* Hidden table for reorder logic only (kept for SortableJS compatibility) *@
    <div style="display:none;">
        <table>
            <tbody id="assign-tbody-hidden"></tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-secondary mt-3">⬆ กรุณาเลือก Project ก่อน</div>
}

<form id="antiForgeryForm" method="post" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="modal fade" id="logModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">บันทึกผล (PASS / REWORK)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label fw-bold">Remark</label>
        <textarea id="logRemark"
                  class="form-control"
                  rows="6"
                  maxlength="1000"
                  oninput="onRemarkInput()"
                  placeholder="พิมพ์หมายเหตุได้สูงสุด 1000 ตัวอักษร"></textarea>
        <div class="text-end text-muted mt-1">
            <span id="logCounter">0 / 1000</span>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
        <button class="btn btn-primary" onclick="submitLog()">บันทึก</button>
      </div>
    </div>
  </div>
</div>

@section Scripts{
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
$(function () {
    const $form = $('#filterForm');
    const hasProject = @(ViewBag.SelectedProject != null ? "true" : "false");

    if (!window.jQuery || !$.fn || !$.fn.select2) {
        console.error('Select2 ยังไม่ถูกโหลด (ตรวจสอบ _Layout.cshtml ว่ามี jquery + select2.js และลำดับการโหลดถูกต้อง)');
        return;
    }

    $('#projectSelect').select2({ placeholder: "-- Select Project --", allowClear: true, width: '100%', minimumResultsForSearch: 0, dropdownParent: $(document.body) });

    if (!hasProject) {
        $('#empSelect').prop('disabled', true);
    } else {
        $('#empSelect').select2({ placeholder: "-- All Employees --", allowClear: true, width: '100%', minimumResultsForSearch: 0, dropdownParent: $(document.body) });
    }

    function submitSafely() { setTimeout(function () { $form.trigger('submit'); }, 0); }
    $('#projectSelect').on('select2:select select2:clear', function () { submitSafely(); });
    $('#empSelect').on('select2:select select2:clear', function () { if (hasProject) submitSafely(); });
});
</script>

<script>
(function () {
    const tbody = document.getElementById('assign-tbody');
    if (!tbody) return;

    const tokenEl = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
    const antiForgeryToken = tokenEl ? tokenEl.value : null;

    function refreshRowNumbers() {
        const rows = Array.from(document.querySelectorAll('.assign-card[data-assign-id]'));
        let i = 1;
        for (const r of rows) {
            const noCell = r.querySelector('.assign-card-index');
            if (noCell) {
                noCell.textContent = '#' + i;
            }
            i++;
        }
    }

    function collectAssignIds() {
        const rows = Array.from(tbody.querySelectorAll('.assign-card[data-assign-id]'));
        return rows
            .map(r => parseInt(r.getAttribute('data-assign-id') || '0', 10))
            .filter(x => Number.isFinite(x) && x > 0);
    }

    async function saveReorder() {
        const assignIds = collectAssignIds();
        if (!assignIds || assignIds.length === 0) {
            console.error('Reorder failed: empty assignIds');
            alert('บันทึกลำดับไม่สำเร็จ (Reorder)\nสาเหตุ: ไม่พบรายการ assignIds (เป็น 0 แถว)');
            return false;
        }

        // ส่งเป็น JSON array ตรง ๆ เพื่อให้ ModelBinder จับได้ทั้งกรณีที่ Controller รับเป็น int[]/List<int>
        const payload = assignIds;

        const headers = { 'Content-Type': 'application/json' };
        if (antiForgeryToken) headers['RequestVerificationToken'] = antiForgeryToken;

        const selectedProjectId = @((int?)ViewBag.SelectedProjectId ?? 0);
        const reorderUrl = '@Url.Action("Reorder", "PhaseAssigns")' + '?projectId=' + selectedProjectId;

        const res = await fetch(reorderUrl, {
            method: 'POST',
            headers,
            body: JSON.stringify(payload)
        });

        const txt = await res.text();
        if (!res.ok) {
            console.error('Reorder failed:', txt, payload);
            alert('บันทึกลำดับไม่สำเร็จ (Reorder)\n' + (txt || 'Bad Request') + '\nกรุณาเช็ค PhaseAssignsController.Reorder');
            return false;
        }

        if (txt) console.log('Reorder OK:', txt);
        return true;
    }

    Sortable.create(tbody, {
        animation: 150,
        handle: '.drag-handle',
        ghostClass: 'sortable-ghost',
        chosenClass: 'dragging-row',
        // ช่วยให้ลากแถวสุดท้าย/ขอบจอได้ง่ายขึ้น
        forceFallback: true,
        fallbackTolerance: 5,
        scroll: true,
        scrollSensitivity: 60,
        scrollSpeed: 15,
        onEnd: async function () {
            refreshRowNumbers();
            const ok = await saveReorder();
            if (!ok) {
                refreshRowNumbers();
                return;
            }
            refreshRowNumbers();
        }
    });

    refreshRowNumbers();
})();
</script>

<script>
let __logAssignId = null;
let __logStatus = null;

function openLogModal(assignId, status) {
    __logAssignId = assignId;
    __logStatus = status;

    const ta = document.getElementById('logRemark');
    const counter = document.getElementById('logCounter');
    ta.value = '';
    counter.textContent = '0 / 1000';

    const modal = new bootstrap.Modal(document.getElementById('logModal'));
    modal.show();
}

function onRemarkInput() {
    const ta = document.getElementById('logRemark');
    const counter = document.getElementById('logCounter');
    const len = ta.value.length;
    counter.textContent = `${len} / 1000`;
}

function submitLog() {
    const ta = document.getElementById('logRemark');
    const remark = ta.value || '';

    fetch('/PhaseAssigns/SaveLog', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded'
        },
        body: `assignId=${__logAssignId}&status=${__logStatus}&remark=${encodeURIComponent(remark)}`
    })
    .then(res => res.json())
    .then(data => {
        if (data && data.success) {
            alert('บันทึกสำเร็จ (รอบ ' + data.round + ')');
            location.reload();
        } else {
            alert('บันทึกไม่สำเร็จ');
        }
    })
    .catch(() => alert('เกิดข้อผิดพลาด'));
}
</script>
}
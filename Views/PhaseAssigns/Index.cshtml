@model IEnumerable<ProjectTracking.Models.PhaseAssign>

@using System.Globalization
@using Microsoft.AspNetCore.Http
@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

@{
    ViewData["Title"] = "บันทึกข้อมูลการมอบหมายงาน";
    var th = new CultureInfo("th-TH");
    var selectedProject = ViewBag.SelectedProject;
    var selectedProjectId = (int?)ViewBag.SelectedProjectId;
}

@functions {
    private static string? ReadNestedString(object? obj, params string[] path)
    {
        if (obj == null) return null;
        object? cur = obj;
        foreach (var seg in path)
        {
            if (cur == null) return null;
            var t = cur.GetType();
            var p = t.GetProperty(seg);
            if (p == null) return null;
            cur = p.GetValue(cur);
        }
        return cur?.ToString();
    }

    private static int? ReadNestedInt(object? obj, params string[] path)
    {
        var s = ReadNestedString(obj, path);
        if (string.IsNullOrWhiteSpace(s)) return null;
        return int.TryParse(s, out var v) ? v : (int?)null;
    }

    private static string GetPhaseNameSafe(object a)
    {
        var v = ReadNestedString(a, "ProjectPhase", "PhaseName")
             ?? ReadNestedString(a, "Phase", "PhaseName")
             ?? ReadNestedString(a, "ProjectPhase", "phase_name")
             ?? ReadNestedString(a, "Phase", "phase_name")
             ?? ReadNestedString(a, "PhaseName")
             ?? ReadNestedString(a, "phase_name");

        return string.IsNullOrWhiteSpace(v) ? "-" : v!;
    }
}

<style>
.table-hover tbody tr:hover > * { background-color: inherit !important; }
.table tbody tr > td { background-color: inherit !important; }

.sticky-col { position: sticky; z-index: 3; background-clip: padding-box; }
.sticky-1 { left: 0; width:70px; min-width:70px; max-width:70px; }
.sticky-2 { left: 70px; width:280px; min-width:280px; max-width:280px; }

thead .sticky-col { z-index: 5; }

.table-assign { table-layout: fixed; }
.table-assign th, .table-assign td { vertical-align: middle; }
.table-assign .col-phase { width:240px; }
.table-assign .col-role { width:220px; }
.table-assign .col-period { width:380px; white-space: nowrap; }
.table-assign .col-remark { width:360px; }
.table-assign .col-action { width:190px; }

.table-assign td { word-break: break-word; }
.table-assign .nowrap { white-space: nowrap; }

.dragging-row { opacity: .65; }
.sortable-ghost { opacity: .35; }
.drag-handle { font-weight: 700; }

.assign-filter-form {
    width: 100%;
    background: #fff;
    border: 1px solid #d8e3ef;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
}

.assign-filter-row {
    width: 100%;
    min-width: 0;
}

.assign-filter-form .form-select {
    min-height: 48px;
    border-radius: 14px;
    font-weight: 700;
}

.assign-filter-form .form-control {
    min-height: 48px;
    border-radius: 14px;
    font-weight: 700;
}

#projectDropdown,
#employeeDropdown {
    width: 100%;
    border-radius: 14px;
    box-shadow: 0 14px 28px rgba(15, 35, 64, .12);
}

.search-dropdown-field {
    position: relative;
}

.search-dropdown-field .form-control {
    padding-right: 48px;
}

.search-dropdown-clear {
    position: absolute;
    top: 50%;
    right: 12px;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 999px;
    display: none;
    align-items: center;
    justify-content: center;
    color: #334155;
    background: #e2e8f0;
    font-size: 1.15rem;
    font-weight: 900;
    line-height: 1;
    transition: .15s ease;
}

.search-dropdown-clear.is-visible {
    display: inline-flex;
}

.search-dropdown-clear:hover {
    color: #fff;
    background: #0f766e;
}

.search-dropdown-clear:disabled {
    opacity: .35;
    pointer-events: none;
}
</style>

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">บันทึกข้อมูลการมอบหมายงาน</h2>
        <p class="index-subtitle">จัดการการมอบหมายงานของพนักงานในแต่ละโครงการ</p>
    </div>

    @if (selectedProject != null)
    {
        <div class="index-actions">
            <a asp-controller="ProjectPhases"
               asp-action="Index"
               asp-route-projectId="@selectedProject.ProjectId"
               class="btn btn-outline-secondary"
               title="กลับไปจัดการ Phase">
                Project Phases
            </a>

            @if (CanMenu("ProjectIssues.Index"))
            {
                <a asp-controller="ProjectIssues"
                   asp-action="Index"
                   asp-route-projectId="@selectedProject.ProjectId"
                   class="btn btn-outline-danger"
                   title="เปิด Issue ของโครงการนี้">
                    Project Issues
                </a>
            }
            else
            {
                <button class="btn btn-outline-secondary" disabled title="ไม่มีสิทธิ์เปิด Project Issues">
                    Project Issues
                </button>
            }

            @if (CanMenu("PhaseAssigns.Create"))
            {
                <a asp-action="Create"
                   asp-route-projectId="@selectedProject.ProjectId"
                   class="btn btn-primary"
                   title="เพิ่มการมอบหมายงาน">
                    Add Assign
                </a>
            }
            else
            {
                <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์เพิ่มการมอบหมายงาน">
                    Add Assign
                </button>
            }
        </div>
    }
</div>

<form method="get" class="assign-filter-form mb-4" id="filterForm">
    <div class="assign-filter-row">
        <label class="form-label fw-bold">📁 Select Project</label>

        <div class="search-dropdown-field">
            <input type="text"
                   id="projectSearch"
                   class="form-control form-control-lg"
                   placeholder="🔍 พิมพ์ค้นหา Project..."
                   autocomplete="off" />
            <button type="button"
                    id="clearProjectSearch"
                    class="search-dropdown-clear"
                    title="เลือก Project ใหม่"
                    aria-label="เลือก Project ใหม่">
                ×
            </button>
        </div>

        <div id="projectDropdown"
             class="list-group mt-1"
             style="max-height:250px; overflow-y:auto; display:none; border:1px solid #ddd;">
        </div>

        <select name="projectId" id="hiddenProjectSelect" style="display:none;">
            <option value="">-- Select Project --</option>
            @foreach (var p in ((IEnumerable<dynamic>)ViewBag.Projects)
                                .OrderBy(x => x.EndDate ?? DateTime.MaxValue))
            {
                <option value="@p.ProjectId"
                        data-end-date="@(p.EndDate?.ToString("yyyy-MM-dd") ?? "")"
                        selected="@(selectedProjectId == p.ProjectId)">
                    @p.ProjectName
                </option>
            }
        </select>
    </div>

    <div class="assign-filter-row">
        <label class="form-label fw-bold">👤 Employee</label>

        <div class="search-dropdown-field">
            <input type="text"
                   id="employeeSearch"
                   class="form-control form-control-lg"
                   placeholder="🔍 พิมพ์ค้นหา Employee..."
                   autocomplete="off"
                   @(ViewBag.SelectedProject == null ? "disabled" : "") />
            <button type="button"
                    id="clearEmployeeSearch"
                    class="search-dropdown-clear"
                    title="เลือก Employee ใหม่"
                    aria-label="เลือก Employee ใหม่"
                    @(ViewBag.SelectedProject == null ? "disabled" : "")>
                ×
            </button>
        </div>

        <div id="employeeDropdown"
             class="list-group mt-1"
             style="max-height:250px; overflow-y:auto; display:none; border:1px solid #ddd;">
        </div>

        <select name="empId" id="hiddenEmployeeSelect" style="display:none;" @(ViewBag.SelectedProject == null ? "disabled" : "")>
            <option value="">-- All Employees --</option>
            @foreach (var e in ViewBag.EmployeeList)
            {
                if (ViewBag.SelectedEmpId == e.EmpId)
                {
                    <option value="@e.EmpId" selected>@e.EmpName</option>
                }
                else
                {
                    <option value="@e.EmpId">@e.EmpName</option>
                }
            }
        </select>
    </div>
</form>


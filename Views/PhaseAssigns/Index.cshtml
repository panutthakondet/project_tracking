    @* Card layout for assign records *@
    var row = 1;
    var ordered = Model
        .OrderBy(a => a.PhaseSort ?? int.MaxValue)
        .ThenBy(a => ReadNestedInt(a, "ProjectPhase", "PhaseOrder")
                  ?? ReadNestedInt(a, "Phase", "PhaseOrder")
                  ?? ReadNestedInt(a, "PhaseOrder")
                  ?? int.MaxValue)
        .ThenBy(a => a.AssignId)
        .ToList();
    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center py-4 mb-4">— No assignment —</div>
    }
    else
    {
        <div class="assign-card-list" id="assign-tbody">
        @foreach (var a in ordered)
        {
            var lastLog = a.Logs?.OrderByDescending(l => l.RoundNo).FirstOrDefault();
            var statusText = lastLog?.Status == "PASS" ? "ผ่าน" : lastLog != null ? "แก้ไข และนำเสนอใหม่" : null;
            var badgeClass = lastLog?.Status == "PASS" ? "bg-success" : lastLog != null ? "bg-warning text-dark" : "";
            <div class="assign-card @(a.WorkStatus == "DONE" ? "is-done" : "is-progress")" data-assign-id="@a.AssignId">
                <section class="assign-card-left">
                    <div class="assign-card-header-row align-items-center mb-1">
                        <span class="drag-handle" title="ลากเพื่อสลับลำดับ">☰</span>
                        <span class="assign-card-index">#@row</span>
                        <div class="min-w-0">
                            <span class="assign-card-emp">@a.Employee?.EmpName</span>
                            <div class="assign-card-phase">@GetPhaseNameSafe(a)</div>
                        </div>
                    </div>

                    <div class="assign-card-dates mt-2">
                        <span class="assign-meta-pill">
                            Plan Date:
                            @(a.PlanStart?.ToString("dd MMM yyyy", th) ?? "-")
                            -
                            @(a.PlanEnd?.ToString("dd MMM yyyy", th) ?? "-")
                        </span>
                        <span class="assign-meta-pill">
                            Period Date:
                            @(a.Phase?.PeriodStartDate?.ToString("dd MMM yyyy", th) ?? "-")
                            -
                            @(a.Phase?.PeriodEndDate?.ToString("dd MMM yyyy", th) ?? "-")
                        </span>
                    </div>
                    <div class="assign-card-role">Role: <span class="text-dark">@a.Role</span></div>
                    <div class="assign-card-remark">
                        <div><b>Assign:</b> @(string.IsNullOrWhiteSpace(a.Remark) ? "-" : a.Remark)</div>
                        <div class="text-muted"><b>Log:</b> @(lastLog == null || string.IsNullOrWhiteSpace(lastLog.Remark) ? "-" : lastLog.Remark)</div>
                    </div>
                </section>

                <aside class="assign-card-right">
                    <div class="assign-status-grid">
                        <div class="assign-status-row">
                            <small>Work</small>
                            @if (a.WorkStatus == "DONE")
                            {
                                <span class="badge bg-success">เสร็จสิ้น</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">กำลังดำเนินการ</span>
                            }
                        </div>
                    </div>

                    <div class="assign-card-actions">
                        @* ===== Edit ===== *@
                        @if (CanMenu("PhaseAssigns.Edit"))
                        {
                            <a asp-action="Edit" asp-route-id="@a.AssignId"
                               class="btn btn-sm btn-outline-primary"
                               title="แก้ไขข้อมูล (Edit)">
                                Edit
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                Edit
                            </button>
                        }

                        @* ===== Delete ===== *@
                        @if (CanMenu("PhaseAssigns.Delete"))
                        {
                            <form asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.AssignId" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        title="ลบข้อมูล (Delete)"
                                        onclick="return confirm('ยืนยันการลบ Assign นี้?');">
                                    Delete
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                Delete
                            </button>
                        }

                        @* ===== PASS ===== *@
                        @if (CanMenu("PhaseAssigns.Edit"))
                        {
                            <button type="button"
                                    class="btn btn-sm btn-success"
                                    title="บันทึกผล: ผ่านงาน (PASS)"
                                    onclick="openLogModal(@a.AssignId, 'PASS')">
                                PASS
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled title="ไม่มีสิทธิ์บันทึก PASS">PASS</button>
                        }

                        @* ===== REWORK ===== *@
                        @if (CanMenu("PhaseAssigns.Edit"))
                        {
                            <button type="button"
                                    class="btn btn-sm btn-warning"
                                    title="บันทึกผล: แก้ไขใหม่ (REWORK)"
                                    onclick="openLogModal(@a.AssignId, 'REWORK')">
                                REWORK
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled title="ไม่มีสิทธิ์บันทึก REWORK">REWORK</button>
                        }
                    </div>
                </aside>
            </div>
            row++;
        }
        </div>
    }

    @* Hidden table for reorder logic only (kept for SortableJS compatibility) *@
    <div style="display:none;">
        <table>
            <tbody id="assign-tbody-hidden"></tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-secondary mt-3">⬆ กรุณาเลือก Project ก่อน</div>
}

<form id="antiForgeryForm" method="post" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="modal fade" id="logModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">บันทึกผล (PASS / REWORK)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label fw-bold">Remark</label>
        <textarea id="logRemark"
                  class="form-control"
                  rows="6"
                  maxlength="1000"
                  oninput="onRemarkInput()"
                  placeholder="พิมพ์หมายเหตุได้สูงสุด 1000 ตัวอักษร"></textarea>
        <div class="text-end text-muted mt-1">
            <span id="logCounter">0 / 1000</span>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
        <button class="btn btn-primary" onclick="submitLog()">บันทึก</button>
      </div>
    </div>
  </div>
</div>

@section Scripts{
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("filterForm");
    const hasProject = @(ViewBag.SelectedProject != null ? "true" : "false");

    function submitSafely() {
        setTimeout(function () {
            form?.submit();
        }, 0);
    }

    function bindSearchDropdown(config) {
        const searchInput = document.getElementById(config.searchId);
        const dropdown = document.getElementById(config.dropdownId);
        const hiddenSelect = document.getElementById(config.selectId);
        const clearButton = document.getElementById(config.clearId);

        if (!searchInput || !dropdown || !hiddenSelect) return;

        const options = Array.from(hiddenSelect.options);

        function updateClearButton() {
            if (!clearButton) return;
            clearButton.classList.toggle("is-visible", Boolean(searchInput.value || hiddenSelect.value));
        }

        function renderList(filter = "") {
            dropdown.innerHTML = "";

            const filtered = options.filter(o =>
                o.text.toLowerCase().includes(filter.toLowerCase()) &&
                o.value !== ""
            )
            .sort((a, b) => {
                if (!config.sortByEndDate) {
                    return a.text.localeCompare(b.text, "th");
                }

                const aRaw = a.dataset.endDate;
                const bRaw = b.dataset.endDate;

                if (!aRaw && !bRaw) return 0;
                if (!aRaw) return 1;
                if (!bRaw) return -1;

                return new Date(aRaw) - new Date(bRaw);
            });

            if (filtered.length === 0) {
                dropdown.style.display = "none";
                return;
            }

            filtered.forEach(o => {
                const item = document.createElement("a");
                item.className = "list-group-item list-group-item-action";
                item.textContent = o.text;

                item.onclick = function () {
                    searchInput.value = o.text;
                    hiddenSelect.value = o.value;
                    dropdown.style.display = "none";
                    updateClearButton();
                    config.onSelect?.();
                    submitSafely();
                };

                dropdown.appendChild(item);
            });

            dropdown.style.display = "block";
        }

        const selectedOption = options.find(o => o.selected && o.value !== "");
        if (selectedOption) {
            searchInput.value = selectedOption.text;
        }
        updateClearButton();

        searchInput.addEventListener("input", function () {
            renderList(this.value);
            updateClearButton();
        });

        searchInput.addEventListener("focus", function () {
            renderList(this.value);
        });

        clearButton?.addEventListener("click", function () {
            searchInput.value = "";
            hiddenSelect.value = "";
            dropdown.style.display = "none";
            updateClearButton();
            config.onClear?.();
            submitSafely();
        });

        document.addEventListener("click", function (e) {
            if (!searchInput.contains(e.target) && !dropdown.contains(e.target) && !clearButton?.contains(e.target)) {
                dropdown.style.display = "none";
            }
        });
    }

    bindSearchDropdown({
        searchId: "projectSearch",
        dropdownId: "projectDropdown",
        selectId: "hiddenProjectSelect",
        clearId: "clearProjectSearch",
        sortByEndDate: true,
        onSelect: function () {
            const employeeSelect = document.getElementById("hiddenEmployeeSelect");
            if (employeeSelect) employeeSelect.value = "";
        },
        onClear: function () {
            const employeeInput = document.getElementById("employeeSearch");
            const employeeSelect = document.getElementById("hiddenEmployeeSelect");
            const employeeClear = document.getElementById("clearEmployeeSearch");
            if (employeeInput) employeeInput.value = "";
            if (employeeSelect) employeeSelect.value = "";
            employeeClear?.classList.remove("is-visible");
        }
    });

    if (hasProject) {
        bindSearchDropdown({
            searchId: "employeeSearch",
            dropdownId: "employeeDropdown",
            selectId: "hiddenEmployeeSelect",
            clearId: "clearEmployeeSearch"
        });
    }
});
</script>

<script>
(function () {
    const tbody = document.getElementById('assign-tbody');
    if (!tbody) return;

    const tokenEl = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
    const antiForgeryToken = tokenEl ? tokenEl.value : null;

    function refreshRowNumbers() {
        const rows = Array.from(document.querySelectorAll('.assign-card[data-assign-id]'));
        let i = 1;
        for (const r of rows) {
            const noCell = r.querySelector('.assign-card-index');
            if (noCell) {
                noCell.textContent = '#' + i;
            }
            i++;
        }
    }

    function collectAssignIds() {
        const rows = Array.from(tbody.querySelectorAll('.assign-card[data-assign-id]'));
        return rows
            .map(r => parseInt(r.getAttribute('data-assign-id') || '0', 10))
            .filter(x => Number.isFinite(x) && x > 0);
    }

    async function saveReorder() {
        const assignIds = collectAssignIds();
        if (!assignIds || assignIds.length === 0) {
            console.error('Reorder failed: empty assignIds');
            alert('บันทึกลำดับไม่สำเร็จ (Reorder)\nสาเหตุ: ไม่พบรายการ assignIds (เป็น 0 แถว)');
            return false;
        }

        // ส่งเป็น JSON array ตรง ๆ เพื่อให้ ModelBinder จับได้ทั้งกรณีที่ Controller รับเป็น int[]/List<int>
        const payload = assignIds;

        const headers = { 'Content-Type': 'application/json' };
        if (antiForgeryToken) headers['RequestVerificationToken'] = antiForgeryToken;

        const selectedProjectId = @((int?)ViewBag.SelectedProjectId ?? 0);
        const reorderUrl = '@Url.Action("Reorder", "PhaseAssigns")' + '?projectId=' + selectedProjectId;

        const res = await fetch(reorderUrl, {
            method: 'POST',
            headers,
            body: JSON.stringify(payload)
        });

        const txt = await res.text();
        if (!res.ok) {
            console.error('Reorder failed:', txt, payload);
            alert('บันทึกลำดับไม่สำเร็จ (Reorder)\n' + (txt || 'Bad Request') + '\nกรุณาเช็ค PhaseAssignsController.Reorder');
            return false;
        }

        if (txt) console.log('Reorder OK:', txt);
        return true;
    }

    Sortable.create(tbody, {
        animation: 150,
        handle: '.drag-handle',
        ghostClass: 'sortable-ghost',
        chosenClass: 'dragging-row',
        // ช่วยให้ลากแถวสุดท้าย/ขอบจอได้ง่ายขึ้น
        forceFallback: true,
        fallbackTolerance: 5,
        scroll: true,
        scrollSensitivity: 60,
        scrollSpeed: 15,
        onEnd: async function () {
            refreshRowNumbers();
            const ok = await saveReorder();
            if (!ok) {
                refreshRowNumbers();
                return;
            }
            refreshRowNumbers();
        }
    });

    refreshRowNumbers();
})();
</script>

<script>
let __logAssignId = null;
let __logStatus = null;

function openLogModal(assignId, status) {
    __logAssignId = assignId;
    __logStatus = status;

    const ta = document.getElementById('logRemark');
    const counter = document.getElementById('logCounter');
    ta.value = '';
    counter.textContent = '0 / 1000';

    const modal = new bootstrap.Modal(document.getElementById('logModal'));
    modal.show();
}

function onRemarkInput() {
    const ta = document.getElementById('logRemark');
    const counter = document.getElementById('logCounter');
    const len = ta.value.length;
    counter.textContent = `${len} / 1000`;
}

function submitLog() {
    const ta = document.getElementById('logRemark');
    const remark = ta.value || '';

    fetch('/PhaseAssigns/SaveLog', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded'
        },
        body: `assignId=${__logAssignId}&status=${__logStatus}&remark=${encodeURIComponent(remark)}`
    })
    .then(res => res.json())
    .then(data => {
        if (data && data.success) {
            alert('บันทึกสำเร็จ (รอบ ' + data.round + ')');
            location.reload();
        } else {
            alert('บันทึกไม่สำเร็จ');
        }
    })
    .catch(() => alert('เกิดข้อผิดพลาด'));
}
</script>
}

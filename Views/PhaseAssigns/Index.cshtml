<form method="get" class="assign-filter-form mb-4" id="filterForm">
    <div class="assign-filter-row">
        <label class="form-label fw-bold">🏢 สหกรณ์</label>
        <select id="projectCoopFilter"
                class="form-select"
                data-placeholder="🔍 พิมพ์ค้นหาสหกรณ์...">
            <option value="">-- ทุกสหกรณ์ --</option>
            @foreach (var coopName in projectCoopOptions)
            {
                <option value="@coopName" selected="@(string.Equals(selectedProjectCoopName, coopName, StringComparison.OrdinalIgnoreCase))">
                    @coopName
                </option>
            }
        </select>

        <label class="form-label fw-bold">📁 โครงการ</label>

        <select name="projectId" id="hiddenProjectSelect" class="form-select form-select-lg" data-project-coop-filter="off">
            <option value="">-- เลือกโครงการ --</option>
            @foreach (var p in projectOptions
                                .OrderBy(x => x.EndDate ?? DateTime.MaxValue))
            {
                <option value="@p.ProjectId"
                        data-coop-name="@(p.Coop?.CoopName ?? "")"
                        data-project-name="@p.ProjectName"
                        data-end-date="@(p.EndDate?.ToString("yyyy-MM-dd") ?? "")"
                        selected="@(selectedProjectId == p.ProjectId)">
                    @p.ProjectName
                </option>
            }
        </select>
    </div>

    <div class="assign-filter-row">
        <label class="form-label fw-bold">👤 Employee</label>

        <select name="empId"
                id="hiddenEmployeeSelect"
                class="form-select form-select-lg"
                @(ViewBag.SelectedProject == null ? "disabled" : "")>
            <option value="">-- All Employees --</option>
            @foreach (var e in ViewBag.EmployeeList)
            {
                if (ViewBag.SelectedEmpId == e.EmpId)
                {
                    <option value="@e.EmpId" selected>@e.EmpName</option>
                }
                else
                {
                    <option value="@e.EmpId">@e.EmpName</option>
                }
            }
        </select>

    </div>
</form>


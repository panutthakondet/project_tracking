@model ProjectTracking.ViewModels.LineOverdueOverviewDetailViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Overdue Overview Detail";
    var th = new CultureInfo("th-TH");
    var rows = Model.Rows ?? new List<ProjectTracking.ViewModels.LineOverdueOverviewAssignViewModel>();
    var coopGroups = Model.CoopGroups ?? new List<ProjectTracking.ViewModels.LineOverdueOverviewCoopGroupViewModel>();
    var selectedCoopName = Model.CoopName;
    var coopList = Model.ProjectOptions
        .Select(x => x.CoopName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    string DateText(DateTime? value) => value?.ToString("dd MMM yyyy", th) ?? "-";
    string DateTimeText(DateTime value) => value.ToString("dd MMM yyyy HH:mm", th);
}

<style>
    .overdue-overview-page {
        padding: 4px 0 28px;
        text-shadow: none;
        text-rendering: auto;
        -webkit-font-smoothing: auto;
        -moz-osx-font-smoothing: auto;
        font-variation-settings: normal;
        -webkit-text-stroke: 0 transparent;
    }

    .overdue-overview-page :is(span, strong, b, label, select, button, input, .btn) {
        text-shadow: none !important;
        text-rendering: auto !important;
        -webkit-font-smoothing: auto !important;
        -moz-osx-font-smoothing: auto !important;
        font-variation-settings: normal !important;
        -webkit-text-stroke: 0 transparent !important;
    }

    .overdue-overview-filter {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        align-items: start;
        padding: 16px;
        border: 1px solid #d8e3ef;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 12px 28px rgba(15, 35, 64, .08);
    }

    .overdue-overview-filter label {
        display: block;
        min-height: 28px;
        margin-bottom: 8px;
        color: #10233f;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
    }

    .overdue-overview-filter > div {
        display: grid;
        grid-template-rows: auto 48px;
        align-content: start;
        min-width: 0;
    }

    .overdue-overview-filter .pt-project-coop-filter {
        margin-bottom: 0;
    }

    .overdue-overview-filter .pt-project-coop-filter .form-label {
        margin-bottom: 8px;
    }

    .overdue-overview-filter :is(select, button, .pt-search-select, .pt-search-select__field, .pt-search-select__input) {
        width: 100%;
        min-height: 48px;
        border-radius: 12px;
        font-weight: 700;
    }

    .overdue-overview-filter :is(.select2-container, .choices, .choices__inner, .ts-wrapper, .ts-control) {
        width: 100% !important;
        min-width: 0;
    }

    .overdue-overview-kpis {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px;
        margin: 14px 0;
    }

    .overdue-overview-kpi {
        --overview-tone: #22c7b8;
        --overview-soft: rgba(34, 199, 184, .18);
        --overview-faint: rgba(34, 199, 184, .045);
        padding: 16px;
        border-radius: 16px;
        border: 1px solid #d8e3ef;
        border-color: color-mix(in srgb, var(--overview-tone) 22%, #d8e3ef);
        border-left: 5px solid var(--overview-tone);
        background:
            linear-gradient(90deg, var(--overview-soft) 0%, var(--overview-faint) 42%, #fff 100%);
        box-shadow: 0 10px 24px rgba(15, 35, 64, .07);
    }

    .overdue-overview-kpi span {
        display: block;
        color: #64748b;
        font-weight: 700;
    }

    .overdue-overview-kpi strong {
        display: block;
        color: #10233f;
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
        margin-top: 8px;
    }

    .overdue-overview-kpi.danger {
        --overview-tone: #f43f5e;
        --overview-soft: rgba(244, 63, 94, .18);
        --overview-faint: rgba(244, 63, 94, .045);
    }
    .overdue-overview-kpi.warning {
        --overview-tone: #f59e0b;
        --overview-soft: rgba(245, 158, 11, .2);
        --overview-faint: rgba(245, 158, 11, .055);
    }
    .overdue-overview-kpi.done {
        --overview-tone: #10b981;
        --overview-soft: rgba(16, 185, 129, .18);
        --overview-faint: rgba(16, 185, 129, .045);
    }
    .overdue-overview-kpi.danger strong { color: #dc2626; }
    .overdue-overview-kpi.warning strong { color: #d97706; }
    .overdue-overview-kpi.done strong { color: #16a34a; }

    .overdue-overview-note {
        margin: 0 0 12px;
        color: #64748b;
        font-weight: 700;
    }

    .overdue-overview-groups {
        display: grid;
        gap: 18px;
    }

    .overdue-overview-group {
        background: rgba(255, 255, 255, .72);
        border: 1px solid #dbe6f3;
        border-radius: 24px;
        padding: 14px;
        box-shadow: 0 14px 30px rgba(15, 40, 74, .08);
    }

    .overdue-overview-group-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
        background: linear-gradient(135deg, rgba(20, 184, 166, .14), rgba(59, 130, 246, .10));
        border: 1px solid rgba(20, 184, 166, .22);
        border-radius: 14px;
        padding: 9px 12px;
    }

    .overdue-overview-group-title {
        min-width: 0;
    }

    .overdue-overview-group-title span {
        display: block;
        color: #64748b;
        font-size: .84rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .overdue-overview-group-title strong {
        display: block;
        color: #0f766e;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.3;
        overflow-wrap: anywhere;
    }

    .overdue-overview-group-stats {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
    }

    .overdue-overview-group-stat {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 30px;
        border: 1px solid #d8e3ef;
        border-radius: 999px;
        padding: 4px 10px;
        color: #475569;
        background: #fff;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
    }

    .overdue-overview-group-stat b {
        color: #10233f;
        font-weight: 700;
    }

    .overdue-overview-group-stat.danger b { color: #dc2626; }
    .overdue-overview-group-stat.warning b { color: #d97706; }
    .overdue-overview-group-stat.done b { color: #16a34a; }

    .overdue-overview-list {
        display: grid;
        gap: 12px;
    }

    .overdue-overview-card {
        --overview-tone: #22c7b8;
        --overview-soft: rgba(34, 199, 184, .16);
        --overview-faint: rgba(34, 199, 184, .04);
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(220px, auto);
        gap: 14px;
        align-items: start;
        border: 1px solid #dbe6f3;
        border-color: color-mix(in srgb, var(--overview-tone) 20%, #dbe6f3);
        border-left: 6px solid var(--overview-tone);
        border-radius: 20px;
        padding: 14px 16px;
        color: #10223e;
        text-decoration: none;
        background:
            linear-gradient(90deg, var(--overview-soft) 0%, var(--overview-faint) 36%, #fff 100%);
        box-shadow: 0 12px 26px rgba(15, 40, 74, .08);
        transition: transform .18s ease, box-shadow .18s ease;
        font-size: 1rem;
        line-height: 1.45;
    }

    .overdue-overview-card.danger {
        --overview-tone: #f43f5e;
        --overview-soft: rgba(244, 63, 94, .16);
        --overview-faint: rgba(244, 63, 94, .04);
    }

    .overdue-overview-card.warning {
        --overview-tone: #f59e0b;
        --overview-soft: rgba(245, 158, 11, .18);
        --overview-faint: rgba(245, 158, 11, .05);
    }

    .overdue-overview-card.done {
        --overview-tone: #10b981;
        --overview-soft: rgba(16, 185, 129, .16);
        --overview-faint: rgba(16, 185, 129, .04);
    }

    .overdue-overview-card:hover {
        color: #10223e;
        transform: translateY(-1px);
        box-shadow: 0 16px 30px rgba(15, 40, 74, .12);
    }

    .overdue-overview-card-main {
        min-width: 0;
    }

    .overdue-overview-card-head {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        min-width: 0;
    }

    .overdue-overview-title {
        margin: 0;
        color: #10223e;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .overdue-overview-project {
        margin: 5px 0 0;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .overdue-overview-label {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.45;
        letter-spacing: 0;
    }

    .overdue-overview-value {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.45;
        letter-spacing: 0;
        overflow-wrap: anywhere;
    }

    .overdue-overview-field {
        min-width: 0;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .overdue-overview-people {
        grid-column: 1 / -1;
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        align-items: center;
        gap: 8px 18px;
        margin-top: 4px;
        padding: 10px 12px;
        border: 1px solid #dbeafe;
        border-radius: 14px;
        background: #f4f8ff;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.45;
    }

    .overdue-overview-people strong {
        color: #0f172a;
        font-weight: 600;
    }

    .overdue-overview-person {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .overdue-overview-person img {
        width: 28px;
        height: 28px;
        border: 1px solid #dbe6f3;
        border-radius: 50%;
        object-fit: cover;
        background: #fff;
        flex: 0 0 auto;
    }

    .overdue-overview-person span {
        overflow-wrap: anywhere;
    }

    .overdue-overview-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 16px;
        margin-top: 8px;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.45;
    }

    .overdue-overview-meta strong {
        color: #0f172a;
        font-weight: 600;
    }

    .overdue-overview-side {
        display: grid;
        gap: 7px;
        justify-items: start;
        text-align: left;
    }

    .overdue-overview-date {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.45;
    }

    .overdue-overview-status-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-start;
    }

    .overdue-overview-remark {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .overdue-overview-status {
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.45;
        white-space: nowrap;
    }

    .overdue-overview-status.done .overdue-overview-value {
        color: #059669;
    }

    .overdue-overview-status.warning .overdue-overview-value {
        color: #d97706;
    }

    .overdue-overview-status.danger .overdue-overview-value {
        color: #e11d48;
    }

    @@media (max-width: 1100px) {
        .overdue-overview-filter,
        .overdue-overview-kpis {
            grid-template-columns: 1fr;
        }

        .overdue-overview-group-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .overdue-overview-group-stats {
            justify-content: flex-start;
        }

        .overdue-overview-card {
            grid-template-columns: 1fr;
        }

        .overdue-overview-side {
            justify-items: start;
            text-align: left;
        }

        .overdue-overview-status-row {
            justify-content: flex-start;
        }

        .overdue-overview-people {
            justify-content: flex-start;
        }
    }
</style>

<div class="overdue-overview-page">
    <section class="index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">Dashboard</span>
            <h1 class="index-title">@ViewData["Title"]</h1>
            <p class="index-subtitle">รายละเอียด Assigns ในโครงการที่มีงานเสี่ยงล่าช้า/ล่าช้า สำหรับภาพรวมแจ้งเตือน LINE/Telegram</p>
        </div>
        <div class="index-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Dashboard</a>
            <a asp-controller="Employees" asp-action="LineOverdue" asp-route-type="ASSIGN_DUE" class="btn btn-outline-light">Send Notification Assigns</a>
        </div>
    </section>

    <form method="get" class="overdue-overview-filter">
        <div>
            <label for="coopFilter" class="form-label">สหกรณ์</label>
            <select id="coopFilter" name="coopName" class="form-select" data-placeholder="พิมพ์ค้นหาสหกรณ์...">
                <option value="">-- All Cooperatives --</option>
                @foreach (var coop in coopList)
                {
                    <option value="@coop" selected="@(string.Equals(selectedCoopName, coop, StringComparison.OrdinalIgnoreCase))">@coop</option>
                }
            </select>
        </div>
        <div>
            <label for="projectId" class="form-label">Project</label>
            <select id="projectId" name="projectId" class="form-select" data-placeholder="พิมพ์ค้นหา Project..." data-project-coop-filter="off">
                <option value="">-- All Projects --</option>
                @foreach (var project in Model.ProjectOptions)
                {
                    <option value="@project.ProjectId"
                            data-coop-name="@project.CoopName"
                            selected="@(Model.ProjectId == project.ProjectId)">
                        @project.ProjectName
                    </option>
                }
            </select>
        </div>
        <div>
            <label for="status" class="form-label">Status</label>
            <select id="status" name="status" class="form-select" data-placeholder="พิมพ์ค้นหา Status...">
                <option value="">-- All Statuses --</option>
                <option value="DANGER" selected="@(string.Equals(Model.Status, "DANGER", StringComparison.OrdinalIgnoreCase))">ล่าช้า</option>
                <option value="WARNING" selected="@(string.Equals(Model.Status, "WARNING", StringComparison.OrdinalIgnoreCase))">เสี่ยงล่าช้า</option>
                <option value="DONE" selected="@(string.Equals(Model.Status, "DONE", StringComparison.OrdinalIgnoreCase))">เสร็จสิ้นแล้ว</option>
            </select>
        </div>
    </form>

    <section class="overdue-overview-kpis">
        <article class="overdue-overview-kpi">
            <span>Projects</span>
            <strong>@Model.ProjectCount</strong>
        </article>
        <article class="overdue-overview-kpi">
            <span>Total Assigns</span>
            <strong>@Model.TotalCount</strong>
        </article>
        <article class="overdue-overview-kpi danger">
            <span>ล่าช้า</span>
            <strong>@Model.DangerCount</strong>
        </article>
        <article class="overdue-overview-kpi warning">
            <span>เสี่ยงล่าช้า</span>
            <strong>@Model.WarningCount</strong>
        </article>
        <article class="overdue-overview-kpi done">
            <span>Done</span>
            <strong>@Model.DoneCount</strong>
        </article>
    </section>

    <p class="overdue-overview-note">
        นับ Assigns ในโครงการที่มีงานยังไม่เสร็จและเข้าเงื่อนไขเสี่ยง/ล่าช้า ช่วงแจ้งเตือน @Model.RiskDays วัน
        ข้อมูล ณ @DateTimeText(Model.GeneratedAt)
    </p>

    @if (rows.Count == 0)
    {
        <div class="alert alert-warning fw-bold">ไม่พบ Assigns ตามเงื่อนไขที่เลือก</div>
    }
    else
    {
        <div class="overdue-overview-groups">
            @foreach (var group in coopGroups)
            {
                <section class="overdue-overview-group">
                    <div class="overdue-overview-group-head">
                        <div class="overdue-overview-group-title">
                            <span>สหกรณ์</span>
                            <strong>@group.CoopName</strong>
                        </div>
                        <div class="overdue-overview-group-stats">
                            <span class="overdue-overview-group-stat">Projects <b>@group.ProjectCount</b></span>
                            <span class="overdue-overview-group-stat">Assigns <b>@group.TotalCount</b></span>
                            <span class="overdue-overview-group-stat danger">ล่าช้า <b>@group.DangerCount</b></span>
                            <span class="overdue-overview-group-stat warning">เสี่ยง <b>@group.WarningCount</b></span>
                            <span class="overdue-overview-group-stat done">Done <b>@group.DoneCount</b></span>
                        </div>
                    </div>

                    <div class="overdue-overview-list">
                        @foreach (var row in group.Rows)
                        {
                            <a class="overdue-overview-card @row.StatusTone"
                               asp-controller="PhaseAssigns"
                               asp-action="Index"
                               asp-route-projectId="@row.ProjectId"
                               asp-route-empId="@row.EmpId">
                                <div class="overdue-overview-card-main">
                                    <div class="overdue-overview-card-head">
                                        <div class="min-w-0">
                                            <h3 class="overdue-overview-title">
                                                <span class="overdue-overview-label">งาน:</span>
                                                <span class="overdue-overview-value">@row.Role</span>
                                            </h3>
                                            <p class="overdue-overview-project">
                                                <span class="overdue-overview-label">โครงการ:</span>
                                                <span class="overdue-overview-value">@row.ProjectName</span>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="overdue-overview-meta">
                                        <span class="overdue-overview-field">
                                            <span class="overdue-overview-label">Phase Name:</span>
                                            <span class="overdue-overview-value">@row.PhaseName</span>
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(row.Remark) && row.Remark != "-")
                                    {
                                        <div class="overdue-overview-remark">
                                            <span class="overdue-overview-label">Remark:</span>
                                            <span class="overdue-overview-value">@row.Remark</span>
                                        </div>
                                    }
                                </div>
                                <div class="overdue-overview-side">
                                    <div class="overdue-overview-date">
                                        <span class="overdue-overview-label">วันที่กำหนด:</span>
                                        <span class="overdue-overview-value">@DateText(row.PlanStart) - @DateText(row.PlanEnd)</span>
                                    </div>
                                    <div class="overdue-overview-date">
                                        <span class="overdue-overview-label">กำหนดงวดงาน:</span>
                                        <span class="overdue-overview-value">@DateText(row.PeriodEnd)</span>
                                    </div>
                                    <div class="overdue-overview-status-row">
                                        <span class="overdue-overview-status @row.StatusTone">
                                            <span class="overdue-overview-label">สถานะ:</span>
                                            <span class="overdue-overview-value">@row.StatusText</span>
                                        </span>
                                    </div>
                                </div>
                                <div class="overdue-overview-people">
                                    <span class="overdue-overview-person">
                                        <img class="pt-owner-avatar"
                                             src="@row.OwnerAvatarPath"
                                             alt="@row.OwnerName"
                                             loading="lazy"
                                             onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                        <span>
                                            <span class="overdue-overview-label">ผู้รับผิดชอบ:</span>
                                            <span class="overdue-overview-value">@row.OwnerName</span>
                                        </span>
                                    </span>
                                    <span class="overdue-overview-person">
                                        <img class="pt-owner-avatar"
                                             src="@row.BaAvatarPath"
                                             alt="@row.BaName"
                                             loading="lazy"
                                             onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                        <span>
                                            <span class="overdue-overview-label">BA:</span>
                                            <span class="overdue-overview-value">@row.BaName</span>
                                        </span>
                                    </span>
                                </div>
                            </a>
                        }
                    </div>
                </section>
            }
        </div>
    }

    <script>
        (function () {
            const normalize = value => (value || "").toString().trim().toLowerCase();
            const coopFilter = document.getElementById("coopFilter");
            const projectFilter = document.getElementById("projectId");
            const form = coopFilter?.closest("form");

            function submitFilters() {
                if (!form) return;
                if (typeof form.requestSubmit === "function") form.requestSubmit();
                else form.submit();
            }

            function syncProjectFilterOptions() {
                if (!projectFilter) return;

                const selectedCoop = normalize(coopFilter?.value || "");
                Array.from(projectFilter.options).forEach(option => {
                    const visible = option.value === "" || !selectedCoop || normalize(option.dataset.coopName || "") === selectedCoop;
                    option.hidden = !visible;
                    option.disabled = !visible;
                });

                const selected = projectFilter.selectedOptions[0];
                if (selected && selected.disabled) projectFilter.value = "";
            }

            coopFilter?.addEventListener("change", function () {
                if (projectFilter) projectFilter.value = "";
                syncProjectFilterOptions();
                submitFilters();
            });

            [projectFilter, document.getElementById("empId"), document.getElementById("status")]
                .forEach(select => select?.addEventListener("change", submitFilters));

            syncProjectFilterOptions();
        })();
    </script>
</div>

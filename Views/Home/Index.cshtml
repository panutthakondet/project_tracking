    font-size:11px;
    font-weight:900;
    line-height:1;
}

.yearly-y-axis span {
    position:absolute;
    right:0;
    transform:translateY(-50%);
}

.yearly-plot {
    grid-column:2;
    grid-row:1;
    position:relative;
    min-width:0;
    overflow-x:hidden;
    overflow-y:hidden;
    scrollbar-color:rgba(20,184,166,.65) rgba(15,35,64,.45);

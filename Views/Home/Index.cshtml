    gap:44px;
    color:#f8fbff;
    font-size:13px;
    font-weight:900;
}

.yearly-legend span {
    display:inline-flex;
    align-items:center;
    gap:9px;
}

.time-layout {
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns:minmax(150px, .8fr) minmax(220px, 1.2fr);

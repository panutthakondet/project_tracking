<script>
    (() => {
        const dashboard = document.querySelector('.dashboard-view.is-loading');
        if (!dashboard) return;

        const reveal = () => dashboard.classList.remove('is-loading');
        requestAnimationFrame(() => requestAnimationFrame(reveal));
        window.setTimeout(reveal, 180);
    })();

    (() => {
        const habitat = document.querySelector('[data-dashboard-dino]');
        if (!habitat) return;

        const feedZone = habitat.querySelector('[data-dino-feed-zone]');
        const food = habitat.querySelector('[data-dino-food]');
        const runner = habitat.querySelector('.dashboard-dino-runner');
        const stage = habitat.querySelector('.dashboard-dino-stage');
        if (!feedZone || !food || !runner || !stage) return;

        const storageKey = habitat.dataset.dinoKey || 'ProjectTracking.DashboardDino.guest';
        const maxFood = 100;
        const feedAmount = 22;
        const decayPerMinute = 7;
        const syncIntervalMs = 10000;
        let memoryState = { level: 0, updatedAt: Date.now(), routeStartLeft: null, routeStartTop: null };
        let seekTimer = null;
        let eatTimer = null;
        let resumeTimer = null;

        const clampLevel = value => Math.max(0, Math.min(maxFood, Number.isFinite(value) ? value : 0));
        const clamp = (value, min, max) => Math.max(min, Math.min(max, value));
        const optionalNumber = value => {
            if (value === null || value === undefined || value === '') return null;

            const numeric = Number(value);
            return Number.isFinite(numeric) ? numeric : null;
        };

        const readState = () => {
            try {
                const stored = window.localStorage?.getItem(storageKey);
                if (!stored) return memoryState;

                const parsed = JSON.parse(stored);
                return {
                    level: clampLevel(Number(parsed.level)),
                    updatedAt: Number(parsed.updatedAt) || Date.now(),
                    routeStartLeft: optionalNumber(parsed.routeStartLeft),
                    routeStartTop: optionalNumber(parsed.routeStartTop)
                };
            } catch {
                return memoryState;
            }
        };

        const writeState = state => {
            memoryState = {
                level: clampLevel(Number(state.level)),
                updatedAt: Number(state.updatedAt) || Date.now(),
                routeStartLeft: optionalNumber(state.routeStartLeft),
                routeStartTop: optionalNumber(state.routeStartTop)
            };
            try {
                window.localStorage?.setItem(storageKey, JSON.stringify(memoryState));
            } catch {
                // localStorage can be unavailable in private or locked-down browsers.
            }
        };

        const decayedLevel = (state, at) => {
            const updatedAt = Number(state.updatedAt) || at;
            const elapsedMs = Math.max(0, at - updatedAt);
            const decay = elapsedMs / 60000 * decayPerMinute;
            return clampLevel(clampLevel(Number(state.level)) - decay);
        };

        const render = level => {
            const safeLevel = clampLevel(level);
            const ratio = safeLevel / maxFood;
            const ratioText = ratio.toFixed(3);

            habitat.style.setProperty('--dashboard-dino-growth', ratioText);
            habitat.classList.toggle('is-dino-fed', safeLevel > 1);
        };

        const sync = () => {
            const at = Date.now();
            const currentState = readState();
            const level = decayedLevel(currentState, at);
            const state = { ...currentState, level, updatedAt: at };
            render(level);
            writeState(state);
        };

        const feedDino = () => {
            const at = Date.now();
            const currentState = readState();
            const level = clampLevel(decayedLevel(currentState, at) + feedAmount);
            const state = { ...currentState, level, updatedAt: at };

            writeState(state);
            render(level);
        };

        const clearSeekTimers = () => {
            window.clearTimeout(seekTimer);
            window.clearTimeout(eatTimer);
            window.clearTimeout(resumeTimer);
        };

        const restartRouteAnimation = () => {
            runner.style.animation = 'none';
            stage.style.animation = 'none';
            void runner.offsetWidth;
            runner.style.animation = '';
            stage.style.animation = '';
        };

        const setRouteStart = (left, top) => {
            if (!Number.isFinite(left) || !Number.isFinite(top)) return;

            const habitatRect = habitat.getBoundingClientRect();
            const runnerRect = runner.getBoundingClientRect();
            const maxLeft = Math.max(0, habitatRect.width - runnerRect.width);
            const safeLeft = habitatRect.width > 0 ? clamp(left, 0, maxLeft) : left;
            const safeTop = clamp(top, -44, 8);

            habitat.style.setProperty('--dashboard-dino-route-start-left', `${safeLeft}px`);
            habitat.style.setProperty('--dashboard-dino-route-start-top', `${safeTop}px`);
            planRouteFromStart(safeLeft, safeTop);
            return { left: safeLeft, top: safeTop };
        };

        const getRouteMetrics = () => {
            const styles = window.getComputedStyle(habitat);
            const habitatRect = habitat.getBoundingClientRect();
            const runnerRect = runner.getBoundingClientRect();
            const cssPx = (name, fallback) => {
                const value = parseFloat(styles.getPropertyValue(name));
                return Number.isFinite(value) ? value : fallback;
            };
            const width = habitatRect.width;
            const dinoWidth = runnerRect.width || cssPx('--dashboard-dino-width', 46);
            const dinoHeight = runnerRect.height || cssPx('--dashboard-dino-height', 34);
            const inset = cssPx('--dashboard-dino-inset', 18);
            const columnGap = parseFloat(styles.columnGap) || cssPx('--kpi-grid-gap', 18);
            const rowGap = parseFloat(styles.rowGap) || columnGap;
            const cardMinHeight = cssPx('--kpi-card-min-height', 176);
            const overviewGap = cssPx('--dashboard-dino-overview-gap', 20);
            const tracks = styles.gridTemplateColumns
                .split(' ')
                .map(track => track.trim())
                .filter(Boolean);
            const columns = tracks.length || (width <= 1024 ? 2 : 4);
            const cardWidth = columns > 0
                ? (width - (columnGap * Math.max(0, columns - 1))) / columns
                : width;
            const edgeTop = (dinoHeight * -1) + 2;
            const rowStep = cardMinHeight + rowGap;
            const cards = Array.from({ length: 4 }, (_, index) => {
                const col = columns > 0 ? index % columns : index;
                const row = columns > 0 ? Math.floor(index / columns) : 0;
                const start = col * (cardWidth + columnGap) + inset;
                const top = row * rowStep + edgeTop;

                return {
                    start,
                    end: Math.max(start, start + cardWidth - dinoWidth - inset - inset),
                    top
                };
            });
            const rows = Math.max(1, Math.ceil(cards.length / Math.max(1, columns)));

            return {
                cards,
                overviewStart: inset,
                overviewEnd: Math.max(inset, width - dinoWidth - inset),
                overviewTop: ((rows - 1) * rowStep) + cardMinHeight + overviewGap + edgeTop
            };
        };

        const planRouteFromStart = (startLeft, startTop) => {
            const route = getRouteMetrics();
            const activeCardIndex = route.cards.findIndex(card => startLeft <= card.end);
            const firstStepIndex = activeCardIndex >= 0 ? activeCardIndex : route.cards.length;
            const forwardCards = route.cards.slice(firstStepIndex);
            const currentPoint = { start: startLeft, end: startLeft, top: startTop };
            const routeSteps = [...forwardCards];

            while (routeSteps.length < 4) {
                const lastStep = routeSteps[routeSteps.length - 1] ?? currentPoint;
                routeSteps.push({ start: lastStep.end, end: lastStep.end, top: lastStep.top });
            }

            const step1End = routeSteps[0] ?? currentPoint;
            const step2 = routeSteps[1] ?? currentPoint;
            const step3 = routeSteps[2] ?? currentPoint;
            const step4 = routeSteps[3] ?? currentPoint;
            const setPoint = (name, left, top) => {
                habitat.style.setProperty(`${name}-left`, `${left}px`);
                habitat.style.setProperty(`${name}-top`, `${top}px`);
            };
            const setHop = (name, from, to) => {
                const changed =
                    Math.abs((to.start ?? to.end) - from.end) > 0.5 ||
                    Math.abs(to.top - from.top) > 0.5;

                habitat.style.setProperty(name, changed ? '-24px' : '0px');
            };
            const startFace = step1End.end >= startLeft ? 1 : -1;
            const returnFace = startLeft >= route.overviewStart ? 1 : -1;

            setPoint('--dashboard-dino-route-step-1-end', step1End.end, step1End.top);
            setPoint('--dashboard-dino-route-step-2-start', step2.start, step2.top);
            setPoint('--dashboard-dino-route-step-2-end', step2.end, step2.top);
            setPoint('--dashboard-dino-route-step-3-start', step3.start, step3.top);
            setPoint('--dashboard-dino-route-step-3-end', step3.end, step3.top);
            setPoint('--dashboard-dino-route-step-4-start', step4.start, step4.top);
            setPoint('--dashboard-dino-route-step-4-end', step4.end, step4.top);
            setPoint('--dashboard-dino-route-loop', route.cards[0]?.start ?? route.overviewStart, route.cards[0]?.top ?? startTop);
            setHop('--dashboard-dino-route-step-2-hop', step1End, step2);
            setHop('--dashboard-dino-route-step-3-hop', step2, step3);
            setHop('--dashboard-dino-route-step-4-hop', step3, step4);

            habitat.style.setProperty('--dashboard-dino-route-start-face', String(startFace));
            habitat.style.setProperty('--dashboard-dino-route-return-face', String(returnFace));
        };

        const applyDefaultRouteStart = () => {
            const route = getRouteMetrics();
            const firstCard = route.cards[0];
            if (!firstCard) return;

            setRouteStart(firstCard.start, firstCard.top);
        };

        const saveRouteStart = (left, top) => {
            const routeStart = setRouteStart(left, top);
            if (!routeStart) return;

            writeState({
                ...readState(),
                routeStartLeft: routeStart.left,
                routeStartTop: routeStart.top
            });
        };

        const applyStoredRouteStart = () => {
            const state = readState();
            setRouteStart(optionalNumber(state.routeStartLeft), optionalNumber(state.routeStartTop));
        };

        const resumeRoute = (startLeft, startTop) => {
            runner.classList.remove('is-seeking-food', 'is-eating');
            saveRouteStart(startLeft, startTop);
            runner.style.left = '';
            runner.style.top = '';
            runner.style.transition = '';
            runner.style.removeProperty('--dino-seek-duration');
            stage.style.transform = '';
            food.classList.remove('is-ready', 'is-eaten');
            restartRouteAnimation();
        };

        const placeFood = event => {
            event.preventDefault();
            event.stopPropagation();
            clearSeekTimers();

            const habitatRect = habitat.getBoundingClientRect();
            const runnerRect = runner.getBoundingClientRect();
            const currentLeft = runnerRect.left - habitatRect.left;
            const currentTop = runnerRect.top - habitatRect.top;
            const clickX = event.clientX - habitatRect.left;
            const clickY = event.clientY - habitatRect.top;
            const foodX = clamp(clickX, 18, habitatRect.width - 18);
            const foodY = clamp(clickY, -34, 10);
            const targetLeft = clamp(foodX - runnerRect.width / 2, 0, habitatRect.width - runnerRect.width);
            const targetTop = clamp(foodY - runnerRect.height + 10, -44, 8);
            const distance = Math.hypot(targetLeft - currentLeft, targetTop - currentTop);
            const duration = clamp(distance * 8, 950, 4200);

            food.classList.remove('is-ready', 'is-eaten');
            food.style.left = `${foodX}px`;
            food.style.top = `${foodY}px`;
            void food.offsetWidth;
            food.classList.add('is-ready');

            runner.classList.remove('is-eating');
            runner.classList.add('is-seeking-food');
            runner.style.transition = 'none';
            runner.style.left = `${currentLeft}px`;
            runner.style.top = `${currentTop}px`;
            stage.style.transform = targetLeft >= currentLeft ? 'scaleX(1)' : 'scaleX(-1)';
            void runner.offsetWidth;
            runner.style.setProperty('--dino-seek-duration', `${duration}ms`);
            runner.style.transition = '';
            runner.style.left = `${targetLeft}px`;
            runner.style.top = `${targetTop}px`;

            seekTimer = window.setTimeout(() => {
                runner.classList.add('is-eating');
                food.classList.add('is-eaten');
                feedDino();

                eatTimer = window.setTimeout(() => {
                    food.classList.remove('is-ready', 'is-eaten');
                }, 620);

                resumeTimer = window.setTimeout(() => resumeRoute(targetLeft, targetTop), 980);
            }, duration + 80);
        };

        feedZone.addEventListener('dblclick', placeFood);
        runner.addEventListener('animationiteration', event => {
            if (event.target !== runner || event.animationName !== 'dashboardDinoCardHop')
                return;

            if (runner.classList.contains('is-seeking-food') || runner.classList.contains('is-eating'))
                return;

            applyDefaultRouteStart();
        });

        applyStoredRouteStart();
        sync();
        window.setInterval(sync, syncIntervalMs);
        document.addEventListener('visibilitychange', () => {
            if (!document.hidden) sync();
        });
    })();

    (() => {
        const searchInput = document.getElementById('projectOverviewSearch');
        if (!searchInput) return;

        const rows = Array.from(document.querySelectorAll('.project-overview-row[data-project-search]'));
        const departmentButtons = Array.from(document.querySelectorAll('[data-project-department]'));
        const emptyMessage = document.querySelector('.project-overview-empty');
        const donut = document.querySelector('[data-project-status-donut]');
        const totalElement = document.querySelector('[data-project-status-total]');
        const metricElements = new Map(
            Array.from(document.querySelectorAll('[data-project-status-metric]'))
                .map(element => [element.dataset.projectStatusMetric, element.querySelector('b')])
        );
        const normalize = value => String(value ?? '').trim().replace(/\s+/g, ' ').toLowerCase();
        let selectedDepartment = 'all';

        const updateStatusSummary = matchingDepartmentRows => {
            const total = matchingDepartmentRows.length;
            const counts = {
                'Completed': matchingDepartmentRows.filter(row => row.dataset.projectStatus === 'DONE').length,
                'In Progress': matchingDepartmentRows.filter(row => row.dataset.projectStatus === 'IN_PROGRESS').length,
                'Pending': matchingDepartmentRows.filter(row => row.dataset.projectStatus === 'PLAN').length
            };

            if (totalElement) totalElement.textContent = String(total);

            Object.entries(counts).forEach(([label, count]) => {
                const percent = total === 0 ? 0 : (count * 100 / total);
                const valueElement = metricElements.get(label);
                if (valueElement) valueElement.textContent = `${count} (${percent.toLocaleString('th-TH', { maximumFractionDigits: 1 })}%)`;
            });

            if (donut) {
                const completedEnd = total === 0 ? 0 : counts['Completed'] * 100 / total;
                const progressEnd = total === 0 ? 0 : completedEnd + counts['In Progress'] * 100 / total;
                const pendingEnd = total === 0 ? 0 : progressEnd + counts.Pending * 100 / total;
                donut.style.setProperty('--donut', total === 0
                    ? 'conic-gradient(#263450 0 100%)'
                    : `conic-gradient(#10d58f 0 ${completedEnd}%, #1688f5 ${completedEnd}% ${progressEnd}%, #fb9a13 ${progressEnd}% ${pendingEnd}%, #263450 ${pendingEnd}% 100%)`);
            }
        };

        const applyFilter = () => {
            const keyword = normalize(searchInput.value);
            let visibleCount = 0;
            const matchingDepartmentRows = rows.filter(row =>
                selectedDepartment === 'all' || row.dataset.projectDepartmentId === selectedDepartment);

            rows.forEach((row, index) => {
                const text = normalize(row.dataset.projectSearch || row.textContent);
                const matchesSearch = !keyword || text.includes(keyword);
                const matchesDepartment = selectedDepartment === 'all'
                    || row.dataset.projectDepartmentId === selectedDepartment;
                const isVisible = matchesSearch && matchesDepartment;
                row.classList.toggle('is-filter-hidden', !isVisible);
                if (isVisible) visibleCount++;
            });

            if (emptyMessage) {
                emptyMessage.hidden = visibleCount > 0;
            }

            updateStatusSummary(matchingDepartmentRows);
        };

        searchInput.addEventListener('input', applyFilter);
        departmentButtons.forEach(button => {
            button.addEventListener('click', () => {
                selectedDepartment = button.dataset.projectDepartment || 'all';
                departmentButtons.forEach(item => {
                    const isActive = item === button;
                    item.classList.toggle('is-active', isActive);
                    item.setAttribute('aria-pressed', String(isActive));
                });
                applyFilter();
            });
        });
        applyFilter();
    })();

    (() => {
        const root = document.querySelector('[data-dashboard-search]');
        if (!root) return;

        const input = document.getElementById('dashboardGlobalSearch');
        const resultsBox = root.querySelector('[data-dashboard-search-results]');
        const clearButton = root.querySelector('[data-dashboard-search-clear]');
        const searchUrl = root.dataset.dashboardSearchUrl;
        const groupLabels = {
            Projects: 'Projects',
            ProjectPhases: 'Project Phases',
            PhaseAssigns: 'Assign Phase',
            ProjectIssues: 'Issues',
            SupportOrders: 'Support'
        };

        let timer = null;
        let controller = null;

        const escapeHtml = value => String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');

        const normalizeItem = item => ({
            type: item.type ?? item.Type ?? '',
            title: item.title ?? item.Title ?? '',
            detail: item.detail ?? item.Detail ?? '',
            url: item.url ?? item.Url ?? '#',
            color: item.color ?? item.Color ?? 'blue'
        });

        const setResults = html => {
            resultsBox.innerHTML = html;
            resultsBox.hidden = false;
        };

        const renderResults = items => {
            if (!items.length) {
                setResults('<p class="dashboard-search-state">ไม่พบข้อมูลที่ตรงกับคำค้น</p>');
                return;
            }

            const normalized = items.map(normalizeItem);
            const groups = normalized.reduce((map, item) => {
                if (!map.has(item.type)) map.set(item.type, []);
                map.get(item.type).push(item);
                return map;
            }, new Map());

            const html = Array.from(groups.entries()).map(([type, groupItems]) => {
                const label = groupLabels[type] || type || 'ผลลัพธ์';
                const list = groupItems.map(item => `
                    <a class="dashboard-search-result" href="${escapeHtml(item.url)}">
                        <span class="dashboard-search-result-mark ${escapeHtml(item.color)}" aria-hidden="true"></span>
                        <span class="dashboard-search-result-body">
                            <strong class="dashboard-search-result-title">${escapeHtml(item.title)}</strong>
                            <span class="dashboard-search-result-detail">${escapeHtml(item.detail)}</span>
                        </span>
                    </a>
                `).join('');

                return `
                    <div class="dashboard-search-group">
                        <p class="dashboard-search-group-title">${escapeHtml(label)} <span>${groupItems.length}</span></p>
                        ${list}
                    </div>
                `;
            }).join('');

            setResults(html);
        };

        const doSearch = async () => {
            const keyword = input.value.trim();
            clearButton.hidden = keyword.length === 0;

            if (keyword.length < 2) {
                resultsBox.hidden = true;
                resultsBox.innerHTML = '';
                return;
            }

            if (controller) controller.abort();
            controller = new AbortController();
            setResults('<p class="dashboard-search-state">กำลังค้นหา...</p>');

            try {
                const response = await fetch(`${searchUrl}?q=${encodeURIComponent(keyword)}`, {
                    signal: controller.signal,
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) throw new Error('search failed');
                renderResults(await response.json());
            } catch (error) {
                if (error.name === 'AbortError') return;
                setResults('<p class="dashboard-search-state">ค้นหาไม่สำเร็จ ลองใหม่อีกครั้ง</p>');
            }
        };

        input.addEventListener('input', () => {
            window.clearTimeout(timer);
            timer = window.setTimeout(doSearch, 220);
        });

        input.addEventListener('focus', () => {
            if (input.value.trim().length >= 2 && resultsBox.innerHTML.trim()) {
                resultsBox.hidden = false;
            }
        });

        clearButton.addEventListener('click', () => {
            input.value = '';
            clearButton.hidden = true;
            resultsBox.hidden = true;
            resultsBox.innerHTML = '';
            input.focus();
        });

        document.addEventListener('click', event => {
            if (!root.contains(event.target)) {
                resultsBox.hidden = true;
            }
        });
    })();
</script>

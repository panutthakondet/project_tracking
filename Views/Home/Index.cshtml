    align-items:center;
    justify-content:center;
    background:#1d355f;
    color:#fff;
    font-size:10px;
    font-style:normal;
    font-weight:900;
}

.yearly-chart {
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns:44px minmax(0, 1fr);
    grid-template-rows:minmax(238px, auto) 22px 28px;
    column-gap:10px;
    min-width:0;
    padding:24px 22px 14px 22px;
    border:1px solid rgba(48,161,255,.3);
    border-radius:14px;
    background:
        radial-gradient(circle at 50% 46%, rgba(0,108,255,.16), transparent 42%),
        linear-gradient(180deg, rgba(4,26,61,.64), rgba(3,20,48,.72));
    box-shadow:inset 0 1px 0 rgba(255,255,255,.05);
}

.yearly-y-title {

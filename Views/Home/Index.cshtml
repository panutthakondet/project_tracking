}

.dashboard-open-work-body strong,
.dashboard-open-work-body small,
.dashboard-open-work-body em {
    min-width:0;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.dashboard-open-work-body strong {
    font-size:14px;
    line-height:1.25;
    font-weight:1000;
}

.dashboard-open-work-body small {
    color:#c7d8ee;
    font-size:12px;
    font-weight:800;
}

.dashboard-open-work-body em {
    color:#93a9c8;
    font-style:normal;
    font-size:11px;
    font-weight:800;
}

.dashboard-open-work-actions {
    display:grid;
    grid-template-columns:1fr 1fr;

}

.project-overview-action-icon.details {
    border:2px solid currentColor;
    border-radius:3px;
    opacity:.95;
}

.project-overview-action-icon.details::before,
.project-overview-action-icon.details::after {
    content:"";
    position:absolute;
    left:2px;
    right:2px;
    height:2px;
    border-radius:999px;
    background:currentColor;
    box-shadow:0 5px 0 currentColor;
}

.project-overview-action-icon.details::before {
    top:3px;
}

.project-overview-action-icon.details::after {
    top:11px;
    left:10px;
    right:auto;
    width:3px;
    height:3px;
    border-radius:50%;
    box-shadow:none;
}

.project-overview-action-icon.team::before {
    content:"";
    position:absolute;
    left:6px;
    top:1px;
    width:6px;
    height:6px;
    border-radius:50%;
    background:currentColor;
    box-shadow:-6px 6px 0 -1px currentColor, 6px 6px 0 -1px currentColor;
}

.project-overview-action-icon.team::after {
    content:"";
    position:absolute;
    left:1px;
    right:1px;
    bottom:1px;
    height:8px;
    border-radius:8px 8px 3px 3px;
    background:currentColor;

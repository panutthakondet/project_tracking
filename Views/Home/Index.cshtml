@model ProjectTracking.ViewModels.HomeDashboardViewModel
@using Microsoft.AspNetCore.Http
@using System.Globalization
@using ProjectTracking.ViewModels

@{
    ViewData["Title"] = "Dashboard";

    var dashboard = Model ?? new HomeDashboardViewModel();
    var attendanceProgressWidth = Math.Clamp(dashboard.MonthAttendanceRate, 0m, 100m).ToString("0.#", CultureInfo.InvariantCulture);
    var yearlyTaskAxisTicks = new[] { 30, 25, 20, 15, 10, 5, 0 };
    var yearlyCompletedTotal = dashboard.YearlyTasks.Sum(task => task.Completed);
    var yearlyInProgressTotal = dashboard.YearlyTasks.Sum(task => task.InProgress);
    var openIssueSupportCount = dashboard.OpenIssueSupportCount;
    var todayIso = DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var onlineUsers = ViewBag.OnlineUsers is IEnumerable<RequirementBoardOnlineUserViewModel> onlineUserRows
        ? onlineUserRows.ToList()
        : new List<RequirementBoardOnlineUserViewModel>();
    var visibleOnlineUsers = onlineUsers.Take(5).ToList();
    var hiddenOnlineCount = Math.Max(0, onlineUsers.Count - visibleOnlineUsers.Count);
    var dashboardDinoUserKey = Context.Session.GetInt32("UserId")?.ToString(CultureInfo.InvariantCulture) ?? "guest";
    var dashboardDinoName = (ViewBag.DashboardDinoName as string ?? "Dino").Trim();
    var pendingStatusApprovalCount = Convert.ToInt32(ViewBag.PendingStatusApprovalCount ?? 0);
    if (string.IsNullOrWhiteSpace(dashboardDinoName))
    {
        dashboardDinoName = "Dino";
    }

    string SvgNumber(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    (double X, double Y) EllipsePoint(double cx, double cy, double rx, double ry, double angle)
    {
        var radians = Math.PI * angle / 180d;
        return (cx + rx * Math.Cos(radians), cy + ry * Math.Sin(radians));
    }

    string StatusHex(string color) => color switch
    {
        "green" or "success" => "var(--pt-chart-success, #7bdc49)",
        "blue" or "primary" => "var(--pt-chart-primary, #2693f4)",
        "orange" or "warning" => "var(--pt-chart-warning, #ff9f1c)",
        "cyan" or "info" => "var(--pt-chart-info, #13d6c9)",
        "lime" => "#8cff3f",
        "purple" or "violet" => "var(--pt-chart-alt, #8b5cf6)",
        "pink" or "danger" => "var(--pt-chart-danger, #f55262)",
        "dark" or "secondary" or "muted" => "var(--pt-chart-muted, #64748b)",
        _ => "var(--pt-chart-primary, #45d6c6)"
    };

    string StatusDarkHex(string color) => color switch
    {
        "green" or "success" => "var(--pt-chart-success-dark, #4eaa2f)",
        "blue" or "primary" => "var(--pt-chart-primary-dark, #1269b8)",
        "orange" or "warning" => "var(--pt-chart-warning-dark, #b86100)",
        "cyan" or "info" => "var(--pt-chart-info-dark, #087f75)",
        "lime" => "#4ca51f",
        "purple" or "violet" => "var(--pt-chart-alt-dark, #6733b8)",
        "pink" or "danger" => "var(--pt-chart-danger-dark, #c92d3d)",
        "dark" or "secondary" or "muted" => "var(--pt-chart-muted, #334155)",
        _ => "var(--pt-chart-primary-dark, #159b91)"
    };

    string PieSegmentPath(double start, double end, double offsetY = 0)
    {
        const double cx = 78d;
        const double cy = 66d;
        const double outerRx = 66d;
        const double outerRy = 36d;
        const double innerRx = 39d;
        const double innerRy = 21d;

        if (Math.Abs(end - start) >= 359.99d)
        {
            var fullOuterStart = EllipsePoint(cx, cy + offsetY, outerRx, outerRy, start);
            var fullOuterMid = EllipsePoint(cx, cy + offsetY, outerRx, outerRy, start + 180d);
            var fullInnerStart = EllipsePoint(cx, cy + offsetY, innerRx, innerRy, start);
            var fullInnerMid = EllipsePoint(cx, cy + offsetY, innerRx, innerRy, start + 180d);

            return string.Join(" ", new[]
            {
                $"M {SvgNumber(fullOuterStart.X)} {SvgNumber(fullOuterStart.Y)}",
                $"A {outerRx} {outerRy} 0 1 1 {SvgNumber(fullOuterMid.X)} {SvgNumber(fullOuterMid.Y)}",
                $"A {outerRx} {outerRy} 0 1 1 {SvgNumber(fullOuterStart.X)} {SvgNumber(fullOuterStart.Y)}",
                $"L {SvgNumber(fullInnerStart.X)} {SvgNumber(fullInnerStart.Y)}",
                $"A {innerRx} {innerRy} 0 1 0 {SvgNumber(fullInnerMid.X)} {SvgNumber(fullInnerMid.Y)}",
                $"A {innerRx} {innerRy} 0 1 0 {SvgNumber(fullInnerStart.X)} {SvgNumber(fullInnerStart.Y)}",
                "Z"
            });
        }

        var outerStart = EllipsePoint(cx, cy + offsetY, outerRx, outerRy, start);
        var outerEnd = EllipsePoint(cx, cy + offsetY, outerRx, outerRy, end);
        var innerStart = EllipsePoint(cx, cy + offsetY, innerRx, innerRy, start);
        var innerEnd = EllipsePoint(cx, cy + offsetY, innerRx, innerRy, end);
        var largeArc = Math.Abs(end - start) > 180d ? 1 : 0;

        return string.Join(" ", new[]
        {
            $"M {SvgNumber(outerStart.X)} {SvgNumber(outerStart.Y)}",
            $"A {outerRx} {outerRy} 0 {largeArc} 1 {SvgNumber(outerEnd.X)} {SvgNumber(outerEnd.Y)}",
            $"L {SvgNumber(innerEnd.X)} {SvgNumber(innerEnd.Y)}",
            $"A {innerRx} {innerRy} 0 {largeArc} 0 {SvgNumber(innerStart.X)} {SvgNumber(innerStart.Y)}",
            "Z"
        });
    }

    List<(HomeDashboardMetric Metric, string Fill, string DarkFill, string TopPath, string BottomPath, double LabelX, double LabelY, double LineStartX, double LineStartY, double LineBendX, double LineBendY, double LineEndX, double LineEndY, string LabelAnchor)> BuildOverviewPieSegments(IReadOnlyList<HomeDashboardMetric> metrics)
    {
        var visibleMetrics = metrics.Where(metric => metric.Count > 0).ToList();
        var result = new List<(HomeDashboardMetric Metric, string Fill, string DarkFill, string TopPath, string BottomPath, double LabelX, double LabelY, double LineStartX, double LineStartY, double LineBendX, double LineBendY, double LineEndX, double LineEndY, string LabelAnchor)>();
        if (visibleMetrics.Count == 0)
        {
            return result;
        }

        var total = Math.Max(1, visibleMetrics.Sum(metric => metric.Count));
        var startAngle = -180d;
        const double totalAngle = 360d;
        const double gapAngle = 1.2d;

        foreach (var metric in visibleMetrics)
        {
            var rawSpan = (double)metric.Count / total * totalAngle;
            var span = visibleMetrics.Count == 1 ? totalAngle : Math.Max(8d, rawSpan - gapAngle);
            var start = startAngle;
            var end = startAngle + span;
            var mid = (start + end) / 2d;
            var lineStart = EllipsePoint(78d, 66d, 64d, 34d, mid);
            var horizontalDirection = Math.Cos(Math.PI * mid / 180d);
            var isRightSide = horizontalDirection >= 0;
            var anchor = Math.Abs(horizontalDirection) < .16d
                ? "middle"
                : isRightSide ? "start" : "end";
            var labelPoint = EllipsePoint(78d, 66d, 91d, 51d, mid);
            var labelX = labelPoint.X;
            var labelY = labelPoint.Y;

            labelX = Math.Clamp(labelX, 7d, 151d);
            labelY = Math.Clamp(labelY, 17d, 118d);

            var lineEndX = anchor == "start"
                ? labelX - 5d
                : anchor == "end" ? labelX + 5d : labelX;
            var lineEndY = labelY + (labelY >= 66d ? -5d : 5d);
            var lineBendX = lineStart.X + (lineEndX - lineStart.X) * .66d;
            var lineBendY = lineEndY;

            result.Add((
                metric,
                StatusHex(metric.Color),
                StatusDarkHex(metric.Color),
                PieSegmentPath(start, end),
                PieSegmentPath(start, end, 15d),
                labelX,
                labelY,
                Math.Clamp(lineStart.X, 16d, 140d),
                Math.Clamp(lineStart.Y, 30d, 102d),
                Math.Clamp(lineBendX, 4d, 156d),
                Math.Clamp(lineBendY, 14d, 114d),
                Math.Clamp(lineEndX, 4d, 156d),
                Math.Clamp(lineEndY, 14d, 114d),
                anchor
            ));
            startAngle += rawSpan;
        }

        return result;
    }

    var issueOverviewSegments = BuildOverviewPieSegments(dashboard.IssueMetrics);
    var supportOverviewSegments = BuildOverviewPieSegments(dashboard.SupportMetrics);
    var projectOverviewSegments = BuildOverviewPieSegments(dashboard.ProjectStatusMetrics);
    var issueOverviewLegend = dashboard.IssueMetrics;
    var supportOverviewLegend = dashboard.SupportMetrics;
    var lineOverdueLegend = dashboard.LineOverdueMetrics;
    var taskOverviewTotalEmployees = dashboard.TaskOverview.Count;
    var taskOverviewTotalTasks = dashboard.TaskOverview.Sum(x => x.TotalCount);
    var taskOverviewDoneTasks = dashboard.TaskOverview.Sum(x => x.DoneCount);
    var taskOverviewWorkingTasks = dashboard.TaskOverview.Sum(x => x.InProgressCount);
    var taskOverviewDelayTasks = dashboard.TaskOverview.Sum(x => x.DelayCount);
    var taskOverviewOpenIssueTasks = dashboard.TaskOverview.Sum(x => x.OpenIssueCount);
    var taskOverviewOpenSupportTasks = dashboard.TaskOverview.Sum(x => x.OpenSupportCount);
    var taskOverviewFieldServiceTasks = dashboard.TaskOverview.Sum(x => x.FieldServiceCount);
    var taskOverviewMaxValue = dashboard.TaskOverview.Count == 0
        ? 0
        : dashboard.TaskOverview.Max(x => new[] { x.DoneCount, x.InProgressCount, x.DelayCount, x.OpenIssueCount, x.OpenSupportCount, x.FieldServiceCount }.Max());
    var taskOverviewAxisMax = Math.Max(25, (int)Math.Ceiling(taskOverviewMaxValue / 5m) * 5);
    var taskOverviewAxisStep = Math.Max(1, taskOverviewAxisMax / 5);
    var taskOverviewAxisTicks = Enumerable.Range(0, 6)
        .Select(i => taskOverviewAxisMax - (i * taskOverviewAxisStep))
        .ToList();
    var taskOverviewFirstChartCount = (int)Math.Ceiling(dashboard.TaskOverview.Count / 2m);
    var taskOverviewGroups = dashboard.TaskOverview
        .Select((member, index) => new { Member = member, Index = index })
        .GroupBy(x => x.Index < taskOverviewFirstChartCount ? 0 : 1)
        .Select(group => group.Select(x => x.Member).ToList())
        .Where(group => group.Count > 0)
        .ToList();
}

<div class="dashboard-view is-loading">
    <section class="dashboard-global-searchbar" aria-label="ค้นหารวมใน Dashboard">
        <div class="dashboard-global-search"
             data-dashboard-search
             data-dashboard-search-url="@Url.Action("DashboardSearch", "Home")">
            <span class="dashboard-global-search-icon" aria-hidden="true">⌕</span>
            <input type="search"
                   id="dashboardGlobalSearch"
                   placeholder="ค้นหาโครงการ งวดงาน Assign Issue Support..."
                   autocomplete="off"
                   aria-label="ค้นหา Projects, ProjectPhases, PhaseAssigns, ProjectIssues, SupportOrders" />
            <button type="button"
                    class="dashboard-global-search-clear"
                    data-dashboard-search-clear
                    aria-label="ล้างคำค้น"
                    hidden>×</button>
            <div class="dashboard-global-search-results"
                 data-dashboard-search-results
                 hidden></div>
        </div>
        @if (visibleOnlineUsers.Count > 0)
        {
            <div class="dashboard-online-users" aria-label="ผู้ใช้งานออนไลน์">
                @foreach (var user in visibleOnlineUsers)
                {
                    <span class="dashboard-online-avatar @user.ColorClass"
                          title="@user.DisplayName">
                        <img src="@user.AvatarPath"
                             alt="@user.DisplayName"
                             onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                    </span>
                }
                @if (hiddenOnlineCount > 0)
                {
                    <span class="dashboard-online-more">+@hiddenOnlineCount</span>
                }
            </div>
        }
        <div class="dashboard-global-tools" aria-label="แจ้งเตือนงาน">
            @if (pendingStatusApprovalCount > 0)
            {
                <a class="dashboard-global-tool approval"
                   asp-controller="StatusApprovals"
                   asp-action="Index"
                   asp-route-status="PENDING"
                   title="รายการรออนุมัติสถานะ"
                   aria-label="มีรายการรออนุมัติ @pendingStatusApprovalCount รายการ">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M9 5h6" />
                        <path d="M9 3h6a1 1 0 0 1 1 1v3H8V4a1 1 0 0 1 1-1Z" />
                        <path d="M8 5H6a2 2 0 0 0-2 2v14h16V7a2 2 0 0 0-2-2h-2" />
                        <path d="m8 13 2 2 5-5" />
                    </svg>
                    <span class="dashboard-global-tool-count">@pendingStatusApprovalCount</span>
                </a>
            }
            <a class="dashboard-global-tool attendance"
               asp-controller="Attendance"
               asp-action="Index"
               title="Attendance"
               aria-label="Attendance">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 2v4" />
                    <path d="M16 2v4" />
                    <path d="M3 10h18" />
                    <path d="M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z" />
                    <path d="m9 16 2 2 4-5" />
                </svg>
            </a>
            <a class="dashboard-global-tool open-work"
               asp-controller="OpenWork"
               asp-action="Index"
               title="งานทั้งหมดที่ยังไม่เสร็จสิ้น"
               aria-label="งานทั้งหมดที่ยังไม่เสร็จสิ้น">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 4h6" />
                    <path d="M10 2h4a2 2 0 0 1 2 2v2H8V4a2 2 0 0 1 2-2Z" />
                    <path d="M8 4H6a2 2 0 0 0-2 2v16h16V6a2 2 0 0 0-2-2h-2" />
                    <path d="M8 11h8" />
                    <path d="M8 16h5" />
                </svg>
                <span class="dashboard-global-tool-count @(openIssueSupportCount == 0 ? "is-empty" : "")">@openIssueSupportCount</span>
            </a>
        </div>
    </section>

    <section class="kpi-grid" aria-label="ตัวชี้วัดหลัก" data-dashboard-dino data-dino-key="ProjectTracking.DashboardDino.@dashboardDinoUserKey">
        <span class="dashboard-dino-feed-zone" data-dino-feed-zone title="ดับเบิลคลิกเพื่อวางขาไก่" aria-hidden="true"></span>
        <span class="dashboard-dino-food" data-dino-food aria-hidden="true">
            <span class="dino-food-bone"></span>
            <span class="dino-food-meat"></span>
        </span>
        <span class="dashboard-dino-runner" aria-hidden="true">
            <span class="dashboard-dino-name">@dashboardDinoName</span>
            <span class="dashboard-dino-stage">
                <span class="dashboard-dino">
                    <span class="dino-tail"></span>
                    <span class="dino-body"></span>
                    <span class="dino-neck"></span>
                    <span class="dino-head"></span>
                    <span class="dino-eye"></span>
                    <span class="dino-arm"></span>
                    <span class="dino-leg dino-leg-a"></span>
                    <span class="dino-leg dino-leg-b"></span>
                </span>
            </span>
        </span>
        <a class="kpi-card kpi-blue"
           asp-controller="Projects"
           asp-action="ViewOnly"
           title="เปิดรายงาน Projects">
            <span class="kpi-menu" aria-hidden="true">•••</span>
            <span class="kpi-icon" aria-hidden="true">
                <img src="~/images/dashboard/kpi-folder.svg" alt="" loading="lazy" />
            </span>
            <div>
                <p>Total Projects</p>
                <strong>@dashboard.TotalProjectCount</strong>
                <small>@dashboard.TotalProjectsNote</small>
            </div>
            <span class="kpi-dots" aria-hidden="true"></span>
            <span class="kpi-wave" aria-hidden="true"></span>
        </a>
        <a class="kpi-card kpi-purple"
           asp-controller="Meetings"
           asp-action="ViewOnly"
           asp-route-fromDate="@todayIso"
           asp-route-toDate="@todayIso"
           title="เปิดรายงาน Meetings วันนี้">
            <span class="kpi-menu" aria-hidden="true">•••</span>
            <span class="kpi-icon" aria-hidden="true">
                <img src="~/images/dashboard/kpi-calendar.svg" alt="" loading="lazy" />
            </span>
            <div>
                <p>Meetings Today</p>
                <strong>@dashboard.MeetingsTodayCount</strong>
                <small>@dashboard.MeetingsTodayNote</small>
            </div>
            <span class="kpi-dots" aria-hidden="true"></span>
            <span class="kpi-wave" aria-hidden="true"></span>
        </a>
        <a class="kpi-card kpi-orange"
           asp-controller="ProjectPhases"
           asp-action="ViewOnly"
           asp-route-phaseStatus="DELAY"
           title="เปิดรายงาน ProjectPhases ล่าช้า">
            <span class="kpi-menu" aria-hidden="true">•••</span>
            <span class="kpi-icon" aria-hidden="true">
                <img src="~/images/dashboard/kpi-alert.svg" alt="" loading="lazy" />
            </span>
            <div>
                <p>ProjectPhases</p>
                <strong>@dashboard.OpenIssueCount</strong>
                <small>@dashboard.OpenIssuesNote</small>
            </div>
            <span class="kpi-dots" aria-hidden="true"></span>
            <span class="kpi-bars" aria-hidden="true"></span>
        </a>
        <a class="kpi-card kpi-pink"
           asp-controller="PhaseAssigns"
           asp-action="ViewOnly"
           asp-route-workStatus="DELAY"
           title="เปิดรายงาน PhaseAssigns ล่าช้า">
            <span class="kpi-menu" aria-hidden="true">•••</span>
            <span class="kpi-icon" aria-hidden="true">
                <img src="~/images/dashboard/kpi-clock.svg" alt="" loading="lazy" />
            </span>
            <div>
                <p>PhaseAssigns</p>
                <strong>@dashboard.OverdueTaskCount</strong>
                <small>@dashboard.OverdueTasksNote</small>
            </div>
            <span class="kpi-dots" aria-hidden="true"></span>
            <span class="kpi-wave" aria-hidden="true"></span>
        </a>
    </section>

    <section class="dashboard-grid" aria-label="ภาพรวม dashboard">
        <article class="glass-panel panel-wide panel-project-overview">
            <div class="panel-head">
                <div class="project-overview-title-row">
                    <span class="project-overview-title-icon" aria-hidden="true">
                        <img src="~/images/dashboard/header-project-overview.svg" alt="" loading="lazy" />
                    </span>
                    <span class="project-overview-title-copy">
                        <h2>ภาพรวมโครงการ (Projects Overview)</h2>
                        <small>สถานะโครงการ</small>
                    </span>
                </div>
                <div class="panel-actions">
                    <a asp-controller="Projects" asp-action="ViewOnly" class="panel-filter compact project-overview-action">
                        <span class="project-overview-action-icon details" aria-hidden="true"></span>
                        <span>รายละเอียด</span>
                    </a>
                    <a asp-controller="ProjectStatus" asp-action="Index" class="panel-filter compact project-overview-action team">
                        <span class="project-overview-action-icon team" aria-hidden="true"></span>
                        <span>ทีมงานพัฒนา</span>
                    </a>
                </div>
            </div>
            <div class="project-overview-combined">
                <div class="project-overview-table">
                    <div class="project-overview-departments" role="group" aria-label="เลือกฝ่าย">
                        <button type="button" class="project-overview-department is-active" data-project-department="all" aria-pressed="true">ทุกฝ่าย</button>
                        @foreach (var department in dashboard.ProjectOverviewDepartments)
                        {
                            var departmentValue = department.DepartmentId?.ToString() ?? "unassigned";
                            <button type="button"
                                    class="project-overview-department"
                                    data-project-department="@departmentValue"
                                    aria-pressed="false">@department.DepartmentName</button>
                        }
                    </div>
                    <label class="project-overview-search">
                        <span class="project-overview-search-label">ค้นหาโครงการ</span>
                        <i aria-hidden="true">⌕</i>
                        <input type="search"
                               id="projectOverviewSearch"
                               placeholder="พิมพ์ชื่อโครงการ..."
                               autocomplete="off" />
                    </label>
                    <div class="project-overview-scroll" data-project-count="@dashboard.ProjectOverviewProjects.Count">
                        @if (dashboard.ProjectOverviewProjects.Count == 0)
                        {
                            <p class="empty-state">ยังไม่มีข้อมูลโครงการ</p>
                        }
                        else
                        {
                            foreach (var project in dashboard.ProjectOverviewProjects)
                            {
                                var projectSearchText = $"{project.ProjectName} {project.DepartmentName} {project.StatusText} {project.StartText} {project.EndText}";
                                var projectDepartmentValue = project.DepartmentId?.ToString() ?? "unassigned";
                                <a class="project-overview-row"
                                   asp-controller="ProjectPhases"
                                   asp-action="Index"
                                   asp-route-projectId="@project.ProjectId"
                                   data-project-search="@projectSearchText"
                                   data-project-department-id="@projectDepartmentValue"
                                   data-project-status="@project.StatusCode"
                                   title="ดูงวดงานของ @project.ProjectName">
                                    <span class="project-overview-icon" aria-hidden="true"></span>
                                    <span class="project-overview-name-wrap">
                                        <span class="project-overview-name" title="@project.ProjectName">@project.ProjectName</span>
                                        <span class="project-overview-department-name">@project.DepartmentName</span>
                                    </span>
                                    <span class="project-overview-status @project.StatusColor">@project.StatusText</span>
                                    <span class="project-overview-date">
                                        <span class="project-overview-mobile-label">เริ่ม</span>
                                        <time>@project.StartText</time>
                                    </span>
                                    <span class="project-overview-date">
                                        <span class="project-overview-mobile-label">สิ้นสุด</span>
                                        <time>@project.EndText</time>
                                    </span>
                                </a>
                            }
                            <p class="empty-state project-overview-empty" hidden>ไม่พบโครงการที่ค้นหา</p>
                        }
                    </div>
                </div>
                <div class="project-status-inline" aria-label="สถานะโครงการ">
                    <div class="donut-layout project-status-donut-layout">
                        <h3 class="project-status-card-title">ภาพรวมสถานะโครงการ</h3>
                        <div class="donut project-status-donut" data-project-status-donut style="--donut:@dashboard.ProjectStatusDonut">
                            <div>
                                <strong data-project-status-total>@dashboard.TotalProjectCount</strong>
                                <span>โครงการ</span>
                            </div>
                        </div>
                        <div class="metric-list">
                            @foreach (var metric in dashboard.ProjectStatusMetrics)
                            {
                                <span data-project-status-metric="@metric.Label"><i class="dot @metric.Color"></i><span class="metric-name">@metric.Label</span><b>@metric.CountPercentText</b></span>
                            }
                        </div>
                        <small class="project-status-updated">ⓘ ข้อมูลอัปเดตล่าสุด @DateTime.Now.ToString("dd MMM yyyy เวลา HH:mm น.", new CultureInfo("th-TH"))</small>
                    </div>
                </div>
            </div>
        </article>

        <article class="glass-panel panel-owner-overview" id="ownerOverview">
            <div class="panel-head dashboard-card-head">
                <div class="dashboard-card-title">
                    <span class="dashboard-card-icon team" aria-hidden="true">●●</span>
                    <span>
                        <h2>ภาพรวมงานตามผู้รับผิดชอบ</h2>
                        <em>สรุป PhaseAssigns, Issues, Support และงานเข้าไซต์ตามผู้รับผิดชอบ</em>
                    </span>
                </div>
                <a asp-controller="ProjectStatus" asp-action="Index" class="panel-link dashboard-action-link chart">ดูทั้งหมด</a>
            </div>


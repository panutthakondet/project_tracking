.project-status-bar3d {
    --bar-height:50%;
    --bar-fill:#2693f4;
    --bar-side:#1269b8;
    position:relative;
    z-index:1;
    width:44px;
    height:118px;
    display:block;
}

.project-status-bar3d i {
    position:absolute;
    display:block;
}

.project-status-bar3d .bar-front {
    left:0;
    bottom:0;
    width:36px;
    height:var(--bar-height);
    border-radius:8px 8px 6px 6px;
    background:linear-gradient(160deg, color-mix(in srgb, var(--bar-fill), #fff 34%), var(--bar-fill) 42%, var(--bar-side));
    box-shadow:inset 8px 0 13px rgba(255,255,255,.14), inset -8px 0 14px rgba(3,10,28,.2);
}

.project-status-bar3d .bar-side {
    left:36px;
    bottom:0;
    width:14px;
    height:var(--bar-height);
    border-radius:0 7px 5px 0;
    background:linear-gradient(180deg, color-mix(in srgb, var(--bar-side), #fff 14%), var(--bar-side));
    transform:skewY(-28deg);
    transform-origin:left bottom;
    filter:brightness(.96);
}

.project-status-bar3d .bar-top {
    left:3px;
    bottom:var(--bar-height);
    width:36px;
    height:14px;
    border-radius:8px 8px 4px 4px;
    background:linear-gradient(135deg, color-mix(in srgb, var(--bar-fill), #fff 58%), var(--bar-fill));
    transform:skewX(-38deg) translate(7px, -7px);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.36);
}

.project-status-bar3d em {
    position:absolute;
    left:50%;
    bottom:calc(var(--bar-height) + 14px);
    transform:translateX(-50%);
    color:#fff;
    font-size:12px;
    font-style:normal;
    font-weight:900;
    line-height:1;
    text-shadow:0 2px 6px rgba(3,10,28,.7);

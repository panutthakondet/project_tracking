    background:
        radial-gradient(circle at 92% 18%, var(--pt-chart-panel-glow, rgba(96,165,250,.14)), transparent 42%),
        linear-gradient(180deg, var(--pt-chart-panel-row-hover-bg, rgba(15,44,88,.72)), var(--pt-chart-panel-row-bg, rgba(7,26,58,.82)));
    border-bottom:1px solid var(--pt-border, rgba(96,165,250,.16));
}

.panel-time .time-metric-grid .time-metric-icon {
    grid-area:icon;
    align-self:center;
}

.panel-time .time-metric-grid span i {

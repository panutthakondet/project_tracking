.progress-track .orange { background:linear-gradient(90deg,#fb9a13,#ff6333); }
.progress-track .purple { background:linear-gradient(90deg,#8b4df4,#d352ff); }
.progress-track .pink { background:linear-gradient(90deg,#ff2d62,#ff6a94); }
.progress-track .cyan { background:linear-gradient(90deg,#0ad0c8,#12d8ff); }

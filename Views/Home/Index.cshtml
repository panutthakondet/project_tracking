.dashboard-open-work-mark.pink { background:linear-gradient(135deg,#fb3f7a,#e11d48); }
.dashboard-open-work-mark.orange { background:linear-gradient(135deg,#f59e0b,#f97316); }
.dashboard-open-work-mark.cyan { background:linear-gradient(135deg,#22d3ee,#0f9f94); }

.dashboard-open-work-body {
    display:grid;
    gap:3px;

<script>
    (() => {
        const searchInput = document.getElementById('projectOverviewSearch');
        if (!searchInput) return;

        const rows = Array.from(document.querySelectorAll('.project-overview-row[data-project-search]'));
        const emptyMessage = document.querySelector('.project-overview-empty');

        searchInput.addEventListener('input', () => {
            const keyword = searchInput.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(row => {
                const text = (row.dataset.projectSearch || '').toLowerCase();
                const isVisible = !keyword || text.includes(keyword);
                row.hidden = !isVisible;
                if (isVisible) visibleCount++;
            });

            if (emptyMessage) {
                emptyMessage.hidden = visibleCount > 0;
            }
        });
    })();
</script>

.panel-task { order:3; grid-column:span 24; min-height:230px; }
.panel-line-overdue { order:4; grid-column:span 24; min-height:310px; }
.panel-issues { order:5; grid-column:span 24; min-height:520px; }
.panel-time { order:6; grid-column:span 24; min-height:248px; }
.panel-team { order:7; grid-column:span 24; min-height:285px; }

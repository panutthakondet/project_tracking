    pointer-events:none;
}

.overview-pie3d-rim {
    fill:none;
    pointer-events:none;
}

.overview-pie3d-rim.outer {
    stroke:rgba(255,255,255,.22);
    stroke-width:.55;
    filter:drop-shadow(0 0 4px rgba(125,211,252,.12));
}

.overview-pie3d-rim.outer-soft {
    stroke:rgba(125,211,252,.2);
    stroke-width:2.2;
    filter:blur(.28px) drop-shadow(0 0 7px rgba(34,211,238,.16));
}

.overview-pie3d-rim.inner {
    stroke-width:1.65;
    filter:
        drop-shadow(0 -1px 3px rgba(255,255,255,.1))
        drop-shadow(0 5px 12px rgba(3,10,28,.68));
}

.overview-pie3d-leaders line,
.overview-pie3d-leaders polyline {
    fill:none;
    stroke:rgba(239,246,255,.94);
    stroke-width:1.55;
    stroke-linejoin:round;
    stroke-linecap:round;
    vector-effect:non-scaling-stroke;
    filter:drop-shadow(0 1px 3px rgba(3,10,28,.48));
}

.overview-pie3d-leaders {
    display:none;
}

.overview-pie3d-leaders circle {
    fill:#eff6ff;
    stroke:rgba(15,23,42,.34);
    stroke-width:.45;
    filter:drop-shadow(0 1px 2px rgba(3,10,28,.36));
}

.overview-pie3d-center {
    filter:
        drop-shadow(0 -2px 5px rgba(255,255,255,.1))
        drop-shadow(0 9px 15px rgba(3,10,28,.5));
}

.overview-pie3d-center-shadow {
    fill:rgba(2,8,23,.42);
    filter:blur(.65px);
    pointer-events:none;
}

.overview-pie3d-center-highlight {
    fill:rgba(54,163,255,.08);
    filter:blur(.7px);
    pointer-events:none;
}

.overview-pie3d-center-core {
    fill:rgba(6,17,42,.5);
    filter:blur(.18px);
    pointer-events:none;
}

.overview-pie3d-total,
.overview-pie3d-caption,
.overview-pie3d-labels text {
    font-family:'Prompt', sans-serif;
    text-anchor:middle;
    fill:#fff;
    font-weight:900;
    paint-order:stroke;
    stroke:rgba(15,23,42,.14);
    stroke-width:1px;
}

.overview-pie3d-total {
    font-size:20px;
}

.overview-pie3d-caption {
    font-size:9px;
    fill:#dbeafe;
}

.overview-pie3d-labels text {
    font-size:9.2px;
    font-style:italic;
    font-weight:900;
    stroke:rgba(15,23,42,.62);
    stroke-width:1.05px;
    filter:drop-shadow(0 2px 4px rgba(3,10,28,.4));
}

.time-pie3d {

                <a asp-controller="Home" asp-action="Index" asp-route-department="all" asp-fragment="ownerOverview"
                   class="dashboard-department-option @(dashboard.SelectedDashboardDepartment == "all" ? "is-active" : "")">ทุกฝ่าย</a>
                @foreach (var department in dashboard.ProjectOverviewDepartments)
                {
                    var departmentKey = department.DepartmentId?.ToString() ?? "unassigned";
                    <a asp-controller="Home" asp-action="Index" asp-route-department="@departmentKey" asp-fragment="ownerOverview"
                       class="dashboard-department-option @(dashboard.SelectedDashboardDepartment == departmentKey ? "is-active" : "")">@department.DepartmentName</a>
                }
            </nav>

            <div class="owner-overview-legend">
                <span><i class="done"></i>เสร็จแล้ว</span>
                <span><i class="working"></i>กำลังทำ</span>
                <span><i class="stuck"></i>ล่าช้า</span>
                <span><i class="issue-open"></i>Issues OPEN</span>
                <span><i class="support-open"></i>Support OPEN</span>
                <span><i class="field-service"></i>Field Service</span>
            </div>

            @if (dashboard.TaskOverview.Count == 0)
            {
                <p class="empty-state">ยังไม่มีข้อมูลงานสำหรับแสดงผล</p>
            }
            else
            {
                <div class="owner-overview-plots">
                    @foreach (var chartMembers in taskOverviewGroups)
                    {
                        <div class="owner-overview-chart-wrap">
                            <div class="owner-overview-y-axis" aria-hidden="true">
                                <span class="owner-overview-y-title">จำนวนงาน</span>
                                @foreach (var tick in taskOverviewAxisTicks)
                                {
                                    var tickPosition = Math.Round((taskOverviewAxisMax - tick) * 100m / taskOverviewAxisMax, 3);
                                    <span style="--tick:@tickPosition.ToString("0.###", CultureInfo.InvariantCulture);">@tick</span>
                                }
                            </div>
                            <div class="owner-overview-scroll">
                                <div class="owner-overview-chart" style="--owner-count:@chartMembers.Count; --owner-min-width:@(Math.Max(1, chartMembers.Count) * 132)px;">
                                    @foreach (var member in chartMembers)
                                    {
                                        var doneHeight = Math.Round(Math.Min(member.DoneCount, taskOverviewAxisMax) * 100m / taskOverviewAxisMax, 3);
                                        var workingHeight = Math.Round(Math.Min(member.InProgressCount, taskOverviewAxisMax) * 100m / taskOverviewAxisMax, 3);
                                        var delayHeight = Math.Round(Math.Min(member.DelayCount, taskOverviewAxisMax) * 100m / taskOverviewAxisMax, 3);
                                        var openIssueHeight = Math.Round(Math.Min(member.OpenIssueCount, taskOverviewAxisMax) * 100m / taskOverviewAxisMax, 3);
                                        var openSupportHeight = Math.Round(Math.Min(member.OpenSupportCount, taskOverviewAxisMax) * 100m / taskOverviewAxisMax, 3);
                                        var fieldServiceHeight = Math.Round(Math.Min(member.FieldServiceCount, taskOverviewAxisMax) * 100m / taskOverviewAxisMax, 3);

                                        <div class="owner-overview-item" title="@member.Name">
                                            <div class="owner-overview-bars" aria-label="@member.Name เสร็จแล้ว @member.DoneCount งาน กำลังทำ @member.InProgressCount งาน ล่าช้า @member.DelayCount งาน Issues OPEN @member.OpenIssueCount งาน Support OPEN @member.OpenSupportCount งาน Field Service @member.FieldServiceCount งาน">
                                                <span class="owner-bar done @(member.DoneCount == 0 ? "is-zero" : "")"
                                                      title="เสร็จแล้ว @member.DoneCount งาน"
                                                      style="--bar-height:@doneHeight.ToString("0.###", CultureInfo.InvariantCulture)%;">
                                                    <em>@member.DoneCount</em><i></i>
                                                </span>
                                                <span class="owner-bar working @(member.InProgressCount == 0 ? "is-zero" : "")"
                                                      title="กำลังทำ @member.InProgressCount งาน"
                                                      style="--bar-height:@workingHeight.ToString("0.###", CultureInfo.InvariantCulture)%;">
                                                    <em>@member.InProgressCount</em><i></i>
                                                </span>
                                                <span class="owner-bar stuck @(member.DelayCount == 0 ? "is-zero" : "")"
                                                      title="ล่าช้า @member.DelayCount งาน"
                                                      style="--bar-height:@delayHeight.ToString("0.###", CultureInfo.InvariantCulture)%;">
                                                    <em>@member.DelayCount</em><i></i>
                                                </span>
                                                <span class="owner-bar issue-open @(member.OpenIssueCount == 0 ? "is-zero" : "")"
                                                      title="Issues OPEN @member.OpenIssueCount งาน"
                                                      style="--bar-height:@openIssueHeight.ToString("0.###", CultureInfo.InvariantCulture)%;">
                                                    <em>@member.OpenIssueCount</em><i></i>
                                                </span>
                                                <span class="owner-bar support-open @(member.OpenSupportCount == 0 ? "is-zero" : "")"
                                                      title="Support OPEN @member.OpenSupportCount งาน"
                                                      style="--bar-height:@openSupportHeight.ToString("0.###", CultureInfo.InvariantCulture)%;">
                                                    <em>@member.OpenSupportCount</em><i></i>
                                                </span>
                                                <span class="owner-bar field-service @(member.FieldServiceCount == 0 ? "is-zero" : "")"
                                                      title="Field Service @member.FieldServiceCount งาน"
                                                      style="--bar-height:@fieldServiceHeight.ToString("0.###", CultureInfo.InvariantCulture)%;">
                                                    <em>@member.FieldServiceCount</em><i></i>
                                                </span>
                                            </div>
                                            <div class="owner-overview-member">
                                                <small>รวม @member.TotalCount งาน</small>
                                                <img src="@member.AvatarPath" alt="@member.Name" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                                <b>@member.Name</b>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="owner-overview-footer">
                    <span>รวม <b>@taskOverviewTotalEmployees</b> คน</span>
                    <span>งานทั้งหมด <b>@taskOverviewTotalTasks</b> งาน</span>
                    <span class="done"><i></i>เสร็จแล้ว <b>@taskOverviewDoneTasks</b></span>
                    <span class="working"><i></i>กำลังทำ <b>@taskOverviewWorkingTasks</b></span>
                    <span class="stuck"><i></i>ล่าช้า <b>@taskOverviewDelayTasks</b></span>
                    <span class="issue-open"><i></i>Issues OPEN <b>@taskOverviewOpenIssueTasks</b></span>
                    <span class="support-open"><i></i>Support OPEN <b>@taskOverviewOpenSupportTasks</b></span>
                    <span class="field-service"><i></i>Field Service <b>@taskOverviewFieldServiceTasks</b></span>
                </div>
            }
        </article>


                </section>
                <section class="field-service-dashboard-list">
                <div class="field-service-dashboard-subhead"><b>กำหนดการถัดไป</b><a asp-controller="FieldService" asp-action="Index">ดูทั้งหมด</a></div>
                @if (dashboard.UpcomingFieldServiceVisits.Count == 0)
                {
                    <p class="empty-state">ยังไม่มีงานเข้าไซต์ที่กำลังจะมาถึง</p>
                }
                else
                {
                    @foreach (var visit in dashboard.UpcomingFieldServiceVisits)
                    {
                        <a class="field-service-dashboard-row" asp-controller="FieldService" asp-action="Show" asp-route-id="@visit.VisitId">
                            <span class="field-service-dashboard-date">@visit.DateText</span>
                            <span class="field-service-dashboard-main"><b>@visit.CoopName</b><small>@visit.Title · ผู้รับผิดชอบ: @visit.AssigneeText</small></span>
                            <span class="field-service-dashboard-status @visit.StatusColor">@visit.StatusText</span>
                        </a>
                    }
                }
                </section>
            </div>
        </article>

        <article class="glass-panel panel-task" id="yearlyTaskProgress">
            <div class="task-progress-head">
                <div class="task-progress-title">
                    <span class="task-progress-icon" aria-hidden="true">
                        <img src="~/images/dashboard/header-task-progress.svg" alt="" loading="lazy" />
                    </span>
                    <span>
                        <h2>Task Progress (รายปี)</h2>
                        <small>ภาพรวมความคืบหน้าของงานรายเดือน</small>
                    </span>
                </div>
                <div class="task-progress-summary" aria-label="สรุปสถานะงานรายปี">
                    <div class="task-summary-card completed">
                        <b>Completed</b>
                        <strong>@yearlyCompletedTotal</strong>
                    </div>
                    <div class="task-summary-card progress">
                        <b>In Progress</b>
                        <strong>@yearlyInProgressTotal</strong>
                    </div>
                </div>
            </div>
            <nav class="dashboard-department-filter" aria-label="เลือกฝ่ายสำหรับความคืบหน้างานรายปี">
                <a asp-controller="Home" asp-action="Index" asp-route-department="all" asp-fragment="yearlyTaskProgress"
                   class="dashboard-department-option @(dashboard.SelectedDashboardDepartment == "all" ? "is-active" : "")">ทุกฝ่าย</a>
                @foreach (var department in dashboard.ProjectOverviewDepartments)
                {
                    var departmentKey = department.DepartmentId?.ToString() ?? "unassigned";
                    <a asp-controller="Home" asp-action="Index" asp-route-department="@departmentKey" asp-fragment="yearlyTaskProgress"
                       class="dashboard-department-option @(dashboard.SelectedDashboardDepartment == departmentKey ? "is-active" : "")">@department.DepartmentName</a>
                }
            </nav>
            <div class="yearly-chart">
                <span class="yearly-y-title">จำนวนงาน</span>
                <div class="yearly-y-axis" aria-hidden="true">
                    @foreach (var tick in yearlyTaskAxisTicks)
                    {
                        var tickTop = (30 - tick) * 100m / 30m;
                        <span style="top:@tickTop.ToString("0.###", CultureInfo.InvariantCulture)%">@tick</span>
                    }
                </div>
                <div class="yearly-plot">
                    <div class="bar-chart">
                        @foreach (var task in dashboard.YearlyTasks)
                        {
                            <div class="bar-group">
                                <span class="@(task.CompletedHeight == 0 ? "is-zero" : "")"
                                      style="height:@task.CompletedHeight%"
                                      title="Completed: @task.Completed">
                                    @if (task.Completed > 0)
                                    {
                                        <i>@task.Completed</i>
                                    }
                                </span>
                                <span class="@(task.InProgressHeight == 0 ? "is-zero" : "")"
                                      style="height:@task.InProgressHeight%"
                                      title="In Progress: @task.InProgress">
                                    @if (task.InProgress > 0)
                                    {
                                        <i>@task.InProgress</i>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                    <div class="yearly-x-axis" aria-hidden="true">
                        @foreach (var task in dashboard.YearlyTasks)
                        {
                            <span>@task.PeriodLabel</span>
                        }
                    </div>
                </div>
                <span class="yearly-x-title">เดือน</span>
                <div class="yearly-legend" aria-hidden="true">
                    <span><i class="dot green"></i>Completed</span>
                    <span><i class="dot blue"></i>In Progress</span>
                </div>
            </div>
        </article>

        <article class="glass-panel panel-time" id="attendanceOverview">
            <div class="panel-head dashboard-card-head">
                <div class="dashboard-card-title">
                    <span class="dashboard-card-icon time" aria-hidden="true">
                        <img src="~/images/dashboard/time-icon-calendar.svg" alt="" loading="lazy" />
                    </span>
                    <span>
                        <h2>ภาพรวมการเข้างาน</h2>
                        <em>ข้อมูลประกอบการประเมินความสม่ำเสมอและวินัยการเข้างาน</em>
                    </span>
                </div>
                <a asp-controller="Attendance" asp-action="Map" class="panel-link dashboard-action-link details">ดูรายละเอียด</a>
            </div>
            <nav class="dashboard-department-filter" aria-label="เลือกฝ่ายสำหรับภาพรวมการเข้างาน">
                <a asp-controller="Home" asp-action="Index" asp-route-department="all" asp-fragment="attendanceOverview"
                   class="dashboard-department-option @(dashboard.SelectedDashboardDepartment == "all" ? "is-active" : "")">ทุกฝ่าย</a>
                @foreach (var department in dashboard.ProjectOverviewDepartments)
                {
                    var departmentKey = department.DepartmentId?.ToString() ?? "unassigned";
                    <a asp-controller="Home" asp-action="Index" asp-route-department="@departmentKey" asp-fragment="attendanceOverview"
                       class="dashboard-department-option @(dashboard.SelectedDashboardDepartment == departmentKey ? "is-active" : "")">@department.DepartmentName</a>
                }
                <span class="dashboard-department-scope">กำลังแสดง: @dashboard.SelectedDashboardDepartmentName</span>
            </nav>
            <div class="time-layout">
                <div class="time-hero">
                    <div class="donut time-donut" style="--donut:@dashboard.AttendanceDonut" aria-label="กราฟอัตราเข้างานเดือนนี้">
                        <div>
                            <strong>@dashboard.MonthAttendanceRate.ToString("0.#")</strong>
                            <span>เปอร์เซ็นต์</span>
                            <em>เดือนนี้</em>
                        </div>
                    </div>
                    <div class="time-goal">
                        <span>เป้าหมายองค์กร</span>
                        <b>≥ @dashboard.AttendanceTargetPercent.ToString("0.#")%</b>
                        <i aria-hidden="true"><em style="width:@attendanceProgressWidth%"></em></i>
                        <small>ลงเวลา @dashboard.MonthRecordedEmployeeDays / @dashboard.MonthExpectedEmployeeDays คน-วัน</small>
                        <span class="time-goal-trend">
                            <span class="time-goal-trend-icon" aria-hidden="true"><img src="~/images/dashboard/time-icon-trend.svg" alt="" loading="lazy" /></span>
                            <small class="@dashboard.AttendanceTrendClass">@dashboard.AttendanceTrendText</small>
                        </span>
                    </div>
                </div>
                <div class="metric-card time-metric-grid">
                    <span><img class="time-metric-icon" src="~/images/dashboard/time-icon-user.svg" alt="" loading="lazy" /><i>เข้างานวันนี้</i> <b>@dashboard.TodayCheckinCount คน</b></span>
                    <span><img class="time-metric-icon" src="~/images/dashboard/time-icon-check.svg" alt="" loading="lazy" /><i>ตรงเวลาวันนี้</i> <b>@dashboard.TodayOnTimeCount คน</b></span>
                    <span><img class="time-metric-icon" src="~/images/dashboard/time-icon-warning.svg" alt="" loading="lazy" /><i>มาสายวันนี้</i> <b>@dashboard.TodayLateCount คน</b></span>
                    <span><img class="time-metric-icon" src="~/images/dashboard/time-icon-pending.svg" alt="" loading="lazy" /><i>ยังไม่ลงเวลา</i> <b>@dashboard.TodayMissingCheckinCount คน</b></span>
                </div>
                <div class="time-trend-card">
                    <div class="time-subhead">
                        <b>7 วันล่าสุด</b>
                        <small>อัตราเข้างานรายวัน</small>
                    </div>
                    <div class="time-trend-bars" aria-label="อัตราเข้างาน 7 วันล่าสุด">
                        @foreach (var day in dashboard.TimeTrendDays)
                        {
                            var trendTitle = day.ExpectedCount > 0
                                ? $"{day.Label} · เข้างาน {day.PresentCount}/{day.ExpectedCount} คน ({day.AttendanceRate:0.#}%)"
                                : day.IsWorkday ? $"{day.Label} · ยังไม่ถึงเวลาประเมิน" : $"{day.Label} · วันหยุด";
                            <span class="time-trend-bar @day.Tone" title="@trendTitle">
                                <i style="height:@day.Percent%"></i>
                                <b>@(day.ExpectedCount > 0 ? $"{day.AttendanceRate:0.#}%" : "-")</b>
                                <small>@day.Label</small>
                            </span>
                        }
                    </div>
                </div>
                <div class="time-heatmap-card">
                    <div class="time-subhead">
                        <b>เดือนนี้</b>
                        <small>อัตราเข้างานรายวัน</small>
                    </div>
                    <div class="time-heatmap" aria-label="ปฏิทินอัตราเข้างานเดือนนี้">
                        @foreach (var day in dashboard.TimeHeatmapDays)
                        {
                            <span class="time-heat-cell @day.Tone @(day.IsToday ? "today" : "")" title="@day.Label">
                                @day.Day
                            </span>
                        }
                    </div>
                </div>
            </div>
            <div class="time-detail-grid">
                <span><img class="time-detail-icon" src="~/images/dashboard/time-icon-users.svg" alt="" loading="lazy" /><span><small>พนักงาน Active</small><b>@dashboard.ActiveEmployeeCount คน</b></span></span>
                <span><img class="time-detail-icon" src="~/images/dashboard/time-icon-check.svg" alt="" loading="lazy" /><span><small>ตรงเวลาเดือนนี้</small><b>@dashboard.MonthPunctualityRate.ToString("0.#")%</b></span></span>
                <span><img class="time-detail-icon" src="~/images/dashboard/time-icon-warning.svg" alt="" loading="lazy" /><span><small>มาสายเดือนนี้</small><b>@dashboard.MonthLateCount ครั้ง</b></span></span>
                <span><img class="time-detail-icon" src="~/images/dashboard/time-icon-pending.svg" alt="" loading="lazy" /><span><small>ลงเวลาไม่ครบเดือนนี้</small><b>@dashboard.MonthIncompleteCheckoutCount ครั้ง</b></span></span>
                <span><img class="time-detail-icon" src="~/images/dashboard/time-icon-calendar.svg" alt="" loading="lazy" /><span><small>อัตราเข้างานปีนี้</small><b>@dashboard.YearAttendanceRate.ToString("0.#")%</b></span></span>
                <span><img class="time-detail-icon" src="~/images/dashboard/time-icon-clock.svg" alt="" loading="lazy" /><span><small>@dashboard.AttendancePolicyText</small><b>สาย @dashboard.YearLateCount ครั้ง/ปี</b></span></span>
            </div>
        </article>

        <article class="glass-panel side-panel panel-team" id="teamWorkloadOverview">
            <div class="panel-head dashboard-card-head">
                <div class="dashboard-card-title">
                    <span class="dashboard-card-icon team" aria-hidden="true">●●</span>
                    <span>
                        <h2>จำนวนงานของพนักงานทั้งหมด</h2>
                        <em>เรียงตามจำนวนงานค้างจากมากไปน้อย</em>
                    </span>
                </div>
                <a asp-controller="PhaseStatusReport" asp-action="Index" class="panel-link dashboard-action-link chart">ดูทั้งหมด</a>
            </div>
            <nav class="dashboard-department-filter" aria-label="เลือกฝ่ายสำหรับจำนวนงานของพนักงาน">
                <a asp-controller="Home" asp-action="Index" asp-route-department="all" asp-fragment="teamWorkloadOverview"
                   class="dashboard-department-option @(dashboard.SelectedDashboardDepartment == "all" ? "is-active" : "")">ทุกฝ่าย</a>
                @foreach (var department in dashboard.ProjectOverviewDepartments)
                {
                    var departmentKey = department.DepartmentId?.ToString() ?? "unassigned";
                    <a asp-controller="Home" asp-action="Index" asp-route-department="@departmentKey" asp-fragment="teamWorkloadOverview"
                       class="dashboard-department-option @(dashboard.SelectedDashboardDepartment == departmentKey ? "is-active" : "")">@department.DepartmentName</a>
                }
            </nav>
            <div class="workload-list">
                @if (dashboard.TeamWorkload.Count == 0)
                {
                    <p class="empty-state">ยังไม่มีงานที่กำลังดำเนินการ</p>
                }
                else
                {
                    for (var memberIndex = 0; memberIndex < dashboard.TeamWorkload.Count; memberIndex++)
                    {
                        var member = dashboard.TeamWorkload[memberIndex];
                        <a class="workload-row"
                           asp-controller="PhaseStatusReport"
                           asp-action="Index"
                           asp-route-empName="@member.Name"
                           asp-route-phaseStatus="IN_PROGRESS"
                           title="ดูรายงานสถานะงานของ @member.Name">
                            <em class="workload-rank">@(memberIndex + 1)</em>
                            <img src="@member.AvatarPath" alt="" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                            <span class="workload-name">
                                <strong>@member.Name</strong>
                                <small>งานค้าง @member.ActiveTaskCount งาน</small>
                            </span>
                            <div class="progress-track"><i class="@member.Color" style="width:@member.Value%"></i></div>
                            <b>@member.Value%</b>
                        </a>
                    }
                }
            </div>
            <div class="dashboard-section-foot"><span>ⓘ</span> อัปเดตข้อมูลล่าสุด @DateTime.Now.ToString("dd MMM yyyy เวลา HH:mm น.", new CultureInfo("th-TH"))</div>
        </article>

        <article class="glass-panel side-panel panel-activity">
            <div class="panel-head dashboard-card-head">
                <div class="dashboard-card-title">
                    <span class="dashboard-card-icon activity" aria-hidden="true">◷</span>
                    <span>
                        <h2>กิจกรรมล่าสุด <small>(Recent Activity)</small></h2>
                        <em>อัปเดตล่าสุด @DateTime.Now.ToString("dd MMM yyyy เวลา HH:mm น.", new CultureInfo("th-TH"))</em>
                    </span>
                </div>
                <a asp-controller="Home" asp-action="Activities" class="panel-link dashboard-action-link list">ดูทั้งหมด</a>
            </div>
            <div class="activity-list">
                @if (dashboard.RecentActivities.Count == 0)
                {
                    <p class="empty-state">ยังไม่มีกิจกรรมล่าสุด</p>
                }
                else
                {
                    foreach (var activity in dashboard.RecentActivities)
                    {
                        <a class="activity-row @activity.Color" href="@(string.IsNullOrWhiteSpace(activity.Url) ? Url.Action("Activities", "Home") : activity.Url)">
                            <img class="activity-avatar"
                                 src="@activity.AvatarPath"
                                 alt=""
                                 onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                            <span>
                                <b>@activity.Actor</b>
                                <small><i class="activity-mini-icon"></i>@activity.Detail</small>
                                @if (!string.IsNullOrWhiteSpace(activity.OwnerText))
                                {
                                    <em><i class="activity-owner-icon"></i>@activity.OwnerText</em>
                                }
                            </span>
                            <time><i aria-hidden="true">◷</i><strong>@activity.TimeText.Split(' ').FirstOrDefault()</strong><small>@string.Join(" ", activity.TimeText.Split(' ').Skip(1))</small></time>
                        </a>
                    }
                }
            </div>
            <a asp-controller="Home" asp-action="Index" class="dashboard-refresh-link">↻ โหลดข้อมูลใหม่</a>
        </article>
    </section>

    <footer class="dashboard-footer">
        © 2026 <strong>#C</strong> By <strong>SO-AT SOLUTION</strong>
    </footer>
</div>

@section Styles {
<style>
.dashboard-view {
    --pt-readable-thai-font:"Prompt", "Noto Sans Thai", "Leelawadee UI", Tahoma, "Segoe UI", Arial, sans-serif;
    --panel:#111f3c;
    min-height:100vh;
    padding:8px 10px 26px;
    background:
        radial-gradient(circle at 18% 16%, rgba(34,211,238,.18), transparent 26%),
        radial-gradient(circle at 78% 24%, rgba(244,63,94,.12), transparent 24%),
        linear-gradient(180deg, #edf4fb 0%, #e7eff8 100%);
    font-family:var(--pt-readable-thai-font);
    opacity:1;
    transform:none;
    will-change:auto;
}

.dashboard-view,
.dashboard-view * {
    box-sizing:border-box;
}

.dashboard-view.is-loading,
.dashboard-view.is-loading * {
    transition:none !important;
    animation:none !important;
}

.dashboard-view img {
    display:block;
    max-width:100%;
    height:auto;
}

.floating-tools-wrapper {
    display:none !important;
}

.dashboard-global-searchbar {
    position:relative;
    z-index:20;
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:10px;
    margin:2px 0 18px;
}

.dashboard-dino-feed-zone {
    position:absolute;
    top:-48px;
    left:0;
    right:0;
    z-index:42;
    height:58px;
    display:none;
    cursor:crosshair;
}

.dashboard-dino-food {
    position:absolute;
    z-index:43;
    left:0;
    top:0;
    width:38px;
    height:26px;
    display:none;
    pointer-events:none;
    transform:translate(-50%, -60%);
    filter:drop-shadow(0 5px 6px rgba(4, 15, 35, .22));
}

.dashboard-dino-food.is-ready {
    display:block;
    animation:dashboardDinoFoodDrop .28s ease both;
}

.dashboard-dino-food.is-eaten {
    animation:dashboardDinoFoodEat .52s ease forwards;
}

.dino-food-bone {
    position:absolute;
    left:4px;
    top:13px;
    width:23px;
    height:6px;
    border:1px solid rgba(15, 35, 64, .18);
    border-radius:999px;
    background:#fff;
    transform:rotate(-18deg);
}

.dino-food-bone::before,
.dino-food-bone::after {
    content:"";
    position:absolute;
    left:-5px;
    width:8px;
    height:8px;
    border:1px solid rgba(15, 35, 64, .14);
    border-radius:50%;
    background:#fff;
}

.dino-food-bone::before {
    top:-5px;
}

.dino-food-bone::after {
    bottom:-5px;
}

.dino-food-meat {
    position:absolute;
    right:1px;
    top:3px;
    width:19px;
    height:17px;
    border:1px solid color-mix(in srgb, var(--pt-dino-food-color, #45D6C6) 72%, #10233f);
    border-radius:68% 48% 62% 50%;
    background:
        radial-gradient(circle at 35% 28%, rgba(255,255,255,.46), transparent 22%),
        linear-gradient(135deg, var(--pt-dino-food-color, #45D6C6), color-mix(in srgb, var(--pt-dino-food-color, #45D6C6) 62%, #9b2d1c));
    transform:rotate(-18deg);
}

.dashboard-dino-runner {
    --dino-width: var(--dashboard-dino-width);
    --dino-height: var(--dashboard-dino-height);
    position:absolute;
    top:var(--dashboard-dino-route-start-top, var(--dashboard-dino-card-1-top));
    left:var(--dashboard-dino-route-start-left, var(--dashboard-dino-card-1-start));
    z-index:44;
    width:var(--dino-width);
    height:var(--dino-height);
    display:none;
    align-items:flex-end;
    justify-content:center;
    color:var(--pt-dino-color, rgba(255,255,255,.96));
    pointer-events:none;
    animation:dashboardDinoCardHop 56s linear infinite;
    will-change:left, top, transform;
}

.dashboard-dino-runner.is-seeking-food {
    animation:none !important;
    transition:
        left var(--dino-seek-duration, 1800ms) linear,
        top var(--dino-seek-duration, 1800ms) ease-in-out;
}

.dashboard-dino-runner.is-seeking-food .dashboard-dino-stage {
    animation:none !important;
}

.dashboard-dino-runner.is-eating .dino-head,
.dashboard-dino-runner.is-eating .dino-neck {
    animation:dashboardDinoNibble .28s steps(2, end) infinite;
}

.dashboard-dino-name {
    position:absolute;
    left:50%;
    bottom:30px;
    max-width:96px;
    padding:2px 7px;
    border:1px solid rgba(15, 35, 64, .16);
    border-radius:999px;
    color:#10233f;
    background:#fff;
    font-size:10px;
    font-weight:900;
    line-height:1.2;
    text-align:center;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
    transform:translateX(-50%);
}

.dashboard-dino-stage {
    position:relative;
    display:block;
    width:46px;
    height:34px;
    transform-origin:center bottom;
    animation:dashboardDinoFace 56s linear infinite;
}

.dashboard-dino {
    position:relative;
    width:46px;
    height:34px;
    color:inherit;
    image-rendering:pixelated;
    transform:scale(var(--dashboard-dino-scale));
    transform-origin:center bottom;
    transition:transform 1.2s ease;
}

.dashboard-dino > span {
    position:absolute;
    display:block;
    background:currentColor;
    box-shadow:none;
}

.dino-tail {
    left:1px;
    top:18px;
    width:18px;
    height:8px;
    clip-path:polygon(0 42%, 100% 0, 100% 72%, 0 72%);
    transform-origin:100% 50%;
    animation:dashboardDinoTailWag .72s ease-in-out infinite;
}

.dino-body {
    left:16px;
    top:15px;
    width:22px;
    height:13px;
}

.dino-neck {
    left:31px;
    top:11px;
    width:9px;
    height:12px;
}

.dino-head {
    left:35px;
    top:5px;
    width:15px;
    height:13px;
}

.dino-head::after {
    content:"";
    position:absolute;
    right:-7px;
    top:4px;
    width:7px;
    height:7px;
    background:currentColor;
}

.dashboard-dino .dino-eye {
    left:42px;
    top:7px;
    width:7px;
    height:6px;
    border:1px solid color-mix(in srgb, currentColor 24%, transparent);
    background:#fff;
}

.dashboard-dino .dino-eye::after {
    content:"";
    position:absolute;
    right:2px;
    top:2px;
    width:3px;
    height:3px;
    background:#07162d;

@@keyframes dashboardDinoCardHop {
    0% {
        left:var(--dashboard-dino-route-start-left, var(--dashboard-dino-card-1-start));
        top:var(--dashboard-dino-route-start-top, var(--dashboard-dino-card-1-top));
        transform:translateY(0);
    }
    8% {
        left:var(--dashboard-dino-route-step-1-end-left, var(--dashboard-dino-card-1-end));
        top:var(--dashboard-dino-route-step-1-end-top, var(--dashboard-dino-card-1-top));
        transform:translateY(0);
    }
    10% {
        left:var(--dashboard-dino-route-step-2-start-left, var(--dashboard-dino-card-2-start));
        top:var(--dashboard-dino-route-step-2-start-top, var(--dashboard-dino-card-2-top));
        transform:translateY(var(--dashboard-dino-route-step-2-hop, -24px));
    }
    12% {
        left:var(--dashboard-dino-route-step-2-start-left, var(--dashboard-dino-card-2-start));
        top:var(--dashboard-dino-route-step-2-start-top, var(--dashboard-dino-card-2-top));
        transform:translateY(0);
    }
    20% {
        left:var(--dashboard-dino-route-step-2-end-left, var(--dashboard-dino-card-2-end));
        top:var(--dashboard-dino-route-step-2-end-top, var(--dashboard-dino-card-2-top));
        transform:translateY(0);
    }
    22% {
        left:var(--dashboard-dino-route-step-3-start-left, var(--dashboard-dino-card-3-start));
        top:var(--dashboard-dino-route-step-3-start-top, var(--dashboard-dino-card-3-top));
        transform:translateY(var(--dashboard-dino-route-step-3-hop, -24px));
    }
    24% {
        left:var(--dashboard-dino-route-step-3-start-left, var(--dashboard-dino-card-3-start));
        top:var(--dashboard-dino-route-step-3-start-top, var(--dashboard-dino-card-3-top));
        transform:translateY(0);
    }
    32% {
        left:var(--dashboard-dino-route-step-3-end-left, var(--dashboard-dino-card-3-end));
        top:var(--dashboard-dino-route-step-3-end-top, var(--dashboard-dino-card-3-top));
        transform:translateY(0);
    }
    34% {
        left:var(--dashboard-dino-route-step-4-start-left, var(--dashboard-dino-card-4-start));
        top:var(--dashboard-dino-route-step-4-start-top, var(--dashboard-dino-card-4-top));
        transform:translateY(var(--dashboard-dino-route-step-4-hop, -24px));
    }
    36% {
        left:var(--dashboard-dino-route-step-4-start-left, var(--dashboard-dino-card-4-start));
        top:var(--dashboard-dino-route-step-4-start-top, var(--dashboard-dino-card-4-top));
        transform:translateY(0);
    }
    42% {
        left:var(--dashboard-dino-route-step-4-end-left, var(--dashboard-dino-card-4-end));
        top:var(--dashboard-dino-route-step-4-end-top, var(--dashboard-dino-card-4-top));
        transform:translateY(0);
    }
    44% {
        left:var(--dashboard-dino-overview-end);
        top:var(--dashboard-dino-overview-top);
        transform:translateY(-34px);
    }
    46% {
        left:var(--dashboard-dino-overview-end);
        top:var(--dashboard-dino-overview-top);
        transform:translateY(0);
    }
    96% {
        left:var(--dashboard-dino-overview-start);
        top:var(--dashboard-dino-overview-top);
        transform:translateY(0);
    }
    98% {
        left:var(--dashboard-dino-route-loop-left, var(--dashboard-dino-card-1-start));
        top:var(--dashboard-dino-route-loop-top, var(--dashboard-dino-card-1-top));
        transform:translateY(-34px);
    }
    100% {
        left:var(--dashboard-dino-route-loop-left, var(--dashboard-dino-card-1-start));
        top:var(--dashboard-dino-route-loop-top, var(--dashboard-dino-card-1-top));
        transform:translateY(0);
    }
}

@@keyframes dashboardDinoFace {
    0%, 8% {
        transform:scaleX(var(--dashboard-dino-route-start-face, 1));
    }
    10%, 45.99% {
        transform:scaleX(1);
    }
    46%, 96% {
        transform:scaleX(-1);
    }
    98%, 99.99% {
        transform:scaleX(var(--dashboard-dino-route-return-face, -1));
    }
    100% {
        transform:scaleX(var(--dashboard-dino-route-start-face, 1));
    }
}

@@keyframes dashboardDinoLegA {
    0%, 49% { transform:translate(0, 0); }
    50%, 100% { transform:translate(3px, -1px); }
}

@@keyframes dashboardDinoLegB {
    0%, 49% { transform:translate(-3px, -1px); }
    50%, 100% { transform:translate(0, 0); }
}

@@keyframes dashboardDinoTailWag {
    0%, 100% { transform:rotate(0deg) translateY(0); }
    50% { transform:rotate(-8deg) translateY(-1px); }
}

@@keyframes dashboardDinoFoodDrop {
    0% { opacity:0; transform:translate(-50%, -110%) scale(.72) rotate(-10deg); }
    72% { opacity:1; transform:translate(-50%, -56%) scale(1.08) rotate(2deg); }
    100% { opacity:1; transform:translate(-50%, -60%) scale(1) rotate(0deg); }
}

@@keyframes dashboardDinoFoodEat {
    0% { opacity:1; transform:translate(-50%, -60%) scale(1); }
    55% { opacity:1; transform:translate(-50%, -60%) scale(.58) rotate(-8deg); }
    100% { opacity:0; transform:translate(-50%, -62%) scale(.1) rotate(-18deg); }
}

@@keyframes dashboardDinoNibble {
    0%, 100% { transform:translateY(0); }
    50% { transform:translateY(2px); }
}

@@media (prefers-reduced-motion: reduce) {
    .dashboard-dino-runner,
    .dashboard-dino-stage,
    .dino-tail,
    .dino-leg-a,
    .dino-leg-b {
        animation:none;
    }
}


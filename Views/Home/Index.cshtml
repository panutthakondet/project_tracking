.dashboard-grid > .glass-panel:not(.panel-wide):not(.panel-project-status):not(.panel-owner-overview):not(.panel-activity):not(.panel-line-overdue):not(.panel-issues):not(.panel-meetings):not(.panel-field-service):not(.panel-task):not(.panel-time):not(.panel-team) { grid-column:span 6; }

.panel-owner-overview {
    padding:20px 24px 18px;
    border-radius:18px;
    border:1px solid rgba(58,148,219,.4);
    background:
        linear-gradient(180deg, rgba(14,36,75,.95), rgba(7,22,50,.98)),
        radial-gradient(circle at 86% 12%, rgba(14,165,233,.17), transparent 32%);
}

.owner-overview-legend {
    display:flex;

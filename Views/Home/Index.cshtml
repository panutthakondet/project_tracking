@model ProjectTracking.ViewModels.HomeDashboardViewModel
@using System.Globalization
@using ProjectTracking.ViewModels

@{
    ViewData["Title"] = "Dashboard";

    var dashboard = Model ?? new HomeDashboardViewModel();
    var closedHoursPercent = dashboard.MonthWorkHours <= 0 ? 0 : Math.Round(dashboard.ClosedWorkHours * 100m / dashboard.MonthWorkHours, 1);
    var openHoursPercent = dashboard.MonthWorkHours <= 0 ? 0 : Math.Round(dashboard.OpenWorkHours * 100m / dashboard.MonthWorkHours, 1);
    var yearlyTaskAxisTicks = new[] { 30, 25, 20, 15, 10, 5, 0 };
    var showYearlyPending = dashboard.YearlyTasks.Any(task => task.Pending > 0);
}

<div class="dashboard-view">
    <section class="kpi-grid" aria-label="ตัวชี้วัดหลัก">
        <article class="kpi-card kpi-blue">
            <span class="kpi-icon" aria-hidden="true">□</span>
            <div>
                <p>Total Projects</p>
                <strong>@dashboard.TotalProjectCount</strong>
                <small>@dashboard.TotalProjectsNote</small>
            </div>
        </article>
        <article class="kpi-card kpi-purple">
            <span class="kpi-icon" aria-hidden="true">▦</span>
            <div>
                <p>Meetings Today</p>
                <strong>@dashboard.MeetingsTodayCount</strong>
                <small>@dashboard.MeetingsTodayNote</small>
            </div>
        </article>
        <article class="kpi-card kpi-orange">
            <span class="kpi-icon" aria-hidden="true">!</span>
            <div>
                <p>Open Issues</p>
                <strong>@dashboard.OpenIssueCount</strong>
                <small>@dashboard.OpenIssuesNote</small>
            </div>
        </article>
        <article class="kpi-card kpi-pink">
            <span class="kpi-icon" aria-hidden="true">⏱</span>
            <div>
                <p>Overdue Tasks</p>
                <strong>@dashboard.OverdueTaskCount</strong>
                <small>@dashboard.OverdueTasksNote</small>
            </div>
        </article>
    </section>

    <section class="dashboard-grid" aria-label="ภาพรวม dashboard">
        <article class="glass-panel panel-wide">
            <div class="panel-head">
                <h2>ภาพรวมโครงการ (Projects Overview)</h2>
                <div class="panel-actions">
                    <a asp-controller="Projects" asp-action="ViewOnly" class="panel-filter compact">รายละเอียด</a>
                </div>
            </div>
            <div class="project-overview-table">
                <div class="project-overview-summary" aria-label="สรุปจำนวนสถานะโครงการ">
                    @foreach (var metric in dashboard.ProjectStatusMetrics)
                    {
                        <span class="@metric.Color">
                            <i class="dot @metric.Color"></i>
                            <b>@metric.Label</b>
                            <strong>@metric.Count</strong>
                        </span>
                    }
                </div>
                <label class="project-overview-search">
                    <span>ค้นหาโครงการ</span>
                    <input type="search"
                           id="projectOverviewSearch"
                           placeholder="พิมพ์ชื่อโครงการ..."
                           autocomplete="off" />
                </label>
                <div class="project-overview-head" aria-hidden="true">
                    <span>Project</span>
                    <span>Status</span>
                    <span>Start</span>
                    <span>End</span>
                </div>
                <div class="project-overview-scroll">
                    @if (dashboard.ProjectOverviewProjects.Count == 0)
                    {
                        <p class="empty-state">ยังไม่มีข้อมูลโครงการ</p>
                    }
                    else
                    {
                        foreach (var project in dashboard.ProjectOverviewProjects)
                        {
                            <a class="project-overview-row"
                               asp-controller="ProjectPhases"
                               asp-action="Index"
                               asp-route-projectId="@project.ProjectId"
                               data-project-search="@project.ProjectName"
                               title="ดูงวดงานของ @project.ProjectName">
                                <span class="project-overview-name" title="@project.ProjectName">@project.ProjectName</span>
                                <span class="project-overview-status @project.StatusColor">@project.StatusText</span>
                                <time>@project.StartText</time>
                                <time>@project.EndText</time>
                            </a>
                        }
                        <p class="empty-state project-overview-empty" hidden>ไม่พบโครงการที่ค้นหา</p>
                    }
                </div>
            </div>
        </article>

        <article class="glass-panel panel-project-status">
            <div class="panel-head">
                <h2>สถานะโครงการ</h2>
                <a asp-controller="ProjectStatus" asp-action="Index" class="panel-filter compact">รายละเอียด</a>
            </div>
            <div class="donut-layout">
                <div class="donut" style="--donut:@dashboard.ProjectStatusDonut;">
                    <div><strong>@dashboard.TotalProjectCount</strong><span>โครงการ</span></div>
                </div>
                <div class="metric-list">
                    @foreach (var metric in dashboard.ProjectStatusMetrics)
                    {
                        <span><i class="dot @metric.Color"></i><span class="metric-name">@metric.Label</span><b>@metric.CountPercentText</b></span>
                    }
                </div>
            </div>
        </article>

        <article class="glass-panel side-panel panel-activity">
            <div class="panel-head">
                <h2>กิจกรรมล่าสุด (Recent Activity)</h2>
                <a asp-controller="Home" asp-action="Activities" class="panel-link">ดูทั้งหมด</a>
            </div>
            <div class="activity-list">
                @if (dashboard.RecentActivities.Count == 0)
                {
                    <p class="empty-state">ยังไม่มีกิจกรรมล่าสุด</p>
                }
                else
                {
                    foreach (var activity in dashboard.RecentActivities)
                    {
                        <a class="activity-row @activity.Color" href="@(string.IsNullOrWhiteSpace(activity.Url) ? Url.Action("Activities", "Home") : activity.Url)">
                            <img class="activity-avatar"
                                 src="@activity.AvatarPath"
                                 alt=""
                                 onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                            <span>
                                <b>@activity.Actor</b>
                                <small>@activity.Detail</small>
                                @if (!string.IsNullOrWhiteSpace(activity.OwnerText))
                                {
                                    <em>@activity.OwnerText</em>
                                }
                            </span>
                            <time>@activity.TimeText</time>
                        </a>
                    }
                }
            </div>
        </article>

        <article class="glass-panel compact-panel panel-top-projects">
            <div class="panel-head">
                <h2>Top 5 Projects Progress</h2>
                <a asp-controller="PhaseStatusReport" asp-action="Index" class="panel-link">ดูทั้งหมด</a>
            </div>
            <div class="progress-list">
                @if (dashboard.TopProjectProgress.Count == 0)
                {
                    <p class="empty-state">ยังไม่มีข้อมูลโครงการ</p>
                }
                else
                {
                    for (var i = 0; i < dashboard.TopProjectProgress.Count; i++)
                    {
                        var project = dashboard.TopProjectProgress[i];
                        <div class="progress-row">
                            <span>@(i + 1). @project.Name</span>
                            <div class="progress-track"><i class="@project.Color" style="width:@project.Value%"></i></div>
                            <b>@project.Value%</b>
                        </div>
                    }
                }
            </div>
        </article>

        <article class="glass-panel compact-panel panel-issues">
            <div class="panel-head">
                <h2>Issues Overview</h2>
                <a asp-controller="ProjectIssues" asp-action="ViewOnly" class="panel-filter compact">รายละเอียด</a>
            </div>
            <div class="donut-layout compact-donut-layout">
                <div class="donut donut-small" style="--donut:@dashboard.IssueDonut;">
                    <div><strong>@dashboard.IssueTotal</strong><span>ประเด็น</span></div>
                </div>
                <div class="metric-list slim">
                    @foreach (var metric in dashboard.IssueMetrics)
                    {
                        <span><i class="dot @metric.Color"></i><span class="metric-name">@metric.Label</span><b>@metric.CountPercentText</b></span>
                    }
                </div>
            </div>
        </article>

        <article class="glass-panel side-panel compact-panel panel-meetings">
            <div class="panel-head">
                <h2>ปฏิทินการประชุมวันนี้</h2>
                <a asp-controller="Meetings" asp-action="Index" class="panel-link">ดูทั้งหมด</a>
            </div>
            <div class="meeting-list">
                @if (dashboard.TodayMeetings.Count == 0)
                {
                    <p class="empty-state">วันนี้ยังไม่มีประชุม</p>
                }
                else
                {
                    foreach (var meeting in dashboard.TodayMeetings)
                    {
                        <div class="meeting-row">
                            <time class="time-pill @meeting.TimeColor">@Html.Raw(meeting.TimeText)</time>
                            <span><b>@meeting.Title</b><small>@meeting.Detail</small></span>
                            <span class="avatar-stack">
                                <img src="@meeting.AvatarPath" alt="" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                <i>+@meeting.AttendeeCount</i>
                            </span>
                        </div>
                    }
                }
            </div>
        </article>

        <article class="glass-panel panel-task">
            <div class="panel-head">
                <h2>Task Progress (รายปี)</h2>
                <div class="panel-actions">
                    <div class="legend-row compact">
                        <span><i class="dot green"></i>Completed</span>
                        <span><i class="dot blue"></i>In Progress</span>
                        @if (showYearlyPending)
                        {
                            <span><i class="dot orange"></i>Pending</span>
                        }
                    </div>
                    <a asp-controller="Reports" asp-action="TaskProgress" class="panel-link">รายละเอียด</a>
                </div>
            </div>
            <div class="yearly-chart">
                <span class="yearly-y-title">จำนวนงาน</span>
                <div class="yearly-y-axis" aria-hidden="true">
                    @foreach (var tick in yearlyTaskAxisTicks)
                    {
                        var tickTop = (30 - tick) * 100m / 30m;
                        <span style="top:@tickTop.ToString("0.###", CultureInfo.InvariantCulture)%">@tick</span>
                    }
                </div>
                <div class="yearly-plot">
                    <div class="bar-chart">
                        @foreach (var task in dashboard.YearlyTasks)
                        {
                            <div class="bar-group">
                                <span class="@(task.CompletedHeight == 0 ? "is-zero" : "")"
                                      style="height:@task.CompletedHeight%"
                                      title="Completed: @task.Completed">
                                    @if (task.Completed > 0)
                                    {
                                        <i>@task.Completed</i>
                                    }
                                </span>
                                <span class="@(task.InProgressHeight == 0 ? "is-zero" : "")"
                                      style="height:@task.InProgressHeight%"
                                      title="In Progress: @task.InProgress">
                                    @if (task.InProgress > 0)
                                    {
                                        <i>@task.InProgress</i>
                                    }
                                </span>
                                @if (showYearlyPending)
                                {
                                    <span class="@(task.PendingHeight == 0 ? "is-zero" : "")"
                                          style="height:@task.PendingHeight%"
                                          title="Pending: @task.Pending">
                                        @if (task.Pending > 0)
                                        {
                                            <i>@task.Pending</i>
                                        }
                                    </span>
                                }
                            </div>
                        }
                    </div>
                    <div class="yearly-x-axis" aria-hidden="true">
                        @foreach (var task in dashboard.YearlyTasks)
                        {
                            <span>@task.PeriodLabel</span>
                        }
                    </div>
                </div>
                <span class="yearly-x-title">เดือน</span>
            </div>
        </article>

        <article class="glass-panel panel-watch">
            <div class="panel-head">
                <h2>โครงการที่ต้องเฝ้าระวัง</h2>
                <div class="panel-actions">
                    <a asp-controller="PhaseWorkload" asp-action="Index" class="panel-link">ดูสถานะงาน</a>
                    <a asp-controller="Reports" asp-action="Executive" class="panel-link">รายละเอียด</a>
                </div>
            </div>
            <div class="watch-list">
                @if (dashboard.WatchProjects.Count == 0)
                {
                    <p class="empty-state">ยังไม่มีโครงการที่เข้าเงื่อนไขเสี่ยง</p>
                }
                else
                {
                    foreach (var project in dashboard.WatchProjects)
                    {
                        <a class="watch-row @project.RiskColor"
                           asp-controller="ProjectPhases"
                           asp-action="Index"
                           asp-route-projectId="@project.ProjectId"
                           title="ดูงวดงานของ @project.ProjectName">
                            <span class="watch-main">
                                <b>@project.ProjectName</b>
                                <small>เจ้าของ: @project.OwnerName</small>
                            </span>
                            <span class="watch-status">
                                <i class="risk-pill @project.RiskColor">@project.RiskLevel</i>
                                <small>@project.DueText</small>
                            </span>
                            <span class="watch-progress">
                                <span class="progress-track"><i class="@project.RiskColor" style="width:@project.Progress%"></i></span>
                                <b class="watch-percent">@project.Progress%</b>
                            </span>
                            <span class="watch-reasons">
                                @foreach (var reason in project.Reasons)
                                {
                                    <i>@reason</i>
                                }
                            </span>
                        </a>
                    }
                }
            </div>
        </article>

        <article class="glass-panel panel-time">
            <div class="panel-head">
                <h2>Time Tracking (ชั่วโมงทำงาน)</h2>
                <a asp-controller="Attendance" asp-action="Map" class="panel-link">ดูรายละเอียด</a>
            </div>
            <div class="time-layout">
                <div class="time-number">
                    <strong>@dashboard.MonthWorkHours.ToString("0.#")</strong>
                    <span>ชั่วโมง</span>
                    <small class="@dashboard.WorkHourTrendClass">@dashboard.WorkHourTrendText</small>
                </div>
                <div class="gauge" style="--donut:@dashboard.TimeTrackingDonut;">
                    <div>⏱</div>
                </div>
                <div class="metric-card">
                    <span><i class="dot green"></i>บันทึกครบ <b>@dashboard.ClosedWorkHours.ToString("0.#") (@closedHoursPercent.ToString("0.#")%)</b></span>
                    <span><i class="dot blue"></i>ยังไม่ออกงาน <b>@dashboard.OpenWorkHours.ToString("0.#") (@openHoursPercent.ToString("0.#")%)</b></span>
                </div>
            </div>
            <div class="time-detail-grid">
                <span><small>เข้างานวันนี้</small><b>@dashboard.TodayCheckinCount คน</b></span>
                <span><small>ออกงานแล้ว</small><b>@dashboard.TodayCheckoutCount คน</b></span>
                <span><small>ยังไม่ออกงาน</small><b>@dashboard.PendingCheckoutCount คน</b></span>
                <span><small>ยังไม่เข้างาน</small><b>@dashboard.TodayMissingCheckinCount คน</b></span>
                <span><small>วันที่มีบันทึก</small><b>@dashboard.MonthAttendanceDays วัน</b></span>
                <span><small>เฉลี่ยต่อวัน</small><b>@dashboard.AverageHoursPerDay.ToString("0.#") ชม.</b></span>
                <span><small>เกิน 12 ชม.</small><b>@dashboard.LongShiftCount ครั้ง</b></span>
                <span><small>ระยะเกิน 5 กม.</small><b>@dashboard.LongDistanceCount ครั้ง</b></span>
            </div>
            @if (dashboard.PendingCheckoutNames.Count > 0)
            {
                <div class="time-alert-row">
                    <b>ยังไม่ออกงาน</b>
                    <span>@string.Join(", ", dashboard.PendingCheckoutNames)</span>
                </div>
            }
        </article>

        <article class="glass-panel side-panel panel-team">
            <div class="panel-head">
                <h2>ทีมงานที่ทำงานหนักที่สุด</h2>
                <a asp-controller="PhaseStatusReport" asp-action="Index" class="panel-link">ดูทั้งหมด</a>
            </div>
            <div class="workload-list">
                @if (dashboard.TeamWorkload.Count == 0)
                {
                    <p class="empty-state">ยังไม่มีงานที่กำลังดำเนินการ</p>
                }
                else
                {
                    foreach (var member in dashboard.TeamWorkload)
                    {
                        <a class="workload-row"
                           asp-controller="PhaseStatusReport"
                           asp-action="Index"
                           asp-route-empName="@member.Name"
                           title="ดูรายงานสถานะงานของ @member.Name">
                            <img src="@member.AvatarPath" alt="" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                            <span>@member.Name</span>
                            <div class="progress-track"><i class="@member.Color" style="width:@member.Value%"></i></div>
                            <b>@member.Value%</b>
                        </a>
                    }
                }
            </div>
        </article>
    </section>

    <footer class="dashboard-footer">
        © 2026 <strong>#C</strong> By <strong>SO-AT SOLUTION</strong>
    </footer>
</div>

<style>
.dashboard-view {
    --panel:#111f3c;
    min-height:100vh;
    padding:8px 10px 26px;
    background:
        radial-gradient(circle at 18% 16%, rgba(34,211,238,.18), transparent 26%),
        radial-gradient(circle at 78% 24%, rgba(244,63,94,.12), transparent 24%),
        linear-gradient(180deg, #edf4fb 0%, #e7eff8 100%);
}

.dashboard-view,
.dashboard-view * {
    box-sizing:border-box;
}

.floating-tools-wrapper {
    display:none !important;
}

.dashboard-topbar {
    display:grid;
    grid-template-columns:max-content minmax(360px, 1fr) max-content;
    align-items:center;
    gap:24px;
    margin-bottom:20px;
}

.brand-cluster {
    display:flex;
    align-items:center;
    gap:20px;
    min-width:510px;
    color:#17213d;
    text-decoration:none;
}

.brand-cluster img {
    width:auto;
    height:76px;
    max-width:320px;
    object-fit:contain;
}

.brand-cluster strong {
    font-size:24px;
    font-weight:900;
    white-space:nowrap;
}

.dashboard-search {
    width:100%;
    max-width:540px;
    justify-self:center;
    height:54px;
    border-radius:28px;
    background:rgba(255,255,255,.75);
    border:1px solid rgba(139,152,181,.22);
    box-shadow:0 12px 28px rgba(15,23,42,.06);
    display:flex;
    align-items:center;
    gap:12px;
    padding:0 18px 0 24px;
    color:#74809b;
}

.dashboard-search input {
    flex:1;
    min-width:0;
    height:100%;
    border:0;
    outline:0;
    background:transparent;
    color:#17213a;
    font-size:15px;
    font-weight:700;
}

.dashboard-actions {
    display:flex;
    justify-content:flex-end;
    gap:14px;
}

.top-icon-button {
    width:54px;
    height:54px;
    border-radius:50%;
    color:#081632;
    background:rgba(255,255,255,.72);
    box-shadow:0 12px 32px rgba(15,23,42,.08);
    display:inline-flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    font-size:22px;
    font-weight:900;
}

.kpi-grid {
    display:grid;
    grid-template-columns:repeat(4, minmax(190px, 1fr));
    gap:16px;
    margin-bottom:16px;
}

.kpi-card {
    min-height:130px;
    position:relative;
    overflow:hidden;
    border-radius:16px;
    padding:18px;
    color:#fff;
    box-shadow:0 18px 34px rgba(15,23,42,.18);
    display:grid;
    grid-template-columns:72px minmax(0, 1fr);
    align-items:center;
    gap:16px;
}

.kpi-card::before {
    content:"";
    position:absolute;
    width:104px;
    height:104px;
    left:18px;
    top:26px;
    border-radius:50%;
    background:rgba(255,255,255,.13);
}

.kpi-blue { background:linear-gradient(135deg,#2d90ff,#005fe8); }
.kpi-purple { background:linear-gradient(135deg,#9c44ff,#5512ca); }
.kpi-orange { background:linear-gradient(135deg,#ff9b22,#ff4d0d); }
.kpi-pink { background:linear-gradient(135deg,#ff487a,#d90962); }

.kpi-icon {
    position:relative;
    z-index:1;
    left:auto;
    top:auto;
    width:64px;
    height:64px;
    border-radius:50%;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    background:rgba(255,255,255,.16);
    font-size:34px;
    font-weight:900;
}

.kpi-card > div {
    min-width:0;
    position:relative;
    z-index:1;
}

.kpi-card p {
    margin:0 0 4px;
    font-size:15px;
    line-height:1.18;
    font-weight:900;
    overflow-wrap:anywhere;
}

.kpi-card strong {
    display:block;
    font-size:38px;
    line-height:1;
    font-weight:900;
}

.kpi-card small {
    display:block;
    margin-top:12px;
    color:rgba(255,255,255,.9);
    font-size:12px;
    line-height:1.25;
    font-weight:800;
    overflow-wrap:anywhere;
}

.dashboard-grid {
    display:grid;
    grid-template-columns:repeat(24, minmax(0, 1fr));
    gap:12px;
}

.dashboard-footer {
    margin-top:18px;
    padding:16px 8px 2px;
    text-align:center;
    color:#64748b;
    font-size:12px;
    font-weight:900;
}

.dashboard-footer strong {
    color:#0f766e;
}

.glass-panel {
    min-height:238px;
    position:relative;
    overflow:hidden;
    min-width:0;
    border-radius:12px;
    padding:17px 18px;
    color:#fff;
    background:
        linear-gradient(180deg, rgba(23,43,82,.96), rgba(9,24,50,.98)),
        radial-gradient(circle at 78% 10%, rgba(28,211,217,.18), transparent 30%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.11), 0 12px 24px rgba(5,15,35,.26);
    border:1px solid rgba(115,142,184,.22);
}

.panel-wide { order:1; grid-column:span 15; min-height:278px; }
.compact-panel { min-height:198px; }
.panel-project-status { order:2; grid-column:span 9; min-height:278px; }
.panel-task { order:3; grid-column:span 24; min-height:252px; }
.panel-watch { order:4; grid-column:span 24; min-height:278px; }
.panel-top-projects { order:5; grid-column:span 16; min-height:238px; }
.panel-issues { order:6; grid-column:span 8; min-height:238px; }
.panel-time { order:7; grid-column:span 12; min-height:278px; }
.panel-team { order:8; grid-column:span 12; min-height:278px; }
.panel-activity { order:9; grid-column:span 18; min-height:278px; }
.panel-meetings { order:9; grid-column:span 6; min-height:278px; }
.dashboard-grid > .glass-panel:not(.panel-wide):not(.panel-project-status):not(.panel-watch):not(.panel-activity):not(.panel-top-projects):not(.panel-issues):not(.panel-meetings):not(.panel-task):not(.panel-time):not(.panel-team) { grid-column:span 6; }

.panel-head {
    position:relative;
    z-index:1;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:14px;
    margin-bottom:14px;
    min-width:0;
}

.panel-head h2 {
    margin:0;
    min-width:0;
    color:#f6fbff;
    font-size:16px;
    line-height:1.15;
    font-weight:900;
    overflow-wrap:anywhere;
}

.panel-actions {
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:8px;
    flex-wrap:wrap;
}

.panel-filter,
.panel-link {
    border:0;
    border-radius:999px;
    padding:8px 14px;
    color:#dce7ff;
    background:rgba(255,255,255,.08);
    font-size:12px;
    font-weight:900;
    text-decoration:none;
    white-space:nowrap;
}

.panel-link {
    color:#7da9ff;
    background:transparent;
    padding:0;
}

.legend-row {
    position:relative;
    z-index:1;
    display:flex;
    align-items:center;
    gap:24px;
    margin:0 0 4px 28px;
    color:#f4f7ff;
    font-size:12px;
    font-weight:900;
    flex-wrap:wrap;
}

.legend-row.compact {
    margin:0;
    gap:10px 14px;
    color:#96a7c8;
}

.legend-row span {
    min-width:0;
    display:inline-flex;
    align-items:center;
    white-space:normal;
}

.dot {
    width:10px;
    height:10px;
    border-radius:50%;
    display:inline-block;
    margin-right:8px;
    box-shadow:0 0 12px currentColor;
}

.dot.green { color:#10d58f; background:#10d58f; }
.dot.blue { color:#1688f5; background:#1688f5; }
.dot.orange { color:#fb9a13; background:#fb9a13; }
.dot.pink { color:#ff2d62; background:#ff2d62; }
.dot.purple { color:#8b4df4; background:#8b4df4; }
.dot.cyan { color:#0ad0c8; background:#0ad0c8; }
.dot.lime { color:#52d11f; background:#52d11f; }

.line-chart {
    position:relative;
    z-index:1;
    height:212px;
    margin-top:4px;
    padding-bottom:42px;
}

.line-chart svg {
    width:100%;
    height:158px;
}

.grid-lines path {
    stroke:rgba(255,255,255,.12);
    stroke-width:1;
}

.line {
    fill:none;
    stroke-width:4;
    filter:drop-shadow(0 0 8px currentColor);
}

.line.green { color:#10d58f; stroke:#10d58f; }
.line.blue { color:#1688f5; stroke:#1688f5; }
.line.orange { color:#fb9a13; stroke:#fb9a13; }
.line.pink { color:#ff2d62; stroke:#ff2d62; }

.chart-tooltip {
    position:absolute;
    left:34px;
    right:0;
    bottom:24px;
    width:auto;
    min-height:32px;
    display:flex;
    align-items:center;
    gap:14px;
    padding:7px 10px;
    border-radius:10px;
    background:rgba(8,13,27,.42);
    box-shadow:none;
    backdrop-filter:blur(6px);
    font-size:12px;
}

.chart-tooltip b,
.chart-tooltip span {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:8px;
    margin-top:0;
    white-space:nowrap;
}

.chart-tooltip b {
    margin-bottom:0;
    color:#fff;
}

.months-row {
    display:grid;
    grid-template-columns:repeat(12, 1fr);
    color:#d8e4ff;
    font-size:12px;
    font-weight:800;
    padding:0 4px 0 34px;
}

.project-overview-table {
    position:relative;
    z-index:1;
    display:grid;
    gap:8px;
    min-width:0;
    max-width:100%;
}

.project-overview-summary {
    display:grid;
    grid-template-columns:repeat(4, minmax(0, 1fr));
    gap:8px;
    min-width:0;
}

.project-overview-summary span {
    min-width:0;
    display:grid;
    grid-template-columns:auto minmax(0, 1fr) max-content;
    align-items:center;
    gap:6px;
    padding:7px 9px;
    border:1px solid rgba(217,228,251,.08);
    border-radius:10px;
    background:rgba(255,255,255,.04);
}

.project-overview-summary b {
    min-width:0;
    overflow:hidden;
    color:#d9e4fb;
    font-size:11px;
    font-weight:900;
    line-height:1.1;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.project-overview-summary strong {
    color:#fff;
    font-size:15px;
    font-weight:900;
    line-height:1;
}

.project-overview-summary span.green strong { color:#10d58f; }
.project-overview-summary span.blue strong { color:#1688f5; }
.project-overview-summary span.orange strong { color:#fb9a13; }
.project-overview-summary span.purple strong { color:#b16cff; }
.project-overview-summary span.pink strong { color:#ff4f7f; }

.project-overview-search {
    min-width:0;
    display:grid;
    gap:4px;
    color:#8fa4c8;
    font-size:11px;
    font-weight:900;
}

.project-overview-search input {
    width:100%;
    min-width:0;
    height:38px;
    box-sizing:border-box;
    border:1px solid rgba(217,228,251,.16);
    border-radius:10px;
    outline:none;
    padding:0 13px;
    background:rgba(255,255,255,.055);
    color:#f4f8ff;
    font-family:'Sarabun', sans-serif;
    font-size:12px;
    font-weight:900;
}

.project-overview-search input::placeholder {
    color:rgba(217,228,251,.55);
}

.project-overview-search input:focus {
    border-color:rgba(20,184,166,.65);
    box-shadow:0 0 0 3px rgba(20,184,166,.13);
}

.project-overview-head,
.project-overview-row {
    display:grid;
    grid-template-columns:minmax(0, 1.7fr) 112px 96px 96px;
    align-items:center;
    gap:10px;
    min-width:0;
}

.project-overview-head {
    padding:0 10px 6px;
    border-bottom:1px solid rgba(217,228,251,.16);
    color:#8fa4c8;
    font-size:11px;
    font-weight:900;
}

.project-overview-head span:not(:first-child) {
    text-align:center;
}

.project-overview-scroll {
    display:grid;
    gap:6px;
    max-height:258px;
    overflow-y:auto;
    overflow-x:hidden;
    padding-right:4px;
    scrollbar-width:thin;
    scrollbar-color:rgba(20,184,166,.72) rgba(15,35,64,.42);
}

.project-overview-scroll::-webkit-scrollbar {
    width:8px;
}

.project-overview-scroll::-webkit-scrollbar-track {
    border-radius:999px;
    background:rgba(15,35,64,.42);
}

.project-overview-scroll::-webkit-scrollbar-thumb {
    border-radius:999px;
    background:linear-gradient(180deg,#14b8a6,#1688f5);
}

.project-overview-empty {
    padding:12px 10px;
    text-align:center;
}

.project-overview-row {
    min-height:44px;
    box-sizing:border-box;
    padding:7px 10px;
    border:1px solid rgba(217,228,251,.08);
    border-radius:10px;
    background:rgba(255,255,255,.035);
    color:inherit;
    text-decoration:none;
    transition:background .18s ease, transform .18s ease, border-color .18s ease;
}

.project-overview-row:hover {
    background:rgba(255,255,255,.06);
    border-color:rgba(20,184,166,.24);
    color:inherit;
    transform:translateX(2px);
}

.project-overview-name {
    min-width:0;
    color:#f4f8ff;
    font-size:12px;
    font-weight:900;
    line-height:1.2;
    white-space:normal;
    overflow-wrap:anywhere;
    word-break:break-word;
}

.project-overview-status {
    justify-self:center;
    color:#1688f5;
    font-size:11px;
    font-weight:900;
    text-align:center;
    white-space:nowrap;
}

.project-overview-status.green { color:#10d58f; }
.project-overview-status.orange { color:#fb9a13; }
.project-overview-status.purple { color:#b16cff; }
.project-overview-status.blue { color:#30a1ff; }
.project-overview-status.pink { color:#ff4f7f; }

.project-overview-row time {
    color:#d9e4fb;
    font-size:11px;
    font-weight:900;
    text-align:center;
    white-space:nowrap;
}

.donut-layout {
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns:minmax(118px, .9fr) minmax(0, 1fr);
    align-items:center;
    gap:12px;
    min-width:0;
}

.panel-project-status .donut-layout,
.panel-issues .donut-layout {
    min-height:calc(100% - 46px);
    justify-content:center;
    align-content:center;
    margin-inline:auto;
}

.panel-project-status .donut-layout {
    width:min(100%, 410px);
    grid-template-columns:1fr;
    justify-items:center;
    gap:14px;
}

.panel-project-status .metric-list {
    width:min(100%, 310px);
    gap:10px;
}

.panel-project-status .metric-list > span {
    grid-template-columns:auto minmax(0, 1fr) max-content;
    padding:0 4px;
}

.panel-issues .donut-layout {
    width:min(100%, 350px);
}

.compact-donut-layout {
    grid-template-columns:112px minmax(0, 1fr);
}

.donut,
.gauge {
    --donut:conic-gradient(#10d58f 0 40%, #1688f5 40% 80%, #fb9a13 80% 100%);
    width:min(170px, 100%);
    aspect-ratio:1;
    margin:0 auto;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:var(--donut);
    box-shadow:0 0 24px rgba(22,136,245,.2);
}

.donut > div,
.gauge > div {
    width:112px;
    aspect-ratio:1;
    border-radius:50%;
    display:grid;
    place-items:center;
    align-content:center;
    background:#111d3b;
    box-shadow:inset 0 0 18px rgba(255,255,255,.08);
}

.donut strong {
    display:block;
    font-size:35px;
    line-height:1;
    font-weight:900;
}

.donut span {
    display:block;
    margin-top:4px;
    color:#f2f7ff;
    font-size:13px;
    font-weight:900;
}

.donut-small {
    width:108px;
}

.donut-small > div {
    width:66px;
}

.donut-small strong {
    font-size:25px;
}

.metric-list {
    display:grid;
    gap:16px;
    font-size:13px;
    font-weight:900;
    min-width:0;
}

.metric-list > span {
    min-width:0;
    display:grid;
    grid-template-columns:auto minmax(0, 1fr) max-content;
    align-items:center;
    gap:6px;
    overflow:hidden;
}

.metric-name {
    min-width:0;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.metric-list b {
    justify-self:end;
    white-space:nowrap;
}

.metric-list.slim {
    gap:10px;
    font-size:11px;
}

.panel-issues .compact-donut-layout {
    grid-template-columns:124px minmax(0, 1fr);
    gap:14px;
}

.panel-issues .donut-small {
    width:124px;
}

.panel-issues .donut-small > div {
    width:76px;
}

.panel-issues .metric-list.slim {
    gap:12px;
    font-size:12px;
}

.panel-issues .metric-list > span {
    grid-template-columns:auto minmax(72px, 1fr) max-content;
}

.empty-state,
.empty-inline {
    position:relative;
    z-index:1;
    margin:0;
    color:#9fb0d0;
    font-size:12px;
    font-weight:900;
}

.empty-state {
    padding:16px 4px;
}

.activity-list,
.meeting-list,
.progress-list,
.workload-list {
    position:relative;
    z-index:1;
    display:grid;
    gap:10px;
    min-width:0;
    max-width:100%;
}

.progress-list,
.workload-list {
    overflow-x:auto;
    overflow-y:visible;
    padding-bottom:4px;
    scrollbar-width:thin;
    scrollbar-color:rgba(20,184,166,.6) transparent;
}

.progress-list::-webkit-scrollbar,
.workload-list::-webkit-scrollbar {
    height:7px;
}

.progress-list::-webkit-scrollbar-thumb,
.workload-list::-webkit-scrollbar-thumb {
    border-radius:999px;
    background:rgba(20,184,166,.62);
}

.panel-team .workload-list {
    grid-template-columns:1fr;
    gap:10px;
}

.watch-list {
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns:repeat(2, minmax(0, 1fr));
    align-items:start;
    gap:10px;
}

.watch-row {
    display:grid;
    grid-template-columns:minmax(0, 1.35fr) 126px;
    gap:8px 12px;
    padding:10px 12px;
    border-radius:12px;
    color:inherit;
    text-decoration:none;
    background:rgba(255,255,255,.045);
    border:1px solid rgba(255,255,255,.08);
    min-width:0;
}

.watch-row:hover {
    background:rgba(255,255,255,.075);
}

.watch-row.pink { box-shadow:inset 3px 0 0 #ff2d62; }
.watch-row.orange { box-shadow:inset 3px 0 0 #fb9a13; }
.watch-row.blue { box-shadow:inset 3px 0 0 #1688f5; }

.watch-main,
.watch-status,
.watch-progress,
.watch-reasons {
    min-width:0;
}

.watch-main b {
    display:block;
    color:#fff;
    font-size:13px;
    line-height:1.25;
    font-weight:900;
    overflow-wrap:anywhere;
}

.watch-main small,
.watch-status small {
    display:block;
    margin-top:3px;
    color:#9fb0d0;
    font-size:11px;
    line-height:1.25;
    font-weight:800;
    overflow-wrap:anywhere;
}

.watch-status {
    justify-self:end;
    text-align:right;
}

.risk-pill {
    min-width:56px;
    min-height:24px;
    border-radius:999px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:4px 9px;
    color:#fff;
    font-size:11px;
    font-style:normal;
    font-weight:900;
}

.risk-pill.pink { background:linear-gradient(135deg,#ff2d62,#ff6043); }
.risk-pill.orange { background:linear-gradient(135deg,#fb9a13,#ffb13b); }
.risk-pill.blue { background:linear-gradient(135deg,#1688f5,#0ad0c8); }

.watch-progress {
    display:grid;
    grid-template-columns:minmax(0, 1fr) 58px;
    align-items:center;
    gap:10px;
}

.watch-progress .progress-track {
    display:block;
}

.watch-percent {
    min-width:54px;
    min-height:26px;
    border-radius:999px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    justify-self:end;
    background:rgba(255,255,255,.1);
    color:#f4f8ff;
    font-size:12px;
    font-weight:900;
    text-align:right;
    white-space:nowrap;
}

.watch-reasons {
    display:flex;
    flex-wrap:wrap;
    gap:5px;
    justify-content:flex-end;
}

.watch-reasons i {
    border-radius:999px;
    padding:4px 8px;
    color:#d9e4fb;
    background:rgba(255,255,255,.075);
    font-size:10px;
    font-style:normal;
    font-weight:900;
    line-height:1.1;
}

.activity-row {
    display:grid;
    grid-template-columns:34px minmax(0, 1fr) max-content;
    align-items:center;
    gap:10px;
    padding:6px 4px;
    border-radius:10px;
    color:inherit;
    text-decoration:none;
    min-width:0;
}

.activity-row:hover {
    background:rgba(255,255,255,.06);
}

.activity-avatar {
    width:34px;
    height:34px;
    border-radius:50%;
    object-fit:cover;
    background:#172849;
    border:2px solid rgba(255,255,255,.2);
    box-shadow:0 8px 14px rgba(0,0,0,.2);
}

.activity-row.green .activity-avatar { border-color:rgba(16,213,143,.65); }
.activity-row.pink .activity-avatar { border-color:rgba(255,45,98,.65); }
.activity-row.blue .activity-avatar { border-color:rgba(22,136,245,.65); }
.activity-row.orange .activity-avatar { border-color:rgba(251,154,19,.65); }
.activity-row.cyan .activity-avatar { border-color:rgba(10,208,200,.65); }
.activity-row.purple .activity-avatar { border-color:rgba(139,77,244,.65); }

.activity-row b,
.meeting-row b {
    display:block;
    min-width:0;
    color:#fff;
    font-size:13px;
    line-height:1.2;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.activity-row small,
.meeting-row small {
    display:block;
    margin-top:2px;
    color:#b7c6e7;
    font-size:11px;
    font-weight:800;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.activity-row span,
.meeting-row span {
    min-width:0;
}

.activity-row em {
    display:block;
    margin-top:2px;
    color:#8ea0c3;
    font-size:10px;
    font-style:normal;
    font-weight:800;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.activity-row time {
    color:#7d8dad;
    font-size:11px;
    font-weight:800;
    white-space:nowrap;
}

.progress-row,
.workload-row {
    display:grid;
    grid-template-columns:minmax(124px, 1fr) minmax(110px, 1.2fr) 40px;
    align-items:center;
    gap:10px;
    color:#f4f8ff;
    font-size:12px;
    font-weight:900;
    min-width:0;
    width:100%;
    max-width:100%;
    box-sizing:border-box;
    text-decoration:none;
    transition:background .18s ease, transform .18s ease;
}

.workload-row:hover {
    color:#fff;
    background:rgba(255,255,255,.06);
    transform:translateX(2px);
}

.progress-row span,
.workload-row span {
    min-width:0;
    overflow:hidden;
    display:-webkit-box;
    -webkit-box-orient:vertical;
    -webkit-line-clamp:2;
    overflow-wrap:anywhere;
}

.panel-top-projects .progress-row {
    align-items:start;
    grid-template-columns:minmax(0, 1.45fr) minmax(96px, 1fr) 48px;
}

.panel-top-projects .progress-row span {
    display:block;
    overflow:visible;
    -webkit-line-clamp:unset;
    white-space:normal;
}

.panel-top-projects .progress-track {
    margin-top:4px;
}

.panel-top-projects .progress-list {
    gap:12px;
}

.progress-row b,
.workload-row b {
    white-space:nowrap;
    text-align:right;
}

.progress-track {
    width:100%;
    min-width:0;
    max-width:100%;
    height:10px;
    overflow:hidden;
    border-radius:999px;
    background:#020712;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.07);
}

.progress-track i {
    display:block;
    height:100%;
    border-radius:inherit;
}

.progress-track .green { background:linear-gradient(90deg,#20df4c,#92ff84); }
.progress-track .blue { background:linear-gradient(90deg,#1688f5,#2ec8ff); }
.progress-track .orange { background:linear-gradient(90deg,#fb9a13,#ff6333); }
.progress-track .purple { background:linear-gradient(90deg,#8b4df4,#d352ff); }
.progress-track .pink { background:linear-gradient(90deg,#ff2d62,#ff6a94); }
.progress-track .cyan { background:linear-gradient(90deg,#0ad0c8,#12d8ff); }
.progress-track .lime { background:linear-gradient(90deg,#52d11f,#a4ff73); }

.meeting-row {
    display:grid;
    grid-template-columns:58px minmax(0, 1fr) 54px;
    align-items:center;
    gap:10px;
    min-width:0;
}

.time-pill {
    width:58px;
    height:44px;
    border-radius:9px;
    display:inline-flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    color:#fff;
    font-size:11px;
    line-height:1.05;
    font-weight:900;
}

.time-pill.pink { background:linear-gradient(135deg,#ff2d62,#ff6043); }
.time-pill.purple { background:linear-gradient(135deg,#8b4df4,#5b2fd3); }
.time-pill.blue { background:linear-gradient(135deg,#1688f5,#0ad0c8); }
.time-pill.orange { background:linear-gradient(135deg,#fb9a13,#ff6333); }
.time-pill.green { background:linear-gradient(135deg,#10d58f,#078f6d); }

.avatar-stack {
    display:flex;
    align-items:center;
    justify-content:flex-end;
}

.avatar-stack img,
.workload-row img {
    width:25px;
    height:25px;
    object-fit:cover;
    border-radius:50%;
    border:2px solid rgba(255,255,255,.75);
}

.avatar-stack i {
    min-width:26px;
    height:24px;
    margin-left:-6px;
    border-radius:999px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    background:#1d355f;
    color:#fff;
    font-size:10px;
    font-style:normal;
    font-weight:900;
}

.yearly-chart {
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns:40px minmax(0, 1fr);
    grid-template-rows:minmax(202px, auto) 20px;
    column-gap:10px;
    min-width:0;
    padding:0 2px 0 20px;
}

.yearly-y-title {
    position:absolute;
    left:-6px;
    top:74px;

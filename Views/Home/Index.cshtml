.energy-tube {
    --energy:#1688f5;
    --energy-dark:#0d5faf;
    position:relative;
    width:28px;
    height:62px;
    display:block;
    border-radius:16px 16px 10px 10px;
    background:linear-gradient(145deg, rgba(255,255,255,.18), rgba(255,255,255,.04) 34%, rgba(3,10,28,.3));
    border:1px solid rgba(217,228,251,.24);
    box-shadow:
        0 10px 18px rgba(3,10,28,.24),
        inset 0 1px 0 rgba(255,255,255,.28),
        inset -6px 0 9px rgba(3,10,28,.2);
    overflow:visible;
}

.energy-tube::before {
    content:"";
    position:absolute;
    left:6px;
    right:6px;
    top:3px;
    height:6px;
    border-radius:8px 8px 3px 3px;
    background:linear-gradient(180deg, rgba(255,255,255,.38), rgba(255,255,255,.1));
    border:1px solid rgba(217,228,251,.18);
}

.energy-tube::after {
    content:"";
    position:absolute;
    inset:13px 6px 7px;
    border-radius:11px 11px 7px 7px;
    background:
        linear-gradient(90deg, rgba(255,255,255,.18), transparent 34%, rgba(0,0,0,.14) 100%),
        rgba(5,15,35,.68);
    box-shadow:inset 0 0 12px rgba(3,10,28,.72);
}

.energy-tube i {
    position:absolute;
    z-index:1;
    left:6px;
    right:6px;
    bottom:7px;
    min-height:4px;
    border-radius:10px 10px 7px 7px;
    background:
        radial-gradient(circle at 38% 18%, rgba(255,255,255,.7), transparent 24%),
        linear-gradient(180deg, color-mix(in srgb, var(--energy) 86%, white), var(--energy) 48%, var(--energy-dark));
    box-shadow:
        0 0 14px color-mix(in srgb, var(--energy) 62%, transparent),
        inset 0 1px 0 rgba(255,255,255,.42),
        inset -4px 0 8px rgba(3,10,28,.18);
}

.energy-tube em {
    position:absolute;
    z-index:2;
    left:50%;
    top:calc(100% + 4px);
    transform:translateX(-50%);
    width:100%;
    min-width:0;
    min-height:16px;
    border-radius:0;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    background:transparent;
    color:#f4f8ff;
    font-size:9px;
    font-style:normal;
    font-weight:900;
    line-height:1;
    white-space:nowrap;
}

.energy-tube.pink { --energy:#ff3f7c; --energy-dark:#c81f55; }
.energy-tube.orange { --energy:#fb9a13; --energy-dark:#c96d00; }
.energy-tube.blue { --energy:#1688f5; --energy-dark:#0a5fb3; }


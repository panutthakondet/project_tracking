</style>

<script>
    (() => {
        const searchInput = document.getElementById('projectOverviewSearch');
        if (!searchInput) return;

        const rows = Array.from(document.querySelectorAll('.project-overview-row[data-project-search]'));
        const emptyMessage = document.querySelector('.project-overview-empty');
        const normalize = value => String(value ?? '').trim().replace(/\s+/g, ' ').toLowerCase();

        const applyFilter = () => {
            const keyword = normalize(searchInput.value);
            let visibleCount = 0;

            rows.forEach((row, index) => {
                const text = normalize(row.dataset.projectSearch || row.textContent);
                const matchesSearch = !keyword || text.includes(keyword);
                row.classList.toggle('is-filter-hidden', !matchesSearch);
                if (matchesSearch) visibleCount++;
            });

            if (emptyMessage) {
                emptyMessage.hidden = visibleCount > 0;
            }
        };

        searchInput.addEventListener('input', applyFilter);
        applyFilter();
    })();

    (() => {
        const root = document.querySelector('[data-dashboard-search]');
        if (!root) return;

        const input = document.getElementById('dashboardGlobalSearch');
        const resultsBox = root.querySelector('[data-dashboard-search-results]');
        const clearButton = root.querySelector('[data-dashboard-search-clear]');
        const searchUrl = root.dataset.dashboardSearchUrl;
        const groupLabels = {
            Projects: 'Projects',
            ProjectPhases: 'Project Phases',
            PhaseAssigns: 'Assign Phase',
            ProjectIssues: 'Issues',
            SupportOrders: 'Support'
        };

        let timer = null;
        let controller = null;

        const escapeHtml = value => String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');

        const normalizeItem = item => ({
            type: item.type ?? item.Type ?? '',
            title: item.title ?? item.Title ?? '',
            detail: item.detail ?? item.Detail ?? '',
            url: item.url ?? item.Url ?? '#',
            color: item.color ?? item.Color ?? 'blue'
        });

        const setResults = html => {
            resultsBox.innerHTML = html;
            resultsBox.hidden = false;
        };

        const renderResults = items => {
            if (!items.length) {
                setResults('<p class="dashboard-search-state">ไม่พบข้อมูลที่ตรงกับคำค้น</p>');
                return;
            }

            const normalized = items.map(normalizeItem);
            const groups = normalized.reduce((map, item) => {
                if (!map.has(item.type)) map.set(item.type, []);
                map.get(item.type).push(item);
                return map;
            }, new Map());

            const html = Array.from(groups.entries()).map(([type, groupItems]) => {
                const label = groupLabels[type] || type || 'ผลลัพธ์';
                const list = groupItems.map(item => `
                    <a class="dashboard-search-result" href="${escapeHtml(item.url)}">
                        <span class="dashboard-search-result-mark ${escapeHtml(item.color)}" aria-hidden="true"></span>
                        <span class="dashboard-search-result-body">
                            <strong class="dashboard-search-result-title">${escapeHtml(item.title)}</strong>
                            <span class="dashboard-search-result-detail">${escapeHtml(item.detail)}</span>
                        </span>
                    </a>
                `).join('');

                return `
                    <div class="dashboard-search-group">
                        <p class="dashboard-search-group-title">${escapeHtml(label)} <span>${groupItems.length}</span></p>
                        ${list}
                    </div>
                `;
            }).join('');

            setResults(html);
        };

        const doSearch = async () => {
            const keyword = input.value.trim();
            clearButton.hidden = keyword.length === 0;

            if (keyword.length < 2) {
                resultsBox.hidden = true;
                resultsBox.innerHTML = '';
                return;
            }

            if (controller) controller.abort();
            controller = new AbortController();
            setResults('<p class="dashboard-search-state">กำลังค้นหา...</p>');

            try {
                const response = await fetch(`${searchUrl}?q=${encodeURIComponent(keyword)}`, {
                    signal: controller.signal,
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) throw new Error('search failed');
                renderResults(await response.json());
            } catch (error) {
                if (error.name === 'AbortError') return;
                setResults('<p class="dashboard-search-state">ค้นหาไม่สำเร็จ ลองใหม่อีกครั้ง</p>');
            }
        };

        input.addEventListener('input', () => {
            window.clearTimeout(timer);
            timer = window.setTimeout(doSearch, 220);
        });

        input.addEventListener('focus', () => {
            if (input.value.trim().length >= 2 && resultsBox.innerHTML.trim()) {
                resultsBox.hidden = false;
            }
        });

        clearButton.addEventListener('click', () => {
            input.value = '';
            clearButton.hidden = true;
            resultsBox.hidden = true;
            resultsBox.innerHTML = '';
            input.focus();
        });

        document.addEventListener('click', event => {
            if (!root.contains(event.target)) {
                resultsBox.hidden = true;
            }
        });
    })();
</script>

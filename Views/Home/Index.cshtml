.bar-chart {
    min-width:720px;
    height:174px;
    box-sizing:border-box;
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(58px, 1fr));
    align-items:start;
    gap:14px;
    padding:0 16px;
    position:relative;
    background:none;
}

.bar-chart::before {
    content:"";
    position:absolute;
    z-index:0;
    left:0;
    right:0;
    top:24px;
    height:150px;
    border-left:1px solid rgba(217,228,251,.36);
    border-bottom:1px solid rgba(217,228,251,.36);
    background:repeating-linear-gradient(to bottom, rgba(255,255,255,.1) 0 1px, transparent 1px 25px);
    pointer-events:none;
}

.yearly-x-axis {
    min-width:720px;
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(58px, 1fr));
    gap:14px;
    padding:6px 16px 0;
    color:#d9e4fb;
    font-size:11px;
    font-weight:900;
    text-align:center;
}

.yearly-x-axis span {
    min-width:0;
    line-height:1;
    white-space:nowrap;
}

.bar-group {
    height:150px;
    margin-top:24px;
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    align-items:end;
    gap:5px;
    position:relative;
    z-index:1;
}

.bar-group span {
    min-height:8px;
    border-radius:5px 5px 2px 2px;
    position:relative;
    display:flex;
    justify-content:center;
    overflow:visible;
    transform-style:preserve-3d;
    box-shadow:
        0 8px 12px rgba(3,10,28,.18),
        inset 0 1px 0 rgba(255,255,255,.2),
        inset -3px 0 7px rgba(3,10,28,.13);
}

.bar-group span.is-zero {
    min-height:0;
    box-shadow:none;
}

.bar-group span::before,
.bar-group span::after {
    content:"";
    position:absolute;
    pointer-events:none;
}

.bar-group span::before {
    left:4px;
    right:-4px;
    top:-5px;
    height:6px;
    border-radius:5px 6px 2px 2px;
    transform:skewX(-32deg);
    transform-origin:left bottom;
    opacity:.9;
}

.bar-group span::after {
    top:-1px;
    right:-6px;
    bottom:0;
    width:6px;
    border-radius:0 5px 2px 0;
    transform:skewY(-36deg);
    transform-origin:left top;
    opacity:.86;
}

.bar-group span.is-zero::before,
.bar-group span.is-zero::after {
    content:none;
}

.bar-group span:nth-child(1) { background:linear-gradient(180deg,#36daa0 0%, #12b77f 45%, #047c65 100%); }
.bar-group span:nth-child(2) { background:linear-gradient(180deg,#4bdcff 0%, #1aa9ef 48%, #127be4 100%); }
.bar-group span:nth-child(3) { background:linear-gradient(180deg,#ffc653 0%, #ffa01b 48%, #ff8400 100%); }

.bar-group span:nth-child(1)::before { background:linear-gradient(90deg,#68ebb7,#2fca91); }
.bar-group span:nth-child(1)::after { background:linear-gradient(180deg,#10a873,#05705a); }
.bar-group span:nth-child(2)::before { background:linear-gradient(90deg,#82e7ff,#37bff5); }
.bar-group span:nth-child(2)::after { background:linear-gradient(180deg,#159bd9,#1068be); }
.bar-group span:nth-child(3)::before { background:linear-gradient(90deg,#ffd572,#ffad31); }

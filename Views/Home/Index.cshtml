}

.dashboard-search-state {
    margin:0;
    padding:13px 14px;
    color:#aebddd;
    font-size:13px;
    font-weight:900;
}

.dashboard-search-group + .dashboard-search-group {
    margin-top:8px;
    padding-top:8px;
    border-top:1px solid rgba(148,163,184,.16);
}

.dashboard-search-group-title {
    display:flex;
    align-items:center;
    gap:8px;
    margin:0 0 7px;
    color:#9debe3;
    font-size:12px;
    line-height:1;
    font-weight:900;
    text-transform:uppercase;
    letter-spacing:.04em;
}

.dashboard-search-result {
    display:grid;
    grid-template-columns:10px minmax(0, 1fr);
    gap:10px;
    align-items:center;
    padding:10px 11px;
    border-radius:13px;
    color:#fff;
    text-decoration:none;
    background:rgba(255,255,255,.045);
    border:1px solid rgba(255,255,255,.06);
}

.dashboard-search-result + .dashboard-search-result {
    margin-top:6px;
}

.dashboard-search-result:hover {
    background:rgba(255,255,255,.09);
    transform:translateY(-1px);
}

.dashboard-search-result-mark {
    width:10px;
    height:38px;
    border-radius:999px;
    background:#1688f5;
    box-shadow:0 0 14px currentColor;
}

.dashboard-search-result-mark.blue { color:#1688f5; background:#1688f5; }
.dashboard-search-result-mark.green { color:#10d58f; background:#10d58f; }
.dashboard-search-result-mark.orange { color:#fb9a13; background:#fb9a13; }
.dashboard-search-result-mark.pink { color:#ff2d62; background:#ff2d62; }
.dashboard-search-result-mark.purple { color:#8b4df4; background:#8b4df4; }

.dashboard-search-result-body {
    min-width:0;
}

.dashboard-search-result-title {
    display:block;
    color:#f8fbff;
    font-size:14px;
    line-height:1.28;
    font-weight:900;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.dashboard-search-result-detail {
    display:block;
    margin-top:3px;
    color:#aebddd;
    font-size:12px;
    line-height:1.35;
    font-weight:800;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.dashboard-topbar {
    display:grid;
    grid-template-columns:max-content minmax(360px, 1fr) max-content;
    align-items:center;
    gap:24px;
    margin-bottom:20px;
}

.brand-cluster {
    display:flex;
    align-items:center;
    gap:20px;
    min-width:510px;
    color:#17213d;
    text-decoration:none;
}

.brand-cluster img {
    width:auto;
    height:76px;
    max-width:320px;
    object-fit:contain;
}

.brand-cluster strong {
    font-size:24px;
    font-weight:900;
    white-space:nowrap;
}

.dashboard-search {
    width:100%;
    max-width:540px;
    justify-self:center;
    height:54px;
    border-radius:28px;
    background:rgba(255,255,255,.75);
    border:1px solid rgba(139,152,181,.22);
    box-shadow:0 12px 28px rgba(15,23,42,.06);
    display:flex;
    align-items:center;
    gap:12px;
    padding:0 18px 0 24px;
    color:#74809b;
}

.dashboard-search input {
    flex:1;
    min-width:0;
    height:100%;
    border:0;
    outline:0;
    background:transparent;
    color:#17213a;
    font-size:15px;
    font-weight:700;
}

.dashboard-actions {
    display:flex;
    justify-content:flex-end;
    gap:14px;
}

.top-icon-button {
    width:54px;
    height:54px;
    border-radius:50%;
    color:#081632;
    background:rgba(255,255,255,.72);
    box-shadow:0 12px 32px rgba(15,23,42,.08);
    display:inline-flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    font-size:22px;
    font-weight:900;
}

.kpi-grid {
    display:grid;
    grid-template-columns:repeat(4, minmax(190px, 1fr));
    gap:16px;
    margin-bottom:16px;
}

.kpi-card {
    min-height:130px;
    position:relative;
    overflow:hidden;
    border-radius:16px;
    padding:18px;
    color:#fff;
    box-shadow:0 18px 34px rgba(15,23,42,.18);
    display:grid;
    grid-template-columns:72px minmax(0, 1fr);
    align-items:center;
    gap:16px;
    text-decoration:none;
    transition:transform .16s ease, box-shadow .16s ease, filter .16s ease;
}

.kpi-card:hover,
.kpi-card:focus {
    color:#fff;
    text-decoration:none;
    transform:translateY(-2px);
    filter:brightness(1.03);
    box-shadow:0 22px 40px rgba(15,23,42,.24);
}

.kpi-card::before {
    content:"";
    position:absolute;
    width:104px;
    height:104px;
    left:18px;
    top:26px;
    border-radius:50%;
    background:rgba(255,255,255,.13);
}

.kpi-blue { background:linear-gradient(135deg,#2d90ff,#005fe8); }
.kpi-purple { background:linear-gradient(135deg,#9c44ff,#5512ca); }
.kpi-orange { background:linear-gradient(135deg,#ff9b22,#ff4d0d); }
.kpi-pink { background:linear-gradient(135deg,#ff487a,#d90962); }

.kpi-icon {
    position:relative;
    z-index:1;
    left:auto;
    top:auto;
    width:64px;
    height:64px;
    border-radius:50%;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    background:rgba(255,255,255,.16);
    font-size:34px;
    font-weight:900;
}

.kpi-card > div {
    min-width:0;
    position:relative;
    z-index:1;
}

.kpi-card p {
    margin:0 0 4px;
    font-size:15px;
    line-height:1.18;
    font-weight:900;
    overflow-wrap:anywhere;
}

.kpi-card strong {
    display:block;
    font-size:38px;
    line-height:1;
    font-weight:900;
}

.kpi-card small {
    display:block;
    margin-top:12px;
    color:rgba(255,255,255,.9);
    font-size:12px;
    line-height:1.25;
    font-weight:800;
    overflow-wrap:anywhere;
}

.dashboard-grid {
    display:grid;
    grid-template-columns:repeat(24, minmax(0, 1fr));
    gap:12px;
}

.dashboard-footer {
    margin-top:18px;
    padding:16px 8px 2px;
    text-align:center;
    color:#64748b;
    font-size:12px;
    font-weight:900;
}

.dashboard-footer strong {
    color:#0f766e;
}

.glass-panel {
    min-height:238px;
    position:relative;
    overflow:hidden;
    min-width:0;
    border-radius:12px;
    padding:17px 18px;
    color:#fff;
    background:
        linear-gradient(180deg, rgba(23,43,82,.96), rgba(9,24,50,.98)),
        radial-gradient(circle at 78% 10%, rgba(28,211,217,.18), transparent 30%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.11), 0 12px 24px rgba(5,15,35,.26);
    border:1px solid rgba(115,142,184,.22);
}

.panel-wide { order:1; grid-column:span 24; min-height:278px; container-type:inline-size; }
.compact-panel { min-height:198px; }
.panel-project-status { order:2; grid-column:span 9; min-height:278px; }
.panel-task { order:3; grid-column:span 24; min-height:252px; }
.panel-watch { order:4; grid-column:span 24; min-height:278px; }
.panel-issues { order:6; grid-column:span 12; min-height:298px; }
.panel-time { order:5; grid-column:span 12; min-height:278px; }
.panel-team { order:8; grid-column:span 12; min-height:278px; }
.panel-activity { order:8; grid-column:span 12; min-height:278px; }
.panel-meetings { order:9; grid-column:span 6; min-height:278px; }
.dashboard-grid > .glass-panel:not(.panel-wide):not(.panel-project-status):not(.panel-watch):not(.panel-activity):not(.panel-issues):not(.panel-meetings):not(.panel-task):not(.panel-time):not(.panel-team) { grid-column:span 6; }

.panel-head {
    position:relative;
    z-index:1;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:14px;
    margin-bottom:14px;
    min-width:0;
}

.panel-head h2 {
    margin:0;
    min-width:0;
    color:#f6fbff;
    font-size:16px;
    line-height:1.15;
    font-weight:900;
    overflow-wrap:anywhere;
}

.project-overview-title-row {
    min-width:0;
    display:flex;
    align-items:center;
    gap:12px;
    flex-wrap:wrap;
}

.project-overview-title-row h2,
.project-overview-title-row h3 {
    margin:0;
    min-width:0;
    color:#f6fbff;
    font-size:16px;
    line-height:1.15;
    font-weight:900;
    overflow-wrap:anywhere;
}

.project-overview-title-row > span {
    width:1px;
    height:18px;
    background:rgba(217,228,251,.34);
}

.panel-actions {
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:8px;
    flex-wrap:wrap;
}

.panel-filter,
.panel-link {
    border:0;
    border-radius:999px;
    padding:8px 14px;
    color:#dce7ff;
    background:rgba(255,255,255,.08);
    font-size:12px;
    font-weight:900;
    text-decoration:none;
    white-space:nowrap;
}

.panel-link {
    color:#7da9ff;
    background:transparent;
    padding:0;
}

.legend-row {
    position:relative;
    z-index:1;
    display:flex;
    align-items:center;
    gap:24px;
    margin:0 0 4px 28px;
    color:#f4f7ff;
    font-size:12px;
    font-weight:900;
    flex-wrap:wrap;
}

.legend-row.compact {
    margin:0;
    gap:10px 14px;
    color:#96a7c8;
}

.legend-row span {
    min-width:0;
    display:inline-flex;
    align-items:center;
    white-space:normal;
}

.dot {
    width:10px;
    height:10px;
    border-radius:50%;
    display:inline-block;
    margin-right:8px;
    box-shadow:0 0 12px currentColor;
}

.dot.green { color:#10d58f; background:#10d58f; }
.dot.blue { color:#1688f5; background:#1688f5; }
.dot.orange { color:#fb9a13; background:#fb9a13; }
.dot.pink { color:#ff2d62; background:#ff2d62; }
.dot.purple { color:#8b4df4; background:#8b4df4; }
.dot.violet { color:#a855f7; background:#a855f7; }
.dot.cyan { color:#0ad0c8; background:#0ad0c8; }
.dot.lime { color:#52d11f; background:#52d11f; }
.dot.warning { color:#f59e0b; background:#f59e0b; }
.dot.info { color:#22c7f5; background:#22c7f5; }
.dot.success { color:#10d58f; background:#10d58f; }
.dot.primary { color:#3b82f6; background:#3b82f6; }
.dot.danger { color:#ef4444; background:#ef4444; }
.dot.dark { color:#64748b; background:#64748b; }
.dot.secondary { color:#94a3b8; background:#94a3b8; }
.dot.muted { color:#64748b; background:#64748b; }

.line-chart {
    position:relative;
    z-index:1;
    height:212px;
    margin-top:4px;
    padding-bottom:42px;
}

.line-chart svg {
    width:100%;
    height:158px;
}

.grid-lines path {
    stroke:rgba(255,255,255,.12);
    stroke-width:1;
}

.line {
    fill:none;
    stroke-width:4;
    filter:drop-shadow(0 0 8px currentColor);
}

.line.green { color:#10d58f; stroke:#10d58f; }
.line.blue { color:#1688f5; stroke:#1688f5; }
.line.orange { color:#fb9a13; stroke:#fb9a13; }
.line.pink { color:#ff2d62; stroke:#ff2d62; }

.chart-tooltip {
    position:absolute;
    left:34px;
    right:0;
    bottom:24px;
    width:auto;
    min-height:32px;
    display:flex;
    align-items:center;
    gap:14px;
    padding:7px 10px;
    border-radius:10px;
    background:rgba(8,13,27,.42);
    box-shadow:none;
    backdrop-filter:blur(6px);
    font-size:12px;
}

.chart-tooltip b,
.chart-tooltip span {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:8px;
    margin-top:0;
    white-space:nowrap;
}

.chart-tooltip b {
    margin-bottom:0;
    color:#fff;
}

.months-row {
    display:grid;
    grid-template-columns:repeat(12, 1fr);
    color:#d8e4ff;
    font-size:12px;
    font-weight:800;
    padding:0 4px 0 34px;
}

.project-overview-table {
    position:relative;
    z-index:1;
    display:grid;
    gap:8px;
    min-width:0;
    max-width:100%;
}

.project-overview-combined {
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns:minmax(0, 1.72fr) minmax(320px, .88fr);
    gap:18px;
    align-items:stretch;
}

.project-status-inline {
    min-width:0;
    display:grid;
    grid-template-rows:minmax(0, 1fr);
    padding:0 0 0 6px;
    border:0;
    border-radius:0;
    background:transparent;
}

.project-overview-search {
    min-width:0;
    display:grid;
    gap:4px;
    color:#8fa4c8;
    font-size:11px;
    font-weight:900;
}

.project-overview-search input {
    width:100%;
    min-width:0;
    height:38px;
    box-sizing:border-box;
    border:1px solid rgba(217,228,251,.16);
    border-radius:10px;
    outline:none;
    padding:0 13px;
    background:rgba(255,255,255,.055);
    color:#f4f8ff !important;
    -webkit-text-fill-color:#f4f8ff;
    caret-color:#f4f8ff;
    font-family:'Prompt', sans-serif;
    font-size:12px;
    font-weight:900;
}

.project-overview-search input::placeholder {
    color:rgba(217,228,251,.7);
    -webkit-text-fill-color:rgba(217,228,251,.7);
}

.project-overview-search input::-webkit-search-cancel-button {
    filter:invert(1) opacity(.65);
}

.project-overview-search input:focus {
    border-color:rgba(20,184,166,.65);
    box-shadow:0 0 0 3px rgba(20,184,166,.13);
}

.project-overview-head,
.project-overview-row {
    display:grid;
    grid-template-columns:minmax(0, 1.7fr) 112px 96px 96px;
    align-items:center;
    gap:10px;
    min-width:0;
}

.project-overview-head {
    padding:0 10px 6px;
    border-bottom:1px solid rgba(217,228,251,.16);
    color:#8fa4c8;
    font-size:11px;
    font-weight:900;
}

.project-overview-head span:not(:first-child) {
    text-align:center;
}

.project-overview-scroll {
    display:flex;
    flex-direction:column;
    gap:6px;
    height:250px;
    max-height:250px;
    overflow-y:auto;
    overflow-x:hidden;
    padding-right:4px;
    overscroll-behavior:contain;
    scrollbar-gutter:stable;
    scrollbar-width:thin;
    scrollbar-color:rgba(20,184,166,.72) rgba(15,35,64,.42);
}

.project-overview-scroll::-webkit-scrollbar {
    width:8px;
}

.project-overview-scroll::-webkit-scrollbar-track {
    border-radius:999px;
    background:rgba(15,35,64,.42);
}

.project-overview-scroll::-webkit-scrollbar-thumb {
    border-radius:999px;
    background:linear-gradient(180deg,#14b8a6,#1688f5);
}

.project-overview-empty {
    padding:12px 10px;
    text-align:center;
}

.project-overview-row {
    flex:0 0 auto;
    min-height:44px;
    box-sizing:border-box;
    padding:7px 10px;
    border:1px solid rgba(217,228,251,.08);
    border-radius:10px;
    background:rgba(255,255,255,.035);
    color:inherit;
    text-decoration:none;
    transition:background .18s ease, transform .18s ease, border-color .18s ease;
}

.project-overview-row:hover {
    background:rgba(255,255,255,.06);
    border-color:rgba(20,184,166,.24);
    color:inherit;
    transform:translateX(2px);
}

.project-overview-row.is-filter-hidden {
    display:none !important;
}

.project-overview-name {
    min-width:0;
    color:#f4f8ff;
    font-size:12px;
    font-weight:900;
    line-height:1.2;
    white-space:normal;
    overflow-wrap:break-word;
    word-break:normal;
}

.project-overview-status {
    justify-self:center;
    color:#1688f5;
    font-size:11px;
    font-weight:900;
    text-align:center;
    white-space:nowrap;
}

.project-overview-status.green { color:#10d58f; }
.project-overview-status.orange { color:#fb9a13; }
.project-overview-status.purple { color:#b16cff; }
.project-overview-status.blue { color:#30a1ff; }
.project-overview-status.pink { color:#ff4f7f; }

.project-overview-date {
    min-width:0;
    justify-self:center;
    display:flex;
    align-items:center;
    justify-content:center;
}

.project-overview-mobile-label {
    display:none !important;
}

.project-overview-row time {
    color:#d9e4fb;
    font-size:11px;
    font-weight:900;
    text-align:center;
    white-space:nowrap;
}

@@container (max-width:1100px) {
    .project-overview-combined {
        grid-template-columns:minmax(0, 1fr) minmax(260px, .42fr);
        gap:12px;
        align-items:start;
    }

    .project-status-inline {
        justify-items:end;
        align-self:start;
        padding:8px 0 0 4px;
    }

    .project-status-inline .donut-layout {
        width:min(100%, 320px) !important;
        justify-self:end;
        align-content:start;
    }

    .project-status-chart3d {
        width:min(100%, 300px) !important;
    }

    .project-overview-table {
        overflow-x:visible;
    }

    .project-overview-head {
        display:none;
    }

    .project-overview-scroll {
        height:250px;
        max-height:250px;
        overflow-x:hidden;
        padding-right:5px;
    }

    .project-overview-row {
        display:grid !important;
        grid-template-columns:minmax(0, 1fr) max-content !important;
        align-items:center !important;
        justify-content:stretch !important;
        min-width:0 !important;
        min-height:48px !important;
        height:auto !important;
        gap:10px !important;
        padding:9px 12px !important;
    }

    .project-overview-row:hover {
        transform:none;
    }

    .project-overview-name {
        display:-webkit-box !important;
        width:auto !important;
        min-width:0 !important;
        font-size:12px;
        line-height:1.28;
        white-space:normal !important;
        overflow:hidden !important;
        overflow-wrap:break-word !important;
        word-break:normal !important;
        -webkit-box-orient:vertical;
        -webkit-line-clamp:2;
    }

    .project-overview-status {
        justify-self:end !important;
        width:auto !important;
        min-height:0 !important;
        display:inline-flex !important;
        align-items:center;
        justify-content:flex-end;
        padding:0 !important;
        text-align:right !important;
        white-space:nowrap !important;
        line-height:1.1 !important;
    }

    .project-overview-status::before {
        content:none !important;
    }

    .project-overview-date,
    .project-overview-mobile-label {
        display:none !important;
    }
}

@@container (max-width:760px) {
    .project-overview-combined {
        grid-template-columns:1fr;
    }

    .project-status-inline {
        justify-items:center;
        padding:14px 0 0;
    }

    .project-status-inline .donut-layout {
        width:min(100%, 360px) !important;
        justify-self:center;
    }
}

.donut-layout {
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns:minmax(118px, .9fr) minmax(0, 1fr);
    align-items:center;
    gap:12px;
    min-width:0;
}

.panel-project-status .donut-layout,
.panel-issues .donut-layout {
    min-height:calc(100% - 46px);
    justify-content:center;
    align-content:center;
    margin-inline:auto;
}

.panel-project-status .donut-layout {
    width:min(100%, 410px);
    grid-template-columns:1fr;
    justify-items:center;
    gap:14px;
}

.panel-project-status .metric-list {
    width:min(100%, 310px);
    gap:10px;
}

.panel-project-status .metric-list > span {
    grid-template-columns:auto minmax(0, 1fr) max-content;
    padding:0 4px;
}

.project-status-inline .donut-layout {
    min-height:100%;
    width:min(100%, 440px);
    grid-template-columns:1fr;
    justify-items:center;
    align-content:center;
    justify-self:center;
    gap:14px;
}

.project-status-inline .metric-list {
    width:min(100%, 310px);
    gap:10px;
}

.project-status-inline .metric-list > span {
    grid-template-columns:auto minmax(0, 1fr) max-content;
    padding:0 4px;
}

.panel-issues .donut-layout {
    width:100%;
}

.compact-donut-layout {
    grid-template-columns:112px minmax(0, 1fr);
}

.donut,
.gauge {
    --donut:conic-gradient(#10d58f 0 40%, #1688f5 40% 80%, #fb9a13 80% 100%);
    width:min(170px, 100%);
    aspect-ratio:1;
    margin:0 auto;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:var(--donut);
    box-shadow:0 0 24px rgba(22,136,245,.2);
}

.donut > div,
.gauge > div {
    width:112px;
    aspect-ratio:1;
    border-radius:50%;
    display:grid;
    place-items:center;
    align-content:center;
    background:#111d3b;
    box-shadow:inset 0 0 18px rgba(255,255,255,.08);
}

.donut strong {
    display:block;
    font-size:35px;
    line-height:1;
    font-weight:900;
}

.donut span {
    display:block;
    margin-top:4px;
    color:#f2f7ff;
    font-size:13px;
    font-weight:900;
}

.project-status-chart3d {
    width:min(100%, 300px);
    margin:0 auto;
}

.project-status-chart3d svg {
    width:100%;
    height:auto;
    display:block;
    overflow:visible;
}

.project-status-chart3d-shadow {
    fill:rgba(226,232,255,.14);
    filter:blur(.4px);
}

.project-status-chart3d-depth path {
    opacity:.96;
}


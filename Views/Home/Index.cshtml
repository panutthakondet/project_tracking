    font-size:12px;
}

.panel-time .time-metric-grid b {
    grid-area:value;
    color:var(--pt-chart-panel-contrast, #ffffff);
    font-size:20px;
    line-height:1;
}

.panel-time .time-metric-grid span:nth-child(1) b { color:#86efac; }
.panel-time .time-metric-grid span:nth-child(2) b { color:#60a5fa; }
.panel-time .time-metric-grid span:nth-child(3) b { color:#fbbf24; }
.panel-time .time-metric-grid span:nth-child(4) b { color:var(--pt-chart-danger, #ff385b); }

.panel-time .time-number {
    grid-area:auto;
    width:min(100%, 260px);
    min-height:46px;
    margin:0;
    background:
        radial-gradient(circle at 18% 50%, var(--pt-chart-panel-glow, rgba(255,255,255,.08)), transparent 56%),
        linear-gradient(180deg, var(--pt-chart-panel-row-hover-bg, rgba(255,255,255,.045)), var(--pt-chart-panel-row-bg, rgba(255,255,255,.025)));
    border-color:var(--pt-border, rgba(217,228,251,.12));
}

.time-trend-card,
.time-heatmap-card {
    width:100%;
    min-width:0;
    padding:10px 14px;
    border:1px solid var(--pt-border, rgba(96,165,250,.16));
    border-radius:16px;
    background:
        radial-gradient(circle at 100% 0%, var(--pt-chart-panel-glow, rgba(96,165,250,.16)), transparent 44%),
        linear-gradient(180deg, var(--pt-chart-panel-row-hover-bg, rgba(8,30,66,.68)), var(--pt-chart-panel-row-bg, rgba(4,20,46,.82)));
    box-shadow:inset 0 1px 0 rgba(255,255,255,.04);
}

.time-trend-card {
    grid-area:trend;
}

.time-heatmap-card {
    grid-area:heat;
}

.time-subhead {
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    gap:12px;
    margin-bottom:8px;
}

.time-subhead b {
    color:var(--pt-chart-panel-contrast, #f8fbff);
    font-size:14px;
    font-weight:1000;
}

.time-subhead small {
    color:var(--pt-chart-panel-contrast-muted, #9fb2d2);
    font-size:11px;
    font-weight:900;
}

.time-trend-bars {
    display:grid;
    grid-template-columns:repeat(7, minmax(0, 1fr));
    gap:8px;
    min-height:88px;
    align-items:end;
}

.time-trend-bar {
    min-width:0;
    height:80px;
    display:grid;
    grid-template-rows:1fr auto auto;
    justify-items:center;
    align-items:end;
    gap:4px;
    color:var(--pt-chart-panel-contrast, #dbeafe);
    font-weight:900;
}

.time-trend-bar i {
    width:min(100%, 32px);
    min-height:5px;
    border-radius:999px 999px 6px 6px;
    background:linear-gradient(180deg, #38bdf8, #2563eb);
    box-shadow:0 10px 18px rgba(37,99,235,.18);
}

.time-trend-bar.high i { background:linear-gradient(180deg, #86efac, #22c55e); }
.time-trend-bar.medium i { background:linear-gradient(180deg, #38bdf8, #2563eb); }
.time-trend-bar.low i { background:linear-gradient(180deg, #fbbf24, #f97316); }
.time-trend-bar.today i { background:linear-gradient(180deg, #f0abfc, #8b5cf6); }
.time-trend-bar.empty i { background:rgba(148,163,184,.22); box-shadow:none; }
.time-trend-bar.weekend i,
.time-trend-bar.future i { background:rgba(148,163,184,.14); box-shadow:none; }

.time-trend-bar b {
    color:var(--pt-chart-panel-contrast, #f8fbff);
    font-size:11px;
    line-height:1;
}

.time-trend-bar small {
    color:var(--pt-chart-panel-contrast-muted, #91a5c8);
    font-size:9px;
    line-height:1;
}

.time-heatmap {
    display:grid;
    grid-template-columns:repeat(16, minmax(0, 1fr));
    gap:5px;
}

.time-heat-cell {
    min-width:0;
    height:22px;
    display:grid;
    place-items:center;
    border-radius:7px;
    color:#dbeafe;
    background:rgba(148,163,184,.12);
    border:1px solid rgba(148,163,184,.12);
    font-size:10px;
    font-weight:900;
}

.time-heat-cell.low {
    color:#fff7ed;
    background:linear-gradient(180deg, rgba(251,191,36,.72), rgba(234,88,12,.68));
}

.time-heat-cell.medium {
    color:#ecfeff;
    background:linear-gradient(180deg, rgba(34,211,238,.72), rgba(37,99,235,.68));
}

.time-heat-cell.high {
    color:#f0fdf4;
    background:linear-gradient(180deg, rgba(134,239,172,.78), rgba(22,163,74,.72));
}

.time-heat-cell.open {
    color:#fff7ed;
    background:linear-gradient(180deg, rgba(251,191,36,.82), rgba(249,115,22,.78));
    box-shadow:0 0 14px rgba(251,191,36,.2);
}

.time-heat-cell.future {
    color:rgba(203,213,225,.42);
    background:rgba(148,163,184,.06);
}

.time-heat-cell.weekend {
    color:var(--pt-chart-panel-contrast-muted, rgba(203,213,225,.62));
    background:var(--pt-chart-panel-deep, rgba(148,163,184,.08));
    border-color:var(--pt-border, rgba(148,163,184,.12));
}

.time-heat-cell.today {
    outline:2px solid rgba(255,255,255,.78);
    outline-offset:1px;
}

.panel-time .time-detail-grid {
    grid-template-columns:repeat(6, minmax(0, 1fr));
    gap:0;
    margin-top:14px;
    padding:12px 0 4px;
    border-top:1px solid rgba(96,165,250,.2);
}

/* Keep attendance information in a few clear zones instead of many nested cards. */
.panel-time .time-goal {
    padding:10px 4px 0;
    border:0;
    border-radius:0;
    background:none;
    box-shadow:none;
}

.panel-time .time-metric-grid {
    grid-template-columns:repeat(4, minmax(0, 1fr));
    gap:0;
    padding:10px 0;
    border-top:1px solid rgba(96,165,250,.2);
    border-bottom:1px solid rgba(96,165,250,.2);
}

.panel-time .time-metric-grid span {
    min-height:54px;
    padding:5px 14px;
    border:0;
    border-right:1px solid rgba(96,165,250,.16);
    border-radius:0;
    background:none;
}

.panel-time .time-metric-grid span:last-child { border-right:0; }

.panel-time .time-trend-card,
.panel-time .time-heatmap-card {
    padding:10px 0 4px;
    border:0;
    border-radius:0;
    background:none;
    box-shadow:none;
}

.panel-time .time-heatmap-card {
    padding-top:12px;
    border-top:1px solid rgba(96,165,250,.16);
}

.panel-time .time-detail-grid > span {
    min-height:48px;
    padding:4px 12px;
    border:0;
    border-right:1px solid rgba(96,165,250,.16);
    border-radius:0;
    background:none;
}

.panel-time .time-detail-grid > span:last-child { border-right:0; }
.panel-time .time-detail-icon { width:28px; height:28px; }
.panel-time .time-detail-grid b { font-size:15px; }

@@media (max-width: 1199.98px) {
    .panel-time .time-metric-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    .panel-time .time-metric-grid span:nth-child(2) { border-right:0; }
    .panel-time .time-metric-grid span:nth-child(-n+2) { border-bottom:1px solid rgba(96,165,250,.12); }
    .panel-time .time-detail-grid { grid-template-columns:repeat(3, minmax(0, 1fr)); }
    .panel-time .time-detail-grid > span:nth-child(3) { border-right:0; }
    .panel-time .time-detail-grid > span:nth-child(-n+3) { border-bottom:1px solid rgba(96,165,250,.12); }
}

@@media (max-width: 767.98px) {
    .panel-time .time-detail-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    .panel-time .time-detail-grid > span:nth-child(3) { border-right:1px solid rgba(96,165,250,.16); }
    .panel-time .time-detail-grid > span:nth-child(even) { border-right:0; }
    .panel-time .time-detail-grid > span:nth-child(-n+4) { border-bottom:1px solid rgba(96,165,250,.12); }
}

.time-detail-icon {
    width:38px;
    height:38px;
    display:block;
}

.panel-team .workload-list {

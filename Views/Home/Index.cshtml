}

.yearly-plot::-webkit-scrollbar {
    height:8px;
}

.yearly-plot::-webkit-scrollbar-track {
    background:rgba(15,35,64,.45);
    border-radius:999px;
}

.yearly-plot::-webkit-scrollbar-thumb {
    background:linear-gradient(90deg,#14b8a6,#1688f5);
    border-radius:999px;
}

.yearly-x-title {
    grid-column:2;
    grid-row:2;
    justify-self:center;
    align-self:center;
    color:#a7b9d8;
    font-size:12px;
    font-weight:900;
}

.bar-chart {
    min-width:0;
    width:100%;
    height:238px;
    box-sizing:border-box;
    display:grid;
    grid-template-columns:repeat(12, minmax(0, 1fr));
    align-items:start;
    gap:8px;
    padding:0 10px;
    position:relative;
    background:none;
}

.bar-chart::before {
    content:"";
    position:absolute;
    z-index:0;
    left:0;
    right:0;
    top:42px;
    height:190px;
    border-left:1px solid rgba(217,228,251,.6);
    border-bottom:1px solid rgba(217,228,251,.6);
    background:repeating-linear-gradient(to bottom, rgba(148,163,184,.22) 0 1px, transparent 1px 38px);
    pointer-events:none;
}

.yearly-x-axis {
    min-width:0;
    width:100%;
    display:grid;
    grid-template-columns:repeat(12, minmax(0, 1fr));
    gap:8px;
    padding:6px 10px 0;
    color:#d9e4fb;
    font-size:11px;
    font-weight:900;
    text-align:center;
}

.yearly-x-axis span {
    min-width:0;
    line-height:1;
    white-space:nowrap;
}

.bar-group {
    height:190px;
    margin-top:42px;
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    align-items:end;
    gap:4px;
    position:relative;
    z-index:1;
}

.bar-group span {
    min-height:6px;
    border-radius:6px 6px 2px 2px;
    position:relative;
    display:flex;
    justify-content:center;
    overflow:visible;
    box-shadow:
        0 7px 14px rgba(2,8,23,.26),
        inset 0 1px 0 rgba(255,255,255,.32),
        inset 0 -14px 20px rgba(4,21,49,.18),
        0 0 22px color-mix(in srgb, currentColor 26%, transparent);
}

.bar-group span.is-zero {
    min-height:0;
    box-shadow:none;
}

.bar-group span::before {
    content:"";
    position:absolute;
    pointer-events:none;
}

.bar-group span::before {
    inset:0;
    border-radius:inherit;
    background:linear-gradient(90deg, rgba(255,255,255,.2), transparent 34% 72%, rgba(255,255,255,.08));
    opacity:.58;
}

.bar-group span.is-zero::before {
    content:none;
}

.bar-group span:nth-child(1) {
    color:#19df8b;
    background:linear-gradient(180deg,#22df8b 0%, #10c783 54%, #07866b 100%);
}

.bar-group span:nth-child(2) {
    color:#1aa7ff;
    background:linear-gradient(180deg,#2fc4ff 0%, #1298f3 55%, #0a5fc0 100%);
}

.bar-group span i {
    position:absolute;
    top:-18px;
    left:50%;
    transform:translateX(-50%);
    z-index:2;
    color:currentColor;
    font-size:11px;
    font-style:normal;
    font-weight:900;
    line-height:1;
    text-shadow:0 2px 8px rgba(0,0,0,.72), 0 0 14px color-mix(in srgb, currentColor 34%, transparent);
    pointer-events:none;

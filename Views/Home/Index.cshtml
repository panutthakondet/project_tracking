    font-weight:900;
}

.time-number small {
    display:inline-block;
    margin:0;
    color:#9fb0d0;
    font-size:13px;
    font-weight:900;
    white-space:nowrap;
}

.time-number small.negative { color:#ff385b; }
.time-number small.positive { color:#7dffad; }

.gauge {
    width:min(138px, 100%);
}

.gauge > div {
    width:82px;
    color:#fff;
    font-size:38px;
}

.time-pyramid3d {
    width:min(100%, 240px);
    margin:0 auto;
    justify-self:center;
    align-self:center;
}

.time-pyramid3d svg {
    display:block;
    width:100%;
    height:auto;
    overflow:visible;
}

.time-pyramid-shadow {
    fill:rgba(3,10,28,.22);
    filter:blur(1px);
}

.time-pyramid-layer {
    filter:drop-shadow(0 7px 8px rgba(3,10,28,.15));
}

.time-pyramid-layer polygon {
    stroke:rgba(255,255,255,.16);
    stroke-width:.7;
}

.time-pyramid-layer .top {
    filter:brightness(1.05);
}

.time-pyramid-layer text {
    font-family:'Prompt', sans-serif;
    text-anchor:middle;
    fill:#fff;
    font-size:10px;
    font-weight:800;
    paint-order:stroke;
    stroke:rgba(15,23,42,.24);
    stroke-width:.8px;
}

.layer-total .top { fill:#7561ba; }
.layer-total .left { fill:#6253a5; }
.layer-total .right { fill:#514395; }

.layer-closed .top { fill:#075f78; }
.layer-closed .left { fill:#07506a; }
.layer-closed .right { fill:#04364f; }

.layer-open .top { fill:#8ed967; }
.layer-open .left { fill:#74bd57; }
.layer-open .right { fill:#338246; }

.layer-checkin .left { fill:#58c8d5; }
.layer-checkin .right { fill:#0496b5; }

.layer-total text {
    font-size:11px;
}

.layer-checkin text {
    font-size:9px;
}

.time-pyramid-callouts {
    display:block;
}

.time-pyramid-callouts path {
    fill:none;
    stroke:rgba(217,228,251,.45);
    stroke-width:1;
}

.time-pyramid-callouts text {
    fill:#dbeafe;
    font-family:'Prompt', sans-serif;
    font-size:7px;
    font-weight:600;
}

.metric-card {

}

.time-pill.pink { background:linear-gradient(135deg,#ff2d62,#ff6043); }
.time-pill.purple { background:linear-gradient(135deg,#8b4df4,#5b2fd3); }
.time-pill.blue { background:linear-gradient(135deg,#1688f5,#0ad0c8); }
.time-pill.orange { background:linear-gradient(135deg,#fb9a13,#ff6333); }
.time-pill.green { background:linear-gradient(135deg,#10d58f,#078f6d); }

.avatar-stack {
    display:flex;
    align-items:center;
    justify-content:flex-end;
}

.avatar-stack img,
.workload-row img {

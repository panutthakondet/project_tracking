@model ProjectTracking.ViewModels.HomeDashboardViewModel
@using System.Globalization
@using ProjectTracking.ViewModels

@{
    ViewData["Title"] = "Dashboard";

    var dashboard = Model ?? new HomeDashboardViewModel();
    var closedHoursPercent = dashboard.MonthWorkHours <= 0 ? 0 : Math.Round(dashboard.ClosedWorkHours * 100m / dashboard.MonthWorkHours, 1);
    var openHoursPercent = dashboard.MonthWorkHours <= 0 ? 0 : Math.Round(dashboard.OpenWorkHours * 100m / dashboard.MonthWorkHours, 1);
    var yearlyTaskAxisTicks = new[] { 30, 25, 20, 15, 10, 5, 0 };
    var showYearlyPending = dashboard.YearlyTasks.Any(task => task.Pending > 0);
    var unreadNotificationCount = Convert.ToInt32(ViewBag.UnreadNotificationCount ?? 0);
    var unreadMailboxCount = Convert.ToInt32(ViewBag.UnreadMailboxCount ?? 0);
    var openIssueSupportCount = dashboard.OpenIssueSupportCount;
    var todayIso = DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var onlineUsers = ViewBag.OnlineUsers is IEnumerable<RequirementBoardOnlineUserViewModel> onlineUserRows
        ? onlineUserRows.ToList()
        : new List<RequirementBoardOnlineUserViewModel>();
    var visibleOnlineUsers = onlineUsers.Take(5).ToList();
    var hiddenOnlineCount = Math.Max(0, onlineUsers.Count - visibleOnlineUsers.Count);

    string SvgNumber(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    (double X, double Y) EllipsePoint(double cx, double cy, double rx, double ry, double angle)
    {
        var radians = Math.PI * angle / 180d;
        return (cx + rx * Math.Cos(radians), cy + ry * Math.Sin(radians));
    }

    string DonutSegmentPath(double start, double end, double offsetY = 0)
    {
        const double cx = 130d;
        const double cy = 116d;
        const double outerRx = 92d;
        const double outerRy = 45d;
        const double innerRx = 52d;
        const double innerRy = 25d;

        var outerStart = EllipsePoint(cx, cy + offsetY, outerRx, outerRy, start);
        var outerEnd = EllipsePoint(cx, cy + offsetY, outerRx, outerRy, end);
        var innerEnd = EllipsePoint(cx, cy + offsetY, innerRx, innerRy, end);
        var innerStart = EllipsePoint(cx, cy + offsetY, innerRx, innerRy, start);
        var largeArc = Math.Abs(end - start) > 180d ? 1 : 0;

        return string.Join(" ", new[]
        {
            $"M {SvgNumber(outerStart.X)} {SvgNumber(outerStart.Y)}",
            $"A {outerRx} {outerRy} 0 {largeArc} 1 {SvgNumber(outerEnd.X)} {SvgNumber(outerEnd.Y)}",
            $"L {SvgNumber(innerEnd.X)} {SvgNumber(innerEnd.Y)}",
            $"A {innerRx} {innerRy} 0 {largeArc} 0 {SvgNumber(innerStart.X)} {SvgNumber(innerStart.Y)}",
            "Z"
        });
    }

    string StatusHex(string color) => color switch
    {
        "green" => "#7bdc49",
        "blue" => "#2693f4",
        "orange" => "#ffb23d",
        "purple" => "#9b5bf2",
        "violet" => "#a855f7",
        "pink" => "#f55262",
        "warning" => "#f59e0b",
        "info" => "#22c7f5",
        "success" => "#10d58f",
        "primary" => "#3b82f6",
        "danger" => "#ef4444",
        "dark" => "#64748b",
        "secondary" => "#94a3b8",
        "muted" => "#64748b",
        _ => "#45d6c6"
    };

    string StatusDarkHex(string color) => color switch
    {
        "green" => "#4eaa2f",
        "blue" => "#1269b8",
        "orange" => "#ef8700",
        "purple" => "#6733b8",
        "violet" => "#6d28d9",
        "pink" => "#c92d3d",
        "warning" => "#b76a00",
        "info" => "#0e8fbd",
        "success" => "#07845f",
        "primary" => "#1d4ed8",
        "danger" => "#b91c1c",
        "dark" => "#334155",
        "secondary" => "#64748b",
        "muted" => "#334155",
        _ => "#159b91"
    };

    string PieSegmentPath(double start, double end, double offsetY = 0)
    {
        const double cx = 78d;
        const double cy = 66d;
        const double rx = 64d;
        const double ry = 31d;

        var outerStart = EllipsePoint(cx, cy + offsetY, rx, ry, start);
        var outerEnd = EllipsePoint(cx, cy + offsetY, rx, ry, end);
        var largeArc = Math.Abs(end - start) > 180d ? 1 : 0;

        return string.Join(" ", new[]
        {
            $"M {SvgNumber(cx)} {SvgNumber(cy + offsetY)}",
            $"L {SvgNumber(outerStart.X)} {SvgNumber(outerStart.Y)}",
            $"A {rx} {ry} 0 {largeArc} 1 {SvgNumber(outerEnd.X)} {SvgNumber(outerEnd.Y)}",
            "Z"
        });
    }

    List<(HomeDashboardMetric Metric, string Fill, string DarkFill, string TopPath, string BottomPath, double LabelX, double LabelY)> BuildOverviewPieSegments(IReadOnlyList<HomeDashboardMetric> metrics)
    {
        var visibleMetrics = metrics.Where(metric => metric.Count > 0).ToList();
        var result = new List<(HomeDashboardMetric Metric, string Fill, string DarkFill, string TopPath, string BottomPath, double LabelX, double LabelY)>();
        if (visibleMetrics.Count == 0)
        {
            return result;
        }

        var total = Math.Max(1, visibleMetrics.Sum(metric => metric.Count));
        var startAngle = -176d;
        const double totalAngle = 352d;
        const double gapAngle = 1.8d;

        foreach (var metric in visibleMetrics)
        {
            var rawSpan = (double)metric.Count / total * totalAngle;
            var span = visibleMetrics.Count == 1 ? totalAngle : Math.Max(8d, rawSpan - gapAngle);
            var start = startAngle;
            var end = startAngle + span;
            var mid = (start + end) / 2d;
            var label = EllipsePoint(78d, 66d, 74d, 41d, mid);

            result.Add((
                metric,
                StatusHex(metric.Color),
                StatusDarkHex(metric.Color),
                PieSegmentPath(start, end),
                PieSegmentPath(start, end, 16d),
                Math.Clamp(label.X, 18d, 142d),
                Math.Clamp(label.Y - 6d, 18d, 108d)
            ));
            startAngle += rawSpan;
        }

        return result;
    }

    var issueOverviewSegments = BuildOverviewPieSegments(dashboard.IssueMetrics);
    var supportOverviewSegments = BuildOverviewPieSegments(dashboard.SupportMetrics);
    var issueOverviewLegend = dashboard.IssueMetrics;
    var supportOverviewLegend = dashboard.SupportMetrics;
    var timeTrackingMetrics = new List<HomeDashboardMetric>
    {
        new()
        {
            Label = "บันทึกครบ",
            Count = (int)Math.Round(dashboard.ClosedWorkHours),
            Percent = closedHoursPercent,
            Color = "green",
            HexColor = StatusHex("green")
        },
        new()
        {
            Label = "ยังไม่ออกงาน",
            Count = (int)Math.Round(dashboard.OpenWorkHours),
            Percent = openHoursPercent,
            Color = "blue",
            HexColor = StatusHex("blue")
        }
    };
    var timeTrackingSegments = BuildOverviewPieSegments(timeTrackingMetrics);
    var projectStatusSegments = new List<(HomeDashboardMetric Metric, string Fill, string DarkFill, string TopPath, string BottomPath, double PinX, double PinY, double LabelX, double LabelY)>();
    var statusMetricsForChart = dashboard.ProjectStatusMetrics.Where(metric => metric.Count > 0).ToList();
    var statusTotalForChart = Math.Max(1, statusMetricsForChart.Sum(metric => metric.Count));
    var statusStartAngle = -168d;
    const double statusTotalAngle = 338d;
    const double statusGapAngle = 2.2d;

    for (var i = 0; i < statusMetricsForChart.Count; i++)
    {
        var metric = statusMetricsForChart[i];
        var rawSpan = (double)metric.Count / statusTotalForChart * statusTotalAngle;
        var span = statusMetricsForChart.Count == 1 ? statusTotalAngle : Math.Max(8d, rawSpan - statusGapAngle);
        var start = statusStartAngle;
        var end = statusStartAngle + span;
        var mid = (start + end) / 2d;
        var pin = EllipsePoint(130d, 116d, 78d, 38d, mid);
        var label = EllipsePoint(130d, 116d, 112d, 55d, mid);
        projectStatusSegments.Add((
            metric,
            StatusHex(metric.Color),
            StatusDarkHex(metric.Color),
            DonutSegmentPath(start, end),
            DonutSegmentPath(start, end, 18d),
            pin.X,
            pin.Y,
            label.X,
            Math.Max(26d, label.Y - 34d)
        ));
        statusStartAngle += rawSpan;
    }
}

<div class="dashboard-view">
    <section class="dashboard-global-searchbar" aria-label="ค้นหารวมใน Dashboard">
        <div class="dashboard-global-search"
             data-dashboard-search
             data-dashboard-search-url="@Url.Action("DashboardSearch", "Home")">
            <span class="dashboard-global-search-icon" aria-hidden="true">⌕</span>
            <input type="search"
                   id="dashboardGlobalSearch"
                   placeholder="ค้นหาโครงการ งวดงาน Assign Issue Support..."
                   autocomplete="off"
                   aria-label="ค้นหา Projects, ProjectPhases, PhaseAssigns, ProjectIssues, SupportOrders" />
            <button type="button"
                    class="dashboard-global-search-clear"
                    data-dashboard-search-clear
                    aria-label="ล้างคำค้น"
                    hidden>×</button>
            <div class="dashboard-global-search-results"
                 data-dashboard-search-results
                 hidden></div>
        </div>
        @if (visibleOnlineUsers.Count > 0)
        {
            <div class="dashboard-online-users" aria-label="ผู้ใช้งานออนไลน์">
                @foreach (var user in visibleOnlineUsers)
                {
                    <span class="dashboard-online-avatar @user.ColorClass"
                          title="@user.DisplayName">
                        <img src="@user.AvatarPath"
                             alt="@user.DisplayName"
                             onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                    </span>
                }
                @if (hiddenOnlineCount > 0)
                {
                    <span class="dashboard-online-more">+@hiddenOnlineCount</span>
                }
            </div>
        }
        <div class="dashboard-global-tools" aria-label="แจ้งเตือนและกล่องจดหมาย">
            <a class="dashboard-global-tool open-work"
               asp-controller="OpenWork"
               asp-action="Index"
               title="Issue และ Support ที่ยังเปิดอยู่"
               aria-label="Issue และ Support ที่ยังเปิดอยู่">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 4h6" />
                    <path d="M10 2h4a2 2 0 0 1 2 2v2H8V4a2 2 0 0 1 2-2Z" />
                    <path d="M8 4H6a2 2 0 0 0-2 2v16h16V6a2 2 0 0 0-2-2h-2" />
                    <path d="M8 11h8" />
                    <path d="M8 16h5" />
                </svg>
                <span class="dashboard-global-tool-count @(openIssueSupportCount == 0 ? "is-empty" : "")">@openIssueSupportCount</span>
            </a>
            <a class="dashboard-global-tool notification"
               asp-controller="Notifications"
               asp-action="Index"
               title="แจ้งเตือนงาน"
               aria-label="แจ้งเตือนงาน">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 8-3 8h18s-3-1-3-8" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                </svg>
                <span class="dashboard-global-tool-count @(unreadNotificationCount == 0 ? "is-empty" : "")">@unreadNotificationCount</span>
            </a>
            <a class="dashboard-global-tool mailbox"
               asp-controller="Mailbox"
               asp-action="Index"
               title="กล่องจดหมาย"
               aria-label="กล่องจดหมาย">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 6h16v12H4z" />
                    <path d="m4 7 8 6 8-6" />
                </svg>
                <span class="dashboard-global-tool-count @(unreadMailboxCount == 0 ? "is-empty" : "")">@unreadMailboxCount</span>
            </a>
        </div>
    </section>

    <section class="kpi-grid" aria-label="ตัวชี้วัดหลัก">
        <a class="kpi-card kpi-blue"
           asp-controller="Projects"
           asp-action="ViewOnly"
           title="เปิดรายงาน Projects">
            <span class="kpi-icon" aria-hidden="true">□</span>
            <div>
                <p>Total Projects</p>
                <strong>@dashboard.TotalProjectCount</strong>
                <small>@dashboard.TotalProjectsNote</small>
            </div>
        </a>
        <a class="kpi-card kpi-purple"
           asp-controller="Meetings"
           asp-action="ViewOnly"
           asp-route-fromDate="@todayIso"
           asp-route-toDate="@todayIso"
           title="เปิดรายงาน Meetings วันนี้">
            <span class="kpi-icon" aria-hidden="true">▦</span>
            <div>
                <p>Meetings Today</p>
                <strong>@dashboard.MeetingsTodayCount</strong>
                <small>@dashboard.MeetingsTodayNote</small>
            </div>
        </a>
        <a class="kpi-card kpi-orange"
           asp-controller="ProjectPhases"
           asp-action="ViewOnly"
           asp-route-phaseStatus="DELAY"
           title="เปิดรายงาน ProjectPhases ล่าช้า">
            <span class="kpi-icon" aria-hidden="true">!</span>
            <div>
                <p>ProjectPhases</p>
                <strong>@dashboard.OpenIssueCount</strong>
                <small>@dashboard.OpenIssuesNote</small>
            </div>
        </a>
        <a class="kpi-card kpi-pink"
           asp-controller="PhaseAssigns"
           asp-action="ViewOnly"
           asp-route-workStatus="DELAY"
           title="เปิดรายงาน PhaseAssigns ล่าช้า">
            <span class="kpi-icon" aria-hidden="true">⏱</span>
            <div>
                <p>PhaseAssigns</p>
                <strong>@dashboard.OverdueTaskCount</strong>
                <small>@dashboard.OverdueTasksNote</small>
            </div>
        </a>
    </section>

    <section class="dashboard-grid" aria-label="ภาพรวม dashboard">
        <article class="glass-panel panel-wide panel-project-overview">
            <div class="panel-head">
                <div class="project-overview-title-row">
                    <h2>ภาพรวมโครงการ (Projects Overview)</h2>
                    <span aria-hidden="true"></span>
                    <h3>สถานะโครงการ</h3>
                </div>
                <div class="panel-actions">
                    <a asp-controller="Projects" asp-action="ViewOnly" class="panel-filter compact">รายละเอียด</a>
                    <a asp-controller="ProjectStatus" asp-action="Index" class="panel-filter compact">ทีมงานพัฒนา</a>
                </div>
            </div>
            <div class="project-overview-combined">
                <div class="project-overview-table">
                    <label class="project-overview-search">
                        <span>ค้นหาโครงการ</span>
                        <input type="search"
                               id="projectOverviewSearch"
                               placeholder="พิมพ์ชื่อโครงการ..."
                               autocomplete="off" />
                    </label>
                    <div class="project-overview-head" aria-hidden="true">
                        <span>Project</span>
                        <span>Status</span>
                        <span>Start</span>
                        <span>End</span>
                    </div>
                    <div class="project-overview-scroll" data-project-count="@dashboard.ProjectOverviewProjects.Count">
                        @if (dashboard.ProjectOverviewProjects.Count == 0)
                        {
                            <p class="empty-state">ยังไม่มีข้อมูลโครงการ</p>
                        }
                        else
                        {
                            foreach (var project in dashboard.ProjectOverviewProjects)
                            {
                                var projectSearchText = $"{project.ProjectName} {project.StatusText} {project.StartText} {project.EndText}";
                                <a class="project-overview-row"
                                   asp-controller="ProjectPhases"
                                   asp-action="Index"
                                   asp-route-projectId="@project.ProjectId"
                                   data-project-search="@projectSearchText"
                                    title="ดูงวดงานของ @project.ProjectName">
                                    <span class="project-overview-name" title="@project.ProjectName">@project.ProjectName</span>
                                    <span class="project-overview-status @project.StatusColor">@project.StatusText</span>
                                    <span class="project-overview-date">
                                        <span class="project-overview-mobile-label">Start</span>
                                        <time>@project.StartText</time>
                                    </span>
                                    <span class="project-overview-date">
                                        <span class="project-overview-mobile-label">End</span>
                                        <time>@project.EndText</time>
                                    </span>
                                </a>
                            }
                            <p class="empty-state project-overview-empty" hidden>ไม่พบโครงการที่ค้นหา</p>
                        }
                    </div>
                </div>
                <div class="project-status-inline" aria-label="สถานะโครงการ">
                    <div class="donut-layout">
                        <figure class="project-status-chart3d" aria-label="กราฟสถานะโครงการแบบสามมิติ">
                            <svg viewBox="0 0 260 210" role="img" aria-labelledby="projectStatusChartTitle">
                                <title id="projectStatusChartTitle">สถานะโครงการทั้งหมด @dashboard.TotalProjectCount โครงการ</title>
                                <ellipse class="project-status-chart3d-shadow" cx="104" cy="159" rx="92" ry="26"></ellipse>
                                <g class="project-status-chart3d-depth">
                                    @foreach (var segment in projectStatusSegments)
                                    {
                                        <path d="@segment.BottomPath" fill="@segment.DarkFill"></path>
                                    }
                                </g>
                                <g class="project-status-chart3d-top">
                                    @foreach (var segment in projectStatusSegments)
                                    {
                                        <path d="@segment.TopPath" fill="@segment.Fill"></path>
                                    }
                                </g>
                                <ellipse class="project-status-chart3d-hole" cx="130" cy="116" rx="50" ry="24"></ellipse>
                                @Html.Raw($"<text class=\"project-status-chart3d-total\" x=\"130\" y=\"111\">{dashboard.TotalProjectCount}</text>")
                                @Html.Raw("<text class=\"project-status-chart3d-caption\" x=\"130\" y=\"131\">โครงการ</text>")
                                <g class="project-status-chart3d-pins">
                                    @foreach (var segment in projectStatusSegments)
                                    {
                                        <line x1="@SvgNumber(segment.PinX)" y1="@SvgNumber(segment.PinY)" x2="@SvgNumber(segment.LabelX)" y2="@SvgNumber(segment.LabelY + 17)" stroke="@segment.DarkFill"></line>
                                        <ellipse cx="@SvgNumber(segment.LabelX)" cy="@SvgNumber(segment.LabelY)" rx="24" ry="18" fill="@segment.Fill" stroke="@segment.DarkFill"></ellipse>
                                        @Html.Raw($"<text x=\"{SvgNumber(segment.LabelX)}\" y=\"{SvgNumber(segment.LabelY + 6)}\">{segment.Metric.Percent.ToString("0.#", CultureInfo.InvariantCulture)}%</text>")
                                    }
                                </g>
                            </svg>
                        </figure>
                        <div class="metric-list">
                            @foreach (var metric in dashboard.ProjectStatusMetrics)
                            {
                                <span><i class="dot @metric.Color"></i><span class="metric-name">@metric.Label</span><b>@metric.CountPercentText</b></span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </article>

        <article class="glass-panel side-panel panel-activity">
            <div class="panel-head">
                <h2>กิจกรรมล่าสุด (Recent Activity)</h2>
                <a asp-controller="Home" asp-action="Activities" class="panel-link">ดูทั้งหมด</a>
            </div>
            <div class="activity-list">
                @if (dashboard.RecentActivities.Count == 0)
                {
                    <p class="empty-state">ยังไม่มีกิจกรรมล่าสุด</p>
                }
                else
                {
                    foreach (var activity in dashboard.RecentActivities)
                    {
                        <a class="activity-row @activity.Color" href="@(string.IsNullOrWhiteSpace(activity.Url) ? Url.Action("Activities", "Home") : activity.Url)">
                            <img class="activity-avatar"
                                 src="@activity.AvatarPath"
                                 alt=""
                                 onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                            <span>
                                <b>@activity.Actor</b>
                                <small>@activity.Detail</small>
                                @if (!string.IsNullOrWhiteSpace(activity.OwnerText))
                                {
                                    <em>@activity.OwnerText</em>
                                }
                            </span>
                            <time>@activity.TimeText</time>
                        </a>
                    }
                }
            </div>
        </article>

        <article class="glass-panel compact-panel panel-issues">
            <div class="panel-head">
                <h2>Issues &amp; Support Overview</h2>
            </div>
            <div class="overview-pair">
                <section class="overview-mini" aria-label="Issues Overview">
                    <div class="overview-mini-head">
                        <h3>Issues Overview</h3>
                        <a asp-controller="ProjectIssues" asp-action="ViewOnly" class="panel-filter compact">รายละเอียด</a>
                    </div>
                    <div class="donut-layout compact-donut-layout overview-pie-layout">
                        <figure class="overview-pie3d" aria-label="กราฟ Issues แบบสามมิติ">
                            <svg viewBox="0 0 160 126" role="img" aria-labelledby="issueOverviewPieTitle">
                                <title id="issueOverviewPieTitle">Issues ทั้งหมด @dashboard.IssueTotal รายการ</title>
                                <ellipse class="overview-pie3d-shadow" cx="70" cy="99" rx="58" ry="16"></ellipse>
                                <g class="overview-pie3d-depth">
                                    @foreach (var segment in issueOverviewSegments)
                                    {
                                        <path d="@segment.BottomPath" fill="@segment.DarkFill"></path>
                                    }
                                </g>
                                <g class="overview-pie3d-top">
                                    @foreach (var segment in issueOverviewSegments)
                                    {
                                        <path d="@segment.TopPath" fill="@segment.Fill"></path>
                                    }
                                </g>
                                <ellipse class="overview-pie3d-center" cx="78" cy="66" rx="28" ry="13"></ellipse>
                                @Html.Raw($"<text class=\"overview-pie3d-total\" x=\"78\" y=\"64\">{dashboard.IssueTotal}</text>")
                                @Html.Raw("<text class=\"overview-pie3d-caption\" x=\"78\" y=\"78\">Issues</text>")
                            </svg>
                        </figure>
                        <div class="metric-list slim">
                            @foreach (var metric in issueOverviewLegend)
                            {
                                <span><i class="dot @metric.Color"></i><span class="metric-name">@metric.Label</span><b>@metric.CountPercentText</b></span>
                            }
                        </div>
                    </div>
                </section>
                <section class="overview-mini" aria-label="Support Overview">
                    <div class="overview-mini-head">
                        <h3>Support Overview</h3>
                        <a asp-controller="SupportOrders" asp-action="ViewOnly" class="panel-filter compact">รายละเอียด</a>
                    </div>
                    <div class="donut-layout compact-donut-layout overview-pie-layout">
                        <figure class="overview-pie3d" aria-label="กราฟ Support แบบสามมิติ">
                            <svg viewBox="0 0 160 126" role="img" aria-labelledby="supportOverviewPieTitle">
                                <title id="supportOverviewPieTitle">Support ทั้งหมด @dashboard.SupportTotal รายการ</title>
                                <ellipse class="overview-pie3d-shadow" cx="70" cy="99" rx="58" ry="16"></ellipse>
                                <g class="overview-pie3d-depth">
                                    @foreach (var segment in supportOverviewSegments)
                                    {
                                        <path d="@segment.BottomPath" fill="@segment.DarkFill"></path>
                                    }
                                </g>
                                <g class="overview-pie3d-top">
                                    @foreach (var segment in supportOverviewSegments)
                                    {
                                        <path d="@segment.TopPath" fill="@segment.Fill"></path>
                                    }
                                </g>
                                <ellipse class="overview-pie3d-center" cx="78" cy="66" rx="28" ry="13"></ellipse>
                                @Html.Raw($"<text class=\"overview-pie3d-total\" x=\"78\" y=\"64\">{dashboard.SupportTotal}</text>")
                                @Html.Raw("<text class=\"overview-pie3d-caption\" x=\"78\" y=\"78\">Support</text>")
                            </svg>
                        </figure>
                        <div class="metric-list slim">
                            @foreach (var metric in supportOverviewLegend)
                            {
                                <span><i class="dot @metric.Color"></i><span class="metric-name">@metric.Label</span><b>@metric.CountPercentText</b></span>
                            }
                        </div>
                    </div>
                </section>
            </div>
        </article>

        <article class="glass-panel side-panel compact-panel panel-meetings">
            <div class="panel-head">
                <h2>ปฏิทินการประชุมวันนี้</h2>
                <a asp-controller="Meetings" asp-action="Index" class="panel-link">ดูทั้งหมด</a>
            </div>
            <div class="meeting-list">
                @if (dashboard.TodayMeetings.Count == 0)
                {
                    <p class="empty-state">วันนี้ยังไม่มีประชุม</p>
                }
                else
                {
                    foreach (var meeting in dashboard.TodayMeetings)
                    {
                        <a class="meeting-row" asp-controller="Meetings" asp-action="Show" asp-route-id="@meeting.Id" title="ดูรายละเอียดประชุม @meeting.Title">
                            <time class="time-pill @meeting.TimeColor">@Html.Raw(meeting.TimeText)</time>
                            <span><b>@meeting.Title</b><small>@meeting.Detail</small></span>
                            <span class="avatar-stack">
                                <img src="@meeting.AvatarPath" alt="" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                <i>+@meeting.AttendeeCount</i>
                            </span>
                        </a>
                    }
                }
            </div>
        </article>

        <article class="glass-panel panel-task">
            <div class="panel-head">
                <h2>Task Progress (รายปี)</h2>
                <div class="panel-actions">
                    <div class="legend-row compact">
                        <span><i class="dot green"></i>Completed</span>
                        <span><i class="dot blue"></i>In Progress</span>
                        @if (showYearlyPending)
                        {
                            <span><i class="dot orange"></i>Pending</span>
                        }
                    </div>
                    <a asp-controller="Reports" asp-action="TaskProgress" class="panel-link">รายละเอียด</a>
                </div>
            </div>
            <div class="yearly-chart">
                <span class="yearly-y-title">จำนวนงาน</span>
                <div class="yearly-y-axis" aria-hidden="true">
                    @foreach (var tick in yearlyTaskAxisTicks)
                    {
                        var tickTop = (30 - tick) * 100m / 30m;
                        <span style="top:@tickTop.ToString("0.###", CultureInfo.InvariantCulture)%">@tick</span>
                    }
                </div>
                <div class="yearly-plot">
                    <div class="bar-chart">
                        @foreach (var task in dashboard.YearlyTasks)
                        {
                            <div class="bar-group">
                                <span class="@(task.CompletedHeight == 0 ? "is-zero" : "")"
                                      style="height:@task.CompletedHeight%"
                                      title="Completed: @task.Completed">
                                    @if (task.Completed > 0)
                                    {
                                        <i>@task.Completed</i>
                                    }
                                </span>
                                <span class="@(task.InProgressHeight == 0 ? "is-zero" : "")"
                                      style="height:@task.InProgressHeight%"
                                      title="In Progress: @task.InProgress">
                                    @if (task.InProgress > 0)
                                    {
                                        <i>@task.InProgress</i>
                                    }
                                </span>
                                @if (showYearlyPending)
                                {
                                    <span class="@(task.PendingHeight == 0 ? "is-zero" : "")"
                                          style="height:@task.PendingHeight%"
                                          title="Pending: @task.Pending">
                                        @if (task.Pending > 0)
                                        {
                                            <i>@task.Pending</i>
                                        }
                                    </span>
                                }
                            </div>
                        }
                    </div>
                    <div class="yearly-x-axis" aria-hidden="true">
                        @foreach (var task in dashboard.YearlyTasks)
                        {
                            <span>@task.PeriodLabel</span>
                        }
                    </div>
                </div>
                <span class="yearly-x-title">เดือน</span>
            </div>
        </article>

        <article class="glass-panel panel-watch">
            <div class="panel-head">
                <h2>โครงการที่ต้องเฝ้าระวัง</h2>
                <div class="panel-actions">
                    <a asp-controller="PhaseWorkload" asp-action="Index" class="panel-link">ดูสถานะงาน</a>
                    <a asp-controller="Reports" asp-action="Executive" class="panel-link">รายละเอียด</a>
                </div>
            </div>
            <div class="watch-list">
                @if (dashboard.WatchProjects.Count == 0)
                {
                    <p class="empty-state">ยังไม่มีโครงการที่เข้าเงื่อนไขเสี่ยง</p>
                }
                else
                {
                    foreach (var project in dashboard.WatchProjects)
                    {
                        <a class="watch-row @project.RiskColor"
                           asp-controller="ProjectPhases"
                           asp-action="Index"
                           asp-route-projectId="@project.ProjectId"
                           title="ดูงวดงานของ @project.ProjectName">
                            <span class="watch-main">
                                <b>@project.ProjectName</b>
                                <span class="watch-meta">
                                    <small>เจ้าของ: @project.OwnerName</small>
                                    <small>@project.DueText</small>
                                    <i class="risk-pill @project.RiskColor">@project.RiskLevel</i>
                                </span>
                            </span>
                            <span class="watch-progress">
                                <span class="energy-tube @project.RiskColor" title="Progress: @project.Progress%">
                                    <i style="height:calc(@project.Progress% * .78)"></i>
                                    <em>@project.Progress%</em>
                                </span>
                            </span>
                            <span class="watch-reasons">
                                @foreach (var reason in project.Reasons)
                                {
                                    <i>@reason</i>
                                }
                            </span>
                        </a>
                    }
                }
            </div>
        </article>

        <article class="glass-panel panel-time">
            <div class="panel-head">
                <h2>Time Tracking (ชั่วโมงทำงาน)</h2>
                <a asp-controller="Attendance" asp-action="Map" class="panel-link">ดูรายละเอียด</a>
            </div>
            <div class="time-layout">
                <div class="time-number">
                    <strong>@dashboard.MonthWorkHours.ToString("0.#")</strong>
                    <span>ชั่วโมง</span>
                    <small class="@dashboard.WorkHourTrendClass">@dashboard.WorkHourTrendText</small>
                </div>
                <figure class="time-donut3d" aria-label="กราฟ Time Tracking แบบสามมิติ">
                    <svg viewBox="0 0 160 126" role="img" aria-labelledby="timeTrackingChartTitle">
                        <title id="timeTrackingChartTitle">Time Tracking รวม @dashboard.MonthWorkHours.ToString("0.#") ชั่วโมง</title>
                        <ellipse class="time-donut3d-shadow" cx="72" cy="99" rx="58" ry="16"></ellipse>
                        <g class="time-donut3d-depth">
                            @foreach (var segment in timeTrackingSegments)
                            {
                                <path d="@segment.BottomPath" fill="@segment.DarkFill"></path>
                            }
                        </g>
                        <g class="time-donut3d-top">
                            @foreach (var segment in timeTrackingSegments)
                            {
                                <path d="@segment.TopPath" fill="@segment.Fill"></path>
                            }
                        </g>
                        <ellipse class="time-donut3d-hole" cx="78" cy="66" rx="28" ry="14"></ellipse>
                        @Html.Raw($"<text class=\"time-donut3d-total\" x=\"78\" y=\"64\">{dashboard.MonthWorkHours.ToString("0.#", CultureInfo.InvariantCulture)}</text>")
                        @Html.Raw("<text class=\"time-donut3d-caption\" x=\"78\" y=\"78\">ชม.</text>")
                    </svg>
                </figure>
                <div class="metric-card">
                    <span><i class="dot green"></i>บันทึกครบ <b>@dashboard.ClosedWorkHours.ToString("0.#") (@closedHoursPercent.ToString("0.#")%)</b></span>
                    <span><i class="dot blue"></i>ยังไม่ออกงาน <b>@dashboard.OpenWorkHours.ToString("0.#") (@openHoursPercent.ToString("0.#")%)</b></span>
                </div>
            </div>
            <div class="time-detail-grid">
                <span><small>เข้างานวันนี้</small><b>@dashboard.TodayCheckinCount คน</b></span>
                <span><small>ออกงานแล้ว</small><b>@dashboard.TodayCheckoutCount คน</b></span>
                <span><small>ยังไม่ออกงาน</small><b>@dashboard.PendingCheckoutCount คน</b></span>
                <span><small>ยังไม่เข้างาน</small><b>@dashboard.TodayMissingCheckinCount คน</b></span>
                <span><small>วันที่มีบันทึก</small><b>@dashboard.MonthAttendanceDays วัน</b></span>
                <span><small>เฉลี่ยต่อวัน</small><b>@dashboard.AverageHoursPerDay.ToString("0.#") ชม.</b></span>
                <span><small>เกิน 12 ชม.</small><b>@dashboard.LongShiftCount ครั้ง</b></span>
                <span><small>ระยะเกิน 5 กม.</small><b>@dashboard.LongDistanceCount ครั้ง</b></span>
            </div>
        </article>

        <article class="glass-panel side-panel panel-team">
            <div class="panel-head">
                <h2>ทีมงานที่ทำงานหนักที่สุด</h2>
                <a asp-controller="PhaseStatusReport" asp-action="Index" class="panel-link">ดูทั้งหมด</a>
            </div>
            <div class="workload-list">
                @if (dashboard.TeamWorkload.Count == 0)
                {
                    <p class="empty-state">ยังไม่มีงานที่กำลังดำเนินการ</p>
                }
                else
                {
                    foreach (var member in dashboard.TeamWorkload)
                    {
                        <a class="workload-row"
                           asp-controller="PhaseStatusReport"
                           asp-action="Index"
                           asp-route-empName="@member.Name"
                           title="ดูรายงานสถานะงานของ @member.Name">
                            <img src="@member.AvatarPath" alt="" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                            <span>@member.Name</span>
                            <div class="progress-track"><i class="@member.Color" style="width:@member.Value%"></i></div>
                            <b>@member.Value%</b>
                        </a>
                    }
                }
            </div>
        </article>
    </section>

    <footer class="dashboard-footer">
        © 2026 <strong>#C</strong> By <strong>SO-AT SOLUTION</strong>
    </footer>
</div>

<style>
.dashboard-view {
    --panel:#111f3c;
    min-height:100vh;
    padding:8px 10px 26px;
    background:
        radial-gradient(circle at 18% 16%, rgba(34,211,238,.18), transparent 26%),
        radial-gradient(circle at 78% 24%, rgba(244,63,94,.12), transparent 24%),
        linear-gradient(180deg, #edf4fb 0%, #e7eff8 100%);
}

.dashboard-view,
.dashboard-view * {
    box-sizing:border-box;
}

.floating-tools-wrapper {
    display:none !important;
}

.dashboard-global-searchbar {
    position:relative;
    z-index:20;
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:10px;
    margin:0 0 14px;
}

.dashboard-global-search {
    position:relative;
    width:min(500px, 100%);
}

.dashboard-global-search input {
    width:100%;
    height:50px;
    border:1px solid rgba(33,150,243,.22);
    border-radius:999px;
    outline:0;
    padding:0 52px 0 56px;
    color:#0f1f3d;
    background:rgba(255,255,255,.86);
    box-shadow:0 16px 34px rgba(15,23,42,.10), inset 0 1px 0 rgba(255,255,255,.85);
    font-size:15px;
    font-weight:900;
    transition:border-color .18s ease, box-shadow .18s ease, background .18s ease;
}

.dashboard-global-search input::-webkit-search-cancel-button {
    display:none;
}

.dashboard-global-search input:focus {
    border-color:rgba(20,184,166,.72);
    background:#fff;
    box-shadow:0 18px 40px rgba(20,184,166,.18), 0 0 0 4px rgba(20,184,166,.14);
}

.dashboard-global-search-icon {
    position:absolute;
    left:14px;
    top:50%;
    z-index:2;
    width:36px;
    height:36px;
    border-radius:50%;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    background:linear-gradient(135deg,#25d6d0,#087b73);
    font-size:25px;
    font-weight:900;
    transform:translateY(-50%);
    box-shadow:0 10px 22px rgba(20,184,166,.24);
}

.dashboard-global-search-clear {
    position:absolute;
    right:8px;
    top:50%;
    z-index:2;
    width:36px;
    height:36px;
    border:0;
    border-radius:50%;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    color:#5d6b84;
    background:rgba(226,232,240,.9);
    font-size:22px;
    line-height:1;
    font-weight:900;
    cursor:pointer;
}

.dashboard-global-search-clear:hover {
    color:#0f172a;
    background:#e2e8f0;
}

.dashboard-online-users {
    display:flex;
    align-items:center;
    flex:0 0 auto;
    gap:0;
    padding:5px 8px;
    min-height:48px;
    border-radius:999px;
    background:rgba(255,255,255,.52);
    border:1px solid rgba(255,255,255,.55);
    box-shadow:0 14px 30px rgba(15,23,42,.12), inset 0 1px 0 rgba(255,255,255,.65);
}

.dashboard-online-avatar {
    position:relative;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:40px;
    height:40px;
    margin-left:-7px;
    border:2px solid rgba(255,255,255,.86);
    border-radius:50%;
    overflow:hidden;
    color:#10213a;
    background:#f59e0b;
    box-shadow:0 7px 16px rgba(15,39,70,.20);
}

.dashboard-online-avatar:first-child {
    margin-left:0;
}

.dashboard-online-avatar img {
    width:100%;
    height:100%;
    object-fit:cover;
}

.dashboard-online-avatar::after {
    content:"";
    position:absolute;
    right:1px;
    bottom:1px;
    width:9px;
    height:9px;
    border:2px solid #fff;
    border-radius:999px;
    background:#22c55e;
}

.dashboard-online-avatar.c1 { background:#f59e0b; }
.dashboard-online-avatar.c2 { background:#059669; }
.dashboard-online-avatar.c3 { background:#ea580c; }
.dashboard-online-avatar.c4 { background:#2563eb; }
.dashboard-online-avatar.c5 { background:#111827; }

.dashboard-online-more {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-width:34px;
    height:38px;
    padding:0 7px;
    color:#0f2a45;
    font-size:14px;
    font-weight:1000;
}

.dashboard-global-tools {
    position:relative;
    display:flex;
    align-items:center;
    gap:9px;
    flex:0 0 auto;
}

.dashboard-global-tool {
    position:relative;
    width:46px;
    height:46px;
    border-radius:50%;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    text-decoration:none;
    border:1px solid rgba(255,255,255,.45);
    box-shadow:0 14px 28px rgba(15,23,42,.15), inset 0 1px 0 rgba(255,255,255,.35);
    transition:transform .18s ease, box-shadow .18s ease, filter .18s ease;
    padding:0;
    cursor:pointer;
    font:inherit;
}

.dashboard-global-tool:hover {
    transform:translateY(-2px);
    box-shadow:0 18px 34px rgba(15,23,42,.2), inset 0 1px 0 rgba(255,255,255,.42);
    filter:saturate(1.06);
}

.dashboard-global-tool.notification {
    background:linear-gradient(135deg,#2fe2da,#087f78);
}

.dashboard-global-tool.mailbox {
    background:linear-gradient(135deg,#8b5cf6,#4f46e5);
}

.dashboard-global-tool.open-work {
    background:linear-gradient(135deg,#ffb12f,#fb3f5f);
}

.dashboard-global-tool svg {
    width:22px;
    height:22px;
    fill:none;
    stroke:currentColor;
    stroke-width:2.25;
    stroke-linecap:round;
    stroke-linejoin:round;
}

.dashboard-global-tool-count {
    position:absolute;
    right:-5px;
    top:-7px;
    min-width:22px;
    height:22px;
    padding:0 6px;
    border-radius:999px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    background:linear-gradient(135deg,#ff3f68,#e11d48);
    border:2px solid rgba(255,255,255,.88);
    font-size:12px;
    line-height:1;
    font-weight:1000;
    box-shadow:0 8px 18px rgba(225,29,72,.25);
}

.dashboard-global-tool-count.is-empty {
    color:#e9f3ff;
    background:rgba(100,116,139,.82);
    box-shadow:0 8px 18px rgba(15,23,42,.18);
}

.dashboard-open-work-panel {
    position:absolute;
    right:0;
    top:calc(100% + 12px);
    z-index:35;
    width:min(430px, calc(100vw - 28px));
    max-height:520px;
    overflow:auto;
    padding:12px;
    border-radius:22px;
    color:#eaf4ff;
    background:
        radial-gradient(circle at 90% 0%, rgba(251,63,95,.20), transparent 30%),
        radial-gradient(circle at 0% 100%, rgba(20,184,166,.16), transparent 34%),
        linear-gradient(180deg, rgba(22,40,76,.98), rgba(8,23,48,.98));
    border:1px solid rgba(148,171,210,.28);
    box-shadow:0 24px 58px rgba(4,12,28,.34);
}

.dashboard-open-work-head {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:4px 4px 10px;
}

.dashboard-open-work-head span {
    font-size:16px;
    font-weight:1000;
}

.dashboard-open-work-head strong {
    padding:6px 10px;
    border-radius:999px;
    color:#fff;
    background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.15);
    font-size:12px;
    font-weight:1000;
}

.dashboard-open-work-empty {
    margin:0;
    padding:18px;
    border-radius:16px;
    color:#bad0eb;
    background:rgba(255,255,255,.07);
    text-align:center;
    font-weight:800;
}

.dashboard-open-work-list {
    display:grid;
    gap:12px;
}

.dashboard-open-work-group {
    display:grid;
    gap:8px;
}

.dashboard-open-work-group p {
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin:0;
    color:#9df8ec;
    font-size:13px;
    font-weight:1000;
    text-transform:uppercase;
    letter-spacing:.02em;
}

.dashboard-open-work-group p span {
    color:#cbd8ea;
}

.dashboard-open-work-item {
    display:grid;
    grid-template-columns:36px minmax(0, 1fr);
    gap:10px;
    padding:10px;
    border-radius:16px;
    color:#eef6ff;
    text-decoration:none;
    background:rgba(255,255,255,.075);
    border:1px solid rgba(151,174,213,.18);
    transition:transform .18s ease, border-color .18s ease, background .18s ease;
}

.dashboard-open-work-item:hover {
    transform:translateY(-1px);
    border-color:rgba(45,212,191,.42);
    background:rgba(255,255,255,.11);
}

.dashboard-open-work-mark {
    width:36px;
    height:36px;
    border-radius:13px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    font-size:14px;
    font-weight:1000;
    background:linear-gradient(135deg,#f59e0b,#fb7185);

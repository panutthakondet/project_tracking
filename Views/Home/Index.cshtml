.dashboard-open-work-actions a {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:38px;
    border-radius:13px;
    color:#08213a;
    background:linear-gradient(135deg,#a7ffed,#2dd4bf);
    text-decoration:none;
    font-size:13px;
    font-weight:1000;
}

.dashboard-global-search-results {
    position:absolute;
    right:0;
    top:calc(100% + 10px);
    z-index:30;
    width:min(620px, calc(100vw - 32px));
    max-height:420px;
    overflow:auto;
    border-radius:18px;
    padding:10px;
    color:#eaf4ff;
    background:
        radial-gradient(circle at 84% 0%, rgba(20,184,166,.18), transparent 28%),
        linear-gradient(180deg, rgba(20,39,75,.98), rgba(8,23,48,.98));
    border:1px solid rgba(139,165,210,.26);
    box-shadow:0 24px 58px rgba(4,12,28,.34);
}

.dashboard-global-search-results[hidden],
.dashboard-global-search-clear[hidden] {

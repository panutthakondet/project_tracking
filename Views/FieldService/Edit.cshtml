@model ProjectTracking.ViewModels.FieldServiceFormViewModel
@{ ViewData["Title"] = "แก้ไขงานออกไซต์"; }
<div class="index-hero pt-form-hero"><div class="index-hero__content"><span class="index-eyebrow">Field Service</span><h2 class="index-title">แก้ไขงานออกไซต์</h2><p class="index-subtitle">ปรับปรุงแผน ทีม และผลการปฏิบัติงาน</p></div></div>
<div class="card shadow-sm pt-form-card"><div class="card-body">
<form asp-action="Edit" asp-route-id="@Model.VisitId" method="post" onsubmit="return confirm('คุณต้องการบันทึกการแก้ไขหรือไม่?');">@Html.AntiForgeryToken()<input asp-for="VisitId" type="hidden" /><partial name="_Form" model="Model" /><div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Show" asp-route-id="@Model.VisitId" class="btn btn-outline-secondary">ปิด</a><button class="btn btn-primary px-4" type="submit">บันทึก</button></div></form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

@model IEnumerable<FieldServiceVisit>
@using System.Globalization
@{
    var month = (DateTime)ViewBag.Month;
    ViewData["Title"] = "Service Schedule";
    var th = new CultureInfo("th-TH");
    string ThaiDate(DateTime? date) => date.HasValue
        ? $"{date.Value.ToString("dd MMM", th)} {date.Value.Year + 543}"
        : "-";
}

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">Field Service</span>
        <h2 class="index-title">ปฏิทินงานบริการ</h2>
        <p class="index-subtitle">กำหนดการเข้าไซต์ประจำเดือน @month.ToString("MMMM", th) @(month.Year + 543)</p>
    </div>
    <div class="index-actions"><a asp-action="Index" class="btn btn-outline-light">รายการงาน</a></div>
</div>

<div class="card shadow-sm border-0 rounded-4 field-service-themed-card">
    <div class="card-header border-0 p-4">
        <div class="d-flex justify-content-between align-items-center gap-3">
            <a asp-action="Calendar" asp-route-month="@month.AddMonths(-1).ToString("yyyy-MM-dd")" class="btn btn-outline-primary">‹ เดือนก่อน</a>
            <h4 class="mb-0 fw-bold text-center">@month.ToString("MMMM", th) @(month.Year + 543)</h4>
            <a asp-action="Calendar" asp-route-month="@month.AddMonths(1).ToString("yyyy-MM-dd")" class="btn btn-outline-primary">เดือนถัดไป ›</a>
        </div>
    </div>
    <div class="list-group list-group-flush">
        @foreach (var item in Model)
        {
            var employeeNames = item.Assignees
                .Where(x => x.Employee != null)
                .OrderBy(x => x.Employee!.EmpName)
                .Select(x => x.Employee!.EmpName)
                .ToList();
            <a asp-action="Show" asp-route-id="@item.VisitId" class="list-group-item list-group-item-action p-4">
                <div class="row align-items-center g-3">
                    <div class="col-md-3 fw-bold field-service-accent">@ThaiDate(item.VisitDate) - @ThaiDate(item.EndVisitDate ?? item.VisitDate)</div>
                    <div class="col-md-5">
                        <div class="fw-bold">🏢 @(item.Coop?.CoopName ?? "ไม่ระบุสหกรณ์")</div>
                        <div class="opacity-75 small mt-1">@item.Title</div>
                        <div class="field-service-calendar-assignees mt-2">
                            <span>ผู้รับผิดชอบ:</span>
                            <strong>@(employeeNames.Count > 0 ? string.Join(", ", employeeNames) : "ยังไม่กำหนด")</strong>
                        </div>
                    </div>
                    <div class="col-md-2">@item.StartTime?.ToString(@"hh\:mm")</div>
                    <div class="col-md-2 text-md-end"><span class="field-service-status" data-status="@item.Status">@item.Status</span></div>
                </div>
            </a>
        }
        @if (!Model.Any())
        {
            <div class="text-center opacity-75 py-5">ไม่มีงานในเดือนนี้</div>
        }
    </div>
</div>

@model IEnumerable<FieldServiceVisit>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = null;
    var rows = (Model ?? Enumerable.Empty<FieldServiceVisit>()).ToList();
    var employees = ViewBag.Employees as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var cooperatives = ViewBag.Cooperatives as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var selectedStatus = (string?)ViewBag.Status ?? "";
    var selectedEmployeeId = (int)(ViewBag.EmployeeId ?? 0);
    var selectedCoopId = (int)(ViewBag.CoopId ?? 0);

    string ThaiDate(DateTime? date) => date.HasValue ? $"{date.Value:dd/MM/}{date.Value.Year + 543}" : "-";
    string ServiceText(string? type) => type switch
    {
        "MA" => "Maintenance (MA)",
        "PM" => "Preventive Maintenance",
        "SUPPORT" => "On-site Support",
        "TRAINING" => "Training",
        "IMPLEMENT" => "Implement",
        "OTHER" => "อื่น ๆ",
        _ => type ?? "-"
    };
    string StatusText(string? status) => status switch
    {
        "PLANNED" => "วางแผนแล้ว",
        "IN_PROGRESS" => "กำลังดำเนินการ",
        "COMPLETED" => "เสร็จสิ้น",
        "CANCELLED" => "ยกเลิก",
        _ => "ทั้งหมด"
    };
    string StatusClass(string? status) => status switch
    {
        "COMPLETED" => "success",
        "IN_PROGRESS" => "warning",
        "CANCELLED" => "danger",
        _ => "info"
    };

    var selectedEmployeeName = employees.FirstOrDefault(x => x.Value == selectedEmployeeId.ToString())?.Text ?? "ทั้งหมด";
    var selectedCoopName = cooperatives.FirstOrDefault(x => x.Value == selectedCoopId.ToString())?.Text ?? "ทั้งหมด";
    var completedCount = rows.Count(x => x.Status == "COMPLETED");
    var inProgressCount = rows.Count(x => x.Status == "IN_PROGRESS");
    var plannedCount = rows.Count(x => x.Status == "PLANNED");
    var cancelledCount = rows.Count(x => x.Status == "CANCELLED");
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>รายงานงานบริการ</title>
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap");
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 16px;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 400;
        }
        .report-actions { display: flex; justify-content: flex-end; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
        .report-btn {
            min-height: 34px; padding: 7px 14px; border: 1px solid #102443; border-radius: 999px;
            color: #102443; background: #fff; font: 600 12px/1.2 'Prompt', Tahoma, Arial, sans-serif;
            text-decoration: none; cursor: pointer;
        }
        .report-btn.primary { color: #fff; background: #102443; }
        .print-header { margin-bottom: 12px; padding: 15px 18px; color: #fff; background: #102443; }
        .print-header small { display: block; margin-bottom: 3px; color: #4fe2d0; font-weight: 600; text-transform: uppercase; }
        .print-header h1 { margin: 0 0 5px; font-size: 22px; font-weight: 700; }
        .print-header p, .print-header-meta { margin: 0; color: rgba(255,255,255,.82); line-height: 1.55; }
        .print-header-meta { margin-top: 5px; font-size: 11px; }
        .filter-panel {
            display: grid; grid-template-columns: repeat(2, minmax(135px, .75fr)) repeat(2, minmax(180px, 1fr)) minmax(220px, 1.35fr) auto;
            align-items: end; gap: 10px; margin-bottom: 12px; padding: 12px; border: 1px solid #d8e3ef; background: #f8fbff;
        }
        .field label { display: block; margin-bottom: 5px; color: #64748b; font-weight: 600; }
        .field :is(input, select) {
            width: 100%; min-height: 36px; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 0;
            color: #10233f; background: #fff; font: 400 12px/1.3 'Prompt', Tahoma, Arial, sans-serif;
        }
        .kpi-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-bottom: 12px; }
        .kpi { padding: 10px 12px; border: 1px solid #d8e3ef; border-left: 4px solid #258cfb; background: #fff; }
        .kpi.warning { border-left-color: #f59e0b; } .kpi.success { border-left-color: #22c55e; }
        .kpi.danger { border-left-color: #ef4444; } .kpi.muted { border-left-color: #94a3b8; }
        .kpi span { display: block; color: #64748b; font-weight: 500; }
        .kpi strong { display: block; margin-top: 4px; color: #10233f; font-size: 20px; font-weight: 700; }
        table { width: 100%; border-collapse: collapse; table-layout: fixed; }
        th { padding: 9px 10px; border-bottom: 2px solid #102443; color: #102443; background: #f4f7fa; font-weight: 600; text-align: left; }
        td { padding: 9px 10px; border-bottom: 1px solid #d8e3ef; vertical-align: top; }
        tbody tr:not(.group-row):hover { background: #f8fbff; }
        .group-row td { padding: 8px 10px; border-top: 1px solid #9fb3c8; border-bottom: 1px solid #9fb3c8; background: #eef3f7; }
        .group-line { display: flex; align-items: center; gap: 8px; }
        .group-line strong { font-weight: 600; }
        .group-line .count { color: #258cfb; font-weight: 600; }
        .group-line .complete { margin-left: auto; color: #15803d; }
        .status { display: inline-block; color: #258cfb; font-weight: 600; }
        .status.success { color: #15803d; } .status.warning { color: #b45309; } .status.danger { color: #dc2626; }
        .report-link { color: #102443; font-weight: 500; text-decoration: none; }
        .report-link:hover { color: #1677d2; text-decoration: underline; }
        .empty { padding: 36px; color: #64748b; text-align: center; }
        @@media (max-width: 1100px) {
            .filter-panel { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .kpi-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @@media print {
            @@page { size: A4 landscape; margin: 8mm; }
            body { padding: 0; font-size: 9px; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .report-actions, .filter-panel { display: none !important; }
            .print-header { padding: 10px 12px; color: #10233f; background: transparent; border-bottom: 1px solid #102443; }
            .print-header small, .print-header p, .print-header-meta { color: #475569; }
            .print-header h1 { font-size: 18px; }
            .kpi-grid { gap: 4px; margin-bottom: 8px; }
            .kpi { padding: 6px 8px; break-inside: avoid; }
            .kpi strong { font-size: 15px; }
            th, td { padding: 5px 6px; }
            .group-row { break-after: avoid; }
            tbody { break-inside: avoid; }
        }
    </style>
</head>
<body class="pt-standalone-report">
    <div class="report-actions">
        <button type="button" class="report-btn primary" onclick="window.print()">Print</button>
        <a asp-controller="Reports" asp-action="Index" class="report-btn">Report Center</a>
        <a asp-controller="Home" asp-action="Index" class="report-btn">Dashboard</a>
    </div>

    <header class="print-header">
        <small>Field Service</small>
        <h1>รายงานงานบริการ</h1>
        <p>สรุปผลการเข้าไซต์และสถานะงาน</p>
        <div class="print-header-meta">ช่วงวันที่ @ViewBag.From – @ViewBag.To · สถานะ @StatusText(selectedStatus) · พนักงาน @selectedEmployeeName · สหกรณ์ @selectedCoopName</div>
    </header>

    <form method="get" class="filter-panel">
        <div class="field"><label>ตั้งแต่วันที่</label><input type="text" name="from" value="@ViewBag.From" placeholder="วัน/เดือน/พ.ศ." /></div>
        <div class="field"><label>ถึงวันที่</label><input type="text" name="to" value="@ViewBag.To" placeholder="วัน/เดือน/พ.ศ." /></div>
        <div class="field">
            <label>สถานะ</label>
            <select name="status">
                <option value="ALL" selected="@(string.IsNullOrEmpty(selectedStatus))">ทั้งหมด</option>
                <option value="PLANNED" selected="@(selectedStatus == "PLANNED")">วางแผนแล้ว</option>
                <option value="IN_PROGRESS" selected="@(selectedStatus == "IN_PROGRESS")">กำลังดำเนินการ</option>
                <option value="COMPLETED" selected="@(selectedStatus == "COMPLETED")">เสร็จสิ้น</option>
                <option value="CANCELLED" selected="@(selectedStatus == "CANCELLED")">ยกเลิก</option>
            </select>
        </div>
        <div class="field">
            <label>พนักงาน</label>
            <select name="employeeId">
                <option value="0">ทั้งหมด</option>
                @foreach (var employee in employees) { <option value="@employee.Value" selected="@(selectedEmployeeId.ToString() == employee.Value)">@employee.Text</option> }
            </select>
        </div>
        <div class="field">
            <label>สหกรณ์</label>
            <select name="coopId">
                <option value="0">ทั้งหมด</option>
                @foreach (var cooperative in cooperatives) { <option value="@cooperative.Value" selected="@(selectedCoopId.ToString() == cooperative.Value)">@cooperative.Text</option> }
            </select>
        </div>
        <button type="submit" class="report-btn primary">ค้นหา</button>
    </form>

    <section class="kpi-grid">
        <div class="kpi"><span>งานทั้งหมด</span><strong>@rows.Count</strong></div>
        <div class="kpi"><span>วางแผนแล้ว</span><strong>@plannedCount</strong></div>
        <div class="kpi warning"><span>กำลังดำเนินการ</span><strong>@inProgressCount</strong></div>
        <div class="kpi success"><span>เสร็จสิ้น</span><strong>@completedCount</strong></div>
        <div class="kpi danger"><span>ยกเลิก</span><strong>@cancelledCount</strong></div>
    </section>

    <table>
        <colgroup><col style="width:16%" /><col style="width:34%" /><col style="width:19%" /><col style="width:15%" /><col style="width:16%" /></colgroup>
        <thead><tr><th>ช่วงวันที่</th><th>งาน</th><th>ประเภท</th><th>สถานะ</th><th>นัดครั้งถัดไป</th></tr></thead>
        @foreach (var coopGroup in rows.GroupBy(x => new { x.CoopId, Name = x.Coop?.CoopName ?? "ไม่ระบุสหกรณ์" }).OrderBy(x => x.Key.Name))
        {
            <tbody>
                <tr class="group-row"><td colspan="5"><div class="group-line"><span>🏢</span><strong>@coopGroup.Key.Name</strong><span class="count">@coopGroup.Count() งาน</span><span class="complete">เสร็จ @coopGroup.Count(x => x.Status == "COMPLETED") งาน</span></div></td></tr>
                @foreach (var item in coopGroup.OrderByDescending(x => x.VisitDate))
                {
                    <tr>
                        <td>@ThaiDate(item.VisitDate) – @ThaiDate(item.EndVisitDate ?? item.VisitDate)</td>
                        <td><a asp-controller="FieldService" asp-action="Show" asp-route-id="@item.VisitId" class="report-link">@item.Title</a></td>
                        <td>@ServiceText(item.ServiceType)</td>
                        <td><span class="status @StatusClass(item.Status)">@StatusText(item.Status)</span></td>
                        <td>@ThaiDate(item.NextVisitDate)</td>
                    </tr>
                }
            </tbody>
        }
        @if (!rows.Any()) { <tbody><tr><td colspan="5" class="empty">ไม่พบข้อมูลตามเงื่อนไขที่เลือก</td></tr></tbody> }
    </table>
</body>
</html>

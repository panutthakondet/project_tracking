@using System.Globalization
@using System.Text.Json
@using ProjectTracking.ViewModels
@{
    ViewData["Title"] = "ปฏิทินงานเข้าไซต์";
    var fromYear = (int)ViewBag.FromYear;
    var toYear = (int)ViewBag.ToYear;
    var yearOptions = ViewBag.YearOptions as int[] ?? Array.Empty<int>();
    var workDates = ViewBag.WorkDates as ISet<string> ?? new HashSet<string>();
    var workDateItems = ViewBag.WorkDateItems as Dictionary<string, List<FieldServiceAnnualCalendarItemViewModel>>
        ?? new Dictionary<string, List<FieldServiceAnnualCalendarItemViewModel>>();
    var employees = ViewBag.Employees as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var selectedEmployeeId = (int)(ViewBag.SelectedEmployeeId ?? 0);
    var selectedEmployeeName = (string)(ViewBag.SelectedEmployeeName ?? "พนักงานทั้งหมด");
    var monthNames = new CultureInfo("th-TH").DateTimeFormat.MonthNames.Take(12).ToArray();
    var dayHeaders = new[] { "อา", "จ", "อ", "พ", "พฤ", "ศ", "ส" };
    var workDateItemsJson = JsonSerializer.Serialize(workDateItems, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
}

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">Field Service</span>
        <h2 class="index-title">ปฏิทินงานเข้าไซต์</h2>
        <p class="index-subtitle">วันปฏิบัติงานของ @selectedEmployeeName</p>
    </div>
    <div class="index-actions"><a asp-action="Schedule" class="btn btn-outline-light">กลับ Work Calendar</a></div>
</div>

<form method="get" class="card shadow-sm border-0 rounded-4 field-service-themed-card field-service-year-filter mb-4">
    <div class="card-body p-3 p-lg-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-6 col-lg-3"><label class="form-label fw-bold" for="employeeId">พนักงาน</label><select id="employeeId" name="employeeId" class="form-select"><option value="0" selected="@(selectedEmployeeId == 0)">พนักงานทั้งหมด</option>@foreach(var employee in employees){<option value="@employee.EmpId" selected="@(selectedEmployeeId == (int)employee.EmpId)">@employee.EmpName</option>}</select></div>
            <div class="col-6 col-md-3 col-lg-2"><label class="form-label fw-bold" for="fromYear">จากปี</label><select id="fromYear" name="fromYear" class="form-select">@foreach(var year in yearOptions){<option value="@(year + 543)" selected="@(year == fromYear)">@(year + 543)</option>}</select></div>
            <div class="col-6 col-md-3 col-lg-2"><label class="form-label fw-bold" for="toYear">ถึงปี</label><select id="toYear" name="toYear" class="form-select">@foreach(var year in yearOptions){<option value="@(year + 543)" selected="@(year == toYear)">@(year + 543)</option>}</select></div>
            <div class="col-md-6 col-lg-2"><button type="submit" class="btn btn-primary w-100">แสดงปฏิทิน</button></div>
        </div>
    </div>
</form>

@for (var year = fromYear; year <= toYear; year++)
{
    var yearWorkCount = workDates.Count(x => x.StartsWith($"{year}-", StringComparison.Ordinal));
    <section class="card shadow-sm border-0 rounded-4 field-service-themed-card field-service-year-section mb-4">
        <div class="card-header border-0 d-flex flex-wrap align-items-center justify-content-between gap-2 p-3 p-lg-4">
            <h3 class="mb-0">ปี @(@year + 543)</h3>
            <span class="field-service-annual-summary">มีงาน @yearWorkCount วัน</span>
        </div>
        <div class="card-body p-3 p-lg-4 pt-0"><div class="field-service-annual-grid">
        @for (var month = 1; month <= 12; month++)
        {
            var firstDay = new DateTime(year, month, 1);
            var blanks = (int)firstDay.DayOfWeek;
            var days = DateTime.DaysInMonth(year, month);
            <article class="field-service-annual-month">
                <h4>@monthNames[month - 1]</h4>
                <div class="field-service-annual-days">
                    @foreach (var header in dayHeaders) { <span class="field-service-annual-day-head">@header</span> }
                    @for (var blank = 0; blank < blanks; blank++) { <span class="field-service-annual-day is-empty"></span> }
                    @for (var day = 1; day <= days; day++)
                    {
                        var date = new DateTime(year, month, day);
                        var dateKey = date.ToString("yyyy-MM-dd");
                        var isWork = workDates.Contains(dateKey);
                        var isToday = date == DateTime.Today;
                        var dateItems = workDateItems.TryGetValue(dateKey, out var items)
                            ? items
                            : new List<FieldServiceAnnualCalendarItemViewModel>();
                        if (isWork && dateItems.Count > 0)
                        {
                            <button type="button"
                                    class="field-service-annual-day is-work @(isToday ? "is-today" : "")"
                                    data-work-date="@dateKey"
                                    aria-label="วันที่ @day มีงานเข้าไซต์ @dateItems.Count งาน">
                                <span class="field-service-annual-day-number">@day</span>
                                <span class="field-service-annual-bars" aria-hidden="true">
                                    @foreach (var item in dateItems)
                                    {
                                        <i style="background:@item.Background"></i>
                                    }
                                </span>
                            </button>
                        }
                        else
                        {
                            <span class="field-service-annual-day @(isToday ? "is-today" : "")">@day</span>
                        }
                    }
                </div>
            </article>
        }
        </div></div>
    </section>
}

<div class="modal fade" id="fieldServiceAnnualVisitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content field-service-annual-modal">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">เลือกงานเข้าไซต์</h5>
                    <div class="field-service-annual-user" id="fieldServiceAnnualModalDate"></div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body p-3" id="fieldServiceAnnualModalItems"></div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const visitsByDate = @Html.Raw(workDateItemsJson);
    const modalElement = document.getElementById('fieldServiceAnnualVisitModal');
    const modalDate = document.getElementById('fieldServiceAnnualModalDate');
    const modalItems = document.getElementById('fieldServiceAnnualModalItems');
    const showBaseUrl = '@Url.Action("Show", "FieldService")';
    const thaiFormatter = new Intl.DateTimeFormat('th-TH', { dateStyle: 'long' });

    function showVisit(visitId) {
        window.location.href = `${showBaseUrl}/${visitId}`;
    }

    document.querySelectorAll('.field-service-annual-day[data-work-date]').forEach(function (day) {
        day.addEventListener('click', function () {
            const dateKey = day.dataset.workDate;
            const visits = visitsByDate[dateKey] || [];
            if (visits.length === 1) {
                showVisit(visits[0].visitId);
                return;
            }
            if (!visits.length || !modalElement || !window.bootstrap) return;

            modalDate.textContent = thaiFormatter.format(new Date(`${dateKey}T00:00:00`));
            modalItems.innerHTML = '';
            visits.forEach(function (visit) {
                const link = document.createElement('a');
                link.className = 'field-service-annual-visit-option';
                link.href = `${showBaseUrl}/${visit.visitId}`;
                link.style.setProperty('--field-service-visit-background', visit.background || '#64748b');

                const color = document.createElement('i');
                const content = document.createElement('span');
                const coop = document.createElement('strong');
                coop.textContent = visit.coopName || 'ไม่ระบุสหกรณ์';
                const title = document.createElement('span');
                title.textContent = visit.title || '-';
                const employee = document.createElement('small');
                employee.textContent = `ผู้รับผิดชอบ: ${visit.employeeNames || 'ยังไม่กำหนดพนักงาน'}`;
                content.append(coop, title, employee);
                link.append(color, content);
                modalItems.appendChild(link);
            });
            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        });
    });
});
</script>

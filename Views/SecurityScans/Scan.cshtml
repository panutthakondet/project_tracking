@model ProjectTracking.ViewModels.Security.SecurityScanPage
@using ProjectTracking.Services.Security
@{ViewData["Title"]="ผลสแกน #"+Model.Scan.Id;var seen=Model.Observations.Select(x=>x.FindingId).ToHashSet();var baseline=Model.BaselineFindings?.Select(x=>x.FindingId).ToHashSet();}
@section Styles { <link rel="stylesheet" href="~/css/security-center.css" asp-append-version="true" /> }
<div class="security-center">
<header class="index-hero security-hero"><div><small>SECURITY SCAN #@Model.Scan.Id</small><h1>@Model.System.Name</h1><p>@Model.Project.ProjectDisplayName<br />Version @Model.Version.VersionName / Build @Model.Version.BuildNumber · @Model.Version.Environment</p></div><a class="btn btn-outline-light" asp-action="Index" asp-route-projectId="@Model.Project.ProjectId">กลับศูนย์สแกน</a></header>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<section class="security-card"><div class="security-card-head"><h2 data-scan-status>@SecurityValues.StatusLabel(Model.Scan.Status)</h2><div class="security-inline"><a class="btn btn-outline-primary" asp-action="Scan" asp-route-id="@Model.Scan.Id">รีเฟรชสถานะ</a>@if(Model.CanManage&&(Model.Scan.Status is "Queued" or "Running")){<form asp-action="Cancel" method="post" data-scan-cancel><input type="hidden" name="id" value="@Model.Scan.Id" /><button type="submit" class="btn btn-outline-danger">ยกเลิกรอบนี้</button></form>}</div></div>
@await Html.PartialAsync("_Progress",ProjectTracking.ViewModels.Security.ScanProgressPage.From(Model.Scan,Model.Progress))
<p>@Model.Scan.Engine @Model.Scan.EngineVersion · @Model.Scan.Mode<br />@Model.Scan.Coverage</p><div class="alert alert-danger" data-scan-error hidden="@(Model.Scan.Error==null)">@Model.Scan.Error</div>
<p>เริ่ม: <span data-scan-started>@Model.Scan.StartedAt?.ToString("yyyy-MM-dd HH:mm")</span> · สิ้นสุด: <span data-scan-finished>@Model.Scan.FinishedAt?.ToString("yyyy-MM-dd HH:mm")</span> (UTC)<br />เป้าหมาย: @Model.Scan.TargetUrl</p>
@if(Model.Scan.Status=="Completed"){<div class="security-inline"><a class="btn btn-primary" asp-action="Report" asp-route-id="@Model.Scan.Id" asp-route-format="json">ดาวน์โหลด JSON ต้นฉบับ</a><a class="btn btn-outline-primary" asp-action="Report" asp-route-id="@Model.Scan.Id" asp-route-format="pdf">ดาวน์โหลดรายงาน PDF</a></div>}
@if(Model.Scan.Status is "Queued" or "Running"){<p data-scan-running-note>งานทำบนเครื่องสแกนแยก สามารถปิดหน้านี้แล้วกลับมาตรวจภายหลังได้</p>}
</section>
@if(Model.Scan.Status=="Completed"){
<div class="security-summary">@foreach(var severity in new[]{"Critical","High","Medium","Low","Info"}){<div><strong>@Model.Observations.Count(x=>x.Severity==severity)</strong> @severity</div>}</div>
<section class="security-card"><h2>เปรียบเทียบรอบตรวจ</h2><form method="get" class="security-inline"><input type="hidden" name="id" value="@Model.Scan.Id" /><select class="form-select" name="baselineId" aria-label="รอบก่อนหน้า"><option value="">เลือกรอบที่เครื่องมือ โหมด เป้าหมาย และสภาพแวดล้อมเดียวกัน</option>@foreach(var scan in Model.Baselines){<option value="@scan.Id">#@scan.Id · @scan.CreatedAt.ToString("yyyy-MM-dd HH:mm")</option>}</select><button type="submit" class="btn btn-outline-primary">เปรียบเทียบ</button></form>
@if(baseline!=null){<p>พบใหม่ <strong>@seen.Except(baseline).Count()</strong> · ยังพบ <strong>@seen.Intersect(baseline).Count()</strong> · ไม่พบในรอบล่าสุด <strong>@baseline.Except(seen).Count()</strong></p><p>“ไม่พบในรอบล่าสุด” ไม่ได้เปลี่ยนสถานะเป็นแก้ไขแล้วอัตโนมัติ ต้องตรวจความครอบคลุมและยืนยันผลก่อน</p>}
</section>
@if(Model.CanCreateIssue){<form asp-action="CreateIssues" method="post" id="securityIssueBatch" class="security-card security-form"><input type="hidden" name="scanId" value="@Model.Scan.Id" /><h2>สร้าง Issues จากประเด็นที่เลือก</h2><label>ผู้รับผิดชอบ<select class="form-select" name="employeeId" required><option value="">เลือกพนักงาน</option>@foreach(var emp in Model.Employees){<option value="@emp.EmpId">@emp.EmpName</option>}</select></label><label>วันเริ่ม<input type="date" class="form-control" name="startDate" required /></label><label>กำหนดส่ง<input type="date" class="form-control" name="endDate" required /></label><button class="btn btn-primary" type="submit">สร้าง / เชื่อม Issue เดิมจากรายการที่เลือก</button><small>เลือกช่องหน้าประเด็นด้านล่าง สูงสุด 50 รายการ ประเด็นที่มี Issue แล้วจะไม่สร้างซ้ำ</small></form>}
@foreach(var item in Model.Observations.OrderByDescending(x=>SecurityValues.Rank(x.Severity)).ThenBy(x=>x.Title)){
 var finding=Model.Findings.Single(x=>x.Id==item.FindingId);var link=Model.Links.FirstOrDefault(x=>x.FindingId==finding.Id);
 <article class="security-card"><header class="security-card-head"><h2>@if(Model.CanCreateIssue){<input type="checkbox" name="observationIds" form="securityIssueBatch" value="@item.Id" aria-label="เลือก @item.Title" />} <span class="security-severity security-severity-@item.Severity.ToLowerInvariant()">@item.Severity</span> @item.Title</h2><span>@SecurityValues.StatusLabel(finding.ReviewStatus)</span></header>
 <p><code>@item.RuleId</code> · CWE @item.Cwe<br /><strong>@item.Location</strong></p><p class="security-text">@item.Description</p>
 <details><summary>หลักฐาน</summary><pre>@item.Evidence</pre></details><h3>แนวทางแก้ไขจากเครื่องมือ</h3><p class="security-text">@(string.IsNullOrWhiteSpace(item.Remediation)?"เครื่องมือไม่ได้ให้คำแนะนำเฉพาะ กรุณาตรวจเอกสารอ้างอิงและให้ผู้ตรวจวิเคราะห์เพิ่มเติม":item.Remediation)</p><details><summary>เอกสารอ้างอิง</summary><pre>@item.References</pre></details>
 @if(link!=null){<p><a class="btn btn-outline-primary" asp-controller="ProjectIssues" asp-action="Details" asp-route-id="@link.IssueId">เปิด Issue #@link.IssueId</a></p>}
 @if(Model.CanCreateIssue&&link==null){<details><summary>เชื่อมกับ Issue ที่มีอยู่ในโครงการ</summary><form asp-action="LinkIssue" method="post" class="security-inline"><input type="hidden" name="observationId" value="@item.Id" /><select class="form-select" name="issueId" required aria-label="Issue เดิม"><option value="">เลือก Issue</option>@foreach(var issue in Model.ExistingIssues){<option value="@issue.IssueId">#@issue.IssueId @issue.IssueName</option>}</select><button type="submit" class="btn btn-outline-primary">เชื่อม Issue</button></form></details>}
 @if(Model.CanManage){<details><summary>ติดตามและตรวจยืนยันการแก้ไข</summary><form asp-action="Review" method="post" class="security-form"><input type="hidden" name="observationId" value="@item.Id" /><label>สถานะ<select name="status" class="form-select">@foreach(var state in SecurityValues.ReviewStatuses){<option value="@state" selected="@(finding.ReviewStatus==state)">@SecurityValues.StatusLabel(state)</option>}</select></label><label>ผู้รับผิดชอบ<select name="assignedEmpId" class="form-select"><option value="">ยังไม่ระบุ</option>@foreach(var emp in Model.Employees){<option value="@emp.EmpId" selected="@(finding.AssignedEmpId==emp.EmpId)">@emp.EmpName</option>}</select></label><label>กำหนดส่ง<input type="date" name="dueDate" class="form-control" value="@finding.DueDate?.ToString("yyyy-MM-dd")" /></label><label>หมายเหตุ / หลักฐานการตรวจยืนยัน<textarea class="form-control" name="note" maxlength="4000" required></textarea></label><button type="submit" class="btn btn-primary">บันทึกการติดตาม</button></form></details>}
 <details><summary>ประวัติการติดตาม</summary>@foreach(var history in Model.History.Where(x=>x.FindingId==finding.Id)){<p>@history.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC · ผู้ใช้ #@history.CreatedBy · @SecurityValues.StatusLabel(history.Status)<br />@history.Note</p>}</details>
 </article>
}
@if(Model.Observations.Count==0){<div class="alert alert-info">รอบนี้เครื่องมือไม่รายงานประเด็นในขอบเขตที่ตรวจ ไม่ได้ยืนยันว่าระบบปราศจากช่องโหว่</div>}
}
</div>

@section Scripts { <script src="~/js/security-scan-progress.js" asp-append-version="true" defer></script> }

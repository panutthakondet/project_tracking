@model ProjectTracking.ViewModels.Security.ProjectSecurityReport
@{
    Layout = null;

}
<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>ผลการทดสอบความปลอดภัย - @Model.ProjectName</title>
<link rel="stylesheet" href="~/css/report-font.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/project-security-report.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/project-report-toolbar.css" asp-append-version="true" />
<style>
    @@page { size: A4 portrait; margin: 14mm 16mm 12mm 18mm; }
    * { box-sizing: border-box; }
    body { margin: 0; color: #111; background: #edf1f6; font: 14pt/1.36 "Report Sarabun", "TH Sarabun New", Tahoma, sans-serif; }
    .project-security-report { background: #fff; max-width: 210mm; margin: 0 auto 24px; padding: 14mm clamp(16px, 4vw, 16mm); }
    @@media print {
        body { background: #fff; }
        .project-security-report { padding: 0; margin: 0; max-width: none; }
    }
</style>
</head>
<body>
    <nav class="project-report-toolbar" aria-label="เครื่องมือรายงาน">
        <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="project-report-button"><span aria-hidden="true">←</span> กลับศูนย์สแกน</a>
        <button type="button" class="project-report-button project-report-button--primary" onclick="window.print()">พิมพ์รายงาน</button>
    </nav>
<main class="project-security-report">
    @await Html.PartialAsync("_ProjectReportContent", Model)
</main>
</body>
</html>

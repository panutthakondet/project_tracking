@model (ProjectTracking.ViewModels.Security.SecurityScanPage Page, IReadOnlyList<ProjectTracking.Models.SecurityScanFinding> Items)
@using ProjectTracking.Services.Security
@{
    var (page, items) = Model;
    var first = items[0];
    var grouped = items.Count > 1;
}
@foreach (var item in items)
{
 var finding=page.Findings.Single(x=>x.Id==item.FindingId);var link=page.Links.Where(x=>x.FindingId==finding.Id).OrderByDescending(x=>x.Id).FirstOrDefault();
 var linkedIssue=page.LinkedIssues.FirstOrDefault(x=>x.IssueId==link?.IssueId);
 var reviewStatus=linkedIssue==null?finding.ReviewStatus:ProjectTracking.Services.Security.SecurityIssueWorkflow.CurrentReviewStatus(linkedIssue);
 var issueState=(linkedIssue?.IssueStatus,linkedIssue?.DevStatus) switch {
     ("PASS",_)=>"PASS", ("REJECT",_)=>"REJECT", (_,"FIXED")=>"FIXED", ("FAIL",_)=>"FAIL", (_,"WIP")=>"WIP", _=>"OPEN"
 };
 <section class="security-card security-finding security-finding-entry @(linkedIssue!=null?"is-issue-linked":"")" data-issue-state="@(linkedIssue!=null?issueState:null)"><header class="security-card-head"><h2>@if(page.CanCreateIssue && !grouped){<input type="checkbox" name="observationIds" form="securityIssueBatch" value="@item.Id" aria-label="เลือก @item.Title ที่ @item.Location" />} <span class="security-severity security-severity-@item.Severity.ToLowerInvariant()">@item.Severity</span> @(grouped ? item.Location : item.Title)</h2><div class="security-finding-state"><span>@SecurityValues.StatusLabel(reviewStatus)</span>@if(linkedIssue!=null){<small>Issue: @linkedIssue.IssueStatus · Dev: @linkedIssue.DevStatus</small>}@if(link!=null){<a class="btn btn-outline-primary btn-sm security-open-issue" asp-controller="ProjectIssues" asp-action="DevDetails" asp-route-id="@link.IssueId">เปิด Issue</a>}</div></header>
 @if(!grouped && page.Run?.IsWebsiteBatch==true){<p class="security-finding-origin">@SecurityValues.SectionLabel(page.Run.Section(item.ScanId))</p>}
 @if (!grouped)
 {
     <p><code>@item.RuleId</code> · CWE @item.Cwe</p>
     var locations = SecurityFindingGrouping.Locations(item.Location);
     if (locations.Length > 0)
     {
         <h3>ตำแหน่งที่พบ (@locations.Length)</h3>
         <ul class="security-finding-locations">
             @foreach (var location in locations)
             {
                 <li>@location</li>
             }
         </ul>
     }
 }
 @if (!grouped || item.Description != first.Description)
 {
     <p class="security-text">@item.Description</p>
 }
 <details><summary>หลักฐาน</summary><pre>@item.Evidence</pre></details><h3>แนวทางแก้ไขจากเครื่องมือ</h3><p class="security-text">@(string.IsNullOrWhiteSpace(item.Remediation)?"เครื่องมือไม่ได้ให้คำแนะนำเฉพาะ กรุณาตรวจเอกสารอ้างอิงและให้ผู้ตรวจวิเคราะห์เพิ่มเติม":item.Remediation)</p><details><summary>เอกสารอ้างอิง</summary><pre>@item.References</pre></details>

 @if(page.CanCreateIssue&&link==null){<details><summary>เชื่อมกับ Issue ที่มีอยู่ในโครงการ</summary><form asp-action="LinkIssue" method="post" data-loading-delay="0" data-loading-message="กำลังเชื่อม Issue…" class="security-inline"><input type="hidden" name="observationId" value="@item.Id" /><select class="form-select" name="issueId" required aria-label="Issue เดิม"><option value="">เลือก Issue</option>@foreach(var issue in page.ExistingIssues){<option value="@issue.IssueId">#@issue.IssueId @issue.IssueName</option>}</select><button type="submit" class="btn btn-outline-primary">เชื่อม Issue</button></form></details>}
 <details><summary>ติดตามและตรวจยืนยันการแก้ไข</summary>
 <p><strong>สถานะ:</strong> @SecurityValues.StatusLabel(reviewStatus)</p>
 @if(linkedIssue!=null){
     <p><strong>อ้างอิง:</strong> Issue #@linkedIssue.IssueId · ข้อมูลอัปเดตจาก Issue เท่านั้น</p>
     <p><strong>ผู้รับผิดชอบ:</strong> @(page.Employees.FirstOrDefault(x=>x.EmpId==linkedIssue.AssignTo)?.EmpName ?? $"พนักงาน #{linkedIssue.AssignTo}")</p>
     <p><strong>วันเริ่ม:</strong> @SecurityDisplayDate.Local(linkedIssue.StartDate) · <strong>กำหนดส่ง:</strong> @SecurityDisplayDate.Local(linkedIssue.EndDate)</p>
     <p><strong>สร้าง Issue:</strong> @SecurityDisplayDate.Local(linkedIssue.CreatedAt,true) · <strong>อัปเดต Issue ล่าสุด:</strong> @SecurityDisplayDate.Local(linkedIssue.UpdatedAt,true)</p>
     <h3>รายละเอียดการแก้ไขจาก Dev</h3><p class="security-text">@(string.IsNullOrWhiteSpace(linkedIssue.DevDetail)?"ยังไม่มีรายละเอียดการแก้ไข":linkedIssue.DevDetail)</p>
     <a class="btn btn-outline-primary" asp-controller="ProjectIssues" asp-action="DevDetails" asp-route-id="@linkedIssue.IssueId">ดู / จัดการที่ Issue #@linkedIssue.IssueId</a>
 }else{<p>ยังไม่ได้เชื่อม Issue กรุณาสร้างหรือเชื่อม Issue เพื่อจัดการการแก้ไขและวันที่</p>}
 </details>
 <details><summary>ประวัติการติดตาม</summary>@foreach(var history in page.History.Where(x=>x.FindingId==finding.Id)){<p>@SecurityDisplayDate.Utc(history.CreatedAt) · ผู้ใช้ #@history.CreatedBy · @SecurityValues.StatusLabel(history.Status)<br />@history.Note</p>}</details>
 </section>
    }

@model ProjectTracking.ViewModels.Security.ProjectSecurityReport
@using ProjectTracking.Services.Security
@{
    var findings = Model.Groups.SelectMany(group => group.Findings).ToList();
    var compared = Model.Groups.Where(group => group.PreviousScanId.HasValue).ToList();
    var changes = new[]
    {
        ("พบใหม่", compared.Sum(group => group.Findings.Count(item => item.IsNew == true))),
        ("ยังพบอยู่", compared.Sum(group => group.Findings.Count(item => item.IsNew == false))),
        ("ไม่พบซ้ำ", compared.Sum(group => group.NotSeenAgain))
    };
    var comparisonScale = Math.Max(1, changes.Max(change => change.Item2));
    var statusCounts = findings.ToLookup(item => item.Status);
    var statuses = SecurityValues.ReviewStatuses.Union(statusCounts.Select(group => group.Key));
    var awaitingAction = findings.Count(item => item.Severity is "Critical" or "High" &&
        item.Status is "Open" or "InProgress" or "FixedPendingVerification");
    var severities = new[] { ("Critical", "#a81939"), ("High", "#c34223"), ("Medium", "#916000"), ("Low", "#2367a0"), ("Info", "#58647a") };
    var totals = severities.Select(level => (level.Item1, level.Item2,
        Count: Model.Groups.Sum(group => group.Findings.Count(item => item.Severity == level.Item1)))).ToList();
    var total = totals.Sum(level => level.Count);
    var scale = Math.Max(1, totals.Max(level => level.Count));
}
<section class="security-report-content">
    <header>
        <h1>ผลการทดสอบความปลอดภัย</h1>
        <p class="report-project">@Model.ProjectName</p>
    </header>
    <section>
        <h2>สรุปผลสแกนจริงล่าสุด</h2>
        <p>พบ @total รายการจากส่วนที่สแกนเสร็จแล้ว · ความเสี่ยง Critical หรือ High ที่ยังต้องแก้ไขหรือตรวจยืนยัน @awaitingAction รายการ</p>
        <dl class="status-summary">
            @foreach (var status in statuses)
            {
                <dt>@SecurityValues.StatusLabel(status)</dt>
                <dd>@statusCounts[status].Count()</dd>
            }
        </dl>
        <h2>จำนวนประเด็นตามระดับความเสี่ยง</h2>
        <div class="risk-chart">
            @foreach (var level in totals)
            {
                <span>@level.Item1</span>
                <span class="risk-track" aria-hidden="true"><span class="risk-bar" style="width: @(level.Count * 100 / scale)%; --risk-color: @level.Item2"></span></span>
                <strong>@level.Count</strong>
            }
        </div>
    </section>
    <section>
        <h2>เปรียบเทียบกับรอบสแกนจริงก่อนหน้า</h2>
        @if (compared.Count == 0)
        {
            <p>ยังไม่มีคู่รอบที่สแกนเสร็จและมีขอบเขตเดียวกัน</p>
        }
        else
        {
            <p>เปรียบเทียบได้ @compared.Count จาก @Model.Groups.Count ประเภท</p>
            <div class="risk-chart">
                @foreach (var change in changes)
                {
                    <span>@change.Item1</span>
                    <span class="risk-track" aria-hidden="true"><span class="risk-bar" style="width: @(change.Item2 * 100 / comparisonScale)%; --risk-color: #2367a0"></span></span>
                    <strong>@change.Item2</strong>
                }
            </div>
        }
    </section>
    @foreach (var group in Model.Groups)
    {
        <section>
            <h2>@group.Category · @group.Findings.Count รายการ</h2>
            @if (group.Run is not { } run)
            {
                <p class="mb-0">ยังไม่มีรอบสแกนจริง</p>
                continue;
            }
            <p>
                <a asp-controller="SecurityScans" asp-action="Scan" asp-route-id="@run.Scan.Id">รอบ #@run.Scan.Id</a>
                · @SecurityValues.StatusLabel(run.Scan.Status)
            </p>
            @if (group.PreviousScanId is long previousId)
            {
                <p>เทียบกับ <a asp-controller="SecurityScans" asp-action="Scan" asp-route-id="@previousId">รอบ #@previousId</a>
                    · พบใหม่ @group.Findings.Count(item => item.IsNew == true)
                    · ยังพบอยู่ @group.Findings.Count(item => item.IsNew == false)
                    · ไม่พบซ้ำ @group.NotSeenAgain</p>
            }
            else
            {
                <p>ยังเปรียบเทียบผลของประเภทนี้ไม่ได้</p>
            }
            @if (run.Scan.Status != "Completed")
            {
                <p>ผลยังไม่ครบ สรุปได้เฉพาะส่วนที่สแกนเสร็จแล้ว</p>
            }
            @if (run.Parts.Count > 0)
            {
                <ul>
                    @foreach (var scan in run.Scans)
                    {
                        <li>@SecurityValues.SectionLabel(run.Section(scan.Id)) · @SecurityValues.StatusLabel(scan.Status)</li>
                    }
                </ul>
            }
            @if (group.Findings.Count == 0)
            {
                <p class="mb-0">@(run.HasResults ? "ไม่พบประเด็นในผลที่มี" : "ยังไม่มีผลสำหรับสรุประดับความเสี่ยง")</p>
            }
            else
            {
                @foreach (var findingGroup in group.Findings.GroupBy(item => item.IsNew)
                    .OrderByDescending(items => items.Key == true))
                {
                    var heading = findingGroup.Key switch
                    {
                        true => "รายการที่พบใหม่",
                        false => "รายการที่ยังพบอยู่",
                        null => "รายการจากรอบล่าสุด"
                    };
                    <h3 class="finding-group-title">@heading · @findingGroup.Count() รายการ</h3>
                    <ol class="findings">
                        @foreach (var item in findingGroup)
                        {
                            <li>
                                <div class="finding-heading">
                                    <strong>@item.Severity · @item.Title</strong> · @SecurityValues.StatusLabel(item.Status)
                                    @if (!string.IsNullOrEmpty(item.Section)) { <span>· @item.Section</span> }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Location))
                                {
                                    <div class="finding-detail"><strong>ตำแหน่งที่พบ</strong> @item.Location.Trim()</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Cwe))
                                {
                                    <div class="finding-detail"><strong>CWE</strong> @item.Cwe.Trim()</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="finding-detail"><strong>รายละเอียด</strong> @item.Description.Trim()</div>
                                }
                            </li>
                        }
                    </ol>
                }
            }
        </section>
    }
</section>

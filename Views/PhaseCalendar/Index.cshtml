

@{
    ViewData["Title"] = "ปฏิทินกำหนดส่งงาน";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<style>
    .calendar-card {
        background: #fff;
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
        margin-bottom: 20px;
    }

    #calendar {
        min-height: 850px;
    }

    .fc-toolbar-title {
        font-size: 1.6rem !important;
        font-weight: 700;
    }

    .fc-event {
        border-radius: 8px !important;
        border: 1px solid rgba(255,255,255,.25) !important;
        padding: 4px 6px !important;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,.12);
        transition: all .2s ease;
    }

    .fc-event:hover {
        transform: translateY(-1px);
        filter: brightness(1.03);
    }

    /* ===== สีตารางเหมือนปฏิทินประชุม ===== */
    .fc .fc-col-header-cell:nth-child(1) {
        background: #dc3545 !important;
    }

    .fc .fc-col-header-cell:nth-child(2) {
        background: #ffc107 !important;
    }

    .fc .fc-col-header-cell:nth-child(3) {
        background: #ff69b4 !important;
    }

    .fc .fc-col-header-cell:nth-child(4) {
        background: #28a745 !important;
    }

    .fc .fc-col-header-cell:nth-child(5) {
        background: #fd7e14 !important;
    }

    .fc .fc-col-header-cell:nth-child(6) {
        background: #0d6efd !important;
    }

    .fc .fc-col-header-cell:nth-child(7) {
        background: #6f42c1 !important;
    }

    .fc .fc-col-header-cell-cushion {
        color: #1f2937 !important;
        font-weight: 700;
        font-size: .95rem;
        text-shadow: none;
    }

    /* จันทร์ตัวหนังสือดำ อ่านง่าย */
    .fc .fc-col-header-cell:nth-child(2) .fc-col-header-cell-cushion {
        color: #111827 !important;
    }

    /* วันอื่นใช้ขาวเหมือน Meetings */
    .fc .fc-col-header-cell:nth-child(1) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(3) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(4) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(5) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(6) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(7) .fc-col-header-cell-cushion {
        color: white !important;
    }

    .fc .fc-daygrid-day.fc-day-sun {
        background: rgba(220,53,69,.06);
    }

    .fc .fc-daygrid-day.fc-day-mon {
        background: rgba(255,193,7,.08);
    }

    .fc .fc-daygrid-day.fc-day-tue {
        background: rgba(255,105,180,.06);
    }

    .fc .fc-daygrid-day.fc-day-wed {
        background: rgba(40,167,69,.06);
    }

    .fc .fc-daygrid-day.fc-day-thu {
        background: rgba(253,126,20,.06);
    }

    .fc .fc-daygrid-day.fc-day-fri {
        background: rgba(13,110,253,.06);
    }

    .fc .fc-daygrid-day.fc-day-sat {
        background: rgba(111,66,193,.06);
    }

    .fc-daygrid-day-number {
        color: #111827 !important;
        font-weight: 700;
        font-size: .95rem;
    }

    .fc-scrollgrid,
    .fc-theme-standard td,
    .fc-theme-standard th {
        border-color: #e5e7eb !important;
    }

    .fc-day-today {
        background: rgba(13,110,253,.12) !important;
    }

    .fc-day-today .fc-daygrid-day-number {
        background: #0d6efd;
        color: white !important;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .fc-button-primary {
        background: #2563eb !important;
        border-color: #2563eb !important;
    }

    .fc-button-primary:hover {
        background: #1d4ed8 !important;
        border-color: #1d4ed8 !important;
    }

    .phase-card {
        background: #fff;
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 12px;
        border-left: 6px solid #d1d5db;
        box-shadow: 0 4px 14px rgba(0,0,0,.06);
    }

    .phase-title {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .phase-detail {
        color: #6b7280;
        font-size: .92rem;
        margin-bottom: 4px;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        color: white;
        font-size: .8rem;
        font-weight: 700;
    }
    /* ============================
       Responsive Calendar
    ============================ */
    @@media (max-width: 768px) {

        .calendar-card {
            padding: 14px;
            border-radius: 14px;
        }

        .fc-toolbar {
            flex-direction: column;
            gap: 10px;
            align-items: stretch !important;
        }

        .fc-toolbar-chunk {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 6px;
        }

        .fc-toolbar-title {
            font-size: 1.1rem !important;
            text-align: center;
        }

        #calendar {
            min-height: 620px;
        }

        .fc-event {
            padding: 2px 4px !important;
            font-size: 11px !important;
            border-radius: 6px !important;
        }

        .fc-daygrid-event {
            white-space: normal !important;
        }

        .fc .fc-daygrid-day-frame {
            min-height: 90px;
        }

        .fc-col-header-cell-cushion {
            font-size: .8rem !important;
        }

        .fc-daygrid-day-number {
            font-size: .8rem !important;
        }
    }
</style>

<div class="container-fluid mt-3">

    <div class="calendar-card">
        <h3 class="mb-3 fw-bold">
            📅 ปฏิทินกำหนดส่งงานโครงการ
        </h3>

        <div id="calendar"></div>
    </div>

    <div class="calendar-card">
        <h4 class="fw-bold mb-3">
            📋 รายการกำหนดส่งงาน
        </h4>

        <div id="phaseList"></div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const calendarEl = document.getElementById('calendar');

        const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: window.innerWidth < 768
                ? 'listMonth'
                : 'dayGridMonth',
            locale: 'th',
            height: 'auto',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,listMonth'
            },

            firstDay: 0,

            buttonText: {
                today: 'วันนี้',
                month: 'เดือน',
                list: 'รายการ'
            },

            events: async function(fetchInfo, successCallback, failureCallback) {
                try {
                    const response = await fetch('/PhaseCalendar/List');
                    const data = await response.json();

                    const filtered = data.filter(x =>
                        ['วางแผน', 'กำลังดำเนินการ', 'ตีกลับ']
                            .includes(x.extendedProps?.phaseStatus)
                    );

                    successCallback(filtered);
                } catch (err) {
                    failureCallback(err);
                }
            },

            eventContent: function (arg) {
                const props = arg.event.extendedProps;

                return {
                    html: `
                        <div style="display:flex;align-items:flex-start;gap:6px;font-size:12px;line-height:1.25;color:#111827;font-weight:600;padding:2px 0;overflow:hidden;">

                            <div style="font-size:16px;line-height:1;flex-shrink:0;margin-top:1px;">
                                📌
                            </div>

                            <div style="min-width:0;overflow:hidden;flex:1;">
                                <div style="font-weight:700;color:#2563eb;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;text-overflow:ellipsis;">
                                    ${props.projectName ?? '-'}
                                </div>

                                <div style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;text-overflow:ellipsis;color:#111827;">
                                    ${props.phaseName ?? '-'}
                                </div>

                                <div style="margin-top:2px;font-size:11px;color:#6b7280;font-weight:600;">
                                    📍 ${props.phaseStatus ?? '-'}
                                </div>
                            </div>
                        </div>
                    `
                }
            },

            eventClick: function(info) {
                const projectId = info.event.extendedProps.projectId;

                if (projectId) {
                    // เปิดหน้า Phase ของ Project
                    window.location.href = `/ProjectPhases?projectId=${projectId}`;
                }
            }
        });

        calendar.render();

        loadPhaseList();
    });

    async function loadPhaseList() {

        const response = await fetch('/PhaseCalendar/List');
        const data = await response.json();

        const container = document.getElementById('phaseList');
        container.innerHTML = '';

        data
        .filter(item =>
            ['วางแผน', 'กำลังดำเนินการ', 'ตีกลับ']
                .includes(item.extendedProps?.phaseStatus)
        )
        .sort((a, b) => {
            const dateA = a.extendedProps?.planEnd
                ? new Date(a.extendedProps.planEnd)
                : new Date('9999-12-31');

            const dateB = b.extendedProps?.planEnd
                ? new Date(b.extendedProps.planEnd)
                : new Date('9999-12-31');

            return dateA - dateB;
        })
        .forEach(item => {

            const statusColor =
                item.extendedProps.phaseStatus === 'วางแผน' ? '#94a3b8' :
                item.extendedProps.phaseStatus === 'กำลังดำเนินการ' ? '#f59e0b' :
                item.extendedProps.phaseStatus === 'ส่งงวดงานแล้ว' ? '#06b6d4' :
                item.extendedProps.phaseStatus === 'อนุมัติแล้ว' ? '#22c55e' :
                item.extendedProps.phaseStatus === 'ตีกลับ' ? '#ef4444' : '#64748b';

            container.innerHTML += `
                <div class="phase-card" style="border-left-color:${statusColor}">

                    <div class="phase-title">
                        ${item.extendedProps.projectName}
                    </div>

                    <div class="phase-detail">
                        <strong>Phase:</strong>
                        ${item.extendedProps.phaseName}
                    </div>

                    <div class="phase-detail">
                        <strong>Period:</strong>
                        ${formatDate(item.extendedProps.periodStartDate)}
                        -
                        ${formatDate(item.extendedProps.periodEndDate)}
                    </div>

                    <div class="phase-detail">
                        <strong>กำหนดส่ง:</strong>
                        ${formatDate(item.extendedProps.planEnd)}
                    </div>

                    <span class="status-badge"
                          style="background:${statusColor}">
                        ${item.extendedProps.phaseStatus}
                    </span>
                </div>
            `;
        });
    }

    function formatDate(dateString) {
        if (!dateString) return '-';

        const date = new Date(dateString);

        return date.toLocaleDateString('th-TH', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric'
        });
    }
</script>


@{
    ViewData["Title"] = "ปฏิทินกำหนดส่งงาน";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<style>
    .phase-calendar-page {
        max-width: 100%;
        margin: 0 auto;
        padding: 8px 0;
    }

    .calendar-card {
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 22px;
        box-shadow: 0 12px 28px rgba(15, 35, 64, .08);
        overflow: hidden;
        margin-bottom: 18px;
    }

    .calendar-card__toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: #10233f;
        background: linear-gradient(180deg, #f8fafc, #eef6fb);
        border-bottom: 1px solid #d8e3ef;
        padding: 16px 18px;
    }

    .toolbar-left {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        min-width: 0;
    }

    .calendar-section-title {
        color: #10233f;
        font-size: 18px;
        font-weight: 900;
        margin: 0;
    }

    .calendar-section-subtitle {
        color: #64748b;
        font-size: .92rem;
        font-weight: 700;
    }

    .calendar-card__body {
        padding: 20px;
    }

    #calendar {
        min-height: 760px;
    }

    .fc {
        color: #10233f;
    }

    .fc .fc-toolbar-title {
        color: #10233f;
        font-size: 1.15rem !important;
        font-weight: 900;
        text-align: center;
    }

    .fc .fc-button {
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,.10) !important;
        box-shadow: none !important;
        padding: .35rem .65rem;
    }

    .fc .fc-button-primary {
        background: linear-gradient(135deg, var(--pt-accent), var(--pt-accent-dark)) !important;
        border-color: transparent !important;
        color: #062b2f !important;
        font-weight: 900 !important;
    }

    .fc .fc-button-primary:not(:disabled):hover,
    .fc .fc-button-primary:not(:disabled):focus {
        color: #fff !important;
    }

    .fc .fc-daygrid-day-frame {
        padding: 8px;
        min-height: 130px;
    }

    .fc .fc-event {
        background: #f8fafc !important;
        border: 1px solid #d8e3ef !important;
        border-left: 5px solid var(--pt-accent) !important;
        color: #10233f !important;
        border-radius: 8px !important;
        padding: 8px 10px !important;
        font-size: 0.82rem;
        line-height: 1.4;
        white-space: normal !important;
        word-break: break-word;
        overflow: hidden;
        margin-bottom: 8px !important;
        cursor: pointer;
        box-shadow: 0 6px 16px rgba(15, 35, 64, .08) !important;
        transition: all .15s ease;
    }

    .fc .fc-event:hover {
        transform: translateY(-1px);
    }

    .fc .fc-event-title {
        color: #10233f !important;
    }

    .fc-event.status-plan { border-left-color: #94a3b8 !important; }
    .fc-event.status-progress { border-left-color: #f59e0b !important; }
    .fc-event.status-submitted { border-left-color: #06b6d4 !important; }
    .fc-event.status-approved { border-left-color: #22c55e !important; }
    .fc-event.status-rejected { border-left-color: #ef4444 !important; }

    .fc .fc-col-header-cell {
        background: #10233f !important;
        color: #fff !important;
        border-color: rgba(255,255,255,.12) !important;
    }

    .fc .fc-col-header-cell-cushion {
        color: #fff !important;
        font-weight: 900;
        font-size: .95rem;
        text-shadow: none !important;
    }

    .fc .fc-daygrid-day {
        background: #ffffff !important;
    }

    .fc .fc-daygrid-day.fc-day-other {
        background: #f8fafc !important;
    }

    .fc .fc-daygrid-day-number {
        color: #10233f !important;
        font-weight: 700;
        font-size: .95rem;
    }

    .fc-scrollgrid,
    .fc-theme-standard td,
    .fc-theme-standard th {
        border-color: #e5e7eb !important;
    }

    .fc .fc-day-today {
        background: linear-gradient(180deg, rgba(20,184,166,.28), rgba(20,184,166,.16)) !important;
        box-shadow: inset 0 0 0 2px rgba(15,118,110,.30);
    }

    .fc .fc-day-today .fc-daygrid-day-number {
        background: linear-gradient(135deg, var(--pt-accent), var(--pt-accent-dark));
        color: #062b2f !important;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 18px rgba(20,184,166,.28);
    }

    .phase-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .phase-card {
        background: #f8fafc;
        border-radius: 14px;
        padding: 16px;
        border: 1px solid #e5e7eb;
        border-left: 5px solid #d1d5db;
        box-shadow: 0 6px 16px rgba(15, 35, 64, .06);
    }

    .phase-title {
        color: #10233f;
        font-size: 1.02rem;
        font-weight: 900;
        margin-bottom: 6px;
        line-height: 1.35;
    }

    .phase-detail {
        color: #64748b;
        font-size: .92rem;
        margin-bottom: 4px;
        font-weight: 700;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        color: #10233f;
        font-size: .8rem;
        font-weight: 900;
        background: rgba(20,184,166,.14);
    }
    /* ============================
       Responsive Calendar
    ============================ */
    @@media (max-width: 768px) {

        .phase-calendar-page {
            padding: 4px 0;
        }

        .calendar-card__toolbar {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
        }

        .calendar-card__body {
            padding: 14px;
        }

        .fc-toolbar {
            flex-direction: column;
            gap: 10px;
            align-items: stretch !important;
        }

        .fc-toolbar-chunk {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 6px;
        }

        .fc .fc-toolbar-title {
            font-size: 1.1rem !important;
            text-align: center;
        }

        #calendar {
            min-height: 620px;
        }

        .fc .fc-event {
            padding: 2px 4px !important;
            font-size: 11px !important;
            border-radius: 6px !important;
        }

        .fc-daygrid-event {
            white-space: normal !important;
        }

        .fc .fc-daygrid-day-frame {
            min-height: 90px;
        }

        .fc .fc-col-header-cell-cushion {
            font-size: .8rem !important;
        }

        .fc .fc-daygrid-day-number {
            font-size: .8rem !important;
        }
    }
</style>

<div class="container phase-calendar-page mt-3">
    <div class="index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="index-title">ปฏิทินกำหนดส่งงานโครงการ</h2>
            <p class="index-subtitle">ดูภาพรวมกำหนดส่งงานและรายการที่ต้องติดตามตามวัน</p>
        </div>
        <div class="index-actions">
            <a class="btn btn-outline-light btn-pill" asp-controller="Home" asp-action="Index" title="กลับ Dashboard">
                Dashboard
            </a>
            <span class="index-chip">งานที่ยังต้องติดตาม</span>
        </div>
    </div>

    <div class="calendar-card">
        <div class="calendar-card__toolbar">
            <div class="toolbar-left">
                <h3 class="calendar-section-title">Calendar</h3>
                <span class="calendar-section-subtitle">ข้อมูลกำหนดส่งจากงวดงานโครงการ</span>
            </div>
        </div>
        <div class="calendar-card__body">
            <div id="calendar"></div>
        </div>
    </div>

    <div class="calendar-card">
        <div class="calendar-card__toolbar">
            <div class="toolbar-left">
                <h3 class="calendar-section-title">รายการกำหนดส่งงาน</h3>
                <span class="calendar-section-subtitle">เรียงตามวันกำหนดส่งใกล้สุดก่อน</span>
            </div>
        </div>
        <div class="calendar-card__body">
            <div id="phaseList" class="phase-list"></div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const calendarEl = document.getElementById('calendar');

        const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: window.innerWidth < 768
                ? 'listMonth'
                : 'dayGridMonth',
            locale: 'th',
            height: 'auto',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,listMonth'
            },

            firstDay: 0,

            buttonText: {
                today: 'วันนี้',
                month: 'เดือน',
                list: 'รายการ'
            },

            events: async function(fetchInfo, successCallback, failureCallback) {
                try {
                    const response = await fetch('/PhaseCalendar/List');
                    const data = await response.json();

                    const filtered = data.filter(x =>
                        ['วางแผน', 'กำลังดำเนินการ', 'ตีกลับ']
                            .includes(x.extendedProps?.phaseStatus)
                    );

                    successCallback(filtered);
                } catch (err) {
                    failureCallback(err);
                }
            },

            eventContent: function (arg) {
                const props = arg.event.extendedProps;

                return {
                    html: `
                        <div style="display:flex;align-items:flex-start;gap:6px;font-size:12px;line-height:1.3;color:#10233f;font-weight:700;padding:2px 0;overflow:hidden;">
                            <div style="min-width:0;overflow:hidden;flex:1;">
                                <div style="font-weight:900;color:#10233f;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;text-overflow:ellipsis;">
                                    ${props.projectName ?? '-'}
                                </div>

                                <div style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;text-overflow:ellipsis;color:#475569;">
                                    ${props.phaseName ?? '-'}
                                </div>

                                <div style="margin-top:3px;font-size:11px;color:#0f766e;font-weight:900;">
                                    ${props.phaseStatus ?? '-'}
                                </div>
                            </div>
                        </div>
                    `
                }
            },

            eventClassNames: function (arg) {
                const status = arg.event.extendedProps?.phaseStatus;
                if (status === 'วางแผน') return ['status-plan'];
                if (status === 'กำลังดำเนินการ') return ['status-progress'];
                if (status === 'ส่งงวดงานแล้ว') return ['status-submitted'];
                if (status === 'อนุมัติแล้ว') return ['status-approved'];
                if (status === 'ตีกลับ') return ['status-rejected'];
                return [];
            },

            eventClick: function(info) {
                const projectId = info.event.extendedProps.projectId;

                if (projectId) {
                    // เปิดหน้า Phase ของ Project
                    window.location.href = `/ProjectPhases?projectId=${projectId}`;
                }
            }
        });

        calendar.render();

        loadPhaseList();
    });

    async function loadPhaseList() {

        const response = await fetch('/PhaseCalendar/List');
        const data = await response.json();

        const container = document.getElementById('phaseList');
        container.innerHTML = '';

        data
        .filter(item =>
            ['วางแผน', 'กำลังดำเนินการ', 'ตีกลับ']
                .includes(item.extendedProps?.phaseStatus)
        )
        .sort((a, b) => {
            const dateA = a.extendedProps?.planEnd
                ? new Date(a.extendedProps.planEnd)
                : new Date('9999-12-31');

            const dateB = b.extendedProps?.planEnd
                ? new Date(b.extendedProps.planEnd)
                : new Date('9999-12-31');

            return dateA - dateB;
        })
        .forEach(item => {

            const statusColor =
                item.extendedProps.phaseStatus === 'วางแผน' ? '#94a3b8' :
                item.extendedProps.phaseStatus === 'กำลังดำเนินการ' ? '#f59e0b' :
                item.extendedProps.phaseStatus === 'ส่งงวดงานแล้ว' ? '#06b6d4' :
                item.extendedProps.phaseStatus === 'อนุมัติแล้ว' ? '#22c55e' :
                item.extendedProps.phaseStatus === 'ตีกลับ' ? '#ef4444' : '#64748b';

            container.innerHTML += `
                <div class="phase-card" style="border-left-color:${statusColor}">

                    <div class="phase-title">
                        ${item.extendedProps.projectName}
                    </div>

                    <div class="phase-detail">
                        <strong>Phase:</strong>
                        ${item.extendedProps.phaseName}
                    </div>

                    <div class="phase-detail">
                        <strong>Period:</strong>
                        ${formatDate(item.extendedProps.periodStartDate)}
                        -
                        ${formatDate(item.extendedProps.periodEndDate)}
                    </div>

                    <div class="phase-detail">
                        <strong>กำหนดส่ง:</strong>
                        ${formatDate(item.extendedProps.planEnd)}
                    </div>

                    <span class="status-badge"
                          style="color:${statusColor};background:${statusColor}22;">
                        ${item.extendedProps.phaseStatus}
                    </span>
                </div>
            `;
        });
    }

    function formatDate(dateString) {
        if (!dateString) return '-';

        const date = new Date(dateString);

        return date.toLocaleDateString('th-TH', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric'
        });
    }
</script>

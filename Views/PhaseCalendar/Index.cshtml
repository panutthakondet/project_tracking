

@{
    ViewData["Title"] = "ปฏิทินกำหนดส่งงาน";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<style>
    :root {
        --phase-navy: #10233f;
        --phase-teal: #14b8a6;
        --phase-teal-dark: #0f766e;
        --phase-border: #d8e3ef;
        --phase-soft: #eef8f7;
        --phase-soft-other: #f7fbfc;
    }

    .phase-calendar-page {
        max-width: 100%;
        margin: 0 auto;
        padding: 8px 0;
    }

    .calendar-card {
        background: #fff;
        border: 1px solid rgba(15, 118, 110, .18);
        border-radius: 22px;
        box-shadow: 0 16px 38px rgba(15, 35, 64, .12);
        overflow: hidden;
        margin-bottom: 18px;
    }

    .calendar-card__toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: #ffffff;
        background: linear-gradient(135deg, #10233f 0%, #123b5c 58%, #0f766e 100%);
        border-bottom: 1px solid rgba(20, 184, 166, .36);
        padding: 16px 18px;
    }

    .toolbar-left {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        min-width: 0;
    }

    .calendar-section-title {
        color: #ffffff;
        font-size: 18px;
        font-weight: 900;
        margin: 0;
    }

    .calendar-section-subtitle {
        color: rgba(255, 255, 255, .72);
        font-size: .92rem;
        font-weight: 700;
    }

    .calendar-card__body {
        padding: 20px;
        background: #eef5fb;
    }

    #calendar {
        min-height: 760px;
    }

    .fc {
        color: var(--phase-navy);
    }

    .fc .fc-toolbar-title {
        color: var(--phase-navy);
        font-size: 1.15rem !important;
        font-weight: 900;
        text-align: center;
    }

    .fc .fc-button {
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,.10) !important;
        box-shadow: none !important;
        padding: .35rem .65rem;
    }

    .fc .fc-button-primary {
        background: linear-gradient(135deg, var(--phase-teal), var(--phase-teal-dark)) !important;
        border-color: transparent !important;
        color: #062b2f !important;
        font-weight: 900 !important;
    }

    .fc .fc-button-primary:not(:disabled):hover,
    .fc .fc-button-primary:not(:disabled):focus {
        color: #fff !important;
    }

    .fc .fc-daygrid-day-frame {
        padding: 8px;
        min-height: 130px;
    }

    .fc .fc-scrollgrid {
        overflow: hidden;
        border-color: var(--phase-border) !important;
        border-radius: 16px;
        box-shadow: 0 12px 28px rgba(15, 35, 64, .08);
    }

    .fc .fc-event {
        background: #f8fafc !important;
        border: 1px solid var(--phase-border) !important;
        border-left: 6px solid var(--phase-teal) !important;
        color: var(--phase-navy) !important;
        border-radius: 12px !important;
        padding: 8px 10px !important;
        font-size: 0.82rem;
        line-height: 1.4;
        white-space: normal !important;
        word-break: break-word;
        overflow: hidden;
        margin-bottom: 8px !important;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(15, 35, 64, .12) !important;
        transition: all .15s ease;
    }

    .fc .fc-event:hover {
        transform: translateY(-1px);
        box-shadow: 0 14px 24px rgba(15, 35, 64, .18) !important;
    }

    .fc .fc-event-title {
        color: var(--phase-navy) !important;
    }

    .fc-event.status-plan {
        background: linear-gradient(135deg, #f8fafc, #eef2ff) !important;
        border-color: #cbd5e1 !important;
        border-left-color: #64748b !important;
    }

    .fc-event.status-progress {
        background: linear-gradient(135deg, #fff7ed, #ffedd5) !important;
        border-color: #fed7aa !important;
        border-left-color: #f59e0b !important;
    }

    .fc-event.status-submitted,
    .fc-event.status-approved {
        background: linear-gradient(135deg, #ecfdf5, #dcfce7) !important;
        border-color: #bbf7d0 !important;
        border-left-color: #22c55e !important;
    }

    .fc-event.status-rejected {
        background: linear-gradient(135deg, #fff1f2, #ffe4e6) !important;
        border-color: #fecdd3 !important;
        border-left-color: #ef4444 !important;
    }

    .fc .fc-col-header-cell {
        background: var(--phase-navy) !important;
        color: #fff !important;
        border-color: rgba(255,255,255,.12) !important;
    }

    .fc .fc-col-header-cell-cushion {
        color: #fff !important;
        font-weight: 900;
        font-size: .95rem;
        text-shadow: none !important;
    }

    .fc .fc-daygrid-day {
        background: var(--phase-soft) !important;
    }

    .fc .fc-daygrid-day.fc-day-other {
        background: var(--phase-soft-other) !important;
        opacity: .78;
    }

    .fc .fc-daygrid-day-number {
        color: var(--phase-navy) !important;
        font-weight: 700;
        font-size: .95rem;
    }

    .fc-scrollgrid,
    .fc-theme-standard td,
    .fc-theme-standard th {
        border-color: #e5e7eb !important;
    }

    .fc .fc-day-today {
        background: #c8f8ef !important;
        box-shadow: inset 0 0 0 3px var(--phase-teal-dark);
    }

    .fc .fc-day-today .fc-daygrid-day-frame {
        min-height: 100% !important;
        height: 100% !important;
        background: linear-gradient(180deg, #d9fbf6 0%, #b9f2e8 100%) !important;
        box-shadow: inset 0 0 0 2px rgba(15,118,110,.55);
    }

    .fc .fc-day-today .fc-daygrid-day-number {
        background: linear-gradient(135deg, var(--phase-teal-dark), #0b4f4a);
        color: #ffffff !important;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        box-shadow: 0 10px 20px rgba(15, 118, 110, .30);
    }

    .fc .fc-list {
        overflow: hidden;
        border: 1px solid var(--phase-border) !important;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 12px 28px rgba(15, 35, 64, .08);
    }

    .fc .fc-list-day-cushion {
        background: linear-gradient(135deg, var(--phase-navy), #0f766e) !important;
        color: #ffffff !important;
        font-weight: 900;
    }

    .fc .fc-list-event td {
        border-color: #e5edf7 !important;
        color: var(--phase-navy);
        font-weight: 800;
    }

    .fc .fc-list-event:hover td {
        background: #ecfeff !important;
    }

    .phase-event-content {
        display: flex;
        align-items: flex-start;
        gap: 6px;
        color: var(--phase-navy);
        font-size: 12px;
        line-height: 1.3;
        font-weight: 800;
        padding: 2px 0;
        overflow: hidden;
    }

    .phase-event-dot {
        width: 9px;
        height: 9px;
        flex: 0 0 9px;
        margin-top: 4px;
        border-radius: 50%;
        background: currentColor;
        box-shadow: 0 0 0 4px rgba(255,255,255,.7);
    }

    .phase-event-text {
        min-width: 0;
        overflow: hidden;
        flex: 1;
    }

    .phase-event-title {
        color: var(--phase-navy);
        font-weight: 900;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        text-overflow: ellipsis;
    }

    .phase-event-subtitle {
        color: #475569;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        text-overflow: ellipsis;
    }

    .phase-event-status {
        margin-top: 3px;
        color: #0f766e;
        font-size: 11px;
        font-weight: 900;
    }

    .phase-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .phase-card {
        background: linear-gradient(90deg, #ecfeff 0, #ffffff 28%);
        border-radius: 16px;
        padding: 16px;
        border: 1px solid var(--phase-border);
        border-left: 5px solid #d1d5db;
        box-shadow: 0 10px 22px rgba(15, 35, 64, .08);
        transition: transform .16s ease, box-shadow .16s ease;
    }

    .phase-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 30px rgba(15, 35, 64, .14);
    }

    .phase-title {
        color: #10233f;
        font-size: 1.02rem;
        font-weight: 900;
        margin-bottom: 6px;
        line-height: 1.35;
    }

    .phase-detail {
        color: #64748b;
        font-size: .92rem;
        margin-bottom: 4px;
        font-weight: 700;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        color: #10233f;
        font-size: .8rem;
        font-weight: 900;
        background: rgba(20,184,166,.14);
    }
    /* ============================
       Responsive Calendar
    ============================ */
    @@media (max-width: 768px) {

        .phase-calendar-page {
            padding: 4px 0;
        }

        .calendar-card__toolbar {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
        }

        .calendar-card__body {
            padding: 14px;
        }

        .fc-toolbar {
            flex-direction: column;
            gap: 10px;
            align-items: stretch !important;
        }

        .fc-toolbar-chunk {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 6px;
        }

        .fc .fc-toolbar-title {
            font-size: 1.1rem !important;
            text-align: center;
        }

        #calendar {
            min-height: 620px;
        }

        .fc .fc-event {
            padding: 2px 4px !important;
            font-size: 11px !important;
            border-radius: 6px !important;
        }

        .fc-daygrid-event {
            white-space: normal !important;
        }

        .fc .fc-daygrid-day-frame {
            min-height: 90px;
        }

        .fc .fc-col-header-cell-cushion {
            font-size: .8rem !important;
        }

        .fc .fc-daygrid-day-number {
            font-size: .8rem !important;
        }
    }
</style>

<div class="container phase-calendar-page mt-3">
    <div class="index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="index-title">ปฏิทินกำหนดส่งงานโครงการ</h2>
            <p class="index-subtitle">ดูภาพรวมกำหนดส่งงานและรายการที่ต้องติดตามตามวัน</p>
        </div>
        <div class="index-actions">
            <a class="btn btn-outline-light btn-pill" asp-controller="Home" asp-action="Index" title="กลับ Dashboard">
                Dashboard
            </a>
            <span class="index-chip">งานที่ยังต้องติดตาม</span>
        </div>
    </div>

    <div class="calendar-card">
        <div class="calendar-card__toolbar">
            <div class="toolbar-left">
                <h3 class="calendar-section-title">Calendar</h3>
                <span class="calendar-section-subtitle">ข้อมูลกำหนดส่งจากงวดงานโครงการ</span>
            </div>
        </div>
        <div class="calendar-card__body">
            <div id="calendar"></div>
        </div>
    </div>

    <div class="calendar-card">
        <div class="calendar-card__toolbar">
            <div class="toolbar-left">
                <h3 class="calendar-section-title">รายการกำหนดส่งงาน</h3>
                <span class="calendar-section-subtitle">เรียงตามวันกำหนดส่งใกล้สุดก่อน</span>
            </div>
        </div>
        <div class="calendar-card__body">
            <div id="phaseList" class="phase-list"></div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const calendarEl = document.getElementById('calendar');

        const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: window.innerWidth < 768
                ? 'listMonth'
                : 'dayGridMonth',
            locale: 'th',
            height: 'auto',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,listMonth'
            },

            firstDay: 0,

            buttonText: {
                today: 'วันนี้',
                month: 'เดือน',
                list: 'รายการ'
            },

            events: async function(fetchInfo, successCallback, failureCallback) {
                try {
                    const response = await fetch('/PhaseCalendar/List');
                    const data = await response.json();

                    const filtered = data.filter(x =>
                        ['วางแผน', 'กำลังดำเนินการ', 'ตีกลับ']
                            .includes(x.extendedProps?.phaseStatus)
                    );

                    successCallback(filtered);
                } catch (err) {
                    failureCallback(err);
                }
            },

            eventContent: function (arg) {
                const props = arg.event.extendedProps;
                const statusColor =
                    props.phaseStatus === 'วางแผน' ? '#64748b' :
                    props.phaseStatus === 'กำลังดำเนินการ' ? '#f59e0b' :
                    props.phaseStatus === 'ส่งงวดงานแล้ว' ? '#22c55e' :
                    props.phaseStatus === 'อนุมัติแล้ว' ? '#22c55e' :
                    props.phaseStatus === 'ตีกลับ' ? '#ef4444' : '#64748b';

                return {
                    html: `
                        <div class="phase-event-content" style="color:${statusColor}">
                            <span class="phase-event-dot"></span>
                            <div class="phase-event-text">
                                <div class="phase-event-title">
                                    ${props.projectName ?? '-'}
                                </div>

                                <div class="phase-event-subtitle">
                                    ${props.phaseName ?? '-'}
                                </div>

                                <div class="phase-event-status" style="color:${statusColor}">
                                    ${props.phaseStatus ?? '-'}
                                </div>
                            </div>
                        </div>
                    `
                }
            },

            eventClassNames: function (arg) {
                const status = arg.event.extendedProps?.phaseStatus;
                if (status === 'วางแผน') return ['status-plan'];
                if (status === 'กำลังดำเนินการ') return ['status-progress'];
                if (status === 'ส่งงวดงานแล้ว') return ['status-submitted'];
                if (status === 'อนุมัติแล้ว') return ['status-approved'];
                if (status === 'ตีกลับ') return ['status-rejected'];
                return [];
            },

            eventClick: function(info) {
                const projectId = info.event.extendedProps.projectId;

                if (projectId) {
                    // เปิดหน้า Phase ของ Project
                    window.location.href = `/ProjectPhases?projectId=${projectId}`;
                }
            }
        });

        calendar.render();

        loadPhaseList();
    });

    async function loadPhaseList() {

        const response = await fetch('/PhaseCalendar/List');
        const data = await response.json();

        const container = document.getElementById('phaseList');
        container.innerHTML = '';

        data
        .filter(item =>
            ['วางแผน', 'กำลังดำเนินการ', 'ตีกลับ']
                .includes(item.extendedProps?.phaseStatus)
        )
        .sort((a, b) => {
            const dateA = a.extendedProps?.planEnd
                ? new Date(a.extendedProps.planEnd)
                : new Date('9999-12-31');

            const dateB = b.extendedProps?.planEnd
                ? new Date(b.extendedProps.planEnd)
                : new Date('9999-12-31');

            return dateA - dateB;
        })
        .forEach(item => {

            const statusColor =
                item.extendedProps.phaseStatus === 'วางแผน' ? '#94a3b8' :
                item.extendedProps.phaseStatus === 'กำลังดำเนินการ' ? '#f59e0b' :
                item.extendedProps.phaseStatus === 'ส่งงวดงานแล้ว' ? '#22c55e' :
                item.extendedProps.phaseStatus === 'อนุมัติแล้ว' ? '#22c55e' :
                item.extendedProps.phaseStatus === 'ตีกลับ' ? '#ef4444' : '#64748b';

            container.innerHTML += `
                <div class="phase-card" style="border-left-color:${statusColor}">

                    <div class="phase-title">
                        ${item.extendedProps.projectName}
                    </div>

                    <div class="phase-detail">
                        <strong>Phase:</strong>
                        ${item.extendedProps.phaseName}
                    </div>

                    <div class="phase-detail">
                        <strong>กำหนดส่งงวดงาน:</strong>
                        ${formatDate(item.extendedProps.periodEndDate)}
                    </div>

                    <div class="phase-detail">
                        <strong>กำหนดส่ง:</strong>
                        ${formatDate(item.extendedProps.planEnd)}
                    </div>

                    <span class="status-badge"
                          style="color:${statusColor};background:${statusColor}22;">
                        ${item.extendedProps.phaseStatus}
                    </span>
                </div>
            `;
        });
    }

    function formatDate(dateString) {
        if (!dateString) return '-';

        const date = new Date(dateString);

        return date.toLocaleDateString('th-TH', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric'
        });
    }
</script>

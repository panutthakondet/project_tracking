

@{
    ViewData["Title"] = "ปฏิทินกำหนดส่งงาน";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/locales-all.global.min.js"></script>

<style>
    :root {
        --phase-navy: #10233f;
        --phase-teal: #14b8a6;
        --phase-teal-dark: #0f766e;
        --phase-blue: #238cf6;
        --phase-orange: #f59e0b;
        --phase-pink: #ef4444;
        --phase-purple: #8b5cf6;
        --phase-border: #d8e3ef;
        --phase-soft: #eef8f7;
        --phase-soft-other: #f7fbfc;
    }

    .phase-calendar-page {
        max-width: 100%;
        margin: 0 auto;
        padding: 8px 0;
    }

    .calendar-card {
        background: #fff;
        border: 1px solid rgba(15, 118, 110, .18);
        border-radius: 22px;
        box-shadow: 0 16px 38px rgba(15, 35, 64, .12);
        overflow: hidden;
        margin-bottom: 18px;
    }

    .calendar-card__toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        color: #ffffff;
        background:
            linear-gradient(135deg, rgba(16, 35, 63, .96) 0%, rgba(18, 59, 92, .94) 58%, rgba(15, 118, 110, .92) 100%);
        border-bottom: 1px solid rgba(20, 184, 166, .36);
        padding: 18px 22px;
        min-height: 92px;
        position: relative;
        overflow: hidden;
    }

    .calendar-card__toolbar::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            linear-gradient(90deg, rgba(255, 255, 255, .10), transparent 42%),
            repeating-linear-gradient(135deg, rgba(255,255,255,.10) 0 1px, transparent 1px 14px);
        opacity: .42;
        pointer-events: none;
    }

    .calendar-card__toolbar > * {
        position: relative;
        z-index: 1;
    }

    .calendar-heading {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .calendar-heading__date {
        min-width: 220px;
        min-height: 48px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        background: rgba(255,255,255,.95);
        color: var(--phase-navy);
        box-shadow: 0 12px 26px rgba(4, 18, 38, .22);
        font-size: .94rem;
        font-weight: 900;
        line-height: 1.25;
        padding: 10px 14px;
        white-space: nowrap;
    }

    .calendar-heading__eyebrow {
        display: block;
        color: rgba(255,255,255,.72);
        font-size: .76rem;
        font-weight: 900;
        letter-spacing: .04em;
        text-transform: uppercase;
        line-height: 1.2;
    }

    .calendar-heading__title {
        display: block;
        color: #ffffff;
        font-size: 1.25rem;
        font-weight: 900;
        line-height: 1.2;
        margin-top: 2px;
    }

    .calendar-heading__subtitle {
        display: block;
        color: rgba(255, 255, 255, .72);
        font-size: .88rem;
        font-weight: 700;
        line-height: 1.3;
        margin-top: 4px;
    }

    .calendar-heading__meta {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
    }

    .calendar-heading__action,
    .calendar-heading__pill {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 14px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.45);
        color: #ffffff !important;
        background: rgba(255,255,255,.12);
        box-shadow: 0 8px 18px rgba(4, 18, 38, .16);
        font-size: .88rem;
        font-weight: 900;
        line-height: 1.15;
        text-decoration: none;
        white-space: nowrap;
        backdrop-filter: blur(8px);
    }

    .calendar-heading__pill {
        border-color: rgba(255,255,255,.28);
        box-shadow: none;
    }

    .calendar-card__body {
        padding: 16px;
        background: #eef5fb;
    }

    .calendar-scroll {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 4px;
    }

    #calendar {
        min-height: 760px;
    }

    .fc {
        color: var(--phase-navy);
    }

    .fc .fc-toolbar-title {
        color: var(--phase-navy);
        font-size: 1.15rem !important;
        font-weight: 900;
        text-align: center;
    }

    .fc .fc-header-toolbar {
        align-items: center;
        gap: 12px;
        margin-bottom: 14px !important;
        padding: 12px;
        border: 1px solid var(--phase-border);
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    }

    .fc .fc-toolbar-chunk {
        min-width: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 6px;
    }

    .fc .fc-button {
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,.10) !important;
        box-shadow: none !important;
        padding: .35rem .65rem;
    }

    .fc .fc-button-primary {
        background: var(--phase-teal) !important;
        border-color: transparent !important;
        color: #062b2f !important;
        font-weight: 900 !important;
    }

    .fc .fc-button-primary:not(:disabled):hover,
    .fc .fc-button-primary:not(:disabled):focus {
        color: #fff !important;
    }

    .fc .fc-daygrid-day-frame {
        padding: 8px;
        min-height: 130px;
    }

    .fc .fc-scrollgrid {
        overflow: hidden;
        border-color: var(--phase-border) !important;
        border-radius: 16px;
        box-shadow: 0 12px 28px rgba(15, 35, 64, .08);
    }

    .fc .fc-event {
        --phase-event-bg-start: #ffffff;
        --phase-event-bg-end: #f8fafc;
        --phase-event-border: var(--phase-border);
        background: linear-gradient(180deg, var(--phase-event-bg-start), var(--phase-event-bg-end)) !important;
        border: 2px solid var(--phase-event-border) !important;
        color: var(--phase-navy) !important;
        border-radius: 12px !important;
        padding: 8px 10px !important;
        font-size: 0.82rem;
        line-height: 1.4;
        white-space: normal !important;
        word-break: break-word;
        overflow: hidden;
        margin-bottom: 8px !important;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(15, 35, 64, .12) !important;
        transition: all .15s ease;
    }

    .fc .fc-event:hover {
        transform: translateY(-1px);
        box-shadow: 0 14px 24px rgba(15, 35, 64, .18) !important;
    }

    .fc .fc-event-title {
        color: var(--phase-navy) !important;
    }

    .fc-event.status-plan {
        --phase-event-bg-end: #f8fafc;
        --phase-event-border: #64748b;
    }

    .fc-event.status-progress {
        --phase-event-bg-end: #fff7ed;
        --phase-event-border: var(--phase-orange);
    }

    .fc-event.status-submitted,
    .fc-event.status-approved {
        --phase-event-bg-end: #f0fdf4;
        --phase-event-border: #22c55e;
    }

    .fc-event.status-rejected {
        --phase-event-bg-end: #fff1f2;
        --phase-event-border: var(--phase-pink);
    }

    .fc .fc-col-header-cell {
        background: var(--phase-navy) !important;
        color: #fff !important;
        border-color: rgba(255,255,255,.12) !important;
    }

    .fc .fc-col-header-cell-cushion {
        color: #fff !important;
        font-weight: 900;
        font-size: .95rem;
        text-shadow: none !important;
    }

    .fc .fc-day-head-weekday,
    .fc .fc-day-head-date {
        display: block;
        color: #ffffff;
        line-height: 1.2;
    }

    .fc .fc-day-head-date {
        margin-top: 2px;
        font-size: .75rem;
        font-weight: 800;
        opacity: .82;
    }

    .fc .fc-daygrid-day {
        background: var(--phase-soft) !important;
    }

    .fc .fc-daygrid-day.fc-day-other {
        background: var(--phase-soft-other) !important;
        opacity: .78;
    }

    .fc .fc-daygrid-day-number {
        color: var(--phase-navy) !important;
        font-weight: 700;
        font-size: .95rem;
    }

    .fc-scrollgrid,
    .fc-theme-standard td,
    .fc-theme-standard th {
        border-color: #e5e7eb !important;
    }

    .fc .fc-day-today {
        background: var(--phase-soft) !important;
        box-shadow: none;
    }

    .fc .fc-day-today .fc-daygrid-day-frame {
        min-height: 100% !important;
        height: 100% !important;
        background: transparent !important;
        box-shadow: none;
    }

    .fc .fc-day-today .fc-daygrid-day-number {
        background: var(--phase-teal-dark);
        color: #ffffff !important;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        box-shadow: 0 10px 20px rgba(15, 118, 110, .30);
    }

    .fc .fc-list {
        overflow: hidden;
        border: 1px solid var(--phase-border) !important;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 12px 28px rgba(15, 35, 64, .08);
    }

    .fc .fc-list-day-cushion {
        background: var(--phase-navy) !important;
        color: #ffffff !important;
        font-weight: 900;
    }

    .fc .fc-list-event td {
        border-color: #e5edf7 !important;
        color: var(--phase-navy);
        font-weight: 800;
    }

    .fc .fc-list-event:hover td {
        background: #ecfeff !important;
    }

    .phase-event-content {
        display: flex;
        align-items: flex-start;
        gap: 6px;
        color: var(--phase-navy);
        font-size: 12px;
        line-height: 1.3;
        font-weight: 800;
        padding: 2px 0;
        overflow: hidden;
    }

    .phase-event-dot {
        display: none;
    }

    .phase-event-text {
        min-width: 0;
        overflow: hidden;
        flex: 1;
    }

    .phase-event-title {
        color: var(--phase-navy);
        font-weight: 900;
        overflow: visible;
        white-space: normal;
        word-break: break-word;
    }

    .phase-event-subtitle {
        color: #475569;
        overflow: visible;
        white-space: normal;
        word-break: break-word;
    }

    .phase-event-status {
        margin-top: 3px;
        color: #0f766e;
        font-size: 11px;
        font-weight: 900;
    }

    .phase-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .phase-list-card {
        border: 1px solid rgba(15, 118, 110, .18) !important;
        border-radius: 18px !important;
        overflow: hidden;
        box-shadow: 0 14px 28px rgba(15, 35, 64, .09);
    }

    .phase-list-card .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 16px;
        color: #ffffff;
        background: var(--phase-navy) !important;
        border: 0;
        font-weight: 900;
    }

    .phase-list-card .card-header span {
        color: rgba(255, 255, 255, .72);
        font-size: .86rem;
        font-weight: 700;
    }

    .phase-list-card .card-body {
        padding: 12px;
        background: #eef5fb;
    }

    .phase-card {
        --phase-card-bg-start: #ffffff;
        --phase-card-bg-end: #f8fafc;
        --phase-card-border: var(--phase-border);
        display: block;
        background: linear-gradient(180deg, var(--phase-card-bg-start), var(--phase-card-bg-end));
        border-radius: 16px;
        padding: 16px;
        border: 2px solid var(--phase-card-border);
        color: inherit;
        text-decoration: none;
        cursor: pointer;
        box-shadow: 0 10px 22px rgba(15, 35, 64, .08);
        transition: transform .16s ease, box-shadow .16s ease;
    }

    .phase-card.status-plan {
        --phase-card-bg-end: #f8fafc;
        --phase-card-border: #64748b;
    }

    .phase-card.status-progress {
        --phase-card-bg-end: #fff7ed;
        --phase-card-border: var(--phase-orange);
    }

    .phase-card.status-submitted,
    .phase-card.status-approved {
        --phase-card-bg-end: #f0fdf4;
        --phase-card-border: #22c55e;
    }

    .phase-card.status-rejected {
        --phase-card-bg-end: #fff1f2;
        --phase-card-border: var(--phase-pink);
    }

    .phase-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 30px rgba(15, 35, 64, .14);
    }

    .phase-title {
        color: #10233f;
        font-size: 1.02rem;
        font-weight: 900;
        margin-bottom: 6px;
        line-height: 1.35;
    }

    .phase-detail {
        color: #64748b;
        font-size: .92rem;
        margin-bottom: 4px;
        font-weight: 700;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        color: #10233f;
        font-size: .8rem;
        font-weight: 900;
        background: rgba(20,184,166,.14);
    }
    /* ============================
       Responsive Calendar
    ============================ */
    @@media (min-width: 901px) and (max-width: 1199.98px) {
        .calendar-card__body {
            padding: 12px;
        }

        #calendar {
            min-width: 1080px;
        }

        .fc .fc-daygrid-day-frame {
            padding: 6px;
            min-height: 140px;
        }

        .phase-event-content {
            gap: 0;
        }
    }

    @@media (max-width: 900px) {
        .calendar-scroll {
            overflow-x: visible;
            padding-bottom: 0;
        }

        #calendar {
            min-width: 0;
        }
    }

    @@media (max-width: 768px) {

        .phase-calendar-page {
            padding: 4px 0;
        }

        .calendar-card__toolbar {
            flex-direction: column;
            align-items: stretch;
            text-align: left;
            padding: 16px;
            min-height: auto;
        }

        .calendar-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .calendar-heading__date {
            min-width: 0;
            width: auto;
            white-space: normal;
            text-align: left;
        }

        .calendar-heading__title {
            font-size: 1.08rem;
        }

        .calendar-heading__subtitle {
            font-size: .82rem;
        }

        .calendar-heading__meta {
            justify-content: flex-start;
        }

        .calendar-card__body {
            padding: 14px;
        }

        .fc-toolbar {
            flex-direction: column;
            gap: 10px;
            align-items: stretch !important;
        }

        .fc-toolbar-chunk {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 6px;
        }

        .fc .fc-toolbar-title {
            font-size: 1.1rem !important;
            text-align: center;
        }

        #calendar {
            min-height: 620px;
        }

        .fc .fc-event {
            padding: 6px 8px !important;
            font-size: 11px !important;
            border-radius: 10px !important;
        }

        .fc-daygrid-event {
            white-space: normal !important;
        }

        .fc .fc-daygrid-day-frame {
            min-height: 90px;
        }

        .fc .fc-col-header-cell-cushion {
            font-size: .8rem !important;
        }

        .fc .fc-daygrid-day-number {
            font-size: .8rem !important;
        }

        .phase-list-card .card-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="container phase-calendar-page">
    <div class="calendar-card">
        <div class="calendar-card__toolbar">
            <div class="calendar-heading">
                <span class="calendar-heading__date" id="calendarThaiDate">วันศุกร์ ที่ 19 มิถุนายน 2569</span>
                <div>
                    <span class="calendar-heading__eyebrow">Phase Calendar</span>
                    <strong class="calendar-heading__title">ปฏิทินกำหนดส่งงาน</strong>
                    <span class="calendar-heading__subtitle">ตารางกำหนดส่งงวดงานและรายการที่ต้องติดตาม</span>
                </div>
            </div>
            <div class="calendar-heading__meta" aria-label="Calendar actions">
                <a class="calendar-heading__action" asp-controller="Home" asp-action="Index" title="กลับ Dashboard">
                    Dashboard
                </a>
                <span class="calendar-heading__pill">งานที่ยังต้องติดตาม</span>
            </div>
        </div>
        <div class="calendar-card__body">
            <div class="calendar-scroll">
                <div id="calendar"></div>
            </div>

            <div class="row mt-3">
                <div class="col-12">
                    <div class="card w-100 phase-list-card">
                        <div class="card-header">
                            <strong>รายการกำหนดส่งงาน</strong>
                            <span>เรียงตามวันกำหนดส่งใกล้สุดก่อน</span>
                        </div>
                        <div class="card-body">
                            <div id="phaseList" class="phase-list"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const calendarEl = document.getElementById('calendar');
        const compactCalendarMedia = window.matchMedia('(max-width: 900px)');
        const isCompactCalendar = () => compactCalendarMedia.matches;
        const calendarThaiDateEl = document.getElementById('calendarThaiDate');
        const thaiWeekdays = ['วันอาทิตย์', 'วันจันทร์', 'วันอังคาร', 'วันพุธ', 'วันพฤหัสบดี', 'วันศุกร์', 'วันเสาร์'];
        const thaiMonths = [
            'มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน',
            'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'
        ];
        const thaiMonthsShort = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];

        function formatThaiDateFull(value) {
            if (!value) return '';

            const date = value instanceof Date ? value : new Date(value);
            if (Number.isNaN(date.getTime())) return '';

            return `${thaiWeekdays[date.getDay()]} ที่ ${date.getDate()} ${thaiMonths[date.getMonth()]} ${date.getFullYear() + 543}`;
        }

        function formatThaiDateShort(value) {
            if (!value) return '';

            const date = value instanceof Date ? value : new Date(value);
            if (Number.isNaN(date.getTime())) return '';

            return `${date.getDate()} ${thaiMonthsShort[date.getMonth()]} ${date.getFullYear() + 543}`;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }

        function phaseStatusColor(status) {
            if (status === 'วางแผน') return '#64748b';
            if (status === 'กำลังดำเนินการ') return '#f59e0b';
            if (status === 'ส่งงวดงานแล้ว') return '#22c55e';
            if (status === 'อนุมัติแล้ว') return '#22c55e';
            if (status === 'ตีกลับ') return '#ef4444';
            return '#64748b';
        }

        function phaseStatusClass(status) {
            if (status === 'วางแผน') return 'status-plan';
            if (status === 'กำลังดำเนินการ') return 'status-progress';
            if (status === 'ส่งงวดงานแล้ว') return 'status-submitted';
            if (status === 'อนุมัติแล้ว') return 'status-approved';
            if (status === 'ตีกลับ') return 'status-rejected';
            return 'status-plan';
        }

        if (calendarThaiDateEl) {
            calendarThaiDateEl.textContent = formatThaiDateFull(new Date());
        }

        const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: isCompactCalendar()
                ? 'listMonth'
                : 'dayGridMonth',
            locale: 'th',
            dayHeaderContent: function(arg) {
                const weekday = thaiWeekdays[arg.date.getDay()];
                if (arg.view.type === 'dayGridMonth') {
                    return { html: `<span class="fc-day-head-weekday">${weekday}</span>` };
                }

                return {
                    html: `<span class="fc-day-head-weekday">${weekday}</span><span class="fc-day-head-date">${arg.date.getDate()} ${thaiMonthsShort[arg.date.getMonth()]}</span>`
                };
            },
            height: 'auto',
            headerToolbar: {
                left: 'prev,next',
                center: 'title',
                right: isCompactCalendar()
                    ? 'listMonth'
                    : 'dayGridMonth,listMonth'
            },

            firstDay: 0,

            buttonText: {
                today: 'วันนี้',
                month: 'เดือน',
                list: 'รายการ'
            },

            events: async function(fetchInfo, successCallback, failureCallback) {
                try {
                    const response = await fetch('/PhaseCalendar/List');
                    const data = await response.json();

                    const filtered = data.filter(x =>
                        ['วางแผน', 'กำลังดำเนินการ', 'ตีกลับ']
                            .includes(x.extendedProps?.phaseStatus)
                    );

                    successCallback(filtered);
                } catch (err) {
                    failureCallback(err);
                }
            },

            eventContent: function (arg) {
                const props = arg.event.extendedProps;
                const statusColor = phaseStatusColor(props.phaseStatus);

                return {
                    html: `
                        <div class="phase-event-content" style="color:${statusColor}">
                            <span class="phase-event-dot"></span>
                            <div class="phase-event-text">
                                <div class="phase-event-title">
                                    ${escapeHtml(props.projectName ?? '-')}
                                </div>

                                <div class="phase-event-subtitle">
                                    ${escapeHtml(props.phaseName ?? '-')}
                                </div>

                                <div class="phase-event-status" style="color:${statusColor}">
                                    ${escapeHtml(props.phaseStatus ?? '-')}
                                </div>
                            </div>
                        </div>
                    `
                }
            },

            eventClassNames: function (arg) {
                return [phaseStatusClass(arg.event.extendedProps?.phaseStatus)];
            },

            eventClick: function(info) {
                const projectId = info.event.extendedProps.projectId;

                if (projectId) {
                    // เปิดหน้า Phase ของ Project
                    window.location.href = `/ProjectPhases?projectId=${projectId}`;
                }
            }
        });

        function getCalendarThaiTitle() {
            const view = calendar.view;
            const current = calendar.getDate();

            if (view.type === 'dayGridMonth' || view.type === 'listMonth') {
                const prefix = view.type === 'listMonth' ? 'รายการกำหนดส่ง ' : '';
                return `${prefix}${thaiMonths[current.getMonth()]} ${current.getFullYear() + 543}`;
            }

            const start = new Date(view.currentStart || view.activeStart);
            const end = new Date(view.currentEnd || view.activeEnd);
            end.setDate(end.getDate() - 1);

            return `${formatThaiDateShort(start)} - ${formatThaiDateShort(end)}`;
        }

        function syncCalendarThaiTitle() {
            const titleEl = calendarEl.querySelector('.fc-toolbar-title');
            if (titleEl) {
                titleEl.textContent = getCalendarThaiTitle();
            }
        }

        calendar.render();
        syncCalendarThaiTitle();

        function syncCalendarResponsiveMode() {
            if (isCompactCalendar()) {
                calendar.setOption('headerToolbar', {
                    left: 'prev,next',
                    center: 'title',
                    right: 'listMonth'
                });

                if (calendar.view.type !== 'listMonth') {
                    calendar.changeView('listMonth');
                }

                return;
            }

            calendar.setOption('headerToolbar', {
                left: 'prev,next',
                center: 'title',
                right: 'dayGridMonth,listMonth'
            });

            if (calendar.view.type === 'listMonth') {
                calendar.changeView('dayGridMonth');
            }
        }

        if (compactCalendarMedia.addEventListener) {
            compactCalendarMedia.addEventListener('change', syncCalendarResponsiveMode);
        } else if (compactCalendarMedia.addListener) {
            compactCalendarMedia.addListener(syncCalendarResponsiveMode);
        }

        calendar.on('datesSet', function () {
            syncCalendarThaiTitle();
        });

        loadPhaseList();
    });

    async function loadPhaseList() {

        const response = await fetch('/PhaseCalendar/List');
        const data = await response.json();

        const container = document.getElementById('phaseList');
        container.innerHTML = '';

        data
        .filter(item =>
            ['วางแผน', 'กำลังดำเนินการ', 'ตีกลับ']
                .includes(item.extendedProps?.phaseStatus)
        )
        .sort((a, b) => {
            const dateA = a.extendedProps?.planEnd
                ? new Date(a.extendedProps.planEnd)
                : new Date('9999-12-31');

            const dateB = b.extendedProps?.planEnd
                ? new Date(b.extendedProps.planEnd)
                : new Date('9999-12-31');

            return dateA - dateB;
        })
        .forEach(item => {

            const statusColor =
                item.extendedProps.phaseStatus === 'วางแผน' ? '#94a3b8' :
                item.extendedProps.phaseStatus === 'กำลังดำเนินการ' ? '#f59e0b' :
                item.extendedProps.phaseStatus === 'ส่งงวดงานแล้ว' ? '#22c55e' :
                item.extendedProps.phaseStatus === 'อนุมัติแล้ว' ? '#22c55e' :
                item.extendedProps.phaseStatus === 'ตีกลับ' ? '#ef4444' : '#64748b';
            const statusClass =
                item.extendedProps.phaseStatus === 'วางแผน' ? 'status-plan' :
                item.extendedProps.phaseStatus === 'กำลังดำเนินการ' ? 'status-progress' :
                item.extendedProps.phaseStatus === 'ส่งงวดงานแล้ว' ? 'status-submitted' :
                item.extendedProps.phaseStatus === 'อนุมัติแล้ว' ? 'status-approved' :
                item.extendedProps.phaseStatus === 'ตีกลับ' ? 'status-rejected' : 'status-plan';
            const projectId = item.extendedProps.projectId;
            const href = projectId ? `/ProjectPhases?projectId=${projectId}` : '/ProjectPhases';

            container.innerHTML += `
                <a class="phase-card ${statusClass}" href="${href}">

                    <div class="phase-title">
                        ${escapePhaseHtml(item.extendedProps.projectName)}
                    </div>

                    <div class="phase-detail">
                        <strong>Phase:</strong>
                        ${escapePhaseHtml(item.extendedProps.phaseName)}
                    </div>

                    <div class="phase-detail">
                        <strong>กำหนดส่งงวดงาน:</strong>
                        ${formatDate(item.extendedProps.periodEndDate)}
                    </div>

                    <div class="phase-detail">
                        <strong>กำหนดส่ง:</strong>
                        ${formatDate(item.extendedProps.planEnd)}
                    </div>

                    <span class="status-badge"
                          style="color:${statusColor};background:${statusColor}22;">
                        ${escapePhaseHtml(item.extendedProps.phaseStatus)}
                    </span>
                </a>
            `;
        });
    }

    function escapePhaseHtml(text) {
        const div = document.createElement('div');
        div.textContent = text || '';
        return div.innerHTML;
    }

    function formatDate(dateString) {
        if (!dateString) return '-';

        const date = new Date(dateString);

        return date.toLocaleDateString('th-TH', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
            year: 'numeric'
        });
    }
</script>

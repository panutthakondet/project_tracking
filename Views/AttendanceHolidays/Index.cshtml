@{
    ViewData["Title"] = "จัดการวันหยุด";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" />
    <style>
        .holiday-page {
            --holiday-text: var(--pt-surface-contrast, #0f172a);
            --holiday-muted: var(--pt-surface-contrast-muted, #64748b);
            color: var(--holiday-text);
            padding: 20px;
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
        }

        .holiday-hero,
        .holiday-calendar-panel {
            border: 1px solid var(--pt-border, #cbd5e1);
            background: var(--pt-surface, #fff);
            box-shadow: 0 16px 36px rgba(15, 23, 42, .08);
        }

        .holiday-hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 16px;
            padding: 22px 24px;
            border-radius: 14px;
        }

        .holiday-title-wrap {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .holiday-title-icon {
            display: grid;
            width: 52px;
            height: 52px;
            flex: 0 0 52px;
            place-items: center;
            border-radius: 12px;
            color: #fff;
            background: linear-gradient(145deg, var(--pt-accent, #14b8a6), var(--pt-accent-dark, #0f766e));
            box-shadow: 0 8px 20px var(--pt-accent-glow, rgba(20, 184, 166, .22));
            font-size: 25px;
        }

        .holiday-title {
            margin: 0;
            font-size: clamp(1.35rem, 2vw, 1.85rem);
            font-weight: 700;
            line-height: 1.25;
            color: var(--holiday-text);
            text-shadow: none;
        }

        .holiday-subtitle {
            margin: 5px 0 0;
            color: var(--holiday-muted);
            font-size: .95rem;
            font-weight: 400;
        }

        .holiday-add-button {
            min-height: 44px;
            padding: 10px 18px;
            border: 1px solid var(--pt-accent, #14b8a6);
            border-radius: 10px;
            color: #fff;
            background: var(--pt-accent-dark, #0f766e);
            font-weight: 600;
            white-space: nowrap;
            transition: transform .15s ease, filter .15s ease;
        }

        .holiday-hero-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 10px;
        }

        .holiday-back-button {
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 10px 16px;
            border: 1px solid var(--pt-border, #cbd5e1);
            border-radius: 10px;
            color: var(--holiday-text);
            background: var(--pt-surface, #fff);
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
        }

        .holiday-back-button:hover {
            color: var(--holiday-text);
            border-color: var(--pt-accent, #14b8a6);
            background: var(--pt-accent-soft, #ecfdf5);
        }

        .holiday-add-button:hover {
            color: #fff;
            filter: brightness(1.08);
            transform: translateY(-1px);
        }

        .holiday-calendar-panel {
            padding: 20px;
            border-radius: 14px;
            overflow: visible;
        }

        .holiday-calendar-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px 16px;
            margin-bottom: 16px;
        }

        .holiday-legend {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            color: var(--holiday-muted);
            font-size: .9rem;
        }

        .holiday-legend-item {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .holiday-legend-dot {
            width: 11px;
            height: 11px;
            border: 2px solid currentColor;
            background: transparent;
        }

        .holiday-legend-active { color: #dc2626; }
        .holiday-legend-inactive { color: #64748b; }

        .holiday-note {
            color: var(--holiday-muted);
            font-size: .86rem;
        }

        #holidayCalendar {
            min-height: 650px;
        }

        #holidayCalendar .fc {
            color: var(--holiday-text);
            font-family: inherit;
            font-size: .92rem;
        }

        #holidayCalendar .fc-theme-standard td,
        #holidayCalendar .fc-theme-standard th,
        #holidayCalendar .fc-theme-standard .fc-scrollgrid {
            border-color: var(--pt-border, #dbe5ef);
        }

        #holidayCalendar .fc-col-header-cell {
            padding: 9px 4px;
            background: var(--pt-surface-soft, #f8fafc);
        }

        #holidayCalendar .fc-col-header-cell-cushion,
        #holidayCalendar .fc-daygrid-day-number {
            color: var(--holiday-text);
            text-decoration: none;
            font-weight: 500;
        }

        #holidayCalendar .fc-day-today {
            background: var(--pt-accent-soft, rgba(20, 184, 166, .08)) !important;
        }

        #holidayCalendar .fc-button-primary {
            border-color: var(--pt-accent, #14b8a6);
            background: var(--pt-accent-dark, #0f766e);
            box-shadow: none;
            font-weight: 500;
        }

        #holidayCalendar .fc-button-primary:hover,
        #holidayCalendar .fc-button-primary:not(:disabled).fc-button-active {
            border-color: var(--pt-accent-dark, #0f766e);
            background: var(--pt-accent, #14b8a6);
        }

        #holidayCalendar .fc-toolbar-title {
            color: var(--holiday-text);
            font-size: 1.25rem;
            font-weight: 700;
            text-shadow: none;
        }

        #holidayCalendar .fc-daygrid-event,
        #holidayCalendar .fc-list-event {
            border-width: 2px !important;
            border-radius: 5px;
            padding: 3px 6px;
            box-shadow: none;
            cursor: pointer;
            font-weight: 500;
        }

        #holidayCalendar .holiday-event-inactive {
            border-style: dashed !important;
            opacity: .72;
        }

        #holidayCalendar .fc-list {
            border-color: var(--pt-border, #dbe5ef);
        }

        #holidayCalendar .fc-list-day-cushion,
        #holidayCalendar .fc-list-event:hover td {
            background: var(--pt-surface-soft, #f8fafc);
        }

        .holiday-feedback {
            display: none;
            margin-bottom: 14px;
            padding: 10px 14px;
            border: 1px solid;
            border-radius: 8px;
            font-size: .92rem;
        }

        .holiday-feedback.is-success {
            display: block;
            border-color: #86efac;
            color: #166534;
            background: #f0fdf4;
        }

        .holiday-feedback.is-error {
            display: block;
            border-color: #fca5a5;
            color: #991b1b;
            background: #fef2f2;
        }

        #holidayModal {
            --holiday-text: var(--pt-surface-contrast, #0f172a);
            --holiday-muted: var(--pt-surface-contrast-muted, #64748b);
            z-index: 26010;
        }

        .modal-backdrop.show {
            z-index: 26000;
        }

        #holidayModal .modal-content {
            border: 1px solid var(--pt-border, #cbd5e1);
            border-radius: 12px;
            color: var(--holiday-text);
            background: var(--pt-surface, #fff);
            box-shadow: 0 24px 70px rgba(15, 23, 42, .24);
        }

        #holidayModal .modal-header,
        #holidayModal .modal-footer {
            border-color: var(--pt-border, #dbe5ef);
        }

        #holidayModal .modal-title,
        #holidayModal .form-label {
            color: var(--holiday-text);
            font-weight: 600;
            text-shadow: none;
        }

        #holidayModal .form-control {
            min-height: 45px;
            border-color: var(--pt-border, #cbd5e1);
            border-radius: 8px;
            color: var(--holiday-text);
            background: var(--pt-surface, #fff);
            font-weight: 400;
        }

        #holidayModal .form-control:focus {
            border-color: var(--pt-accent, #14b8a6);
            box-shadow: 0 0 0 3px var(--pt-accent-soft, rgba(20, 184, 166, .12));
        }

        #holidayModal .form-check-input:checked {
            border-color: var(--pt-accent, #14b8a6);
            background-color: var(--pt-accent, #14b8a6);
        }

        .holiday-modal-save,
        .holiday-modal-toggle {
            min-height: 42px;
            border-radius: 8px;
            padding: 8px 16px;
            font-weight: 600;
        }

        .holiday-modal-save {
            border: 1px solid var(--pt-accent, #14b8a6);
            color: #fff;
            background: var(--pt-accent-dark, #0f766e);
        }

        .holiday-modal-toggle {
            display: none;
            margin-right: auto;
            border: 1px solid #dc2626;
            color: #dc2626;
            background: transparent;
        }

        .holiday-modal-toggle.is-inactive {
            border-color: #16a34a;
            color: #15803d;
        }

        @@media (max-width: 767.98px) {
            .holiday-page { padding: 12px; }
            .holiday-hero { align-items: stretch; flex-direction: column; padding: 18px; }
            .holiday-hero-actions { align-items: stretch; flex-direction: column; }
            .holiday-add-button,
            .holiday-back-button { width: 100%; }
            .holiday-calendar-panel { padding: 12px; }
            #holidayCalendar { min-height: 560px; }
            #holidayCalendar .fc-header-toolbar { align-items: stretch; flex-direction: column; gap: 10px; }
            #holidayCalendar .fc-toolbar-chunk { display: flex; justify-content: center; }
        }
    </style>
}

<div class="holiday-page">
    <section class="holiday-hero">
        <div class="holiday-title-wrap">
            <div class="holiday-title-icon" aria-hidden="true">📅</div>
            <div>
                <h1 class="holiday-title">จัดการวันหยุด</h1>
                <p class="holiday-subtitle">กำหนดวันหยุดของบริษัทและวันหยุดนักขัตฤกษ์สำหรับระบบลงเวลา</p>
            </div>
        </div>
        <div class="holiday-hero-actions">
            <a class="holiday-back-button" asp-controller="SystemConfigs" asp-action="Index">← กลับไปตั้งค่าระบบ</a>
            <button type="button" class="holiday-add-button" id="addHolidayButton">＋ เพิ่มวันหยุด</button>
        </div>
    </section>

    <section class="holiday-calendar-panel">
        <div id="holidayFeedback" class="holiday-feedback" role="status" aria-live="polite"></div>
        <div class="holiday-calendar-toolbar">
            <div class="holiday-legend" aria-label="คำอธิบายสถานะ">
                <span class="holiday-legend-item holiday-legend-active"><span class="holiday-legend-dot"></span> เปิดใช้งาน</span>
                <span class="holiday-legend-item holiday-legend-inactive"><span class="holiday-legend-dot"></span> ปิดใช้งาน</span>
            </div>
            <div class="holiday-note">คลิกวันที่เพื่อเพิ่ม หรือคลิกรายการเพื่อแก้ไข</div>
        </div>
        <div id="holidayCalendar"></div>
    </section>
</div>

<form id="holidayTokenForm" class="d-none">@Html.AntiForgeryToken()</form>

<div class="modal fade" id="holidayModal" tabindex="-1" aria-labelledby="holidayModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="holidayModalTitle">เพิ่มวันหยุด</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="holidayOriginalDate" />
                <div class="mb-3">
                    <label for="holidayDate" class="form-label">วันที่ <span class="text-danger">*</span></label>
                    <input type="date" class="form-control" id="holidayDate" required />
                </div>
                <div class="mb-3">
                    <label for="holidayName" class="form-label">ชื่อวันหยุด <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="holidayName" maxlength="200" placeholder="เช่น วันขึ้นปีใหม่" required />
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="holidayIsActive" checked />
                    <label class="form-check-label" for="holidayIsActive">นำไปคำนวณเป็นวันหยุด</label>
                </div>
                <div id="holidayModalError" class="text-danger mt-3 small" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="holiday-modal-toggle" id="toggleHolidayButton">ปรับสถานะเป็นปิดใช้งาน</button>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">ปิด</button>
                <button type="button" class="holiday-modal-save" id="saveHolidayButton">บันทึก</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/locales-all.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const calendarElement = document.getElementById('holidayCalendar');
            const modalElement = document.getElementById('holidayModal');

            // Keep the modal and Bootstrap backdrop in the same root stacking
            // context. The application shell creates its own stacking context,
            // which otherwise leaves the backdrop above the dialog.
            if (modalElement.parentElement !== document.body) {
                document.body.appendChild(modalElement);
            }

            const holidayModal = bootstrap.Modal.getOrCreateInstance(modalElement);
            const titleElement = document.getElementById('holidayModalTitle');
            const originalDateElement = document.getElementById('holidayOriginalDate');
            const dateElement = document.getElementById('holidayDate');
            const nameElement = document.getElementById('holidayName');
            const activeElement = document.getElementById('holidayIsActive');
            const saveButton = document.getElementById('saveHolidayButton');
            const toggleButton = document.getElementById('toggleHolidayButton');
            const modalError = document.getElementById('holidayModalError');
            const feedback = document.getElementById('holidayFeedback');
            const token = document.querySelector('#holidayTokenForm input[name="__RequestVerificationToken"]').value;
            const thaiMonths = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน', 'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'];

            const calendar = new FullCalendar.Calendar(calendarElement, {
                locale: 'th',
                initialView: window.matchMedia('(max-width: 767.98px)').matches ? 'listMonth' : 'dayGridMonth',
                firstDay: 0,
                height: 'auto',
                fixedWeekCount: false,
                dayMaxEvents: true,
                displayEventTime: false,
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,listMonth'
                },
                buttonText: {
                    today: 'วันนี้',
                    month: 'เดือน',
                    list: 'รายการ'
                },
                events: '@Url.Action("Events", "AttendanceHolidays")',
                dateClick: function (info) {
                    openCreateModal(info.dateStr);
                },
                eventClick: function (info) {
                    const props = info.event.extendedProps;
                    openEditModal(props.holidayDate, props.holidayName, props.isActive);
                },
                eventClassNames: function (arg) {
                    return arg.event.extendedProps.isActive ? [] : ['holiday-event-inactive'];
                },
                datesSet: syncThaiTitle
            });

            calendar.render();
            syncThaiTitle();

            document.getElementById('addHolidayButton').addEventListener('click', function () {
                const now = new Date();
                const localDate = new Date(now.getTime() - (now.getTimezoneOffset() * 60000)).toISOString().slice(0, 10);
                openCreateModal(localDate);
            });

            saveButton.addEventListener('click', saveHoliday);
            toggleButton.addEventListener('click', toggleHoliday);

            function syncThaiTitle() {
                window.requestAnimationFrame(function () {
                    const toolbarTitle = calendarElement.querySelector('.fc-toolbar-title');
                    if (!toolbarTitle) return;
                    const current = calendar.getDate();
                    toolbarTitle.textContent = `${thaiMonths[current.getMonth()]} ${current.getFullYear() + 543}`;
                });
            }

            function openCreateModal(date) {
                titleElement.textContent = 'เพิ่มวันหยุด';
                originalDateElement.value = '';
                dateElement.value = date || '';
                nameElement.value = '';
                activeElement.checked = true;
                toggleButton.style.display = 'none';
                modalError.textContent = '';
                holidayModal.show();
                modalElement.addEventListener('shown.bs.modal', function focusName() {
                    nameElement.focus();
                    modalElement.removeEventListener('shown.bs.modal', focusName);
                });
            }

            function openEditModal(date, name, isActive) {
                titleElement.textContent = 'แก้ไขวันหยุด';
                originalDateElement.value = date;
                dateElement.value = date;
                nameElement.value = name || '';
                activeElement.checked = isActive === true || isActive === 'true';
                toggleButton.style.display = 'inline-flex';
                toggleButton.classList.toggle('is-inactive', !activeElement.checked);
                toggleButton.textContent = activeElement.checked
                    ? 'ปรับสถานะเป็นปิดใช้งาน'
                    : 'ปรับสถานะเป็นเปิดใช้งาน';
                modalError.textContent = '';
                holidayModal.show();
            }

            async function saveHoliday() {
                modalError.textContent = '';
                if (!dateElement.value || !nameElement.value.trim()) {
                    modalError.textContent = 'กรุณาระบุวันที่และชื่อวันหยุด';
                    return;
                }

                setBusy(saveButton, true, 'กำลังบันทึก...');
                const body = new URLSearchParams({
                    __RequestVerificationToken: token,
                    holidayDate: dateElement.value,
                    holidayName: nameElement.value.trim(),
                    originalDate: originalDateElement.value,
                    isActive: activeElement.checked ? 'true' : 'false'
                });

                try {
                    const response = await fetch('@Url.Action("Save", "AttendanceHolidays")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                        body
                    });
                    const result = await readJson(response);
                    if (!response.ok || !result.success) throw new Error(result.message || 'บันทึกไม่สำเร็จ');

                    holidayModal.hide();
                    calendar.refetchEvents();
                    showFeedback(result.message, false);
                } catch (error) {
                    modalError.textContent = error.message || 'บันทึกไม่สำเร็จ';
                } finally {
                    setBusy(saveButton, false, 'บันทึก');
                }
            }

            async function toggleHoliday() {
                const holidayDate = originalDateElement.value;
                if (!holidayDate) return;

                modalError.textContent = '';
                setBusy(toggleButton, true, 'กำลังดำเนินการ...');
                const body = new URLSearchParams({
                    __RequestVerificationToken: token,
                    holidayDate
                });

                try {
                    const response = await fetch('@Url.Action("Toggle", "AttendanceHolidays")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                        body
                    });
                    const result = await readJson(response);
                    if (!response.ok || !result.success) throw new Error(result.message || 'ปรับสถานะไม่สำเร็จ');

                    holidayModal.hide();
                    calendar.refetchEvents();
                    showFeedback(result.message, false);
                } catch (error) {
                    modalError.textContent = error.message || 'ปรับสถานะไม่สำเร็จ';
                } finally {
                    setBusy(
                        toggleButton,
                        false,
                        activeElement.checked
                            ? 'ปรับสถานะเป็นปิดใช้งาน'
                            : 'ปรับสถานะเป็นเปิดใช้งาน');
                }
            }

            async function readJson(response) {
                try {
                    return await response.json();
                } catch {
                    return { success: false, message: 'ระบบตอบกลับไม่ถูกต้อง กรุณาลองใหม่' };
                }
            }

            function setBusy(button, busy, label) {
                button.disabled = busy;
                button.textContent = label;
            }

            function showFeedback(message, isError) {
                feedback.textContent = message;
                feedback.className = `holiday-feedback ${isError ? 'is-error' : 'is-success'}`;
                window.clearTimeout(showFeedback.timer);
                showFeedback.timer = window.setTimeout(function () {
                    feedback.className = 'holiday-feedback';
                }, 4500);
            }
        });
    </script>
}



@{
    ViewData["Title"] = "Upload Document";
    var projectId = ViewBag.ProjectId;
    var documentTypes = ViewBag.DocumentTypes as IEnumerable<ProjectTracking.Models.ProjectDocumentType> ?? Enumerable.Empty<ProjectTracking.Models.ProjectDocumentType>();
}

<div class="container">

    <h3 class="mb-3">⬆ Upload Project Document</h3>

    <div class="card">

        <div class="card-body">

            <form asp-action="Upload" method="post" enctype="multipart/form-data">

                <input type="hidden" name="projectId" value="@projectId" />

                <div class="mb-3">
                    <label class="form-label">Document Type</label>
                    <select name="documentType" class="form-select" required>
                        <option value="" selected disabled>-- เลือกประเภทเอกสาร --</option>
                        @foreach (var documentType in documentTypes)
                        {
                            <option value="@documentType.DocumentTypeCode">@documentType.DocumentTypeName</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Select File</label>
                    <input type="file" name="file" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="documentDescription">คำอธิบาย (ไม่บังคับ)</label>
                    <textarea id="documentDescription" name="description" class="form-control" rows="3" maxlength="2000" placeholder="รายละเอียดเพิ่มเติมของเอกสาร" aria-describedby="documentDescriptionHelp"></textarea>
                    <div id="documentDescriptionHelp" class="form-text text-muted">ใส่ได้ไม่เกิน 2,000 ตัวอักษร</div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        ⬆ Upload
                    </button>

                    <a asp-action="Index" asp-route-projectId="@projectId" class="btn btn-secondary">
                        ← Back
                    </a>
                </div>

            </form>

        </div>

    </div>

</div>

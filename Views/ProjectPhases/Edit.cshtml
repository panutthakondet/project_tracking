@model ProjectTracking.Models.ProjectPhase

@{
    ViewData["Title"] = "แก้ไขส่วนงานโครงการ";

    DateTime? planStart = Model?.PlanStart;
    DateTime? planEnd = Model?.PlanEnd;
    DateTime? actualEnd = Model?.ActualEnd;

    var ps = planStart.GetValueOrDefault();
    var pe = planEnd.GetValueOrDefault();
    var ape = actualEnd.GetValueOrDefault();

    string planStartText = planStart.HasValue
        ? $"{ps:dd/MM/}{ps.Year + 543}"
        : "";

    string planEndText = planEnd.HasValue
        ? $"{pe:dd/MM/}{pe.Year + 543}"
        : "";

    string actualEndText = actualEnd.HasValue
        ? $"{ape:dd/MM/}{ape.Year + 543}"
        : "";

    var requirementProjectCardDetailUrlTemplate = Url.Action("ProjectCardDetails", "RequirementBoard", new { projectId = "__PROJECT_ID__" }) ?? "";
}

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">แก้ไขส่วนงานโครงการ</h2>
        <p class="index-subtitle">แก้ไขรายละเอียดส่วนงาน งวดงาน แผนงาน และสถานะของโครงการ</p>
    </div>

</div>

<div class="card shadow-sm pt-form-card">
    <div class="card-body">

        <form asp-action="Edit"
              asp-route-id="@(Model?.PhaseId ?? 0)"
              method="post"
              onsubmit="return confirm('บันทึกการแก้ไขส่วนงานนี้หรือไม่?');">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="PhaseId" />
            <input type="hidden" asp-for="ProjectId" />

            <div class="project-board-card-picker project-board-card-picker--button mb-3">
                <button id="RequirementCardDetailButton"
                        type="button"
                        class="btn btn-outline-primary project-board-card-detail"
                        data-detail-project-url-template="@requirementProjectCardDetailUrlTemplate"
                        data-project-field-id="ProjectId">
                    ดูรายละเอียด Project Board
                </button>
            </div>

            <div class="row g-3">

                <!-- Phase Name -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">ชื่องวดงาน</label>
                    <input asp-for="PhaseName"
                           class="form-control"
                           placeholder="ระบุชื่องวดงาน" />
                    <span asp-validation-for="PhaseName"
                          class="text-danger"></span>
                </div>

                <!-- Phase Order -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">ส่วนที่</label>
                    <input asp-for="PhaseOrder"
                           type="number"
                           class="form-control" />
                    <span asp-validation-for="PhaseOrder"
                          class="text-danger"></span>
                </div>

                <!-- Period Order -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">งวดที่</label>
                    <input asp-for="PeriodOrder"
                           type="number"
                           class="form-control" />
                    <span asp-validation-for="PeriodOrder"
                          class="text-danger"></span>
                </div>

                <!-- Phase Type -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">ประเภท</label>
                    <select asp-for="PhaseType"
                            asp-items="ViewBag.PhaseTypeList"
                            class="form-select"
                            id="phaseTypeSelect">
                    </select>
                </div>

                <!-- Phase Status -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">สถานะงาน</label>
                    <select asp-for="StatusId"
                            asp-items="ViewBag.ProjectPhaseStatuses"
                            class="form-select">
                        <option value="">-- เลือกสถานะ --</option>
                    </select>
                    <span asp-validation-for="StatusId" class="text-danger"></span>
                </div>

                <!-- CHECKBOX -->
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="copyPreviousDatesEdit" />
                        <label class="form-check-label fw-semibold">
                            ใช้วันที่จากส่วนงานก่อนหน้า
                        </label>
                    </div>
                </div>

                <!-- Plan Start -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">กำหนดวันที่เริ่ม</label>
                    <input asp-for="PlanStart"
                           type="text"
                           class="form-control thai-date"
                           id="editPlanStart"
                           value="@planStartText"
                           placeholder="วัน/เดือน/พ.ศ." />
                </div>

                <!-- Plan End -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">กำหนดวันที่สิ้นสุด</label>
                    <input asp-for="PlanEnd"
                           type="text"
                           class="form-control thai-date"
                           id="editPlanEnd"
                           value="@planEndText"
                           placeholder="วัน/เดือน/พ.ศ." />
                </div>

                <!-- Period Due -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">กำหนดส่งวันที่</label>
                    <input asp-for="ActualEnd"
                           type="text"
                           class="form-control thai-date"
                           id="editPeriodEnd"
                           value="@actualEndText"
                           placeholder="วัน/เดือน/พ.ศ." />
                </div>

            </div>

            <div class="pt-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    บันทึกการแก้ไข
                </button>

                <a asp-action="Index"
                   asp-route-projectId="@(Model?.ProjectId ?? 0)"
                   class="btn btn-outline-secondary">
                    กลับ
                </a>
            </div>

        </form>
    </div>
</div>

<partial name="_RequirementCardDetailModal" />

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <!-- Copy Previous Dates Script (Safe Version) -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const checkbox = document.getElementById("copyPreviousDatesEdit");

            const planStart = document.getElementById("editPlanStart");
            const planEnd = document.getElementById("editPlanEnd");
            const periodEnd = document.getElementById("editPeriodEnd");

            const lastPlanStart = '@(ViewBag.LastPlanStart ?? "")';
            const lastPlanEnd = '@(ViewBag.LastPlanEnd ?? "")';
            const lastPeriodEnd = '@(ViewBag.LastPeriodEnd ?? "")';

            if (!checkbox) return;

            function toThaiDate(dateStr) {
                if (!dateStr) return "";

                const parts = dateStr.split('-');
                if (parts.length !== 3) return dateStr;

                const [y, m, d] = parts;
                return `${d}/${m}/${parseInt(y) + 543}`;
            }

            checkbox.addEventListener("change", function () {

                if (this.checked) {

                    if (lastPlanStart !== "") planStart.value = toThaiDate(lastPlanStart);
                    if (lastPlanEnd !== "") planEnd.value = toThaiDate(lastPlanEnd);
                    if (lastPeriodEnd !== "") periodEnd.value = toThaiDate(lastPeriodEnd);

                }
            });

        });
    </script>
    <script>
        function convertThaiDateToIso(value) {
            if (!value || !value.trim()) return '';

            const parts = value.trim().split('/');
            if (parts.length !== 3) return value;

            let [d, m, y] = parts;

            d = d.padStart(2, '0');
            m = m.padStart(2, '0');
            y = parseInt(y, 10);

            if (y > 2400) {
                y -= 543;
            }

            return `${y}-${m}-${d}`;
        }

        function formatThaiDateInput(input) {
            if (!input) return;

            input.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');

                if (value.length > 8) {
                    value = value.substring(0, 8);
                }

                if (value.length >= 5) {
                    value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
                } else if (value.length >= 3) {
                    value = `${value.substring(0, 2)}/${value.substring(2)}`;
                }

                e.target.value = value;
            });
        }

        formatThaiDateInput(document.getElementById('editPlanStart'));
        formatThaiDateInput(document.getElementById('editPlanEnd'));
        formatThaiDateInput(document.getElementById('editPeriodEnd'));

        document.querySelector('form').addEventListener('submit', function () {
            document.querySelectorAll('.thai-date').forEach(input => {
                input.value = convertThaiDateToIso(input.value);
            });
        });
    </script>
}

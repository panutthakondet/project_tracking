@model ProjectTracking.Models.ProjectPhase
@using System.Text.Json

@{
    ViewData["Title"] = "Add Project Phase";

    DateTime? planStart = Model?.PlanStart;
    DateTime? planEnd = Model?.PlanEnd;
    DateTime? actualStart = Model?.ActualStart;
    DateTime? actualEnd = Model?.ActualEnd;

    var ps = planStart.GetValueOrDefault();
    var pe = planEnd.GetValueOrDefault();
    var aps = actualStart.GetValueOrDefault();
    var ape = actualEnd.GetValueOrDefault();

    string planStartText = planStart.HasValue
        ? $"{ps:dd/MM/}{ps.Year + 543}"
        : "";

    string planEndText = planEnd.HasValue
        ? $"{pe:dd/MM/}{pe.Year + 543}"
        : "";

    string actualStartText = actualStart.HasValue
        ? $"{aps:dd/MM/}{aps.Year + 543}"
        : "";

    string actualEndText = actualEnd.HasValue
        ? $"{ape:dd/MM/}{ape.Year + 543}"
        : "";
}

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">Add Project Phase</h2>
        <p class="index-subtitle">เพิ่มงวดงานใหม่ให้กับโครงการที่เลือก</p>
    </div>

    <div class="index-actions">
        <a asp-action="Index"
           asp-route-projectId="@(Model?.ProjectId ?? 0)"
           class="btn btn-outline-light">
            Back
        </a>
    </div>
</div>

<div class="card shadow-sm pt-form-card">
    <div class="card-body">

        <form asp-action="Create"
              method="post"
              onsubmit="return confirm('บันทึก Phase นี้หรือไม่?');">

            @Html.AntiForgeryToken()

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">📁 Project</label>

                    <div class="form-control bg-light fw-semibold pt-readonly-field">
                        @(ViewBag.SelectedProjectName ?? "ไม่พบข้อมูลโครงการ")
                    </div>

                    <input type="hidden" asp-for="ProjectId" />
                    <span asp-validation-for="ProjectId" class="text-danger"></span>
                </div>

                <!-- CHECKBOX -->
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check mt-4">
                        <input class="form-check-input"
                               type="checkbox"
                               id="copyPreviousDates" />
                        <label class="form-check-label fw-semibold">
                            ใช้วันที่จาก Phase ก่อนหน้า
                        </label>
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">🔢 Phase Order</label>
                    <input asp-for="PhaseOrder" type="number" class="form-control" />
                    <span asp-validation-for="PhaseOrder" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">🏷 Phase Type</label>
                    <select asp-for="PhaseType"
                            asp-items="ViewBag.PhaseTypeList"
                            class="form-select">
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">📌 สถานะงวดงาน</label>
                    <select asp-for="PhaseStatus" class="form-select">
                        <option value="วางแผน">วางแผน</option>
                        <option value="กำลังดำเนินการ">กำลังดำเนินการ</option>
                        <option value="ส่งงวดงานแล้ว">ส่งงวดงานแล้ว</option>
                        <option value="อนุมัติจ่ายเงินแล้ว">อนุมัติจ่ายเงินแล้ว</option>
                    </select>
                </div>

                <div class="col-md-9">
                    <label class="form-label fw-semibold">🧩 Phase Name</label>
                    <input asp-for="PhaseName"
                           class="form-control"
                           placeholder="Enter phase name" />
                    <span asp-validation-for="PhaseName" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">📅 Dates</label>
                    <div class="row g-2">
                        <div class="col-md-3">
                            <small class="text-muted">Plan Start</small>
                            <input asp-for="PlanStart"
                                   type="text"
                                   class="form-control thai-date"
                                   id="planStart"
                                   value="@planStartText"
                                   placeholder="วัน/เดือน/พ.ศ." />
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Plan End</small>
                            <input asp-for="PlanEnd"
                                   type="text"
                                   class="form-control thai-date"
                                   id="planEnd"
                                   value="@planEndText"
                                   placeholder="วัน/เดือน/พ.ศ." />
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Period Start</small>
                            <input asp-for="ActualStart"
                                   type="text"
                                   class="form-control thai-date"
                                   id="periodStart"
                                   value="@actualStartText"
                                   placeholder="วัน/เดือน/พ.ศ." />
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Period End</small>
                            <input asp-for="ActualEnd"
                                   type="text"
                                   class="form-control thai-date"
                                   id="periodEnd"
                                   value="@actualEndText"
                                   placeholder="วัน/เดือน/พ.ศ." />
                        </div>
                    </div>
                </div>

            </div>

            <div class="pt-form-actions">
                <button type="submit" class="btn btn-primary">
                    💾 Save Phase
                </button>

                <a asp-action="Index"
                   asp-route-projectId="@(Model?.ProjectId ?? 0)"
                   class="btn btn-outline-secondary">
                    ↩ Back
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts{

<partial name="_ValidationScriptsPartial" />

<script>
document.addEventListener("DOMContentLoaded", function () {

    function convertThaiDateToIso(value) {
        if (!value || !value.trim()) return '';

        const parts = value.trim().split('/');
        if (parts.length !== 3) return value;

        let [d, m, y] = parts;

        d = d.padStart(2, '0');
        m = m.padStart(2, '0');
        y = parseInt(y, 10);

        if (y > 2400) {
            y -= 543;
        }

        return `${y}-${m}-${d}`;
    }

    function formatThaiDateInput(input) {
        if (!input) return;

        input.addEventListener('input', function (e) {
            let value = e.target.value.replace(/\D/g, '');

            if (value.length > 8) {
                value = value.substring(0, 8);
            }

            if (value.length >= 5) {
                value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
            } else if (value.length >= 3) {
                value = `${value.substring(0, 2)}/${value.substring(2)}`;
            }

            e.target.value = value;
        });
    }

    const checkbox = document.getElementById("copyPreviousDates");

    if (!checkbox) return;   // 🔥 สำคัญมาก

    const planStart = document.getElementById("planStart");
    const planEnd = document.getElementById("planEnd");
    const periodStart = document.getElementById("periodStart");
    const periodEnd = document.getElementById("periodEnd");

    formatThaiDateInput(planStart);
    formatThaiDateInput(planEnd);
    formatThaiDateInput(periodStart);
    formatThaiDateInput(periodEnd);

    const lastPlanStart = '@(ViewBag.LastPlanStart ?? "")';
    const lastPlanEnd = '@(ViewBag.LastPlanEnd ?? "")';
    const lastPeriodStart = '@(ViewBag.LastPeriodStart ?? "")';
    const lastPeriodEnd = '@(ViewBag.LastPeriodEnd ?? "")';

    checkbox.addEventListener("change", function () {

        if (!this.checked) return;

        function toThaiDate(dateStr) {
            if (!dateStr) return "";

            const parts = dateStr.split('-');
            if (parts.length !== 3) return dateStr;

            const [y, m, d] = parts;
            return `${d}/${m}/${parseInt(y) + 543}`;
        }

        if (lastPlanStart !== "" && planStart) planStart.value = toThaiDate(lastPlanStart);
        if (lastPlanEnd !== "" && planEnd) planEnd.value = toThaiDate(lastPlanEnd);
        if (lastPeriodStart !== "" && periodStart) periodStart.value = toThaiDate(lastPeriodStart);
        if (lastPeriodEnd !== "" && periodEnd) periodEnd.value = toThaiDate(lastPeriodEnd);

    });

    const form = document.querySelector('form');
    if (form) {
        form.addEventListener('submit', function () {
            document.querySelectorAll('.thai-date').forEach(input => {
                input.value = convertThaiDateToIso(input.value);
            });
        });
    }

});
</script>
}

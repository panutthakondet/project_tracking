@model IEnumerable<ProjectTracking.Models.ProjectPhase>
@using System.Globalization
@using System.Linq
@using Microsoft.AspNetCore.Http
@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

@{
    ViewData["Title"] = "บันทึกข้อมูลแผนงานและงวดงาน";
    var th = new CultureInfo("th-TH");
    var selectedProject = ViewBag.SelectedProject;
    var projectOptions = ViewBag.Projects as IEnumerable<ProjectTracking.Models.Project>
                         ?? Enumerable.Empty<ProjectTracking.Models.Project>();
    var selectedProjectCoopName = (selectedProject as ProjectTracking.Models.Project)?.Coop?.CoopName ?? "";
    var requirementProjectCardDetailUrlTemplate = Url.Action("ProjectCardDetails", "RequirementBoard", new { projectId = "__PROJECT_ID__" }) ?? "";

    var orderedPhases = (Model ?? Enumerable.Empty<ProjectTracking.Models.ProjectPhase>())
        .OrderBy(p => p.PhaseOrder)
        .ThenBy(p => p.PeriodOrder)
        .ThenBy(p => (p.PhaseSort == 0 ? int.MaxValue : p.PhaseSort))
        .ThenBy(p => p.PhaseId);

    string PhaseStatusClass(string? status) => (status ?? "").Trim() switch
    {
        "วางแผน" => "bg-secondary",
        "กำลังดำเนินการ" => "bg-primary",
        "ส่งงวดงานแล้ว" => "bg-success",
        _ => "bg-light text-dark"
    };

    string PhaseTone(string? phaseType) => (phaseType ?? "").Trim().ToUpperInvariant() switch
    {
        "SUPPORT" => "is-support",
        "MAIN" => "is-main",
        _ => "is-muted"
    };

    string PhaseTypeText(string? phaseType) => (phaseType ?? "").Trim().ToUpperInvariant() switch
    {
        "SUPPORT" => "Support",
        "MAIN" => "Main",
        _ => "-"
    };

    string DateRange(DateTime? start, DateTime? end)
    {
        var startText = start?.ToString("dd MMM yyyy", th) ?? "-";
        var endText = end?.ToString("dd MMM yyyy", th) ?? "-";
        return $"{startText} - {endText}";
    }
}

<style>
    table tbody tr.phase-main > td {
        background-color: #ffffff !important;
    }

    table tbody tr.phase-support > td {
        background-color: #f79090ca !important;
    }

    table tbody tr.phase-main {
        border-left: 5px solid #ffffff;
    }

    table tbody tr.phase-support {
        border-left: 5px solid #ad2800;
    }

    .phase-drag-handle {
        font-weight: 700;
        cursor: grab;
        user-select: none;
        display: inline-block;
    }
    table td {
        word-break: break-word;
    }

    /* --- SupportOrders-style Phase Card Layout --- */
    .phase-card-container {
        display: grid;
        gap: 14px;
    }

    .phase-card {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(340px, .42fr);
        background: #fff;
        border: 1px solid #d8e3ef;
        border-left: 5px solid #94a3b8;
        border-radius: 18px;
        padding: 0;
        overflow: hidden;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .phase-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 34px rgba(15, 35, 64, .12);
    }

    .phase-card.is-main {
        border-left-color: #14b8a6;
    }

    .phase-card.is-support {
        border-left-color: #f59e0b;
    }

    .phase-card-main,
    .phase-card-support {
        background: #fff;
    }

    .phase-card-content,
    .phase-card-side {
        min-width: 0;
        padding: 18px;
    }

    .phase-card-side {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 14px;
    }

    .phase-card-head {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 10px;
    }

    .phase-card-drag {
        flex: 0 0 auto;
        width: 36px;
        height: 36px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #062b2f;
        background: rgba(20, 184, 166, .18);
        cursor: grab;
        font-size: 1.1rem;
        font-weight: 900;
        user-select: none;
    }

    .phase-no {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 46px;
        min-height: 32px;
        color: #062b2f;
        background: rgba(20, 184, 166, .18);
        border-radius: 999px;
        font-size: 1rem;
        font-weight: 900;
    }

    .phase-period {
        color: #334155;
        font-size: .9rem;
        font-weight: 400;
    }

    .phase-name-row {
        color: #10233f;
        font-size: 18px;
        font-weight: 900;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .phase-detail {
        color: #0f172a;
        font-weight: 400;
        line-height: 1.55;
        margin-top: 12px;
        overflow-wrap: anywhere;
    }

    .phase-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 12px;
        margin-top: 14px;
    }

    .phase-meta-pill {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        padding: 6px 10px;
        color: #0f172a;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 400;
    }

    .phase-status-grid {
        display: grid;
        gap: 10px;
    }

    .phase-status-row {
        display: grid;
        grid-template-columns: 86px minmax(0, 1fr);
        align-items: center;
        gap: 10px;
    }

    .phase-status-row small {
        color: #334155;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .phase-status-row .badge {
        min-height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: normal;
        line-height: 1.15;
        text-align: center;
    }

    .phase-card-actions {
        display: flex;
        flex-wrap: nowrap;
        justify-content: flex-end;
        gap: 6px;
    }

    .phase-card-actions form {
        margin: 0;
    }

    .phase-card-actions .btn {
        flex: 0 0 108px;
        width: 108px;
        min-height: 38px;
        padding: .4rem .55rem;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        font-weight: 800;
        line-height: 1.15;
        white-space: nowrap;
    }

    .phase-filter-form {
        width: 100%;
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 18px;
        padding: 18px;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    }

    .phase-filter-row {
        width: 100%;
    }

    .phase-filter-form .form-control {
        min-height: 48px;
        border-radius: 14px;
        font-weight: 700;
    }

    #projectDropdown {
        width: 100%;
        border-radius: 14px;
        box-shadow: 0 14px 28px rgba(15, 35, 64, .12);
    }
    @@media (max-width: 991.98px) {
        .phase-card {
            grid-template-columns: 1fr;
        }

        .phase-card-side {
            border-left: 0;
            border-top: 1px solid #e2e8f0;
        }

        .phase-card-actions {
            flex-wrap: nowrap;
            justify-content: flex-start;
        }
    }

    @@media (max-width: 575.98px) {
        .phase-card-actions {
            flex-wrap: wrap;
        }

        .phase-card-actions .btn {
            flex: 1 1 calc(50% - 6px);
            width: auto;
        }
    }
</style>

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">บันทึกข้อมูลแผนงานและงวดงาน</h2>
        <p class="index-subtitle">เลือกโครงการเพื่อจัดการส่วนงานและงวดงานของแต่ละ Project</p>
    </div>

    @if (selectedProject != null)
    {
        <div class="index-actions">
            <a asp-controller="Projects"
               asp-action="Index"
               class="btn btn-outline-secondary"
               title="กลับไปหน้ารายการโครงการ">
                Projects
            </a>

            <button id="RequirementCardDetailButton"
                    type="button"
                    class="btn btn-outline-primary project-board-card-detail"
                    data-detail-project-url-template="@requirementProjectCardDetailUrlTemplate"
                    data-project-field-id="hiddenProjectSelect"
                    title="เปิดดูรายละเอียด Project Board">
                🔎 Project Board
            </button>

            @if (CanMenu("ProjectPhases.Create"))
            {
                <a asp-action="Create"
                   asp-route-projectId="@selectedProject.ProjectId"
                   class="btn btn-primary"
                   title="เพิ่มส่วนงาน">
                    Add Phases
                </a>

                @if (selectedProject.RequirementCardId != null)
                {
                    <form asp-action="ImportFromRequirementCard"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Import ร่างส่วนงาน/งวดงานจาก Project Board เข้ามาใน Project นี้หรือไม่?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@selectedProject.ProjectId" />
                        <button type="submit"
                                class="btn btn-outline-success"
                                title="ดึงข้อมูลส่วนงาน/งวดงานจาก Project Board Card">
                            Import Project Board
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn btn-outline-secondary" disabled title="Project นี้ยังไม่ได้ผูก Project Board Card">
                        Import Project Board
                    </button>
                }
            }
            else
            {
                <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์เพิ่มส่วนงาน">
                    Add Section
                </button>
            }

            @if (CanMenu("PhaseAssigns.Index"))
            {
                <a asp-controller="PhaseAssigns"
                   asp-action="Index"
                   asp-route-projectId="@selectedProject.ProjectId"
                   class="btn btn-outline-info"
                   title="จัดการ Assign">
                    Assign
                </a>
            }
            else
            {
                <button class="btn btn-outline-secondary" disabled title="ไม่มีสิทธิ์เข้าหน้า Assign">
                    Assign
                </button>
            }
        </div>
    }
</div>

<partial name="_RequirementCardDetailModal" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success fw-bold">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
}

<form method="get" class="phase-filter-form mb-4">
    <div class="phase-filter-row">

        <label class="form-label fw-bold">🏢 สหกรณ์</label>
        <select id="projectCoopFilter"
                class="form-select"
                data-placeholder="🔍 พิมพ์ค้นหาสหกรณ์...">
            <option value="">-- ทุกสหกรณ์ --</option>
            @foreach (var coopName in projectOptions
                        .Select(p => p.Coop?.CoopName)
                        .Where(name => !string.IsNullOrWhiteSpace(name))
                        .Distinct()
                        .OrderBy(name => name))
            {
                <option value="@coopName" selected="@(selectedProjectCoopName == coopName)">
                    @coopName
                </option>
            }
        </select>

        <label class="form-label fw-bold">📁 โครงการ</label>

        <select name="projectId"
                id="hiddenProjectSelect"
                class="form-select form-select-lg">
            <option value="">-- เลือกโครงการ --</option>

            @foreach (var p in projectOptions)
            {
                <option value="@p.ProjectId"
                        data-coop-name="@(p.Coop?.CoopName ?? "")"
                        data-project-name="@p.ProjectName"
                        data-end-date="@(p.EndDate?.ToString("yyyy-MM-dd") ?? "")"
                        selected="@(ViewBag.SelectedProject != null &&
                                    ViewBag.SelectedProject.ProjectId == p.ProjectId)">
                    @p.ProjectName
                </option>
            }
        </select>

    </div>
</form>

@if (selectedProject != null)
{
    <form id="antiForm" method="post" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <div class="table-responsive" style="display:none;">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark text-center">
                <tr>
                    <th style="width:70px;">No.</th>
                    <th style="width:90px;">ส่วนที่</th>
                    <th style="width:90px;">งวดที่</th>
                    <th style="min-width:260px;">ชื่อส่วนงาน</th>
                    <th style="width:280px;">Plan Date</th>
                    <th style="width:180px;">กำหนดส่งงวดงาน</th>
                    <th style="width:160px;">Status</th>
                    <th style="width:320px;">Action</th>
                </tr>
            </thead>
            <tbody id="phaseTbody" data-project-id="@selectedProject.ProjectId">
            @if (!orderedPhases.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">
                        — No Section —
                    </td>
                </tr>
            }
            else
            {
                var row = 1;

                foreach (var phase in orderedPhases)
                {
                    var displayNo = row; // แสดงลำดับแถว 1..N
                    row++;
                    <tr data-phase-id="@phase.PhaseId" class="@(phase.PhaseType == "MAIN"
                                    ? "phase-main"
                                    : phase.PhaseType == "SUPPORT"
                                        ? "phase-support"
                                        : "")">

                        <!-- ⭐ NEW ROW NUMBER -->
                        <td class="text-center fw-semibold phase-sort-cell">
                            <span class="phase-drag-handle" title="ลากเพื่อสลับแถว">☰</span>
                            <span class="ms-2">@displayNo</span>
                        </td>

                        <td class="text-center fw-bold">
                            @phase.PhaseOrder
                        </td>

                        <td class="text-center fw-bold">
                            @phase.PeriodOrder
                        </td>

                        <td>
                            <b>@phase.PhaseName</b>
                        </td>

                        <td class="text-center">
                            @(phase.PlanStart?.ToString("dd MMM yyyy", th) ?? "-")
                            &nbsp;–&nbsp;
                            @(phase.PlanEnd?.ToString("dd MMM yyyy", th) ?? "-")
                        </td>

                        <td class="text-center">
                            @(phase.PeriodEndDate?.ToString("dd MMM yyyy", th) ?? "-")
                        </td>

                        <td class="text-center">
                        @{
                            var status = phase.PhaseStatus ?? "";
                            string badgeClass = status switch
                            {
                                "วางแผน" => "bg-secondary",
                                "กำลังดำเนินการ" => "bg-primary",
                                "ส่งงวดงานแล้ว" => "bg-success",
                                _ => "bg-light text-dark"
                            };
                        }
                        <span class="badge @badgeClass px-3 py-2">@(string.IsNullOrEmpty(status) ? "-" : status)</span>
                        </td>

                        <td class="text-center">
                            @if (CanMenu("ProjectPhases.Edit"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@phase.PhaseId"
                                   class="btn btn-sm btn-outline-primary me-1"
                                   title="แก้ไขส่วนงาน">
                                    ✏️ Edit
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary me-1" disabled title="ไม่มีสิทธิ์แก้ไข">
                                    ✏️ Edit
                                </button>
                            }

                            @if (CanMenu("PhaseAssigns.Index"))
                            {
                                <a asp-controller="PhaseAssigns"
                                   asp-action="Index"
                                   asp-route-projectId="@selectedProject.ProjectId"
                                   asp-route-phaseId="@phase.PhaseId"
                                   class="btn btn-sm btn-outline-info me-1"
                                   title="จัดการ Assign">
                                    👥 Assign
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary me-1" disabled title="ไม่มีสิทธิ์เข้าหน้า Assign">
                                    👥 Assign
                                </button>
                            }

                            @if (CanMenu("ProjectPhases.Delete"))
                            {
                                <form asp-action="Delete"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@phase.PhaseId" />
                                    <input type="hidden" name="projectId"
                                           value="@selectedProject.ProjectId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="ลบส่วนงาน"
                                            onclick="return confirm('ยืนยันการลบส่วนงานนี้?');">
                                        🗑 Delete
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                    🗑 Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

<div id="phaseCardContainer" class="phase-card-container" data-project-id="@selectedProject.ProjectId">

@if (!orderedPhases.Any())
{
    <div class="text-center text-muted py-5">
        — No Section —
    </div>
}
else
{
    var rowCard = 1;

    foreach (var phase in orderedPhases)
    {
        var displayNo = rowCard;
        rowCard++;

        var status = phase.PhaseStatus ?? "";

        <div class="phase-card @(phase.PhaseType == "SUPPORT" ? "phase-card-support" : "phase-card-main") @PhaseTone(phase.PhaseType)"
             data-phase-id="@phase.PhaseId">

            <section class="phase-card-content">
                <div class="phase-card-head">
                    <div class="phase-drag-handle phase-card-drag" title="ลากเพื่อสลับลำดับ">
                        ☰
                    </div>

                    <div class="min-w-0 flex-grow-1">
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <span class="phase-no">#@displayNo</span>
                            <span class="phase-period">ส่วนที่ @phase.PhaseOrder</span>
                            <span class="phase-period">งวดที่ @phase.PeriodOrder</span>
                        </div>

                        <div class="phase-name-row">@phase.PhaseName</div>
                    </div>
                </div>

                <div class="phase-detail">
                    แผนงาน ส่วนงาน และงวดงานของโครงการที่เลือก
                </div>

                <div class="phase-meta">
                    <span class="phase-meta-pill">Plan Date: @DateRange(phase.PlanStart, phase.PlanEnd)</span>
                    <span class="phase-meta-pill">กำหนดส่งงวดงาน: @(phase.PeriodEndDate?.ToString("dd MMM yyyy", th) ?? "-")</span>
                </div>

                <div class="phase-status-grid">
                    <div class="phase-status-row">
                        <small>Type</small>
                        <span class="badge @(phase.PhaseType == "SUPPORT" ? "bg-warning text-dark" : "bg-info text-dark")">
                            @PhaseTypeText(phase.PhaseType)
                        </span>
                    </div>
                    <div class="phase-status-row">
                        <small>Status</small>
                        <span class="badge @PhaseStatusClass(status)">@(string.IsNullOrEmpty(status) ? "-" : status)</span>
                    </div>
                </div>
            </section>

            <aside class="phase-card-side">
                <div class="phase-card-actions">
                    @if (CanMenu("ProjectPhases.Edit"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@phase.PhaseId"
                           class="btn btn-outline-primary btn-sm">
                            Edit
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            Edit
                        </button>
                    }

                    @if (CanMenu("PhaseAssigns.Create"))
                    {
                        <a asp-controller="PhaseAssigns"
                           asp-action="Create"
                           asp-route-projectId="@selectedProject.ProjectId"
                           asp-route-phaseId="@phase.PhaseId"
                           class="btn btn-outline-success btn-sm"
                           title="เพิ่ม Assign ให้ส่วนงานนี้">
                            Add Assigns
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled title="ไม่มีสิทธิ์เพิ่ม Assign">
                            Add Assigns
                        </button>
                    }

                    @if (CanMenu("ProjectPhases.Delete"))
                    {
                        <form asp-action="Delete"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@phase.PhaseId" />
                            <input type="hidden" name="projectId"
                                   value="@selectedProject.ProjectId" />

                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm"
                                    onclick="return confirm('ยืนยันการลบส่วนงานนี้?');">
                                Delete
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            Delete
                        </button>
                    }
                </div>
            </aside>
        </div>
    }
}
</div>
}
else
{
    <div class="alert alert-secondary">
        ⬆ กรุณาเลือก Project ก่อน
    </div>
}

@section Scripts{
    <!-- ✅ SortableJS (Drag & Drop Reorder Rows) -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

    <script>
    document.addEventListener("DOMContentLoaded", function () {

        const hiddenSelect = document.getElementById("hiddenProjectSelect");
        const coopFilter = document.getElementById("projectCoopFilter");

        if (hiddenSelect) {
            const options = Array.from(hiddenSelect.options);

            function syncProjectOptions() {
                const selectedCoop = (coopFilter?.value || "").toLowerCase();
                options.forEach(option => {
                    const visible = option.value === "" ||
                        !selectedCoop ||
                        (option.dataset.coopName || "").toLowerCase() === selectedCoop;
                    option.hidden = !visible;
                    option.disabled = !visible;
                });

                const selected = hiddenSelect.selectedOptions[0];
                if (selected && selected.disabled) hiddenSelect.value = "";
            }

            hiddenSelect.addEventListener("change", function () {
                hiddenSelect.closest("form").submit();
            });

            coopFilter?.addEventListener("change", function () {
                hiddenSelect.value = "";
                syncProjectOptions();
            });

            syncProjectOptions();
        }

        // =========================
        // Drag & Drop reorder rows/cards
        // =========================
        const tbody = document.getElementById("phaseTbody");
        const cardContainer = document.getElementById("phaseCardContainer");
        const sortableTarget = cardContainer || tbody;

        if (!sortableTarget) return;

        // Anti-forgery token (from hidden form #antiForm)
        const token = document.querySelector('#antiForm input[name="__RequestVerificationToken"]')?.value;

        // helper: update No. column (1..N) after drag
        function refreshRowNumbers() {
            const rows = sortableTarget.querySelectorAll('[data-phase-id]');
            let i = 1;
            rows.forEach(tr => {
                // For table row
                const noSpan = tr.querySelector('td.phase-sort-cell span.ms-2');
                if (noSpan) noSpan.textContent = String(i);
                // For card
                const cardNo = tr.querySelector('.phase-no');
                if (cardNo) {
                    cardNo.textContent = `#${i}`;
                }
                i++;
            });
        }

        new Sortable(sortableTarget, {
            animation: 150,
            handle: ".phase-drag-handle", // drag by hamburger icon
            ghostClass: "table-active",
            onEnd: async function () {
                refreshRowNumbers();

                // Collect phase ids in new order
                const phaseIds = Array.from(sortableTarget.querySelectorAll('[data-phase-id]'))
                    .map(tr => parseInt(tr.getAttribute('data-phase-id')))
                    .filter(n => !Number.isNaN(n));

                const projectId = parseInt(sortableTarget.getAttribute('data-project-id'));

                // If no projectId or no ids, stop.
                if (Number.isNaN(projectId) || phaseIds.length === 0) return;

                // Persist order (optional): calls ProjectPhasesController.Reorder
                // If you don't have this action yet, nothing will break visually; it will just fail to save.
                try {
                    const res = await fetch("@Url.Action("Reorder", "ProjectPhases")", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            ...(token ? { "RequestVerificationToken": token } : {})
                        },
                        body: JSON.stringify({ projectId, phaseIds })
                    });

                    if (!res.ok) {
                        console.warn("Reorder save failed", await res.text());
                    }
                } catch (err) {
                    console.warn("Reorder save error", err);
                }
            }
        });

    });
    </script>
}

@section Scripts{
    <!-- ✅ SortableJS (Drag & Drop Reorder Rows) -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

    <script>
    document.addEventListener("DOMContentLoaded", function () {

        const hiddenSelect = document.getElementById("hiddenProjectSelect");
        const coopFilter = document.getElementById("projectCoopFilter");

        if (hiddenSelect) {
            const options = Array.from(hiddenSelect.options);

            function syncProjectOptions() {
                const selectedCoop = (coopFilter?.value || "").toLowerCase();
                options.forEach(option => {
                    const visible = option.value === "" ||
                        !selectedCoop ||
                        (option.dataset.coopName || "").toLowerCase() === selectedCoop;
                    option.hidden = !visible;
                    option.disabled = !visible;
                });

                const selected = hiddenSelect.selectedOptions[0];
                if (selected && selected.disabled) hiddenSelect.value = "";
            }

            hiddenSelect.addEventListener("change", function () {
                hiddenSelect.closest("form").submit();
            });

            coopFilter?.addEventListener("change", function () {
                hiddenSelect.value = "";
                syncProjectOptions();
            });

            syncProjectOptions();
        }

        document.querySelectorAll("[data-phase-assign-toggle]").forEach(button => {
            button.addEventListener("click", function () {
                const panelId = button.getAttribute("data-phase-assign-toggle");
                const panel = panelId ? document.getElementById(panelId) : null;
                if (!panel) return;

                const isOpen = button.getAttribute("aria-expanded") === "true";
                button.setAttribute("aria-expanded", isOpen ? "false" : "true");
                button.querySelector("span").textContent = isOpen ? "+" : "−";
                panel.classList.toggle("is-open", !isOpen);
                panel.setAttribute("aria-hidden", isOpen ? "true" : "false");
            });
        });

        // =========================
        // Thai calendar note
        // =========================
        const calendarButton = document.getElementById("ThaiCalendarNoteButton");
        const calendarNote = document.getElementById("ThaiCalendarNoteModal");
        const calendarHeader = document.getElementById("ThaiCalendarNoteHeader");
        const calendarPositionKey = "ProjectTracking.ProjectPhases.ThaiCalendarNotePosition";

        function calendarBounds() {
            const rect = calendarNote?.getBoundingClientRect();
            const margin = 8;
            return {
                margin,
                maxLeft: Math.max(margin, window.innerWidth - (rect?.width || 0) - margin),
                maxTop: Math.max(margin, window.innerHeight - (rect?.height || 0) - margin)
            };
        }

        function clampCalendarPosition(left, top) {
            if (!calendarNote) return;
            const bounds = calendarBounds();
            const nextLeft = Math.min(Math.max(left, bounds.margin), bounds.maxLeft);
            const nextTop = Math.min(Math.max(top, bounds.margin), bounds.maxTop);
            calendarNote.style.setProperty("--requirement-card-note-left", `${nextLeft}px`);
            calendarNote.style.setProperty("--requirement-card-note-top", `${nextTop}px`);
        }

        function applySavedCalendarPosition() {
            if (!calendarNote) return;
            if (window.matchMedia?.("(max-width: 575.98px)").matches) {
                calendarNote.style.removeProperty("--requirement-card-note-left");
                calendarNote.style.removeProperty("--requirement-card-note-top");
                return;
            }

            let saved = null;
            try {
                saved = JSON.parse(window.localStorage?.getItem(calendarPositionKey) || "null");
            } catch {
                saved = null;
            }

            if (!saved || !Number.isFinite(saved.left) || !Number.isFinite(saved.top)) return;
            clampCalendarPosition(saved.left, saved.top);
        }

        function openCalendarNote() {
            if (!calendarNote) return;
            if (calendarNote.parentElement !== document.body) {
                document.body.appendChild(calendarNote);
            }

            applySavedCalendarPosition();
            calendarNote.classList.add("is-open");
            calendarNote.setAttribute("aria-hidden", "false");
        }

        function closeCalendarNote() {
            if (!calendarNote) return;
            calendarNote.classList.remove("is-open");
            calendarNote.setAttribute("aria-hidden", "true");
        }

        calendarButton?.addEventListener("click", openCalendarNote);
        document.querySelectorAll("[data-thai-calendar-close]").forEach(button => {
            button.addEventListener("click", closeCalendarNote);
        });

        if (calendarNote && calendarHeader) {
            let startX = 0;
            let startY = 0;
            let startLeft = 0;
            let startTop = 0;

            function stopCalendarDrag() {
                calendarNote.classList.remove("is-dragging");
                document.removeEventListener("pointermove", dragCalendarNote);
                document.removeEventListener("pointerup", stopCalendarDrag);
                document.removeEventListener("pointercancel", stopCalendarDrag);

                const rect = calendarNote.getBoundingClientRect();
                window.localStorage?.setItem(calendarPositionKey, JSON.stringify({
                    left: Math.round(rect.left),
                    top: Math.round(rect.top)
                }));
            }

            function dragCalendarNote(event) {
                clampCalendarPosition(
                    startLeft + event.clientX - startX,
                    startTop + event.clientY - startY
                );
            }

            calendarHeader.addEventListener("pointerdown", function (event) {
                if (window.matchMedia?.("(max-width: 575.98px)").matches) return;
                if (event.target.closest("button, a, input, textarea, select")) return;

                event.preventDefault();
                startX = event.clientX;
                startY = event.clientY;
                const rect = calendarNote.getBoundingClientRect();
                startLeft = rect.left;
                startTop = rect.top;
                calendarNote.classList.add("is-dragging");
                calendarHeader.setPointerCapture?.(event.pointerId);
                document.addEventListener("pointermove", dragCalendarNote);
                document.addEventListener("pointerup", stopCalendarDrag);
                document.addEventListener("pointercancel", stopCalendarDrag);
            });

            window.addEventListener("resize", function () {
                if (!calendarNote.classList.contains("is-open")) return;
                applySavedCalendarPosition();
            });
        }

        // =========================
        // Drag & Drop reorder rows/cards
        // =========================
        const tbody = document.getElementById("phaseTbody");
        const cardContainer = document.getElementById("phaseCardContainer");
        const sortableTarget = cardContainer || tbody;

        if (!sortableTarget) return;

        // Anti-forgery token (from hidden form #antiForm)
        const token = document.querySelector('#antiForm input[name="__RequestVerificationToken"]')?.value;

        // helper: update No. column (1..N) after drag
        function refreshRowNumbers() {
            const rows = sortableTarget.querySelectorAll('[data-phase-id]');
            let i = 1;
            rows.forEach(tr => {
                // For table row
                const noSpan = tr.querySelector('td.phase-sort-cell span.ms-2');
                if (noSpan) noSpan.textContent = String(i);
                // For card
                const cardNo = tr.querySelector('.phase-no');
                if (cardNo) {
                    cardNo.textContent = `#${i}`;
                }
                i++;
            });
        }

        new Sortable(sortableTarget, {
            animation: 150,
            handle: ".phase-drag-handle", // drag by hamburger icon
            ghostClass: "table-active",
            onEnd: async function () {
                refreshRowNumbers();

                // Collect phase ids in new order
                const phaseIds = Array.from(sortableTarget.querySelectorAll('[data-phase-id]'))
                    .map(tr => parseInt(tr.getAttribute('data-phase-id')))
                    .filter(n => !Number.isNaN(n));

                const projectId = parseInt(sortableTarget.getAttribute('data-project-id'));

                // If no projectId or no ids, stop.
                if (Number.isNaN(projectId) || phaseIds.length === 0) return;

                // Persist order (optional): calls ProjectPhasesController.Reorder
                // If you don't have this action yet, nothing will break visually; it will just fail to save.
                try {
                    const res = await fetch("@Url.Action("Reorder", "ProjectPhases")", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            ...(token ? { "RequestVerificationToken": token } : {})
                        },
                        body: JSON.stringify({ projectId, phaseIds })
                    });

                    if (!res.ok) {
                        console.warn("Reorder save failed", await res.text());
                    }
                } catch (err) {
                    console.warn("Reorder save error", err);
                }
            }
        });

    });
    </script>
}

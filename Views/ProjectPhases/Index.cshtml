@model IEnumerable<ProjectTracking.Models.ProjectPhase>
@using System.Globalization
@using System.Linq
@using Microsoft.AspNetCore.Http
@{
    bool CanMenu(string key)
    {
        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Contains(key);
    }
}

@{
    ViewData["Title"] = "บันทึกข้อมูลแผนงานและงวดงาน";
    var th = new CultureInfo("th-TH");

    // ✅ เรียงตาม phase_sort เป็นหลัก (0 หรือ null ให้ไปท้าย) เพื่อให้การลากสลับแถว "ถาวร" ตามค่า PhaseSort
    //    แล้วค่อย tie-break ด้วย PlanEnd (null ไปท้าย) และ PhaseId
    var orderedPhases = (Model ?? Enumerable.Empty<ProjectTracking.Models.ProjectPhase>())
        .OrderBy(p => (p.PhaseSort == 0 ? int.MaxValue : p.PhaseSort))
        .ThenBy(p => p.PlanEnd ?? DateTime.MaxValue)
        .ThenBy(p => p.PhaseId);
}

<style>
    .project-header-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 18px 22px;
        box-shadow: 0 2px 10px rgba(15,23,42,.05);
    }

    .project-title {
        line-height: 1.5;
        word-break: break-word;
    }

    .project-header-action {
        display: flex;
        justify-content: flex-end;
    }

    @@media (max-width: 768px) {
        .project-header-action {
            justify-content: stretch;
        }

        .project-header-action .btn {
            width: 100%;
        }
    }
    table tbody tr.phase-main > td {
        background-color: #ffffff !important;
    }

    table tbody tr.phase-support > td {
        background-color: #f79090ca !important;
    }

    table tbody tr.phase-main {
        border-left: 5px solid #ffffff;
    }

    table tbody tr.phase-support {
        border-left: 5px solid #ad2800;
    }

    .phase-drag-handle {
        font-weight: 700;
        cursor: grab;
        user-select: none;
        display: inline-block;
    }
    table td {
        word-break: break-word;
    }

    /* --- Responsive Phase Card Layout --- */
    .phase-card-container {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .phase-card {
        background: #fff;
        border: 2px solid #cbd5e1;
        border-radius: 24px;
        padding: 22px;
        box-shadow: 0 4px 14px rgba(15,23,42,.05);
    }

    .phase-card-main {
        border-left: 6px solid #2563eb;
    }

    .phase-card-support {
        border-left: 6px solid #dc2626;
        background: #fff7f7;
    }

    .phase-card-header {
        margin-bottom: 18px;
    }

    .phase-card-drag {
        cursor: grab;
        font-size: 1.3rem;
        font-weight: 700;
    }

    .phase-card-title {
        font-weight: 700;
        color: #2563eb;
        margin-bottom: 4px;
    }

    .phase-card-name {
        font-size: 1.08rem;
        font-weight: 700;
    }

    .phase-card-inline {
        display: flex;
        align-items: center;
        gap: 10px;
        line-height: 1.7;
        flex-wrap: nowrap;
        overflow-x: auto;
        white-space: nowrap;
    }

    .phase-no {
        font-size: 1.05rem;
        font-weight: 800;
        color: #2563eb;
    }

    .phase-period {
        font-weight: 700;
        color: #0f172a;
    }

    .phase-name-row {
        margin-top: 4px;
        font-size: 1.06rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.45;
    }

    .phase-name-inline {
        font-weight: 700;
        color: #111827;
        display: block;
    }

    .phase-plan-inline {
        color: #475569;
        font-weight: 500;
    }

    .phase-plan-label {
        font-weight: 700;
        color: #334155;
        margin-right: 4px;
    }

    .phase-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px,1fr));
        gap: 12px;
    }

    .phase-info-box {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 14px;
    }

    .phase-info-label {
        font-size: .82rem;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 4px;
    }

    .phase-info-value {
        font-weight: 600;
    }

    .phase-date-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 24px;
        margin-top: 8px;
        color: #475569;
        font-size: .95rem;
    }

    .phase-date-item {
        white-space: nowrap;
    }

    .phase-date-item strong {
        color: #334155;
        margin-right: 4px;
    }

    .phase-card-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
</style>

<h2 class="fw-bold mb-3">🧩 บันทึกข้อมูลแผนงานและงวดงาน</h2>

<p class="text-muted">
    เลือกโครงการเพื่อจัดการ Phase ของแต่ละ Project
</p>

<form method="get" class="mb-4">
    <div class="col-md-6">

        <label class="form-label fw-bold">📁 Select Project</label>

        <input type="text"
               id="projectSearch"
               class="form-control"
               placeholder="🔍 พิมพ์ค้นหา Project..."
               autocomplete="off" />

        <div id="projectDropdown"
             class="list-group mt-1"
             style="max-height:250px; overflow-y:auto; display:none; border:1px solid #ddd;">
        </div>

        <select name="projectId"
                id="hiddenProjectSelect"
                style="display:none;">
            <option value="">-- Select Project --</option>

            @foreach (var p in (ViewBag.Projects ?? new List<dynamic>()))
            {
                <option value="@p.ProjectId"
                        data-end-date="@(p.EndDate?.ToString("yyyy-MM-dd") ?? "")"
                        selected="@(ViewBag.SelectedProject != null &&
                                    ViewBag.SelectedProject.ProjectId == p.ProjectId)">
                    @p.ProjectName
                </option>
            }
        </select>

    </div>
</form>

@if (ViewBag.SelectedProject != null)
{
    var selectedProject = ViewBag.SelectedProject;

    <div class="project-header-card mb-3">

        <div class="project-header-top">
            <h4 class="fw-bold mb-0 project-title">
                📌 Project : @selectedProject.ProjectName
            </h4>
        </div>

        <div class="project-header-action mt-3">
            @if (CanMenu("ProjectPhases.Create"))
            {
                <a asp-action="Create"
                   asp-route-projectId="@selectedProject.ProjectId"
                   class="btn btn-primary"
                   title="เพิ่ม Phase">
                    ➕ Add Phase
                </a>
            }
            else
            {
                <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์เพิ่ม Phase">
                    ➕ Add Phase
                </button>
            }
        </div>

    </div>

    <form id="antiForm" method="post" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <div class="table-responsive" style="display:none;">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark text-center">
                <tr>
                    <th style="width:70px;">No.</th>
                    <th style="width:90px;">Period</th>
                    <th style="min-width:260px;">Phase Name</th>
                    <th style="width:280px;">Plan Date</th>
                    <th style="width:280px;">Period Date</th>
                    <th style="width:160px;">Status</th>
                    <th style="width:320px;">Action</th>
                </tr>
            </thead>
            <tbody id="phaseTbody" data-project-id="@selectedProject.ProjectId">
            @if (!orderedPhases.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">
                        — No Phase —
                    </td>
                </tr>
            }
            else
            {
                var row = 1;

                foreach (var phase in orderedPhases)
                {
                    var displayNo = row; // แสดงลำดับแถว 1..N
                    row++;
                    <tr data-phase-id="@phase.PhaseId" class="@(phase.PhaseType == "MAIN"
                                    ? "phase-main"
                                    : phase.PhaseType == "SUPPORT"
                                        ? "phase-support"
                                        : "")">

                        <!-- ⭐ NEW ROW NUMBER -->
                        <td class="text-center fw-semibold phase-sort-cell">
                            <span class="phase-drag-handle" title="ลากเพื่อสลับแถว">☰</span>
                            <span class="ms-2">@displayNo</span>
                        </td>

                        <td class="text-center fw-bold">
                            @phase.PhaseOrder
                        </td>

                        <td>
                            <b>@phase.PhaseName</b>
                        </td>

                        <td class="text-center">
                            @(phase.PlanStart?.ToString("dd MMM yyyy", th) ?? "-")
                            &nbsp;–&nbsp;
                            @(phase.PlanEnd?.ToString("dd MMM yyyy", th) ?? "-")
                        </td>

                        <td class="text-center">
                            @(phase.PeriodStartDate?.ToString("dd MMM yyyy", th) ?? "-")
                            &nbsp;–&nbsp;
                            @(phase.PeriodEndDate?.ToString("dd MMM yyyy", th) ?? "-")
                        </td>

                        <td class="text-center">
                        @{
                            var status = phase.PhaseStatus ?? "";
                            string badgeClass = status switch
                            {
                                "วางแผน" => "bg-secondary",
                                "กำลังดำเนินการ" => "bg-primary",
                                "ส่งงวดงานแล้ว" => "bg-warning text-dark",
                                "อนุมัติจ่ายเงินแล้ว" => "bg-success",
                                _ => "bg-light text-dark"
                            };
                        }
                        <span class="badge @badgeClass px-3 py-2">@(string.IsNullOrEmpty(status) ? "-" : status)</span>
                        </td>

                        <td class="text-center">
                            @if (CanMenu("ProjectPhases.Edit"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@phase.PhaseId"
                                   class="btn btn-sm btn-outline-primary me-1"
                                   title="แก้ไข Phase">
                                    ✏️ Edit
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary me-1" disabled title="ไม่มีสิทธิ์แก้ไข">
                                    ✏️ Edit
                                </button>
                            }

                            @if (CanMenu("PhaseAssigns.Index"))
                            {
                                <a asp-controller="PhaseAssigns"
                                   asp-action="Index"
                                   asp-route-projectId="@selectedProject.ProjectId"
                                   asp-route-phaseId="@phase.PhaseId"
                                   class="btn btn-sm btn-outline-info me-1"
                                   title="จัดการ Assign">
                                    👥 Assign
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary me-1" disabled title="ไม่มีสิทธิ์เข้าหน้า Assign">
                                    👥 Assign
                                </button>
                            }

                            @if (CanMenu("ProjectPhases.Delete"))
                            {
                                <form asp-action="Delete"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@phase.PhaseId" />
                                    <input type="hidden" name="projectId"
                                           value="@selectedProject.ProjectId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="ลบ Phase"
                                            onclick="return confirm('ยืนยันการลบ Phase นี้?');">
                                        🗑 Delete
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                    🗑 Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

<div id="phaseCardContainer" class="phase-card-container" data-project-id="@selectedProject.ProjectId">

@if (!orderedPhases.Any())
{
    <div class="text-center text-muted py-5">
        — No Phase —
    </div>
}
else
{
    var rowCard = 1;

    foreach (var phase in orderedPhases)
    {
        var displayNo = rowCard;
        rowCard++;

        var status = phase.PhaseStatus ?? "";
        string badgeClass = status switch
        {
            "วางแผน" => "bg-secondary",
            "กำลังดำเนินการ" => "bg-primary",
            "ส่งงวดงานแล้ว" => "bg-warning text-dark",
            "อนุมัติจ่ายเงินแล้ว" => "bg-success",
            _ => "bg-light text-dark"
        };

        <div class="phase-card @(phase.PhaseType == "SUPPORT" ? "phase-card-support" : "phase-card-main")"
             data-phase-id="@phase.PhaseId">

            <div class="phase-card-header">
                <div class="d-flex align-items-start gap-3 flex-grow-1">
                    <div class="phase-drag-handle phase-card-drag"
                         title="ลากเพื่อสลับลำดับ">
                        ☰
                    </div>

                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start gap-3">

                            <div class="flex-grow-1">

                                <div class="phase-title-row">
                                    <span class="phase-no">#@displayNo</span>
                                    <span class="phase-period">— งวด @phase.PhaseOrder</span>
                                </div>

                                <div class="phase-name-row">
                                    @phase.PhaseName
                                </div>

                            </div>

                            <span class="badge @badgeClass px-3 py-2 rounded-pill shadow-sm">
                                @(string.IsNullOrEmpty(status) ? "-" : status)
                            </span>

                        </div>
                    </div>
                </div>
            </div>

            <div class="phase-card-body">

                <div class="phase-date-row">

                    <span class="phase-date-item">
                        <strong>Plan Date</strong>
                        @(phase.PlanStart?.ToString("dd MMM yyyy", th) ?? "-")
                        –
                        @(phase.PlanEnd?.ToString("dd MMM yyyy", th) ?? "-")
                    </span>

                    <span class="phase-date-item">
                        <strong>Period Date</strong>
                        @(phase.PeriodStartDate?.ToString("dd MMM yyyy", th) ?? "-")
                        –
                        @(phase.PeriodEndDate?.ToString("dd MMM yyyy", th) ?? "-")
                    </span>

                </div>

                <div class="phase-card-actions mt-3">

                    @if (CanMenu("ProjectPhases.Edit"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@phase.PhaseId"
                           class="btn btn-outline-primary btn-sm">
                            ✏️ Edit
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            ✏️ Edit
                        </button>
                    }

                    @if (CanMenu("PhaseAssigns.Index"))
                    {
                        <a asp-controller="PhaseAssigns"
                           asp-action="Index"
                           asp-route-projectId="@selectedProject.ProjectId"
                           asp-route-phaseId="@phase.PhaseId"
                           class="btn btn-outline-info btn-sm">
                            👥 Assign
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            👥 Assign
                        </button>
                    }

                    @if (CanMenu("ProjectPhases.Delete"))
                    {
                        <form asp-action="Delete"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@phase.PhaseId" />
                            <input type="hidden" name="projectId"
                                   value="@selectedProject.ProjectId" />

                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm"
                                    onclick="return confirm('ยืนยันการลบ Phase นี้?');">
                                🗑 Delete
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🗑 Delete
                        </button>
                    }

                </div>
            </div>
        </div>
    }
}
</div>
}
else
{
    <div class="alert alert-secondary">
        ⬆ กรุณาเลือก Project ก่อน
    </div>
}

@section Scripts{
    <!-- ✅ SortableJS (Drag & Drop Reorder Rows) -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

    <script>
    document.addEventListener("DOMContentLoaded", function () {

        // =========================
        // Project search dropdown
        // =========================
        const searchInput = document.getElementById("projectSearch");
        const dropdown = document.getElementById("projectDropdown");
        const hiddenSelect = document.getElementById("hiddenProjectSelect");

        if (searchInput && dropdown && hiddenSelect) {
            const options = Array.from(hiddenSelect.options);

            function renderList(filter = "") {
                dropdown.innerHTML = "";

                const filtered = options.filter(o =>
                    o.text.toLowerCase().includes(filter.toLowerCase()) &&
                    o.value !== ""
                )
                .sort((a, b) => {
                    const aRaw = a.dataset.endDate;
                    const bRaw = b.dataset.endDate;

                    // null/empty dates go last
                    if (!aRaw && !bRaw) return 0;
                    if (!aRaw) return 1;
                    if (!bRaw) return -1;

                    const aDate = new Date(aRaw);
                    const bDate = new Date(bRaw);

                    return aDate - bDate; // น้อย → มาก
                });

                if (filtered.length === 0) {
                    dropdown.style.display = "none";
                    return;
                }

                filtered.forEach(o => {
                    const item = document.createElement("a");
                    item.className = "list-group-item list-group-item-action";
                    item.textContent = o.text;

                    item.onclick = function () {
                        searchInput.value = o.text;
                        hiddenSelect.value = o.value;
                        dropdown.style.display = "none";
                        searchInput.closest("form").submit();
                    };

                    dropdown.appendChild(item);
                });

                dropdown.style.display = "block";
            }

            searchInput.addEventListener("input", function () {
                renderList(this.value);
            });

            searchInput.addEventListener("focus", function () {
                renderList(this.value);
            });

            document.addEventListener("click", function (e) {
                if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.style.display = "none";
                }
            });
        }

        // =========================
        // Drag & Drop reorder rows/cards
        // =========================
        const tbody = document.getElementById("phaseTbody");
        const cardContainer = document.getElementById("phaseCardContainer");
        const sortableTarget = cardContainer || tbody;

        if (!sortableTarget) return;

        // Anti-forgery token (from hidden form #antiForm)
        const token = document.querySelector('#antiForm input[name="__RequestVerificationToken"]')?.value;

        // helper: update No. column (1..N) after drag
        function refreshRowNumbers() {
            const rows = sortableTarget.querySelectorAll('[data-phase-id]');
            let i = 1;
            rows.forEach(tr => {
                // For table row
                const noSpan = tr.querySelector('td.phase-sort-cell span.ms-2');
                if (noSpan) noSpan.textContent = String(i);
                // For card
                const cardNo = tr.querySelector('.phase-card-title');
                if (cardNo) {
                    // #n — งวด ...
                    let txt = cardNo.textContent;
                    cardNo.textContent = txt.replace(/^#\d+/, `#${i}`);
                }
                i++;
            });
        }

        new Sortable(sortableTarget, {
            animation: 150,
            handle: ".phase-drag-handle", // drag by hamburger icon
            ghostClass: "table-active",
            onEnd: async function () {
                refreshRowNumbers();

                // Collect phase ids in new order
                const phaseIds = Array.from(sortableTarget.querySelectorAll('[data-phase-id]'))
                    .map(tr => parseInt(tr.getAttribute('data-phase-id')))
                    .filter(n => !Number.isNaN(n));

                const projectId = parseInt(sortableTarget.getAttribute('data-project-id'));

                // If no projectId or no ids, stop.
                if (Number.isNaN(projectId) || phaseIds.length === 0) return;

                // Persist order (optional): calls ProjectPhasesController.Reorder
                // If you don't have this action yet, nothing will break visually; it will just fail to save.
                try {
                    const res = await fetch("@Url.Action("Reorder", "ProjectPhases")", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            ...(token ? { "RequestVerificationToken": token } : {})
                        },
                        body: JSON.stringify({ projectId, phaseIds })
                    });

                    if (!res.ok) {
                        console.warn("Reorder save failed", await res.text());
                    }
                } catch (err) {
                    console.warn("Reorder save error", err);
                }
            }
        });

    });
    </script>
}
@model IEnumerable<ProjectTracking.Models.ProjectPhase>
@using System.Globalization
@using System.Linq
@using Microsoft.AspNetCore.Http
@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

@{
    ViewData["Title"] = "บันทึกข้อมูลแผนงานและงวดงาน";
    var th = new CultureInfo("th-TH");
    var selectedProject = ViewBag.SelectedProject;
    var selectedProjectModel = selectedProject as ProjectTracking.Models.Project;
    var pendingPhaseApprovalIds = ViewBag.PendingPhaseApprovalIds as ISet<int> ?? new HashSet<int>();
    var phaseAssignsByPhaseId = ViewBag.PhaseAssignsByPhaseId as IDictionary<int, List<ProjectTracking.Models.PhaseAssign>>
                                ?? new Dictionary<int, List<ProjectTracking.Models.PhaseAssign>>();
    var projectOptions = ViewBag.Projects as IEnumerable<ProjectTracking.Models.Project>
                         ?? Enumerable.Empty<ProjectTracking.Models.Project>();
    var selectedProjectCoopName = ((selectedProject as ProjectTracking.Models.Project)?.Coop?.CoopName ?? "").Trim();
    var projectCoopOptions = projectOptions
        .Select(p => p.Coop?.CoopName?.Trim())
        .Where(name => !string.IsNullOrWhiteSpace(name))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(name => name)
        .ToList();
    var requirementProjectCardDetailUrlTemplate = Url.Action("ProjectCardDetails", "RequirementBoard", new { projectId = "__PROJECT_ID__" }) ?? "";

    var orderedPhases = (Model ?? Enumerable.Empty<ProjectTracking.Models.ProjectPhase>())
        .OrderBy(p => p.PhaseOrder)
        .ThenBy(p => p.PeriodOrder)
        .ThenBy(p => (p.PhaseSort == 0 ? int.MaxValue : p.PhaseSort))
        .ThenBy(p => p.PhaseId);

    string PhaseStatusClass(string? status) => (status ?? "").Trim() switch
    {
        "วางแผน" => "bg-secondary",
        "กำลังดำเนินการ" => "bg-primary",
        "ส่งงวดงานแล้ว" => "bg-success",
        _ => "bg-light text-dark"
    };

    string PhaseTone(string? phaseType) => (phaseType ?? "").Trim().ToUpperInvariant() switch
    {
        "SUPPORT" => "is-support",
        "MAIN" => "is-main",
        _ => "is-muted"
    };

    string PhaseTypeText(string? phaseType) => (phaseType ?? "").Trim().ToUpperInvariant() switch
    {
        "SUPPORT" => "Support",
        "MAIN" => "Main",
        _ => "-"
    };

    string DateRange(DateTime? start, DateTime? end)
    {
        var startText = start?.ToString("dd MMM yyyy", th) ?? "-";
        var endText = end?.ToString("dd MMM yyyy", th) ?? "-";
        return $"{startText} - {endText}";
    }

    var calendarToday = DateTime.Today;
    var calendarYear = calendarToday.Year;
    var calendarThaiYear = calendarYear + 543;
    var thaiMonthNames = th.DateTimeFormat.MonthNames.Take(12).ToArray();
    var thaiDayHeaders = new[] { "อา", "จ", "อ", "พ", "พฤ", "ศ", "ส" };

    string ProfileImage(ProjectTracking.Models.Employee? employee)
        => ProjectTracking.Services.ProfileImagePathResolver.Normalize(employee?.LoginUser?.ProfileImagePath);

    string AssignStatusText(string? status) => string.Equals((status ?? "").Trim(), "DONE", StringComparison.OrdinalIgnoreCase)
        ? "เสร็จสิ้น"
        : "กำลังดำเนินการ";
}

<style>
    table tbody tr.phase-main > td {
        background-color: #ffffff !important;
    }

    table tbody tr.phase-support > td {
        background-color: #f79090ca !important;
    }

    table tbody tr.phase-main {
        border-left: 5px solid #ffffff;
    }

    table tbody tr.phase-support {
        border-left: 5px solid #ad2800;
    }

    .phase-drag-handle {
        font-weight: 700;
        cursor: grab;
        user-select: none;
        display: inline-block;
    }
    table td {
        word-break: break-word;
    }

    /* --- SupportOrders-style Phase Card Layout --- */
    .phase-card-container {
        display: grid;
        gap: 14px;
    }

    .phase-card {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(340px, .42fr);
        background: #fff;
        border: 1px solid #d8e3ef;
        border-left: 5px solid #94a3b8;
        border-radius: 18px;
        padding: 0;
        overflow: hidden;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .phase-assign-toggle {
        flex: 0 0 auto;
        width: 36px;
        height: 36px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #0f766e;
        background: #fff;
        border: 1px solid #5eead4;
        border-radius: 10px;
        font-size: 1.3rem;
        font-weight: 500;
        line-height: 1;
        cursor: pointer;
        transition: color .16s ease, background .16s ease, border-color .16s ease;
    }

    .phase-assign-toggle:hover,
    .phase-assign-toggle[aria-expanded="true"] {
        color: #fff;
        background: #0f8f80;
        border-color: #0f8f80;
    }

    .phase-assign-toggle-count {
        min-width: 24px;
        height: 24px;
        padding: 0 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #0f766e;
        background: #d8faf4;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 700;
    }

    .phase-assign-details {
        grid-column: 1 / -1;
        max-height: 0;
        overflow: hidden;
        visibility: hidden;
        opacity: 0;
        border-top: 0 solid #d8e3ef;
        background: #f8fbff;
        transition: max-height .28s ease, opacity .18s ease, visibility 0s linear .28s, border-top-width .18s ease;
    }

    .phase-assign-details.is-open {
        max-height: 2000px;
        visibility: visible;
        opacity: 1;
        border-top-width: 1px;
        transition: max-height .35s ease, opacity .2s ease, visibility 0s, border-top-width .18s ease;
    }

    .phase-assign-details-inner {
        padding: 16px 18px 18px;
    }

    .phase-assign-details-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
        color: #10233f;
    }

    .phase-assign-details-head strong {
        font-size: .92rem;
        font-weight: 700;
    }

    .phase-assign-list {
        display: grid;
        gap: 8px;
    }

    .phase-assign-item {
        display: grid;
        grid-template-columns: minmax(190px, .8fr) minmax(220px, 1.3fr) minmax(180px, .8fr) auto;
        align-items: center;
        gap: 12px;
        padding: 11px 12px;
        color: #26364d;
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 10px;
    }

    .phase-assign-person {
        min-width: 0;
        display: grid;
        grid-template-columns: 36px minmax(0, 1fr);
        align-items: center;
        gap: 9px;
    }

    .phase-assign-person img {
        width: 36px;
        height: 36px;
        object-fit: cover;
        border: 1px solid #5eead4;
        border-radius: 50%;
    }

    .phase-assign-person span,
    .phase-assign-work,
    .phase-assign-date {
        min-width: 0;
        font-size: .83rem;
        font-weight: 400;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .phase-assign-person strong,
    .phase-assign-work strong,
    .phase-assign-date strong {
        display: block;
        color: #10233f;
        font-weight: 600;
    }

    .phase-assign-position,
    .phase-assign-remark {
        display: block;
        color: #64748b;
        font-size: .76rem;
        font-weight: 400;
    }

    .phase-assign-state {
        white-space: nowrap;
        color: #2563eb;
        font-size: .8rem;
        font-weight: 600;
    }

    .phase-assign-state.is-done { color: #15803d; }

    .phase-assign-empty {
        padding: 14px;
        color: #64748b;
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        font-size: .84rem;
        font-weight: 400;
        text-align: center;
    }

    .phase-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 34px rgba(15, 35, 64, .12);
    }

    .phase-card.is-main {
        border-left-color: #14b8a6;
    }

    .phase-card.is-support {
        border-left-color: #f59e0b;
    }

    .phase-card-main,
    .phase-card-support {
        background: #fff;
    }

    .phase-card-content,
    .phase-card-side {
        min-width: 0;
        padding: 18px;
    }

    .phase-card-side {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 14px;
    }

    .phase-card-head {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 10px;
    }

    .phase-card-drag {
        flex: 0 0 auto;
        width: 36px;
        height: 36px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #062b2f;
        background: rgba(20, 184, 166, .18);
        cursor: grab;
        font-size: 1.1rem;
        font-weight: 900;
        user-select: none;
    }

    .phase-no {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 46px;
        min-height: 32px;
        color: #062b2f;
        background: rgba(20, 184, 166, .18);
        border-radius: 999px;
        font-size: 1rem;
        font-weight: 900;
    }

    .phase-sequence {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .phase-name-row {
        display: block;
        color: #0f172a;
        font-size: .93rem;
        line-height: 1.38;
        overflow-wrap: anywhere;
    }

    .phase-name-label {
        color: #0f172a;
        font-weight: 900;
    }

    .phase-name-value {
        display: inline;
        color: #0f172a;
        font-weight: 400;
        overflow-wrap: anywhere;
    }

    .phase-period {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        min-height: 0;
        padding: 0;
        color: #0f172a;
        background: transparent;
        border: 0;
        border-radius: 0;
        font-size: .9rem;
        font-weight: 400;
        line-height: 1.35;
    }

    .phase-period strong {
        color: #0f172a;
        font-weight: 700;
    }

    .phase-info-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 16px;
        margin-top: 14px;
    }

    .phase-info-box {
        min-width: 0;
        display: inline-flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 4px;
        padding: 0;
        color: #0f172a;
        border: 0;
        border-radius: 0;
        background: transparent;
        overflow-wrap: anywhere;
    }

    .phase-info-label {
        color: #0f172a;
        font-size: .92rem;
        font-weight: 700;
        line-height: 1.35;
        text-transform: none;
    }

    .phase-info-label::after,
    .phase-status-row small::after {
        content: ":";
    }

    .phase-info-value {
        color: #0f172a;
        font-size: .92rem;
        font-weight: 400;
        line-height: 1.35;
    }

    .phase-status-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin-top: 10px;
    }

    .phase-status-row {
        min-width: 0;
        display: inline-flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
    }

    .phase-status-row small {
        color: #0f172a;
        font-size: .92rem;
        font-weight: 700;
        line-height: 1.35;
        text-transform: none;
    }

    .phase-status-row .badge {
        min-height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: normal;
        line-height: 1.15;
        text-align: center;
    }

    .phase-status-row .phase-approval-pending-badge {
        color: #c2410c !important;
        background: #fff7ed !important;
        border: 1px solid #fed7aa;
        box-shadow: 0 4px 10px rgba(194, 65, 12, .10);
        font-weight: 900;
    }

    .phase-card-actions {
        display: flex;
        flex-wrap: nowrap;
        justify-content: flex-end;
        gap: 6px;
    }

    .phase-card-actions form {
        margin: 0;
    }

    .phase-card-actions .btn {
        flex: 0 0 108px;
        width: 108px;
        min-height: 38px;
        padding: .4rem .55rem;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        font-weight: 800;
        line-height: 1.15;
        white-space: nowrap;
    }

    .thai-calendar-note {
        --requirement-card-note-width: min(760px, calc(100vw - 44px));
    }

    .thai-calendar-note .requirement-card-popup__title {
        display: block;
    }

    .thai-calendar-note .requirement-card-popup__body {
        gap: 14px;
    }

    .thai-calendar-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .thai-calendar-month {
        min-width: 0;
        border: 1px solid #cfe0ef;
        border-radius: 16px;
        background: linear-gradient(180deg, rgba(255, 255, 255, .98), rgba(248, 252, 255, .94));
        box-shadow: 0 10px 24px rgba(15, 35, 64, .06);
        overflow: hidden;
    }

    .thai-calendar-month__title {
        padding: 10px 12px;
        color: #0f766e;
        background: #d8faf4;
        font-weight: 900;
        text-align: center;
    }

    .thai-calendar-days {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 1px;
        padding: 8px;
        background: #e2edf7;
    }

    .thai-calendar-day-head,
    .thai-calendar-day {
        min-height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #10213a;
        background: #fff;
        font-size: .82rem;
        font-weight: 800;
    }

    .thai-calendar-day-head {
        min-height: 24px;
        color: #64748b;
        background: #f8fafc;
        font-size: .74rem;
        font-weight: 900;
    }

    .thai-calendar-day.is-empty {
        color: transparent;
        background: rgba(255, 255, 255, .52);
    }

    .thai-calendar-day.is-weekend {
        color: #be123c;
        background: #fff7f8;
    }

    .thai-calendar-day.is-today {
        color: #fff;
        background: linear-gradient(135deg, #21d4c2, #0f8f80);
        box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .72);
    }

    .thai-calendar-note-actions {
        display: flex;
        justify-content: flex-end;
    }

    .phase-filter-form {
        width: 100%;
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 18px;
        padding: 18px;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    }

    .phase-filter-row {
        width: 100%;
    }

    .phase-filter-form .form-control {
        min-height: 48px;
        border-radius: 14px;
        font-weight: 700;
    }

    .phase-selected-people {
        margin-top: 14px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-start;
        gap: 12px;
        max-width: 100%;
    }

    .phase-selected-person-card {
        width: min(190px, 100%);
        min-height: 132px;
        padding: 12px;
        border: 1px solid #d8e3ef;
        border-radius: 16px;
        background: #f8fbff;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-align: center;
        box-shadow: 0 8px 18px rgba(15, 35, 64, .08);
    }

    .phase-selected-person-card .pt-owner-avatar {
        width: 58px;
        height: 58px;
        flex-basis: 58px;
    }

    .phase-selected-person-label {
        color: #0f766e;
        font-size: .78rem;
        font-weight: 900;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .phase-selected-person-name {
        max-width: 100%;
        color: #10233f;
        font-size: .92rem;
        font-weight: 800;
        line-height: 1.22;
        overflow-wrap: anywhere;
    }

    #projectDropdown {
        width: 100%;
        border-radius: 14px;
        box-shadow: 0 14px 28px rgba(15, 35, 64, .12);
    }
    @@media (max-width: 991.98px) {
        .phase-card {
            grid-template-columns: 1fr;
        }

        .phase-card-side {
            border-left: 0;
            border-top: 1px solid #e2e8f0;
        }

        .phase-card-actions {
            flex-wrap: nowrap;
            justify-content: flex-start;
        }

        .phase-assign-item {
            grid-template-columns: minmax(180px, 1fr) minmax(220px, 1.4fr);
        }

    }

    @@media (max-width: 575.98px) {
        .thai-calendar-grid {
            grid-template-columns: 1fr;
        }

        .phase-card-actions {
            flex-wrap: wrap;
        }

        .phase-card-actions .btn {
            flex: 1 1 calc(50% - 6px);
            width: auto;
        }

        .phase-assign-item {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">บันทึกข้อมูลแผนงานและงวดงาน</h2>
        <p class="index-subtitle">เลือกโครงการเพื่อจัดการส่วนงานและงวดงานของแต่ละ Project</p>
    </div>

    @if (selectedProject != null)
    {
        <div class="index-actions">
            <a asp-controller="Projects"
               asp-action="Index"
               class="btn btn-outline-secondary"
               title="กลับไปหน้ารายการโครงการ">
                โครงการ
            </a>

            <button id="RequirementCardDetailButton"
                    type="button"
                    class="btn btn-outline-primary project-board-card-detail"
                    data-detail-project-url-template="@requirementProjectCardDetailUrlTemplate"
                    data-project-field-id="hiddenProjectSelect"
                    title="เปิดดูรายละเอียด Project Board">
                รายละเอียด Project Board
            </button>

            <button id="ThaiCalendarNoteButton"
                    type="button"
                    class="btn btn-outline-warning"
                    title="เปิดปฏิทินไทยปี @calendarThaiYear">
                ปฏิทิน
            </button>

            @if (CanMenu("ProjectPhases.Create"))
            {
                <a asp-action="Create"
                   asp-route-projectId="@selectedProject.ProjectId"
                   class="btn btn-primary"
                   title="เพิ่มส่วนงาน">
                    เพิ่มส่วนงาน
                </a>

                @if (selectedProject.RequirementCardId != null)
                {
                    <form asp-action="ImportFromRequirementCard"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Import ร่างส่วนงาน/งวดงานจาก Project Board เข้ามาใน Project นี้หรือไม่?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@selectedProject.ProjectId" />
                        <button type="submit"
                                class="btn btn-outline-success"
                                title="ดึงข้อมูลส่วนงาน/งวดงานจาก Project Board Card">
                            นำเข้า Project Board
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn btn-outline-secondary" disabled title="โครงการนี้ยังไม่ได้ผูก Project Board Card">
                        นำเข้า Project Board
                    </button>
                }
            }
            else
            {
                <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์เพิ่มส่วนงาน">
                    เพิ่มส่วนงาน
                </button>
            }

            @if (CanMenu("PhaseAssigns.Index"))
            {
                <a asp-controller="PhaseAssigns"
                   asp-action="Index"
                   asp-route-projectId="@selectedProject.ProjectId"
                   class="btn btn-outline-info"
                   title="มอบงาน">
                    มอบงาน
                </a>
            }
            else
            {
                <button class="btn btn-outline-secondary" disabled title="ไม่มีสิทธิ์มอบงาน">
                    มอบงาน
                </button>
            }
        </div>
    }
</div>

<partial name="_RequirementCardDetailModal" />

<aside class="requirement-card-popup requirement-card-note thai-calendar-note" id="ThaiCalendarNoteModal" aria-hidden="true">
    <div class="requirement-card-note__panel">
        <div class="requirement-card-popup__header" id="ThaiCalendarNoteHeader">
            <div class="requirement-card-popup__heading">
                <div class="requirement-card-popup__eyebrow">ProjectTracking</div>
                <h5 class="requirement-card-popup__title">ปฏิทินไทย @calendarThaiYear</h5>
                <div class="requirement-card-popup__meta">
                    วันนี้ @calendarToday.ToString("dd MMMM yyyy", th)
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-thai-calendar-close aria-label="Close"></button>
        </div>
        <div class="requirement-card-popup__body requirement-card-note__body">
            <section class="requirement-card-popup__section">
                <div class="requirement-card-popup__section-head">
                    <h6 class="requirement-card-popup__label mb-0">ปี @calendarThaiYear</h6>
                    <span class="requirement-card-popup__count">12 เดือน</span>
                </div>

                <div class="thai-calendar-grid">
                    @for (var month = 1; month <= 12; month++)
                    {
                        var firstDay = new DateTime(calendarYear, month, 1);
                        var leadingBlanks = (int)firstDay.DayOfWeek;
                        var daysInMonth = DateTime.DaysInMonth(calendarYear, month);

                        <article class="thai-calendar-month">
                            <div class="thai-calendar-month__title">@thaiMonthNames[month - 1]</div>
                            <div class="thai-calendar-days">
                                @foreach (var dayHeader in thaiDayHeaders)
                                {
                                    <div class="thai-calendar-day-head">@dayHeader</div>
                                }

                                @for (var blank = 0; blank < leadingBlanks; blank++)
                                {
                                    <div class="thai-calendar-day is-empty" aria-hidden="true">0</div>
                                }

                                @for (var day = 1; day <= daysInMonth; day++)
                                {
                                    var date = new DateTime(calendarYear, month, day);
                                    var isWeekend = date.DayOfWeek == DayOfWeek.Sunday || date.DayOfWeek == DayOfWeek.Saturday;
                                    var isToday = date.Date == calendarToday.Date;
                                    var dayClass = isToday
                                        ? "thai-calendar-day is-today"
                                        : isWeekend
                                            ? "thai-calendar-day is-weekend"
                                            : "thai-calendar-day";

                                    <div class="@dayClass">@day</div>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>

            <div class="thai-calendar-note-actions">
                <button type="button" class="btn btn-outline-secondary" data-thai-calendar-close>ปิด</button>
            </div>
        </div>
    </div>
</aside>


@model ProjectTracking.Models.ProjectSupportOrder

@{
    DateTime? startDate = Model?.StartDate;
    DateTime? endDate = Model?.EndDate;
    var projectId = Model?.ProjectId ?? 0;

    string ThaiDateText(DateTime? value)
    {
        if (!value.HasValue) return "";
        var year = value.Value.Year;
        while (year > 2200) year -= 543;
        return $"{value.Value:dd/MM/}{year + 543}";
    }

    string startDateText = ThaiDateText(startDate);
    string endDateText = ThaiDateText(endDate);
}

<h3>สร้าง Support Order</h3>

<form asp-action="Create" asp-route-projectId="@projectId" method="post" enctype="multipart/form-data">
@Html.AntiForgeryToken()

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
<label>Project</label>
<input asp-for="ProjectId" type="hidden" />
<input type="text" class="form-control" value="@ViewBag.SelectedProjectName" readonly />
<span asp-validation-for="ProjectId" class="text-danger"></span>
</div>

<input type="hidden" asp-for="DevStatus" value="WIP" />
<input type="hidden" asp-for="Status" value="OPEN" />

<div class="mb-3">
<label>Title</label>
<input asp-for="OrderTitle" class="form-control"/>
</div>

<div class="mb-3">
<label>Detail</label>
<textarea asp-for="OrderDetail" class="form-control"></textarea>
</div>

<div class="mb-3">
<label>Priority</label>
<select asp-for="Priority" class="form-select">
<option>LOW</option>
<option>MEDIUM</option>
<option>HIGH</option>
<option>URGENT</option>
</select>
</div>

<div class="mb-3">
<label>Status</label>
<div class="pt-readonly-field">OPEN - เปิดงาน / รอแก้</div>
<span asp-validation-for="Status" class="text-danger"></span>
</div>

<div class="row g-3 mb-3">
<div class="col-md-6">
<label>วันที่เริ่ม</label>
<input asp-for="StartDate"
       type="text"
       class="form-control thai-date"
       value="@startDateText"
       placeholder="วัน/เดือน/พ.ศ."
       required />
<span asp-validation-for="StartDate" class="text-danger"></span>
</div>

<div class="col-md-6">
<label>วันที่สิ้นสุด</label>
<input asp-for="EndDate"
       type="text"
       class="form-control thai-date"
       value="@endDateText"
       placeholder="วัน/เดือน/พ.ศ."
       required />
<span asp-validation-for="EndDate" class="text-danger"></span>
</div>
</div>

<div class="mb-3">
<label>Assign To</label>
<select asp-for="AssignTo" asp-items="ViewBag.EmployeeList" class="form-select">
<option value="">-- Select Employee --</option>
</select>
</div>

<div class="mb-3">
<label>Upload Images</label>
<input type="file" name="files" multiple class="form-control"/>
</div>

<button class="btn btn-primary">Save</button>
<a asp-action="Index" asp-route-projectId="@projectId" class="btn btn-secondary ms-2">Back</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function convertThaiDateToIso(value) {
            if (!value || !value.trim()) return '';

            const parts = value.trim().split('/');
            if (parts.length !== 3) return value;

            let [d, m, y] = parts;
            d = d.padStart(2, '0');
            m = m.padStart(2, '0');
            y = parseInt(y, 10);

            while (y > 2200) {
                y -= 543;
            }

            return `${y}-${m}-${d}`;
        }

        function formatThaiDateInput(input) {
            if (!input) return;

            input.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');

                if (value.length > 8) {
                    value = value.substring(0, 8);
                }

                if (value.length >= 5) {
                    value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
                } else if (value.length >= 3) {
                    value = `${value.substring(0, 2)}/${value.substring(2)}`;
                }

                e.target.value = value;
            });
        }

        formatThaiDateInput(document.getElementById('StartDate'));
        formatThaiDateInput(document.getElementById('EndDate'));

        document.querySelector('form').addEventListener('submit', function () {
            document.querySelectorAll('.thai-date').forEach(input => {
                input.value = convertThaiDateToIso(input.value);
            });
        }, true);
    </script>
}

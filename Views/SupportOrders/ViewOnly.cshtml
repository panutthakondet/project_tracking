@model IEnumerable<ProjectTracking.Models.ProjectSupportOrder>
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = null;
    var th = new CultureInfo("th-TH");
    var orders = (Model ?? Enumerable.Empty<ProjectTracking.Models.ProjectSupportOrder>()).ToList();
    var projects = ViewBag.Projects as IEnumerable<ProjectTracking.Models.Project> ?? Enumerable.Empty<ProjectTracking.Models.Project>();
    var selectedProjectId = ViewBag.SelectedProjectId is int projectId ? projectId : (int?)null;
    var selectedBA = ViewBag.SelectedBA is int baId ? baId : (int?)null;
    var selectedEmp = ViewBag.SelectedEmp as string;
    var selectedStatus = ViewBag.SelectedStatus as string ?? "";
    var selectedPriority = ViewBag.SelectedPriority as string ?? "";
    var selectedDevStatus = ViewBag.SelectedDevStatus as string ?? "";
    var baList = ViewBag.BAList as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var empList = ViewBag.EmpList as IEnumerable<string> ?? Enumerable.Empty<string>();
    var statusList = ViewBag.StatusList as IEnumerable<string> ?? Enumerable.Empty<string>();
    var priorityList = ViewBag.PriorityList as IEnumerable<string> ?? Enumerable.Empty<string>();
    var devStatusList = ViewBag.DevStatusList as IEnumerable<string> ?? Enumerable.Empty<string>();
    var imageCounts = ViewBag.ImageCounts as IDictionary<int, int> ?? new Dictionary<int, int>();
    var today = DateTime.Today;
    var totalFail = orders.Sum(x => x.ReopenCount);
    var coopList = projects
        .Select(x => x.Coop?.CoopName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    string SelectedProjectName() => selectedProjectId.HasValue
        ? projects.FirstOrDefault(x => x.ProjectId == selectedProjectId.Value)?.ProjectDisplayName ?? "-"
        : "All Projects";
    string SelectedBAText()
    {
        if (!selectedBA.HasValue) return "All BA";
        return baList.FirstOrDefault(x => x.Value == selectedBA.Value.ToString())?.Text ?? $"BA #{selectedBA.Value}";
    }

    bool IsClosed(string? status, string? devStatus)
    {
        var s = (status ?? "").Trim().ToUpperInvariant();
        return s == "PASS" || s == "REJECT" || s == "DONE" || s == "CLOSED" || s == "RESOLVED";
    }

    string StatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "warning",
        "FAIL" => "danger",
        "PASS" => "success",
        "REJECT" => "muted",
        _ => "muted"
    };

    string DevStatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "WIP" => "warning",
        "FIXED" => "success",
        _ => "muted"
    };

    string PriorityClass(string? priority) => (priority ?? "").Trim().ToUpperInvariant() switch
    {
        "URGENT" => "danger",
        "HIGH" => "danger",
        "MEDIUM" => "warning",
        "LOW" => "success",
        _ => "muted"
    };

    string DateText(DateTime? value) => value?.ToString("dd/MM/yyyy", th) ?? "-";
    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    var openCount = orders.Count(x => !IsClosed(x.Status, x.DevStatus));
    var waitingBaCount = orders.Count(x =>
        !IsClosed(x.Status, x.DevStatus) &&
        string.Equals(x.DevStatus, "FIXED", StringComparison.OrdinalIgnoreCase));
    var closedCount = orders.Count(x => IsClosed(x.Status, x.DevStatus));
    var overdueCount = orders.Count(x => !IsClosed(x.Status, x.DevStatus) && x.EndDate?.Date < today);
    var urgentCount = orders.Count(x =>
        string.Equals(x.Priority, "URGENT", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(x.Priority, "HIGH", StringComparison.OrdinalIgnoreCase));
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>Support Report</title>
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&display=swap");
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 16px;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 11px;
        }
        .report-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }
        .report-btn {
            min-height: 34px;
            padding: 7px 13px;
            border: 1px solid #102443;
            border-radius: 999px;
            color: #102443;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 900;
            line-height: 1.1;
            text-decoration: none;
            cursor: pointer;
        }
        .report-btn.primary {
            color: #fff;
            background: #102443;
        }
        .print-header {
            margin-bottom: 12px;
            padding: 14px 16px;
            color: #fff;
            background: #102443;
        }
        .print-header h1 {
            margin: 0 0 6px;
            font-size: 22px;
        }
        .print-header div {
            color: rgba(255,255,255,.82);
            font-weight: 700;
            line-height: 1.55;
        }
        .filter-panel {
            display: grid;
            grid-template-columns: minmax(240px, 1.25fr) minmax(190px, .9fr) minmax(190px, .9fr) repeat(3, minmax(140px, .65fr)) auto;
            align-items: end;
            gap: 10px;
            margin-bottom: 12px;
            padding: 12px;
            border: 1px solid #d8e3ef;
            background: #f8fbff;
        }
        .field label {
            display: block;
            margin-bottom: 5px;
            color: #64748b;
            font-weight: 900;
        }
        .field select {
            width: 100%;
            min-height: 34px;
            padding: 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
        }
        .pt-native-select-hidden {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            min-height: 1px !important;
            opacity: 0 !important;
            pointer-events: none !important;
            clip-path: inset(50%) !important;
        }
        .pt-search-select {
            position: relative;
            width: 100%;
        }
        .pt-search-select__field {
            position: relative;
        }
        .pt-search-select__input {
            width: 100%;
            min-height: 34px;
            padding: 7px 38px 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            outline: none;
        }
        .pt-search-select__input:focus {
            border-color: #14b8a6;
            box-shadow: 0 0 0 3px rgba(20, 184, 166, .12);
        }        .pt-search-select__dropdown {
            position: absolute;
            left: 0;
            right: 0;
            top: calc(100% + 4px);
            z-index: 20;
            width: 100%;
            max-height: 240px;
            overflow-y: auto;
            display: none;
            border: 1px solid #d8e2ef;
            background: #fff;
            box-shadow: 0 12px 26px rgba(15, 35, 64, .14);
        }
        .pt-search-select.is-open .pt-search-select__dropdown {
            display: block;
        }
        .pt-search-select__option {
            width: 100%;
            padding: 8px 10px;
            border: 0;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.35;
            text-align: left;
            cursor: pointer;
        }
        .pt-search-select__option:hover,
        .pt-search-select__option.is-selected {
            color: #062b2f;
            background: rgba(20, 184, 166, .14);
        }
        .pt-search-select__empty {
            padding: 10px;
            color: #64748b;
            font-weight: 800;
            text-align: center;
        }
        .filter-submit {
            width: auto;
            min-width: 88px;
            justify-self: start;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin-bottom: 12px;
        }
        .kpi {
            padding: 10px;
            border: 1px solid #d8e3ef;
            border-left: 4px solid #14b8a6;
        }
        .kpi.info { border-left-color: #258cfb; }
        .kpi.warning { border-left-color: #f59e0b; }
        .kpi.danger { border-left-color: #f43f5e; }
        .kpi span,
        .kpi small {
            display: block;
            color: #64748b;
            font-weight: 800;
        }
        .kpi strong {
            display: block;
            margin: 5px 0;
            color: #10233f;
            font-size: 20px;
            font-weight: 900;
        }
        h2 {
            margin: 14px 0 8px;
            color: #10233f;
            font-size: 16px;
            font-weight: 900;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin-bottom: 12px;
        }
        .support-report-table col.col-seq { width: 5%; }
        .support-report-table col.col-support { width: 23%; }
        .support-report-table col.col-detail { width: 28%; }
        .support-report-table col.col-owner { width: 16%; }
        .support-report-table col.col-state { width: 14%; }
        .support-report-table col.col-date { width: 14%; }
        th {
            padding: 7px 6px;
            color: #fff;
            background: #102443;
            border: 1px solid rgba(255,255,255,.18);
            font-weight: 900;
            text-align: center;
        }
        td {
            padding: 7px 6px;
            border: 1px solid #d8e3ef;
            line-height: 1.45;
            vertical-align: top;
            overflow-wrap: break-word;
            word-break: normal;
        }
        tr:nth-child(even) td { background: #f8fbff; }
        .text-center { text-align: center; }
        .long-text { white-space: pre-line; }
        .project-group-row td {
            padding: 8px 10px;
            color: #fff;
            background: #18365e !important;
            border-color: #18365e;
            font-size: 12px;
            font-weight: 900;
        }
        .project-group-name {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }
        .project-group-label {
            color: #8df1e4;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: .05em;
            text-transform: uppercase;
        }
        .project-group-count {
            flex: 0 0 auto;
            color: rgba(255, 255, 255, .78);
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }
        .project-group-stats {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 12px;
            margin-top: 5px;
            color: rgba(255,255,255,.82);
            font-size: 10px;
            font-weight: 800;
        }
        .project-group-stats b {
            color: #8df1e4;
            font-weight: 900;
        }
        .cell-title {
            color: #10233f;
            font-weight: 900;
        }
        .cell-sub {
            margin-top: 4px;
            color: #111827;
            font-weight: 400;
        }
        .detail-block {
            display: grid;
            gap: 6px;
        }
        .detail-block div {
            padding: 6px 7px;
            border-radius: 8px;
            background: #f8fbff;
            border: 1px solid #e6edf6;
            color: #111827;
            font-weight: 400;
            line-height: 1.45;
        }
        .detail-block b {
            display: block;
            margin-bottom: 3px;
            color: #111827;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .meta-stack {
            display: grid;
            gap: 5px;
        }
        .meta-line {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            align-items: baseline;
        }
        .meta-label {
            color: #111827;
            font-weight: 600;
        }
        .meta-value {
            color: #111827;
            font-weight: 600;
            text-align: right;
        }
        .status-text {
            font-weight: 900;
            white-space: nowrap;
        }
        .status-text.success { color: #0f8f5f; }
        .status-text.warning { color: #b7790b; }
        .status-text.info { color: #0f6fa8; }
        .status-text.danger { color: #d6294f; }
        .status-text.muted { color: #64748b; }
        .empty {
            padding: 18px;
            border: 1px dashed #cbd5e1;
            color: #111827;
            text-align: center;
            font-weight: 400;
        }
        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
        @@media print {
            body {
                padding: 0;
                font-size: 10px;
            }
            .report-actions,
            .filter-panel { display: none !important; }
            .print-header { padding: 10px 12px; }
            .print-header h1 { font-size: 18px; }
            .kpi-grid { gap: 6px; }
            .kpi { padding: 7px; }
            .kpi strong { font-size: 16px; }
            th,
            td { padding: 5px 5px; }
            h2, h3,
            .project-group-row,
            .scenario-project__header,
            .scenario-group__header,
            .phase-project-group {
                break-after: avoid;
                page-break-after: avoid;
            }
            h2 + table,
            h2 + .empty,
            h2 + .report-table-scroll,
            h3 + table,
            h3 + .empty,
            .project-group-row + tr {
                break-before: avoid;
                page-break-before: avoid;
            }
            .report-section,
            .scenario-project,
            .scenario-group,
            .project-group-row,
            .phase-project-group {
                break-inside: avoid-page;
                page-break-inside: avoid;
            }
            thead { display: table-header-group; }
            tr { page-break-inside: avoid; }
        }
        @@media (max-width: 1100px) {
            .filter-panel,
            .kpi-grid {
                grid-template-columns: 1fr;
            }
        }
    
        /* Crisp typography normalization for standalone pages. */
        :root { --pt-readable-thai-font: "Noto Sans Thai", "Leelawadee UI", Tahoma, "Segoe UI", Arial, sans-serif; }
        html, body {
            font-family: var(--pt-readable-thai-font) !important;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }
        body :where(*):not(svg):not(svg *) {
            font-family: var(--pt-readable-thai-font) !important;
            font-stretch: normal !important;
            letter-spacing: 0 !important;
            text-shadow: none !important;
        }
        body :is(h1, h2, h3, h4, h5, h6, th, label, strong, b, .report-btn, .btn, .badge, .status-text, .cell-title, .project-group-name, [class*="title"], [class*="heading"], [class*="eyebrow"], [class*="status"], [class*="badge"], [class*="count"], [class*="total"], [class*="value"]) {
            font-weight: 700 !important;
        }
        body :is(p, li, td, small, em, time, .cell-sub, .detail-block div, .meta-label, .meta-value, .empty, [class*="detail"], [class*="meta"], [class*="subtitle"], [class*="description"], [class*="desc"], [class*="remark"], [class*="note"], [class*="empty"]):not(.btn):not(.badge):not(.status-text):not([class*="status-"]):not([class*="Status"]) {
            font-weight: 400 !important;
        }
</style>
@await Html.PartialAsync("_StandaloneTheme")
</head>
<body class="pt-standalone-report">
    <div class="report-actions">
        <button type="button" class="report-btn primary" onclick="window.print()">Print</button>
        <a asp-controller="Reports" asp-action="Index" class="report-btn">Report Center</a>
        <a asp-controller="Home" asp-action="Index" class="report-btn">Dashboard</a>
    </div>

    <header class="print-header">
        <h1>Support Report</h1>
        <div>
            Project: @SelectedProjectName()<br />
            BA: @SelectedBAText()<br />
            Employee: @(string.IsNullOrWhiteSpace(selectedEmp) ? "All Employees" : selectedEmp)<br />
            Status: @(string.IsNullOrWhiteSpace(selectedStatus) ? "All Statuses" : selectedStatus)<br />
            Priority: @(string.IsNullOrWhiteSpace(selectedPriority) ? "All Priorities" : selectedPriority)<br />
            Dev: @(string.IsNullOrWhiteSpace(selectedDevStatus) ? "All Dev Statuses" : selectedDevStatus)<br />
            ข้อมูล ณ @DateTime.Now.ToString("dd MMM yyyy HH:mm", th)
        </div>
    </header>

    <form method="get" class="filter-panel">
        <div class="field">
            <label for="coopFilter">Cooperative</label>
            <select id="coopFilter" data-placeholder="🔍 พิมพ์ค้นหาสหกรณ์...">
                <option value="">-- All Cooperatives --</option>
                @foreach (var coop in coopList)
                {
                    <option value="@coop">@coop</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="projectId">Project</label>
            <select id="projectId" name="projectId" data-placeholder="🔍 พิมพ์ค้นหา Project..." onchange="this.form.submit()">
                <option value="">-- All Projects --</option>
                @foreach (var project in projects)
                {
                    <option value="@project.ProjectId"
                            data-coop-name="@(project.Coop?.CoopName ?? "")"
                            selected="@(selectedProjectId == project.ProjectId ? "selected" : null)">
                        @project.ProjectDisplayName
                    </option>
                }
            </select>
        </div>
        <div class="field">
            <label for="baEmpId">BA</label>
            <select id="baEmpId" name="baEmpId" data-placeholder="🔍 พิมพ์ค้นหา BA..." onchange="this.form.submit()">
                <option value="">-- All BA --</option>
                @foreach (var ba in baList)
                {
                    <option value="@ba.Value" selected="@(selectedBA.HasValue && ba.Value == selectedBA.Value.ToString() ? "selected" : null)">
                        @ba.Text
                    </option>
                }
            </select>
        </div>
        <div class="field">
            <label for="empName">Employee</label>
            <select id="empName" name="empName" data-placeholder="🔍 พิมพ์ค้นหา Employee..." onchange="this.form.submit()">
                <option value="">-- All Employees --</option>
                @foreach (var emp in empList)
                {
                    <option value="@emp" selected="@(emp == selectedEmp ? "selected" : null)">
                        @emp
                    </option>
                }
            </select>
        </div>
        <div class="field">
            <label for="status">Status</label>
            <select id="status" name="status" data-placeholder="🔍 พิมพ์ค้นหา Status..." onchange="this.form.submit()">
                <option value="">-- All Statuses --</option>
                @foreach (var item in statusList)
                {
                    <option value="@item" selected="@(selectedStatus == item ? "selected" : null)">@item</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="priority">Priority</label>
            <select id="priority" name="priority" data-placeholder="🔍 พิมพ์ค้นหา Priority..." onchange="this.form.submit()">
                <option value="">-- All Priorities --</option>
                @foreach (var item in priorityList)
                {
                    <option value="@item" selected="@(selectedPriority == item ? "selected" : null)">@item</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="devStatus">Dev Status</label>
            <select id="devStatus" name="devStatus" data-placeholder="🔍 พิมพ์ค้นหา Dev Status..." onchange="this.form.submit()">
                <option value="">-- All Dev Statuses --</option>
                @foreach (var item in devStatusList)
                {
                    <option value="@item" selected="@(selectedDevStatus == item ? "selected" : null)">@item</option>
                }
            </select>
        </div>
        <button type="submit" class="report-btn primary filter-submit">ค้นหา</button>
    </form>

    <section class="kpi-grid">
        <article class="kpi info">
            <span>Total Support</span>
            <strong>@orders.Count</strong>
            <small>รายการทั้งหมด</small>
        </article>
        <article class="kpi warning">
            <span>Open</span>
            <strong>@openCount</strong>
            <small>ยังไม่ปิดงาน</small>
        </article>
        <article class="kpi">
            <span>รอ BA ตรวจ</span>
            <strong>@waitingBaCount</strong>
            <small>Dev FIXED แล้ว รอตรวจผล</small>
        </article>
        <article class="kpi success">
            <span>Closed</span>
            <strong>@closedCount</strong>
            <small>PASS / REJECT</small>
        </article>
        <article class="kpi danger">
            <span>Overdue</span>
            <strong>@overdueCount</strong>
            <small>เลยวันที่สิ้นสุด</small>
        </article>
        <article class="kpi danger">
            <span>High Priority</span>
            <strong>@urgentCount</strong>
            <small>HIGH / URGENT</small>
        </article>
        <article class="kpi warning">
            <span>จำนวน FAIL</span>
            <strong>@totalFail</strong>
            <small>จำนวน FAIL รวม</small>
        </article>
    </section>

    <h2>Support List By Project</h2>
    @if (!orders.Any())
    {
        <div class="empty">ไม่พบรายการ Support ตามเงื่อนไขที่เลือก</div>
    }
    else
    {
        <table class="support-report-table">
            <colgroup>
                <col class="col-seq" />
                <col class="col-support" />
                <col class="col-detail" />
                <col class="col-owner" />
                <col class="col-state" />
                <col class="col-date" />
            </colgroup>
            <thead>
                <tr>
                    <th>Seq</th>
                    <th>Support</th>
                    <th>Detail</th>
                    <th>Owner / BA</th>
                    <th>Priority / Status</th>
                    <th>วันที่ / รูป</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var projectGroups = orders
                        .GroupBy(order => new
                        {
                            order.ProjectId,
                            ProjectName = TextOrDash(order.Project?.ProjectDisplayName),
                            BAName = TextOrDash(order.Project?.BA?.EmpName)
                        })
                        .OrderBy(group => group.Key.ProjectName)
                        .ToList();
                }
                @foreach (var projectGroup in projectGroups)
                {
                    var seq = 1;
                    var groupOpen = projectGroup.Count(x => !IsClosed(x.Status, x.DevStatus));
                    var groupWaitingBa = projectGroup.Count(x =>
                        !IsClosed(x.Status, x.DevStatus) &&
                        string.Equals(x.DevStatus, "FIXED", StringComparison.OrdinalIgnoreCase));
                    var groupDone = projectGroup.Count(x => IsClosed(x.Status, x.DevStatus));
                    var groupDevFixed = projectGroup.Count(x => string.Equals(x.DevStatus, "FIXED", StringComparison.OrdinalIgnoreCase));
                    var groupOverdue = projectGroup.Count(x => !IsClosed(x.Status, x.DevStatus) && x.EndDate?.Date < today);
                    var groupFail = projectGroup.Sum(x => x.ReopenCount);
                    <tr class="project-group-row">
                        <td colspan="6">
                            <div class="project-group-name">
                                <div>
                                    <span class="project-group-label">Project</span>
                                    @projectGroup.Key.ProjectName
                                    <div class="cell-sub">BA: @projectGroup.Key.BAName</div>
                                    <div class="project-group-stats">
                                        <span>Open <b>@groupOpen</b></span>
                                        <span>รอ BA ตรวจ <b>@groupWaitingBa</b></span>
                                        <span>Closed <b>@groupDone</b></span>
                                        <span>Dev Fixed <b>@groupDevFixed</b></span>
                                        <span>Overdue <b>@groupOverdue</b></span>
                                        <span>FAIL <b>@groupFail</b></span>
                                    </div>
                                </div>
                                <span class="project-group-count">@projectGroup.Count() รายการ</span>
                            </div>
                        </td>
                    </tr>

                    @foreach (var order in projectGroup)
                    {
                        var beforeCount = imageCounts.TryGetValue(order.OrderId, out var count) ? count : 0;
                        var afterCount = order.FixImages?.Count ?? 0;
                        <tr>
                            <td class="text-center">@seq</td>
                            <td>
                                <div class="cell-title">@TextOrDash(order.OrderTitle)</div>
                                <div class="cell-sub">#@order.OrderId</div>
                            </td>
                            <td>
                                <div class="detail-block">
                                    <div>
                                        <b>Support Detail</b>
                                        @TextOrDash(order.OrderDetail)
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="meta-stack">
                                    <div>
                                        <span class="meta-label">BA</span>
                                        <div class="meta-value">@TextOrDash(order.Project?.BA?.EmpName)</div>
                                    </div>
                                    <div>
                                        <span class="meta-label">Assign To</span>
                                        <div class="meta-value">@TextOrDash(order.Employee?.EmpName)</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="meta-stack">
                                    <div class="meta-line">
                                        <span class="meta-label">Priority</span>
                                        <span class="status-text @PriorityClass(order.Priority)">@TextOrDash(order.Priority)</span>
                                    </div>
                                    <div class="meta-line">
                                        <span class="meta-label">Status</span>
                                        <span class="status-text @StatusClass(order.Status)">@TextOrDash(order.Status)</span>
                                    </div>
                                    <div class="meta-line">
                                        <span class="meta-label">Dev</span>
                                        <span class="status-text @DevStatusClass(order.DevStatus)">@TextOrDash(order.DevStatus)</span>
                                    </div>
                                    <div class="meta-line">
                                        <span class="meta-label">จำนวน FAIL</span>
                                        <span class="status-text @(order.ReopenCount > 0 ? "warning" : "success")">
                                            @(order.ReopenCount > 0 ? order.ReopenCount.ToString() : "-")
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="meta-stack">
                                    <div class="meta-line">
                                        <span class="meta-label">เริ่ม</span>
                                        <span class="meta-value">@DateText(order.StartDate)</span>
                                    </div>
                                    <div class="meta-line">
                                        <span class="meta-label">สิ้นสุด</span>
                                        <span class="status-text @(order.EndDate?.Date < today && !IsClosed(order.Status, order.DevStatus) ? "danger" : "muted")">
                                            @DateText(order.EndDate)
                                        </span>
                                    </div>
                                    <div class="meta-line">
                                        <span class="meta-label">Created</span>
                                        <span class="meta-value">@DateText(order.CreatedAt)</span>
                                    </div>
                                    <div class="meta-line">
                                        <span class="meta-label">Images</span>
                                        <span class="meta-value">@beforeCount / @afterCount</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        seq++;
                    }
                }
            </tbody>
        </table>
    }
    <script>
        (function () {
            function normalize(value) {
                return (value || "").toString().trim().toLowerCase();
            }

            function getSelectedOption(select) {
                return select.options[select.selectedIndex] || null;
            }

            function dispatchSelectChange(select) {
                select.dispatchEvent(new Event("input", { bubbles: true }));
                select.dispatchEvent(new Event("change", { bubbles: true }));
            }

            function enhanceSelect(select) {
                if (!select || select.classList.contains("pt-dropdown-enhanced")) return;

                const wrapper = document.createElement("div");
                wrapper.className = "pt-search-select";

                const field = document.createElement("div");
                field.className = "pt-search-select__field";

                const input = document.createElement("input");
                input.type = "text";
                input.className = "pt-search-select__input";
                input.autocomplete = "off";
                input.placeholder = select.dataset.placeholder || getSelectedOption(select)?.text || "🔍 พิมพ์ค้นหา...";
                const dropdown = document.createElement("div");
                dropdown.className = "pt-search-select__dropdown";

                field.appendChild(input);
                wrapper.appendChild(field);
                wrapper.appendChild(dropdown);
                select.parentNode.insertBefore(wrapper, select);
                wrapper.appendChild(select);
                select.classList.add("pt-native-select-hidden", "pt-dropdown-enhanced");

                const options = Array.from(select.options).map(option => ({
                    value: option.value,
                    text: option.text.trim(),
                    option
                }));

                function syncInput() {
                    const selected = getSelectedOption(select);
                    input.value = selected ? selected.text.trim() : "";                }

                function renderOptions() {
                    const term = normalize(input.value);
                    dropdown.innerHTML = "";

                    const matches = options.filter(item => !item.option.disabled && (!term || normalize(item.text).includes(term)));
                    if (!matches.length) {
                        const empty = document.createElement("div");
                        empty.className = "pt-search-select__empty";
                        empty.textContent = "ไม่พบข้อมูล";
                        dropdown.appendChild(empty);
                        return;
                    }

                    matches.forEach(item => {
                        const button = document.createElement("button");
                        button.type = "button";
                        button.className = "pt-search-select__option";
                        if (item.option.selected) button.classList.add("is-selected");
                        button.textContent = item.text || "--";
                        button.addEventListener("click", () => {
                            select.value = item.value;
                            syncInput();
                            wrapper.classList.remove("is-open");
                            dispatchSelectChange(select);
                        });
                        dropdown.appendChild(button);
                    });
                }

                input.addEventListener("focus", () => {
                    input.value = "";
                    renderOptions();
                    wrapper.classList.add("is-open");
                });

                input.addEventListener("input", () => {
                    renderOptions();
                    wrapper.classList.add("is-open");
                });
                document.addEventListener("click", event => {
                    if (!wrapper.contains(event.target)) wrapper.classList.remove("is-open");
                });

                syncInput();
                renderOptions();
            }

            document.querySelectorAll("select[data-placeholder]").forEach(enhanceSelect);

            const coopFilter = document.getElementById("coopFilter");
            const projectFilter = document.getElementById("projectId");

            function syncProjectFilterOptions() {
                if (!projectFilter) return;

                const selectedCoop = normalize(coopFilter?.value || "");
                Array.from(projectFilter.options).forEach(option => {
                    const visible = option.value === "" || !selectedCoop || normalize(option.dataset.coopName || "") === selectedCoop;
                    option.hidden = !visible;
                    option.disabled = !visible;
                });

                const selected = projectFilter.selectedOptions[0];
                if (selected && selected.disabled) projectFilter.value = "";
            }

            coopFilter?.addEventListener("change", function () {
                localStorage.setItem("reports.support.selectedCoop", normalize(coopFilter.value));
                if (projectFilter) projectFilter.value = "";
                syncProjectFilterOptions();
            });

            const savedCoop = localStorage.getItem("reports.support.selectedCoop") || "";
            if (savedCoop && coopFilter) {
                const match = Array.from(coopFilter.options).find(option => normalize(option.value) === savedCoop);
                if (match) coopFilter.value = match.value;
            }

            syncProjectFilterOptions();
        })();
    </script>
</body>
</html>

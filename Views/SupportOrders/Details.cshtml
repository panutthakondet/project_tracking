@model ProjectTracking.Models.ProjectSupportOrder
@using Microsoft.AspNetCore.Http
@using System.Globalization
@using System.Linq

@{
    ViewData["Title"] = "Support Details";

    var th = new CultureInfo("th-TH");
    var beforeImages = Model.Images?.ToList() ?? new List<ProjectTracking.Models.ProjectSupportImage>();
    var afterImages = Model.FixImages?
        .Where(x => string.Equals(x.ImageType, "AFTER", StringComparison.OrdinalIgnoreCase))
        .ToList() ?? new List<ProjectTracking.Models.ProjectSupportFixImage>();
    var gitHistories = ViewBag.GitHistories as IEnumerable<ProjectTracking.Models.ProjectSupportOrderGitHistory>
        ?? new List<ProjectTracking.Models.ProjectSupportOrderGitHistory>();

    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string DateText(DateTime? value) => value?.ToString("dd/MM/yyyy", th) ?? "-";

    string StatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "muted",
        "FAIL" => "danger",
        "PASS" => "success",
        "REJECT" => "muted",
        _ => "muted"
    };

    string DevStatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "WIP" => "warning",
        "FIXED" => "success",
        _ => "muted"
    };

    string PriorityClass(string? priority) => (priority ?? "").Trim().ToUpperInvariant() switch
    {
        "URGENT" => "danger",
        "HIGH" => "danger",
        "MEDIUM" => "warning",
        "LOW" => "success",
        _ => "muted"
    };
}

<style>
    .support-detail-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
    }

    .support-detail-hero {
        color: #fff;
        background: linear-gradient(135deg, #10233f, #1f3b63);
        border-radius: 20px;
        padding: 24px;
        margin-bottom: 18px;
        box-shadow: 0 18px 40px rgba(15, 35, 64, .22);
    }

    .support-detail-hero-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .support-detail-main {
        min-width: 0;
        flex: 1 1 auto;
    }

    .support-eyebrow {
        color: rgba(216, 230, 247, .86);
        font-size: 12px;
        font-weight: 900 !important;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .support-detail-title {
        margin: 0;
        color: #fff;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 900 !important;
        line-height: 1.22;
        overflow-wrap: anywhere;
    }

    .support-detail-subtitle {
        max-width: 920px;
        margin: 8px 0 0;
        color: #d8e6f7;
        font-weight: 700;
        line-height: 1.5;
    }

    .support-detail-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        width: 100%;
        margin-top: 14px;
    }

    .support-detail-actions .btn {
        min-width: max-content;
        max-width: 100%;
        min-height: 42px;
        border-radius: 999px !important;
        font-size: .95rem;
        font-weight: 900;
        line-height: 1.25;
        padding: .58rem 1.35rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        white-space: nowrap;
        box-shadow: 0 8px 18px rgba(20, 184, 166, .14);
    }

    .support-detail-hero .btn-primary {
        color: #062b2f !important;
        background: linear-gradient(135deg, #8df1e4, #23c7c8) !important;
        border-color: transparent !important;
    }

    .support-detail-hero .btn-outline-light {
        color: #fff !important;
        background: rgba(255,255,255,.08);
        border-color: rgba(255,255,255,.55) !important;
    }

    .support-detail-hero .btn-outline-light:hover {
        background: rgba(255,255,255,.18) !important;
    }

    .support-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .support-summary-card,
    .support-panel {
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    }

    .support-summary-card {
        min-height: 90px;
        padding: 14px 16px;
    }

    .support-summary-card small {
        display: block;
        margin-bottom: 6px;
        color: #000;
        font-size: 12px;
        font-weight: 900 !important;
        text-transform: uppercase;
    }

    .support-summary-card b {
        color: #000;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.35;
        word-break: break-word;
    }

    .support-content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 16px;
        margin-bottom: 18px;
    }

    .support-bottom-stack {
        display: grid;
        gap: 16px;
        margin-bottom: 18px;
    }

    .support-panel {
        padding: 18px;
    }

    .support-panel h3 {
        margin: 0 0 12px;
        color: #000;
        font-size: 18px;
        font-weight: 900;
    }

    .support-info-block {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 18px;
        padding: 14px;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #f8fafc;
    }

    .support-info-line {
        min-width: 0;
        color: #000;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .support-info-line .support-info-label {
        display: inline-block;
        margin-right: 6px;
        color: #000;
        font-size: inherit;
        font-weight: 700;
        line-height: inherit;
        text-transform: uppercase;
    }

    .support-info-value {
        color: #000;
        font-size: inherit;
        font-weight: 400 !important;
        line-height: inherit;
    }

    .support-text-box {
        min-height: 150px;
        color: #000;
        font-weight: 400;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 14px;
        line-height: 1.65;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .support-gallery-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .support-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 5px 12px;
        border-radius: 999px;
        color: #0f766e;
        background: rgba(20, 184, 166, .14);
        font-size: .84rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .support-gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
    }

    .support-image-card {
        display: block;
        width: 100%;
        border: 1px solid #d8e3ef;
        border-radius: 14px;
        padding: 8px;
        background: #f8fafc;
        overflow: hidden;
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .support-image-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(15, 35, 64, .14);
    }

    .support-image-card img {
        display: block;
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 10px;
    }

    .support-empty {
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        color: #000;
        background: #f8fafc;
        padding: 18px;
        text-align: center;
        font-weight: 400;
    }

    .support-git-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

    .support-git-table th {
        padding: 0 10px;
        color: #475569;
        font-size: .9rem;
        font-weight: 700;
    }

    .support-git-table td {
        padding: 10px;
        color: #000;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        font-weight: 400;
    }

    .support-git-table td:first-child {
        border-left: 1px solid #e2e8f0;
        border-radius: 12px 0 0 12px;
    }

    .support-git-table td:last-child {
        border-right: 1px solid #e2e8f0;
        border-radius: 0 12px 12px 0;
    }

    .support-git-badge {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: 4px 10px;
        border-radius: 999px;
        color: #075985;
        background: #e0f2fe;
        font-size: .86rem;
        font-weight: 700;
    }

    .support-git-id {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        overflow-wrap: anywhere;
    }

    .status-text {
        color: #000;
        font-weight: 400 !important;
        font-size: inherit !important;
        white-space: nowrap;
    }

    .status-text.success,
    .status-text.warning,
    .status-text.info,
    .status-text.danger,
    .status-text.muted { color: #000; }

    .support-detail-page :is(
        .support-summary-card,
        .support-summary-label,
        .support-summary-value,
        .support-info-line,
        .support-info-label,
        .support-info-value,
        .support-text-box,
        .support-count,
        .support-empty
    ) {
        font-size: 1rem !important;
        line-height: 1.45 !important;
        letter-spacing: 0 !important;
    }

    .support-detail-page :is(
        .support-summary-label,
        .support-info-label,
        .support-panel h3,
        .support-gallery-head h3
    ) {
        color: #000 !important;
        font-size: 1rem !important;
        font-weight: 700 !important;
        line-height: 1.45 !important;
        letter-spacing: 0 !important;
        text-transform: none !important;
    }

    .support-summary-label {
        display: block;
        margin-bottom: 6px;
    }

    .support-detail-page :is(
        .support-summary-value,
        .support-info-value,
        .support-text-box,
        .status-text
    ) {
        color: #000 !important;
        font-size: 1rem !important;
        font-weight: 400 !important;
        line-height: 1.45 !important;
        letter-spacing: 0 !important;
    }

    @@media (max-width: 991.98px) {
        .support-detail-hero-top,
        .support-content-grid {
            grid-template-columns: 1fr;
            display: grid;
        }

        .support-detail-actions {
            justify-content: flex-start;
        }

        .support-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .support-info-block {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .support-summary-grid {
            grid-template-columns: 1fr;
        }

        .support-detail-actions .btn {
            min-width: 0;
            width: 100%;
            white-space: normal;
        }
    }
</style>

<div class="support-detail-page">
    <section class="support-detail-hero">
        <div class="support-detail-hero-top">
            <div class="support-detail-main">
                <div class="support-eyebrow">Support Order #@Model.OrderId</div>
                <h1 class="support-detail-title">รายละเอียดงาน Support</h1>
                <p class="support-detail-subtitle">@TextOrDash(Model.OrderTitle)</p>
            </div>

        </div>

        <div class="support-detail-actions">
            <a asp-action="Index"
               asp-route-projectId="@Model.ProjectId"
               class="btn btn-outline-light">
                ไปหน้า Support
            </a>

            @if (CanMenu("SupportOrders.Edit"))
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.OrderId"
                   class="btn btn-primary">
                    ไปหน้าแก้ไข
                </a>
            }
        </div>
    </section>

    <section class="support-summary-grid">
        <div class="support-summary-card">
            <span class="support-summary-label">Priority</span>
            <span class="support-summary-value status-text @PriorityClass(Model.Priority)">@TextOrDash(Model.Priority)</span>
        </div>
        <div class="support-summary-card">
            <span class="support-summary-label">Status</span>
            <span class="support-summary-value status-text @StatusClass(Model.Status)">@TextOrDash(Model.Status)</span>
        </div>
        <div class="support-summary-card">
            <span class="support-summary-label">Dev Status</span>
            <span class="support-summary-value status-text @DevStatusClass(Model.DevStatus)">@TextOrDash(Model.DevStatus)</span>
        </div>
        <div class="support-summary-card">
            <span class="support-summary-label">จำนวน FAIL</span>
            <span class="support-summary-value">@((Model.ReopenCount > 0 ? $"{Model.ReopenCount} ครั้ง" : "0 ครั้ง"))</span>
        </div>
        <div class="support-summary-card">
            <span class="support-summary-label">วันที่เริ่ม</span>
            <span class="support-summary-value">@DateText(Model.StartDate)</span>
        </div>
        <div class="support-summary-card">
            <span class="support-summary-label">วันที่สิ้นสุด</span>
            <span class="support-summary-value">@DateText(Model.EndDate)</span>
        </div>
    </section>

    <section class="support-bottom-stack">
        <article class="support-panel">
            <h3>ข้อมูล Support</h3>
            <div class="support-info-block">
                <div class="support-info-line"><span class="support-info-label">Project:</span><span class="support-info-value">@TextOrDash(Model.Project?.ProjectDisplayName)</span></div>
                <div class="support-info-line"><span class="support-info-label">Title:</span><span class="support-info-value">@TextOrDash(Model.OrderTitle)</span></div>
                <div class="support-info-line">
                    <span class="support-info-label">Assign To:</span><span class="support-info-value">@(Model.Employee != null ? $"{Model.Employee.EmpName} ({Model.Employee.Position})" : "-")</span>
                </div>
                <div class="support-info-line"><span class="support-info-label">Created:</span><span class="support-info-value">@DateText(Model.CreatedAt)</span></div>
            </div>
        </article>

        <article class="support-panel">
            <h3>รายละเอียดงาน</h3>
            <div class="support-text-box">@TextOrDash(Model.OrderDetail)</div>
        </article>

        <article class="support-panel">
            <h3>รายละเอียดการแก้ไข</h3>
            <div class="support-text-box">@TextOrDash(Model.DevDetail)</div>
        </article>

        <article class="support-panel">
            <h3>ประวัติ Git</h3>
            @if (gitHistories.Any())
            {
                <table class="support-git-table">
                    <thead>
                        <tr>
                            <th>ประเภท</th>
                            <th>Git ID</th>
                            <th>วันที่บันทึก</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in gitHistories)
                        {
                            <tr>
                                <td><span class="support-git-badge">@row.GitType</span></td>
                                <td class="support-git-id">@row.GitId</td>
                                <td>@row.EntryDate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="support-empty">ยังไม่มีประวัติ Git</div>
            }
        </article>
    </section>

    <section class="support-content-grid">
        <article class="support-panel">
            <div class="support-gallery-head">
                <h3>รูปจาก BA</h3>
                <span class="support-count">@beforeImages.Count รูป</span>
            </div>

            @if (beforeImages.Count > 0)
            {
                <div class="support-gallery-grid">
                    @foreach (var img in beforeImages)
                    {
                        var src = string.IsNullOrWhiteSpace(img.FilePath) ? "" : Url.Content("~/" + img.FilePath.TrimStart('/'));
                        <button type="button"
                                class="support-image-card"
                                onclick="previewSupportImage('@src')"
                                aria-label="ดูรูปจาก BA">
                            <img src="@src" alt="@TextOrDash(img.FileName)" />
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="support-empty">ไม่มีรูปจาก BA</div>
            }
        </article>

        <article class="support-panel">
            <div class="support-gallery-head">
                <h3>รูปหลังแก้</h3>
                <span class="support-count">@afterImages.Count รูป</span>
            </div>

            @if (afterImages.Count > 0)
            {
                <div class="support-gallery-grid">
                    @foreach (var img in afterImages)
                    {
                        var src = string.IsNullOrWhiteSpace(img.FilePath) ? "" : Url.Content("~/" + img.FilePath.TrimStart('/'));
                        <button type="button"
                                class="support-image-card"
                                onclick="previewSupportImage('@src')"
                                aria-label="ดูรูปหลังแก้">
                            <img src="@src" alt="Support image after fix" />
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="support-empty">ไม่มีรูปหลังแก้</div>
            }
        </article>
    </section>
</div>

<div class="modal fade" id="supportImagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark">
            <div class="modal-body text-center p-2">
                <img id="supportPreviewImage" src="" class="img-fluid rounded" alt="preview" />
            </div>
        </div>
    </div>
</div>

<script>
function prepareSupportImagePreviewModal(modalId) {
    const modalEl = document.getElementById(modalId);
    if (!modalEl) return null;

    if (modalEl.parentElement !== document.body) {
        document.body.appendChild(modalEl);
    }

    document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
    document.body.classList.remove('modal-open');
    document.body.style.removeProperty('overflow');
    document.body.style.removeProperty('padding-right');

    modalEl.style.zIndex = '26010';
    return modalEl;
}

function previewSupportImage(src) {
    const img = document.getElementById("supportPreviewImage");
    img.src = src;

    const modalEl = prepareSupportImagePreviewModal("supportImagePreviewModal");
    if (!modalEl) return;

    const modal = bootstrap.Modal.getOrCreateInstance(modalEl, {
        backdrop: true,
        keyboard: true
    });
    modal.show();

    window.setTimeout(function () {
        modalEl.style.zIndex = '26010';
        document.querySelectorAll('.modal-backdrop').forEach(function (backdrop) {
            backdrop.style.zIndex = '26000';
        });
    }, 0);
}
</script>

@using Microsoft.AspNetCore.Http
@model IEnumerable<ProjectTracking.Models.ProjectSupportOrder>

@{
    ViewData["Title"] = "Support Orders";

    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }

    var selectedProject = ViewBag.SelectedProject as ProjectTracking.Models.Project;
    var projects = ViewBag.Projects as IEnumerable<ProjectTracking.Models.Project> ?? Enumerable.Empty<ProjectTracking.Models.Project>();
    var hasSelectedProject = selectedProject != null;
    var orders = (Model ?? Enumerable.Empty<ProjectTracking.Models.ProjectSupportOrder>()).ToList();
    var empList = ViewBag.EmpList as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var selectedStatus = ViewBag.SelectedStatus as string ?? "";
    var statusList = ViewBag.StatusList as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var th = new System.Globalization.CultureInfo("th-TH");

    string PriorityClass(string? priority) => (priority ?? "").Trim().ToUpperInvariant() switch
    {
        "URGENT" => "bg-danger",
        "HIGH" => "bg-danger",
        "MEDIUM" => "bg-warning text-dark",
        "LOW" => "bg-success",
        _ => "bg-secondary"
    };

    string PriorityTone(string? priority) => (priority ?? "").Trim().ToUpperInvariant() switch
    {
        "URGENT" => "is-danger",
        "HIGH" => "is-danger",
        "MEDIUM" => "is-warning",
        "LOW" => "is-success",
        _ => "is-muted"
    };

    string StatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "bg-secondary",
        "FAIL" => "bg-danger",
        "PASS" => "bg-success",
        "REJECT" => "bg-dark",
        _ => "bg-secondary"
    };

    string DevStatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "WIP" => "bg-warning text-dark",
        "FIXED" => "bg-success",
        _ => "bg-secondary"
    };

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string DateText(DateTime? date) => date.HasValue ? date.Value.ToString("dd MMM yyyy", th) : "-";
    string PeriodText(DateTime? start, DateTime? end) =>
        !start.HasValue && !end.HasValue ? "-" : $"{DateText(start)} - {DateText(end)}";
    string ProfileImage(ProjectTracking.Models.Employee? employee)
    {
        var path = employee?.LoginUser?.ProfileImagePath;
        if (string.IsNullOrWhiteSpace(path)) return "/images/Profile/profile.png";

        path = path.Trim();
        if (path.StartsWith("~/", StringComparison.Ordinal)) path = path[1..];
        if (!path.StartsWith("/", StringComparison.Ordinal)) path = "/" + path.TrimStart('/');
        return path;
    }
}

<style>
    .support-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
    }

    .support-hero {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 16px;
        color: #fff;
        background:
            radial-gradient(circle at 86% 8%, rgba(20, 184, 166, .28), transparent 28%),
            linear-gradient(135deg, #10233f, #1f3b63);
        border-radius: 22px;
        padding: 22px 24px;
        margin-bottom: 16px;
        box-shadow: 0 18px 40px rgba(15, 35, 64, .18);
    }

    .support-title {
        margin: 0;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 900;
        line-height: 1.25;
    }

    .support-subtitle {
        color: #d8e6f7;
        font-weight: 700;
        margin: 6px 0 0;
    }

    .support-filter-card,
    .support-order-card,
    .support-empty-card {
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    }

    .support-filter-card {
        padding: 18px;
        margin-bottom: 16px;
    }

    .support-filter-card .form-label {
        color: #10233f;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .support-filter-card .form-select,
    .support-filter-card .pt-search-select__input {
        min-height: 52px;
        border-radius: 14px;
        font-weight: 800;
    }

    .support-list {
        display: grid;
        gap: 14px;
    }

    .support-order-card {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(300px, .46fr);
        overflow: hidden;
        border-left: 5px solid #94a3b8;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .support-order-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 34px rgba(15, 35, 64, .12);
    }

    .support-order-card.is-danger {
        border-left-color: #ef4444;
    }

    .support-order-card.is-warning {
        border-left-color: #f59e0b;
    }

    .support-order-card.is-success {
        border-left-color: #22c55e;
    }

    .support-main,
    .support-side {
        min-width: 0;
        padding: 18px;
    }

    .support-side {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 14px;
    }

    .support-head {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 10px;
    }

    .support-no {
        flex: 0 0 auto;
        min-width: 46px;
        min-height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #062b2f;
        background: rgba(20, 184, 166, .18);
        border-radius: 999px;
        font-weight: 700;
    }

    .support-order-title {
        display: block;
        color: #0f172a;
        font-size: .98rem;
        font-weight: 700;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .support-title-line {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }

    .support-project-name {
        margin-top: 4px;
        color: #0f172a;
        font-size: .93rem;
        font-weight: 400;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .support-detail {
        color: #0f172a;
        font-size: .93rem;
        font-weight: 400;
        line-height: 1.42;
        margin: 8px 0;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .support-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 16px;
        color: #0f172a;
        font-size: .92rem;
        line-height: 1.35;
        margin-bottom: 6px;
    }

    .support-meta-text {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        min-height: 0;
        padding: 0;
        color: #0f172a;
        background: transparent;
        border: 0;
        border-radius: 0;
        font-size: .92rem;
        font-weight: 400;
    }

    .support-meta-text strong {
        color: #0f172a;
        font-weight: 700;
    }

    .support-card-people {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        align-items: center;
        gap: 10px 18px;
        margin: 10px 0 0;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: #0f172a;
        font-size: .95rem;
        font-weight: 400;
    }

    .support-card-person {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        color: #0f172a;
        font-weight: 400;
        line-height: 1.25;
    }

    .support-card-person img {
        width: 36px;
        height: 36px;
        flex: 0 0 auto;
        border: 1px solid #dbe6f3;
        border-radius: 50%;
        object-fit: cover;
        background: #fff;
    }

    .support-card-person span {
        overflow-wrap: anywhere;
    }

    .support-card-person strong {
        color: #0f172a;
        font-weight: 600;
    }

    .support-status-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin-top: 10px;
    }

    .support-status-row {
        min-width: 0;
        display: inline-flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
    }

    .support-status-row small {
        color: #0f172a;
        font-size: .93rem;
        font-weight: 700;
        text-transform: none;
    }

    .support-status-row small::after {
        content: ":";
    }

    .support-status-row .badge {
        min-height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: normal;
        line-height: 1.15;
        text-align: center;
        padding: .32rem .7rem;
        font-weight: 700;
    }

    .support-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
    }

    .support-actions form {
        margin: 0;
    }

    .support-empty-card {
        color: #64748b;
        padding: 28px;
        text-align: center;
        font-weight: 800;
    }

    @@media (max-width: 991.98px) {
        .support-hero {
            flex-direction: column;
        }

        .support-order-card {
            grid-template-columns: 1fr;
        }

        .support-side {
            border-left: 0;
            border-top: 1px solid #e2e8f0;
        }

        .support-actions {
            justify-content: flex-end;
        }
    }
</style>

<div class="support-page">
    <div class="support-hero index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="support-title index-title">งาน Support</h2>
            <p class="support-subtitle index-subtitle">งานแก้ไขช่วงรับประกัน แยกตามโครงการและผู้รับผิดชอบ</p>
        </div>

        <div class="index-actions">
            @if (CanMenu("SupportOrders.Create"))
            {
                <button class="btn btn-light fw-bold" onclick="createOrder()" title="เพิ่มงาน Support">
                    เพิ่มงาน
                </button>
            }
            else
            {
                <button class="btn btn-light fw-bold" disabled title="ไม่มีสิทธิ์เพิ่มงาน">
                    เพิ่มงาน
                </button>
            }
        </div>
    </div>

    <form method="get" id="supportFilterForm" class="support-filter-card">
        <div class="row g-3 align-items-end">
            <div class="@(hasSelectedProject ? "col-md-4" : "col-md-6")">
                <label class="form-label">โครงการ</label>
                <select id="projectSelect"
                        name="projectId"
                        class="form-select"
                        onchange="supportOrdersProjectChanged(this)">
                    <option value="">-- เลือกโครงการ --</option>
                    @foreach (var p in projects.OrderBy(x => x.Coop?.CoopName ?? "").ThenBy(x => x.ProjectName))
                    {
                        <option value="@p.ProjectId" selected="@(selectedProject?.ProjectId == p.ProjectId)">
                            @p.ProjectDisplayName
                        </option>
                    }
                </select>
            </div>
            @if (hasSelectedProject)
            {
                <div class="col-md-4">
                    <label class="form-label">เจ้าของงาน</label>
                    <select id="supportOwnerSelect" name="empId" class="form-select" onchange="supportOrdersOwnerChanged(this)">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (var emp in empList)
                        {
                            <option value="@emp.Value" selected="@(emp.Selected ? "selected" : null)">@emp.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">สถานะ</label>
                    <select id="supportStatusSelect" name="status" class="form-select" onchange="supportOrdersStatusChanged(this)">
                        <option value="">-- ทุกสถานะ --</option>
                        @foreach (var status in statusList)
                        {
                            <option value="@status.Value" selected="@(string.Equals(status.Value, selectedStatus, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                @status.Text
                            </option>
                        }
                    </select>
                </div>
            }
        </div>
    </form>

    @if (!hasSelectedProject)
    {
        <div class="support-empty-card">
            กรุณาเลือกโครงการก่อนเพื่อแสดงรายการงาน Support
        </div>
    }
    else if (!orders.Any())
    {
        <div class="support-empty-card">
            ไม่พบรายการงาน Support ในโครงการนี้
        </div>
    }
    else
    {
        <div class="support-list">
            @{
                var no = 1;
            }

            @foreach (var item in orders)
            {
                <article class="support-order-card @PriorityTone(item.Priority)">
                    <section class="support-main">
                        <div class="support-head">
                            <div class="min-w-0">
                                <div class="support-title-line">
                                    <span class="support-no">#@no</span>
                                </div>
                                <span class="support-order-title"><span class="pt-list-label">หัวข้องาน:</span> <span class="pt-list-value">@TextOrDash(item.OrderTitle)</span></span>
                                <div class="support-project-name"><span class="pt-list-label">โครงการ:</span> <span class="pt-list-value">@TextOrDash(item.Project?.ProjectDisplayName)</span></div>
                            </div>
                        </div>

                        <div class="support-detail"><span class="pt-list-label">รายละเอียดงาน:</span> <span class="pt-list-value">@TextOrDash(item.OrderDetail)</span></div>

                        <div class="support-meta">
                            <span class="support-meta-text"><span class="pt-list-label">วันที่กำหนด:</span> <span class="pt-list-value">@PeriodText(item.StartDate, item.EndDate)</span></span>
                        </div>

                        <div class="support-card-people">
                            <span class="support-card-person">
                                <img class="pt-owner-avatar"
                                     src="@ProfileImage(item.Employee)"
                                     alt="@(item.Employee?.EmpName ?? "ผู้รับผิดชอบ")"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                <span><span class="pt-list-label">ผู้รับผิดชอบ:</span> <span class="pt-list-value">@TextOrDash(item.Employee?.EmpName)</span></span>
                            </span>
                        </div>

                        <div class="support-status-grid">
                            <div class="support-status-row">
                                <small class="pt-list-label">ความสำคัญ</small>
                                <span class="badge @PriorityClass(item.Priority) pt-list-value">@TextOrDash(item.Priority)</span>
                            </div>
                            <div class="support-status-row">
                                <small class="pt-list-label">สถานะ</small>
                                <span class="badge @StatusClass(item.Status) pt-list-value">@TextOrDash(item.Status)</span>
                            </div>
                            <div class="support-status-row">
                                <small class="pt-list-label">สถานะ Dev</small>
                                <span class="badge @DevStatusClass(item.DevStatus) pt-list-value">@TextOrDash(item.DevStatus)</span>
                            </div>
                            <div class="support-status-row">
                                <small class="pt-list-label">จำนวน FAIL</small>
                                <span class="badge @(item.ReopenCount > 0 ? "bg-warning text-dark" : "bg-success") pt-list-value">@item.ReopenCount ครั้ง</span>
                            </div>
                        </div>
                    </section>

                    <aside class="support-side">
                        <div class="support-actions">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.OrderId" title="ดูรายละเอียด">
                                ดูรายละเอียด
                            </a>

                            @if (CanMenu("SupportOrders.Edit"))
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.OrderId" title="แก้ไขงาน">
                                    แก้ไข
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                    แก้ไข
                                </button>
                            }

                            @if (CanMenu("SupportOrders.Delete"))
                            {
                                <form asp-action="Delete" asp-route-id="@item.OrderId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="ลบงาน"
                                            onclick="return confirm('ยืนยันการลบงานนี้ใช่หรือไม่?');">
                                        ลบ
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                    ลบ
                                </button>
                            }
                        </div>
                    </aside>
                </article>

                no++;
            }
        </div>
    }
</div>

<script>
function createOrder() {
    var projectSelect = document.querySelector('select[name="projectId"]');
    var projectId = projectSelect ? projectSelect.value : "";

    if (!projectId) {
        alert("กรุณาเลือกโครงการก่อนเพิ่มงาน Support");
        return;
    }

    window.location.href = '/SupportOrders/Create?projectId=' + encodeURIComponent(projectId);
}

function supportOrdersGo(projectId, empId, status) {
    var url = new URL('/SupportOrders', window.location.origin);
    if (projectId) url.searchParams.set('projectId', projectId);
    if (empId) url.searchParams.set('empId', empId);
    if (status) url.searchParams.set('status', status);
    window.location.href = url.pathname + url.search;
}

function supportOrdersProjectChanged(select) {
    var statusSelect = document.getElementById('supportStatusSelect');
    supportOrdersGo(select ? select.value : '', '', statusSelect ? statusSelect.value : '');
}

function supportOrdersOwnerChanged(select) {
    var projectSelect = document.getElementById('projectSelect');
    var statusSelect = document.getElementById('supportStatusSelect');
    supportOrdersGo(projectSelect ? projectSelect.value : '', select ? select.value : '', statusSelect ? statusSelect.value : '');
}

function supportOrdersStatusChanged(select) {
    var projectSelect = document.getElementById('projectSelect');
    var ownerSelect = document.getElementById('supportOwnerSelect');
    supportOrdersGo(projectSelect ? projectSelect.value : '', ownerSelect ? ownerSelect.value : '', select ? select.value : '');
}

(function () {
    var projectSelect = document.getElementById('projectSelect');
    if (!projectSelect || projectSelect.dataset.supportOrdersReady === 'true') return;
    projectSelect.dataset.supportOrdersReady = 'true';
    projectSelect.addEventListener('change', function () {
        supportOrdersProjectChanged(projectSelect);
    });
})();
</script>

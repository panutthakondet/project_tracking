@using Microsoft.AspNetCore.Http
@model IEnumerable<ProjectTracking.Models.ProjectSupportOrder>

@{
    ViewData["Title"] = "Support Orders";

    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }

    var selectedProjectId = Context.Request.Query["projectId"].ToString();
    var hasSelectedProject = !string.IsNullOrWhiteSpace(selectedProjectId);
    var orders = (Model ?? Enumerable.Empty<ProjectTracking.Models.ProjectSupportOrder>()).ToList();
    var th = new System.Globalization.CultureInfo("th-TH");

    string PriorityClass(string? priority) => (priority ?? "").Trim().ToUpperInvariant() switch
    {
        "URGENT" => "bg-danger",
        "HIGH" => "bg-danger",
        "MEDIUM" => "bg-warning text-dark",
        "LOW" => "bg-success",
        _ => "bg-secondary"
    };

    string PriorityTone(string? priority) => (priority ?? "").Trim().ToUpperInvariant() switch
    {
        "URGENT" => "is-danger",
        "HIGH" => "is-danger",
        "MEDIUM" => "is-warning",
        "LOW" => "is-success",
        _ => "is-muted"
    };

    string StatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "bg-secondary",
        "WIP" => "bg-warning text-dark",
        "FIXED" => "bg-info text-dark",
        "FAIL" => "bg-danger",
        "PASS" => "bg-success",
        "REJECT" => "bg-dark",
        _ => "bg-secondary"
    };

    string DevStatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "WIP" => "bg-warning text-dark",
        "FIXED" => "bg-success",
        _ => "bg-secondary"
    };

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string DateText(DateTime? date) => date.HasValue ? date.Value.ToString("dd MMM yyyy", th) : "-";
    string PeriodText(DateTime? start, DateTime? end) =>
        !start.HasValue && !end.HasValue ? "-" : $"{DateText(start)} - {DateText(end)}";
    string ProfileImage(ProjectTracking.Models.Employee? employee)
    {
        var path = employee?.LoginUser?.ProfileImagePath;
        if (string.IsNullOrWhiteSpace(path)) return "/images/Profile/profile.png";

        path = path.Trim();
        if (path.StartsWith("~/", StringComparison.Ordinal)) path = path[1..];
        if (!path.StartsWith("/", StringComparison.Ordinal)) path = "/" + path.TrimStart('/');
        return path;
    }
}

<style>
    .support-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
    }

    .support-hero {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 16px;
        color: #fff;
        background:
            radial-gradient(circle at 86% 8%, rgba(20, 184, 166, .28), transparent 28%),
            linear-gradient(135deg, #10233f, #1f3b63);
        border-radius: 22px;
        padding: 22px 24px;
        margin-bottom: 16px;
        box-shadow: 0 18px 40px rgba(15, 35, 64, .18);
    }

    .support-title {
        margin: 0;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 900;
        line-height: 1.25;
    }

    .support-subtitle {
        color: #d8e6f7;
        font-weight: 700;
        margin: 6px 0 0;
    }

    .support-filter-card,
    .support-order-card,
    .support-empty-card {
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    }

    .support-filter-card {
        padding: 18px;
        margin-bottom: 16px;
    }

    .support-filter-card .form-label {
        color: #10233f;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .support-filter-card .form-select,
    .support-filter-card .pt-search-select__input {
        min-height: 52px;
        border-radius: 14px;
        font-weight: 800;
    }

    .support-list {
        display: grid;
        gap: 14px;
    }

    .support-order-card {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(300px, .46fr);
        overflow: hidden;
        border-left: 5px solid #94a3b8;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .support-order-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 34px rgba(15, 35, 64, .12);
    }

    .support-order-card.is-danger {
        border-left-color: #ef4444;
    }

    .support-order-card.is-warning {
        border-left-color: #f59e0b;
    }

    .support-order-card.is-success {
        border-left-color: #22c55e;
    }

    .support-main,
    .support-side {
        min-width: 0;
        padding: 18px;
    }

    .support-side {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 14px;
    }

    .support-head {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 10px;
    }

    .support-no {
        flex: 0 0 auto;
        min-width: 46px;
        min-height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #062b2f;
        background: rgba(20, 184, 166, .18);
        border-radius: 999px;
        font-weight: 900;
    }

    .support-order-title {
        display: block;
        color: #10233f;
        font-size: 18px;
        font-weight: 900;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .support-title-line {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }

    .support-project-name {
        margin-top: 4px;
        color: #64748b;
        font-weight: 800;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .support-owner-line {
        color: #0f172a;
        font-size: .9rem;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .support-detail {
        color: #475569;
        font-weight: 400;
        line-height: 1.42;
        margin: 8px 0;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .support-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 16px;
        color: #0f172a;
        font-size: .92rem;
        line-height: 1.35;
        margin-bottom: 6px;
    }

    .support-meta-text {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        min-height: 0;
        padding: 0;
        color: #0f172a;
        background: transparent;
        border: 0;
        border-radius: 0;
        font-size: .92rem;
        font-weight: 400;
    }

    .support-meta-text strong {
        color: #0f172a;
        font-weight: 900;
    }

    .support-status-grid {
        display: grid;
        gap: 6px;
    }

    .support-status-row {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        align-items: center;
        gap: 8px;
    }

    .support-status-row small {
        color: #0f172a;
        font-size: .93rem;
        font-weight: 900;
        text-transform: none;
    }

    .support-status-row .badge {
        min-height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: normal;
        line-height: 1.15;
        text-align: center;
        padding: .32rem .7rem;
        font-weight: 400;
    }

    .support-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
    }

    .support-actions form {
        margin: 0;
    }

    .support-empty-card {
        color: #64748b;
        padding: 28px;
        text-align: center;
        font-weight: 800;
    }

    @@media (max-width: 991.98px) {
        .support-hero {
            flex-direction: column;
        }

        .support-order-card {
            grid-template-columns: 1fr;
        }

        .support-side {
            border-left: 0;
            border-top: 1px solid #e2e8f0;
        }

        .support-actions {
            justify-content: flex-end;
        }
    }
</style>

<div class="support-page">
    <div class="support-hero index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="support-title index-title">Support Orders</h2>
            <p class="support-subtitle index-subtitle">งานแก้ไขช่วงรับประกัน แยกตามโครงการและผู้รับผิดชอบ</p>
        </div>

        <div class="index-actions">
            @if (CanMenu("SupportOrders.Create"))
            {
                <button class="btn btn-light fw-bold" onclick="createOrder()" title="เพิ่มงาน Support">
                    Add Order
                </button>
            }
            else
            {
                <button class="btn btn-light fw-bold" disabled title="ไม่มีสิทธิ์เพิ่มงาน">
                    Add Order
                </button>
            }
        </div>
    </div>

    <form method="get" class="support-filter-card">
        <div class="row g-3 align-items-end">
            <div class="col-12">
                <label class="form-label">📁 โครงการ</label>
                <select name="projectId" class="form-select" asp-items="ViewBag.ProjectList" onchange="this.form.submit()">
                    <option value="">-- เลือกโครงการ --</option>
                </select>
            </div>
        </div>
    </form>

    @if (!hasSelectedProject)
    {
        <div class="support-empty-card">
            กรุณาเลือก Project ก่อนเพื่อแสดงรายการ Support Orders
        </div>
    }
    else if (!orders.Any())
    {
        <div class="support-empty-card">
            ไม่พบรายการ Support Orders ในโครงการนี้
        </div>
    }
    else
    {
        <div class="support-list">
            @{
                var no = 1;
            }

            @foreach (var item in orders)
            {
                <article class="support-order-card @PriorityTone(item.Priority)">
                    <section class="support-main">
                        <div class="support-head">
                            <img class="pt-owner-avatar"
                                 src="@ProfileImage(item.Employee)"
                                 alt="@(item.Employee?.EmpName ?? "ผู้รับผิดชอบ")"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                            <div class="min-w-0">
                                <div class="support-title-line">
                                    <span class="support-no">#@no</span>
                                    <span class="support-owner-line">ผู้รับผิดชอบ: @TextOrDash(item.Employee?.EmpName)</span>
                                </div>
                                <span class="support-order-title">@TextOrDash(item.OrderTitle)</span>
                                <div class="support-project-name">@TextOrDash(item.Project?.ProjectDisplayName)</div>
                            </div>
                        </div>

                        <div class="support-detail">@TextOrDash(item.OrderDetail)</div>

                        <div class="support-meta">
                            <span class="support-meta-text"><strong>วันที่กำหนด:</strong> @PeriodText(item.StartDate, item.EndDate)</span>
                        </div>

                        <div class="support-status-grid">
                            <div class="support-status-row">
                                <small>Priority</small>
                                <span class="badge @PriorityClass(item.Priority)">@TextOrDash(item.Priority)</span>
                            </div>
                            <div class="support-status-row">
                                <small>Status</small>
                                <span class="badge @StatusClass(item.Status)">@TextOrDash(item.Status)</span>
                            </div>
                            <div class="support-status-row">
                                <small>Dev</small>
                                <span class="badge @DevStatusClass(item.DevStatus)">@TextOrDash(item.DevStatus)</span>
                            </div>
                        </div>
                    </section>

                    <aside class="support-side">
                        <div class="support-actions">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.OrderId" title="ดูรายละเอียด">
                                👁 View
                            </a>

                            @if (CanMenu("SupportOrders.Edit"))
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.OrderId" title="แก้ไขงาน">
                                    ✏️ Edit
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                    ✏️ Edit
                                </button>
                            }

                            @if (CanMenu("SupportOrders.Delete"))
                            {
                                <form asp-action="Delete" asp-route-id="@item.OrderId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="ลบงาน"
                                            onclick="return confirm('Are you sure you want to delete this order?');">
                                        🗑 Delete
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                    🗑 Delete
                                </button>
                            }
                        </div>
                    </aside>
                </article>

                no++;
            }
        </div>
    }
</div>

<script>
function createOrder() {
    var projectSelect = document.querySelector('select[name="projectId"]');
    var projectId = projectSelect ? projectSelect.value : "";

    if (!projectId) {
        alert("Please select a Project before creating a Support Order.");
        return;
    }

    window.location.href = '/SupportOrders/Create?projectId=' + encodeURIComponent(projectId);
}
</script>

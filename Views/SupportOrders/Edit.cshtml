

@model ProjectTracking.Models.ProjectSupportOrder

@{
    ViewData["Title"] = "แก้ไขงานสนับสนุน";

    DateTime? startDate = Model?.StartDate;
    DateTime? endDate = Model?.EndDate;
    var supportOrder = Model ?? new ProjectTracking.Models.ProjectSupportOrder();

    string ThaiDateText(DateTime? value)
    {
        if (!value.HasValue) return "";
        var year = value.Value.Year;
        while (year > 2200) year -= 543;
        return $"{value.Value:dd/MM/}{year + 543}";
    }

    string startDateText = ThaiDateText(startDate);
    string endDateText = ThaiDateText(endDate);
}

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">แก้ไขงานสนับสนุน</h2>
        <p class="index-subtitle">Support Order #@supportOrder.OrderId</p>
    </div>
</div>

<div class="card shadow-sm pt-form-card">
    <div class="card-body">
<form asp-action="Edit" asp-route-id="@supportOrder.OrderId" asp-route-projectId="@supportOrder.ProjectId" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <input asp-for="OrderId" type="hidden" />
    <input asp-for="ProjectId" type="hidden" />
    <input asp-for="DevStatus" type="hidden" />

    <div class="mb-3">
        <label>โครงการ</label>
        <input type="text" class="form-control" value="@(string.IsNullOrEmpty(ViewBag.SelectedProjectName) ? supportOrder.Project?.ProjectDisplayName : ViewBag.SelectedProjectName)" readonly />
    </div>

    <div class="mb-3">
        <label>หัวข้องาน</label>
        <input asp-for="OrderTitle" class="form-control" />
        <span asp-validation-for="OrderTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>รายละเอียดงาน</label>
        <textarea asp-for="OrderDetail" class="form-control"></textarea>
        <span asp-validation-for="OrderDetail" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>ความสำคัญ</label>
        <select asp-for="Priority" class="form-select">
            <option value="LOW">LOW</option>
            <option value="MEDIUM">MEDIUM</option>
            <option value="HIGH">HIGH</option>
            <option value="URGENT">URGENT</option>
        </select>
    </div>

    <div class="mb-3">
        <label>สถานะ</label>
        <select asp-for="Status" asp-items="ViewBag.StatusList" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label>วันที่เริ่ม</label>
            <input asp-for="StartDate"
                   type="text"
                   class="form-control thai-date"
                   value="@startDateText"
                   placeholder="01/01/2569" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label>วันที่สิ้นสุด</label>
            <input asp-for="EndDate"
                   type="text"
                   class="form-control thai-date"
                   value="@endDateText"
                   placeholder="01/01/2569" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label>ผู้รับผิดชอบ</label>
        <select asp-for="AssignTo" asp-items="ViewBag.EmployeeList" class="form-select">
            <option value="">-- เลือกผู้รับผิดชอบ --</option>
        </select>
    </div>

    <div class="mb-3">
        <label>รูปประกอบปัจจุบัน</label>
        <div>
            @if (supportOrder.Images != null && supportOrder.Images.Any())
            {
                foreach (var img in supportOrder.Images)
                {
                    <div class="d-inline-block text-center me-2 mb-2">
                        <img src="@Url.Content("~" + img.FilePath)" style="width:150px" class="border mb-1" />
                        <div>
                            <input type="checkbox" name="deleteImageIds" value="@img.ImageId" />
                            <small class="text-danger">ลบ</small>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">ยังไม่มีรูปประกอบ</p>
            }
        </div>
    </div>

    <div class="mb-3">
        <label>เพิ่มรูปประกอบ</label>
        <input type="file" name="files" multiple class="form-control" />
        <small class="text-muted">เลือกได้หลายรูป ติ๊กที่รูปเดิมเพื่อลบรูปนั้นออก</small>
    </div>

    <div class="pt-form-actions">
        <button type="submit" class="btn btn-primary">บันทึก</button>
        <a asp-action="Index" asp-route-projectId="@supportOrder.ProjectId" class="btn btn-outline-secondary">ยกเลิก</a>
    </div>

</form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function convertThaiDateToIso(value) {
            if (!value || !value.trim()) return '';

            const parts = value.trim().split('/');
            if (parts.length !== 3) return value;

            let [d, m, y] = parts;
            d = d.padStart(2, '0');
            m = m.padStart(2, '0');
            y = parseInt(y, 10);

            while (y > 2200) {
                y -= 543;
            }

            return `${y}-${m}-${d}`;
        }

        function formatThaiDateInput(input) {
            if (!input) return;

            input.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');

                if (value.length > 8) {
                    value = value.substring(0, 8);
                }

                if (value.length >= 5) {
                    value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
                } else if (value.length >= 3) {
                    value = `${value.substring(0, 2)}/${value.substring(2)}`;
                }

                e.target.value = value;
            });
        }

        formatThaiDateInput(document.getElementById('StartDate'));
        formatThaiDateInput(document.getElementById('EndDate'));

        document.querySelector('form').addEventListener('submit', function () {
            document.querySelectorAll('.thai-date').forEach(input => {
                input.value = convertThaiDateToIso(input.value);
            });
        }, true);
    </script>
}

@model ProjectTracking.Models.Meeting

@{
    ViewData["Title"] = "แก้ไขนัดประชุม";
}

@{
    var employees = ViewBag.Employees as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var departments = ViewBag.Departments as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var selectedUsers = ViewBag.SelectedUsers as IEnumerable<int> ?? Enumerable.Empty<int>();
    var selectedSet = new HashSet<int>(selectedUsers);
}

<style>
    main.route-controller-meetings.route-action-edit .meeting-create-wrap .meeting-card,
    main.route-controller-meetings.route-action-edit .meeting-card__body,
    main.route-controller-meetings.route-action-edit .meeting-card__body form,
    main.route-controller-meetings.route-action-edit .meeting-card__body .row,
    main.route-controller-meetings.route-action-edit .meeting-card__body [class*="col-"] {
        overflow: visible !important;
    }

    main.route-controller-meetings.route-action-edit .meeting-card__body .meeting-attendee-picker {
        position: relative;
        z-index: 20;
    }

    main.route-controller-meetings.route-action-edit .meeting-card__body .meeting-attendee-picker:focus-within {
        z-index: 1100;
    }

    main.route-controller-meetings.route-action-edit .meeting-card__body .meeting-attendee-picker .pt-search-select.is-open,
    main.route-controller-meetings.route-action-edit .meeting-card__body .meeting-attendee-picker .pt-search-select__dropdown {
        z-index: 1101 !important;
    }

    main.route-controller-meetings.route-action-edit .meeting-create-wrap .meeting-card:has(.meeting-attendee-picker .pt-search-select.is-open) {
        padding-bottom: 260px;
    }

    .meeting-attendee-picker__department {
        padding: 12px;
        margin-bottom: 10px;
        border: 1px solid rgba(13, 110, 253, .18);
        border-radius: 12px;
        background: rgba(13, 110, 253, .035);
    }

    .meeting-attendee-picker__department-label {
        display: block;
        margin: 0 0 7px;
        font-size: .9rem;
        font-weight: 700;
        color: #243b5a;
    }

    .meeting-attendee-picker__department-controls {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 8px;
        align-items: center;
    }

    .meeting-attendee-picker__department-feedback {
        min-height: 1.25rem;
        margin: 7px 0 0;
        color: #62748a;
        font-size: .84rem;
    }

    @@media (max-width: 768px) {
        .meeting-attendee-picker__department-controls {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container meeting-create-wrap">
    <div class="meeting-form-hero index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">Meetings</span>
            <h2 class="index-title">@ViewData["Title"]</h2>
            <p class="index-subtitle">ปรับรายละเอียด วันเวลา และผู้เข้าร่วมประชุม</p>
        </div>
        <div class="index-actions">
            <a class="btn btn-outline-light btn-pill" href="/Meetings/Show/@Model.Id">กลับรายละเอียด</a>
            <a class="btn btn-outline-light btn-pill" href="/Meetings/Schedule/@Model.CalendarId">กลับปฏิทิน</a>
        </div>
    </div>

    <div class="meeting-card">
        <div class="meeting-card__header">
            <strong>ข้อมูลการประชุม</strong>
            <span class="chip">Meeting #@Model.Id</span>
        </div>

        <div class="meeting-card__body">
            <form method="post" action="/Meetings/Update" id="meetingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />
                <input type="hidden" name="CalendarId" value="@Model.CalendarId" />

                <h3 class="section-title">รายละเอียด</h3>
                <p class="section-subtitle">แก้ไขข้อมูลหลักของนัดประชุม</p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">หัวข้อการประชุม</label>
                        <input type="text" name="Title" class="form-control" required value="@Model.Title" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">โครงการ</label>
                        <select name="ProjectId" class="form-select">
                            <option value="">-- ไม่ผูกโครงการ --</option>
                            @foreach (var p in ViewBag.Projects)
                            {
                                <option value="@p.ProjectId" selected="@(Model.ProjectId == p.ProjectId)">
                                    @p.ProjectName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label">รายละเอียด</label>
                        <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                    </div>

                    <div class="col-md-6 col-lg-5">
                        <label class="form-label">วันที่</label>

                        <input type="text"
                               id="MeetingDateDisplay"
                               class="form-control meeting-date-control"
                               placeholder="วว/ดด/ปปปป"
                               autocomplete="off"
                               maxlength="10"
                               required />

                        <input type="hidden"
                               name="MeetingDate"
                               id="MeetingDate"
                               value="@Model.MeetingDate.ToString("yyyy-MM-dd")" />

                        <div class="form-hint">รูปแบบ วัน/เดือน/พ.ศ. เช่น 26/05/2569</div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <label class="form-label">เวลา</label>
                        <div class="meeting-time-pair">
                            <div class="meeting-time-field">
                                <span>เริ่ม</span>
                                <input type="time" name="StartTime" class="form-control"
                                       value="@Model.StartTime.ToString(@"hh\:mm")" required />
                            </div>
                            <div class="meeting-time-field">
                                <span>สิ้นสุด</span>
                                <input type="time" name="EndTime" class="form-control"
                                       value="@Model.EndTime.ToString(@"hh\:mm")" required />
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">สถานที่ / ลิงก์ประชุม</label>
                        <input type="text" name="Location" class="form-control" value="@Model.Location" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">ประชุมกับใคร</label>
                        <select name="MeetingAudience" class="form-select">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.MeetingAudience))">— เลือกประเภทการประชุม —</option>
                            <option value="ลูกค้า" selected="@(Model.MeetingAudience == "ลูกค้า")">ลูกค้า</option>
                            <option value="ทีมงาน" selected="@(Model.MeetingAudience == "ทีมงาน")">ทีมงาน</option>
                            <option value="ผู้บริหาร" selected="@(Model.MeetingAudience == "ผู้บริหาร")">ผู้บริหาร</option>
                            <option value="ผู้จัดการ" selected="@(Model.MeetingAudience == "ผู้จัดการ")">ผู้จัดการ</option>
                            <option value="Vendor" selected="@(Model.MeetingAudience == "Vendor")">Vendor / Partner</option>
                            <option value="อื่นๆ" selected="@(Model.MeetingAudience == "อื่นๆ")">อื่นๆ</option>
                        </select>
                        <div class="form-hint">เลือกประเภทของการประชุม</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">สถานะ</label>
                        <select name="Status" class="form-select">
                            <option value="ACTIVE" selected="@(!string.Equals(Model.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase))">ปกติ</option>
                            <option value="CANCELLED" selected="@(string.Equals(Model.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase))">ยกเลิก</option>
                        </select>
                        <div class="form-hint">เมื่อเปลี่ยนเป็นยกเลิก ระบบจะแจ้งผู้เข้าร่วมทางอีเมล, LINE และ Telegram</div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">ผู้เข้าร่วมประชุม</label>
                        <div class="meeting-attendee-picker" data-attendee-picker>
                            <div class="meeting-attendee-picker__department">
                                <label class="meeting-attendee-picker__department-label" for="attendeeDepartmentSelect">เพิ่มผู้เข้าร่วมตามฝ่าย</label>
                                <div class="meeting-attendee-picker__department-controls">
                                    <select id="attendeeDepartmentSelect" class="form-select" data-attendee-department>
                                        <option value="">-- เลือกฝ่าย --</option>
                                        @foreach (var department in departments)
                                        {
                                            <option value="@department.DepartmentId">@department.DepartmentName</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-outline-primary btn-pill" data-attendee-department-add disabled>
                                        + เพิ่มทั้งฝ่าย
                                    </button>
                                </div>
                                <p class="meeting-attendee-picker__department-feedback" data-attendee-department-feedback aria-live="polite">
                                    เลือกฝ่ายเพื่อเพิ่มพนักงานที่ใช้งานอยู่ทั้งหมด
                                </p>
                            </div>
                            <div class="meeting-attendee-picker__controls">
                                <select class="form-select" data-attendee-select>
                                    <option value="">-- เลือกผู้เข้าร่วม --</option>
                                    @foreach (var e in employees)
                                    {
                                        var isSelected = selectedSet.Contains((int)e.EmpId);
                                        var label = $"{e.EmpName} {(e.Position != null ? $"({e.Position})" : "")}".Trim();
                                        <option value="@e.EmpId"
                                                data-label="@label"
                                                data-department-id="@e.DepartmentId"
                                                data-selected="@(isSelected ? "true" : "false")">
                                            @label
                                        </option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-primary btn-pill" data-attendee-add>
                                    เพิ่ม
                                </button>
                            </div>
                            <div class="meeting-selected-attendees" data-attendee-list></div>
                            <div data-attendee-inputs></div>
                        </div>
                        <div class="form-hint">เลือกเพิ่มทีละคน หรือเลือกฝ่ายเพื่อเพิ่มพนักงานทั้งฝ่าย แล้วสามารถลบรายชื่อออกเพื่อเลือกใหม่ได้</div>
                    </div>
                </div>

                <div class="divider"></div>

                <div class="d-flex justify-content-end gap-2 flex-wrap">
                    <a href="/Meetings/Show/@Model.Id" class="btn btn-outline-secondary btn-pill">ยกเลิก</a>
                    <button type="submit" class="btn btn-primary btn-pill">บันทึกการแก้ไข</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {

    const form = document.getElementById('meetingForm');
    const displayDate = document.getElementById('MeetingDateDisplay');
    const hiddenDate = document.getElementById('MeetingDate');

    initMeetingAttendeePicker(form);

    function initMeetingAttendeePicker(formElement) {
        const picker = formElement?.querySelector('[data-attendee-picker]');
        if (!picker) return;

        const select = picker.querySelector('[data-attendee-select]');
        const addButton = picker.querySelector('[data-attendee-add]');
        const departmentSelect = picker.querySelector('[data-attendee-department]');
        const departmentAddButton = picker.querySelector('[data-attendee-department-add]');
        const departmentFeedback = picker.querySelector('[data-attendee-department-feedback]');
        const list = picker.querySelector('[data-attendee-list]');
        const inputs = picker.querySelector('[data-attendee-inputs]');
        const selected = new Map();

        function findOption(value) {
            return Array.from(select.options).find(option => option.value === value);
        }

        function syncInputs() {
            inputs.innerHTML = '';
            selected.forEach((label, id) => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'users';
                input.value = id;
                inputs.appendChild(input);
            });
        }

        function render() {
            list.innerHTML = '';

            if (selected.size === 0) {
                const empty = document.createElement('div');
                empty.className = 'meeting-attendee-empty';
                empty.textContent = 'ยังไม่ได้เลือกผู้เข้าร่วม';
                list.appendChild(empty);
                syncInputs();
                return;
            }

            selected.forEach((label, id) => {
                const chip = document.createElement('span');
                chip.className = 'meeting-selected-attendee';

                const text = document.createElement('span');
                text.textContent = label;

                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'meeting-attendee-remove';
                remove.setAttribute('aria-label', `ลบ ${label}`);
                remove.dataset.removeAttendee = id;
                remove.textContent = '×';

                chip.appendChild(text);
                chip.appendChild(remove);
                list.appendChild(chip);
            });

            syncInputs();
        }

        function addAttendee(value) {
            if (!value || selected.has(value)) return;

            const option = findOption(value);
            if (!option) return;

            const label = option.dataset.label || option.textContent.trim();
            selected.set(value, label);
            option.disabled = true;
            select.value = '';
            render();
        }

        function getDepartmentOptions() {
            const departmentId = departmentSelect?.value || '';
            if (!departmentId) return [];

            return Array.from(select.options)
                .filter(option => option.value && option.dataset.departmentId === departmentId);
        }

        function refreshDepartmentAction(message) {
            if (!departmentSelect || !departmentAddButton || !departmentFeedback) return;

            const departmentId = departmentSelect.value;
            if (!departmentId) {
                departmentAddButton.disabled = true;
                departmentFeedback.textContent = 'เลือกฝ่ายเพื่อเพิ่มพนักงานที่ใช้งานอยู่ทั้งหมด';
                return;
            }

            const departmentName = departmentSelect.options[departmentSelect.selectedIndex]?.textContent?.trim() || 'ฝ่ายที่เลือก';
            const departmentEmployees = getDepartmentOptions();
            const availableCount = departmentEmployees.filter(option => !option.disabled).length;

            departmentAddButton.disabled = availableCount === 0;
            departmentFeedback.textContent = message || (departmentEmployees.length === 0
                ? `${departmentName} ยังไม่มีพนักงานที่ใช้งานอยู่`
                : availableCount === 0
                    ? `เพิ่มพนักงานจากฝ่าย ${departmentName} ครบแล้ว`
                    : `พบพนักงาน ${departmentEmployees.length} คน · เพิ่มได้อีก ${availableCount} คน`);
        }

        function addDepartmentAttendees() {
            const departmentEmployees = getDepartmentOptions();
            if (departmentEmployees.length === 0) {
                refreshDepartmentAction();
                return;
            }

            let addedCount = 0;
            departmentEmployees.forEach(option => {
                if (!option.disabled) {
                    addAttendee(option.value);
                    addedCount++;
                }
            });

            const departmentName = departmentSelect?.options[departmentSelect.selectedIndex]?.textContent?.trim() || 'ฝ่ายที่เลือก';
            refreshDepartmentAction(addedCount > 0
                ? `เพิ่มพนักงานจากฝ่าย ${departmentName} แล้ว ${addedCount} คน`
                : `เพิ่มพนักงานจากฝ่าย ${departmentName} ครบแล้ว`);
        }

        addButton?.addEventListener('click', function () {
            addAttendee(select.value);
            refreshDepartmentAction();
        });

        departmentSelect?.addEventListener('change', function () {
            refreshDepartmentAction();
        });

        departmentAddButton?.addEventListener('click', addDepartmentAttendees);

        select?.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                addAttendee(select.value);
            }
        });

        list?.addEventListener('click', function (event) {
            const button = event.target.closest('[data-remove-attendee]');
            if (!button) return;

            const id = button.dataset.removeAttendee;
            selected.delete(id);

            const option = findOption(id);
            if (option) option.disabled = false;

            render();
            refreshDepartmentAction();
        });

        Array.from(select.options)
            .filter(option => option.dataset.selected === 'true')
            .forEach(option => addAttendee(option.value));

        render();
        refreshDepartmentAction();
    }

    function formatDateInput(value) {
        const digits = value.replace(/\D/g, '').slice(0, 8);

        if (digits.length <= 2) return digits;
        if (digits.length <= 4) {
            return digits.slice(0, 2) + '/' + digits.slice(2);
        }

        return digits.slice(0, 2) + '/' +
               digits.slice(2, 4) + '/' +
               digits.slice(4);
    }

    function syncHiddenDate() {
        if (!displayDate || !hiddenDate) return;

        const raw = displayDate.value.trim();
        const parts = raw.split('/');

        if (parts.length !== 3) {
            hiddenDate.value = '';
            return;
        }

        let [dd, mm, yyyy] = parts;

        if (yyyy.length === 4 && parseInt(yyyy) > 2400) {
            yyyy = (parseInt(yyyy) - 543).toString();
        }

        if (dd && mm && yyyy) {
            hiddenDate.value = `${yyyy}-${mm.padStart(2, '0')}-${dd.padStart(2, '0')}`;
        }
    }

    if (displayDate && hiddenDate?.value) {
        const d = new Date(hiddenDate.value);

        if (!isNaN(d)) {
            const dd = String(d.getDate()).padStart(2, '0');
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const yyyy = d.getFullYear() + 543;

            displayDate.value = `${dd}/${mm}/${yyyy}`;
        }
    }

    displayDate?.addEventListener('input', function () {
        this.value = formatDateInput(this.value);
        syncHiddenDate();
    });

    form?.addEventListener('submit', function (e) {
        syncHiddenDate();

        if (!hiddenDate?.value) {
            e.preventDefault();
            displayDate?.focus();
        }
    });
})();
</script>

@model ProjectTracking.Models.Meeting

@using ProjectTracking.Models
@using Microsoft.AspNetCore.Http
@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

@{
    ViewData["Title"] = "รายละเอียดการประชุม";
    var attendees = ViewBag.Attendees as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var attendeeList = attendees.ToList();
    var projectName = ViewBag.ProjectName as string;
}

@if (!CanMenu("Meetings.Show"))
{
    <div class="container mt-4">
        <div class="alert alert-danger" style="font-weight:600;">
            ❌ ไม่มีสิทธิ์เข้าหน้านี้
        </div>
        <a class="btn btn-secondary" asp-controller="Meetings" asp-action="Index">← กลับ</a>
    </div>
    return;
}

<div class="container meeting-create-wrap">
    <div class="meeting-detail-hero d-flex align-items-start justify-content-between gap-3">
        <div>
            <div class="meeting-detail-subtitle">Meeting #@Model.Id</div>
            <h2 class="meeting-detail-title">@ViewData["Title"]</h2>
            <p class="meeting-detail-subtitle mb-0">ข้อมูลการประชุมที่บันทึกไว้</p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-light btn-pill" asp-controller="Meetings" asp-action="Index" title="กลับไปหน้าปฏิทิน">กลับปฏิทิน</a>
            @if (CanMenu("Meetings.Edit"))
            {
                <a class="btn btn-primary btn-pill" asp-controller="Meetings" asp-action="Edit" asp-route-id="@Model.Id" title="แก้ไขการประชุม">แก้ไข</a>
            }
            else
            {
                <button class="btn btn-outline-light btn-pill" disabled title="ไม่มีสิทธิ์แก้ไขการประชุม">แก้ไข</button>
            }

            @if (CanMenu("Meetings.Delete"))
            {
                <form asp-action="Cancel" asp-controller="Meetings" method="post"
                      onsubmit="return confirm('ยืนยันการยกเลิกการประชุมนี้ ?');" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger btn-pill" title="ยกเลิกการประชุม">ยกเลิก</button>
                </form>
            }
            else
            {
                <button class="btn btn-outline-light btn-pill" disabled title="ไม่มีสิทธิ์ยกเลิกการประชุม">ยกเลิก</button>
            }
        </div>
    </div>

    <div class="meeting-detail-card">
        <div class="meeting-detail-card__header d-flex align-items-center justify-content-between gap-3 flex-wrap">
            <strong>รายละเอียดการประชุม</strong>
            <span class="badge bg-info">@Model.MeetingDate.ToString("dd/MM/yyyy")</span>
        </div>

        <div class="meeting-detail-card__body">
            <div class="meeting-detail-grid">
                <div class="meeting-detail-item full meeting-detail-title-card">
                    <div class="meeting-detail-label">หัวข้อประชุม</div>
                    <div class="meeting-detail-value">@Model.Title</div>
                </div>

                <div class="meeting-detail-item meeting-detail-meta-card meeting-project-detail-card">
                    <div class="meeting-detail-label">โครงการ</div>
                    <div class="meeting-detail-value">
                        @if (Model.ProjectId == null)
                        {
                            <span>ไม่ระบุโครงการ</span>
                        }
                        else
                        {
                            <span class="meeting-project-id">#@Model.ProjectId</span>
                            <span class="meeting-project-name">@projectName</span>
                        }
                    </div>
                </div>

                <div class="meeting-detail-item meeting-detail-meta-card">
                    <div class="meeting-detail-label">วันที่</div>
                    <div class="meeting-detail-value">@Model.MeetingDate.ToString("dd/MM/yyyy")</div>
                </div>

                <div class="meeting-detail-item meeting-detail-meta-card">
                    <div class="meeting-detail-label">เวลา</div>
                    <div class="meeting-detail-value">@Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</div>
                </div>

                <div class="meeting-detail-item meeting-detail-meta-card">
                    <div class="meeting-detail-label">สถานที่</div>
                    <div class="meeting-detail-value">@(string.IsNullOrWhiteSpace(Model.Location) ? "-" : Model.Location)</div>
                </div>

                <div class="meeting-detail-item meeting-detail-meta-card">
                    <div class="meeting-detail-label">ประชุมกับ</div>
                    <div class="meeting-detail-value">@(string.IsNullOrWhiteSpace(Model.MeetingAudience) ? "-" : Model.MeetingAudience)</div>
                </div>

                <div class="meeting-detail-item full meeting-detail-description-card">
                    <div class="meeting-detail-label">รายละเอียด</div>
                    <div class="meeting-detail-value">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</div>
                </div>
            </div>

            <div class="divider"></div>

            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-3">
                <h3 class="section-title mb-0">ผู้เข้าร่วม (@attendeeList.Count)</h3>
            </div>

            @if (attendeeList.Count == 0)
            {
                <div class="meeting-detail-item">
                    <div class="meeting-detail-value text-muted">ยังไม่มีผู้เข้าร่วม</div>
                </div>
            }
            else
            {
                <div class="meeting-attendee-list">
                    @foreach (var a in attendeeList)
                    {
                        <div class="meeting-attendee-card">
                            <div>
                                <div class="meeting-detail-value">@(a.EmpName ?? $"EmpId: {a.EmpId}")</div>
                                @if (a.Position != null)
                                {
                                    <div class="text-muted fw-semibold">@a.Position</div>
                                }
                            </div>
                            <span class="badge bg-light text-dark">@a.Status</span>
                        </div>
                    }
                </div>
            }

            <div class="divider"></div>

            <div class="text-muted fw-semibold">
                สร้างเมื่อ: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
    </div>
</div>

@model ProjectTracking.Models.Meeting

@using ProjectTracking.Models
@using ProjectTracking.ViewModels
@using Microsoft.AspNetCore.Http
@using System.Globalization
@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }

    string ThaiDate(DateTime value)
        => value.ToString("ddddที่ d MMMM yyyy", new CultureInfo("th-TH"));

    string ThaiDateTime(DateTime value)
        => value.ToString("ddddที่ d MMMM yyyy HH:mm", new CultureInfo("th-TH"));

    string? LinkHref(string? value)
    {
        var trimmed = value?.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
            return null;

        var candidate = trimmed.StartsWith("www.", StringComparison.OrdinalIgnoreCase)
            ? $"https://{trimmed}"
            : trimmed;

        return Uri.TryCreate(candidate, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
                ? candidate
                : null;
    }
}

@{
    ViewData["Title"] = "รายละเอียดการประชุม";
    var attendees = ViewBag.Attendees as IEnumerable<MeetingShowAttendeeViewModel>
        ?? Enumerable.Empty<MeetingShowAttendeeViewModel>();
    var attendeeList = attendees.ToList();
    var coopName = ViewBag.CoopName as string;
    var projectName = ViewBag.ProjectName as string;
}

@if (!CanMenu("Meetings.Show"))
{
    <div class="container mt-4">
        <div class="alert alert-danger" style="font-weight:600;">
            ❌ ไม่มีสิทธิ์เข้าหน้านี้
        </div>
        <a class="btn btn-secondary" asp-controller="Meetings" asp-action="Schedule" asp-route-id="@Model.CalendarId">← กลับ</a>
    </div>
    return;
}

<div class="container meeting-create-wrap">
    <div class="meeting-detail-hero index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="meeting-detail-title index-title">@ViewData["Title"]</h2>
            <p class="meeting-detail-subtitle index-subtitle mb-0">ข้อมูลการประชุมที่บันทึกไว้</p>
        </div>

        <div class="meeting-detail-actions index-actions">
            <a class="btn btn-outline-light btn-pill" asp-controller="Meetings" asp-action="Schedule" asp-route-id="@Model.CalendarId" title="กลับไปหน้าปฏิทิน">กลับปฏิทิน</a>
            @if (CanMenu("Meetings.Edit"))
            {
                <a class="btn btn-primary btn-pill" asp-controller="Meetings" asp-action="Edit" asp-route-id="@Model.Id" title="แก้ไขการประชุม">แก้ไข</a>
            }
            else
            {
                <button class="btn btn-outline-light btn-pill" disabled title="ไม่มีสิทธิ์แก้ไขการประชุม">แก้ไข</button>
            }

            @if (CanMenu("Meetings.Delete"))
            {
                <form asp-action="Cancel" asp-controller="Meetings" method="post"
                      onsubmit="return confirm('ยืนยันการยกเลิกการประชุมนี้ ?');" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger btn-pill" title="ยกเลิกการประชุม">ยกเลิก</button>
                </form>
            }
            else
            {
                <button class="btn btn-outline-light btn-pill" disabled title="ไม่มีสิทธิ์ยกเลิกการประชุม">ยกเลิก</button>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning fw-bold">@TempData["Error"]</div>
    }

    <div class="meeting-detail-card">
        <div class="meeting-detail-card__header d-flex align-items-center justify-content-between gap-3 flex-wrap">
            <strong>รายละเอียดการประชุม</strong>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (string.Equals(Model.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase))
                {
                    <span class="badge bg-danger">ยกเลิก</span>
                }
                else
                {
                    <span class="badge bg-success">ปกติ</span>
                }
                <span class="badge bg-info">@ThaiDate(Model.MeetingDate)</span>
            </div>
        </div>

        <div class="meeting-detail-card__body">
            <div class="meeting-detail-grid">
                <div class="meeting-detail-item full meeting-detail-title-card meeting-detail-summary-block">
                    <div class="row g-3 meeting-detail-summary-grid">
                        <div class="col-md-6">
                            <div class="meeting-detail-label">ชื่อสหกรณ์</div>
                            <div class="meeting-detail-value">@(string.IsNullOrWhiteSpace(coopName) ? "-" : coopName)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="meeting-detail-label">ชื่อโครงการ</div>
                            <div class="meeting-detail-value">@(string.IsNullOrWhiteSpace(projectName) ? "-" : projectName)</div>
                        </div>
                        <div class="col-12">
                            <div class="meeting-detail-label">หัวข้อประชุม</div>
                            <div class="meeting-detail-value">@Model.Title</div>
                        </div>
                        <div class="col-12">
                            <div class="meeting-detail-label">รายละเอียด</div>
                            <div class="meeting-detail-value">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="meeting-detail-label">วันที่</div>
                            <div class="meeting-detail-value">@ThaiDate(Model.MeetingDate)</div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="meeting-detail-label">เวลา</div>
                            <div class="meeting-detail-value">@Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="meeting-detail-label">สถานที่</div>
                            <div class="meeting-detail-value">
                                @{
                                    var locationHref = LinkHref(Model.Location);
                                }
                                @if (string.IsNullOrWhiteSpace(Model.Location))
                                {
                                    <span>-</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(locationHref))
                                {
                                    <a href="@locationHref" target="_blank" rel="noopener noreferrer">@Model.Location</a>
                                }
                                else
                                {
                                    <span>@Model.Location</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="meeting-detail-label">ประชุมกับ</div>
                            <div class="meeting-detail-value">@(string.IsNullOrWhiteSpace(Model.MeetingAudience) ? "-" : Model.MeetingAudience)</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="divider"></div>

            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-3">
                <h3 class="section-title mb-0">ผู้เข้าร่วม (@attendeeList.Count)</h3>
            </div>

            @if (attendeeList.Count == 0)
            {
                <div class="meeting-detail-item">
                    <div class="meeting-detail-value text-muted">ยังไม่มีผู้เข้าร่วม</div>
                </div>
            }
            else
            {
                <div class="meeting-attendee-list">
                    @foreach (var a in attendeeList)
                    {
                        <div class="meeting-attendee-card">
                            <div>
                                <div class="meeting-detail-value">@(a.EmpName ?? $"EmpId: {a.EmpId}")</div>
                                @if (a.Position != null)
                                {
                                    <div class="text-muted fw-semibold">@a.Position</div>
                                }
                                <div class="d-flex align-items-center gap-3 flex-wrap fw-semibold mt-1 small">
                                    <span class="@(a.EmailSent ? "text-success" : "text-muted")">
                                        @(a.EmailSent ? "ส่งอีเมลแล้ว" : "ยังไม่ส่งอีเมล")
                                    </span>
                                    <span class="@(a.LineSent ? "text-primary" : "text-muted")">
                                        @(a.LineSent ? "ส่ง LINE แล้ว" : "ยังไม่ส่ง LINE")
                                    </span>
                                    <span class="@(a.TelegramSent ? "text-info" : "text-muted")">
                                        @(a.TelegramSent ? "ส่ง Telegram แล้ว" : "ยังไม่ส่ง Telegram")
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="divider"></div>

            <div class="text-muted fw-semibold">
                สร้างเมื่อ: @ThaiDateTime(Model.CreatedAt)
            </div>
        </div>
    </div>
</div>

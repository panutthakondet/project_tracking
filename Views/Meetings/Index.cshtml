        min-height: 130px;
    }
    .fc .fc-daygrid-day-number { font-weight: 600; color: rgba(0,0,0,.70); }

    .fc .fc-col-header-cell-cushion {
        font-weight: 700;
        font-size: 1rem;
        text-shadow: 0 1px 1px rgba(0,0,0,.15);
    }

    /* Header background color */
    .fc .fc-col-header-cell {
        background: #10233f !important;
        color: #fff !important;
        border-color: rgba(255,255,255,.12) !important;
    }

    .fc .fc-col-header-cell:nth-child(1),
    .fc .fc-col-header-cell:nth-child(2),
    .fc .fc-col-header-cell:nth-child(3),
    .fc .fc-col-header-cell:nth-child(4),
    .fc .fc-col-header-cell:nth-child(5),
    .fc .fc-col-header-cell:nth-child(6),
    .fc .fc-col-header-cell:nth-child(7) {

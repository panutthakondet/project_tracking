    }

    .meeting-location {
        font-size: .82rem;
        color: #6c757d;
        margin-top: 2px;
    }

    .meeting-col > * {
        width: 100%;
    }

    .meeting-row > .meeting-col:nth-child(1) {
        flex: 0 0 auto;   /* ให้กว้างตามเนื้อหา */
        min-width: 90px;  /* กันเล็กเกินไป */
    }

    .meeting-row > .meeting-col:nth-child(2) {
        flex: 1;
    }

    .meeting-row > .meeting-col:nth-child(3) {
        flex: 1;
    }
    /* ============================
       Responsive Meeting Calendar
    ============================ */
    @@media (min-width: 901px) and (max-width: 1199.98px) {
        .calendar-card__body {
            padding: 12px;
        }

        #calendar {
            min-width: 1080px;
        }

        .fc .fc-daygrid-day-frame {
            padding: 6px;
            min-height: 140px;
        }

        .fc .fc-event {
            padding: 6px 8px !important;
            margin-bottom: 6px !important;
        }

        .meeting-event-content {
            gap: 6px;
        }

        .meeting-event-icon {
            display: none;
        }
    }

    @@media (max-width: 900px) {
        .calendar-scroll {
            overflow-x: visible;
            padding-bottom: 0;
        }

        #calendar {
            min-width: 0;
        }
    }

    @@media (max-width: 768px) {

        .meeting-page {
            padding: 4px 0;
        }

        .meeting-header {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
        }

        .toolbar-right {
            width: 100%;
            justify-content: flex-end;
            flex-wrap: wrap;
        }

        .toolbar-right .btn,
        .toolbar-right .hint-chip {
            width: auto;
            justify-content: center;
        }

        .calendar-card__toolbar {
            flex-direction: column;
            align-items: stretch;
            text-align: left;
            padding: 16px;
            min-height: auto;
        }

        .calendar-heading__meta {
            justify-content: flex-start;
        }

        .calendar-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .calendar-heading__date {
            min-width: 0;
            width: auto;
            white-space: normal;
            text-align: left;
        }

        .calendar-heading__title {
            font-size: 1.08rem;
        }

        .calendar-heading__subtitle {
            font-size: .82rem;
        }

        .fc-toolbar {
            flex-direction: column;
            gap: 8px;
        }

        .fc-toolbar-chunk {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 6px;
        }

        .fc .fc-toolbar-title {
            font-size: 1rem !important;
        }

        .fc .fc-daygrid-day-frame {
            min-height: 90px;
            padding: 4px;
        }

        .fc .fc-event {
            padding: 4px 6px !important;
            font-size: 11px !important;
            margin-bottom: 4px !important;
        }

        .fc .fc-event-title {
            font-size: .7rem;
        }

        /* มือถือใช้ list view อ่านง่ายกว่า */
        #calendar {
            min-height: 580px;
        }

        /* รายการประชุม responsive */
        .meeting-row {
            flex-direction: column;
            gap: 10px;
            padding: 12px;
        }

        .meeting-col {
            padding: 14px;
        }

        .meeting-row > .meeting-col:nth-child(1),
        .meeting-row > .meeting-col:nth-child(2),
        .meeting-row > .meeting-col:nth-child(3) {
            flex: unset;
            min-width: unset;
            width: 100%;
        }

        .meeting-project {
            align-items: flex-start;
        }

        .meeting-project-text {
            font-size: .85rem;
        }

        .meeting-desc {
            font-size: .9rem;
        }
    }
</style>

<div class="container meeting-page">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning fw-bold">@TempData["Error"]</div>
    }

    <form id="antiForgeryForm" method="post">
        @Html.AntiForgeryToken()
    </form>

    <div class="calendar-card">
        <div class="calendar-card__toolbar">
            <div class="calendar-heading">
                <span class="calendar-heading__date" id="calendarThaiDate">วันศุกร์ ที่ 19 มิถุนายน 2569</span>
                <div>
                    <span class="calendar-heading__eyebrow">Meetings Calendar</span>
                    <strong class="calendar-heading__title">ปฏิทินประชุม</strong>
                    <span class="calendar-heading__subtitle">ตารางนัดหมายทีม ลูกค้า และโครงการ</span>
                </div>
            </div>
            <div class="calendar-heading__meta" aria-label="Calendar actions">
                <a class="calendar-heading__action" asp-controller="Home" asp-action="Index" title="กลับ Dashboard">
                    Dashboard
                </a>
                @if (CanMenu("Meetings.Create"))
                {
                    <a class="calendar-heading__action primary" href="/Meetings/Create" title="สร้างนัดประชุม">
                        สร้างนัดประชุม
                    </a>
                }
                else
                {
                    <button type="button" class="calendar-heading__action primary" disabled title="ไม่มีสิทธิ์สร้างนัดประชุม">
                        สร้างนัดประชุม
                    </button>
                }
            </div>
        </div>

    <div class="calendar-card__body">
        <div class="row">
            <!-- Calendar Full Width -->
            <div class="col-12">
                <div class="calendar-scroll">
                    <div id="calendar"></div>
                </div>
            </div>
        </div>

        <!-- Monthly Meeting List (moved below) -->
        <div class="row mt-3">
            <div class="col-12">
                <div class="card w-100 meeting-list-card">
                    <div class="card-header">
                        <strong>รายการประชุม</strong>
                        <span>นัดหมายที่กำลังจะมาถึง</span>
                    </div>
                    <div class="card-body" style="padding:12px;overflow:auto;">
                        <div id="meetingListTable" class="meeting-list"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const calendarEl = document.getElementById('calendar');
    const compactCalendarMedia = window.matchMedia('(max-width: 900px)');
    const isCompactCalendar = () => compactCalendarMedia.matches;
    const calendarThaiDateEl = document.getElementById('calendarThaiDate');
    const thaiWeekdays = ['วันอาทิตย์', 'วันจันทร์', 'วันอังคาร', 'วันพุธ', 'วันพฤหัสบดี', 'วันศุกร์', 'วันเสาร์'];
    const thaiMonths = [
        'มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน',
        'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'
    ];
    const thaiMonthsShort = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
    const formatThaiDateFull = function (value) {
        if (!value) return '';

        const date = value instanceof Date ? value : new Date(value);
        if (Number.isNaN(date.getTime())) return '';

        return `${thaiWeekdays[date.getDay()]} ที่ ${date.getDate()} ${thaiMonths[date.getMonth()]} ${date.getFullYear() + 543}`;
    };

    const formatThaiDateShort = function (value) {
        if (!value) return '';

        const date = value instanceof Date ? value : new Date(value);
        if (Number.isNaN(date.getTime())) return '';

        return `${date.getDate()} ${thaiMonthsShort[date.getMonth()]} ${date.getFullYear() + 543}`;
    };

    const formatThaiTime = function (value) {
        if (!value) return '';

        return value.toLocaleTimeString('th-TH', {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false
        }) + ' น.';
    };

    if (calendarThaiDateEl) {
        const today = new Date();
        calendarThaiDateEl.textContent = formatThaiDateFull(today);
    }

    let eventCounter = 0;

    function getMeetingAudienceClass(props) {
        const audience = (
            props?.meetingAudience ||
            props?.audience ||
            props?.meetingWith ||
            props?.meeting_with ||
            props?.meetingAudienceText ||
            ''
        ).trim().toLowerCase();

        switch(audience) {
            case 'ลูกค้า':
            case 'customer':
                return 'customer-event';

            case 'ทีมงาน':
            case 'team':
            case 'internal':
                return 'team-event';

            case 'ผู้บริหาร':
            case 'executive':
                return 'executive-event';

            case 'ผู้จัดการ':
            case 'manager':
                return 'manager-event';

            case 'vendor':
            case 'vendor / partner':
            case 'partner':
                return 'vendor-event';

            case 'อื่นๆ':
            case 'other':
                return 'other-event';

            default:
                return 'other-event';
        }
    }

    const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: isCompactCalendar()
            ? 'listMonth'
            : 'dayGridMonth',
        locale: 'th',
        dayHeaderContent: function(arg) {
            const weekday = thaiWeekdays[arg.date.getDay()];
            if (arg.view.type === 'dayGridMonth') {
                return { html: `<span class="fc-day-head-weekday">${weekday}</span>` };
            }

            return {
                html: `<span class="fc-day-head-weekday">${weekday}</span><span class="fc-day-head-date">${arg.date.getDate()} ${thaiMonthsShort[arg.date.getMonth()]}</span>`
            };
        },
        height: 'auto',
        firstDay: 0, // Sunday
        allDaySlot: false,
        nowIndicator: true,
        expandRows: true,
        slotDuration: '00:30:00',
        slotLabelInterval: '01:00',
        slotLabelContent: function(arg) {
            return { html: `<span>${formatThaiTime(arg.date)}</span>` };
        },
        eventTimeFormat: {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false
        },
        editable: true,
        eventStartEditable: true,
        eventDurationEditable: true,
        progressiveEventRendering: true,

        headerToolbar: {
            left: 'prev,next',
            center: 'title',
            right: isCompactCalendar()
                ? 'listMonth'
                : 'dayGridMonth,timeGridWeek,timeGridDay'
        },

        titleFormat: { year: 'numeric', month: 'long' },

        buttonText: {
            today: 'วันนี้',
            month: 'เดือน',
            week: 'สัปดาห์',
            day: 'วัน',
            list: 'รายการ'
        },

        // ดึงข้อมูลจาก controller: /Meetings/List
        events: '/Meetings/List',

        dateClick: function (info) {
            // ไปหน้าสร้างนัด โดยส่ง date ไปด้วย
            window.location.href = '/Meetings/Create?date=' + info.dateStr;
        },

        eventClick: function (info) {
            window.location.href = '/Meetings/Show/' + info.event.id;
        },

        eventDrop: function(info) {
            updateEventTime(info.event);
        },

        eventResize: function(info) {
            updateEventTime(info.event);
        },

        eventClassNames: function(arg) {
            return [getMeetingAudienceClass(arg.event.extendedProps || {})];
        },

        displayEventTime: false,

        eventContent: function(arg) {
            eventCounter++;
            const props = arg.event.extendedProps || {};

            let project = arg.event.title || '';
            let meetingTitle = props.title || props.meetingTitle || '';

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text || '';
                return div.innerHTML;
            }

            const shortProject = eventCounter + '. ' + project;
            const shortMeeting = meetingTitle || '';
            const startText = formatThaiTime(arg.event.start);
            const endText = formatThaiTime(arg.event.end);
            const timeText = startText ? `${startText}${endText ? ' - ' + endText : ''}` : '';

            // Add meetingWith extraction
            const meetingWith = (
                props.meetingAudienceText ||
                props.meetingAudience ||
                props.audience ||
                props.meetingWith ||
                props.meeting_with ||
                '-'
            ).trim();

            const container = document.createElement('div');
            container.style.whiteSpace = 'normal';
            container.style.overflow = 'hidden';

            const audience = (
                props.meetingAudience ||
                props.audience ||
                props.meetingWith ||
                props.meeting_with ||
                ''
            ).trim();
            let icon = '📌';
            switch(audience.toLowerCase()) {
                case 'ลูกค้า':
                case 'customer':
                    icon = '👤';
                    break;

                case 'ทีมงาน':
                case 'team':
                case 'internal':
                    icon = '👨‍💻';
                    break;

                case 'ผู้บริหาร':
                case 'executive':
                    icon = '🏢';
                    break;

                case 'ผู้จัดการ':
                case 'manager':
                    icon = '📋';
                    break;

                case 'vendor':
                case 'vendor / partner':
                case 'partner':
                    icon = '🤝';
                    break;

                default:
                    icon = '📄';
                    break;
            }

            container.innerHTML = `
                <div class="meeting-event-content ${arg.view.type.startsWith('timeGrid') ? 'is-timegrid' : ''}">
                    <div class="meeting-event-icon">${icon}</div>
                    <div class="meeting-event-text">
                        <div class="meeting-event-title">${escapeHtml(shortProject)}</div>
                        ${shortMeeting ? `<div class="meeting-event-subtitle">${escapeHtml(shortMeeting)}</div>` : ''}
                        <div class="meeting-event-meta">
                            ${timeText ? `<span>⏰ ${escapeHtml(timeText)}</span>` : ''}
                            <span>👥 ${escapeHtml(meetingWith)}</span>
                        </div>
                    </div>
                </div>
            `;

            return { domNodes: [container] };
        },

        eventDidMount: function(info) {
            const props = info.event.extendedProps || {};
            console.log('Meeting props:', props);
            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text || '';
                return div.innerHTML;
            }

            const safeTitle = escapeHtml(info.event.title);
            const safeProject = props.projectName ? `📁 ${escapeHtml(props.projectName)}<br>` : '';
            const safeLocation = props.location ? `📍 ${escapeHtml(props.location)}<br>` : '';
            const start = formatThaiTime(info.event.start);
            const end = formatThaiTime(info.event.end);
            const time = start && end ? `⏰ ${start} - ${end}` : '';

            const listTimeCell = info.el.querySelector('.fc-list-event-time');
            if (listTimeCell && start) {
                listTimeCell.textContent = end ? `${start} - ${end}` : start;
            }

            const tooltip = document.createElement('div');
            tooltip.className = 'fc-tooltip';
            tooltip.innerHTML = `<strong>${safeTitle}</strong><br>${safeProject}${safeLocation}${time}`;
            document.body.appendChild(tooltip);
            tooltip.style.display = 'none';

            info.el.addEventListener('mouseenter', (e) => {
                tooltip.style.display = 'block';
                tooltip.style.position = 'fixed';
                tooltip.style.left = (e.clientX + 12) + 'px';
                tooltip.style.top = (e.clientY + 12) + 'px';
            });

            info.el.addEventListener('mousemove', (e) => {
                tooltip.style.left = (e.clientX + 12) + 'px';
                tooltip.style.top = (e.clientY + 12) + 'px';
            });

            info.el.addEventListener('mouseleave', () => {
                tooltip.style.display = 'none';
            });
        }
    });

    function getCalendarThaiTitle() {
        const view = calendar.view;
        const current = calendar.getDate();

        if (view.type === 'dayGridMonth' || view.type === 'listMonth') {
            const prefix = view.type === 'listMonth' ? 'รายการประชุม ' : '';
            return `${prefix}${thaiMonths[current.getMonth()]} ${current.getFullYear() + 543}`;
        }

        if (view.type === 'timeGridDay') {
            return formatThaiDateFull(current);
        }

        const start = new Date(view.currentStart || view.activeStart);
        const end = new Date(view.currentEnd || view.activeEnd);
        end.setDate(end.getDate() - 1);

        return `${formatThaiDateShort(start)} - ${formatThaiDateShort(end)}`;
    }

    function syncCalendarThaiTitle() {
        const titleEl = calendarEl.querySelector('.fc-toolbar-title');
        if (titleEl) {
            titleEl.textContent = getCalendarThaiTitle();
        }
    }

    calendar.render();
    syncCalendarThaiTitle();

    function syncCalendarResponsiveMode() {
        if (isCompactCalendar()) {
            calendar.setOption('headerToolbar', {
                left: 'prev,next',
                center: 'title',
                right: 'listMonth'
            });

            if (calendar.view.type !== 'listMonth') {
                calendar.changeView('listMonth');
            }

            return;
        }

        calendar.setOption('headerToolbar', {
            left: 'prev,next',
            center: 'title',
            right: 'dayGridMonth,timeGridWeek,timeGridDay'
        });

        if (calendar.view.type === 'listMonth') {
            calendar.changeView('dayGridMonth');
        }
    }

    if (compactCalendarMedia.addEventListener) {
        compactCalendarMedia.addEventListener('change', syncCalendarResponsiveMode);
    } else if (compactCalendarMedia.addListener) {
        compactCalendarMedia.addListener(syncCalendarResponsiveMode);
    }

    calendar.on('datesSet', function() {
        eventCounter = 0;
        syncCalendarThaiTitle();
    });

    loadMeetingList();

    function loadMeetingList() {
        fetch('/Meetings/List')
            .then(r => r.json())
            .then(data => {
                const container = document.getElementById('meetingListTable');
                container.innerHTML = '';

                const today = new Date();
                today.setHours(0,0,0,0);

                // sort meetings by start date (ascending)
                data.sort((a, b) => new Date(a.start) - new Date(b.start));

                data.forEach(e => {
                    const d = new Date(e.start);
                    if (d >= today) {

                        const date = formatThaiDateFull(d);

                        const project = e.extendedProps && e.extendedProps.projectName
                            ? e.extendedProps.projectName
                            : '-';

                        const start = e.start ? formatThaiTime(new Date(e.start)) : '';
                        const end = e.end ? formatThaiTime(new Date(e.end)) : '';

                        const div = document.createElement('div');
                        const audienceClass = getMeetingAudienceClass(e.extendedProps || {});

                        div.className = `meeting-row ${audienceClass}`;

                        div.innerHTML = `
    <div class="meeting-col">
        <div class="meeting-date-box">
            <div class="meeting-icon" aria-hidden="true">
                <img src="/images/meetings/list-date.svg" alt="" loading="lazy" />
            </div>
            <div>
                <div class="meeting-date">${date}</div>
                <div class="meeting-time">⏰ ${start}${end ? ' - ' + end : ''}</div>
            </div>
        </div>
    </div>

    <div class="meeting-col">
        <div class="meeting-project">
            <div class="meeting-project-icon" aria-hidden="true">
                <img src="/images/meetings/list-project.svg" alt="" loading="lazy" />
            </div>
            <div class="meeting-project-text">${project}</div>
        </div>
    </div>

    <div class="meeting-col">
        <div class="meeting-desc">${e.extendedProps?.description || '-'}</div>
        <div class="meeting-location">📍 ${e.extendedProps?.location || 'Online'}</div>
        <div class="meeting-location" style="margin-top:6px;font-weight:600;color:#374151;">
            👥 ประชุมกับ: ${
                e.extendedProps?.meetingAudienceText ||
                e.extendedProps?.meetingAudience ||
                '-'
            }
        </div>
    </div>
`;

                        div.style.cursor = 'pointer';
                        div.onclick = () => {
                            window.location.href = '/Meetings/Show/' + e.id;
                        };

                        container.appendChild(div);
                    }
                });
            });
    }

    function updateEventTime(event) {
        fetch('/Meetings/Move', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({
                id: event.id,
                start: event.startStr,
                end: event.endStr
            })
        })
        .then(r => r.json())
        .then(res => {
            if (!res.success) {
                alert('ไม่สามารถเปลี่ยนเวลาได้');
                calendar.refetchEvents();
            }
        })
        .catch(() => {
            alert('เกิดข้อผิดพลาด');
            calendar.refetchEvents();
        });
    }

});
</script>

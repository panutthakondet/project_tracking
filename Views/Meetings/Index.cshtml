            justify-content: center;
        }

        .calendar-card__toolbar {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
        }

        .fc-toolbar {
            flex-direction: column;
            gap: 8px;
        }

        .fc-toolbar-chunk {

@{
    ViewData["Title"] = "ปฏิทินนัดประชุม";
}

@using Microsoft.AspNetCore.Http
@{
    bool CanMenu(string key)
    {
        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Contains(key);
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/locales-all.global.min.js"></script>

<style>
    /* Page layout */
    .meeting-page { padding: 8px 0; }
    .meeting-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 12px;
    }

    .meeting-header > div:first-child {
        flex: 1;
    }

    .meeting-title {
        margin: 0;
        line-height: 1.2;
        width: 100%;
    }
    .meeting-subtitle { margin: 6px 0 0 0; color: #6c757d; font-size: 0.95rem; }

    /* Card-like container */
    .calendar-card {
        background: #fff;
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .calendar-card__toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 16px;
        background: linear-gradient(180deg, rgba(13,110,253,.06), rgba(13,110,253,.0));
        border-bottom: 1px solid rgba(0,0,0,.06);
    }

    .toolbar-left { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .toolbar-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

    .hint-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(25,135,84,.10);
        color: #146c43;
        font-size: .9rem;
        border: 1px solid rgba(25,135,84,.18);
        white-space: nowrap;
    }

    .calendar-card__body { padding: 12px 12px 14px 12px; }

    /* FullCalendar polish */
    .fc .fc-toolbar-title {
        font-size: 1.15rem;
        font-weight: 700;
        flex-grow: 1;
        text-align: center;
    }
    .fc .fc-button {
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,.10) !important;
        box-shadow: none !important;
        padding: .35rem .65rem;
    }
    .fc .fc-button-primary {
        background: #0d6efd;
        border-color: rgba(13,110,253,.55) !important;
    }
    .fc .fc-button-primary:disabled { opacity: .55; }

    .fc .fc-daygrid-day-frame {
        padding: 8px;
        min-height: 130px;
    }
    .fc .fc-daygrid-day-number { font-weight: 600; color: rgba(0,0,0,.70); }

    .fc .fc-col-header-cell-cushion {
        font-weight: 700;
        font-size: 1rem;
        text-shadow: 0 1px 1px rgba(0,0,0,.15);
    }

    /* Header background color */
    .fc .fc-col-header-cell {
        background: linear-gradient(180deg, #0d6efd, #0b5ed7);
        color: #fff;
        border-color: rgba(255,255,255,.2) !important;
    }

    /* Thai traditional day colors (Mon–Sun) */
    .fc .fc-col-header-cell:nth-child(1) { background:#dc3545; color:#fff; }  /* Sunday - Red */
    .fc .fc-col-header-cell:nth-child(2) { background:#ffc107; color:#000; }  /* Monday - Yellow */
    .fc .fc-col-header-cell:nth-child(3) { background:#ff69b4; color:#fff; }  /* Tuesday - Pink */
    .fc .fc-col-header-cell:nth-child(4) { background:#28a745; color:#fff; }  /* Wednesday - Green */
    .fc .fc-col-header-cell:nth-child(5) { background:#fd7e14; color:#fff; }  /* Thursday - Orange */
    .fc .fc-col-header-cell:nth-child(6) { background:#0d6efd; color:#fff; }  /* Friday - Blue */
    .fc .fc-col-header-cell:nth-child(7) { background:#6f42c1; color:#fff; }  /* Saturday - Purple */

    /* Light background using FullCalendar weekday classes (force correct color even with fc-day-other) */
    .fc .fc-daygrid-day.fc-day-sun { background: rgba(220,53,69,0.12) !important; }
    .fc .fc-daygrid-day.fc-day-mon { background: rgba(255,193,7,0.12) !important; }
    .fc .fc-daygrid-day.fc-day-tue { background: rgba(255,105,180,0.12) !important; }
    .fc .fc-daygrid-day.fc-day-wed { background: rgba(40,167,69,0.12) !important; }
    .fc .fc-daygrid-day.fc-day-thu { background: rgba(253,126,20,0.12) !important; }
    .fc .fc-daygrid-day.fc-day-fri { background: rgba(13,110,253,0.12) !important; }
    .fc .fc-daygrid-day.fc-day-sat { background: rgba(111,66,193,0.12) !important; }

    /* Make header text readable */
    .fc .fc-col-header-cell:nth-child(1) .fc-col-header-cell-cushion { color: #000000 !important; } /* Sunday */
    .fc .fc-col-header-cell:nth-child(2) .fc-col-header-cell-cushion { color: #000000 !important; } /* Monday */
    .fc .fc-col-header-cell:nth-child(3) .fc-col-header-cell-cushion { color: #000000 !important; } /* Tuesday */
    .fc .fc-col-header-cell:nth-child(4) .fc-col-header-cell-cushion { color: #000000 !important; } /* Wednesday */
    .fc .fc-col-header-cell:nth-child(5) .fc-col-header-cell-cushion { color: #000000 !important; } /* Thursday */
    .fc .fc-col-header-cell:nth-child(6) .fc-col-header-cell-cushion { color: #000000 !important; } /* Friday */
    .fc .fc-col-header-cell:nth-child(7) .fc-col-header-cell-cushion { color: #000000 !important; } /* Saturday */

    /* Day number colors only (do not override header text) */
    .fc-day-sun .fc-daygrid-day-number {
        color: #dc2626 !important; /* Sunday = Red */
    }

    .fc-day-mon .fc-daygrid-day-number {
        color: #d4a017 !important; /* Monday = Yellow */
    }

    .fc-day-tue .fc-daygrid-day-number {
        color: #e91e63 !important; /* Tuesday = Pink */
    }

    .fc-day-wed .fc-daygrid-day-number {
        color: #16a34a !important; /* Wednesday = Green */
    }

    .fc-day-thu .fc-daygrid-day-number {
        color: #f97316 !important; /* Thursday = Orange */
    }

    .fc-day-fri .fc-daygrid-day-number {
        color: #2563eb !important; /* Friday = Blue */
    }

    .fc-day-sat .fc-daygrid-day-number {
        color: #7c3aed !important; /* Saturday = Purple */
    }

    .fc .fc-day-today {
        background: rgba(13,110,253,.08) !important;
    }

    /* Circle highlight around today's date number */
    .fc .fc-day-today .fc-daygrid-day-number {
        background: #0d6efd;
        color: #fff !important;
        border-radius: 50%;
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .fc .fc-event {
        border-radius: 10px !important;
        border: 1px solid rgba(0,0,0,.08) !important;
        padding: 8px 10px !important;
        font-size: 0.80rem;
        line-height: 1.4;
        white-space: normal !important;
        word-break: break-word;
        overflow: hidden;
        margin-bottom: 8px !important;
        box-shadow: none !important;
        transition: all .15s ease;
    }

    .fc .fc-event:hover {
        transform: translateY(-1px);
    }

    .fc .fc-event-title {
        font-weight: 600;
        font-size: 0.78rem;
        white-space: normal !important;
        word-break: break-word;
        color: #1f2937 !important;
        line-height: 1.4;
    }

    .fc-event.customer-event {
        background: #dff2dc !important;
        border-color: #b7dcb0 !important;
    }

    .fc-event.team-event {
        background: #fff0bf !important;
        border-color: #ecd47a !important;
    }

    .fc-event.executive-event {
        background: #fde0e0 !important;
        border-color: #f0b1b1 !important;
    }

    .fc-event.manager-event {
        background: #ead7fb !important;
        border-color: #cfb0f5 !important;
    }

    .fc-event.vendor-event {
        background: #ffe8cf !important;
        border-color: #f3be86 !important;
    }

    .fc-event.other-event {
        background: #dcecff !important;
        border-color: #a9c8f7 !important;
    }

    .fc-tooltip {
        background: #212529;
        color: #fff;
        padding: 8px 10px;
        border-radius: 8px;
        font-size: 0.85rem;
        box-shadow: 0 6px 18px rgba(0,0,0,.2);
        pointer-events: none;
        z-index: 9999;
        max-width: 260px;
        line-height: 1.35;
    }


    .meeting-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .meeting-row {
        display: flex;
        gap: 18px;
        background: #f8f9fb;
        border-radius: 14px;
        padding: 16px;
        border: 1px solid #e5e7eb;
        align-items: stretch;
        height: 100%;
    }

    /* Correct weekday colors */
    .meeting-row.sun { background: #fdecea; } /* Sunday - Red */
    .meeting-row.mon { background: #fff8e1; } /* Monday - Yellow */
    .meeting-row.tue { background: #fce4ec; } /* Tuesday - Pink */
    .meeting-row.wed { background: #e8f5e9; } /* Wednesday - Green */
    .meeting-row.thu { background: #fff3e0; } /* Thursday - Orange */
    .meeting-row.fri { background: #e3f2fd; } /* Friday - Blue */
    .meeting-row.sat { background: #f3e5f5; } /* Saturday - Purple */

    .meeting-col {
        background: #ffffff;
        border-radius: 12px;
        padding: 18px;
        border: 1px solid #e9ecef;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    .meeting-date-box {
        display: flex;
        gap: 10px;
        align-items: flex-start;
    }

    .meeting-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #e7f1ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .meeting-day {
        font-size: .8rem;
        color: #6c757d;
    }

    .meeting-project {
        display: flex;
        gap: 10px;
    }

    .meeting-project-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #d1e7dd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .meeting-project-text {
        font-size: .9rem;
        line-height: 1.5;
        color: #0f5132;
        font-weight: 600;
    }

    .meeting-desc {
        font-weight: 700;
        font-size: .95rem;
        margin-bottom: 8px;
        line-height: 1.3;
    }

    .meeting-location {
        font-size: .82rem;
        color: #6c757d;
        margin-top: 2px;
    }

    .meeting-col > * {
        width: 100%;
    }

    .meeting-row > .meeting-col:nth-child(1) {
        flex: 0 0 auto;   /* ให้กว้างตามเนื้อหา */
        min-width: 90px;  /* กันเล็กเกินไป */
    }

    .meeting-row > .meeting-col:nth-child(2) {
        flex: 1;
    }

    .meeting-row > .meeting-col:nth-child(3) {
        flex: 1;
    }
</style>

<div class="container meeting-page">
    <div class="meeting-header">
        <div>
            <h2 class="meeting-title">@ViewData["Title"]</h2>
            <p class="meeting-subtitle">คลิกวันที่เพื่อสร้างนัดประชุม และคลิกนัดเพื่อดูรายละเอียด</p>
        </div>

        <div class="toolbar-right">
            <span class="hint-chip">คลิกวันที่เพื่อสร้างนัด</span>
            @if (CanMenu("Meetings.Create"))
            {
                <a class="btn btn-primary" href="/Meetings/Create" title="สร้างนัดประชุม">
                    <span style="margin-right:6px;">＋</span> สร้างนัดประชุม
                </a>
            }
            else
            {
                <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์สร้างนัดประชุม">
                    <span style="margin-right:6px;">＋</span> สร้างนัดประชุม
                </button>
            }
        </div>
    </div>

    <form id="antiForgeryForm" method="post">
        @Html.AntiForgeryToken()
    </form>

    <div class="calendar-card">
        <div class="calendar-card__toolbar">
            <div class="toolbar-left">
                <strong style="display:flex;align-items:center;gap:8px;">
                    <span style="font-size:1.1rem;">📅</span>
                    <span>Calendar</span>
                </strong>
                <span class="text-muted" style="font-size:.92rem;">ข้อมูลจากระบบ</span>
            </div>
        </div>

    <div class="calendar-card__body">
        <div class="row">
            <!-- Calendar Full Width -->
            <div class="col-12">
                <div id="calendar"></div>
            </div>
        </div>

        <!-- Monthly Meeting List (moved below) -->
        <div class="row mt-3">
            <div class="col-12">
                <div class="card w-100" style="border-radius:12px;border:1px solid rgba(0,0,0,.08);">
                    <div class="card-header" style="background:#f8f9fa;font-weight:600;">
                        รายการประชุม
                    </div>
                    <div class="card-body" style="padding:10px;overflow:auto;">
                        <div id="meetingListTable" class="meeting-list"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const calendarEl = document.getElementById('calendar');

    let eventCounter = 0;

    const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        locale: 'en',
        dayHeaderFormat: { weekday: 'long' },
        height: 'auto',
        firstDay: 0, // Sunday
        editable: true,
        eventStartEditable: true,
        eventDurationEditable: true,
        progressiveEventRendering: true,

        headerToolbar: {
            left: 'prev,next',
            center: 'title',
            right: 'dayGridMonth,timeGridWeek,timeGridDay'
        },

        titleFormat: { year: 'numeric', month: 'long' },

        buttonText: {
            today: 'วันนี้',
            month: 'เดือน',
            week: 'สัปดาห์',
            day: 'วัน'
        },

        // ดึงข้อมูลจาก controller: /Meetings/List
        events: '/Meetings/List',

        dateClick: function (info) {
            // ไปหน้าสร้างนัด โดยส่ง date ไปด้วย
            window.location.href = '/Meetings/Create?date=' + info.dateStr;
        },

        eventClick: function (info) {
            window.location.href = '/Meetings/Show/' + info.event.id;
        },

        eventDrop: function(info) {
            updateEventTime(info.event);
        },

        eventResize: function(info) {
            updateEventTime(info.event);
        },

        eventClassNames: function(arg) {
            const audience = (
                arg.event.extendedProps?.meetingAudience ||
                arg.event.extendedProps?.audience ||
                arg.event.extendedProps?.meetingWith ||
                arg.event.extendedProps?.meeting_with ||
                ''
            ).trim();

            switch(audience.toLowerCase()) {
                case 'ลูกค้า':
                case 'customer':
                    return ['customer-event'];

                case 'ทีมงาน':
                case 'team':
                case 'internal':
                    return ['team-event'];

                case 'ผู้บริหาร':
                case 'executive':
                    return ['executive-event'];

                case 'ผู้จัดการ':
                case 'manager':
                    return ['manager-event'];

                case 'vendor':
                case 'vendor / partner':
                case 'partner':
                    return ['vendor-event'];

                case 'อื่นๆ':
                case 'other':
                    return ['other-event'];

                default:
                    console.log('Unknown meeting audience:', audience, arg.event.extendedProps);
                    return ['other-event'];
            }
        },

        displayEventTime: false,

        eventContent: function(arg) {
            eventCounter++;
            const props = arg.event.extendedProps || {};

            let project = arg.event.title || '';
            let meetingTitle = props.title || props.meetingTitle || '';

            function truncate(text, max) {
                if (!text) return '';
                return text.length > max ? text.substring(0, max) + '...' : text;
            }

            const shortProject = eventCounter + '. ' + truncate(project, 30);
            const shortMeeting = meetingTitle || '';

            // Add meetingWith extraction
            const meetingWith = (
                props.meetingAudienceText ||
                props.meetingAudience ||
                props.audience ||
                props.meetingWith ||
                props.meeting_with ||
                '-'
            ).trim();

            const container = document.createElement('div');
            container.style.whiteSpace = 'normal';
            container.style.wordBreak = 'break-word';

            const audience = (
                props.meetingAudience ||
                props.audience ||
                props.meetingWith ||
                props.meeting_with ||
                ''
            ).trim();
            let icon = '📌';
            switch(audience.toLowerCase()) {
                case 'ลูกค้า':
                case 'customer':
                    icon = '👤';
                    break;

                case 'ทีมงาน':
                case 'team':
                case 'internal':
                    icon = '👨‍💻';
                    break;

                case 'ผู้บริหาร':
                case 'executive':
                    icon = '🏢';
                    break;

                case 'ผู้จัดการ':
                case 'manager':
                    icon = '📋';
                    break;

                case 'vendor':
                case 'vendor / partner':
                case 'partner':
                    icon = '🤝';
                    break;

                default:
                    icon = '📄';
                    break;
            }

            container.innerHTML = `
                <div style="display:flex;gap:8px;align-items:flex-start;">
                    <div style="font-size:1rem;line-height:1;margin-top:2px;">${icon}</div>
                    <div style="flex:1;overflow:hidden;">
                        <div style="font-weight:700;font-size:.78rem;line-height:1.35;">
                            ${shortProject}
                        </div>
                        ${shortMeeting ? `
                            <div style="font-size:.73rem;line-height:1.3;margin-top:2px;opacity:.85;">
                                ${shortMeeting}
                            </div>
                        ` : ''}

                        <div style="font-size:.72rem;margin-top:4px;font-weight:600;color:#374151;">
                            👥 ${meetingWith}
                        </div>
                    </div>
                </div>
            `;

            return { domNodes: [container] };
        },

        eventDidMount: function(info) {
            const props = info.event.extendedProps || {};
            console.log('Meeting props:', props);
            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text || '';
                return div.innerHTML;
            }

            const safeTitle = escapeHtml(info.event.title);
            const safeProject = props.projectName ? `📁 ${escapeHtml(props.projectName)}<br>` : '';
            const safeLocation = props.location ? `📍 ${escapeHtml(props.location)}<br>` : '';
            const start = info.event.start ? info.event.start.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) : '';
            const end = info.event.end ? info.event.end.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) : '';
            const time = start && end ? `⏰ ${start} - ${end}` : '';

            const tooltip = document.createElement('div');
            tooltip.className = 'fc-tooltip';
            tooltip.innerHTML = `<strong>${safeTitle}</strong><br>${safeProject}${safeLocation}${time}`;
            document.body.appendChild(tooltip);
            tooltip.style.display = 'none';

            info.el.addEventListener('mouseenter', (e) => {
                tooltip.style.display = 'block';
                tooltip.style.position = 'fixed';
                tooltip.style.left = (e.clientX + 12) + 'px';
                tooltip.style.top = (e.clientY + 12) + 'px';
            });

            info.el.addEventListener('mousemove', (e) => {
                tooltip.style.left = (e.clientX + 12) + 'px';
                tooltip.style.top = (e.clientY + 12) + 'px';
            });

            info.el.addEventListener('mouseleave', () => {
                tooltip.style.display = 'none';
            });
        }
    });

    calendar.render();

    calendar.on('datesSet', function() {
        eventCounter = 0;
    });

    loadMeetingList();

    function loadMeetingList() {
        fetch('/Meetings/List')
            .then(r => r.json())
            .then(data => {
                const container = document.getElementById('meetingListTable');
                container.innerHTML = '';

                const today = new Date();
                today.setHours(0,0,0,0);

                // sort meetings by start date (ascending)
                data.sort((a, b) => new Date(a.start) - new Date(b.start));

                data.forEach(e => {
                    const d = new Date(e.start);
                    if (d >= today) {

                        const date = d.toLocaleDateString('th-TH');

                        const project = e.extendedProps && e.extendedProps.projectName
                            ? e.extendedProps.projectName
                            : '-';

                        const start = e.start ? new Date(e.start).toLocaleTimeString('th-TH',{hour:'2-digit',minute:'2-digit'}) : '';
                        const end = e.end ? new Date(e.end).toLocaleTimeString('th-TH',{hour:'2-digit',minute:'2-digit'}) : '';

                        const div = document.createElement('div');
                        const dayIndex = d.getDay(); // 0=Sun
                        const dayClasses = ['sun','mon','tue','wed','thu','fri','sat'];

                        let rowClass = 'meeting-row ' + dayClasses[dayIndex];

                        div.className = rowClass;

                        div.innerHTML = `
    <div class="meeting-col">
        <div class="meeting-date-box">
            <div class="meeting-icon">📅</div>
            <div>
                <div class="meeting-date">${date}</div>
                <div class="meeting-day">${d.toLocaleDateString('th-TH', { weekday: 'long' })}</div>
                <div class="meeting-time">⏰ ${start}${end ? ' - ' + end : ''}</div>
            </div>
        </div>
    </div>

    <div class="meeting-col">
        <div class="meeting-project">
            <div class="meeting-project-icon">💼</div>
            <div class="meeting-project-text">${project}</div>
        </div>
    </div>

    <div class="meeting-col">
        <div class="meeting-desc">${e.extendedProps?.description || '-'}</div>
        <div class="meeting-location">📍 ${e.extendedProps?.location || 'Online'}</div>
        <div class="meeting-location" style="margin-top:6px;font-weight:600;color:#374151;">
            👥 ประชุมกับ: ${
                e.extendedProps?.meetingAudienceText ||
                e.extendedProps?.meetingAudience ||
                '-'
            }
        </div>
    </div>
`;

                        div.style.cursor = 'pointer';
                        div.onclick = () => {
                            window.location.href = '/Meetings/Show/' + e.id;
                        };

                        container.appendChild(div);
                    }
                });
            });
    }

    function updateEventTime(event) {
        fetch('/Meetings/Move', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({
                id: event.id,
                start: event.startStr,
                end: event.endStr
            })
        })
        .then(r => r.json())
        .then(res => {
            if (!res.success) {
                alert('ไม่สามารถเปลี่ยนเวลาได้');
                calendar.refetchEvents();
            }
        })
        .catch(() => {
            alert('เกิดข้อผิดพลาด');
            calendar.refetchEvents();
        });
    }

});
</script>
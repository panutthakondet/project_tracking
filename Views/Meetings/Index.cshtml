        background: rgba(255, 255, 255, .82);
        border-radius: 14px;
        padding: 18px;
        border: 1px solid rgba(216, 227, 239, .92);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    .meeting-date-box {
        display: flex;
        gap: 10px;
        align-items: flex-start;
    }

    .meeting-icon,
    .meeting-project-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        flex: 0 0 40px;

@{
    ViewData["Title"] = "ปฏิทินนัดประชุม";
}

@using Microsoft.AspNetCore.Http
@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/locales-all.global.min.js"></script>

<style>
    :root {
        --meeting-navy: #10233f;
        --meeting-teal: #14b8a6;
        --meeting-teal-dark: #0f766e;
        --meeting-blue: #238cf6;
        --meeting-purple: #8b5cf6;
        --meeting-orange: #f59e0b;
        --meeting-pink: #f43f5e;
        --meeting-border: #d8e3ef;
    }

    /* Page layout */
    .meeting-page { padding: 8px 0; }
    #antiForgeryForm { display: none !important; }
    .meeting-header {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 14px;
        margin-bottom: 12px;
    }

    .meeting-header > div:first-child {
        flex: 1;
    }

    .meeting-title {
        margin: 0;
        line-height: 1.2;
        width: 100%;
    }
    .meeting-subtitle { margin: 6px 0 0 0; color: #6c757d; font-size: 0.95rem; }

    /* Card-like container */
    .calendar-card {
        background: #ffffff;
        border: 1px solid rgba(15, 118, 110, .18);
        border-radius: 22px;
        box-shadow: 0 16px 38px rgba(15, 35, 64, .12);
        overflow: hidden;
    }

    .calendar-card__toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 18px;
        color: #ffffff;
        background: linear-gradient(135deg, #10233f 0%, #123b5c 58%, #0f766e 100%);
        border-bottom: 1px solid rgba(20, 184, 166, .36);
    }

    .toolbar-left { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .toolbar-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

    .calendar-card__toolbar .text-muted {
        color: rgba(255, 255, 255, .72) !important;
        font-weight: 700;
    }

    .hint-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(25,135,84,.10);
        color: #146c43;
        font-size: .9rem;
        border: 1px solid rgba(25,135,84,.18);
        white-space: nowrap;
    }

    .calendar-card__body { padding: 16px; background: #eef5fb; }

    /* FullCalendar polish */
    .fc .fc-toolbar-title {
        color: var(--meeting-navy);
        font-size: 1.15rem;
        font-weight: 900;
        flex-grow: 1;
        text-align: center;
    }
    .fc .fc-button {
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,.10) !important;
        box-shadow: none !important;
        padding: .35rem .65rem;
    }
    .fc .fc-button-primary {
        background: linear-gradient(135deg, var(--meeting-teal), var(--meeting-teal-dark)) !important;
        border-color: transparent !important;
        color: #062b2f !important;
        font-weight: 800;
    }
    .fc .fc-button-primary:not(:disabled):hover,
    .fc .fc-button-primary:not(:disabled):focus {
        color: #ffffff !important;
        filter: brightness(1.03);
    }

    .fc .fc-scrollgrid {
        overflow: hidden;
        border-radius: 16px;
        border-color: var(--meeting-border) !important;
        box-shadow: 0 12px 28px rgba(15, 35, 64, .08);
    }
    .fc .fc-button-primary:disabled { opacity: .55; }

    .fc .fc-daygrid-day-frame {
        padding: 8px;
        min-height: 130px;
    }
    .fc .fc-daygrid-day-number { font-weight: 600; color: rgba(0,0,0,.70); }

    .fc .fc-col-header-cell-cushion {
        font-weight: 700;
        font-size: 1rem;
        text-shadow: 0 1px 1px rgba(0,0,0,.15);
    }

    /* Header background color */
    .fc .fc-col-header-cell {
        background: var(--meeting-navy) !important;
        color: #fff !important;
        border-color: rgba(255,255,255,.12) !important;
    }

    .fc .fc-col-header-cell:nth-child(1),
    .fc .fc-col-header-cell:nth-child(2),
    .fc .fc-col-header-cell:nth-child(3),
    .fc .fc-col-header-cell:nth-child(4),
    .fc .fc-col-header-cell:nth-child(5),
    .fc .fc-col-header-cell:nth-child(6),
    .fc .fc-col-header-cell:nth-child(7) {
        background: var(--meeting-navy) !important;
        color: #fff !important;
    }

    .fc .fc-daygrid-day,
    .fc .fc-daygrid-day.fc-day-sun,
    .fc .fc-daygrid-day.fc-day-mon,
    .fc .fc-daygrid-day.fc-day-tue,
    .fc .fc-daygrid-day.fc-day-wed,
    .fc .fc-daygrid-day.fc-day-thu,
    .fc .fc-daygrid-day.fc-day-fri,
    .fc .fc-daygrid-day.fc-day-sat {
        background: #eef8f7 !important;
    }

    .fc .fc-daygrid-day.fc-day-other {
        background: #f7fbfc !important;
        opacity: .78;
    }

    /* Make header text readable */
    .fc .fc-col-header-cell:nth-child(1) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(2) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(3) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(4) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(5) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(6) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(7) .fc-col-header-cell-cushion {
        color: #ffffff !important;
    }

    /* Day number colors only (do not override header text) */
    .fc-day-sun .fc-daygrid-day-number {
        color: var(--meeting-navy) !important;
    }

    .fc-day-mon .fc-daygrid-day-number {
        color: #10233f !important;
    }

    .fc-day-tue .fc-daygrid-day-number {
        color: #10233f !important;
    }

    .fc-day-wed .fc-daygrid-day-number {
        color: #10233f !important;
    }

    .fc-day-thu .fc-daygrid-day-number {
        color: #10233f !important;
    }

    .fc-day-fri .fc-daygrid-day-number {
        color: #10233f !important;
    }

    .fc-day-sat .fc-daygrid-day-number {
        color: #10233f !important;
    }

    .fc .fc-day-today {
        background: #c8f8ef !important;
        box-shadow: inset 0 0 0 3px var(--meeting-teal-dark);
    }

    .fc .fc-day-today .fc-daygrid-day-frame {
        min-height: 100% !important;
        height: 100% !important;
        background: linear-gradient(180deg, #d9fbf6 0%, #b9f2e8 100%) !important;
        box-shadow: inset 0 0 0 2px rgba(15,118,110,.55);
    }

    .fc .fc-day-today .fc-daygrid-day-top,
    .fc .fc-day-today .fc-daygrid-day-events,
    .fc .fc-day-today .fc-daygrid-day-bg {
        background: transparent !important;
    }

    /* Circle highlight around today's date number */
    .fc .fc-day-today .fc-daygrid-day-number {
        background: linear-gradient(135deg, var(--meeting-teal-dark), #0b4f4a);
        color: #ffffff !important;
        border-radius: 50%;
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        box-shadow: 0 10px 20px rgba(15, 118, 110, .30);
    }

    .fc .fc-list {
        overflow: hidden;
        border: 1px solid var(--meeting-border) !important;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 12px 28px rgba(15, 35, 64, .08);
    }

    .fc .fc-list-day-cushion {
        background: linear-gradient(135deg, var(--meeting-navy), #0f766e) !important;
        color: #ffffff !important;
        font-weight: 900;
    }

    .fc .fc-list-event td {
        border-color: #e5edf7 !important;
        color: var(--meeting-navy);
        font-weight: 800;
    }

    .fc .fc-list-event:hover td {
        background: #ecfeff !important;
    }

    .fc .fc-event {
        background: #f8fafc !important;
        border-radius: 12px !important;
        border: 1px solid var(--meeting-border) !important;
        border-left: 6px solid var(--meeting-teal) !important;
        padding: 8px 10px !important;
        font-size: 0.80rem;
        line-height: 1.4;
        white-space: normal !important;
        word-break: break-word;
        overflow: hidden;
        margin-bottom: 8px !important;
        box-shadow: 0 8px 18px rgba(15, 35, 64, .12) !important;
        transition: all .15s ease;
    }

    .fc .fc-event:hover {
        transform: translateY(-1px);
        box-shadow: 0 14px 24px rgba(15, 35, 64, .18) !important;
    }

    .fc .fc-event-title {
        font-weight: 600;
        font-size: 0.78rem;
        white-space: normal !important;
        word-break: break-word;
        color: var(--meeting-navy) !important;
        line-height: 1.4;
    }

    .meeting-event-content {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        color: var(--meeting-navy);
        white-space: normal;
        overflow: hidden;
    }

    .meeting-event-icon {
        width: 24px;
        height: 24px;
        flex: 0 0 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: rgba(255, 255, 255, .72);
        box-shadow: inset 0 0 0 1px rgba(15, 35, 64, .08);
        font-size: .95rem;
        line-height: 1;
    }

    .meeting-event-text {
        min-width: 0;
        flex: 1;
    }

    .meeting-event-title {
        color: var(--meeting-navy);
        font-size: .78rem;
        line-height: 1.35;
        font-weight: 900;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        text-overflow: ellipsis;
    }

    .meeting-event-subtitle,
    .meeting-event-meta {
        margin-top: 3px;
        color: #465b78;
        font-size: .72rem;
        line-height: 1.3;
        font-weight: 800;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .meeting-event-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 8px;
    }

    .fc-event.customer-event {
        background: linear-gradient(135deg, #ecfeff, #dffbf7) !important;
        border-color: #99f6e4 !important;
        border-left-color: var(--meeting-teal-dark) !important;
    }

    .fc-event.team-event {
        background: linear-gradient(135deg, #eff6ff, #dbeafe) !important;
        border-color: #bfdbfe !important;
        border-left-color: var(--meeting-blue) !important;
    }

    .fc-event.executive-event {
        background: linear-gradient(135deg, #fff7ed, #ffedd5) !important;
        border-color: #fed7aa !important;
        border-left-color: var(--meeting-orange) !important;
    }

    .fc-event.manager-event {
        background: linear-gradient(135deg, #f5f3ff, #ede9fe) !important;
        border-color: #ddd6fe !important;
        border-left-color: var(--meeting-purple) !important;
    }

    .fc-event.vendor-event {
        background: linear-gradient(135deg, #fffbeb, #fef3c7) !important;
        border-color: #fde68a !important;
        border-left-color: #d97706 !important;
    }

    .fc-event.other-event {
        background: linear-gradient(135deg, #f8fafc, #eef2ff) !important;
        border-color: #cbd5e1 !important;
        border-left-color: #64748b !important;
    }

    .fc-tooltip {
        background: #212529;
        color: #fff;
        padding: 8px 10px;
        border-radius: 8px;
        font-size: 0.85rem;
        box-shadow: 0 6px 18px rgba(0,0,0,.2);
        pointer-events: none;
        z-index: 9999;
        max-width: 260px;
        line-height: 1.35;
    }


    .meeting-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .meeting-list-card {
        border: 1px solid rgba(15, 118, 110, .18) !important;
        border-radius: 18px !important;
        overflow: hidden;
        box-shadow: 0 14px 28px rgba(15, 35, 64, .09);
    }

    .meeting-list-card .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 16px;
        color: #ffffff;
        background: linear-gradient(135deg, #10233f, #0f766e) !important;
        border: 0;
        font-weight: 900;
    }

    .meeting-list-card .card-header span {
        color: rgba(255, 255, 255, .72);
        font-size: .86rem;
        font-weight: 700;
    }

    .meeting-list-card .card-body {
        background: #eef5fb;
    }

    .meeting-row {
        display: flex;
        gap: 18px;
        background: #ffffff;
        border-radius: 16px;
        padding: 16px;
        border: 1px solid #d8e3ef;
        border-left: 7px solid var(--meeting-teal);
        align-items: stretch;
        height: 100%;
        box-shadow: 0 10px 22px rgba(15, 35, 64, .08);
        transition: transform .16s ease, box-shadow .16s ease;
    }

    .meeting-row:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 30px rgba(15, 35, 64, .14);
    }

    .meeting-row.sun { border-left-color: var(--meeting-pink); background: linear-gradient(90deg, #fff1f2 0, #ffffff 30%); }
    .meeting-row.mon { border-left-color: var(--meeting-teal-dark); background: linear-gradient(90deg, #ecfeff 0, #ffffff 30%); }
    .meeting-row.tue { border-left-color: #d946ef; background: linear-gradient(90deg, #fdf2f8 0, #ffffff 30%); }
    .meeting-row.wed { border-left-color: #22c55e; background: linear-gradient(90deg, #ecfdf5 0, #ffffff 30%); }
    .meeting-row.thu { border-left-color: var(--meeting-orange); background: linear-gradient(90deg, #fff7ed 0, #ffffff 30%); }
    .meeting-row.fri { border-left-color: var(--meeting-blue); background: linear-gradient(90deg, #eff6ff 0, #ffffff 30%); }
    .meeting-row.sat { border-left-color: var(--meeting-purple); background: linear-gradient(90deg, #f5f3ff 0, #ffffff 30%); }

    .meeting-col {
        background: rgba(255, 255, 255, .82);
        border-radius: 14px;
        padding: 18px;
        border: 1px solid rgba(216, 227, 239, .92);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    .meeting-date-box {
        display: flex;
        gap: 10px;
        align-items: flex-start;
    }

    .meeting-icon {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--meeting-teal), var(--meeting-teal-dark));
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .meeting-day {
        font-size: .8rem;
        color: #6c757d;
    }

    .meeting-project {
        display: flex;
        gap: 10px;
    }

    .meeting-project-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #238cf6, #14b8a6);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .meeting-project-text {
        font-size: .9rem;
        line-height: 1.5;
        color: #10233f;
        font-weight: 600;
    }

    .meeting-desc {
        color: var(--meeting-navy);
        font-weight: 900;
        font-size: .95rem;
        margin-bottom: 8px;
        line-height: 1.3;
    }

    .meeting-location {
        font-size: .82rem;
        color: #6c757d;
        margin-top: 2px;
    }

    .meeting-col > * {
        width: 100%;
    }

    .meeting-row > .meeting-col:nth-child(1) {
        flex: 0 0 auto;   /* ให้กว้างตามเนื้อหา */
        min-width: 90px;  /* กันเล็กเกินไป */
    }

    .meeting-row > .meeting-col:nth-child(2) {
        flex: 1;
    }

    .meeting-row > .meeting-col:nth-child(3) {
        flex: 1;
    }
    /* ============================
       Responsive Meeting Calendar
    ============================ */
    @@media (max-width: 768px) {

        .meeting-page {
            padding: 4px 0;
        }

        .meeting-header {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
        }

        .toolbar-right {
            width: 100%;
            justify-content: flex-end;
            flex-wrap: wrap;
        }

        .toolbar-right .btn,
        .toolbar-right .hint-chip {
            width: auto;
            justify-content: center;
        }

        .calendar-card__toolbar {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
        }

        .fc-toolbar {
            flex-direction: column;
            gap: 8px;
        }

        .fc-toolbar-chunk {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 6px;
        }

        .fc .fc-toolbar-title {
            font-size: 1rem !important;
        }

        .fc .fc-daygrid-day-frame {
            min-height: 90px;
            padding: 4px;
        }

        .fc .fc-event {
            padding: 4px 6px !important;
            font-size: 11px !important;
            margin-bottom: 4px !important;
        }

        .fc .fc-event-title {
            font-size: .7rem;
        }

        /* มือถือใช้ list view อ่านง่ายกว่า */
        #calendar {
            min-height: 580px;
        }

        /* รายการประชุม responsive */
        .meeting-row {
            flex-direction: column;
            gap: 10px;
            padding: 12px;
        }

        .meeting-col {
            padding: 14px;
        }

        .meeting-row > .meeting-col:nth-child(1),
        .meeting-row > .meeting-col:nth-child(2),
        .meeting-row > .meeting-col:nth-child(3) {
            flex: unset;
            min-width: unset;
            width: 100%;
        }

        .meeting-project {
            align-items: flex-start;
        }

        .meeting-project-text {
            font-size: .85rem;
        }

        .meeting-desc {
            font-size: .9rem;
        }
    }
</style>

<div class="container meeting-page">
    <div class="meeting-header index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="meeting-title index-title">@ViewData["Title"]</h2>
            <p class="meeting-subtitle index-subtitle">คลิกนัดเพื่อดูรายละเอียด</p>
        </div>

        <div class="toolbar-right index-actions">
            <a class="btn btn-outline-light btn-pill" asp-controller="Home" asp-action="Index" title="กลับ Dashboard">
                Dashboard
            </a>
            @if (CanMenu("Meetings.Create"))
            {
                <a class="btn btn-primary" href="/Meetings/Create" title="สร้างนัดประชุม">
                    สร้างนัดประชุม
                </a>
            }
            else
            {
                <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์สร้างนัดประชุม">
                    สร้างนัดประชุม
                </button>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning fw-bold">@TempData["Error"]</div>
    }

    <form id="antiForgeryForm" method="post">
        @Html.AntiForgeryToken()
    </form>

    <div class="calendar-card">
        <div class="calendar-card__toolbar">
            <div class="toolbar-left">
                <strong style="display:flex;align-items:center;gap:8px;">
                    <span style="font-size:1.1rem;">📅</span>
                    <span>Calendar</span>
                </strong>
                <span class="text-muted" style="font-size:.92rem;">ข้อมูลจากระบบ</span>
            </div>
        </div>

    <div class="calendar-card__body">
        <div class="row">
            <!-- Calendar Full Width -->
            <div class="col-12">
                <div id="calendar"></div>
            </div>
        </div>

        <!-- Monthly Meeting List (moved below) -->
        <div class="row mt-3">
            <div class="col-12">
                <div class="card w-100 meeting-list-card">
                    <div class="card-header">
                        <strong>รายการประชุม</strong>
                        <span>นัดหมายที่กำลังจะมาถึง</span>
                    </div>
                    <div class="card-body" style="padding:12px;overflow:auto;">
                        <div id="meetingListTable" class="meeting-list"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const calendarEl = document.getElementById('calendar');

    let eventCounter = 0;

    const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: window.matchMedia('(max-width: 768px)').matches
            ? 'listMonth'
            : 'dayGridMonth',
        locale: 'en',
        dayHeaderFormat: { weekday: 'long' },
        height: 'auto',
        firstDay: 0, // Sunday
        editable: true,
        eventStartEditable: true,
        eventDurationEditable: true,
        progressiveEventRendering: true,

        headerToolbar: {
            left: 'prev,next',
            center: 'title',
            right: window.matchMedia('(max-width: 768px)').matches
                ? 'listMonth'
                : 'dayGridMonth,timeGridWeek,timeGridDay'
        },

        titleFormat: { year: 'numeric', month: 'long' },

        buttonText: {
            today: 'วันนี้',
            month: 'เดือน',
            week: 'สัปดาห์',
            day: 'วัน'
        },

        // ดึงข้อมูลจาก controller: /Meetings/List
        events: '/Meetings/List',

        dateClick: function (info) {
            // ไปหน้าสร้างนัด โดยส่ง date ไปด้วย
            window.location.href = '/Meetings/Create?date=' + info.dateStr;
        },

        eventClick: function (info) {
            window.location.href = '/Meetings/Show/' + info.event.id;
        },

        eventDrop: function(info) {
            updateEventTime(info.event);
        },

        eventResize: function(info) {
            updateEventTime(info.event);
        },

        eventClassNames: function(arg) {
            const audience = (
                arg.event.extendedProps?.meetingAudience ||
                arg.event.extendedProps?.audience ||
                arg.event.extendedProps?.meetingWith ||
                arg.event.extendedProps?.meeting_with ||
                ''
            ).trim();

            switch(audience.toLowerCase()) {
                case 'ลูกค้า':
                case 'customer':
                    return ['customer-event'];

                case 'ทีมงาน':
                case 'team':
                case 'internal':
                    return ['team-event'];

                case 'ผู้บริหาร':
                case 'executive':
                    return ['executive-event'];

                case 'ผู้จัดการ':
                case 'manager':
                    return ['manager-event'];

                case 'vendor':
                case 'vendor / partner':
                case 'partner':
                    return ['vendor-event'];

                case 'อื่นๆ':
                case 'other':
                    return ['other-event'];

                default:
                    console.log('Unknown meeting audience:', audience, arg.event.extendedProps);
                    return ['other-event'];
            }
        },

        displayEventTime: false,

        eventContent: function(arg) {
            eventCounter++;
            const props = arg.event.extendedProps || {};

            let project = arg.event.title || '';
            let meetingTitle = props.title || props.meetingTitle || '';

            function truncate(text, max) {
                if (!text) return '';
                return text.length > max ? text.substring(0, max) + '...' : text;
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text || '';
                return div.innerHTML;
            }

            function formatTime(value) {
                return value ? value.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) : '';
            }

            const shortProject = eventCounter + '. ' + truncate(project, 30);
            const shortMeeting = truncate(meetingTitle || '', 28);
            const startText = formatTime(arg.event.start);
            const endText = formatTime(arg.event.end);
            const timeText = startText ? `${startText}${endText ? ' - ' + endText : ''}` : '';

            // Add meetingWith extraction
            const meetingWith = (
                props.meetingAudienceText ||
                props.meetingAudience ||
                props.audience ||
                props.meetingWith ||
                props.meeting_with ||
                '-'
            ).trim();

            const container = document.createElement('div');
            container.style.whiteSpace = 'normal';
            container.style.overflow = 'hidden';

            const audience = (
                props.meetingAudience ||
                props.audience ||
                props.meetingWith ||
                props.meeting_with ||
                ''
            ).trim();
            let icon = '📌';
            switch(audience.toLowerCase()) {
                case 'ลูกค้า':
                case 'customer':
                    icon = '👤';
                    break;

                case 'ทีมงาน':
                case 'team':
                case 'internal':
                    icon = '👨‍💻';
                    break;

                case 'ผู้บริหาร':
                case 'executive':
                    icon = '🏢';
                    break;

                case 'ผู้จัดการ':
                case 'manager':
                    icon = '📋';
                    break;

                case 'vendor':
                case 'vendor / partner':
                case 'partner':
                    icon = '🤝';
                    break;

                default:
                    icon = '📄';
                    break;
            }

            container.innerHTML = `
                <div class="meeting-event-content">
                    <div class="meeting-event-icon">${icon}</div>
                    <div class="meeting-event-text">
                        <div class="meeting-event-title">${escapeHtml(shortProject)}</div>
                        ${shortMeeting ? `<div class="meeting-event-subtitle">${escapeHtml(shortMeeting)}</div>` : ''}
                        <div class="meeting-event-meta">
                            ${timeText ? `<span>⏰ ${escapeHtml(timeText)}</span>` : ''}
                            <span>👥 ${escapeHtml(meetingWith)}</span>
                        </div>
                    </div>
                </div>
            `;

            return { domNodes: [container] };
        },

        eventDidMount: function(info) {
            const props = info.event.extendedProps || {};
            console.log('Meeting props:', props);
            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text || '';
                return div.innerHTML;
            }

            const safeTitle = escapeHtml(info.event.title);
            const safeProject = props.projectName ? `📁 ${escapeHtml(props.projectName)}<br>` : '';
            const safeLocation = props.location ? `📍 ${escapeHtml(props.location)}<br>` : '';
            const start = info.event.start ? info.event.start.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) : '';
            const end = info.event.end ? info.event.end.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) : '';
            const time = start && end ? `⏰ ${start} - ${end}` : '';

            const tooltip = document.createElement('div');
            tooltip.className = 'fc-tooltip';
            tooltip.innerHTML = `<strong>${safeTitle}</strong><br>${safeProject}${safeLocation}${time}`;
            document.body.appendChild(tooltip);
            tooltip.style.display = 'none';

            info.el.addEventListener('mouseenter', (e) => {
                tooltip.style.display = 'block';
                tooltip.style.position = 'fixed';
                tooltip.style.left = (e.clientX + 12) + 'px';
                tooltip.style.top = (e.clientY + 12) + 'px';
            });

            info.el.addEventListener('mousemove', (e) => {
                tooltip.style.left = (e.clientX + 12) + 'px';
                tooltip.style.top = (e.clientY + 12) + 'px';
            });

            info.el.addEventListener('mouseleave', () => {
                tooltip.style.display = 'none';
            });
        }
    });

    calendar.render();

    calendar.on('datesSet', function() {
        eventCounter = 0;
    });

    loadMeetingList();

    function loadMeetingList() {
        fetch('/Meetings/List')
            .then(r => r.json())
            .then(data => {
                const container = document.getElementById('meetingListTable');
                container.innerHTML = '';

                const today = new Date();
                today.setHours(0,0,0,0);

                // sort meetings by start date (ascending)
                data.sort((a, b) => new Date(a.start) - new Date(b.start));

                data.forEach(e => {
                    const d = new Date(e.start);
                    if (d >= today) {

                        const date = d.toLocaleDateString('th-TH');

                        const project = e.extendedProps && e.extendedProps.projectName
                            ? e.extendedProps.projectName
                            : '-';

                        const start = e.start ? new Date(e.start).toLocaleTimeString('th-TH',{hour:'2-digit',minute:'2-digit'}) : '';
                        const end = e.end ? new Date(e.end).toLocaleTimeString('th-TH',{hour:'2-digit',minute:'2-digit'}) : '';

                        const div = document.createElement('div');
                        const dayIndex = d.getDay(); // 0=Sun
                        const dayClasses = ['sun','mon','tue','wed','thu','fri','sat'];

                        let rowClass = 'meeting-row ' + dayClasses[dayIndex];

                        div.className = rowClass;

                        div.innerHTML = `
    <div class="meeting-col">
        <div class="meeting-date-box">
            <div class="meeting-icon">📅</div>
            <div>
                <div class="meeting-date">${date}</div>
                <div class="meeting-day">${d.toLocaleDateString('th-TH', { weekday: 'long' })}</div>
                <div class="meeting-time">⏰ ${start}${end ? ' - ' + end : ''}</div>
            </div>
        </div>
    </div>

    <div class="meeting-col">
        <div class="meeting-project">
            <div class="meeting-project-icon">💼</div>
            <div class="meeting-project-text">${project}</div>
        </div>
    </div>

    <div class="meeting-col">
        <div class="meeting-desc">${e.extendedProps?.description || '-'}</div>
        <div class="meeting-location">📍 ${e.extendedProps?.location || 'Online'}</div>
        <div class="meeting-location" style="margin-top:6px;font-weight:600;color:#374151;">
            👥 ประชุมกับ: ${
                e.extendedProps?.meetingAudienceText ||
                e.extendedProps?.meetingAudience ||
                '-'
            }
        </div>
    </div>
`;

                        div.style.cursor = 'pointer';
                        div.onclick = () => {
                            window.location.href = '/Meetings/Show/' + e.id;
                        };

                        container.appendChild(div);
                    }
                });
            });
    }

    function updateEventTime(event) {
        fetch('/Meetings/Move', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({
                id: event.id,
                start: event.startStr,
                end: event.endStr
            })
        })
        .then(r => r.json())
        .then(res => {
            if (!res.success) {
                alert('ไม่สามารถเปลี่ยนเวลาได้');
                calendar.refetchEvents();
            }
        })
        .catch(() => {
            alert('เกิดข้อผิดพลาด');
            calendar.refetchEvents();
        });
    }

});
</script>

@{
    ViewData["Title"] = "ปฏิทินนัดประชุม";
}

@using Microsoft.AspNetCore.Http
@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/locales-all.global.min.js"></script>

<style>
    :root {
        --meeting-navy: #10233f;
        --meeting-teal: #14b8a6;
        --meeting-teal-dark: #0f766e;
        --meeting-blue: #238cf6;
        --meeting-purple: #8b5cf6;
        --meeting-orange: #f59e0b;
        --meeting-pink: #f43f5e;
        --meeting-border: #d8e3ef;
    }

    /* Page layout */
    .meeting-page { padding: 8px 0; }
    #antiForgeryForm { display: none !important; }
    .meeting-header {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 14px;
        margin-bottom: 12px;
    }

    .meeting-header > div:first-child {
        flex: 1;
    }

    .meeting-title {
        margin: 0;
        line-height: 1.2;
        width: 100%;
    }
    .meeting-subtitle { margin: 6px 0 0 0; color: #6c757d; font-size: 0.95rem; }

    /* Card-like container */
    .calendar-card {
        background: #ffffff;
        border: 1px solid rgba(15, 118, 110, .18);
        border-radius: 22px;
        box-shadow: 0 16px 38px rgba(15, 35, 64, .12);
        overflow: hidden;
    }

    .calendar-card__toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 18px 22px;
        color: #ffffff;
        background:
            linear-gradient(135deg, rgba(16, 35, 63, .96) 0%, rgba(18, 59, 92, .94) 58%, rgba(15, 118, 110, .92) 100%);
        border-bottom: 1px solid rgba(20, 184, 166, .36);
        position: relative;
        overflow: hidden;
        min-height: 92px;
    }

    .calendar-card__toolbar::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            linear-gradient(90deg, rgba(255, 255, 255, .10), transparent 42%),
            repeating-linear-gradient(135deg, rgba(255,255,255,.10) 0 1px, transparent 1px 14px);
        opacity: .42;
        pointer-events: none;
    }

    .calendar-card__toolbar > * {
        position: relative;
        z-index: 1;
    }

    .calendar-heading {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .calendar-heading__date {
        min-width: 220px;
        min-height: 48px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        background: rgba(255,255,255,.95);
        color: var(--meeting-navy);
        box-shadow: 0 12px 26px rgba(4, 18, 38, .22);
        font-size: .94rem;
        font-weight: 900;
        line-height: 1.25;
        padding: 10px 14px;
        white-space: nowrap;
    }

    .calendar-heading__eyebrow {
        display: block;
        color: rgba(255,255,255,.72);
        font-size: .76rem;
        font-weight: 900;
        letter-spacing: .04em;
        text-transform: uppercase;
        line-height: 1.2;
    }

    .calendar-heading__title {
        display: block;
        color: #ffffff;
        font-size: 1.25rem;
        font-weight: 900;
        line-height: 1.2;
        margin-top: 2px;
    }

    .calendar-heading__subtitle {
        display: block;
        color: rgba(255,255,255,.78);
        font-size: .88rem;
        font-weight: 700;
        line-height: 1.3;
        margin-top: 4px;
    }

    .calendar-heading__meta {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
    }

    .calendar-heading__pill {
        display: inline-flex;
        align-items: center;
        min-height: 34px;
        padding: 7px 12px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.28);
        background: rgba(255,255,255,.13);
        color: #ffffff;
        font-size: .82rem;
        font-weight: 900;
        white-space: nowrap;
        backdrop-filter: blur(8px);
    }

    .calendar-heading__action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        min-width: 118px;
        padding: 8px 14px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.45);
        color: #ffffff !important;
        background: rgba(255,255,255,.12);
        box-shadow: 0 8px 18px rgba(4, 18, 38, .16);
        font-size: .88rem;
        font-weight: 900;
        line-height: 1.15;
        text-decoration: none;
        white-space: nowrap;
        backdrop-filter: blur(8px);
    }

    .calendar-heading__action.primary {
        color: #062b2f !important;
        border-color: transparent;
        background: linear-gradient(135deg, #8df1e4, #23c7c8);
    }

    .calendar-heading__action:hover,
    .calendar-heading__action:focus {
        color: #ffffff !important;
        filter: brightness(1.06);
        transform: translateY(-1px);
    }

    .calendar-heading__action.primary:hover,
    .calendar-heading__action.primary:focus {
        color: #062b2f !important;
    }

    .calendar-heading__action:disabled {
        color: rgba(255,255,255,.72) !important;
        border-color: rgba(255,255,255,.28);
        background: rgba(148, 163, 184, .22);
        box-shadow: none;
        filter: none;
        transform: none;
        cursor: not-allowed;
    }

    .toolbar-left { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .toolbar-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

    .calendar-card__toolbar .text-muted {
        color: rgba(255, 255, 255, .72) !important;
        font-weight: 700;
    }

    .hint-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(25,135,84,.10);
        color: #146c43;
        font-size: .9rem;
        border: 1px solid rgba(25,135,84,.18);
        white-space: nowrap;
    }

    .calendar-card__body { padding: 16px; background: #eef5fb; }
    .calendar-scroll {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 4px;
    }

    /* FullCalendar polish */
    .fc .fc-toolbar-title {
        color: var(--meeting-navy);
        font-size: 1.15rem;
        font-weight: 900;
        flex-grow: 1;
        text-align: center;
    }
    .fc .fc-button {
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,.10) !important;
        box-shadow: none !important;
        padding: .35rem .65rem;
    }
    .fc .fc-button-primary {
        background: var(--meeting-teal) !important;
        border-color: transparent !important;
        color: #062b2f !important;
        font-weight: 800;
    }
    .fc .fc-button-primary:not(:disabled):hover,
    .fc .fc-button-primary:not(:disabled):focus {
        color: #ffffff !important;
        filter: brightness(1.03);
    }

    .fc .fc-scrollgrid {
        overflow: hidden;
        border-radius: 16px;
        border-color: var(--meeting-border) !important;
        box-shadow: 0 12px 28px rgba(15, 35, 64, .08);
    }
    .fc .fc-button-primary:disabled { opacity: .55; }

    .fc .fc-daygrid-day-frame {
        padding: 8px;
        min-height: 130px;
    }
    .fc .fc-daygrid-day-number { font-weight: 600; color: rgba(0,0,0,.70); }

    .fc .fc-col-header-cell-cushion {
        font-weight: 700;
        font-size: 1rem;
        text-shadow: 0 1px 1px rgba(0,0,0,.15);
    }

    .fc .fc-day-head-weekday,
    .fc .fc-day-head-date {
        display: block;
        color: #ffffff;
        line-height: 1.2;
    }

    .fc .fc-day-head-weekday {
        font-weight: 900;
    }

    .fc .fc-day-head-date {
        margin-top: 2px;
        font-size: .75rem;
        font-weight: 800;
        opacity: .82;
    }

    /* Header background color */
    .fc .fc-col-header-cell {
        background: var(--meeting-navy) !important;
        color: #fff !important;
        border-color: rgba(255,255,255,.12) !important;
    }

    .fc .fc-col-header-cell:nth-child(1),
    .fc .fc-col-header-cell:nth-child(2),
    .fc .fc-col-header-cell:nth-child(3),
    .fc .fc-col-header-cell:nth-child(4),
    .fc .fc-col-header-cell:nth-child(5),
    .fc .fc-col-header-cell:nth-child(6),
    .fc .fc-col-header-cell:nth-child(7) {
        background: var(--meeting-navy) !important;
        color: #fff !important;
    }

    .fc .fc-daygrid-day,
    .fc .fc-daygrid-day.fc-day-sun,
    .fc .fc-daygrid-day.fc-day-mon,
    .fc .fc-daygrid-day.fc-day-tue,
    .fc .fc-daygrid-day.fc-day-wed,
    .fc .fc-daygrid-day.fc-day-thu,
    .fc .fc-daygrid-day.fc-day-fri,
    .fc .fc-daygrid-day.fc-day-sat {
        background: #eef8f7 !important;
    }

    .fc .fc-daygrid-day.fc-day-other {
        background: #f7fbfc !important;
        opacity: .78;
    }

    /* Make header text readable */
    .fc .fc-col-header-cell:nth-child(1) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(2) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(3) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(4) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(5) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(6) .fc-col-header-cell-cushion,
    .fc .fc-col-header-cell:nth-child(7) .fc-col-header-cell-cushion {
        color: #ffffff !important;
    }

    /* Day number colors only (do not override header text) */
    .fc-day-sun .fc-daygrid-day-number {
        color: var(--meeting-navy) !important;
    }

    .fc-day-mon .fc-daygrid-day-number {
        color: #10233f !important;
    }

    .fc-day-tue .fc-daygrid-day-number {
        color: #10233f !important;
    }

    .fc-day-wed .fc-daygrid-day-number {
        color: #10233f !important;
    }

    .fc-day-thu .fc-daygrid-day-number {
        color: #10233f !important;
    }

    .fc-day-fri .fc-daygrid-day-number {
        color: #10233f !important;
    }

    .fc-day-sat .fc-daygrid-day-number {
        color: #10233f !important;
    }

    .fc .fc-day-today {
        background: #eef8f7 !important;
        box-shadow: none;
    }

    .fc .fc-day-today .fc-daygrid-day-frame {
        min-height: 100% !important;
        height: 100% !important;
        background: transparent !important;
        box-shadow: none;
    }

    .fc .fc-day-today .fc-daygrid-day-top,
    .fc .fc-day-today .fc-daygrid-day-events,
    .fc .fc-day-today .fc-daygrid-day-bg {
        background: transparent !important;
    }

    .fc .fc-day-today .fc-daygrid-day-number {
        background: var(--meeting-teal-dark);
        color: #ffffff !important;
        border-radius: 50%;
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        box-shadow: 0 8px 18px rgba(15, 118, 110, .26);
    }

    .fc .fc-list {
        overflow: hidden;
        border: 1px solid var(--meeting-border) !important;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 12px 28px rgba(15, 35, 64, .08);
    }

    .fc .fc-list-day-cushion {
        background: var(--meeting-navy) !important;
        color: #ffffff !important;
        font-weight: 900;
    }

    .fc .fc-list-event td {
        border-color: #e5edf7 !important;
        color: var(--meeting-navy);
        font-weight: 800;
    }

    .fc .fc-list-event:hover td {
        background: #ecfeff !important;
    }

    .fc .fc-timegrid-axis,
    .fc .fc-timegrid-slot-label {
        background: #f8fafc !important;
        border-color: #d8e3ef !important;
    }

    .fc .fc-timegrid-slot-label-cushion {
        color: #334155;
        font-size: .75rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .fc .fc-timegrid-slot {
        height: 46px;
        border-color: #d8e3ef !important;
    }

    .fc .fc-timegrid-col {
        background: #f7fbfc;
    }

    .fc .fc-timegrid-col.fc-day-today {
        background: #f7fbfc !important;
        box-shadow: none;
    }

    .fc .fc-timegrid-event {
        border-radius: 12px !important;
        padding: 7px 9px !important;
        min-height: 46px;
        box-shadow: 0 8px 18px rgba(15, 35, 64, .12) !important;
        overflow: hidden !important;
    }

    .fc .fc-timegrid-event .meeting-event-content {
        display: block;
    }

    .fc .fc-timegrid-event .meeting-event-icon {
        display: none;
    }

    .fc .fc-timegrid-event .meeting-event-title {
        font-size: .75rem;
        line-height: 1.25;
    }

    .fc .fc-timegrid-event .meeting-event-subtitle {
        font-size: .68rem;
        line-height: 1.25;
    }

    .fc .fc-timegrid-event .meeting-event-meta {
        font-size: .67rem;
        line-height: 1.25;
        gap: 2px 6px;
    }

    .fc .fc-timegrid-now-indicator-line {
        border-color: var(--meeting-pink) !important;
        border-width: 2px 0 0 !important;
    }

    .fc .fc-timegrid-now-indicator-arrow {
        border-color: var(--meeting-pink) !important;
        border-top-color: transparent !important;
        border-bottom-color: transparent !important;
    }

    .fc .fc-event {
        --meeting-event-bg-start: #ffffff;
        --meeting-event-bg-end: #f8fafc;
        --meeting-event-border: var(--meeting-border);
        background: linear-gradient(180deg, var(--meeting-event-bg-start), var(--meeting-event-bg-end)) !important;
        border-radius: 12px !important;
        border: 2px solid var(--meeting-event-border) !important;
        padding: 8px 10px !important;
        font-size: 0.80rem;
        line-height: 1.4;
        white-space: normal !important;
        word-break: break-word;
        overflow: hidden;
        margin-bottom: 8px !important;
        box-shadow: 0 8px 18px rgba(15, 35, 64, .12) !important;
        transition: all .15s ease;
    }

    .fc .fc-event:hover {
        transform: translateY(-1px);
        box-shadow: 0 14px 24px rgba(15, 35, 64, .18) !important;
    }

    .fc .fc-event-title {
        font-weight: 600;
        font-size: 0.78rem;
        white-space: normal !important;
        word-break: break-word;
        color: var(--meeting-navy) !important;
        line-height: 1.4;
    }

    .meeting-event-content {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        color: var(--meeting-navy);
        white-space: normal;
        overflow: hidden;
    }

    .meeting-event-icon {
        width: 24px;
        height: 24px;
        flex: 0 0 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: rgba(255, 255, 255, .72);
        box-shadow: inset 0 0 0 1px rgba(15, 35, 64, .08);
        font-size: .95rem;
        line-height: 1;
    }

    .meeting-event-text {
        min-width: 0;
        flex: 1;
    }

    .meeting-event-title {
        color: var(--meeting-navy);
        font-size: .78rem;
        line-height: 1.35;
        font-weight: 900;
        white-space: normal;
        overflow: visible;
        word-break: break-word;
    }

    .meeting-event-subtitle,
    .meeting-event-meta {
        margin-top: 3px;
        color: #465b78;
        font-size: .72rem;
        line-height: 1.3;
        font-weight: 800;
        overflow: visible;
        white-space: normal;
        word-break: break-word;
    }

    .meeting-event-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 8px;
    }

    .fc-event.customer-event {
        --meeting-event-bg-end: #f0fdfa;
        --meeting-event-border: #22c55e;
    }

    .fc-event.team-event {
        --meeting-event-bg-end: #eff6ff;
        --meeting-event-border: #238cf6;
    }

    .fc-event.executive-event {
        --meeting-event-bg-end: #fff7ed;
        --meeting-event-border: var(--meeting-orange);
    }

    .fc-event.manager-event {
        --meeting-event-bg-end: #f5f3ff;
        --meeting-event-border: var(--meeting-purple);
    }

    .fc-event.vendor-event {
        --meeting-event-bg-end: #fffbeb;
        --meeting-event-border: #d97706;
    }

    .fc-event.other-event {
        --meeting-event-bg-end: #f8fafc;
        --meeting-event-border: #64748b;
    }

    .fc-tooltip {
        background: #212529;
        color: #fff;
        padding: 8px 10px;
        border-radius: 8px;
        font-size: 0.85rem;
        box-shadow: 0 6px 18px rgba(0,0,0,.2);
        pointer-events: none;
        z-index: 9999;
        max-width: 260px;
        line-height: 1.35;
    }


    .meeting-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .meeting-list-card {
        border: 1px solid rgba(15, 118, 110, .18) !important;
        border-radius: 18px !important;
        overflow: hidden;
        box-shadow: 0 14px 28px rgba(15, 35, 64, .09);
    }

    .meeting-list-card .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 16px;
        color: #ffffff;
        background: #10233f !important;
        border: 0;
        font-weight: 900;
    }

    .meeting-list-card .card-header span {
        color: rgba(255, 255, 255, .72);
        font-size: .86rem;
        font-weight: 700;
    }

    .meeting-list-card .card-body {
        background: #eef5fb;
    }

    .meeting-row {
        --meeting-event-bg-start: #ffffff;
        --meeting-event-bg-end: #f8fafc;
        --meeting-event-border: #d8e3ef;
        display: flex;
        gap: 18px;
        background: linear-gradient(180deg, var(--meeting-event-bg-start), var(--meeting-event-bg-end));
        border-radius: 16px;
        padding: 16px;
        border: 2px solid var(--meeting-event-border);
        align-items: stretch;
        height: 100%;
        box-shadow: 0 10px 22px rgba(15, 35, 64, .08);
        transition: transform .16s ease, box-shadow .16s ease;
    }

    .meeting-row:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 30px rgba(15, 35, 64, .14);
    }

    .fc-event.customer-event,
    .meeting-row.customer-event {
        --meeting-event-bg-end: #f0fdfa;
        --meeting-event-border: #22c55e;
    }

    .fc-event.team-event,
    .meeting-row.team-event {
        --meeting-event-bg-end: #eff6ff;
        --meeting-event-border: #238cf6;
    }

    .fc-event.executive-event,
    .meeting-row.executive-event {
        --meeting-event-bg-end: #fff7ed;
        --meeting-event-border: var(--meeting-orange);
    }

    .fc-event.manager-event,
    .meeting-row.manager-event {
        --meeting-event-bg-end: #f5f3ff;
        --meeting-event-border: var(--meeting-purple);
    }

    .fc-event.vendor-event,
    .meeting-row.vendor-event {
        --meeting-event-bg-end: #fffbeb;
        --meeting-event-border: #d97706;
    }

    .fc-event.other-event,
    .meeting-row.other-event {
        --meeting-event-bg-end: #f8fafc;
        --meeting-event-border: #64748b;
    }


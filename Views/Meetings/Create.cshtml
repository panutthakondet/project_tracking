@model ProjectTracking.Models.Meeting

@{
    ViewData["Title"] = "สร้างนัดประชุม";
    // Controller ส่ง ViewBag.Projects = list of { ProjectId, ProjectName }
    var projects = ViewBag.Projects as IEnumerable<dynamic>;
    var employees = ViewBag.Employees as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<style>
    .meeting-create-wrap {
        width: 100%;
        max-width: 100%;
    }

    main.route-controller-meetings.route-action-create .meeting-create-wrap .meeting-card {
        border-radius: 16px;
        overflow: visible !important;
        border: 1px solid rgba(0,0,0,.08);
        box-shadow: 0 10px 28px rgba(0,0,0,.06);
        background: #fff;
    }

    main.route-controller-meetings.route-action-create .meeting-card__body,
    main.route-controller-meetings.route-action-create .meeting-card__body form,
    main.route-controller-meetings.route-action-create .meeting-card__body .row,
    main.route-controller-meetings.route-action-create .meeting-card__body [class*="col-"] {
        overflow: visible !important;
    }

    main.route-controller-meetings.route-action-create .meeting-card__body .meeting-attendee-picker {
        position: relative;
        z-index: 20;
    }

    main.route-controller-meetings.route-action-create .meeting-card__body .meeting-attendee-picker:focus-within {
        z-index: 1100;
    }

    main.route-controller-meetings.route-action-create .meeting-card__body .meeting-attendee-picker .pt-search-select.is-open,
    main.route-controller-meetings.route-action-create .meeting-card__body .meeting-attendee-picker .pt-search-select__dropdown {
        z-index: 1101 !important;
    }

    main.route-controller-meetings.route-action-create .meeting-create-wrap .meeting-card:has(.meeting-attendee-picker .pt-search-select.is-open) {
        padding-bottom: 260px;
    }

    .meeting-card__header {
        padding: 14px 16px;
        border-bottom: 1px solid rgba(0,0,0,.06);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .meeting-card__header .chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(25,135,84,.10);
        color: #146c43;
        border: 1px solid rgba(25,135,84,.18);
        font-size: .92rem;
        white-space: nowrap;
    }

    .meeting-card__body { padding: 18px; }

    .section-title {
        margin: 0 0 8px 0;
        font-weight: 800;
        font-size: 1.02rem;
        color: rgba(0,0,0,.78);
    }

    .section-subtitle {
        margin: 0 0 12px 0;
        color: #6c757d;
        font-size: .93rem;
    }

    .req { color: #dc3545; font-weight: 700; }

    .form-hint {
        display: block;
        margin-top: 6px;
        color: #6c757d;
        font-size: .88rem;
    }

    .divider {
        height: 1px;
        background: rgba(0,0,0,.06);
        margin: 14px 0;
    }

    .btn-pill { border-radius: 999px; }

    @@media (max-width: 768px) {
        .meeting-card__body { padding: 14px; }
    }
</style>

<div class="container meeting-create-wrap">
    <div class="meeting-form-hero index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">Meetings</span>
            <h2 class="index-title">@ViewData["Title"]</h2>
            <p class="index-subtitle">เลือกโครงการ ถ้ามี แล้วกรอกรายละเอียดการประชุม</p>
        </div>
        <div class="index-actions">
            <a class="btn btn-outline-light btn-pill" href="/Meetings/Schedule/@ViewBag.CalendarId">กลับปฏิทิน</a>
        </div>
    </div>

    <div class="meeting-card">
        <div class="meeting-card__header">
            <strong style="display:flex;align-items:center;gap:8px;">
                <span style="font-size:1.05rem;">🗓️</span>
                <span>ข้อมูลการประชุม</span>
            </strong>
        </div>

        <div class="meeting-card__body">
            <form method="post" action="/Meetings/Store" id="meetingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CalendarId" value="@ViewBag.CalendarId" />

                <h3 class="section-title">รายละเอียด</h3>
                <p class="section-subtitle">กรอกหัวข้อและเลือกโครงการเพื่อเชื่อมโยง (ไม่เลือกก็ได้)</p>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">หัวข้อประชุม <span class="req">*</span></label>
                        <input type="text" name="Title" class="form-control" required placeholder="เช่น Kickoff, Sprint Planning" />
                        <small class="form-hint">หัวข้อสั้น กระชับ จะช่วยให้ดูในปฏิทินง่าย</small>
                    </div>

                    <div class="col-12">
                        <label class="form-label">รายละเอียดการประชุม</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="วาระการประชุม / สิ่งที่ต้องเตรียม / หมายเหตุเพิ่มเติม"></textarea>
                        <small class="form-hint">เช่น Agenda, สิ่งที่ต้องเตรียม, ลิงก์เอกสาร</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">โครงการ</label>
                        <select name="ProjectId" class="form-select">
                            <option value="">— ไม่ระบุโครงการ —</option>
                            @if (projects != null)
                            {
                                foreach (var p in projects)
                                {
                                    <option value="@p.ProjectId">@p.ProjectName</option>
                                }
                            }
                        </select>
                        <small class="form-hint">@((ViewBag.ProjectHint as string) ?? "")</small>
                    </div>

                    <div class="col-md-6 col-lg-5">
                        <label class="form-label">วันที่ <span class="req">*</span></label>

                        <input type="text"
                               id="MeetingDateDisplay"
                               class="form-control meeting-date-control"
                               placeholder="วว/ดด/ปปปป"
                               autocomplete="off"
                               maxlength="10"
                               required />

                        <input type="hidden"
                               name="MeetingDate"
                               id="MeetingDate"
                               value="@ViewBag.Date" />

                        <small class="form-hint">รูปแบบ วัน/เดือน/พ.ศ. เช่น 26/05/2569</small>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <label class="form-label">เวลา <span class="req">*</span></label>
                        <div class="meeting-time-pair">
                            <div class="meeting-time-field">
                                <span>เริ่ม</span>
                                <input type="time" name="StartTime" class="form-control" required />
                            </div>
                            <div class="meeting-time-field">
                                <span>สิ้นสุด</span>
                                <input type="time" name="EndTime" class="form-control" required />
                            </div>
                        </div>
                        <small class="form-hint">หากสิ้นสุดเวลา 00:00 ระบบจะนับเป็นเที่ยงคืนของวันถัดไป</small>
                    </div>

                    <div class="col-12">
                        <label class="form-label">สถานที่</label>
                        <input type="text" name="Location" class="form-control" placeholder="เช่น ห้องประชุม A / Google Meet" />
                        <small class="form-hint">ถ้าเป็นออนไลน์ ใส่ชื่อแพลตฟอร์มหรือ link ไว้ก็ได้</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">ประชุมกับใคร</label>
                        <select name="MeetingAudience" class="form-select">
                            <option value="">— เลือกประเภทการประชุม —</option>
                            <option value="ลูกค้า">👥 ลูกค้า</option>
                            <option value="ทีมงาน">👨‍💻 ทีมงาน</option>
                            <option value="ผู้บริหาร">🏢 ผู้บริหาร</option>
                            <option value="ผู้จัดการ">📋 ผู้จัดการ</option>
                            <option value="Vendor">🤝 Vendor / Partner</option>
                            <option value="อื่นๆ">📝 อื่นๆ</option>
                        </select>
                        <small class="form-hint">ช่วยแยกประเภทการประชุม เช่น ประชุมลูกค้า หรือประชุมภายในทีม</small>
                    </div>
                    <div class="col-12">
                        <label class="form-label">ผู้เข้าร่วมประชุม</label>
                        <div class="meeting-attendee-picker" data-attendee-picker>
                            <div class="meeting-attendee-picker__controls">
                                <select class="form-select" data-attendee-select>
                                    <option value="">-- เลือกผู้เข้าร่วม --</option>
                                    @foreach (var e in employees)
                                    {
                                        var label = $"{e.EmpName} {(e.Position != null ? $"({e.Position})" : "")}".Trim();
                                        <option value="@e.EmpId" data-label="@label">@label</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-primary btn-pill" data-attendee-add>
                                    เพิ่ม
                                </button>
                            </div>
                            <div class="meeting-selected-attendees" data-attendee-list></div>
                            <div data-attendee-inputs></div>
                        </div>
                        <small class="form-hint">เลือกทีละคน กดเพิ่ม แล้วสามารถลบรายชื่อออกเพื่อเลือกใหม่ได้</small>
                    </div>
                </div>

                <div class="divider"></div>

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="text-muted" style="font-size:.92rem;">
                        <span class="req">*</span> จำเป็นต้องกรอก
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-pill">บันทึก</button>
                        <a href="/Meetings/Schedule/@ViewBag.CalendarId" class="btn btn-outline-secondary btn-pill">ยกเลิก</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    const form = document.getElementById('meetingForm');
    if (!form) return;

    const startInput = form.querySelector('input[name="StartTime"]');
    const endInput = form.querySelector('input[name="EndTime"]');
    const displayDate = document.getElementById('MeetingDateDisplay');
    const hiddenDate = document.getElementById('MeetingDate');

    initMeetingAttendeePicker(form);

    function initMeetingAttendeePicker(formElement) {
        const picker = formElement.querySelector('[data-attendee-picker]');
        if (!picker) return;

        const select = picker.querySelector('[data-attendee-select]');
        const addButton = picker.querySelector('[data-attendee-add]');
        const list = picker.querySelector('[data-attendee-list]');
        const inputs = picker.querySelector('[data-attendee-inputs]');
        const selected = new Map();

        function findOption(value) {
            return Array.from(select.options).find(option => option.value === value);
        }

        function syncInputs() {
            inputs.innerHTML = '';
            selected.forEach((label, id) => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'users';
                input.value = id;
                inputs.appendChild(input);
            });
        }

        function render() {
            list.innerHTML = '';

            if (selected.size === 0) {
                const empty = document.createElement('div');
                empty.className = 'meeting-attendee-empty';
                empty.textContent = 'ยังไม่ได้เลือกผู้เข้าร่วม';
                list.appendChild(empty);
                syncInputs();
                return;
            }

            selected.forEach((label, id) => {
                const chip = document.createElement('span');
                chip.className = 'meeting-selected-attendee';

                const text = document.createElement('span');
                text.textContent = label;

                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'meeting-attendee-remove';
                remove.setAttribute('aria-label', `ลบ ${label}`);
                remove.dataset.removeAttendee = id;
                remove.textContent = '×';

                chip.appendChild(text);
                chip.appendChild(remove);
                list.appendChild(chip);
            });

            syncInputs();
        }

        function addAttendee(value) {
            if (!value || selected.has(value)) return;

            const option = findOption(value);
            if (!option) return;

            const label = option.dataset.label || option.textContent.trim();
            selected.set(value, label);
            option.disabled = true;
            select.value = '';
            render();
        }

        addButton?.addEventListener('click', function () {
            addAttendee(select.value);
        });

        select?.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                addAttendee(select.value);
            }
        });

        list?.addEventListener('click', function (event) {
            const button = event.target.closest('[data-remove-attendee]');
            if (!button) return;

            const id = button.dataset.removeAttendee;
            selected.delete(id);

            const option = findOption(id);
            if (option) option.disabled = false;

            render();
        });

        Array.from(select.options)
            .filter(option => option.dataset.selected === 'true')
            .forEach(option => addAttendee(option.value));

        render();
    }

    function formatDateInput(value) {
        const digits = value.replace(/\D/g, '').slice(0, 8);

        if (digits.length <= 2) return digits;
        if (digits.length <= 4) {
            return digits.slice(0, 2) + '/' + digits.slice(2);
        }

        return digits.slice(0, 2) + '/' +
               digits.slice(2, 4) + '/' +
               digits.slice(4);
    }

    function syncHiddenDate() {
        if (!displayDate || !hiddenDate) return;

        const raw = displayDate.value.trim();
        const parts = raw.split('/');

        if (parts.length !== 3) {
            hiddenDate.value = '';
            return;
        }

        let [dd, mm, yyyy] = parts;

        if (yyyy.length === 4 && parseInt(yyyy) > 2400) {
            yyyy = (parseInt(yyyy) - 543).toString();
        }

        if (dd && mm && yyyy) {
            hiddenDate.value = `${yyyy}-${mm.padStart(2, '0')}-${dd.padStart(2, '0')}`;
        }
    }

    if (displayDate) {

        if (hiddenDate?.value) {
            const d = new Date(hiddenDate.value);

            if (!isNaN(d)) {
                const dd = String(d.getDate()).padStart(2, '0');
                const mm = String(d.getMonth() + 1).padStart(2, '0');
                const yyyy = d.getFullYear() + 543;

                displayDate.value = `${dd}/${mm}/${yyyy}`;
            }
        }

        displayDate.addEventListener('input', function () {
            this.value = formatDateInput(this.value);
            syncHiddenDate();
        });
    }

    function validateTime() {
        if (!startInput || !endInput) return true;
        return Boolean(startInput.value && endInput.value);
    }

    if (startInput) startInput.addEventListener('change', validateTime);
    if (endInput) endInput.addEventListener('change', validateTime);

    form.addEventListener('submit', function (e) {
        syncHiddenDate();

        if (!hiddenDate?.value) {
            e.preventDefault();
            displayDate?.focus();
            return;
        }

        if (!validateTime()) {
            e.preventDefault();
            endInput?.focus();
        }
    });
})();
</script>

@model IEnumerable<ProjectTracking.ViewModels.MeetingReportRowViewModel>
@using System.Globalization

@{
    Layout = null;
    var th = new CultureInfo("th-TH");
    var rows = (Model ?? Enumerable.Empty<ProjectTracking.ViewModels.MeetingReportRowViewModel>()).ToList();
    var projects = ViewBag.Projects as IEnumerable<ProjectTracking.Models.Project> ?? Enumerable.Empty<ProjectTracking.Models.Project>();
    var selectedProjectId = ViewBag.SelectedProjectId is int projectId ? projectId : (int?)null;
    var fromDate = ViewBag.FromDate as DateTime?;
    var toDate = ViewBag.ToDate as DateTime?;
    var audienceList = ViewBag.AudienceList as IEnumerable<string> ?? Enumerable.Empty<string>();
    var selectedAudience = ViewBag.SelectedAudience as string ?? "";
    var today = DateTime.Today;
    var coopList = projects
        .Select(x => x.Coop?.CoopName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string DateText(DateTime value) => value.ToString("dd/MM/yyyy", th);
    string DateTimeText(DateTime value) => value == default ? "-" : value.ToString("dd/MM/yyyy HH:mm", th);
    string DateInput(DateTime? value) => value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";
    string TimeText(TimeSpan value) => $"{(int)value.TotalHours:00}:{value.Minutes:00}";
    string SelectedProjectName() => selectedProjectId.HasValue
        ? projects.FirstOrDefault(x => x.ProjectId == selectedProjectId.Value)?.ProjectDisplayName ?? "-"
        : "All Projects";
    string DateRangeText()
    {
        if (fromDate.HasValue && toDate.HasValue) return $"{fromDate.Value.ToString("dd MMM yyyy", th)} - {toDate.Value.ToString("dd MMM yyyy", th)}";
        if (fromDate.HasValue) return $"ตั้งแต่ {fromDate.Value.ToString("dd MMM yyyy", th)}";
        if (toDate.HasValue) return $"ถึง {toDate.Value.ToString("dd MMM yyyy", th)}";
        return "All Dates";
    }
    string AttendeeStatusClass(string? status) => (status ?? "").Trim().ToLowerInvariant() switch
    {
        "accepted" => "success",
        "rejected" => "danger",
        "pending" => "warning",
        _ => "muted"
    };
    string AttendeeStatusText(string? status) => string.IsNullOrWhiteSpace(status) ? "-" : status.Trim();

    var totalMeetings = rows.Count;
    var todayMeetings = rows.Count(x => x.MeetingDate.Date == today);
    var upcomingMeetings = rows.Count(x => x.MeetingDate.Date >= today);
    var projectCount = rows.Where(x => x.ProjectId.HasValue).Select(x => x.ProjectId).Distinct().Count();
    var attendeeTotal = rows.Sum(x => x.Attendees.Count);
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>Meetings Report</title>
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&display=swap");
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 16px;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 11px;
        }
        .report-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }
        .report-btn {
            min-height: 34px;
            padding: 7px 13px;
            border: 1px solid #102443;
            border-radius: 999px;
            color: #102443;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 900;
            line-height: 1.1;
            text-decoration: none;
            cursor: pointer;
        }
        .report-btn.primary {
            color: #fff;
            background: #102443;
        }
        .print-header {
            margin-bottom: 12px;
            padding: 14px 16px;
            color: #fff;
            background: #102443;
        }
        .print-header h1 {
            margin: 0 0 6px;
            font-size: 22px;
        }
        .print-header div {
            color: rgba(255,255,255,.82);
            font-weight: 700;
            line-height: 1.55;
        }
        .filter-panel {
            display: grid;
            grid-template-columns: minmax(260px, 1.25fr) minmax(150px, .55fr) minmax(150px, .55fr) minmax(190px, .75fr) auto;
            align-items: end;
            gap: 10px;
            margin-bottom: 12px;
            padding: 12px;
            border: 1px solid #d8e3ef;
            background: #f8fbff;
        }
        .field label {
            display: block;
            margin-bottom: 5px;
            color: #64748b;
            font-weight: 900;
        }
        .field select,
        .field input[type="date"] {
            width: 100%;
            min-height: 34px;
            padding: 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
        }
        .pt-native-select-hidden {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            min-height: 1px !important;
            opacity: 0 !important;
            pointer-events: none !important;
            clip-path: inset(50%) !important;
        }
        .pt-search-select { position: relative; width: 100%; }
        .pt-search-select__field { position: relative; }
        .pt-search-select__input {
            width: 100%;
            min-height: 34px;
            padding: 7px 38px 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            outline: none;
        }
        .pt-search-select__input:focus {
            border-color: #14b8a6;
            box-shadow: 0 0 0 3px rgba(20, 184, 166, .12);
        }        .pt-search-select__dropdown {
            position: absolute;
            left: 0;
            right: 0;
            top: calc(100% + 4px);
            z-index: 20;
            max-height: 240px;
            overflow-y: auto;
            display: none;
            border: 1px solid #d8e2ef;
            background: #fff;
            box-shadow: 0 12px 26px rgba(15, 35, 64, .14);
        }
        .pt-search-select.is-open .pt-search-select__dropdown { display: block; }
        .pt-search-select__option {
            width: 100%;
            padding: 8px 10px;
            border: 0;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.35;
            text-align: left;
            cursor: pointer;
        }
        .pt-search-select__option:hover,
        .pt-search-select__option.is-selected {
            color: #062b2f;
            background: rgba(20, 184, 166, .14);
        }
        .pt-search-select__empty {
            padding: 10px;
            color: #64748b;
            font-weight: 800;
            text-align: center;
        }
        .filter-submit {
            width: auto;
            min-width: 88px;
            justify-self: start;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin-bottom: 12px;
        }
        .kpi {
            padding: 10px;
            border: 1px solid #d8e3ef;
            border-left: 4px solid #14b8a6;
        }
        .kpi.info { border-left-color: #258cfb; }
        .kpi.warning { border-left-color: #f59e0b; }
        .kpi.cyan { border-left-color: #22d3ee; }
        .kpi span,
        .kpi small {
            display: block;
            color: #64748b;
            font-weight: 800;
        }
        .kpi strong {
            display: block;
            margin: 5px 0;
            color: #10233f;
            font-size: 20px;
            font-weight: 900;
        }
        h2 {
            margin: 14px 0 8px;
            color: #10233f;
            font-size: 16px;
            font-weight: 900;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin-bottom: 12px;
        }
        .meeting-report-table col.col-seq { width: 5%; }
        .meeting-report-table col.col-date { width: 14%; }
        .meeting-report-table col.col-meeting { width: 26%; }
        .meeting-report-table col.col-place { width: 19%; }
        .meeting-report-table col.col-attendee { width: 24%; }
        .meeting-report-table col.col-created { width: 12%; }
        th {
            padding: 7px 6px;
            color: #fff;
            background: #102443;
            border: 1px solid rgba(255,255,255,.18);
            font-weight: 900;
            text-align: center;
        }
        td {
            padding: 7px 6px;
            border: 1px solid #d8e3ef;
            line-height: 1.45;
            vertical-align: top;
            overflow-wrap: anywhere;
        }
        tr:nth-child(even) td { background: #f8fbff; }
        .text-center { text-align: center; }
        .project-group-row td {
            padding: 8px 10px;
            color: #10233f;
            background: transparent !important;
            border-color: #d8e3ef;
            border-top: 2px solid #102443;
            font-size: 12px;
            font-weight: 900;
        }
        .project-group-name {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }
        .project-group-label {
            color: #0f766e;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: .05em;
            text-transform: uppercase;
        }
        .project-group-count {
            flex: 0 0 auto;
            color: #64748b;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }
        .cell-title {
            color: #10233f;
            font-weight: 900;
        }
        .cell-sub {
            margin-top: 4px;
            color: #465a73;
            font-weight: 700;
        }
        .attendee-list {
            display: grid;
            gap: 4px;
        }
        .attendee-name {
            color: #10233f;
            font-weight: 900;
        }
        .attendee-meta {
            color: #64748b;
            font-size: 10px;
            font-weight: 800;
        }
        .status-text {
            font-weight: 900;
            white-space: nowrap;
        }
        .status-text.success { color: #0f8f5f; }
        .status-text.warning { color: #b7790b; }
        .status-text.danger { color: #d6294f; }
        .status-text.muted { color: #64748b; }
        .empty {
            padding: 18px;
            border: 1px dashed #cbd5e1;
            color: #64748b;
            text-align: center;
            font-weight: 800;
        }
        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
        @@media print {
            body { padding: 0; }
            .report-actions,
            .filter-panel { display: none !important; }
            h2, h3,
            .project-group-row,
            .scenario-project__header,
            .scenario-group__header,
            .phase-project-group {
                break-after: avoid;
                page-break-after: avoid;
            }
            h2 + table,
            h2 + .empty,
            h2 + .report-table-scroll,
            h3 + table,
            h3 + .empty,
            .project-group-row + tr {
                break-before: avoid;
                page-break-before: avoid;
            }
            .report-section,
            .scenario-project,
            .scenario-group,
            .project-group-row,
            .phase-project-group {
                break-inside: avoid-page;
                page-break-inside: avoid;
            }
            thead { display: table-header-group; }
            tr { page-break-inside: avoid; }
        }
        @@media (max-width: 900px) {
            .filter-panel,
            .kpi-grid {
                grid-template-columns: 1fr;
            }
        }
    
        /* Crisp typography normalization for standalone pages. */
        :root { --pt-readable-thai-font: "Noto Sans Thai", "Leelawadee UI", Tahoma, "Segoe UI", Arial, sans-serif; }
        html, body {
            font-family: var(--pt-readable-thai-font) !important;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }
        body :where(*):not(svg):not(svg *) {
            font-family: var(--pt-readable-thai-font) !important;
            font-stretch: normal !important;
            letter-spacing: 0 !important;
            text-shadow: none !important;
        }
        body :is(h1, h2, h3, h4, h5, h6, th, label, strong, b, .report-btn, .btn, .badge, .status-text, .cell-title, .project-group-name, [class*="title"], [class*="heading"], [class*="eyebrow"], [class*="status"], [class*="badge"], [class*="count"], [class*="total"], [class*="value"]) {
            font-weight: 700 !important;
        }
        body :is(p, li, td, small, em, time, .cell-sub, .detail-block div, .meta-label, .meta-value, .empty, [class*="detail"], [class*="meta"], [class*="subtitle"], [class*="description"], [class*="desc"], [class*="remark"], [class*="note"], [class*="empty"]):not(.btn):not(.badge):not(.status-text):not([class*="status-"]):not([class*="Status"]) {
            font-weight: 400 !important;
        }
</style>
@await Html.PartialAsync("_StandaloneTheme")
</head>
<body class="pt-standalone-report">
    <div class="report-actions">
        <button type="button" class="report-btn primary" onclick="window.print()">Print</button>
        <a asp-controller="Reports" asp-action="Index" class="report-btn">Report Center</a>
        <a asp-controller="Home" asp-action="Index" class="report-btn">Dashboard</a>
    </div>

    <header class="print-header">
        <h1>Meetings Report</h1>
        <div>
            Project: @SelectedProjectName()<br />
            Date: @DateRangeText()<br />
            Audience: @(string.IsNullOrWhiteSpace(selectedAudience) ? "All Audiences" : selectedAudience)<br />
            ข้อมูล ณ @DateTime.Now.ToString("dd MMM yyyy HH:mm", th)
        </div>
    </header>

    <form method="get" id="filterForm" class="filter-panel">
        <div class="field">
            <label for="coopFilter">Cooperative</label>
            <select id="coopFilter" data-placeholder="พิมพ์ค้นหาสหกรณ์...">
                <option value="">-- All Cooperatives --</option>
                @foreach (var coop in coopList)
                {
                    <option value="@coop">@coop</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="projectSelect">Project</label>
            <select id="projectSelect" name="projectId" data-placeholder="พิมพ์ค้นหา Project...">
                <option value="">-- All Projects --</option>
                @foreach (var p in projects)
                {
                    <option value="@p.ProjectId"
                            data-coop-name="@(p.Coop?.CoopName ?? "")"
                            selected="@(selectedProjectId == p.ProjectId ? "selected" : null)">
                        @p.ProjectDisplayName
                    </option>
                }
            </select>
        </div>

        <div class="field">
            <label for="fromDate">From Date</label>
            <input id="fromDate" name="fromDate" type="date" value="@DateInput(fromDate)" />
        </div>

        <div class="field">
            <label for="toDate">To Date</label>
            <input id="toDate" name="toDate" type="date" value="@DateInput(toDate)" />
        </div>

        <div class="field">
            <label for="audienceSelect">Audience</label>
            <select id="audienceSelect" name="audience" data-placeholder="พิมพ์ค้นหา Audience...">
                <option value="">-- All Audiences --</option>
                @foreach (var item in audienceList)
                {
                    <option value="@item" selected="@(item == selectedAudience ? "selected" : null)">
                        @item
                    </option>
                }
            </select>
        </div>

        <button type="submit" class="report-btn primary filter-submit">ค้นหา</button>
    </form>

    <section class="kpi-grid">
        <article class="kpi">
            <span>Total Meetings</span>
            <strong>@totalMeetings</strong>
            <small>รายการประชุมทั้งหมด</small>
        </article>
        <article class="kpi warning">
            <span>Today</span>
            <strong>@todayMeetings</strong>
            <small>รายการประชุมวันนี้</small>
        </article>
        <article class="kpi info">
            <span>Upcoming</span>
            <strong>@upcomingMeetings</strong>
            <small>ประชุมวันนี้เป็นต้นไป</small>
        </article>
        <article class="kpi cyan">
            <span>Projects</span>
            <strong>@projectCount</strong>
            <small>โครงการที่มีประชุม</small>
        </article>
        <article class="kpi">
            <span>Attendees</span>
            <strong>@attendeeTotal</strong>
            <small>จำนวนผู้เข้าร่วมรวม</small>
        </article>
    </section>

    <h2>Meeting List By Project</h2>
    @if (!rows.Any())
    {
        <div class="empty">ไม่พบรายการประชุมตามเงื่อนไขที่เลือก</div>
    }
    else
    {
        <table class="meeting-report-table">
            <colgroup>
                <col class="col-seq" />
                <col class="col-date" />
                <col class="col-meeting" />
                <col class="col-place" />
                <col class="col-attendee" />
                <col class="col-created" />
            </colgroup>
            <thead>
                <tr>
                    <th>Seq</th>
                    <th>Date / Time</th>
                    <th>Meeting</th>
                    <th>Location / Audience</th>
                    <th>Attendees</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var projectGroups = rows
                        .GroupBy(item => new { item.ProjectId, item.ProjectName })
                        .OrderBy(group => group.Key.ProjectName)
                        .ToList();
                }
                @foreach (var projectGroup in projectGroups)
                {
                    var row = 1;
                    <tr class="project-group-row">
                        <td colspan="6">
                            <div class="project-group-name">
                                <div>
                                    <span class="project-group-label">Project</span>
                                    @projectGroup.Key.ProjectName
                                </div>
                                <span class="project-group-count">@projectGroup.Count() รายการ</span>
                            </div>
                        </td>
                    </tr>

                    @foreach (var item in projectGroup.OrderBy(x => x.MeetingDate).ThenBy(x => x.StartTime).ThenBy(x => x.Title))
                    {
                        <tr>
                            <td class="text-center">@row</td>
                            <td>
                                <div class="cell-title">@DateText(item.MeetingDate)</div>
                                <div class="cell-sub">@TimeText(item.StartTime) - @TimeText(item.EndTime)</div>
                            </td>
                            <td>
                                <div class="cell-title">#@item.Id @TextOrDash(item.Title)</div>
                                <div class="cell-sub">@TextOrDash(item.Description)</div>
                            </td>
                            <td>
                                <div class="cell-title">@TextOrDash(item.Location)</div>
                                <div class="cell-sub">Audience: @TextOrDash(item.Audience)</div>
                            </td>
                            <td>
                                @if (!item.Attendees.Any())
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <div class="attendee-list">
                                        @foreach (var attendee in item.Attendees)
                                        {
                                            <div>
                                                <span class="attendee-name">@attendee.EmpName</span>
                                                <span class="status-text @AttendeeStatusClass(attendee.Status)">(@AttendeeStatusText(attendee.Status))</span>
                                                <div class="attendee-meta">@TextOrDash(attendee.Position)</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="cell-title">@TextOrDash(item.CreatedByName)</div>
                                <div class="cell-sub">@DateTimeText(item.CreatedAt)</div>
                            </td>
                        </tr>
                        row++;
                    }
                }
            </tbody>
        </table>
    }

    <script>
        (function () {
            function normalize(value) {
                return (value || "").toString().trim().toLowerCase();
            }

            function getSelectedOption(select) {
                return select.options[select.selectedIndex] || null;
            }

            function hasEmptyOption(select) {
                return Array.from(select.options).some(option => option.value === "");
            }

            function dispatchSelectChange(select) {
                select.dispatchEvent(new Event("input", { bubbles: true }));
                select.dispatchEvent(new Event("change", { bubbles: true }));
            }

            function enhanceSelect(select) {
                if (!select || select.classList.contains("pt-dropdown-enhanced")) return;

                const wrapper = document.createElement("div");
                wrapper.className = "pt-search-select";

                const field = document.createElement("div");
                field.className = "pt-search-select__field";

                const input = document.createElement("input");
                input.type = "text";
                input.className = "pt-search-select__input";
                input.autocomplete = "off";
                input.placeholder = select.dataset.placeholder || getSelectedOption(select)?.text || "พิมพ์ค้นหา...";
                const dropdown = document.createElement("div");
                dropdown.className = "pt-search-select__dropdown";

                field.appendChild(input);
                wrapper.appendChild(field);
                wrapper.appendChild(dropdown);
                select.insertAdjacentElement("afterend", wrapper);
                select.classList.add("pt-dropdown-enhanced", "pt-native-select-hidden");
                select.tabIndex = -1;
                function syncInputFromSelect() {
                    const selected = getSelectedOption(select);
                    input.value = selected ? selected.text : "";
                }

                function closeDropdown() {
                    wrapper.classList.remove("is-open");
                }

                function renderOptions(filter = "") {
                    dropdown.innerHTML = "";
                    const keyword = normalize(filter);
                    const options = Array.from(select.options)
                        .filter(option => !option.disabled)
                        .filter(option => {
                            const haystack = normalize(`${option.text} ${option.value}`);
                            return !keyword || haystack.includes(keyword);
                        });

                    if (options.length === 0) {
                        const empty = document.createElement("div");
                        empty.className = "pt-search-select__empty";
                        empty.textContent = "ไม่พบข้อมูล";
                        dropdown.appendChild(empty);
                        return;
                    }

                    options.forEach(option => {
                        const item = document.createElement("button");
                        item.type = "button";
                        item.className = "pt-search-select__option";
                        if (option.value === select.value) item.classList.add("is-selected");
                        item.textContent = option.text;
                        item.addEventListener("click", function () {
                            select.value = option.value;
                            input.value = option.text;
                            closeDropdown();
                            syncInputFromSelect();
                            dispatchSelectChange(select);
                        });
                        dropdown.appendChild(item);
                    });
                }

                function openDropdown() {
                    input.value = "";
                    renderOptions(input.value);
                    wrapper.classList.add("is-open");
                }
                input.addEventListener("focus", openDropdown);
                input.addEventListener("click", openDropdown);
                input.addEventListener("input", function () {
                    renderOptions(input.value);
                    wrapper.classList.add("is-open");
                });
                input.addEventListener("keydown", function (event) {
                    if (event.key === "Escape") {
                        closeDropdown();
                        syncInputFromSelect();
                    }
                });                select.addEventListener("change", syncInputFromSelect);
                document.addEventListener("click", function (event) {
                    if (!wrapper.contains(event.target)) {
                        closeDropdown();
                        syncInputFromSelect();
                    }
                });

                syncInputFromSelect();
            }

            // Native dropdowns: custom search-select disabled globally.


            document.querySelectorAll(".filter-panel select").forEach(enhanceSelect);

            const coopFilter = document.getElementById("coopFilter");
            const projectFilter = document.getElementById("projectSelect");

            function syncProjectFilterOptions() {
                if (!projectFilter) return;

                const selectedCoop = normalize(coopFilter?.value || "");
                Array.from(projectFilter.options).forEach(option => {
                    const visible = option.value === "" || !selectedCoop || normalize(option.dataset.coopName || "") === selectedCoop;
                    option.hidden = !visible;
                    option.disabled = !visible;
                });

                const selected = projectFilter.selectedOptions[0];
                if (selected && selected.disabled) projectFilter.value = "";
            }

            coopFilter?.addEventListener("change", function () {
                localStorage.setItem("reports.meetings.selectedCoop", normalize(coopFilter.value));
                if (projectFilter) projectFilter.value = "";
                syncProjectFilterOptions();
            });

            const savedCoop = localStorage.getItem("reports.meetings.selectedCoop") || "";
            if (savedCoop && coopFilter) {
                const match = Array.from(coopFilter.options).find(option => normalize(option.value) === savedCoop);
                if (match) coopFilter.value = match.value;
            }

            syncProjectFilterOptions();
        })();
    </script>
</body>
</html>

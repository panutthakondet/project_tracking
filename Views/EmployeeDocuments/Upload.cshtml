@model IEnumerable<ProjectTracking.Models.EmployeeDocumentType>

@{
    ViewData["Title"] = "อัปโหลดเอกสารพนักงาน";
    var empId = ViewBag.EmpId is int id ? id : 0;
}

<div class="container">
    <div class="index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="index-title">อัปโหลดเอกสารพนักงาน</h2>
            <p class="index-subtitle">เลือกประเภทเอกสารและไฟล์ที่ต้องการจัดเก็บ</p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Upload" method="post" enctype="multipart/form-data"
                      data-employee-file-upload
                      data-upload-begin="@Url.Action("BeginUpload")"
                      data-upload-chunk="@Url.Action("UploadChunk")"
                      data-upload-complete="@Url.Action("CompleteUpload")"
                      data-upload-cancel="@Url.Action("CancelUpload")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="empId" value="@empId" />
                <div class="mb-3">
                    <label class="form-label" for="documentType">ประเภทเอกสาร</label>
                    <select id="documentType" name="documentType" class="form-select" required>
                        <option value="" selected disabled>-- เลือกประเภทเอกสาร --</option>
                        @foreach (var documentType in Model)
                        {
                            <option value="@documentType.DocumentTypeCode">@documentType.DocumentTypeName</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="file">เลือกไฟล์</label>
                    <input id="file" type="file" name="file" class="form-control" required aria-describedby="fileHelp" />
                    <div id="fileHelp" class="form-text text-muted">รองรับทุกนามสกุล รวมไฟล์ไม่มีนามสกุล เช่น ZIP, RAR, SQL, Excel, วิดีโอ และไฟล์โปรเจกต์ · อัปโหลดแบบแบ่งชิ้นส่วน ไม่กำหนดขนาดไฟล์สูงสุดในหน้าเว็บ</div>
                    <div class="form-text text-muted">ดูตัวอย่างรูปภาพและ PDF ได้ในเว็บ ส่วนไฟล์ชนิดอื่นจะดาวน์โหลดเพื่อเปิดด้วยโปรแกรมในเครื่อง</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="documentDescription">คำอธิบาย (ไม่บังคับ)</label>
                    <textarea id="documentDescription" name="description" class="form-control" rows="3" maxlength="2000" placeholder="รายละเอียดเพิ่มเติมของเอกสาร" aria-describedby="documentDescriptionHelp"></textarea>
                    <div id="documentDescriptionHelp" class="form-text text-muted">ใส่ได้ไม่เกิน 2,000 ตัวอักษร</div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">⬆ อัปโหลด</button>
                    <a asp-action="Index" asp-route-empId="@empId" class="btn btn-secondary">← กลับ</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/employee-file-upload.js" asp-append-version="true"></script>

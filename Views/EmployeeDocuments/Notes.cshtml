@using Microsoft.AspNetCore.Http
@using System.Globalization
@using System.Linq
@model ProjectTracking.Models.EmployeeNotesViewModel

@{
    ViewData["Title"] = "บันทึกพนักงาน";
    var thaiCulture = new CultureInfo("th-TH");

    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? string.Empty).Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? string.Empty;
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }

    string NotePreview(string? content, bool rich)
    {
        if (rich) content = ProjectTracking.Services.EmployeeNoteRichText.PlainText(content ?? "");
        var normalized = string.Join(" ", (content ?? string.Empty)
            .Split(new[] { '\r', '\n', '\t' }, StringSplitOptions.RemoveEmptyEntries))
            .Trim();
        if (string.IsNullOrWhiteSpace(normalized)) return "ยังไม่มีรายละเอียด";
        var text = new StringInfo(normalized);
        return text.LengthInTextElements > 72 ? text.SubstringByTextElements(0, 72) + "…" : normalized;
    }

    var canEdit = CanMenu("EmployeeDocuments.Upload");
    var canDelete = CanMenu("EmployeeDocuments.Delete");
    var editorDisabled = canEdit ? null : "disabled";
    var emojiGroups = new[]
    {
        (Name: "สีหน้าและความรู้สึก", Emojis: new[] { "😀", "😃", "😄", "😁", "😊", "🥰", "😍", "😎", "🤔", "😅", "😂", "🥳", "😴", "😢", "😮", "😓" }),
        (Name: "ท่าทางและกำลังใจ", Emojis: new[] { "👍", "👎", "👏", "🙌", "🙏", "💪", "🤝", "✌️", "👌", "👋", "❤️", "💚", "💙", "💜", "🔥", "🎉" }),
        (Name: "งานและเอกสาร", Emojis: new[] { "📝", "📋", "📁", "📂", "📎", "📌", "📍", "📄", "📑", "📊", "📈", "📉", "💼", "💻", "📧", "📞" }),
        (Name: "สถานะและการแจ้งเตือน", Emojis: new[] { "✅", "☑️", "❌", "⚠️", "❗", "❓", "🔔", "🚩", "🟢", "🟡", "🔴", "🔵", "⏳", "🔄", "🔒", "🔓" }),
        (Name: "เวลาและเป้าหมาย", Emojis: new[] { "📅", "🗓️", "⏰", "⏱️", "⌛", "🎯", "💡", "⭐", "🌟", "✨", "🏆", "🥇", "🚀", "🛠️", "🔍", "📦" })
    };
}

<style>
    .employee-note-success-toast {
        position: fixed;
        top: max(20px, env(safe-area-inset-top));
        right: max(20px, env(safe-area-inset-right));
        z-index: 1080;
        width: max-content;
        max-width: min(420px, calc(100vw - 40px));
        margin: 0;
        border-radius: 16px;
        box-shadow: 0 12px 32px rgba(0, 0, 0, .16);
        overflow-wrap: anywhere;
        transition: opacity .3s ease, transform .3s ease;
    }
    .employee-note-success-toast.is-hiding { opacity: 0; transform: translateY(-10px); pointer-events: none; }
    @@media (prefers-reduced-motion: reduce) {
        .employee-note-success-toast { transition: none; }
    }

    .employee-notes-page,
    .employee-notes-page * {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans Thai", "Leelawadee UI", Tahoma, Arial, sans-serif !important;
        letter-spacing: 0 !important;
        text-shadow: none !important;
        -webkit-font-smoothing: antialiased !important;
    }

    .employee-notes-page {
        --notes-bg: var(--pt-surface, #fff);
        --notes-soft: var(--pt-surface-soft, #f4f7fb);
        --notes-text: var(--pt-surface-contrast, #102f35);
        --notes-muted: var(--pt-surface-contrast-muted, #667b80);
        --notes-border: var(--pt-border, #cde1ed);
        --notes-accent: var(--pt-accent, #0ea5a6);
        color: var(--notes-text);
    }

    .employee-notes-hero {
        --notes-text: var(--pt-sidebar-contrast, #fff);
        --notes-muted: var(--pt-sidebar-contrast-muted, #d7e5ee);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
        padding: 22px 26px;
        border: 1px solid var(--notes-border);
        border-radius: 22px;
        color: var(--notes-text);
        background:
            radial-gradient(circle at 88% 10%, var(--pt-accent-glow, transparent), transparent 30%),
            linear-gradient(135deg, var(--pt-sidebar-bg, #18345d), var(--pt-sidebar-deep, #102443));
        box-shadow: 0 12px 30px var(--pt-shadow, rgba(15, 47, 64, .08));
    }

    .employee-notes-hero h1 {
        margin: 3px 0 4px;
        font-size: clamp(1.45rem, 2.2vw, 2rem);
        font-weight: 750;
        color: var(--notes-text);
    }

    .employee-notes-eyebrow {
        color: var(--notes-muted);
        font-size: .78rem;
        font-weight: 750;
        text-transform: uppercase;
    }

    .employee-notes-subtitle {
        margin: 0;
        color: var(--notes-muted);
        font-size: .94rem;
    }

    .employee-notes-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 9px;
    }

    .employee-notes-workspace {
        display: grid;
        grid-template-columns: minmax(220px, 28%) minmax(0, 1fr);
        min-height: 0;
        height: 70dvh;
        grid-template-rows: minmax(0, 1fr);
        overflow: hidden;
        border: 1px solid var(--notes-border);
        border-radius: 22px;
        background: var(--notes-bg);
        box-shadow: 0 12px 30px var(--pt-shadow, rgba(15, 47, 64, .08));
    }

    .employee-notes-sidebar {
        min-width: 0;
        min-height: 0;
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--notes-border);
        background: var(--notes-soft);
    }

    .employee-notes-sidebar-head {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-height: 76px;
        padding: 16px 18px;
        border-bottom: 1px solid var(--notes-border);
    }

    .employee-notes-sidebar-head h2 {
        margin: 0;
        color: var(--notes-text);
        font-size: 1.05rem;
        font-weight: 750;
    }

    .employee-notes-count {
        color: var(--notes-muted);
        font-size: .8rem;
    }

    .employee-note-add {
        width: 42px;
        height: 42px;
        display: inline-grid;
        place-items: center;
        padding: 0;
        border: 1px solid var(--notes-accent);
        border-radius: 50%;
        background: var(--notes-bg);
        color: var(--notes-accent);
        font-size: 1.55rem;
        line-height: 1;
    }

    .employee-note-add svg {
        display: block;
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
    }

    #employeeEmojiOpen { display: inline-grid; place-items: center; width: 37px; padding: 0; }
    .employee-emoji-plus { position: relative; display: block; width: 18px; height: 18px; }
    .employee-emoji-plus::before, .employee-emoji-plus::after {
        content: ""; position: absolute; top: 50%; left: 50%;
        transform: translate(-50%, -50%); border-radius: 1px;
        background: var(--notes-text, #102f35) !important;
    }
    .employee-emoji-plus::before { width: 18px; height: 2px; }
    .employee-emoji-plus::after { width: 2px; height: 18px; }

    .employee-notes-list {
        min-height: 0;
        flex: 1;
        overflow: auto;
        padding: 12px;
    }

    .employee-note-link {
        display: block;
        margin-bottom: 8px;
        padding: 14px 15px;
        border: 1px solid transparent;
        border-radius: 14px;
        color: var(--notes-text);
        text-decoration: none;
        transition: background-color .15s ease, border-color .15s ease, transform .15s ease;
    }

    .employee-note-link:hover {
        border-color: var(--notes-border);
        background: var(--notes-bg);
        color: var(--notes-text);
        transform: translateY(-1px);
    }

    .employee-note-link.is-active {
        border-color: var(--notes-accent);
        background: var(--notes-bg);
        box-shadow: inset 4px 0 0 var(--notes-accent);
    }

    .employee-note-pin-icon {
        display: inline-block;
        width: 17px;
        height: 17px;
        vertical-align: -3px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .employee-note-pinned-marker { color: var(--notes-accent); margin-right: 5px; }

    .employee-note-list-title {
        display: block;
        overflow: hidden;
        color: var(--notes-text);
        font-size: .98rem;
        font-weight: 720;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .employee-note-list-preview {
        display: -webkit-box;
        overflow: hidden;
        margin-top: 5px;
        color: var(--notes-muted);
        font-size: .82rem;
        line-height: 1.4;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .employee-note-list-date {
        display: block;
        margin-top: 8px;
        color: var(--notes-muted);
        font-size: .72rem;
    }

    .employee-notes-empty-list,
    .employee-note-empty-editor {
        display: grid;
        place-items: center;
        min-height: 260px;
        padding: 32px;
        color: var(--notes-muted);
        text-align: center;
    }

    .employee-note-editor {
        min-width: 0;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: var(--notes-bg);
    }

    .employee-note-toolbar {
        flex-shrink: 0;
        max-height: 45%;
        overflow-y: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-height: 76px;
        padding: 13px 20px;
        border-bottom: 1px solid var(--notes-border);
        background: var(--notes-bg);
    }

    .employee-note-toolbar-left,
    .employee-note-toolbar-right {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .employee-note-toolbar-left { min-width: 0; flex: 1; }
    .employee-emoji-collapse { width: 100%; }
    .employee-emoji-collapse summary { width: fit-content; cursor: pointer; padding: 8px 10px; border: 1px solid var(--notes-border); border-radius: 10px; color: var(--notes-text); background: var(--notes-soft); font-size: .9rem; }
    .employee-emoji-collapse summary:focus-visible { outline: 2px solid var(--notes-accent); outline-offset: 2px; }
    .employee-emoji-collapse-hint::after { content: "แสดง"; font-size: .8rem; color: var(--notes-muted); margin-left: 6px; }
    .employee-emoji-collapse[open] .employee-emoji-collapse-hint::after { content: "ซ่อน"; }
    .employee-emoji-quick { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding-top: 10px; }

    .employee-emoji-dialog {
        width: min(560px, calc(100vw - 32px)); max-height: 80dvh;
        padding: 0; border: 1px solid var(--notes-border); border-radius: 18px;
        background: var(--notes-bg); color: var(--notes-text);
        box-shadow: 0 20px 60px var(--pt-shadow, rgba(0,0,0,.25)); overflow: hidden;
    }
    .employee-emoji-dialog[open] { display: flex; flex-direction: column; }
    .employee-emoji-dialog::backdrop { background: rgba(0,0,0,.4); }
    .employee-emoji-dialog-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 18px; border-bottom: 1px solid var(--notes-border); }
    .employee-emoji-dialog-head h2 { margin: 0; font-size: 1.1rem; }
    .employee-note-help-button { padding: 8px 10px; border: 1px solid var(--notes-border); border-radius: 10px; color: var(--notes-text); background: var(--notes-soft); font-size: .9rem; }
    .employee-note-help-body { padding: 16px 18px; min-height: 0; overflow-y: auto; overflow-wrap: anywhere; }
    .employee-note-help-body h3 { font-size: 1rem; margin: 16px 0 10px; }
    .employee-note-shortcuts { margin: 0; }
    .employee-note-shortcuts dt { margin-top: 12px; }
    .employee-note-shortcuts dd { margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 4px 14px; color: var(--notes-muted); }
    .employee-emoji-categories {
        min-height: 0;
        overflow-y: auto;
        padding: 12px;
        border: 1px solid var(--notes-border);
        border-radius: 12px;
        background: var(--notes-soft);
    }
    .employee-emoji-category + .employee-emoji-category { margin-top: 12px; }
    .employee-emoji-category h3 {
        margin: 0 0 8px;
        font-size: .85rem;
        color: var(--notes-text);
    }
    .employee-emoji-grid { display: flex; flex-wrap: wrap; gap: 6px; }

    .employee-emoji-button {
        min-width: 37px;
        height: 37px;
        padding: 0 8px;
        border: 1px solid var(--notes-border);
        border-radius: 10px;
        background: var(--notes-soft);
        font-size: 1.15rem;
    }

    .employee-emoji-item { position: relative; display: inline-flex; }
    .employee-emoji-remove { position: absolute; top: -6px; right: -5px; display: grid; place-items: center; width: 20px; height: 20px; padding: 0; border: 1px solid var(--notes-border); border-radius: 50%; background: var(--notes-bg); color: var(--notes-text); font-size: 14px; line-height: 1; }
    .employee-emoji-remove:hover { color: #b91c1c; border-color: #b91c1c; }
    .employee-emoji-quick { row-gap: 14px; }

    .employee-emoji-button:hover {
        border-color: var(--notes-accent);
        background: var(--notes-bg);
    }

    .employee-note-form {
        display: flex;
        flex: 1;
        flex-direction: column;
        min-height: 0;
        padding: 24px clamp(20px, 4vw, 48px) 18px;
    }

    .employee-note-title {
        flex-shrink: 0;
        width: 100%;
        padding: 0 0 16px;
        border: 0;
        border-bottom: 1px solid var(--notes-border);
        outline: none;
        background: transparent;
        color: var(--notes-text);
        font-size: clamp(1.35rem, 2vw, 1.75rem);
        font-weight: 720;
    }

    .employee-note-content {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        width: 100%;
        min-height: 0;
        height: 0;
        flex: 1;
        resize: none;
        overflow-y: auto;
        padding: 22px 0;
        border: 0;
        outline: none;
        background: transparent;
        color: var(--notes-text);
        font-size: 1rem;
        font-weight: 430;
        line-height: 1.75;
    }

    .employee-note-title:disabled,
    .employee-note-content:disabled {
        opacity: 1;
        -webkit-text-fill-color: var(--notes-text);
    }

    .employee-note-meta {
        flex-shrink: 0;
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding-top: 12px;
        border-top: 1px solid var(--notes-border);
        color: var(--notes-muted);
        font-size: .78rem;
    }

    @@media (min-width: 1200px) {
        html:has(.employee-notes-page), body:has(.employee-notes-page) { height: 100%; overflow: hidden; }
        body:has(.employee-notes-page) .v2-page { height: 100dvh; min-height: 0; padding-bottom: 12px; overflow: hidden; }
        body:has(.employee-notes-page) .v2-page > .container,
        body:has(.employee-notes-page) main.route-controller-employeedocuments.route-action-notes { height: 100%; min-height: 0; }
        body:has(.employee-notes-page) .footer-modern { display: none; }
        .employee-notes-page { height: 100%; min-height: 0; display: flex; flex-direction: column; }
        .employee-notes-hero { flex-shrink: 0; max-height: 30dvh; overflow: auto; }
        .employee-notes-page > .alert { flex-shrink: 0; }
        .employee-notes-workspace { flex: 1; height: auto; }
    }

    @@media (max-width: 1199.98px) {
        .employee-notes-hero { align-items: flex-start; flex-direction: column; }
        .employee-notes-actions { justify-content: flex-start; }
        .employee-notes-workspace { grid-template-columns: 1fr; grid-template-rows: auto auto; height: auto; min-height: 0; }
        .employee-note-content { height: 60dvh; min-height: 300px; flex: none; }
        .employee-note-toolbar { max-height: none; }
        .employee-notes-sidebar { border-right: 0; border-bottom: 1px solid var(--notes-border); }
        .employee-notes-list { display: flex; flex: none; max-height: 190px; overflow-x: auto; overflow-y: hidden; gap: 10px; }
        .employee-note-link { flex: 0 0 240px; min-width: 0; margin: 0; }
        .employee-note-toolbar { align-items: flex-start; flex-direction: column; }
    }

    .employee-notes-page { min-width: 0; max-width: 100%; }
    .employee-notes-hero > div { min-width: 0; }
    .employee-notes-hero h1 { overflow-wrap: anywhere; white-space: normal; }
    .employee-note-toolbar-right { min-width: 0; }
    .employee-note-toolbar-right form { margin: 0; min-width: 0; }
    .employee-note-meta span { min-width: 0; overflow-wrap: anywhere; }
    .employee-note-content { overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
    @@media (max-width: 1199.98px) {
        .employee-note-toolbar { gap: 12px; padding: 14px 18px; }
        .employee-note-toolbar-left, .employee-note-toolbar-right { width: 100%; }
        .employee-note-toolbar-right { justify-content: flex-end; }
        .employee-note-form { padding: 18px 22px; }
        .employee-note-meta { flex-wrap: wrap; gap: 6px 16px; }
    }
    @@media (max-width: 575.98px) {
        .employee-notes-page { padding-left: 0 !important; padding-right: 0 !important; }
        .employee-notes-hero { padding: 16px; gap: 14px; border-radius: 16px; margin-bottom: 12px; }
        .employee-notes-hero h1 { font-size: 1.3rem; line-height: 1.5; }
        .employee-notes-subtitle { font-size: .85rem; }
        .employee-notes-actions { width: 100%; gap: 8px; }
        .employee-notes-actions .btn { flex: 1 1 120px; min-height: 42px; font-size: .85rem; }
        .employee-notes-workspace { border-radius: 16px; }
        .employee-notes-sidebar-head { min-height: 60px; padding: 10px 14px; }
        .employee-notes-list { padding: 10px; max-height: 155px; }
        .employee-note-link { flex-basis: min(240px, 75vw); padding: 10px 12px; }
        .employee-note-list-title { font-size: .9rem; }
        .employee-note-list-preview { font-size: .78rem; }
        .employee-note-toolbar { padding: 12px; }
        .employee-note-toolbar-left { gap: 6px; }
        .employee-note-toolbar-right { justify-content: stretch; gap: 6px; }
        .employee-note-toolbar-right > .btn, .employee-note-toolbar-right > form { flex: 1 1 80px; }
        .employee-note-toolbar-right .btn { width: 100%; min-height: 44px; padding: 8px 6px; font-size: .82rem; white-space: normal; }
        .employee-note-form { padding: 16px 14px 12px; }
        .employee-note-title { font-size: 1.2rem; padding-bottom: 12px; }
        .employee-note-content { height: 55dvh; min-height: 260px; font-size: 16px; padding: 16px 0; }
        .employee-note-meta { flex-direction: column; font-size: .72rem; gap: 5px; }
        .employee-emoji-dialog { width: calc(100vw - 24px); max-height: 85dvh; }
        .employee-emoji-dialog-head { padding: 12px; }
        .employee-emoji-dialog-head h2 { font-size: 1rem; }
    }

</style>

<div class="container-fluid employee-notes-page px-lg-4 py-3">
    <section class="employee-notes-hero">
        <div>
            <span class="employee-notes-eyebrow">Employee Notes</span>
            <h1>📝 บันทึกของ @Model.Employee.EmpName</h1>
            <p class="employee-notes-subtitle">
                @(string.IsNullOrWhiteSpace(Model.Employee.DisplayPosition) ? "จดบันทึกข้อมูลพนักงาน" : Model.Employee.DisplayPosition)
                @if (!string.IsNullOrWhiteSpace(Model.Employee.Department?.DepartmentName))
                {
                    <span> · @Model.Employee.Department.DepartmentName</span>
                }
            </p>
        </div>
        <div class="employee-notes-actions">
            <a asp-action="Index" asp-route-empId="@Model.Employee.EmpId" class="btn btn-outline-primary">📁 เอกสารพนักงาน</a>
            <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-secondary">กลับไปพนักงาน</a>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div id="employeeNoteSuccess" class="alert alert-success fw-bold employee-note-success-toast" role="status" aria-live="polite" aria-atomic="true">✅ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
    }

    <section class="employee-notes-workspace">
        <aside class="employee-notes-sidebar">
            <div class="employee-notes-sidebar-head">
                <div>
                    <h2>รายการบันทึก</h2>
                    <span class="employee-notes-count">@Model.Notes.Count รายการ</span>
                </div>
                @if (canEdit)
                {
                    <form asp-action="CreateNote" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="empId" value="@Model.Employee.EmpId" />
                        <button type="submit" class="employee-note-add" title="เพิ่มบันทึกใหม่" aria-label="เพิ่มบันทึกใหม่"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
                    </form>
                }
            </div>

            <div class="employee-notes-list">
                @if (Model.Notes.Count == 0)
                {
                    <div class="employee-notes-empty-list">
                        <div>
                            <div style="font-size:2.25rem">🗒️</div>
                            <strong>ยังไม่มีบันทึก</strong>
                            <div class="mt-1">@(canEdit ? "กดปุ่ม + เพื่อเพิ่มบันทึกแรก" : "ยังไม่มีบันทึกสำหรับพนักงานนี้")</div>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var note in Model.Notes)
                    {
                        var isActive = Model.SelectedNote?.EmployeeNoteId == note.EmployeeNoteId;
                        <a asp-action="Notes"
                           asp-route-empId="@Model.Employee.EmpId"
                           asp-route-noteId="@note.EmployeeNoteId"
                           class="employee-note-link @(isActive ? "is-active" : string.Empty)">
                            <span class="employee-note-list-title">@if (note.IsPinned) { <span class="employee-note-pinned-marker" title="ปักหมุดแล้ว" role="img" aria-label="ปักหมุดแล้ว"><svg class="employee-note-pin-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 9l3 3v2H5v-2l3-3V3h8v6ZM12 14v7M7 3h10" /></svg></span> }@note.Title</span>
                            <span class="employee-note-list-preview">@NotePreview(note.Content, note.IsRichText)</span>
                            <span class="employee-note-list-date">แก้ไข @note.UpdatedAt.ToString("dd MMM yyyy HH:mm", thaiCulture)</span>
                        </a>
                    }
                }
            </div>
        </aside>

        <main class="employee-note-editor">
            @if (Model.SelectedNote == null)
            {
                <div class="employee-note-empty-editor">
                    <div>
                        <div style="font-size:3rem">✍️</div>
                        <h3 class="mt-3">เลือกหรือเพิ่มบันทึก</h3>
                        <p class="mb-0">บันทึกข้อความและ Emoji แยกตามพนักงานได้จากหน้าจอนี้</p>
                    </div>
                </div>
            }
            else
            {
                <div class="employee-note-toolbar">
                    <div class="employee-note-toolbar-left" aria-label="เลือก Emoji">
                        <details class="employee-emoji-collapse">
                            <summary>😀 Emoji <span class="employee-emoji-collapse-hint" aria-hidden="true"></span></summary>
                            <div class="employee-emoji-quick" data-user-id="@Context.Session.GetInt32("UserId")">
                                @foreach (var emoji in new[] { "😀", "😊", "👍", "✅", "⭐", "📌", "📅", "💡", "🎯", "❤️" })
                                {
                                    <button type="button" class="employee-emoji-button" data-emoji="@emoji" title="เพิ่ม @emoji" disabled="@editorDisabled">@emoji</button>
                                }
                                @if (canEdit)
                                {
                                    <button type="button" id="employeeEmojiOpen" class="employee-emoji-button" title="เพิ่ม Emoji ในแถบใช้งานด่วน" aria-label="เพิ่ม Emoji ในแถบใช้งานด่วน" aria-haspopup="dialog" aria-controls="employeeEmojiDialog"><span class="employee-emoji-plus" aria-hidden="true"></span></button>
                                }
                            </div>
                        </details>
                        <button type="button" id="employeeNoteHelpOpen" class="employee-note-help-button" aria-haspopup="dialog" aria-controls="employeeNoteHelpDialog">⌨ วิธีใช้</button>
                    </div>
                    <div class="employee-note-toolbar-right">
                        @if (canEdit)
                        {
                            <button type="submit" form="employeeNoteSaveForm" class="btn btn-primary">💾 บันทึก</button>
                            <form asp-action="SetNotePinned" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="empId" value="@Model.Employee.EmpId" />
                                <input type="hidden" name="employeeNoteId" value="@Model.SelectedNote.EmployeeNoteId" />
                                <input type="hidden" name="isPinned" value="@(!Model.SelectedNote.IsPinned ? "true" : "false")" />
                                <button type="submit" class="btn btn-outline-secondary">
                                    <svg class="employee-note-pin-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 9l3 3v2H5v-2l3-3V3h8v6ZM12 14v7M7 3h10" />@if (Model.SelectedNote.IsPinned) { <path d="M3 3l18 18" /> }</svg>
                                    @(Model.SelectedNote.IsPinned ? "เลิกปักหมุด" : "ปักหมุด")
                                </button>
                            </form>
                        }
                        @if (canDelete)
                        {
                            <form asp-action="DeleteNote" method="post" onsubmit="return confirm('ลบบันทึกนี้หรือไม่?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="empId" value="@Model.Employee.EmpId" />
                                <input type="hidden" name="employeeNoteId" value="@Model.SelectedNote.EmployeeNoteId" />
                                <button type="submit" class="btn btn-outline-danger">🗑 ลบ</button>
                            </form>
                        }
                    </div>
                </div>

                <form id="employeeNoteSaveForm" asp-action="SaveNote" method="post" class="employee-note-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="empId" value="@Model.Employee.EmpId" />
                    <input type="hidden" name="employeeNoteId" value="@Model.SelectedNote.EmployeeNoteId" />
                    <input id="employeeNoteTitle"
                           name="title"
                           value="@Model.SelectedNote.Title"
                           class="employee-note-title"
                           maxlength="255"
                           placeholder="หัวข้อบันทึก"
                           aria-label="หัวข้อบันทึก"
                           disabled="@editorDisabled" />
                    <input type="hidden" name="isRichText" value="true" />
                    <input type="hidden" id="employeeNoteContent" name="content" value="@(ProjectTracking.Services.EmployeeNoteRichText.Normalize(Model.SelectedNote.IsRichText ? Model.SelectedNote.Content : "") ?? ProjectTracking.Services.EmployeeNoteRichText.FromPlainText(Model.SelectedNote.IsRichText ? ProjectTracking.Services.EmployeeNoteRichText.PlainText(Model.SelectedNote.Content) : Model.SelectedNote.Content))" disabled="@editorDisabled" />
                    <div id="employeeNoteRichEditor" class="employee-note-content" contenteditable="@(canEdit ? "true" : "false")" role="textbox" aria-multiline="true" aria-readonly="@(canEdit ? "false" : "true")" aria-label="รายละเอียดบันทึก" title="Ctrl/⌘ + B ตัวหนา · I เอียง · U ขีดเส้นใต้ · Alt+B ตัวปกติ · Alt+H ไฮไลท์ · Alt+C สีตัวอักษร · Alt+S ขนาด · S บันทึก">@Html.Raw(ProjectTracking.Services.EmployeeNoteRichText.ToHtml(Model.SelectedNote.Content, Model.SelectedNote.IsRichText))</div>
                    <div class="employee-note-meta">
                        <span>สร้างโดย @(string.IsNullOrWhiteSpace(Model.SelectedNote.CreatedBy) ? "-" : Model.SelectedNote.CreatedBy) · @Model.SelectedNote.CreatedAt.ToString("dd MMM yyyy HH:mm", thaiCulture)</span>
                        <span>แก้ไขล่าสุดโดย @(string.IsNullOrWhiteSpace(Model.SelectedNote.UpdatedBy) ? "-" : Model.SelectedNote.UpdatedBy) · @Model.SelectedNote.UpdatedAt.ToString("dd MMM yyyy HH:mm", thaiCulture)</span>
                    </div>
                </form>
            }
        </main>
    </section>
    @if (Model.SelectedNote != null)
    {
        <dialog id="employeeNoteHelpDialog" class="employee-emoji-dialog" aria-labelledby="employeeNoteHelpHeading">
            <div class="employee-emoji-dialog-head">
                <h2 id="employeeNoteHelpHeading">วิธีใช้บันทึกและอีโมจิ</h2>
                <button type="button" id="employeeNoteHelpClose" class="btn btn-outline-secondary" aria-label="ปิดวิธีใช้">ปิด</button>
            </div>
            <div class="employee-note-help-body">
                <p>เลือกข้อความในพื้นที่บันทึกก่อนใช้คีย์ลัดจัดรูปแบบ บน Mac ปุ่ม <strong>⌥ Option คือ Alt</strong> และ <strong>⌘ คือ Command</strong></p>
                <dl class="employee-note-shortcuts">
                    @foreach (var shortcut in new[] {
                        ("ตัวหนา", "Ctrl + B", "⌘ + B"),
                        ("ตัวปกติ / เอาตัวหนาออก", "Ctrl + Alt + B", "⌘ + ⌥ + B"),
                        ("ตัวเอียง", "Ctrl + I", "⌘ + I"),
                        ("ขีดเส้นใต้", "Ctrl + U", "⌘ + U"),
                        ("สีไฮไลท์", "Ctrl + Alt + H", "⌘ + ⌥ + H"),
                        ("สีตัวอักษร", "Ctrl + Alt + C", "⌘ + ⌥ + C"),
                        ("ขนาดตัวอักษร", "Ctrl + Alt + S", "⌘ + ⌥ + S"),
                        ("บันทึก", "Ctrl + S", "⌘ + S") })
                    {
                        <dt>@shortcut.Item1</dt>
                        <dd><span>Windows: @shortcut.Item2</span><span>Mac: @shortcut.Item3</span></dd>
                    }
                </dl>
                <p class="mt-3">กรอกสีเป็นรหัส 6 หลัก เช่น #e53935 หรือ #fff59d หากต้องการลบไฮไลท์ให้พิมพ์ <strong>none</strong> ขนาดตัวอักษรเลือกได้ 12–48 px กดคีย์ลัดตัวหนา ตัวเอียง หรือขีดเส้นใต้ซ้ำเพื่อยกเลิก</p>
                <h3>ยกเลิกไฮไลท์</h3>
                <ol>
                    <li>เลือกข้อความที่มีสีไฮไลท์</li>
                    <li>Mac กด <strong>⌘ + ⌥ + H</strong> หรือ Windows กด <strong>Ctrl + Alt + H</strong></li>
                    <li>พิมพ์ <strong>none</strong> ในช่องสี แล้วกด <strong>ตกลง</strong></li>
                    <li>กด <strong>บันทึก</strong> เพื่อเก็บการเปลี่ยนแปลง</li>
                </ol>
                <h3>เพิ่มและลบอีโมจิ</h3>
                <ul>
                    <li>กด <strong>😀 Emoji</strong> เพื่อแสดงหรือซ่อนแถบอีโมจิ</li>
                    <li>กด <strong>＋</strong> แล้วเลือกอีโมจิเพื่อเพิ่มในแถบใช้งานด่วน</li>
                    <li>วางเคอร์เซอร์ในหัวข้อหรือข้อความ แล้วกดอีโมจิในแถบเพื่อแทรก</li>
                    <li>กด <strong>×</strong> บนอีโมจิเพื่อลบออกจากแถบ ข้อความในโน้ตจะยังอยู่</li>
                </ul>
                <p class="mb-0">รายการอีโมจิจะแยกตามผู้ใช้ในเบราว์เซอร์นี้ และต้องกดบันทึกเพื่อเก็บข้อความกับรูปแบบของโน้ต</p>
            </div>
        </dialog>
    }
    @if (canEdit && Model.SelectedNote != null)
    {
        <dialog id="employeeEmojiDialog" class="employee-emoji-dialog" aria-labelledby="employeeEmojiHeading">
            <div class="employee-emoji-dialog-head">
                <h2 id="employeeEmojiHeading">เพิ่ม Emoji ในแถบใช้งานด่วน</h2>
                <button type="button" id="employeeEmojiClose" class="btn btn-sm btn-outline-secondary" aria-label="ปิดตัวเลือก Emoji">ปิด ✕</button>
            </div>
            <div class="employee-emoji-categories">
                @foreach (var group in emojiGroups)
                {
                    <section class="employee-emoji-category">
                        <h3>@group.Name</h3>
                        <div class="employee-emoji-grid">
                            @foreach (var emoji in group.Emojis)
                            {
                                <button type="button" class="employee-emoji-button" data-emoji="@emoji" title="เพิ่ม @emoji" aria-label="เพิ่ม Emoji @emoji">@emoji</button>
                            }
                        </div>
                    </section>
                }
            </div>
        </dialog>
    }
</div>

<script src="~/js/employee-note-editor.js" asp-append-version="true"></script>
<script>
    (() => {
        const successMessage = document.getElementById('employeeNoteSuccess');
        if (successMessage) setTimeout(() => {
            successMessage.classList.add('is-hiding');
            setTimeout(() => successMessage.remove(), 300);
        }, 3000);
        const title = document.getElementById('employeeNoteTitle');
        const content = document.getElementById('employeeNoteContent');
        const form = document.getElementById('employeeNoteSaveForm');
        const originalTitle = title?.value;
        const originalContent = content?.value;
        let saving = false;
        let leavingConfirmed = false;
        const hasChanges = () => !saving && title && !title.disabled &&
            (title.value !== originalTitle || content.value !== originalContent);
        const confirmLeaving = () => {
            if (!hasChanges()) return true;
            if (!window.confirm('คุณมีข้อความที่ยังไม่ได้บันทึก หากออกจากหน้านี้ ข้อความที่แก้ไขจะหายไป\n\nต้องการออกจากหน้านี้โดยไม่บันทึกหรือไม่?')) return false;
            leavingConfirmed = true;
            // ยกเว้นคำเตือนซ้ำเฉพาะการเปลี่ยนหน้าครั้งนี้
            setTimeout(() => leavingConfirmed = false, 0);
            return true;
        };
        document.addEventListener('click', event => {
            if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
            const link = event.target.closest('a[href]');
            if (!link || link.hasAttribute('download')) return;
            const target = link.getAttribute('target');
            if (target && target.toLowerCase() !== '_self') return;
            const url = new URL(link.href, window.location.href);
            if (!['http:', 'https:'].includes(url.protocol)) return;
            if (url.origin === location.origin && url.pathname === location.pathname &&
                url.search === location.search && url.hash) return;
            if (!confirmLeaving()) {
                event.preventDefault();
                event.stopImmediatePropagation();
            }
        });
        document.addEventListener('submit', event => {
            if (event.defaultPrevented || event.target === form) return;
            const target = event.target.getAttribute('target');
            if (target && target.toLowerCase() !== '_self') return;
            if (!confirmLeaving()) {
                event.preventDefault();
                event.stopImmediatePropagation();
            }
        });
        form?.addEventListener('submit', () => saving = true);
        window.addEventListener('beforeunload', event => {
            if (leavingConfirmed || !hasChanges()) return;
            event.preventDefault();
            event.returnValue = '';
        });
        const emojiDialog = document.getElementById('employeeEmojiDialog');
        const helpDialog = document.getElementById('employeeNoteHelpDialog');
        document.getElementById('employeeNoteHelpOpen')?.addEventListener('click', () => helpDialog?.showModal());
        document.getElementById('employeeNoteHelpClose')?.addEventListener('click', () => helpDialog?.close());
        helpDialog?.addEventListener('click', event => {
            if (event.target !== helpDialog) return;
            const bounds = helpDialog.getBoundingClientRect();
            if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) helpDialog.close();
        });
        document.getElementById('employeeEmojiOpen')?.addEventListener('click', () => emojiDialog?.showModal());
        document.getElementById('employeeEmojiClose')?.addEventListener('click', () => emojiDialog?.close());
        emojiDialog?.addEventListener('click', event => {
            if (event.target !== emojiDialog) return;
            const bounds = emojiDialog.getBoundingClientRect();
            if (event.clientX < bounds.left || event.clientX > bounds.right ||
                event.clientY < bounds.top || event.clientY > bounds.bottom) emojiDialog.close();
        });
        let target = content || title;

        [title, content].forEach(input => {
            if (!input) return;
            input.addEventListener('focus', () => target = input);
        });
        document.getElementById('employeeNoteRichEditor')?.addEventListener('focus', () => target = content);

        const quick = document.querySelector('.employee-emoji-quick');
        const addButton = document.getElementById('employeeEmojiOpen');
        const initialEmojis = [...(quick?.querySelectorAll('[data-emoji]') || [])].map(button => button.dataset.emoji);
        const available = new Set([...initialEmojis, ...[...(emojiDialog?.querySelectorAll('[data-emoji]') || [])].map(button => button.dataset.emoji)]);
        const storageKey = `employee-notes.quick-emojis.${quick?.dataset.userId || 'guest'}`;
        let emojis = initialEmojis;
        if (quick && addButton) {
            try {
                const saved = JSON.parse(localStorage.getItem(storageKey));
                if (Array.isArray(saved)) emojis = [...new Set(saved.filter(emoji => available.has(emoji)))];
            } catch { /* Use the default palette when browser storage is unavailable. */ }
        }
        const renderEmojis = () => {
            if (!quick || !addButton) return;
            quick.querySelectorAll('.employee-emoji-item, :scope > [data-emoji]').forEach(item => item.remove());
            emojis.forEach(emoji => {
                const item = document.createElement('span');
                item.className = 'employee-emoji-item';
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'employee-emoji-button';
                button.dataset.emoji = emoji;
                button.textContent = emoji;
                button.title = `แทรก ${emoji} ในโน้ต`;
                button.setAttribute('aria-label', button.title);
                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'employee-emoji-remove';
                remove.dataset.removeEmoji = emoji;
                remove.textContent = '×';
                remove.title = `ลบ ${emoji} ออกจากแถบ`;
                remove.setAttribute('aria-label', remove.title);
                item.append(button, remove);
                quick.insertBefore(item, addButton);
            });
        };
        const saveEmojis = () => {
            try { localStorage.setItem(storageKey, JSON.stringify(emojis)); } catch { /* The palette still works for this page. */ }
            renderEmojis();
        };
        renderEmojis();
        quick?.addEventListener('click', event => {
            const remove = event.target.closest('[data-remove-emoji]');
            if (remove) {
                emojis = emojis.filter(emoji => emoji !== remove.dataset.removeEmoji);
                saveEmojis();
                addButton?.focus({ preventScroll: true });
            }
        });
        document.addEventListener('click', event => {
            const button = event.target.closest('.employee-emoji-button[data-emoji]');
            if (!button || button.disabled) return;
            const emoji = button.dataset.emoji;
            if (emojiDialog?.contains(button)) {
                if (!emojis.includes(emoji)) {
                    emojis.push(emoji);
                    saveEmojis();
                }
                emojiDialog.close();
                return;
            }
            if (!quick?.contains(button) || !target || target.disabled) return;
            if (target === content) {
                window.employeeNoteEditor?.insertEmoji(emoji);
                return;
            }
            const start = target.selectionStart ?? target.value.length;
            const end = target.selectionEnd ?? target.value.length;
            if (target.maxLength >= 0 && target.value.length - (end - start) + emoji.length > target.maxLength) return;
            target.setRangeText(emoji, start, end, 'end');
            target.focus();
            target.dispatchEvent(new Event('input', { bubbles: true }));
        });
    })();
</script>

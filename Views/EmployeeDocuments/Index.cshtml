@using Microsoft.AspNetCore.Http
@using System.Linq
@model IEnumerable<ProjectTracking.Models.EmployeeDocument>

@{
    ViewData["Title"] = "เอกสารพนักงาน";
    var selectedEmpId = ViewBag.EmpId is int id ? id : 0;
    var selectedEmployee = ViewBag.SelectedEmployee as ProjectTracking.Models.Employee;
    var employees = ViewBag.Employees as IEnumerable<ProjectTracking.Models.Employee>
        ?? Enumerable.Empty<ProjectTracking.Models.Employee>();
    var documentTypes = ViewBag.DocumentTypes as IEnumerable<ProjectTracking.Models.EmployeeDocumentType>
        ?? Enumerable.Empty<ProjectTracking.Models.EmployeeDocumentType>();
    var searchTerm = ViewBag.SearchTerm as string ?? string.Empty;
    var documentTypeNames = documentTypes.ToDictionary(
        x => x.DocumentTypeCode.Trim(),
        x => x.DocumentTypeName,
        StringComparer.OrdinalIgnoreCase);

    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? string.Empty).Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? string.Empty;
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }

    string DocumentTypeName(string? code)
    {
        var normalized = (code ?? string.Empty).Trim();
        return documentTypeNames.TryGetValue(normalized, out var name) ? name : normalized;
    }
}

<style>
    .employee-documents-page,
    .employee-documents-page * {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans Thai", "Leelawadee UI", Tahoma, Arial, sans-serif !important;
        letter-spacing: 0 !important;
        text-shadow: none !important;
        text-rendering: geometricPrecision !important;
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
    }

    .employee-doc-select-card {
        position: relative;
        z-index: 10;
        overflow: visible;
        margin-bottom: 28px !important;
    }

    .employee-doc-upload-card {
        position: relative;
        z-index: 1;
    }

    .employee-doc-select-card .form-select { min-height: 54px; }

    .employee-doc-selected-note {
        margin-top: 10px;
        color: #526579;
        font-size: .95rem;
        font-weight: 600;
    }

    .employee-doc-selected-note strong { color: #0f2f40; }

    .employee-doc-type {
        color: #0f766e;
        font-size: .92rem;
        font-weight: 700 !important;
        line-height: 1.35;
    }

    .employee-doc-file-name {
        color: #10233f;
        font-size: .98rem;
        font-weight: 650 !important;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .employee-doc-uploaded {
        color: #64748b;
        font-size: .82rem;
        font-weight: 500 !important;
        line-height: 1.35;
        margin-top: 4px;
    }

    .employee-doc-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
    }

    .employee-doc-search { margin-top: 14px; }
    .employee-doc-search .form-control { min-height: 44px; }
</style>

<div class="container employee-documents-page">
    <div class="index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="index-title">เอกสารพนักงาน</h2>
            <p class="index-subtitle">อัปโหลดและจัดเก็บเอกสารแยกตามพนักงาน</p>
        </div>
        <div class="index-actions">
            <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-light">กลับไปพนักงาน</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
    }

    <div class="card employee-doc-select-card">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <input type="hidden" name="q" value="@searchTerm" />
                <label class="form-label fw-bold" for="employeeDocumentEmployee">👤 พนักงาน</label>
                <select id="employeeDocumentEmployee" name="empId" class="form-select form-select-lg" onchange="this.form.submit()">
                    <option value="">-- เลือกพนักงาน --</option>
                    @foreach (var employee in employees)
                    {
                        <option value="@employee.EmpId" selected="@(selectedEmpId == employee.EmpId ? "selected" : null)">
                            @employee.EmpName@(string.IsNullOrWhiteSpace(employee.DisplayPosition) ? string.Empty : $" ({employee.DisplayPosition})")
                        </option>
                    }
                </select>
            </form>

            @if (selectedEmployee != null)
            {
                <div class="employee-doc-selected-note">
                    กำลังจัดการเอกสารของ <strong>@selectedEmployee.EmpName</strong>
                    @if (!string.IsNullOrWhiteSpace(selectedEmployee.DisplayPosition))
                    {
                        <span> · @selectedEmployee.DisplayPosition</span>
                    }
                </div>

                <form method="get" asp-action="Index" class="employee-doc-search">
                    <input type="hidden" name="empId" value="@selectedEmpId" />
                    <label class="form-label fw-bold" for="employeeDocumentSearch">🔎 ค้นหาเอกสาร</label>
                    <div class="input-group">
                        <input id="employeeDocumentSearch"
                               name="q"
                               value="@searchTerm"
                               class="form-control"
                               placeholder="ค้นหาจากชื่อไฟล์ ประเภทเอกสาร หรือผู้อัปโหลด" />
                        <button type="submit" class="btn btn-primary">ค้นหา</button>
                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <a asp-action="Index" asp-route-empId="@selectedEmpId" class="btn btn-outline-secondary">ล้าง</a>
                        }
                    </div>
                </form>
            }
        </div>
    </div>

    <div class="card mb-4 employee-doc-upload-card">
        <div class="card-header fw-bold">อัปโหลดเอกสาร</div>
        <div class="card-body">
            @if (selectedEmpId <= 0)
            {
                <div class="alert alert-info mb-0 fw-bold">กรุณาเลือกพนักงานก่อนอัปโหลดเอกสาร</div>
            }
            else if (CanMenu("EmployeeDocuments.Upload"))
            {
                <form asp-action="Upload" method="post" enctype="multipart/form-data" onsubmit="return confirm('อัปโหลดไฟล์นี้หรือไม่?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="empId" value="@selectedEmpId" />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label" for="employeeDocumentType">ประเภทเอกสาร</label>
                            <select id="employeeDocumentType" name="documentType" class="form-select" required>
                                <option value="" selected disabled>-- เลือกประเภทเอกสาร --</option>
                                @foreach (var documentType in documentTypes)
                                {
                                    <option value="@documentType.DocumentTypeCode">@documentType.DocumentTypeName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="employeeDocumentFile">ไฟล์</label>
                            <input id="employeeDocumentFile" type="file" name="file" class="form-control" required />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">⬆ อัปโหลด</button>
                        </div>
                    </div>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-primary w-100" disabled title="ไม่มีสิทธิ์อัปโหลดเอกสาร">⬆ อัปโหลด</button>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-bold">
            รายการเอกสาร
            @if (selectedEmpId > 0 && !string.IsNullOrWhiteSpace(searchTerm))
            {
                <span class="text-muted fw-normal">· ผลการค้นหา “@searchTerm” (@Model.Count() รายการ)</span>
            }
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:80px">ลำดับ</th>
                            <th style="width:200px">ประเภทเอกสาร</th>
                            <th>ชื่อไฟล์</th>
                            <th style="width:320px" class="text-center">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (selectedEmpId <= 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">กรุณาเลือกพนักงานเพื่อดูเอกสาร</td></tr>
                        }
                        else if (!Model.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">@(string.IsNullOrWhiteSpace(searchTerm) ? "ยังไม่มีเอกสารของพนักงานคนนี้" : "ไม่พบเอกสารที่ค้นหา")</td></tr>
                        }
                        else
                        {
                            var sequence = 1;
                            foreach (var document in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-center">@sequence</td>
                                    <td><span class="employee-doc-type">@DocumentTypeName(document.DocumentType)</span></td>
                                    <td>
                                        <div class="employee-doc-file-name">@document.FileName</div>
                                        <div class="employee-doc-uploaded">อัปโหลด @document.UploadedAt.ToString("dd/MM/yyyy HH:mm")@(!string.IsNullOrWhiteSpace(document.UploadedBy) ? $" · {document.UploadedBy}" : string.Empty)</div>
                                    </td>
                                    <td>
                                        <div class="employee-doc-actions">
                                            @if (CanMenu("EmployeeDocuments.Preview"))
                                            {
                                                <a asp-action="Preview" asp-route-id="@document.EmployeeDocumentId" target="_blank" class="btn btn-sm btn-outline-secondary">👁 ดูไฟล์</a>
                                            }
                                            @if (CanMenu("EmployeeDocuments.Download"))
                                            {
                                                <a asp-action="Download" asp-route-id="@document.EmployeeDocumentId" class="btn btn-sm btn-outline-success">⬇ ดาวน์โหลด</a>
                                            }
                                            @if (CanMenu("EmployeeDocuments.Delete"))
                                            {
                                                <a asp-action="Delete" asp-route-id="@document.EmployeeDocumentId" class="btn btn-sm btn-outline-danger" onclick="return confirm('ยืนยันลบเอกสารนี้?');">🗑 ลบ</a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                sequence++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

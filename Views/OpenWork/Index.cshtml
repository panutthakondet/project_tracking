@model ProjectTracking.ViewModels.OpenIssueSupportPageViewModel

@{
    ViewData["Title"] = "งานทั้งหมดที่ยังไม่เสร็จสิ้น";
    var pageModel = Model ?? new ProjectTracking.ViewModels.OpenIssueSupportPageViewModel();
    var totalWorkTypeCount = pageModel.WorkTypeOptions.Sum(option => option.Count);

    string SeverityText(string severity) => (severity ?? "").Trim().ToLowerInvariant() switch
    {
        "danger" => "ล่าช้าเลยกำหนด",
        "warning" => "เสี่ยงล่าช้า",
        _ => "ปกติ"
    };

    string RemainingDaysText(DateTime? dueDate)
    {
        if (!dueDate.HasValue)
            return "ยังไม่กำหนด";

        var days = (dueDate.Value.Date - DateTime.Today).Days;
        if (days < 0)
            return $"เลยกำหนด {Math.Abs(days)} วัน";

        return days == 0 ? "ครบกำหนดวันนี้" : $"เหลือ {days} วัน";
    }

    string TextTone(string? value) => (value ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "danger",
        "URGENT" => "danger",
        "HIGH" => "danger",
        "TODO" => "muted",
        "WIP" => "warning",
        "IN PROGRESS" => "warning",
        "IN_PROGRESS" => "warning",
        "WAIT TEST" => "info",
        "WAIT_TEST" => "info",
        "MEDIUM" => "warning",
        "LOW" => "success",
        "DONE" => "success",
        "FIXED" => "success",
        "PASS" => "success",
        "REJECT" => "muted",
        "RESOLVED" => "success",
        _ => "muted"
    };
}

<style>
    .open-work-page {
        padding: 4px 0 28px;
    }

    .open-work-hero {
        background: linear-gradient(135deg, #10284a, #0f766e);
    }
    .open-work-actions {
        justify-content: flex-end !important;
    }

    .open-work-filter {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 14px;
        margin: 0 0 18px;
        padding: 14px 16px;
        background: rgba(255, 255, 255, .82);
        border: 1px solid #dbe6f3;
        border-radius: 18px;
        box-shadow: 0 12px 26px rgba(15, 40, 74, .07);
    }

    .open-work-filter-field {
        display: grid;
        gap: 7px;
        width: min(360px, 100%);
    }

    .open-work-filter label {
        color: #10223e;
        font-size: .92rem;
        font-weight: 900;
    }

    .open-work-filter select {
        width: 100%;
        min-height: 44px;
        color: #10223e;
        background: #fff;
        border: 1px solid #cbd8ea;
        border-radius: 12px;
        padding: 0 38px 0 12px;
        font-weight: 800;
        outline: none;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .9);
    }

    .open-work-filter select:focus {
        border-color: #22c7b8;
        box-shadow: 0 0 0 3px rgba(34, 199, 184, .16);
    }

    .open-work-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .open-work-stat {
        background: rgba(255, 255, 255, .82);
        border: 1px solid #dbe6f3;
        border-left: 6px solid #22c7b8;
        border-radius: 20px;
        padding: 16px 18px;
        box-shadow: 0 12px 26px rgba(15, 40, 74, .08);
    }

    .open-work-stat span {
        display: block;
        color: #64748b;
        font-weight: 900;
    }

    .open-work-stat strong {
        display: block;
        color: #10223e;
        font-size: 2rem;
        font-weight: 900;
        line-height: 1;
        margin-top: 6px;
    }

    .open-work-groups {
        display: grid;
        gap: 18px;
    }

    .open-work-group {
        background: rgba(255, 255, 255, .72);
        border: 1px solid #dbe6f3;
        border-radius: 24px;
        padding: 14px;
        box-shadow: 0 14px 30px rgba(15, 40, 74, .08);
    }

    .open-work-group-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 12px;
        padding: 4px 4px 10px;
        border-bottom: 1px solid #e2eaf5;
    }

    .open-work-group-title {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        color: #10223e;
        font-size: 1.22rem;
        font-weight: 900;
    }

    .open-work-group-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 14px;
        color: #fff;
        background: linear-gradient(135deg, #fb3f7a, #e11d48);
        font-weight: 900;
    }

    .open-work-group.support .open-work-group-icon {
        background: linear-gradient(135deg, #f59e0b, #f97316);
    }

    .open-work-group.assign .open-work-group-icon {
        background: linear-gradient(135deg, #2563eb, #0891b2);
    }

    .open-work-group.followup .open-work-group-icon {
        background: linear-gradient(135deg, #16a34a, #0f766e);
    }

    .open-work-group-count {
        color: #64748b;
        font-weight: 900;
    }

    .open-work-coop-groups {
        display: grid;
        gap: 14px;
    }

    .open-work-coop-group {
        background: rgba(248, 250, 252, .76);
        border: 1px solid #e2eaf5;
        border-radius: 20px;
        padding: 12px;
    }

    .open-work-coop-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
        background: linear-gradient(135deg, rgba(20, 184, 166, .14), rgba(59, 130, 246, .10));
        border: 1px solid rgba(20, 184, 166, .22);
        border-radius: 14px;
        padding: 9px 12px;
    }

    .open-work-coop-name {
        min-width: 0;
        color: #0f766e;
        font-weight: 800;
        overflow-wrap: anywhere;
        line-height: 1.3;
    }

    .open-work-coop-count {
        color: #64748b;
        font-size: .92rem;
        white-space: nowrap;
    }

    .open-work-list {
        display: grid;
        gap: 12px;
    }

    .open-work-card {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(220px, auto);
        gap: 14px;
        align-items: start;
        background: #fff;
        border: 1px solid #dbe6f3;
        border-left: 6px solid #22c7b8;
        border-radius: 20px;
        padding: 14px 16px;
        color: #10223e;
        text-decoration: none;
        box-shadow: 0 12px 26px rgba(15, 40, 74, .08);
    }

    .open-work-card.danger {
        border-left-color: #f43f5e;
    }

    .open-work-card.warning {
        border-left-color: #f59e0b;
    }

    .open-work-card:hover {
        color: #10223e;
        transform: translateY(-1px);
        box-shadow: 0 16px 30px rgba(15, 40, 74, .12);
    }

    .open-work-card-main {
        min-width: 0;
    }

    .open-work-card-head {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        min-width: 0;
    }

    .open-work-title {
        margin: 0;
        font-size: 1.08rem;
        font-weight: 900;
        line-height: 1.28;
    }

    .open-work-project {
        margin: 5px 0 0;
        color: #0f172a;
        font-weight: 400;
        line-height: 1.35;
        font-size: .93rem;
    }

    .open-work-label {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.45;
        letter-spacing: 0;
    }

    .open-work-value {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.45;
        letter-spacing: 0;
        overflow-wrap: anywhere;
    }

    .open-work-owner-line {
        margin-top: 5px;
        color: #0f172a;
        font-size: .9rem;
        font-weight: 700;
    }

    .open-work-people {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 18px;
        margin-top: 8px;
        color: #0f172a;
        font-size: .9rem;
        font-weight: 400;
    }

    .open-work-people strong {
        color: #0f172a;
        font-weight: 600;
    }

    .open-work-person {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .open-work-person img {
        width: 28px;
        height: 28px;
        border: 1px solid #dbe6f3;
        border-radius: 50%;
        object-fit: cover;
        background: #fff;
        flex: 0 0 auto;
    }

    .open-work-person span {
        overflow-wrap: anywhere;
    }

    .open-work-side {
        display: grid;
        gap: 7px;
        justify-items: end;
        text-align: right;
    }

    .open-work-date {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.45;
    }

    .open-work-days {
        font-size: .95rem;
        font-weight: 800;
        line-height: 1.35;
    }

    .open-work-days .open-work-value {
        font-weight: 800;
    }

    .open-work-status-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .open-work-status-text,
    .open-work-severity {
        font-size: .9rem;
        font-weight: 600;
        line-height: 1.2;
        white-space: nowrap;
    }

    .open-work-status-text.danger,
    .open-work-severity.danger,
    .open-work-days.danger {
        color: #e11d48;
    }

    .open-work-status-text.warning,
    .open-work-severity.warning,
    .open-work-days.warning {
        color: #ca8a04;
    }

    .open-work-status-text.info {
        color: #0284c7;
    }

    .open-work-status-text.success {
        color: #059669;
    }

    .open-work-status-text.muted,
    .open-work-severity.normal,
    .open-work-days.normal {
        color: #059669;
    }

    .open-work-empty {
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 22px;
        padding: 28px;
        color: #64748b;
        font-weight: 900;
        text-align: center;
        box-shadow: 0 12px 26px rgba(15, 40, 74, .06);
    }

    @@media (max-width: 768px) {
        .open-work-hero {
            padding: 24px;
        }

        .open-work-actions {
            justify-content: flex-end !important;
        }

        .open-work-filter {
            align-items: stretch;
            padding: 12px;
        }

        .open-work-card {
            grid-template-columns: 1fr;
        }

        .open-work-side {
            justify-items: start;
            text-align: left;
        }

        .open-work-status-row {
            justify-content: flex-start;
        }
    }
</style>

<div class="open-work-page">
    <section class="open-work-hero index-hero">
        <div class="index-hero__content">
            <div class="open-work-eyebrow index-eyebrow">ProjectTracking</div>
            <h1 class="index-title">งานทั้งหมดที่ยังไม่เสร็จสิ้น</h1>
            <p class="index-subtitle">
                PhaseAssigns, ProjectIssues, SupportOrders และ Followups แยกตามประเภทงานและสหกรณ์
                <span>ของ @pageModel.CurrentEmployeeName และโครงการที่เป็น BA</span>
            </p>
        </div>
        <div class="open-work-actions index-actions">
            <a class="btn btn-light" asp-controller="Home" asp-action="Index">Dashboard</a>
        </div>
    </section>

    <form class="open-work-filter" method="get" asp-controller="OpenWork" asp-action="Index">
        <div class="open-work-filter-field">
            <label for="workType">ประเภทงาน</label>
            <select id="workType" name="workType" onchange="this.form.submit()">
                @if (string.IsNullOrWhiteSpace(pageModel.SelectedWorkType))
                {
                    <option value="" selected>ทั้งหมด (@totalWorkTypeCount)</option>
                }
                else
                {
                    <option value="">ทั้งหมด (@totalWorkTypeCount)</option>
                }

                @foreach (var option in pageModel.WorkTypeOptions)
                {
                    if (string.Equals(pageModel.SelectedWorkType, option.Value, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@option.Value" selected>@option.Label (@option.Count)</option>
                    }
                    else
                    {
                        <option value="@option.Value">@option.Label (@option.Count)</option>
                    }
                }
            </select>
        </div>
    </form>

    <section class="open-work-summary" aria-label="สรุปงานที่ยังไม่เสร็จสิ้น">
        <div class="open-work-stat">
            <span>รวมทั้งหมด</span>
            <strong>@pageModel.TotalCount</strong>
        </div>
        @foreach (var group in pageModel.Groups)
        {
            <div class="open-work-stat">
                <span>@group.Label</span>
                <strong>@group.TotalCount</strong>
            </div>
        }
    </section>

    @if (pageModel.TotalCount == 0)
    {
        <div class="open-work-empty">ยังไม่มีงานที่ยังไม่เสร็จสิ้น</div>
    }
    else
    {
        <section class="open-work-groups" aria-label="รายการงานที่ยังไม่เสร็จสิ้น">
            @foreach (var group in pageModel.Groups)
            {
                <article class="open-work-group @group.Tone">
                    <div class="open-work-group-header">
                        <h2 class="open-work-group-title">
                            <span class="open-work-group-icon">@group.Icon</span>
                            @group.Label
                        </h2>
                        <span class="open-work-group-count">@group.TotalCount รายการ</span>
                    </div>
                    <div class="open-work-coop-groups">
                        @foreach (var coopGroup in group.CoopGroups)
                        {
                            <section class="open-work-coop-group">
                                <div class="open-work-coop-header">
                                    <span class="open-work-coop-name">@coopGroup.CoopName</span>
                                    <span class="open-work-coop-count">@coopGroup.Items.Count รายการ</span>
                                </div>
                                <div class="open-work-list">
                                    @foreach (var item in coopGroup.Items)
                                    {
                                        <a class="open-work-card @item.Severity" href="@item.TargetUrl">
                                            <div class="open-work-card-main">
                                                <div class="open-work-card-head">
                                                    <div class="min-w-0">
                                                        <h3 class="open-work-title">@item.Title</h3>
                                                        <p class="open-work-project">
                                                            <span class="open-work-label">โครงการ:</span>
                                                            <span class="open-work-value">@item.ProjectName</span>
                                                        </p>
                                                        <div class="open-work-owner-line">
                                                            <span class="open-work-label">ผู้รับผิดชอบ:</span>
                                                            <span class="open-work-value">@item.OwnerName</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="open-work-people">
                                                    <span class="open-work-person">
                                                        <img class="pt-owner-avatar"
                                                             src="@item.OwnerAvatarPath"
                                                             alt="@item.OwnerName"
                                                             loading="lazy"
                                                             onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                                        <span>
                                                            <span class="open-work-label">เจ้าของงาน:</span>
                                                            <span class="open-work-value">@item.OwnerName</span>
                                                        </span>
                                                    </span>
                                                    <span class="open-work-person">
                                                        <img class="pt-owner-avatar"
                                                             src="@item.BaAvatarPath"
                                                             alt="@item.BaName"
                                                             loading="lazy"
                                                             onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                                        <span>
                                                            <span class="open-work-label">BA:</span>
                                                            <span class="open-work-value">@item.BaName</span>
                                                        </span>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="open-work-side">
                                                <div class="open-work-date">
                                                    <span class="open-work-label">กำหนด:</span>
                                                    <span class="open-work-value">@item.DateRangeText</span>
                                                </div>
                                                <div class="open-work-days @item.Severity">
                                                    <span class="open-work-label">จำนวนวัน:</span>
                                                    <span class="open-work-value">@RemainingDaysText(item.DueDate)</span>
                                                </div>
                                                <div class="open-work-status-row">
                                                    <span class="open-work-severity @item.Severity">@SeverityText(item.Severity)</span>
                                                    <span class="open-work-status-text @TextTone(item.StatusText)">@item.StatusText</span>
                                                    @if (!string.IsNullOrWhiteSpace(item.DevStatusText) && item.DevStatusText != "-")
                                                    {
                                                        <span class="open-work-status-text @TextTone(item.DevStatusText)">Dev @item.DevStatusText</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.PriorityText) && item.PriorityText != "-")
                                                    {
                                                        <span class="open-work-status-text @TextTone(item.PriorityText)">@item.PriorityText</span>
                                                    }
                                                </div>
                                            </div>
                                        </a>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                </article>
            }
        </section>
    }
</div>

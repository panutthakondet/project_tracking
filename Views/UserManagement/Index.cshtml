@using System
@using System.Linq
@model IEnumerable<ProjectTracking.Models.LoginUser>

@{
    ViewData["Title"] = "User Management";
}

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">จัดการผู้ใช้งาน</h2>
        <p class="index-subtitle">จัดการผู้ใช้งาน เพิ่ม แก้ไข และกำหนดสิทธิ์</p>
    </div>
    <div class="index-actions">
        <a asp-action="Create" class="btn btn-primary">Create User</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Email Verified</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">ยังไม่มีผู้ใช้งาน</td>
            </tr>
        }
        else
        {
            foreach (var u in Model)
            {
                <tr>
                    <td class="fw-semibold">@u.Username</td>
                    <td>@u.Email</td>
                    <td>
                        <span class="user-role-text @(string.Equals(u.Role, "ADMIN", StringComparison.OrdinalIgnoreCase) ? "is-admin" : "is-user")">
                            @u.Role
                        </span>
                    </td>
                    <td>
                        @if ((u.Status ?? "").Equals("ACTIVE", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="user-status-text is-active">ACTIVE</span>
                        }
                        else
                        {
                            <span class="user-status-text is-inactive">INACTIVE</span>
                        }
                    </td>
                    <td>
                        @if (u.EmailVerified)
                        {
                            <span class="user-verified-text is-verified">YES</span>
                        }
                        else
                        {
                            <span class="user-verified-text is-unverified">NO</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-username="@u.Username" class="btn btn-sm btn-outline-secondary" style="border-radius:12px; font-weight:800; margin-right:6px;">✏️ Edit</a>
                        <a asp-action="Permissions" asp-route-username="@u.Username" class="btn btn-sm btn-outline-primary" style="border-radius:12px; font-weight:800; margin-right:6px;">🔐 Menus</a>

                        <form asp-action="Delete"
                              asp-route-username="@u.Username"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    style="border-radius:12px; font-weight:800;"
                                    onclick="return confirm('ยืนยันการลบผู้ใช้งาน @u.Username ?');">
                                🗑 Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
<style>
    table td {
        word-break: break-word;
    }

    .user-status-text,
    .user-role-text,
    .user-verified-text {
        display: inline;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        font-weight: 900;
        line-height: 1.35;
        white-space: normal;
    }

    .user-role-text.is-admin {
        color: #7c3aed;
    }

    .user-role-text.is-user {
        color: #2563eb;
    }

    .user-status-text.is-active {
        color: #16a34a;
    }

    .user-status-text.is-inactive {
        color: #ef4444;
    }

    .user-verified-text.is-verified {
        color: #16a34a;
    }

    .user-verified-text.is-unverified {
        color: #f59e0b;
    }
</style>

@using System
@using System.Linq
@using ProjectTracking.Models
@model IEnumerable<ProjectTracking.Models.LoginUser>

@{
    ViewData["Title"] = "User Management";
    var departments = ViewBag.ProjectDepartments as IEnumerable<ProjectDepartment>
        ?? Enumerable.Empty<ProjectDepartment>();
    var employeeOptions = ViewBag.EmployeeOptions as IEnumerable<Employee>
        ?? Enumerable.Empty<Employee>();
    var selectedDepartment = ViewBag.SelectedDepartment as string ?? "all";
    var selectedEmployeeId = ViewBag.SelectedEmployeeId as int?;
    var userEmployees = ViewBag.UserEmployees as IReadOnlyDictionary<int, Employee?>
        ?? new Dictionary<int, Employee?>();
}

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">จัดการผู้ใช้งาน</h2>
        <p class="index-subtitle">จัดการผู้ใช้งาน เพิ่ม แก้ไข และกำหนดสิทธิ์</p>
    </div>
    <div class="index-actions">
        <a asp-action="Create" class="btn btn-primary">Create User</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<form asp-action="Index" method="get" class="user-management-filter">
    <div class="user-management-filter__controls">
        <div class="user-management-filter__field">
            <label for="userDepartmentFilter">ฝ่าย</label>
            <select id="userDepartmentFilter"
                    name="department"
                    class="form-select"
                    onchange="document.getElementById('userEmployeeFilter').value=''; this.form.submit()">
                <option value="all" selected="@(selectedDepartment == "all" ? "selected" : null)">ทุกฝ่าย</option>
                @foreach (var department in departments)
                {
                    var departmentValue = department.DepartmentId.ToString();
                    <option value="@departmentValue"
                            selected="@(selectedDepartment == departmentValue ? "selected" : null)">@department.DepartmentName</option>
                }
                <option value="unassigned" selected="@(selectedDepartment == "unassigned" ? "selected" : null)">ยังไม่กำหนดฝ่าย</option>
            </select>
        </div>
        <div class="user-management-filter__field">
            <label for="userEmployeeFilter">พนักงาน</label>
            <select id="userEmployeeFilter"
                    name="employeeId"
                    class="form-select"
                    onchange="this.form.submit()">
                <option value="">พนักงานทั้งหมด</option>
                @foreach (var employee in employeeOptions)
                {
                    <option value="@employee.EmpId"
                            selected="@(selectedEmployeeId == employee.EmpId ? "selected" : null)">@employee.EmpName</option>
                }
            </select>
        </div>
    </div>
    <span class="user-management-filter__count">@Model.Count() บัญชี</span>
</form>

<div class="table-responsive user-management-table-wrap">
    <table class="table table-hover align-middle user-management-table">
        <thead class="table-light">
            <tr>
                <th>Username</th>
                <th>พนักงาน</th>
                <th>ฝ่าย</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Email Verified</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center text-muted py-4">ยังไม่มีผู้ใช้งาน</td>
            </tr>
        }
        else
        {
            foreach (var u in Model)
            {
                userEmployees.TryGetValue(u.UserId, out var employee);
                <tr>
                    <td class="fw-semibold">@u.Username</td>
                    <td>@(employee?.EmpName ?? "ยังไม่ผูกพนักงาน")</td>
                    <td>@(employee?.Department?.DepartmentName ?? "ยังไม่กำหนดฝ่าย")</td>
                    <td>@u.Email</td>
                    <td>
                        <span class="user-role-text @(string.Equals(u.Role, "ADMIN", StringComparison.OrdinalIgnoreCase) ? "is-admin" : "is-user")">
                            @u.Role
                        </span>
                    </td>
                    <td>
                        @if ((u.Status ?? "").Equals("ACTIVE", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="user-status-text is-active">ACTIVE</span>
                        }
                        else
                        {
                            <span class="user-status-text is-inactive">INACTIVE</span>
                        }
                    </td>
                    <td>
                        @if (u.EmailVerified)
                        {
                            <span class="user-verified-text is-verified">YES</span>
                        }
                        else
                        {
                            <span class="user-verified-text is-unverified">NO</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-username="@u.Username" class="btn btn-sm btn-outline-secondary" style="border-radius:12px; font-weight:800; margin-right:6px;">✏️ Edit</a>
                        <a asp-action="Permissions" asp-route-username="@u.Username" class="btn btn-sm btn-outline-primary" style="border-radius:12px; font-weight:800; margin-right:6px;">🔐 Menus</a>

                        <form asp-action="Delete"
                              asp-route-username="@u.Username"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    style="border-radius:12px; font-weight:800;"
                                    onclick="return confirm('ยืนยันการลบผู้ใช้งาน @u.Username ?');">
                                🗑 Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
<style>
    .user-management-filter {
        display:flex;
        align-items:flex-end;
        justify-content:space-between;
        gap:16px;
        margin:0 0 16px;
        padding:14px 16px;
        border:1px solid var(--pt-border-soft, #dbeafe);
        border-radius:16px;
        color:var(--pt-body-contrast, #10233f);
        background:var(--pt-surface, #fff);
        box-shadow:0 8px 22px rgba(15,23,42,.05);
    }

    .user-management-filter__controls {
        display:grid;
        grid-template-columns:repeat(2, minmax(220px, 420px));
        gap:14px;
        width:100%;
    }

    .user-management-filter__field label {
        display:block;
        margin:0 0 6px;
        font-size:.88rem;
        font-weight:600;
    }

    .user-management-filter__count {
        flex:0 0 auto;
        padding-bottom:11px;
        color:var(--pt-body-muted, #64748b);
        font-size:.88rem;
        font-weight:500;
        white-space:nowrap;
    }

    .user-management-table th,
    .user-management-table td {
        padding: 12px 14px;
        font-size: .9rem;
        line-height: 1.35;
    }

    .user-management-table td {
        word-break: break-word;
    }

    .user-management-table .fw-semibold {
        font-weight: 700 !important;
    }

    .user-status-text,
    .user-role-text,
    .user-verified-text {
        display: inline;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        font-size: .82rem;
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: 0;
        white-space: normal;
    }

    .user-management-table .btn-sm {
        padding: .34rem .58rem;
        font-size: .78rem;
        line-height: 1.15;
    }

    .user-role-text.is-admin {
        color: #7c3aed;
    }

    .user-role-text.is-user {
        color: #2563eb;
    }

    .user-status-text.is-active {
        color: #16a34a;
    }

    .user-status-text.is-inactive {
        color: #ef4444;
    }

    .user-verified-text.is-verified {
        color: #16a34a;
    }

    .user-verified-text.is-unverified {
        color: #f59e0b;
    }

    @@media (max-width: 576px) {
        .user-management-filter {
            align-items:stretch;
            flex-direction:column;
            gap:8px;
        }

        .user-management-filter__controls {
            grid-template-columns:1fr;
        }

        .user-management-filter__count {
            padding-bottom:0;
            text-align:right;
        }

        .user-management-table th,
        .user-management-table td {
            padding: 10px 12px;
            font-size: .82rem;
        }

        .user-status-text,
        .user-role-text,
        .user-verified-text {
            font-size: .74rem;
            font-weight: 750;
        }
    }
</style>

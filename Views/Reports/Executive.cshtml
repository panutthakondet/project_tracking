@model ProjectTracking.ViewModels.ExecutiveReportViewModel
@using System.Globalization

@{
    Layout = null;
    var th = new CultureInfo("th-TH");
    var report = Model ?? new ProjectTracking.ViewModels.ExecutiveReportViewModel();

    string FormatDate(DateTime? value)
    {
        return value?.ToString("dd MMM yyyy", th) ?? "-";
    }
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>Executive Project Summary</title>
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&display=swap");
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 16px;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 11px;
        }
        .report-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 12px;
        }
        .department-filter { display:flex; align-items:center; gap:8px; margin-right:auto; }
        .department-filter label { font-weight:700; }
        .department-filter select { min-width:220px; min-height:34px; padding:6px 10px; border:1px solid #b9c9dc; background:#fff; color:#10233f; font:inherit; }
        .report-btn {
            min-height: 34px;
            padding: 7px 13px;
            border: 1px solid #102443;
            border-radius: 999px;
            color: #102443;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 900;
            line-height: 1.1;
            text-decoration: none;
            cursor: pointer;
        }
        .report-btn.primary {
            color: #fff;
            background: #102443;
        }
        .print-header {
            margin-bottom: 12px;
            padding: 14px 16px;
            color: #fff;
            background: #102443;
        }
        .print-header h1 {
            margin: 0 0 6px;
            font-size: 22px;
        }
        .print-header div {
            color: rgba(255,255,255,.82);
            font-weight: 700;
            line-height: 1.55;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 8px;
            margin-bottom: 12px;
        }
        .kpi {
            --kpi-tone: #14b8a6;
            --kpi-soft: rgba(20, 184, 166, .18);
            --kpi-faint: rgba(20, 184, 166, .045);
            padding: 10px;
            border: 1px solid #d8e3ef;
            border-color: color-mix(in srgb, var(--kpi-tone) 22%, #d8e3ef);
            border-left: 4px solid var(--kpi-tone);
            background:
                linear-gradient(90deg, var(--kpi-soft) 0%, var(--kpi-faint) 42%, #fff 100%);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .78);
        }
        .kpi.blue,
        .kpi.info {
            --kpi-tone: #258cfb;
            --kpi-soft: rgba(37, 140, 251, .18);
            --kpi-faint: rgba(37, 140, 251, .045);
        }
        .kpi.pink {
            --kpi-tone: #ec4899;
            --kpi-soft: rgba(236, 72, 153, .18);
            --kpi-faint: rgba(236, 72, 153, .045);
        }
        .kpi.orange,
        .kpi.warning {
            --kpi-tone: #f59e0b;
            --kpi-soft: rgba(245, 158, 11, .2);
            --kpi-faint: rgba(245, 158, 11, .055);
        }
        .kpi.red,
        .kpi.danger {
            --kpi-tone: #ef4444;
            --kpi-soft: rgba(239, 68, 68, .18);
            --kpi-faint: rgba(239, 68, 68, .045);
        }
        .kpi.green,
        .kpi.success {
            --kpi-tone: #22c55e;
            --kpi-soft: rgba(34, 197, 94, .18);
            --kpi-faint: rgba(34, 197, 94, .045);
        }
        .kpi.cyan,
        .kpi.teal {
            --kpi-tone: #14b8a6;
            --kpi-soft: rgba(20, 184, 166, .18);
            --kpi-faint: rgba(20, 184, 166, .045);
        }
        .kpi.purple {
            --kpi-tone: #8b5cf6;
            --kpi-soft: rgba(139, 92, 246, .18);
            --kpi-faint: rgba(139, 92, 246, .045);
        }
        .kpi span,
        .kpi small {
            display: block;
            color: #64748b;
            font-weight: 800;
        }
        .kpi strong {
            display: block;
            margin: 5px 0;
            color: #10233f;
            font-size: 20px;
            font-weight: 900;
        }
        h2 {
            margin: 14px 0 8px;
            color: #10233f;
            font-size: 16px;
            font-weight: 900;
        }
        .report-section {
            margin-bottom: 12px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin-bottom: 12px;
        }
        th {
            padding: 7px 6px;
            color: #fff;
            background: #102443;
            border: 1px solid rgba(255,255,255,.18);
            font-weight: 900;
            text-align: center;
        }
        td {
            padding: 7px 6px;
            border: 1px solid #d8e3ef;
            line-height: 1.45;
            vertical-align: top;
            overflow-wrap: anywhere;
        }
        tr:nth-child(even) td { background: #f8fbff; }
        .text-center { text-align: center; }
        .empty {
            padding: 18px;
            border: 1px dashed #cbd5e1;
            color: #64748b;
            text-align: center;
            font-weight: 800;
        }
        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
        @@media print {
            body { padding: 0; }
            .report-actions { display: none; }
            thead { display: table-header-group; }
            h2, h3,
            .project-group-row,
            .scenario-project__header,
            .scenario-group__header,
            .phase-project-group {
                break-after: avoid;
                page-break-after: avoid;
            }
            .report-section table,
            .report-section .empty,
            h2 + table,
            h2 + .empty,
            h2 + .report-table-scroll,
            h3 + table,
            h3 + .empty,
            .project-group-row + tr {
                break-before: avoid;
                page-break-before: avoid;
            }
            .report-section,
            .scenario-project,
            .scenario-group,
            .project-group-row,
            .phase-project-group {
                break-inside: avoid-page;
                page-break-inside: avoid;
            }
            tr { page-break-inside: avoid; }
        }
    
        /* Crisp typography normalization for standalone pages. */
        :root { --pt-readable-thai-font: "Noto Sans Thai", "Leelawadee UI", Tahoma, "Segoe UI", Arial, sans-serif; }
        html, body {
            font-family: var(--pt-readable-thai-font) !important;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }
        body :where(*):not(svg):not(svg *) {
            font-family: var(--pt-readable-thai-font) !important;
            font-stretch: normal !important;
            letter-spacing: 0 !important;
            text-shadow: none !important;
        }
        body :is(h1, h2, h3, h4, h5, h6, th, label, strong, b, .report-btn, .btn, .badge, .status-text, .cell-title, .project-group-name, [class*="title"], [class*="heading"], [class*="eyebrow"], [class*="status"], [class*="badge"], [class*="count"], [class*="total"], [class*="value"]) {
            font-weight: 700 !important;
        }
        body :is(p, li, td, small, em, time, .cell-sub, .detail-block div, .meta-label, .meta-value, .empty, [class*="detail"], [class*="meta"], [class*="subtitle"], [class*="description"], [class*="desc"], [class*="remark"], [class*="note"], [class*="empty"]):not(.btn):not(.badge):not(.status-text):not([class*="status-"]):not([class*="Status"]) {
            font-weight: 400 !important;
        }
</style>
@await Html.PartialAsync("_StandaloneTheme")
</head>
<body class="pt-standalone-report">
    <div class="report-actions">
        <form method="get" class="department-filter">
            <label for="departmentId">ฝ่าย</label>
            <select id="departmentId" name="departmentId" onchange="this.form.submit()">
                <option value="">ทุกฝ่าย</option>
                @foreach (var department in report.DepartmentOptions)
                {
                    <option value="@department.DepartmentId" selected="@(report.DepartmentId == department.DepartmentId ? "selected" : null)">@department.DepartmentName</option>
                }
            </select>
        </form>
        <button type="button" class="report-btn primary" onclick="window.print()">Print</button>
        <a asp-action="Index" class="report-btn">Report Center</a>
        <a asp-controller="Home" asp-action="Index" class="report-btn">Dashboard</a>
    </div>

    <header class="print-header">
        <h1>Executive Project Summary</h1>
        <div>
            ข้อมูล ณ @report.GeneratedAt.ToString("dd MMM yyyy HH:mm", th)<br />
            ผู้พิมพ์: @(string.IsNullOrWhiteSpace(report.GeneratedBy) ? "-" : report.GeneratedBy)
        </div>
    </header>

    <section class="kpi-grid">
        @foreach (var kpi in report.Kpis)
        {
            <article class="kpi @kpi.Tone">
                <span>@kpi.Label</span>
                <strong>@kpi.Value</strong>
                <small>@kpi.Note</small>
            </article>
        }
    </section>

    <section class="report-section">
        <h2>โครงการที่ต้องเฝ้าระวัง</h2>
        @if (!report.RiskProjects.Any())
        {
            <div class="empty">ยังไม่พบโครงการที่ต้องเฝ้าระวัง</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th style="width:34px;">Seq</th>
                        <th>Project</th>
                        <th style="width:150px;">Owner</th>
                        <th style="width:70px;">Risk</th>
                        <th style="width:70px;">Progress</th>
                        <th style="width:180px;">Due</th>
                        <th style="width:240px;">Reasons</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var riskSeq = 1;
                    }
                    @foreach (var item in report.RiskProjects)
                    {
                        <tr>
                            <td class="text-center">@riskSeq</td>
                            <td>@item.ProjectName</td>
                            <td>@item.OwnerName</td>
                            <td class="text-center">@item.RiskLevel</td>
                            <td class="text-center">@item.Progress%</td>
                            <td>@item.DueText</td>
                            <td>@string.Join(", ", item.Reasons)</td>
                        </tr>
                        riskSeq++;
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="report-section">
        <h2>งานเลยกำหนดที่ต้องจัดการ</h2>
        @if (!report.DueItems.Any())
        {
            <div class="empty">ไม่มีงานเลยกำหนด</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th style="width:34px;">Seq</th>
                        <th style="width:80px;">Type</th>
                        <th>Title</th>
                        <th>Project</th>
                        <th style="width:150px;">Owner</th>
                        <th style="width:95px;">Due</th>
                        <th style="width:70px;">Days</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var dueSeq = 1;
                    }
                    @foreach (var item in report.DueItems)
                    {
                        <tr>
                            <td class="text-center">@dueSeq</td>
                            <td>@item.Type</td>
                            <td>@item.Title</td>
                            <td>@item.ProjectName</td>
                            <td>@item.OwnerName</td>
                            <td class="text-center">@FormatDate(item.DueDate)</td>
                            <td class="text-center">@item.OverdueDays</td>
                        </tr>
                        dueSeq++;
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="report-section">
        <h2>Team Workload</h2>
        @if (!report.TeamWorkload.Any())
        {
            <div class="empty">ยังไม่มีภาระงานค้างในทีม</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th style="width:34px;">Seq</th>
                        <th>Employee</th>
                        <th style="width:70px;">Assign</th>
                        <th style="width:70px;">Issue</th>
                        <th style="width:70px;">Support</th>
                        <th style="width:80px;">Followup</th>
                        <th style="width:70px;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var workloadSeq = 1;
                    }
                    @foreach (var row in report.TeamWorkload)
                    {
                        <tr>
                            <td class="text-center">@workloadSeq</td>
                            <td>@row.EmployeeName</td>
                            <td class="text-center">@row.Assignments</td>
                            <td class="text-center">@row.Issues</td>
                            <td class="text-center">@row.SupportOrders</td>
                            <td class="text-center">@row.Followups</td>
                            <td class="text-center">@row.Total</td>
                        </tr>
                        workloadSeq++;
                    }
                </tbody>
            </table>
        }
    </section>

</body>
</html>

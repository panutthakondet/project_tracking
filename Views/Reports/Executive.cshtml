@model ProjectTracking.ViewModels.ExecutiveReportViewModel
@using System.Globalization
@{
    Layout = null;
    var th = CultureInfo.GetCultureInfo("th-TH");
    string DateText(DateTime? date) => date?.ToString("d MMM yyyy", th) ?? "ไม่กำหนด";
    string StatusTone(string status)
    {
        var code = ProjectTracking.Services.WorkflowStatusPresentation.Normalize(status);
        return code switch {
            "IN_PROGRESS" or "WORKING" or "WIP" => "working",
            "PLAN" or "PLANNED" or "OPEN" or "PENDING" => "planned",
            "DELAYED" or "OVERDUE" or "FAIL" or "REWORK" => "delayed",
            "FIXED" or "REVIEW" => "review",
            _ => "other"
        };
    }
    var sections = new[] {
        (Title: "งานที่กำลังทำในสัปดาห์นี้", Period: $"{DateText(Model.WeekStart)} – {DateText(Model.WeekStart.AddDays(6))}", Items: Model.ThisWeek, Tone: "current"),
        (Title: "งานที่ต้องทำในสัปดาห์หน้า", Period: $"{DateText(Model.WeekStart.AddDays(7))} – {DateText(Model.WeekStart.AddDays(13))}", Items: Model.NextWeek, Tone: "next"),
        (Title: "งานที่กำลังดำเนินการทั้งหมด", Period: "งานมอบหมายที่ยังไม่เสร็จ", Items: Model.AllWork, Tone: "all")
    };
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>รายงานงานประจำสัปดาห์ - @DateText(Model.WeekStart)</title>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700&display=swap');
        * { box-sizing:border-box; }
        body { margin:0; padding:24px; background:#f3f6fa; color:#172b43; font:16px/1.5 'Sarabun',Tahoma,sans-serif; }
        .report { max-width:1440px; margin:auto; }
        .actions { display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin-bottom:18px; }
        .filter { display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-right:auto; }
        button,select,.button { font:inherit; padding:8px 14px; border:1px solid #b6c6d8; border-radius:8px; background:white; color:#172b43; text-decoration:none; cursor:pointer; }
        .pt-native-select-hidden {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            min-height: 1px !important;
            opacity: 0 !important;
            pointer-events: none !important;
            clip-path: inset(50%) !important;
        }
        .pt-search-select { position: relative; width: 100%; }
        .pt-search-select__field { position: relative; }
        .pt-search-select__input {
            width: 100%;
            min-height: 34px;
            padding: 7px 38px 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            outline: none;
        }
        .pt-search-select__input:focus {
            border-color: #14b8a6;
            box-shadow: 0 0 0 3px rgba(20, 184, 166, .12);
        }        .pt-search-select__dropdown {
            position: absolute;
            left: 0;
            right: 0;
            top: calc(100% + 4px);
            z-index: 20;
            width: 100%;
            max-height: 240px;
            overflow-y: auto;
            display: none;
            border: 1px solid #d8e2ef;
            background: #fff;
            box-shadow: 0 12px 26px rgba(15, 35, 64, .14);
        }
        .pt-search-select.is-open .pt-search-select__dropdown { display: block; }
        .pt-search-select__option {
            width: 100%;
            padding: 8px 10px;
            border: 0;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.35;
            text-align: left;
            cursor: pointer;
        }
        .pt-search-select__option:hover,
        .pt-search-select__option.is-selected {
            color: #062b2f;
            background: rgba(20, 184, 166, .14);
        }
        .pt-search-select__empty {
            padding: 10px;
            color: #64748b;
            font-weight: 800;
            text-align: center;
        }
        .filter .pt-search-select { width:260px; max-width:100%; }
        .filter .pt-search-select__input { border-radius:8px; font:inherit; min-height:40px; }
        .filter .pt-search-select__option { font:inherit; border-radius:0; }
        .primary { background:#183b64; color:white; }
        header { border-bottom:3px solid #183b64; padding:0 0 18px; margin-bottom:20px; }
        h1 { margin:0 0 6px; font-size:28px; } .muted { color:#54677b; }
        .summary { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-bottom:24px; }
        .summary a { display:block; padding:16px; border:1px solid #d4deea; border-top:4px solid #2473b5; border-radius:10px; background:white; text-decoration:none; color:inherit; }
        .summary strong { display:block; font-size:28px; } .summary a:nth-child(2) { border-top-color:#8b5dc4; } .summary a:nth-child(3) { border-top-color:#16877e; }
        .section { margin:0 0 28px; padding:20px; background:white; border:1px solid #d4deea; border-radius:12px; scroll-margin-top:12px; }
        .section-head { display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:8px; margin-bottom:14px; }
        h2 { margin:0; font-size:22px; } .period { margin-top:3px; color:#54677b; }
        .table-wrap { overflow-x:auto; } table { width:100%; border-collapse:collapse; table-layout:fixed; font-size:15px; }
        th,td { padding:10px; border-bottom:1px solid #dce4ed; text-align:left; vertical-align:top; overflow-wrap:anywhere; }
        th { background:#eff4f9; font-weight:600; } tbody.work-entry:nth-of-type(even) td { background:#fafbfd; }
        .type { display:block; color:#54677b; font-size:13px; margin-bottom:3px; } .late { color:#b42318; display:block; font-size:13px; }
        .pt-standalone-report .period-deadline { color:#175ca6 !important; font-weight:600; }
        .pt-standalone-report .period-deadline.is-overdue { color:#b42318 !important; }
        .pt-standalone-report .work-status { font-weight:600; }
        .pt-standalone-report .status-working { color:#087669 !important; }
        .pt-standalone-report .status-planned { color:#9a5700 !important; }
        .pt-standalone-report .status-delayed { color:#b42318 !important; }
        .pt-standalone-report .status-review { color:#7044a0 !important; }
        .pt-standalone-report .status-other { color:#175ca6 !important; }
        .work-note { white-space:normal; overflow-wrap:anywhere; }
        .work-note-row td { padding:6px 10px 12px; color:#54677b; }
        .work-entry { break-inside:avoid; page-break-inside:avoid; }
        .work-entry.cooperative-end > tr:last-child > td { border-bottom:3px solid #74899f; }
        .empty { text-align:center; padding:28px; color:#54677b; } footer { color:#54677b; font-size:13px; }
        @@media(max-width:700px) { body { padding:12px; } .summary { grid-template-columns:1fr; gap:8px; } .summary a { padding:10px 14px; } .summary strong { display:inline; margin-right:8px; } .section { padding:12px; } table { min-width:850px; } h1 { font-size:24px; } }
        @@page { size:A4 landscape; margin:12mm; }
        @@media print { body { background:white; padding:0; font-size:11pt; } .actions { display:none; } .summary { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-bottom:16px; break-inside:avoid; page-break-inside:avoid; print-color-adjust:exact; -webkit-print-color-adjust:exact; } .summary a { padding:10px 12px; } .summary strong { display:block; margin-right:0; font-size:20pt; } .section { border:0; padding:0; border-radius:0; } .section + .section { break-before:page; } table { font-size:10pt; min-width:0; } thead { display:table-header-group; } tr { break-inside:avoid; } .table-wrap { overflow:visible; } a { color:inherit; } }
    </style>
    @await Html.PartialAsync("_StandaloneTheme")
</head>
<body class="pt-standalone-report">
<main class="report">
    <div class="actions">
        <form method="get" class="filter">
            <label for="departmentId">ฝ่าย</label>
            <select id="departmentId" name="departmentId" data-placeholder="พิมพ์ค้นหาฝ่าย..." onchange="this.form.elements.empId.value=''; this.form.submit()">
                <option value="">ทุกฝ่าย</option>
                @foreach (var option in Model.DepartmentOptions)
                {
                    <option value="@option.DepartmentId" selected="@(Model.DepartmentId == option.DepartmentId)">@option.DepartmentName</option>
                }
            </select>
            <label for="empId">พนักงาน</label>
            <select id="empId" name="empId" data-placeholder="พิมพ์ค้นหาพนักงาน..." onchange="this.form.submit()">
                <option value="">ทุกคน</option>
                @foreach (var employee in Model.EmployeeOptions)
                {
                    <option value="@employee.EmpId" selected="@(Model.EmpId == employee.EmpId)">@employee.EmpName</option>
                }
            </select>
        </form>
        <button type="button" class="primary" onclick="window.print()">พิมพ์ / บันทึก PDF</button>
        <a asp-action="Index" class="button">ศูนย์รายงาน</a>
    </div>
    <header>
        <h1>รายงานงานประจำสัปดาห์</h1>
        <div class="muted">ฝ่าย: @(Model.DepartmentOptions.FirstOrDefault(d => d.DepartmentId == Model.DepartmentId)?.DepartmentName ?? "ทุกฝ่าย")</div>
        <div class="muted">ข้อมูล ณ @Model.GeneratedAt.ToString("d MMM yyyy HH:mm", th) น.</div>
        <div class="muted">ผู้จัดทำ: @Model.GeneratedBy · ตำแหน่ง: @Model.GeneratedByPosition</div>
    </header>
    <div class="summary">
        @foreach (var block in sections)
        {
            <a href="#@block.Tone"><strong>@block.Items.Count.ToString("N0")</strong>@block.Title</a>
        }
    </div>
    @foreach (var block in sections)
    {
        <section class="section" id="@block.Tone">
            <div class="section-head"><div><h2>@block.Title</h2><div class="period">@block.Period</div></div><span>@block.Items.Count.ToString("N0") รายการ</span></div>
            <div class="table-wrap">
                <table>
                    <colgroup><col style="width:5%" /><col style="width:24%" /><col style="width:27%" /><col style="width:16%" /><col style="width:15%" /><col style="width:13%" /></colgroup>
                    <thead><tr><th>ลำดับ</th><th>สหกรณ์ / โครงการ</th><th>งาน</th><th>ผู้รับผิดชอบ</th><th>กำหนดเริ่ม–สิ้นสุด</th><th>สถานะ</th></tr></thead>
                    @for (var index = 0; index < block.Items.Count; index++)
                    {
                        var item = block.Items[index];
                        var cooperativeEnd = index == block.Items.Count - 1 || !string.Equals(item.CooperativeName, block.Items[index + 1].CooperativeName, StringComparison.OrdinalIgnoreCase);
                        <tbody class="work-entry @(cooperativeEnd ? "cooperative-end" : "")">
                        <tr><td>@(index + 1)</td><td>@item.ProjectName</td><td>@item.Title<br /><span class="period-deadline @(item.PeriodEndDate?.Date < Model.GeneratedAt.Date ? "is-overdue" : "")">กำหนดส่งงวด: @DateText(item.PeriodEndDate)</span></td><td>@(string.IsNullOrWhiteSpace(item.OwnerName) ? "ยังไม่ระบุ" : item.OwnerName)</td><td>@DateText(item.StartDate)<br />ถึง @DateText(item.EndDate)
                        @if (item.EndDate?.Date < Model.GeneratedAt.Date) { <span class="late">เกินกำหนด @((Model.GeneratedAt.Date - item.EndDate.Value.Date).Days) วัน</span> }
                        </td><td><span class="work-status status-@StatusTone(string.IsNullOrWhiteSpace(item.StatusCode) ? item.Status : item.StatusCode)">@item.Status</span></td></tr>
                        @if (!string.IsNullOrWhiteSpace(item.Note) && !block.Items.Skip(index + 1).Any(later => later.ProjectId == item.ProjectId))
                        {
                            <tr class="work-note-row"><td colspan="6"><div class="work-note"><strong>หมายเหตุ:</strong> @item.Note</div></td></tr>
                        }
                        </tbody>
                    }
                    @if (!block.Items.Any()) { <tbody><tr><td colspan="6" class="empty">ไม่มีรายการในส่วนนี้</td></tr></tbody> }
                </table>
            </div>
        </section>
    }
</main>
<script src="~/js/executive-report-filters.js" asp-append-version="true"></script>
</body>
</html>

@model ProjectTracking.ViewModels.TaskProgressReportViewModel
@using System.Globalization

@{
    Layout = null;
    var th = new CultureInfo("th-TH");
    var report = Model ?? new ProjectTracking.ViewModels.TaskProgressReportViewModel();

    string DateText(DateTime? value)
    {
        return value?.ToString("dd MMM yyyy", th) ?? "-";
    }

    string YearText(int year)
    {
        return (year + 543).ToString();
    }

    string ProjectName()
    {
        return report.ProjectId.HasValue
            ? report.ProjectOptions.FirstOrDefault(x => x.ProjectId == report.ProjectId.Value)?.ProjectName ?? "-"
            : "All Projects";
    }

    string CoopName()
    {
        return report.ProjectId.HasValue
            ? report.ProjectOptions.FirstOrDefault(x => x.ProjectId == report.ProjectId.Value)?.CoopName ?? "-"
            : "All Cooperatives";
    }

    string EmployeeName()
    {
        return report.EmpId.HasValue
            ? report.EmployeeOptions.FirstOrDefault(x => x.EmpId == report.EmpId.Value)?.EmpName ?? "-"
            : "All Employees";
    }

    string BaName()
    {
        return report.BaEmpId.HasValue
            ? report.BaOptions.FirstOrDefault(x => x.EmpId == report.BaEmpId.Value)?.EmpName ?? "-"
            : "All BA";
    }

    string StatusName(string? status)
    {
        return string.IsNullOrWhiteSpace(status)
            ? "All Phase Statuses"
            : report.PhaseStatusDefinitions.FirstOrDefault(x =>
                string.Equals(x.StatusCode, status, StringComparison.OrdinalIgnoreCase))?.StatusDesc ?? status.Trim();
    }

    string AssignStatusName(string? status)
    {
        return string.IsNullOrWhiteSpace(status)
            ? "All Assign Statuses"
            : report.AssignStatusDefinitions.FirstOrDefault(x =>
                string.Equals(x.StatusCode, status, StringComparison.OrdinalIgnoreCase))?.StatusDesc ?? status.Trim();
    }

    var statusOptions = report.PhaseStatusDefinitions;

    var assignStatusOptions = report.AssignStatusOptions;

    var coopOptions = report.ProjectOptions
        .Select(x => x.CoopName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();
    var selectedCoop = report.ProjectId.HasValue
        ? report.ProjectOptions.FirstOrDefault(x => x.ProjectId == report.ProjectId.Value)?.CoopName ?? ""
        : "";

    var projectGroups = report.Rows
        .GroupBy(x => new { x.ProjectId, x.ProjectName })
        .OrderBy(x => x.Key.ProjectName)
        .ToList();
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>Task Progress Report</title>
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&display=swap");
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 16px;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 11px;
        }
        .report-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }
        .report-btn {
            min-height: 34px;
            padding: 7px 13px;
            border: 1px solid #102443;
            border-radius: 999px;
            color: #102443;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 900;
            line-height: 1.1;
            text-decoration: none;
            cursor: pointer;
        }
        .report-btn.primary {
            color: #fff;
            background: #102443;
        }
        .print-header {
            margin-bottom: 12px;
            padding: 14px 16px;
            color: #fff;
            background: #102443;
        }
        .print-header h1 {
            margin: 0 0 6px;
            font-size: 22px;
        }
        .print-header div {
            color: rgba(255,255,255,.82);
            font-weight: 700;
            line-height: 1.55;
        }
        .filter-panel {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            align-items: end;
            gap: 10px;
            max-width: 100%;
            margin-bottom: 12px;
            padding: 12px;
            border: 1px solid #d8e3ef;
            background: #f8fbff;
        }
        .field {
            min-width: 0;
        }
        .field:nth-of-type(2),
        .field:nth-of-type(7) {
            grid-column: span 2;
        }
        .field label {
            display: block;
            margin-bottom: 5px;
            color: #64748b;
            font-weight: 900;
        }
        .field select {
            width: 100%;
            min-height: 34px;
            padding: 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
        }
        .pt-native-select-hidden {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            opacity: 0 !important;
            pointer-events: none !important;
        }
        .pt-search-select {
            position: relative;
            width: 100%;
            min-width: 0;
        }
        .pt-search-select__input {
            width: 100%;
            min-width: 0;
            min-height: 34px;
            padding: 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
        }
        .pt-search-select__input:focus {
            border-color: #14b8a6;
            outline: none;
            box-shadow: 0 0 0 3px rgba(20, 184, 166, .12);
        }
        .pt-search-select__dropdown {
            position: absolute;
            left: 0;
            right: 0;
            top: calc(100% + 4px);
            z-index: 20;
            max-height: 240px;
            overflow-y: auto;
            display: none;
            border: 1px solid #d8e3ef;
            background: #fff;
            box-shadow: 0 12px 24px rgba(15, 35, 64, .14);
        }
        .pt-search-select.is-open .pt-search-select__dropdown {
            display: block;
        }
        .pt-search-select__option,
        .pt-search-select__empty {
            width: 100%;
            padding: 8px 10px;
            border: 0;
            border-bottom: 1px solid #edf2f7;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            text-align: left;
        }
        .pt-search-select__option:hover,
        .pt-search-select__option.is-selected {
            background: #d9f7f2;
        }
        .pt-search-select__empty {
            color: #64748b;
        }
        .filter-submit {
            width: 100%;
            min-width: 0;
            justify-self: stretch;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 8px;
            margin-bottom: 12px;
        }
        .kpi {
            --kpi-tone: #14b8a6;
            --kpi-soft: rgba(20, 184, 166, .18);
            --kpi-faint: rgba(20, 184, 166, .045);
            padding: 10px;
            border: 1px solid #d8e3ef;
            border-color: color-mix(in srgb, var(--kpi-tone) 22%, #d8e3ef);
            border-left: 4px solid var(--kpi-tone);
            background:
                linear-gradient(90deg, var(--kpi-soft) 0%, var(--kpi-faint) 42%, #fff 100%);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .78);
        }
        .kpi.success,
        .kpi.green {
            --kpi-tone: #22c55e;
            --kpi-soft: rgba(34, 197, 94, .18);
            --kpi-faint: rgba(34, 197, 94, .045);
        }
        .kpi.info,
        .kpi.blue {
            --kpi-tone: #258cfb;
            --kpi-soft: rgba(37, 140, 251, .18);
            --kpi-faint: rgba(37, 140, 251, .045);
        }
        .kpi.warning,
        .kpi.orange {
            --kpi-tone: #f59e0b;
            --kpi-soft: rgba(245, 158, 11, .2);
            --kpi-faint: rgba(245, 158, 11, .055);
        }
        .kpi.danger,
        .kpi.red {
            --kpi-tone: #ef4444;
            --kpi-soft: rgba(239, 68, 68, .18);
            --kpi-faint: rgba(239, 68, 68, .045);
        }
        .kpi.pink {
            --kpi-tone: #ec4899;
            --kpi-soft: rgba(236, 72, 153, .18);
            --kpi-faint: rgba(236, 72, 153, .045);
        }
        .kpi.cyan,
        .kpi.teal {
            --kpi-tone: #14b8a6;
            --kpi-soft: rgba(20, 184, 166, .18);
            --kpi-faint: rgba(20, 184, 166, .045);
        }
        .kpi.purple {
            --kpi-tone: #8b5cf6;
            --kpi-soft: rgba(139, 92, 246, .18);
            --kpi-faint: rgba(139, 92, 246, .045);
        }
        .kpi span,
        .kpi small {
            display: block;
            color: #64748b;
            font-weight: 800;
        }
        .kpi strong {
            display: block;
            margin: 5px 0;
            color: #10233f;
            font-size: 20px;
            font-weight: 900;
        }
        h2 {
            margin: 14px 0 8px;
            color: #10233f;
            font-size: 16px;
            font-weight: 900;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin-bottom: 12px;
        }
        th {
            padding: 7px 6px;
            color: #fff;
            background: #102443;
            border: 1px solid rgba(255,255,255,.18);
            font-weight: 900;
            text-align: center;
        }
        td {
            padding: 7px 6px;
            border: 1px solid #d8e3ef;
            line-height: 1.45;
            vertical-align: top;
            overflow-wrap: break-word;
            word-break: normal;
        }
        tr:nth-child(even) td { background: #f8fbff; }
        .monthly-table col.col-month { width: 13%; }
        .monthly-table col.col-count { width: 14.5%; }
        .task-table col.col-seq { width: 4%; }
        .task-table col.col-employee { width: 13%; }
        .task-table col.col-phase { width: 24%; }
        .task-table col.col-role { width: 15%; }
        .task-table col.col-status { width: 10%; }
        .task-table col.col-assign-status { width: 10%; }
        .task-table col.col-date { width: 9%; }
        .task-table col.col-month { width: 6%; }
        .project-group-row td {
            padding: 8px 10px;
            color: #10233f;
            background: transparent !important;
            border-color: #d8e3ef;
            border-top: 2px solid #102443;
            font-size: 12px;
            font-weight: 900;
        }
        .project-group-name {
            display: flex;
            justify-content: space-between;
            gap: 12px;
        }
        .project-group-count {
            flex: 0 0 auto;
            color: #64748b;
            font-size: 11px;
            font-weight: 800;
        }
        .text-center { text-align: center; }
        .cell-title {
            color: #10233f;
            font-weight: 900;
        }
        .cell-sub {
            margin-top: 4px;
            color: #64748b;
            font-weight: 800;
        }
        .status-text {
            font-weight: 900;
            white-space: nowrap;
        }
        .status-text.success { color: #0f8f5f; }
        .status-text.info { color: #0f6fa8; }
        .status-text.warning { color: #b7790b; }
        .status-text.muted { color: #64748b; }
        .empty {
            padding: 18px;
            border: 1px dashed #cbd5e1;
            color: #64748b;
            text-align: center;
            font-weight: 800;
        }
        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
        @@media print {
            body {
                padding: 0;
                font-size: 10px;
            }
            .report-actions,
            .filter-panel { display: none !important; }
            .print-header { padding: 10px 12px; }
            .print-header h1 { font-size: 18px; }
            .kpi-grid { gap: 6px; }
            .kpi { padding: 7px; }
            .kpi strong { font-size: 16px; }
            th,
            td { padding: 5px 5px; }
            h2,
            .project-group-row {
                break-after: avoid;
                page-break-after: avoid;
            }
            h2 + table,
            h2 + .empty,
            .project-group-row + tr {
                break-before: avoid;
                page-break-before: avoid;
            }
            .report-section,
            .project-group-row {
                break-inside: avoid-page;
                page-break-inside: avoid;
            }
            thead { display: table-header-group; }
            tr { page-break-inside: avoid; }
        }
        @@media (max-width: 1100px) {
            .filter-panel,
            .kpi-grid {
                grid-template-columns: 1fr;
            }

            .field:nth-of-type(2),
            .field:nth-of-type(7) {
                grid-column: auto;
            }
        }
    
        /* Crisp typography normalization for standalone pages. */
        :root { --pt-readable-thai-font: "Noto Sans Thai", "Leelawadee UI", Tahoma, "Segoe UI", Arial, sans-serif; }
        html, body {
            font-family: var(--pt-readable-thai-font) !important;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }
        body :where(*):not(svg):not(svg *) {
            font-family: var(--pt-readable-thai-font) !important;
            font-stretch: normal !important;
            letter-spacing: 0 !important;
            text-shadow: none !important;
        }
        body :is(h1, h2, h3, h4, h5, h6, th, label, strong, b, .report-btn, .btn, .badge, .status-text, .cell-title, .project-group-name, [class*="title"], [class*="heading"], [class*="eyebrow"], [class*="status"], [class*="badge"], [class*="count"], [class*="total"], [class*="value"]) {
            font-weight: 700 !important;
        }
        body :is(p, li, td, small, em, time, .cell-sub, .detail-block div, .meta-label, .meta-value, .empty, [class*="detail"], [class*="meta"], [class*="subtitle"], [class*="description"], [class*="desc"], [class*="remark"], [class*="note"], [class*="empty"]):not(.btn):not(.badge):not(.status-text):not([class*="status-"]):not([class*="Status"]) {
            font-weight: 400 !important;
        }
</style>
@await Html.PartialAsync("_StandaloneTheme")
</head>
<body class="pt-standalone-report">
    <div class="report-actions">
        <button type="button" class="report-btn primary" onclick="window.print()">Print</button>
        <a asp-controller="Reports" asp-action="Index" class="report-btn">Report Center</a>
        <a asp-controller="Home" asp-action="Index" class="report-btn">Dashboard</a>
    </div>

    <header class="print-header">
        <h1>Task Progress Report</h1>
        <div>
            Year: @YearText(report.Year)<br />
            Cooperative: @CoopName()<br />
            Project: @ProjectName()<br />
            Employee: @EmployeeName()<br />
            BA: @BaName()<br />
            Phase Status: @StatusName(report.Status)<br />
            Assign Status: @AssignStatusName(report.AssignStatus)<br />
            ข้อมูล ณ @report.GeneratedAt.ToString("dd MMM yyyy HH:mm", th)<br />
            ผู้พิมพ์: @(string.IsNullOrWhiteSpace(report.GeneratedBy) ? "-" : report.GeneratedBy)
        </div>
    </header>

    <form method="get" class="filter-panel">
        <div class="field">
            <label for="departmentId">ฝ่าย</label>
            <select id="departmentId" name="departmentId" data-placeholder="เลือกฝ่าย..." onchange="this.form.submit()">
                <option value="">ทุกฝ่าย</option>
                @foreach (var department in report.DepartmentOptions)
                {
                    <option value="@department.DepartmentId" selected="@(report.DepartmentId == department.DepartmentId ? "selected" : null)">@department.DepartmentName</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="coopFilter">Cooperative</label>
            <select id="coopFilter" data-placeholder="พิมพ์ค้นหาสหกรณ์...">
                <option value="">-- All Cooperatives --</option>
                @foreach (var coop in coopOptions)
                {
                    <option value="@coop" selected="@(string.Equals(selectedCoop, coop, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                        @coop
                    </option>
                }
            </select>
        </div>

        <div class="field">
            <label for="projectId">Project</label>
            <select id="projectId" name="projectId" data-placeholder="พิมพ์ค้นหา Project..." onchange="this.form.submit()">
                <option value="">-- All Projects --</option>
                @foreach (var project in report.ProjectOptions)
                {
                    <option value="@project.ProjectId"
                            data-coop-name="@project.CoopName"
                            selected="@(report.ProjectId == project.ProjectId ? "selected" : null)">
                        @project.ProjectName
                    </option>
                }
            </select>
        </div>
        <div class="field">
            <label for="empId">Employee</label>
            <select id="empId" name="empId" data-placeholder="พิมพ์ค้นหา Employee..." onchange="this.form.submit()">
                <option value="">-- All Employees --</option>
                @foreach (var emp in report.EmployeeOptions)
                {
                    <option value="@emp.EmpId" selected="@(report.EmpId == emp.EmpId ? "selected" : null)">
                        @emp.EmpName
                    </option>
                }
            </select>
        </div>
        <div class="field">
            <label for="baEmpId">BA</label>
            <select id="baEmpId" name="baEmpId" data-placeholder="พิมพ์ค้นหา BA..." onchange="this.form.submit()">
                <option value="">-- All BA --</option>
                @foreach (var ba in report.BaOptions)
                {
                    <option value="@ba.EmpId" selected="@(report.BaEmpId == ba.EmpId ? "selected" : null)">
                        @ba.EmpName
                    </option>
                }
            </select>
        </div>
        <div class="field">
            <label for="year">Year</label>
            <select id="year" name="year" data-placeholder="พิมพ์ค้นหา Year..." onchange="this.form.submit()">
                @foreach (var y in report.YearOptions)
                {
                    <option value="@y" selected="@(report.Year == y ? "selected" : null)">@YearText(y)</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="status">Phase Status</label>
            <select id="status" name="status" data-placeholder="พิมพ์ค้นหา Phase Status..." onchange="this.form.submit()">
                <option value="">-- All Phase Statuses --</option>
                @foreach (var option in statusOptions)
                {
                    <option value="@option.StatusCode" selected="@(string.Equals(report.Status, option.StatusCode, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                        @option.StatusDesc
                    </option>
                }
            </select>
        </div>
        <div class="field">
            <label for="assignStatus">Assign Status</label>
            <select id="assignStatus" name="assignStatus" data-placeholder="พิมพ์ค้นหา Assign Status..." onchange="this.form.submit()">
                <option value="">-- All Assign Statuses --</option>
                @foreach (var option in assignStatusOptions)
                {
                    <option value="@option" selected="@(string.Equals(report.AssignStatus, option, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                        @AssignStatusName(option)
                    </option>
                }
            </select>
        </div>
        <button type="submit" class="report-btn primary filter-submit">ค้นหา</button>
    </form>

    <section class="kpi-grid">
        <article class="kpi">
            <span>Total Assigns</span>
            <strong>@report.Summary.Total</strong>
            <small>งานทั้งหมดตามเงื่อนไข</small>
        </article>
        @foreach (var statusCount in report.Summary.StatusCounts.OrderBy(x => x.SortOrder))
        {
            <article class="kpi @statusCount.Tone">
                <span>@statusCount.StatusCode</span>
                <strong>@statusCount.Count</strong>
                <small>@statusCount.StatusDesc</small>
            </article>
        }
        <article class="kpi">
            <span>Projects</span>
            <strong>@report.Summary.Projects</strong>
            <small>โครงการที่มีรายการ</small>
        </article>
        <article class="kpi">
            <span>Employees</span>
            <strong>@report.Summary.Employees</strong>
            <small>ผู้รับผิดชอบที่เกี่ยวข้อง</small>
        </article>
    </section>

    <section class="report-section">
        <h2>Monthly Summary</h2>
        <table class="monthly-table">
            <thead>
                <tr>
                    <th>Month</th>
                    @foreach (var definition in report.PhaseStatusDefinitions.OrderBy(x => x.SortOrder))
                    {
                        <th>@definition.StatusDesc</th>
                    }
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var month in report.Months)
                {
                    <tr>
                        <td class="text-center">@month.MonthName</td>
                        @foreach (var definition in report.PhaseStatusDefinitions.OrderBy(x => x.SortOrder))
                        {
                            var statusCount = month.StatusCounts.FirstOrDefault(x => x.StatusCode == definition.StatusCode)?.Count ?? 0;
                            <td class="text-center">@statusCount</td>
                        }
                        <td class="text-center"><strong>@month.Total</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="report-section">
        <h2>Task Detail By Project</h2>
        @if (!report.Rows.Any())
        {
            <div class="empty">ไม่พบข้อมูลงานตามเงื่อนไขที่เลือก</div>
        }
        else
        {
            <table class="task-table">
                <colgroup>
                    <col class="col-seq" />
                    <col class="col-employee" />
                    <col class="col-phase" />
                    <col class="col-role" />
                    <col class="col-status" />
                    <col class="col-assign-status" />
                    <col class="col-date" />
                    <col class="col-date" />
                    <col class="col-month" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Seq</th>
                        <th>Employee</th>
                        <th>ส่วน / งวด / งาน</th>
                        <th>Role</th>
                        <th>Phase Status</th>
                        <th>Assign Status</th>
                        <th>Plan</th>
                        <th>กำหนดส่งงวดงาน</th>
                        <th>Month</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in projectGroups)
                    {
                        <tr class="project-group-row">
                            <td colspan="9">
                                <span class="project-group-name">
                                    <span>@group.Key.ProjectName</span>
                                    <span class="project-group-count">@group.Count() งาน</span>
                                </span>
                            </td>
                        </tr>
                        @foreach (var row in group)
                        {
                            <tr>
                                <td class="text-center">@row.Seq</td>
                                <td>@row.EmployeeName</td>
                                <td>
                                    <div class="cell-title">@row.PhasePeriodLabel</div>
                                    <div class="cell-sub">@row.PhaseName</div>
                                </td>
                                <td>@row.Role</td>
                                <td class="text-center">
                                    <span class="status-text @row.StatusTone">@row.StatusText</span>
                                </td>
                                <td class="text-center">
                                    <span class="status-text @row.AssignStatusTone">@row.AssignStatusText</span>
                                </td>
                                <td class="text-center">
                                    @DateText(row.PlanStart)<br />
                                    @DateText(row.PlanEnd)
                                </td>
                                <td class="text-center">@DateText(row.PeriodEnd)</td>
                                <td class="text-center">@row.MonthName</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </section>
    <script>
        (function () {
            function normalize(value) {
                return (value || "").toString().trim().toLowerCase();
            }

            function getSelectedOption(select) {
                return select.options[select.selectedIndex] || null;
            }

            function dispatchSelectChange(select) {
                select.dispatchEvent(new Event("input", { bubbles: true }));
                select.dispatchEvent(new Event("change", { bubbles: true }));
            }

            function enhanceSelect(select) {
                if (!select || select.classList.contains("pt-dropdown-enhanced")) return;

                const wrapper = document.createElement("div");
                wrapper.className = "pt-search-select";

                const input = document.createElement("input");
                input.type = "text";
                input.className = "pt-search-select__input";
                input.autocomplete = "off";
                input.placeholder = select.dataset.placeholder || getSelectedOption(select)?.text || "พิมพ์ค้นหา...";

                const dropdown = document.createElement("div");
                dropdown.className = "pt-search-select__dropdown";

                select.insertAdjacentElement("afterend", wrapper);
                wrapper.appendChild(input);
                wrapper.appendChild(dropdown);
                select.classList.add("pt-dropdown-enhanced", "pt-native-select-hidden");
                select.tabIndex = -1;

                function syncInput() {
                    const selected = getSelectedOption(select);
                    input.value = selected ? selected.text : "";
                }

                function closeDropdown() {
                    wrapper.classList.remove("is-open");
                }

                function renderOptions(filter = "") {
                    dropdown.innerHTML = "";
                    const keyword = normalize(filter);
                    const options = Array.from(select.options)
                        .filter(option => {
                            const haystack = normalize(`${option.text} ${option.value}`);
                            return !keyword || haystack.includes(keyword);
                        });

                    if (options.length === 0) {
                        const empty = document.createElement("div");
                        empty.className = "pt-search-select__empty";
                        empty.textContent = "ไม่พบข้อมูล";
                        dropdown.appendChild(empty);
                        return;
                    }

                    options.forEach(option => {
                        const button = document.createElement("button");
                        button.type = "button";
                        button.className = "pt-search-select__option";
                        if (option.value === select.value) button.classList.add("is-selected");
                        button.textContent = option.text;
                        button.addEventListener("click", function () {
                            select.value = option.value;
                            closeDropdown();
                            syncInput();
                            dispatchSelectChange(select);
                        });
                        dropdown.appendChild(button);
                    });
                }

                function openDropdown() {
                    input.value = "";
                    renderOptions(input.value);
                    wrapper.classList.add("is-open");
                }

                input.addEventListener("focus", openDropdown);
                input.addEventListener("click", openDropdown);
                input.addEventListener("input", function () {
                    renderOptions(input.value);
                    wrapper.classList.add("is-open");
                });
                input.addEventListener("keydown", function (event) {
                    if (event.key === "Escape") {
                        closeDropdown();
                        syncInput();
                    }
                });
                select.addEventListener("change", syncInput);
                document.addEventListener("click", function (event) {
                    if (!wrapper.contains(event.target)) {
                        closeDropdown();
                        syncInput();
                    }
                });

                syncInput();
            }

            document.querySelectorAll(".filter-panel select").forEach(enhanceSelect);

            const coopFilter = document.getElementById("coopFilter");
            const projectFilter = document.getElementById("projectId");

            function syncProjectOptionsByCoop() {
                const selectedCoop = normalize(coopFilter?.value || "");
                Array.from(projectFilter?.options || []).forEach(option => {
                    option.disabled = option.value !== "" &&
                        selectedCoop &&
                        normalize(option.dataset.coopName || "") !== selectedCoop;
                });

                const selected = projectFilter?.selectedOptions[0];
                if (selected && selected.disabled && projectFilter) {
                    projectFilter.value = "";
                    dispatchSelectChange(projectFilter);
                }
            }

            coopFilter?.addEventListener("change", syncProjectOptionsByCoop);
            syncProjectOptionsByCoop();
        })();
    </script>
</body>
</html>

@model ProjectTracking.ViewModels.TaskProgressReportViewModel
@using System.Globalization

@{
    Layout = null;
    var th = new CultureInfo("th-TH");
    var report = Model ?? new ProjectTracking.ViewModels.TaskProgressReportViewModel();

    string DateText(DateTime? value)
    {
        return value?.ToString("dd MMM yyyy", th) ?? "-";
    }

    string YearText(int year)
    {
        return (year + 543).ToString();
    }

    string ProjectName()
    {
        return report.ProjectId.HasValue
            ? report.ProjectOptions.FirstOrDefault(x => x.ProjectId == report.ProjectId.Value)?.ProjectName ?? "-"
            : "All Projects";
    }

    string EmployeeName()
    {
        return report.EmpId.HasValue
            ? report.EmployeeOptions.FirstOrDefault(x => x.EmpId == report.EmpId.Value)?.EmpName ?? "-"
            : "All Employees";
    }

    string StatusName(string? status)
    {
        return (status ?? "").Trim().ToUpperInvariant() switch
        {
            "DONE" => "ส่งงวดงานแล้ว",
            "IN_PROGRESS" => "กำลังดำเนินการ",
            "PENDING" => "วางแผน",
            _ => "All Statuses"
        };
    }

    var statusOptions = new[]
    {
        new { Value = "", Text = "-- All Statuses --" },
        new { Value = "DONE", Text = "ส่งงวดงานแล้ว" },
        new { Value = "IN_PROGRESS", Text = "กำลังดำเนินการ" },
        new { Value = "PENDING", Text = "วางแผน" }
    };

    var projectGroups = report.Rows
        .GroupBy(x => new { x.ProjectId, x.ProjectName })
        .OrderBy(x => x.Key.ProjectName)
        .ToList();
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>Task Progress Report</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 16px;
            color: #10233f;
            background: #fff;
            font-family: 'Sarabun', Tahoma, Arial, sans-serif;
            font-size: 11px;
        }
        .report-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }
        .report-btn {
            min-height: 34px;
            padding: 7px 13px;
            border: 1px solid #102443;
            border-radius: 999px;
            color: #102443;
            background: #fff;
            font-family: 'Sarabun', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 900;
            line-height: 1.1;
            text-decoration: none;
            cursor: pointer;
        }
        .report-btn.primary {
            color: #fff;
            background: #102443;
        }
        .print-header {
            margin-bottom: 12px;
            padding: 14px 16px;
            color: #fff;
            background: #102443;
        }
        .print-header h1 {
            margin: 0 0 6px;
            font-size: 22px;
        }
        .print-header div {
            color: rgba(255,255,255,.82);
            font-weight: 700;
            line-height: 1.55;
        }
        .filter-panel {
            display: grid;
            grid-template-columns: minmax(260px, 1.5fr) minmax(220px, 1fr) minmax(120px, .45fr) minmax(180px, .7fr) auto;
            align-items: end;
            gap: 10px;
            margin-bottom: 12px;
            padding: 12px;
            border: 1px solid #d8e3ef;
            background: #f8fbff;
        }
        .field label {
            display: block;
            margin-bottom: 5px;
            color: #64748b;
            font-weight: 900;
        }
        .field select {
            width: 100%;
            min-height: 34px;
            padding: 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Sarabun', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
        }
        .filter-submit {
            min-width: 88px;
            justify-self: start;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 8px;
            margin-bottom: 12px;
        }
        .kpi {
            padding: 10px;
            border: 1px solid #d8e3ef;
            border-left: 4px solid #14b8a6;
        }
        .kpi.success { border-left-color: #22c55e; }
        .kpi.info { border-left-color: #258cfb; }
        .kpi.warning { border-left-color: #f59e0b; }
        .kpi span,
        .kpi small {
            display: block;
            color: #64748b;
            font-weight: 800;
        }
        .kpi strong {
            display: block;
            margin: 5px 0;
            color: #10233f;
            font-size: 20px;
            font-weight: 900;
        }
        h2 {
            margin: 14px 0 8px;
            color: #10233f;
            font-size: 16px;
            font-weight: 900;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin-bottom: 12px;
        }
        th {
            padding: 7px 6px;
            color: #fff;
            background: #102443;
            border: 1px solid rgba(255,255,255,.18);
            font-weight: 900;
            text-align: center;
        }
        td {
            padding: 7px 6px;
            border: 1px solid #d8e3ef;
            line-height: 1.45;
            vertical-align: top;
            overflow-wrap: break-word;
            word-break: normal;
        }
        tr:nth-child(even) td { background: #f8fbff; }
        .monthly-table col.col-month { width: 13%; }
        .monthly-table col.col-count { width: 14.5%; }
        .task-table col.col-seq { width: 4%; }
        .task-table col.col-employee { width: 15%; }
        .task-table col.col-phase { width: 26%; }
        .task-table col.col-role { width: 20%; }
        .task-table col.col-status { width: 10%; }
        .task-table col.col-date { width: 10%; }
        .task-table col.col-month { width: 7%; }
        .project-group-row td {
            padding: 8px 10px;
            color: #fff;
            background: #18365e !important;
            border-color: #18365e;
            font-size: 12px;
            font-weight: 900;
        }
        .project-group-name {
            display: flex;
            justify-content: space-between;
            gap: 12px;
        }
        .project-group-count {
            flex: 0 0 auto;
            color: rgba(255,255,255,.78);
            font-size: 11px;
            font-weight: 800;
        }
        .text-center { text-align: center; }
        .cell-title {
            color: #10233f;
            font-weight: 900;
        }
        .cell-sub {
            margin-top: 4px;
            color: #64748b;
            font-weight: 800;
        }
        .status-text {
            font-weight: 900;
            white-space: nowrap;
        }
        .status-text.success { color: #0f8f5f; }
        .status-text.info { color: #0f6fa8; }
        .status-text.warning { color: #b7790b; }
        .status-text.muted { color: #64748b; }
        .empty {
            padding: 18px;
            border: 1px dashed #cbd5e1;
            color: #64748b;
            text-align: center;
            font-weight: 800;
        }
        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
        @@media print {
            body {
                padding: 0;
                font-size: 10px;
            }
            .report-actions,
            .filter-panel { display: none !important; }
            .print-header { padding: 10px 12px; }
            .print-header h1 { font-size: 18px; }
            .kpi-grid { gap: 6px; }
            .kpi { padding: 7px; }
            .kpi strong { font-size: 16px; }
            th,
            td { padding: 5px 5px; }
            h2,
            .project-group-row {
                break-after: avoid;
                page-break-after: avoid;
            }
            h2 + table,
            h2 + .empty,
            .project-group-row + tr {
                break-before: avoid;
                page-break-before: avoid;
            }
            .report-section,
            .project-group-row {
                break-inside: avoid-page;
                page-break-inside: avoid;
            }
            thead { display: table-header-group; }
            tr { page-break-inside: avoid; }
        }
        @@media (max-width: 1100px) {
            .filter-panel,
            .kpi-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="report-actions">
        <button type="button" class="report-btn primary" onclick="window.print()">Print</button>
        <a asp-controller="Reports" asp-action="Index" class="report-btn">Report Center</a>
        <a asp-controller="Home" asp-action="Index" class="report-btn">Dashboard</a>
    </div>

    <header class="print-header">
        <h1>Task Progress Report</h1>
        <div>
            Year: @YearText(report.Year)<br />
            Project: @ProjectName()<br />
            Employee: @EmployeeName()<br />
            Status: @StatusName(report.Status)<br />
            ข้อมูล ณ @report.GeneratedAt.ToString("dd MMM yyyy HH:mm", th)<br />
            ผู้พิมพ์: @(string.IsNullOrWhiteSpace(report.GeneratedBy) ? "-" : report.GeneratedBy)
        </div>
    </header>

    <form method="get" class="filter-panel">
        <div class="field">
            <label for="projectId">Project</label>
            <select id="projectId" name="projectId" onchange="this.form.submit()">
                <option value="">-- All Projects --</option>
                @foreach (var project in report.ProjectOptions)
                {
                    <option value="@project.ProjectId" selected="@(report.ProjectId == project.ProjectId ? "selected" : null)">
                        @project.ProjectName
                    </option>
                }
            </select>
        </div>
        <div class="field">
            <label for="empId">Employee</label>
            <select id="empId" name="empId" onchange="this.form.submit()">
                <option value="">-- All Employees --</option>
                @foreach (var emp in report.EmployeeOptions)
                {
                    <option value="@emp.EmpId" selected="@(report.EmpId == emp.EmpId ? "selected" : null)">
                        @emp.EmpName
                    </option>
                }
            </select>
        </div>
        <div class="field">
            <label for="year">Year</label>
            <select id="year" name="year" onchange="this.form.submit()">
                @foreach (var y in report.YearOptions)
                {
                    <option value="@y" selected="@(report.Year == y ? "selected" : null)">@YearText(y)</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="status">Status</label>
            <select id="status" name="status" onchange="this.form.submit()">
                @foreach (var option in statusOptions)
                {
                    <option value="@option.Value" selected="@(report.Status == option.Value ? "selected" : null)">
                        @option.Text
                    </option>
                }
            </select>
        </div>
        <button type="submit" class="report-btn primary filter-submit">ค้นหา</button>
    </form>

    <section class="kpi-grid">
        <article class="kpi">
            <span>Total Assigns</span>
            <strong>@report.Summary.Total</strong>
            <small>งานทั้งหมดตามเงื่อนไข</small>
        </article>
        <article class="kpi success">
            <span>Completed</span>
            <strong>@report.Summary.Completed</strong>
            <small>อิงสถานะส่งงวดงานแล้ว</small>
        </article>
        <article class="kpi info">
            <span>In Progress</span>
            <strong>@report.Summary.InProgress</strong>
            <small>อิงสถานะกำลังดำเนินการ</small>
        </article>
        <article class="kpi warning">
            <span>Pending</span>
            <strong>@report.Summary.Pending</strong>
            <small>อิงสถานะวางแผน</small>
        </article>
        <article class="kpi">
            <span>Projects</span>
            <strong>@report.Summary.Projects</strong>
            <small>โครงการที่มีรายการ</small>
        </article>
        <article class="kpi">
            <span>Employees</span>
            <strong>@report.Summary.Employees</strong>
            <small>ผู้รับผิดชอบที่เกี่ยวข้อง</small>
        </article>
    </section>

    <section class="report-section">
        <h2>Monthly Summary</h2>
        <table class="monthly-table">
            <colgroup>
                <col class="col-month" />
                <col class="col-count" />
                <col class="col-count" />
                <col class="col-count" />
                <col class="col-count" />
            </colgroup>
            <thead>
                <tr>
                    <th>Month</th>
                    <th>Completed</th>
                    <th>In Progress</th>
                    <th>Pending</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var month in report.Months)
                {
                    <tr>
                        <td class="text-center">@month.MonthName</td>
                        <td class="text-center">@month.Completed</td>
                        <td class="text-center">@month.InProgress</td>
                        <td class="text-center">@month.Pending</td>
                        <td class="text-center"><strong>@month.Total</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="report-section">
        <h2>Task Detail By Project</h2>
        @if (!report.Rows.Any())
        {
            <div class="empty">ไม่พบข้อมูลงานตามเงื่อนไขที่เลือก</div>
        }
        else
        {
            <table class="task-table">
                <colgroup>
                    <col class="col-seq" />
                    <col class="col-employee" />
                    <col class="col-phase" />
                    <col class="col-role" />
                    <col class="col-status" />
                    <col class="col-date" />
                    <col class="col-date" />
                    <col class="col-month" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Seq</th>
                        <th>Employee</th>
                        <th>ส่วน / งวด / งาน</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Plan</th>
                        <th>กำหนดส่งงวดงาน</th>
                        <th>Month</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in projectGroups)
                    {
                        <tr class="project-group-row">
                            <td colspan="8">
                                <span class="project-group-name">
                                    <span>@group.Key.ProjectName</span>
                                    <span class="project-group-count">@group.Count() งาน</span>
                                </span>
                            </td>
                        </tr>
                        @foreach (var row in group)
                        {
                            <tr>
                                <td class="text-center">@row.Seq</td>
                                <td>@row.EmployeeName</td>
                                <td>
                                    <div class="cell-title">@row.PhasePeriodLabel</div>
                                    <div class="cell-sub">@row.PhaseName</div>
                                </td>
                                <td>@row.Role</td>
                                <td class="text-center">
                                    <span class="status-text @row.StatusTone">@row.StatusText</span>
                                </td>
                                <td class="text-center">
                                    @DateText(row.PlanStart)<br />
                                    @DateText(row.PlanEnd)
                                </td>
                                <td class="text-center">@DateText(row.PeriodEnd)</td>
                                <td class="text-center">@row.MonthName</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </section>
</body>
</html>

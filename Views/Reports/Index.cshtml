@using Microsoft.AspNetCore.Http
@model ProjectTracking.ViewModels.ReportCenterViewModel

@{
    ViewData["Title"] = "Report Center";

    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }

    var reports = (Model?.Reports ?? new List<ProjectTracking.ViewModels.ReportCardViewModel>())
        .Where(x => CanMenu(x.PermissionKey ?? $"{x.Controller}.{x.Action}"))
        .ToList();

    string SectionName(string group)
    {
        return group switch
        {
            "Executive" => "รายงานหลัก",
            "Project Phases" => "Projects",
            "Projects" => "Projects",
            "Issues" => "Issues / Support",
            "Support" => "Issues / Support",
            "Field Service" => "Field Service",
            "Test Scenario" => "QA / Test",
            "Followups" => "People / Operation",
            "Meetings" => "People / Operation",
            "Attendance" => "People / Operation",
            _ => group
        };
    }

    int SectionOrder(string section)
    {
        return section switch
        {
            "รายงานหลัก" => 0,
            "Projects" => 10,
            "Issues / Support" => 20,
            "QA / Test" => 30,
            "Field Service" => 35,
            "People / Operation" => 40,
            _ => 99
        };
    }

    string SectionSubtitle(string section)
    {
        return section switch
        {
            "รายงานหลัก" => "รายงานภาพรวมสำหรับผู้บริหารและการติดตามสถานะสำคัญ",
            "Projects" => "รายงานข้อมูลโครงการ งวดงาน การมอบหมาย และสถานะงาน",
            "Issues / Support" => "รายงานปัญหาและงาน Support ที่ต้องติดตาม",
            "QA / Test" => "รายงาน Test Scenario และผลการตรวจสอบ",
            "Field Service" => "รายงานงานเข้าไซต์ งานบริการ และผลการปฏิบัติงาน",
            "People / Operation" => "รายงานการติดตามงานและข้อมูลการลงเวลาของทีม",
            _ => "รายงานในหมวดนี้"
        };
    }

    var groupedReports = reports
        .GroupBy(x => SectionName(x.Group))
        .OrderBy(g => SectionOrder(g.Key))
        .ThenBy(g => g.Key)
        .ToList();
    var initialSection = groupedReports.FirstOrDefault()?.Key ?? "";
    var reportSequence = 0;

    string GroupIconPath(string group)
    {
        return group switch
        {
            "People / Operation" => "/images/menu-icons/attendance.svg",
            "Issues / Support" => "/images/menu-icons/issues.svg",
            "QA / Test" => "/images/menu-icons/test-scenarios.svg",
            "Field Service" => "/images/menu-icons/field-service.svg",
            "Project Phases" => "/images/menu-icons/phases.svg",
            "Projects" => "/images/menu-icons/projects.svg",
            "Issues" => "/images/menu-icons/issues.svg",
            "Support" => "/images/menu-icons/workload.svg",
            "Followups" => "/images/menu-icons/followups.svg",
            "Meetings" => "/images/menu-icons/meetings.svg",
            "Test Scenario" => "/images/menu-icons/test-scenarios.svg",
            "Attendance" => "/images/menu-icons/attendance.svg",
            "Executive" => "/images/menu-icons/reports.svg",
            _ => "/images/menu-icons/reports.svg"
        };
    }

    string ReportLabel(ProjectTracking.ViewModels.ReportCardViewModel report)
    {
        return report.IsPrimary ? "ผู้บริหาร" : report.Group;
    }
}

<div class="report-center-page">
    <div class="index-hero report-center-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="index-title">Report Center</h2>
            <p class="index-subtitle">ศูนย์รวมรายงานสำหรับประชุม ติดตามความเสี่ยง และพิมพ์ส่งผู้บริหาร</p>
        </div>
        <div class="report-hero-stats">
            <span>
                <strong>@reports.Count</strong>
                รายงาน
            </span>
            <span>
                <strong>@groupedReports.Count</strong>
                หมวด
            </span>
        </div>
    </div>

    @if (!reports.Any())
    {
        <div class="report-empty">
            ยังไม่มีสิทธิ์เข้าถึงรายงาน
        </div>
    }
    else
    {
        <section class="report-browser">
            <aside class="report-group-panel" aria-label="กลุ่มรายงาน">
                <div class="report-panel-heading">
                    <div>
                        <span>REPORT GROUPS</span>
                        <h3>กลุ่มรายงาน</h3>
                    </div>
                    <strong>@groupedReports.Count</strong>
                </div>
                <nav class="report-group-list">
                @foreach (var group in groupedReports)
                {
                    <button type="button"
                            class="report-group-option @(group.Key == initialSection ? "is-active" : "")"
                            data-report-filter="@group.Key"
                            data-report-subtitle="@SectionSubtitle(group.Key)"
                            data-report-count="@group.Count()">
                        <span class="report-group-option-icon">
                            <img src="@GroupIconPath(group.Key)" alt="" />
                        </span>
                        <span class="report-group-option-copy">
                            <strong>@group.Key</strong>
                            <small>@group.Count() รายงาน</small>
                        </span>
                        <span class="report-group-option-arrow" aria-hidden="true">›</span>
                    </button>
                }
                </nav>
            </aside>

            <div class="report-list-panel">
                <div class="report-panel-heading report-list-heading">
                    <div>
                        <span>AVAILABLE REPORTS</span>
                        <div>
                            <h3 id="reportListTitle">@initialSection</h3>
                            <small id="reportListSubtitle">@SectionSubtitle(initialSection)</small>
                        </div>
                    </div>
                    <strong id="reportListCount">@groupedReports.First().Count()</strong>
                </div>

                <div class="report-list">
                @foreach (var group in groupedReports)
                {
                    @foreach (var report in group)
                    {
                        reportSequence++;
                        <a class="report-card tone-@report.Tone @(group.Key == initialSection ? "" : "is-hidden")"
                           asp-controller="@report.Controller"
                           asp-action="@report.Action"
                           data-report-card
                           data-report-section="@group.Key"
                           data-report-text="@($"{report.Title} {report.Description} {report.Group} {group.Key}")">
                            <span class="report-card-code">@reportSequence.ToString("000")</span>
                            <span class="report-card-icon">
                                <img src="@report.Icon" alt="" />
                            </span>
                            <span class="report-card-body">
                                <span class="report-card-label">@ReportLabel(report)</span>
                                <strong>@report.Title</strong>
                                <small>@report.Description</small>
                            </span>
                            <span class="report-card-action">เปิดรายงาน <span aria-hidden="true">→</span></span>
                        </a>
                    }
                }
                </div>

                <div id="reportNoResult" class="report-empty" style="display:none;">
                    ไม่พบรายงานในกลุ่มนี้
                </div>
            </div>
        </section>
    }
</div>

<style>
    .report-center-page {
        color: #10233f;
    }

    .report-center-hero {
        flex-direction: row;
        align-items: flex-start;
        justify-content: space-between;
    }

    .report-hero-stats {
        flex: 0 0 auto;
        min-width: 0;
        display: flex;
        align-items: flex-start;
        justify-content: flex-end;
        gap: 18px;
        padding-top: 4px;
    }

    .report-hero-stats span {
        display: grid;
        justify-items: end;
        gap: 2px;
        min-width: 72px;
        color: #d8e6f7;
        font-weight: 800;
        line-height: 1.25;
        text-align: right;
    }

    .report-hero-stats span + span {
        padding-left: 18px;
        border-left: 1px solid rgba(255, 255, 255, .24);
    }

    .report-hero-stats strong {
        display: block;
        color: #fff;
        font-size: 1.55rem;
        font-weight: 900;
    }

    .report-card {
        --report-tone: #14b8a6;
        --report-tone-dark: #0f766e;
        --report-tone-soft: #e0f7f4;
        --report-tone-border: #9ee8df;
        min-height: 112px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 18px;
        padding: 18px 20px;
        border: 1px solid var(--report-tone-border);
        border-left: 6px solid var(--report-tone);
        border-radius: 16px;
        color: #10233f;
        background:
            linear-gradient(135deg, rgba(255,255,255,.98) 0%, rgba(255,255,255,.88) 58%, var(--report-tone-soft) 100%);
        box-shadow: 0 10px 22px rgba(15, 35, 64, .07);
        text-decoration: none;
        transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
    }

    .report-card:hover {
        color: #10233f;
        transform: translateY(-2px);
        box-shadow: 0 18px 34px rgba(15, 35, 64, .12);
    }

    .report-card-body {
        min-width: 0;
        display: grid;
        gap: 5px;
    }

    .report-card-label {
        width: max-content;
        max-width: 100%;
        display: inline-flex;
        align-items: center;
        min-height: 24px;
        padding: 0 9px;
        border-radius: 999px;
        color: var(--report-tone-dark);
        background: var(--report-tone-soft);
        font-size: .75rem;
        font-weight: 900;
    }

    .report-card-body strong {
        color: #10233f;
        font-size: 1.12rem;
        font-weight: 900;
        line-height: 1.25;
    }

    .report-card-body small {
        color: #64748b;
        font-size: .93rem;
        font-weight: 700;
        line-height: 1.45;
    }

    .report-card-action {
        min-width: 104px;
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        color: #fff;
        background: var(--report-tone);
        font-size: .9rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .report-card.tone-teal {
        --report-tone: #14b8a6;
        --report-tone-dark: #0f766e;
        --report-tone-soft: #d9fbf5;
        --report-tone-border: #8ce7dd;
    }

    .report-card.tone-blue {
        --report-tone: #258cfb;
        --report-tone-dark: #155cc8;
        --report-tone-soft: #dcebff;
        --report-tone-border: #9bc7ff;
    }

    .report-card.tone-green {
        --report-tone: #22c55e;
        --report-tone-dark: #15803d;
        --report-tone-soft: #dcfce7;
        --report-tone-border: #9ae6b4;
    }

    .report-card.tone-orange {
        --report-tone: #f59e0b;
        --report-tone-dark: #b45309;
        --report-tone-soft: #fff3d7;
        --report-tone-border: #f8c76d;
    }

    .report-card.tone-pink {
        --report-tone: #f43f5e;
        --report-tone-dark: #be123c;
        --report-tone-soft: #ffe4ec;
        --report-tone-border: #f9a8bc;
    }

    .report-card.tone-cyan {
        --report-tone: #22d3ee;
        --report-tone-dark: #0891b2;
        --report-tone-soft: #cffafe;
        --report-tone-border: #8be7f5;
    }

    .report-card.tone-purple {
        --report-tone: #8b5cf6;
        --report-tone-dark: #6d28d9;
        --report-tone-soft: #ede9fe;
        --report-tone-border: #c4b5fd;
    }

    .report-browser {
        display: grid;
        grid-template-columns: minmax(250px, 310px) minmax(0, 1fr);
        align-items: start;
        gap: 18px;
    }

    .report-group-panel,
    .report-list-panel {
        min-width: 0;
        overflow: hidden;
        border: 1px solid rgba(216, 227, 239, .96);
        border-radius: 18px;
        background: rgba(255, 255, 255, .9);
        box-shadow: 0 14px 32px rgba(15, 35, 64, .08);
    }

    .report-group-panel {
        position: sticky;
        top: 14px;
    }

    .report-panel-heading {
        min-height: 78px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 14px 16px;
        border-bottom: 1px solid #dbe7f3;
        background: linear-gradient(180deg, #f8fbff, #edf6ff);
    }

    .report-panel-heading > div {
        min-width: 0;
    }

    .report-panel-heading > div > span {
        display: block;
        margin-bottom: 3px;
        color: #64748b;
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .04em !important;
    }

    .report-panel-heading h3 {
        margin: 0;
        color: #10233f;
        font-size: 1.05rem;
        font-weight: 650;
        line-height: 1.3;
    }

    .report-panel-heading small {
        display: block;
        margin-top: 3px;
        color: #64748b;
        font-size: .78rem;
        font-weight: 400;
        line-height: 1.4;
    }

    .report-panel-heading > strong {
        flex: 0 0 auto;
        min-width: 32px;
        min-height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--pt-accent, #14b8a6);
        border-radius: 8px;
        color: var(--pt-accent-dark, #0f766e);
        background: #fff;
        font-size: .84rem;
        font-weight: 600;
    }

    .report-group-list {
        display: grid;
        gap: 5px;
        padding: 8px;
    }

    .report-group-option {
        width: 100%;
        min-height: 64px;
        display: grid;
        grid-template-columns: 38px minmax(0, 1fr) auto;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        border: 1px solid transparent;
        border-radius: 10px;
        color: #10233f;
        background: transparent;
        text-align: left;
        transition: background .16s ease, border-color .16s ease;
    }

    .report-group-option:hover,
    .report-group-option:focus-visible {
        border-color: #bfdbfe;
        color: #10233f;
        background: #eff6ff;
        outline: none;
    }

    .report-group-option.is-active {
        border-color: color-mix(in srgb, var(--pt-accent, #14b8a6) 52%, #dbe7f3);
        color: #10233f;
        background: var(--pt-accent-soft, rgba(20, 184, 166, .12));
    }

    .report-group-option-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        background: #fff;
        border: 1px solid #dbe7f3;
    }

    .report-group-option-icon img {
        width: 30px;
        height: 30px;
        object-fit: contain;
    }

    .report-group-option-copy {
        min-width: 0;
        display: grid;
        gap: 2px;
    }

    .report-group-option-copy strong {
        overflow: hidden;
        color: inherit;
        font-size: .9rem;
        font-weight: 600;
        line-height: 1.25;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .report-group-option-copy small {
        color: #64748b;
        font-size: .75rem;
        font-weight: 400;
    }

    .report-group-option-arrow {
        color: #94a3b8;
        font-size: 1.35rem;
        font-weight: 400;
    }

    .report-group-option.is-active .report-group-option-arrow {
        color: var(--pt-accent-dark, #0f766e);
    }

    .report-list-heading > div > div {
        min-width: 0;
    }

    .report-list {
        display: grid;
        gap: 7px;
        padding: 10px;
    }

    .report-list .report-card {
        min-height: 78px;
        grid-template-columns: 50px 40px minmax(0, 1fr) auto;
        gap: 10px;
        padding: 10px 12px;
        border-width: 1px;
        border-left-width: 4px;
        border-radius: 10px;
        background: #fff;
        box-shadow: none;
    }

    .report-list .report-card:hover,
    .report-list .report-card:focus-visible {
        border-color: var(--report-tone);
        color: #10233f;
        background: color-mix(in srgb, var(--report-tone-soft) 44%, #fff);
        box-shadow: 0 8px 18px rgba(15, 35, 64, .08);
        outline: none;
        transform: none;
    }

    .report-card.is-hidden {
        display: none !important;
    }

    .report-card-code {
        align-self: stretch;
        display: grid;
        place-items: center;
        border-right: 1px solid #dbe7f3;
        color: var(--report-tone-dark);
        font-size: .82rem;
        font-weight: 600;
    }

    .report-card-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        background: var(--report-tone-soft);
    }

    .report-card-icon img {
        width: 30px;
        height: 30px;
        object-fit: contain;
    }

    .report-list .report-card-body {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        column-gap: 9px;
        row-gap: 2px;
    }

    .report-list .report-card-label {
        grid-row: 1 / span 2;
        min-width: 66px;
        justify-content: center;
        border-radius: 6px;
        font-weight: 600;
    }

    .report-list .report-card-body strong {
        font-size: .94rem;
        font-weight: 600;
    }

    .report-list .report-card-body small {
        overflow: hidden;
        font-size: .78rem;
        font-weight: 400;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .report-list .report-card-action {
        min-width: 98px;
        min-height: 34px;
        gap: 7px;
        border-radius: 8px;
        font-size: .78rem;
        font-weight: 600;
    }

    .report-empty {
        padding: 34px 20px;
        border: 1px dashed #cbd5e1;
        border-radius: 18px;
        background: rgba(255,255,255,.72);
        color: #64748b;
        text-align: center;
        font-weight: 800;
    }

    @@media (max-width: 900px) {
        .report-browser {
            grid-template-columns: 1fr;
        }

        .report-group-panel {
            position: static;
        }

        .report-group-list {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .report-center-hero {
            flex-direction: column;
        }

        .report-group-list {
            grid-template-columns: 1fr;
        }

        .report-list .report-card {
            grid-template-columns: 42px 34px minmax(0, 1fr);
        }

        .report-list .report-card-action {
            grid-column: 3;
            width: max-content;
            min-width: 0;
            padding: 0 10px;
        }

        .report-list .report-card-body {
            grid-template-columns: 1fr;
        }

        .report-list .report-card-label {
            display: none;
        }

        .report-list .report-card-body small {
            white-space: normal;
        }

        .report-hero-stats {
            min-width: 0;
            width: 100%;
            justify-content: flex-start;
            gap: 16px;
            padding-top: 0;
        }

        .report-hero-stats span {
            justify-items: start;
            text-align: left;
        }

        .report-hero-stats span + span {
            padding-left: 16px;
        }
    }
</style>

<script>
(() => {
    const filterButtons = Array.from(document.querySelectorAll('[data-report-filter]'));
    const cards = Array.from(document.querySelectorAll('[data-report-card]'));
    const noResult = document.getElementById('reportNoResult');
    const listTitle = document.getElementById('reportListTitle');
    const listSubtitle = document.getElementById('reportListSubtitle');
    const listCount = document.getElementById('reportListCount');
    let activeFilter = filterButtons.find(button => button.classList.contains('is-active'))?.dataset.reportFilter || '';

    function applyReportFilter(button) {
        activeFilter = button?.dataset.reportFilter || activeFilter;
        let visibleCount = 0;

        cards.forEach(card => {
            const section = card.dataset.reportSection || '';
            const visible = section === activeFilter;
            card.classList.toggle('is-hidden', !visible);
            if (visible) visibleCount++;
        });

        filterButtons.forEach(item => item.classList.toggle('is-active', item === button));
        if (listTitle) listTitle.textContent = activeFilter;
        if (listSubtitle) listSubtitle.textContent = button?.dataset.reportSubtitle || '';
        if (listCount) listCount.textContent = String(visibleCount);

        if (noResult) {
            noResult.style.display = visibleCount > 0 ? 'none' : '';
        }
    }

    filterButtons.forEach(button => {
        button.addEventListener('click', () => {
            applyReportFilter(button);
        });
    });

    if (filterButtons.length > 0) {
        applyReportFilter(filterButtons.find(button => button.classList.contains('is-active')) || filterButtons[0]);
    }
})();
</script>

@using Microsoft.AspNetCore.Http
@model ProjectTracking.ViewModels.ReportCenterViewModel

@{
    ViewData["Title"] = "Report Center";

    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }

    var reports = (Model?.Reports ?? new List<ProjectTracking.ViewModels.ReportCardViewModel>())
        .Where(x => CanMenu(x.PermissionKey ?? $"{x.Controller}.{x.Action}"))
        .ToList();

    string SectionName(string group)
    {
        return group switch
        {
            "Executive" => "รายงานหลัก",
            "Project Phases" => "Projects",
            "Projects" => "Projects",
            "Issues" => "Issues / Support",
            "Support" => "Issues / Support",
            "Test Scenario" => "QA / Test",
            "Followups" => "People / Operation",
            "Meetings" => "People / Operation",
            "Attendance" => "People / Operation",
            _ => group
        };
    }

    int SectionOrder(string section)
    {
        return section switch
        {
            "รายงานหลัก" => 0,
            "Projects" => 10,
            "Issues / Support" => 20,
            "QA / Test" => 30,
            "People / Operation" => 40,
            _ => 99
        };
    }

    string SectionSubtitle(string section)
    {
        return section switch
        {
            "รายงานหลัก" => "รายงานภาพรวมสำหรับผู้บริหารและการติดตามสถานะสำคัญ",
            "Projects" => "รายงานข้อมูลโครงการ งวดงาน การมอบหมาย และสถานะงาน",
            "Issues / Support" => "รายงานปัญหาและงาน Support ที่ต้องติดตาม",
            "QA / Test" => "รายงาน Test Scenario และผลการตรวจสอบ",
            "People / Operation" => "รายงานการติดตามงานและข้อมูลการลงเวลาของทีม",
            _ => "รายงานในหมวดนี้"
        };
    }

    var groupedReports = reports
        .GroupBy(x => SectionName(x.Group))
        .OrderBy(g => SectionOrder(g.Key))
        .ThenBy(g => g.Key)
        .ToList();

    string GroupIconPath(string group)
    {
        return group switch
        {
            "People / Operation" => "/images/menu-icons/attendance.svg",
            "Issues / Support" => "/images/menu-icons/issues.svg",
            "QA / Test" => "/images/menu-icons/test-scenarios.svg",
            "Project Phases" => "/images/menu-icons/phases.svg",
            "Projects" => "/images/menu-icons/projects.svg",
            "Issues" => "/images/menu-icons/issues.svg",
            "Support" => "/images/menu-icons/workload.svg",
            "Followups" => "/images/menu-icons/followups.svg",
            "Meetings" => "/images/menu-icons/meetings.svg",
            "Test Scenario" => "/images/menu-icons/test-scenarios.svg",
            "Attendance" => "/images/menu-icons/attendance.svg",
            "Executive" => "/images/menu-icons/reports.svg",
            _ => "/images/menu-icons/reports.svg"
        };
    }

    string ReportLabel(ProjectTracking.ViewModels.ReportCardViewModel report)
    {
        return report.IsPrimary ? "ผู้บริหาร" : report.Group;
    }
}

<div class="report-center-page">
    <div class="index-hero report-center-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="index-title">Report Center</h2>
            <p class="index-subtitle">ศูนย์รวมรายงานสำหรับประชุม ติดตามความเสี่ยง และพิมพ์ส่งผู้บริหาร</p>
        </div>
        <div class="report-hero-stats">
            <span>
                <strong>@reports.Count</strong>
                รายงาน
            </span>
            <span>
                <strong>@reports.Select(x => x.Group).Distinct().Count()</strong>
                หมวด
            </span>
        </div>
    </div>

    @if (!reports.Any())
    {
        <div class="report-empty">
            ยังไม่มีสิทธิ์เข้าถึงรายงาน
        </div>
    }
    else
    {
        <section class="report-toolbar" aria-label="Report filters">
            <div class="report-filter-pills">
                <button type="button" class="report-filter-pill is-active" data-report-filter="all">ทั้งหมด</button>
                @foreach (var group in groupedReports)
                {
                    <button type="button" class="report-filter-pill" data-report-filter="@group.Key">@group.Key</button>
                }
            </div>
        </section>

        foreach (var group in groupedReports)
        {
            <section class="report-group" data-report-section-wrap="@group.Key">
                <div class="report-group-head">
                    <div class="report-group-title">
                        <span><img src="@GroupIconPath(group.Key)" alt="" /></span>
                        <div>
                            <h3>@group.Key</h3>
                            <small>@SectionSubtitle(group.Key)</small>
                        </div>
                    </div>
                    <span class="report-group-count">@group.Count() รายงาน</span>
                </div>
                <div class="report-card-grid">
                    @foreach (var report in group)
                    {
                        <a class="report-card tone-@report.Tone"
                           asp-controller="@report.Controller"
                           asp-action="@report.Action"
                           data-report-card
                           data-report-section="@group.Key"
                           data-report-text="@($"{report.Title} {report.Description} {report.Group} {group.Key}")">
                            <span class="report-card-body">
                                <span class="report-card-label">@ReportLabel(report)</span>
                                <strong>@report.Title</strong>
                                <small>@report.Description</small>
                            </span>
                            <span class="report-card-action">เปิดรายงาน</span>
                        </a>
                    }
                </div>
            </section>
        }

        <div id="reportNoResult" class="report-empty" style="display:none;">
            ไม่พบรายงานที่ค้นหา
        </div>
    }
</div>

<style>
    .report-center-page {
        color: #10233f;
    }

    .report-center-hero {
        align-items: stretch;
    }

    .report-hero-stats {
        flex: 0 0 auto;
        min-width: 260px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        align-content: center;
    }

    .report-hero-stats span {
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 16px;
        padding: 10px 12px;
        background: rgba(255,255,255,.08);
        color: #d8e6f7;
        font-weight: 800;
        line-height: 1.25;
    }

    .report-hero-stats strong {
        display: block;
        color: #fff;
        font-size: 1.45rem;
        font-weight: 900;
    }

    .report-toolbar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        margin-bottom: 16px;
        padding: 14px;
        border: 1px solid rgba(216, 227, 239, .92);
        border-radius: 22px;
        background: rgba(255,255,255,.78);
        box-shadow: 0 10px 24px rgba(15, 35, 64, .07);
    }

    .report-filter-pills {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
        width: 100%;
    }

    .report-filter-pill {
        min-height: 42px;
        border: 1px solid #c7d6e8;
        border-radius: 999px;
        padding: 0 16px;
        color: #0f2748;
        background: #fff;
        font-family: 'Prompt', sans-serif;
        font-weight: 800;
    }

    .report-filter-pill.is-active {
        border-color: #14b8a6;
        color: #063b3a;
        background: linear-gradient(135deg, #8df1e4, #23c7c8);
        box-shadow: 0 10px 22px rgba(20, 184, 166, .2);
    }

    .report-group {
        margin-bottom: 18px;
        padding: 18px;
        border: 1px solid rgba(216, 227, 239, .92);
        border-radius: 24px;
        background: rgba(255,255,255,.72);
        box-shadow: 0 14px 32px rgba(15, 35, 64, .08);
    }

    .report-group-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

    .report-group-title {
        display: inline-grid;
        grid-template-columns: auto 1fr;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .report-group-title > span {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: #0f766e;
        background: rgba(20, 184, 166, .13);
        font-weight: 900;
    }

    .report-group-title > span img {
        width: 42px;
        height: 42px;
        display: block;
        object-fit: contain;
        border-radius: 14px;
    }

    .report-group-head h3 {
        margin: 0;
        color: #10233f;
        font-size: 1.18rem;
        font-weight: 900;
    }

    .report-group-head small {
        color: #64748b;
        font-weight: 800;
    }

    .report-group-count {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        min-height: 34px;
        padding: 0 12px;
        border-radius: 999px;
        color: #0f766e;
        background: rgba(20, 184, 166, .12);
        font-size: .88rem;
        font-weight: 900;
    }

    .report-card-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .report-card {
        --report-tone: #14b8a6;
        --report-tone-dark: #0f766e;
        --report-tone-soft: #e0f7f4;
        --report-tone-border: #9ee8df;
        min-height: 112px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 18px;
        padding: 18px 20px;
        border: 1px solid var(--report-tone-border);
        border-left: 6px solid var(--report-tone);
        border-radius: 16px;
        color: #10233f;
        background:
            linear-gradient(135deg, rgba(255,255,255,.98) 0%, rgba(255,255,255,.88) 58%, var(--report-tone-soft) 100%);
        box-shadow: 0 10px 22px rgba(15, 35, 64, .07);
        text-decoration: none;
        transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
    }

    .report-card:hover {
        color: #10233f;
        transform: translateY(-2px);
        box-shadow: 0 18px 34px rgba(15, 35, 64, .12);
    }

    .report-card-body {
        min-width: 0;
        display: grid;
        gap: 5px;
    }

    .report-card-label {
        width: max-content;
        max-width: 100%;
        display: inline-flex;
        align-items: center;
        min-height: 24px;
        padding: 0 9px;
        border-radius: 999px;
        color: var(--report-tone-dark);
        background: var(--report-tone-soft);
        font-size: .75rem;
        font-weight: 900;
    }

    .report-card-body strong {
        color: #10233f;
        font-size: 1.12rem;
        font-weight: 900;
        line-height: 1.25;
    }

    .report-card-body small {
        color: #64748b;
        font-size: .93rem;
        font-weight: 700;
        line-height: 1.45;
    }

    .report-card-action {
        min-width: 104px;
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        color: #fff;
        background: var(--report-tone);
        font-size: .9rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .report-card.tone-teal {
        --report-tone: #14b8a6;
        --report-tone-dark: #0f766e;
        --report-tone-soft: #d9fbf5;
        --report-tone-border: #8ce7dd;
    }

    .report-card.tone-blue {
        --report-tone: #258cfb;
        --report-tone-dark: #155cc8;
        --report-tone-soft: #dcebff;
        --report-tone-border: #9bc7ff;
    }

    .report-card.tone-green {
        --report-tone: #22c55e;
        --report-tone-dark: #15803d;
        --report-tone-soft: #dcfce7;
        --report-tone-border: #9ae6b4;
    }

    .report-card.tone-orange {
        --report-tone: #f59e0b;
        --report-tone-dark: #b45309;
        --report-tone-soft: #fff3d7;
        --report-tone-border: #f8c76d;
    }

    .report-card.tone-pink {
        --report-tone: #f43f5e;
        --report-tone-dark: #be123c;
        --report-tone-soft: #ffe4ec;
        --report-tone-border: #f9a8bc;
    }

    .report-card.tone-cyan {
        --report-tone: #22d3ee;
        --report-tone-dark: #0891b2;
        --report-tone-soft: #cffafe;
        --report-tone-border: #8be7f5;
    }

    .report-card.tone-purple {
        --report-tone: #8b5cf6;
        --report-tone-dark: #6d28d9;
        --report-tone-soft: #ede9fe;
        --report-tone-border: #c4b5fd;
    }

    .report-empty {
        padding: 34px 20px;
        border: 1px dashed #cbd5e1;
        border-radius: 18px;
        background: rgba(255,255,255,.72);
        color: #64748b;
        text-align: center;
        font-weight: 800;
    }

    @@media (max-width: 575.98px) {
        .report-filter-pills {
            justify-content: flex-start;
        }

        .report-card {
            grid-template-columns: 1fr;
            align-items: start;
        }

        .report-card-action {
            width: 100%;
        }

        .report-hero-stats {
            min-width: 0;
            width: 100%;
        }
    }
</style>

<script>
(() => {
    const filterButtons = Array.from(document.querySelectorAll('[data-report-filter]'));
    const cards = Array.from(document.querySelectorAll('[data-report-card]'));
    const sections = Array.from(document.querySelectorAll('[data-report-section-wrap]'));
    const noResult = document.getElementById('reportNoResult');
    let activeFilter = 'all';

    function applyReportFilters() {
        let visibleCount = 0;

        cards.forEach(card => {
            const section = card.dataset.reportSection || '';
            const matchesSection = activeFilter === 'all' || section === activeFilter;
            const visible = matchesSection;

            card.style.display = visible ? '' : 'none';
            if (visible) visibleCount++;
        });

        sections.forEach(section => {
            const sectionName = section.dataset.reportSectionWrap || '';
            const hasVisibleCard = cards.some(card =>
                card.dataset.reportSection === sectionName && card.style.display !== 'none'
            );
            section.style.display = hasVisibleCard ? '' : 'none';
        });

        if (noResult) {
            noResult.style.display = visibleCount > 0 ? 'none' : '';
        }
    }

    filterButtons.forEach(button => {
        button.addEventListener('click', () => {
            activeFilter = button.dataset.reportFilter || 'all';
            filterButtons.forEach(item => item.classList.toggle('is-active', item === button));
            applyReportFilters();
        });
    });
})();
</script>

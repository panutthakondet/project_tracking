            width: calc(290px + var(--timeline-axis-width));
            min-width: calc(290px + var(--timeline-axis-width));
            display: grid;
            grid-template-columns: 290px var(--timeline-axis-width);
        }
        .timeline-head { min-height: 90px; color: var(--wd-muted); background: var(--wd-soft); border-bottom: 2px solid var(--wd-grid); }

            min-height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 6px 11px;
            border: 1px solid var(--wd-accent);
            color: var(--wd-accent-dark);
            background: transparent;
            font: inherit;
            font-size: 10px;
            font-weight: 700;
            cursor: pointer;
        }
        .section-control:hover,
        .section-control:focus-visible { color: #fff; background: var(--wd-accent); outline: none; }
        .completed-toggle-row { display: flex; align-items: center; justify-content: flex-end; margin-bottom: 9px; }
        .completed-item.is-hidden { display: none !important; }
        .section-default-empty { margin-bottom: 9px; padding: 10px 12px; color: var(--wd-muted); border: 1px dashed var(--wd-border); background: var(--wd-soft); font-size: 10px; text-align: center; }

        .timeline-months span { padding: 3px 4px; background: var(--month-head); }
        .timeline-months strong { color: var(--month-text); font-size: 11px; line-height: 1; }
        .timeline-weeks span { padding: 3px 2px; color: var(--month-text); background: var(--month-body); }
        .timeline-weeks strong { color: var(--month-text); font-size: 10px; line-height: 1; }
        .month-tone-0 { --month-head:#d9f7ef; --month-body:#f0fdfa; --month-text:#0f766e; }
        .month-tone-1 { --month-head:#dbeafe; --month-body:#eff6ff; --month-text:#1d4ed8; }
        .month-tone-2 { --month-head:#ede9fe; --month-body:#f5f3ff; --month-text:#6d28d9; }
        .month-tone-3 { --month-head:#fef3c7; --month-body:#fffbeb; --month-text:#b45309; }
        .month-tone-4 { --month-head:#ffe4e6; --month-body:#fff1f2; --month-text:#be123c; }
        .month-tone-5 { --month-head:#cffafe; --month-body:#ecfeff; --month-text:#0e7490; }
        .month-tone-6 { --month-head:#dcfce7; --month-body:#f0fdf4; --month-text:#15803d; }
        .month-tone-7 { --month-head:#f1f5f9; --month-body:#f8fafc; --month-text:#334155; }

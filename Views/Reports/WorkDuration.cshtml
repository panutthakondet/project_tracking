        .timeline-bar { position: absolute; z-index: 1; left: var(--left); width: var(--width); min-width: 3px; }
        .timeline-bar.plan { top: 13px; height: 12px; border: 2px solid var(--wd-planned); background: color-mix(in srgb, var(--wd-planned) 10%, transparent); }
        .timeline-bar.actual { top: 32px; height: 12px; background: var(--bar); }
        .timeline-bar.actual.status-fallback {
            background: repeating-linear-gradient(135deg, var(--bar) 0 7px, color-mix(in srgb, var(--bar) 68%, white) 7px 12px);
        }
        .table-wrap { overflow-x: auto; border: 1px solid var(--wd-border); }
        table { width: 100%; min-width: 1280px; border-collapse: collapse; }
        th, td { padding: 10px 11px; border-bottom: 1px solid var(--wd-border); text-align: left; vertical-align: top; }
        th { color: var(--wd-muted); background: var(--wd-soft); font-size: 10px; white-space: nowrap; }
        td { color: var(--wd-ink); font-size: 10px; }
        tbody tr:last-child td { border-bottom: 0; }
        .cell-main { display: block; font-weight: 600; }
        .cell-sub { display: block; margin-top: 2px; color: var(--wd-muted); font-size: 9px; font-weight: 400; }
        .status-result.success { color: var(--wd-success); }
        .status-result.danger { color: var(--wd-danger); }
        .status-result.info { color: var(--wd-blue); }
        .status-result.muted { color: var(--wd-muted); }
        .status { display: inline-flex; min-width: 92px; justify-content: center; padding: 5px 8px; border: 1px solid var(--status); color: var(--status); background: transparent; font-size: 9px; font-weight: 700; }
        .status.success { --status: var(--wd-success); }
        .status.warning { --status: var(--wd-warning); }
        .status.danger { --status: var(--wd-danger); }
        .status.muted { --status: var(--wd-planned); }
        .num { text-align: right; white-space: nowrap; }
        .empty { padding: 34px 18px; color: var(--wd-muted); border: 1px dashed var(--wd-border); background: var(--wd-soft); text-align: center; }
        .footer-note { margin: 12px 2px 0; color: var(--wd-muted); font-size: 10px; text-align: right; }
        @@media (max-width: 1360px) {
            .kpi-grid { grid-template-columns: repeat(4, 1fr); }
            .filters { grid-template-columns: 1fr 1.2fr 150px 150px auto; }
        }
        @@media print {
            @@page { size: A3 landscape; margin: 8mm; }
            html, body { min-width: 0; background: #fff !important; }
            .page { padding: 0; }
            body.pt-standalone-report .hero.print-header { color: #10233f !important; background: #fff !important; border: 1px solid #9fb1c3 !important; box-shadow: none !important; }
            body.pt-standalone-report .hero.print-header :is(h1, p, .eyebrow) { color: #10233f !important; -webkit-text-fill-color: #10233f !important; }
            body.pt-standalone-report .hero.print-header :is(p, .eyebrow) { color: #52657b !important; -webkit-text-fill-color: #52657b !important; }
            .hero-actions, .filter-panel, .section-control, .completed-toggle-row { display: none !important; }
            .section, .kpi { box-shadow: none; break-inside: avoid; }
            .employee-row { break-inside: avoid; }
        }
    </style>
    @await Html.PartialAsync("_StandaloneTheme")
</head>
<body class="pt-standalone-report">
    <main class="page">
        <header class="hero print-header">
            <div class="hero-copy">
                <div class="eyebrow">PROJECT TRACKING · EXECUTIVE ANALYTICS</div>
                <h1>วิเคราะห์สถานะและระยะเวลางาน</h1>
                <p>เปรียบเทียบแผนกับเวลาที่ใช้จริงจาก PhaseAssigns แบบรายฝ่าย รายบุคคล และภาพรวม</p>
            </div>
            <div class="hero-actions">
                <button type="button" class="btn report-btn" onclick="window.print()">พิมพ์รายงาน</button>
                <a asp-controller="Home" asp-action="Index" class="btn report-btn">กลับ Dashboard</a>
            </div>
        </header>

        <section class="filter-panel">
            <form method="get" asp-action="WorkDuration" class="filters" id="workDurationFilters">
                <div class="field">
                    <label for="departmentId">ฝ่าย</label>
                    <select id="departmentId" name="departmentId" data-placeholder="พิมพ์ค้นหาฝ่าย...">
                        <option value="0" selected="@(report.DepartmentFilterValue == 0 ? "selected" : null)">ทุกฝ่าย</option>
                        @foreach (var department in report.DepartmentOptions)
                        {
                            <option value="@department.DepartmentId" selected="@(report.DepartmentFilterValue == department.DepartmentId ? "selected" : null)">@department.DepartmentName</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="empId">ผู้รับผิดชอบ</label>
                    <select id="empId" name="empId" data-placeholder="พิมพ์ค้นหาผู้รับผิดชอบ...">
                        <option value="">พนักงานทั้งหมดในฝ่าย</option>
                        @foreach (var employee in report.EmployeeOptions)
                        {
                            <option value="@employee.EmpId" selected="@(report.EmpId == employee.EmpId ? "selected" : null)">@employee.EmpName</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="startDate">ตั้งแต่วันที่</label>
                    <input id="startDate" name="startDate" type="date" value="@DateInput(report.StartDate)" />
                </div>
                <div class="field">
                    <label for="endDate">ถึงวันที่</label>
                    <input id="endDate" name="endDate" type="date" value="@DateInput(report.EndDate)" />
                </div>
                <button class="btn primary filter-submit" type="submit">แสดงข้อมูล</button>
            </form>
            <div class="selection-note">
                กำลังแสดง <strong>@report.DepartmentName</strong>
                · @(report.EmpId.HasValue ? report.EmployeeOptions.FirstOrDefault(row => row.EmpId == report.EmpId)?.EmpName : "พนักงานทั้งหมด")
                · @DateText(report.StartDate) ถึง @DateText(report.EndDate)
            </div>
        </section>

        <section class="kpi-grid" aria-label="ข้อมูลสรุป">
            <article class="kpi"><span>โครงการทั้งหมด</span><strong>@report.Summary.TotalProjects</strong><small>โครงการไม่ซ้ำในช่วงที่เลือก</small></article>
            <article class="kpi blue"><span>งานทั้งหมด</span><strong>@report.Summary.Total</strong><small>PhaseAssigns ในช่วงที่เลือก</small></article>
            @foreach (var statusRow in workflowStatusRows)
            {
                <article class="kpi" style="--tone:@statusRow.Color"><span>@statusRow.Definition.StatusDesc</span><strong>@statusRow.Count</strong><small>จากตารางสถานะ Phase Assign</small></article>
            }
            <article class="kpi danger"><span>ล่าช้า</span><strong>@report.Summary.Overdue</strong><small>กำลังทำและเลย Plan End</small></article>
            <article class="kpi"><span>เฉลี่ยตามแผน</span><strong>@Number(report.Summary.AveragePlanDays)</strong><small>วันปฏิทินต่อรายการ</small></article>
            <article class="kpi"><span>เฉลี่ยเวลาที่ใช้</span><strong>@Number(report.Summary.AverageActualDays)</strong><small>วันปฏิทินต่อรายการ</small></article>
        </section>

        <section class="section">
            <div class="section-head">
                <div><h2>ภาพรวมสถานะงาน</h2><p>แถบสีแบ่งรายการแบบไม่ซ้ำ · งานที่เลย Plan End และยังไม่เสร็จจะแยกเป็นสีแดง “ล่าช้า”</p></div>
            </div>
            <div class="status-layout">
                <div class="completion">
                    <div class="donut"><strong>@report.Summary.CompletionPercent%</strong></div>
                    <div class="completion-copy">
                        <h3>ความคืบหน้าจากจำนวนงาน</h3>
                        <strong>@report.Summary.Completed / @report.Summary.Total รายการ</strong>
                        <p>นับงานสถานะเสร็จสิ้นเทียบกับงานทั้งหมดในตัวกรอง</p>
                    </div>
                </div>
                <div>
                    <div class="status-stack" aria-label="สัดส่วนสถานะงาน">
                        @foreach (var statusRow in workflowStatusRows)
                        {
                            <span title="@statusRow.Definition.StatusDesc: @statusRow.StackCount งาน"
                                  style="width:@Percent(statusRow.StackCount, report.Summary.Total)%; background:@statusRow.Color"></span>
                        }
                        @if (report.Summary.Overdue > 0)
                        {
                            <span title="ล่าช้า: @report.Summary.Overdue งาน"
                                  style="width:@Percent(report.Summary.Overdue, report.Summary.Total)%; background:var(--wd-danger)"></span>
                        }
                    </div>
                    <div class="status-numbers">
                        @foreach (var statusRow in workflowStatusRows)
                        {
                            <div class="status-number"><span><i class="dot" style="--dot:@statusRow.Color"></i>@statusRow.Definition.StatusDesc</span><strong>@statusRow.StackCount</strong></div>
                        }
                        <div class="status-number"><span><i class="dot" style="--dot:var(--wd-danger)"></i>ล่าช้า</span><strong>@report.Summary.Overdue</strong></div>
                    </div>
                    <p class="status-stack-note">จำนวนในกราฟส่วนนี้ไม่ซ้ำกัน โดยงานล่าช้าถูกแยกออกจากสถานะเดิมเฉพาะการแสดงผล</p>
                </div>
            </div>
        </section>

        <section class="section">
            <div class="section-head">
                <div><h2>แผนเทียบเวลาที่ใช้จริงรายคน</h2><p>แผน = ผลรวม Plan Start ถึง Plan End · เวลาที่ใช้ = Actual Start ถึง Actual End/วันนี้ · ตัวเลขขวาสุดเทียบวันจบจริงกับ Plan End</p></div>
                <div class="legend">
                    <span><i class="dot" style="--dot:var(--wd-blue)"></i>วันตามแผน</span>
                    <span><i class="dot" style="--dot:var(--wd-accent)"></i>วันที่ใช้จริง</span>
                </div>
            </div>
            @if (!report.Employees.Any())
            {
                <div class="empty">ไม่พบข้อมูลมอบหมายงานในช่วงที่เลือก</div>
            }
            else
            {
                <div class="employee-chart">
                    @foreach (var employee in report.Employees)
                    {
                        var planWidth = employee.PlanDays * 100m / maxEmployeeDays;
                        var actualWidth = employee.ActualDays * 100m / maxEmployeeDays;
                        <div class="employee-row">
                            <div class="employee-name"><strong>@employee.EmployeeName</strong><small>@employee.DepartmentName · @employee.Position · @employee.Total งาน</small></div>
                            <div class="duration-bars">
                                <div class="bar-track"><div class="bar-fill" style="--bar:var(--wd-blue); width:@planWidth.ToString("0.##", CultureInfo.InvariantCulture)%"></div></div>
                                <div class="bar-track"><div class="bar-fill" style="--bar:var(--wd-accent); width:@actualWidth.ToString("0.##", CultureInfo.InvariantCulture)%"></div></div>
                            </div>
                            <div class="employee-days"><strong>@employee.PlanDays</strong> / @employee.ActualDays วัน</div>
                            <div class="variance @(employee.VarianceDays > 0 ? "late" : employee.VarianceDays < 0 ? "early" : "")">@(employee.VarianceDays > 0 ? "+" : "")@employee.VarianceDays วัน</div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="section" id="timelineSection">
            <div class="section-head">
                <div><h2>Timeline แผนและการทำงานจริง</h2><p>กรอบสีเทาคือแผน · แถบสีด้านล่างใช้สีตามสถานะ PhaseAssign · ลายเฉียงคือรายการที่ยังไม่มีช่วงทำจริงที่วาดได้</p></div>
                <div class="section-head-actions">
                    <div class="legend">
                        @foreach (var statusRow in workflowStatusRows)
                        {
                            <span><i class="dot" style="--dot:@statusRow.Color"></i>@statusRow.Definition.StatusDesc</span>
                        }
                    </div>
                    <button type="button" class="section-control" data-collapse-target="timelineContent" aria-expanded="true">ย่อ</button>
                </div>
            </div>
            <div class="section-body" id="timelineContent">
                <div class="timeline-guide" aria-label="คำอธิบายสถานะและแถบ Timeline">
                    <div class="timeline-guide-item">
                        <strong>สีสถานะงาน</strong>
                        <span>ดึงจากตาราง phase_assign_status โดยตรง เช่น น้ำเงิน = กำลังดำเนินการ และเขียว = เสร็จสิ้น</span>
                    </div>
                    <div class="timeline-guide-item">
                        <strong>กรอบสีเทา</strong>
                        <span>ช่วงวันที่ตามแผนจาก Plan Start ถึง Plan End ไม่ใช่สถานะงาน</span>
                    </div>
                    <div class="timeline-guide-item">
                        <strong>แถบสีทึบ / ลายเฉียง</strong>
                        <span>สีทึบคือช่วงทำจริง ส่วนลายเฉียงคือยังไม่มีช่วงทำจริงที่วาดได้ จึงวางสีสถานะตามช่วงแผน</span>
                    </div>
                    <div class="timeline-guide-item">
                        <strong>ล่าช้า</strong>
                        <span>เป็นผลวิเคราะห์เมื่อยังไม่เสร็จและวันนี้เกิน Plan End ไม่ใช่สถานะใหม่ และไม่เปลี่ยนสีสถานะหลัก</span>
                    </div>
                </div>
                @if (completedTaskCount > 0)
                {
                    <div class="completed-toggle-row">
                        <button type="button"
                                class="section-control"
                                data-completed-toggle="timeline"
                                data-show-text="แสดงงานเสร็จสิ้น (@completedTaskCount)"
                                data-hide-text="ซ่อนงานเสร็จสิ้น (@completedTaskCount)"
                                aria-expanded="false">แสดงงานเสร็จสิ้น (@completedTaskCount)</button>
                    </div>
                }
                @if (!report.Tasks.Any())
                {
                    <div class="empty">ไม่พบ Timeline ในช่วงที่เลือก</div>
                }
                else
                {
                    @if (incompleteTaskCount == 0)
                    {
                        <div class="section-default-empty" data-default-empty="timeline">ไม่มีงานที่ยังไม่เสร็จสิ้น กด “แสดงงานเสร็จสิ้น” เพื่อดูรายการทั้งหมด</div>
                    }
                    <div class="timeline" style="--timeline-axis-width:@(timelineAxisWidth)px">
                    <div class="timeline-head">
                        <div>งาน / ผู้รับผิดชอบ</div>
                        <div class="timeline-axis">
                            <div class="timeline-years">
                                @foreach (var year in timelineYears)
                                {
                                    <span style="--cell-width:@year.Width.ToString("0.######", CultureInfo.InvariantCulture)%">
                                        <strong>@(year.Year + 543)</strong>
                                    </span>
                                }
                            </div>
                            <div class="timeline-months">
                                @foreach (var month in timelineMonths)
                                {
                                    <span class="month-tone-@month.Tone" style="--cell-width:@month.Width.ToString("0.######", CultureInfo.InvariantCulture)%" title="@DateText(month.Start) – @DateText(month.End)">
                                        <strong>@month.Start.ToString("MMM", th)</strong>
                                    </span>
                                }
                            </div>
                            <div class="timeline-weeks">
                                @foreach (var week in timelineWeeks)
                                {
                                    <span class="month-tone-@week.Tone" style="--cell-width:@week.Width.ToString("0.######", CultureInfo.InvariantCulture)%" title="@DateText(week.Start) – @DateText(week.End)">
                                        <strong>@week.Number</strong>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    @foreach (var task in report.Tasks)
                    {
                        var plan = TimelinePosition(task.PlanStart, task.PlanEnd);
                        var effectiveActualEnd = task.IsCompleted ? task.ActualEnd : task.HasStarted ? DateTime.Today : null;
                        var actual = task.IsCompleted || task.HasStarted
                            ? TimelinePosition(task.ActualStart, effectiveActualEnd)
                            : (Left: 0m, Width: 0m);
                        var statusUsesPlanFallback = actual.Width <= 0 && plan.Width > 0;
                        var statusBar = statusUsesPlanFallback ? plan : actual;
                        var actualColor = task.StatusColor;
                        var timelineLabelTooltip = $"งาน: {task.WorkName} | ผู้รับผิดชอบ: {task.EmployeeName} | โครงการ: {task.ProjectName}";
                        var planTooltip = $"แผน: {DateText(task.PlanStart)} – {DateText(task.PlanEnd)}";
                        var actualTooltip = statusUsesPlanFallback
                            ? $"สถานะ: {task.StatusText} · ยังไม่มีช่วงทำจริงที่วาดได้ จึงแสดงสีสถานะตามช่วงแผน"
                            : task.IsCompleted
                                ? $"ทำจริง: {DateText(task.ActualStart)} – {DateText(task.ActualEnd)} · {task.StatusText}"
                                : $"ทำจริง: {DateText(task.ActualStart)} – วันนี้ · {task.StatusText}";
                        <div class="timeline-row @(task.IsCompleted ? "completed-item is-hidden" : "")" data-completed-group="timeline">
                            <div class="timeline-label"
                                 title="@timelineLabelTooltip"
                                 aria-label="@timelineLabelTooltip">
                                <strong>@task.WorkName</strong>
                                <span>@task.EmployeeName · @task.ProjectName</span>
                            </div>
                            <div class="timeline-track">
                                <div class="timeline-week-cells" aria-hidden="true">
                                    @foreach (var week in timelineWeeks)
                                    {
                                        <span class="month-tone-@week.Tone" style="--cell-width:@week.Width.ToString("0.######", CultureInfo.InvariantCulture)%"></span>
                                    }
                                </div>
                                @if (plan.Width > 0)
                                {
                                    <span class="timeline-bar plan" title="@planTooltip" style="--left:@plan.Left.ToString("0.###", CultureInfo.InvariantCulture)%; --width:@plan.Width.ToString("0.###", CultureInfo.InvariantCulture)%"></span>
                                }
                                @if (statusBar.Width > 0)
                                {
                                    <span class="timeline-bar actual @(statusUsesPlanFallback ? "status-fallback" : "")"
                                          title="@actualTooltip"
                                          aria-label="@actualTooltip"
                                          style="--left:@statusBar.Left.ToString("0.###", CultureInfo.InvariantCulture)%; --width:@statusBar.Width.ToString("0.###", CultureInfo.InvariantCulture)%; --bar:@actualColor"></span>
                                }
                            </div>
                        </div>
                    }
                    </div>
                }
            </div>
        </section>

        <section class="section" id="workDetailSection">
            <div class="section-head">
                <div><h2>รายละเอียดงานและระยะเวลา</h2><p>Actual Start บันทึกอัตโนมัติจาก Plan Start และ Actual End บันทึกเมื่อสถานะเสร็จสิ้น</p></div>
                <button type="button" class="section-control" data-collapse-target="workDetailContent" aria-expanded="true">ย่อ</button>
            </div>
            <div class="section-body" id="workDetailContent">
                @if (completedTaskCount > 0)
                {
                    <div class="completed-toggle-row">
                        <button type="button"
                                class="section-control"
                                data-completed-toggle="details"
                                data-show-text="แสดงงานเสร็จสิ้น (@completedTaskCount)"
                                data-hide-text="ซ่อนงานเสร็จสิ้น (@completedTaskCount)"
                                aria-expanded="false">แสดงงานเสร็จสิ้น (@completedTaskCount)</button>
                    </div>
                }
                @if (!report.Tasks.Any())
                {
                    <div class="empty">ไม่พบรายการงาน</div>
                }
                else
                {
                    @if (incompleteTaskCount == 0)
                    {
                        <div class="section-default-empty" data-default-empty="details">ไม่มีงานที่ยังไม่เสร็จสิ้น กด “แสดงงานเสร็จสิ้น” เพื่อดูรายการทั้งหมด</div>
                    }
                    <div class="table-wrap">
                        <table>
                        <thead><tr><th>#</th><th>ผู้รับผิดชอบ</th><th>โครงการ / งาน</th><th>สถานะ</th><th>แผน</th><th>ทำจริง</th><th class="num">วันตามแผน</th><th class="num">วันที่ใช้</th><th class="num">ต่างจากแผน</th></tr></thead>
                        <tbody>
                            @{ var sequence = 1; }
                            @foreach (var task in report.Tasks)
                            {
                                var actualPeriodText = !task.ActualStart.HasValue
                                    ? "-"
                                    : !task.IsCompleted && !task.HasStarted
                                        ? "ยังไม่เริ่ม"
                                        : task.IsCompleted
                                            ? $"{DateText(task.ActualStart)} – {DateText(task.ActualEnd)}"
                                            : $"{DateText(task.ActualStart)} – วันนี้";
                                <tr class="@(task.IsCompleted ? "completed-item is-hidden" : "")" data-completed-group="details">
                                    <td>@sequence</td>
                                    <td><span class="cell-main">@task.EmployeeName</span><span class="cell-sub">@task.DepartmentName · @task.Position</span></td>
                                    <td><span class="cell-main">@task.WorkName</span><span class="cell-sub">@task.ProjectName</span></td>
                                    <td><span class="status" style="--status:@task.StatusColor">@task.StatusText</span><span class="cell-sub status-result @task.ScheduleTone">@task.ScheduleText</span></td>
                                    <td>@DateText(task.PlanStart) – @DateText(task.PlanEnd)</td>
                                    <td>@actualPeriodText</td>
                                    <td class="num">@task.PlanDays</td>
                                    <td class="num">@task.ActualDays</td>
                                    <td class="num">@(task.VarianceDays > 0 ? "+" : "")@task.VarianceDays</td>
                                </tr>
                                sequence++;
                            }
                        </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
        <div class="footer-note">อัปเดตข้อมูล @report.GeneratedAt.ToString("dd MMM yyyy HH:mm", th) · ผู้ใช้งาน @report.GeneratedBy</div>
    </main>
    <script>
        (() => {
            const form = document.getElementById('workDurationFilters');
            const department = document.getElementById('departmentId');
            const employee = document.getElementById('empId');

            function normalize(value) {
                return (value || '').toString().trim().toLocaleLowerCase('th-TH');
            }

            function getSelectedOption(select) {
                return select.options[select.selectedIndex] || null;
            }

            function dispatchSelectChange(select) {
                select.dispatchEvent(new Event('input', { bubbles: true }));
                select.dispatchEvent(new Event('change', { bubbles: true }));
            }

            function enhanceSelect(select) {
                if (!select || select.classList.contains('pt-dropdown-enhanced')) return;

                const wrapper = document.createElement('div');
                wrapper.className = 'pt-search-select';

                const input = document.createElement('input');
                input.type = 'text';
                input.className = 'pt-search-select__input';
                input.autocomplete = 'off';
                input.setAttribute('role', 'combobox');
                input.setAttribute('aria-expanded', 'false');
                input.placeholder = select.dataset.placeholder || 'พิมพ์ค้นหา...';

                const dropdown = document.createElement('div');
                dropdown.className = 'pt-search-select__dropdown';
                dropdown.setAttribute('role', 'listbox');

                select.insertAdjacentElement('afterend', wrapper);
                wrapper.appendChild(input);
                wrapper.appendChild(dropdown);
                select.classList.add('pt-dropdown-enhanced', 'pt-native-select-hidden');
                select.tabIndex = -1;

                function syncInput() {
                    const selected = getSelectedOption(select);
                    input.value = selected ? selected.text : '';
                }

                function closeDropdown() {
                    wrapper.classList.remove('is-open');
                    input.setAttribute('aria-expanded', 'false');
                }

                function renderOptions(filter = '') {
                    dropdown.innerHTML = '';
                    const keyword = normalize(filter);
                    const options = Array.from(select.options).filter(option =>
                        !keyword || normalize(`${option.text} ${option.value}`).includes(keyword));

                    if (!options.length) {
                        const empty = document.createElement('div');
                        empty.className = 'pt-search-select__empty';
                        empty.textContent = 'ไม่พบข้อมูล';
                        dropdown.appendChild(empty);
                        return;
                    }

                    options.forEach(option => {
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.className = 'pt-search-select__option';
                        button.setAttribute('role', 'option');
                        button.setAttribute('aria-selected', option.value === select.value ? 'true' : 'false');
                        if (option.value === select.value) button.classList.add('is-selected');
                        button.textContent = option.text;
                        button.addEventListener('click', () => {
                            select.value = option.value;
                            closeDropdown();
                            syncInput();
                            dispatchSelectChange(select);
                        });
                        dropdown.appendChild(button);
                    });
                }

                function openDropdown() {
                    input.value = '';
                    renderOptions();
                    wrapper.classList.add('is-open');
                    input.setAttribute('aria-expanded', 'true');
                }

                input.addEventListener('focus', openDropdown);
                input.addEventListener('click', openDropdown);
                input.addEventListener('input', () => {
                    renderOptions(input.value);
                    wrapper.classList.add('is-open');
                    input.setAttribute('aria-expanded', 'true');
                });
                input.addEventListener('keydown', event => {
                    if (event.key === 'Escape') {
                        closeDropdown();
                        syncInput();
                        input.blur();
                    }
                });
                select.addEventListener('change', syncInput);
                document.addEventListener('click', event => {
                    if (!wrapper.contains(event.target)) {
                        closeDropdown();
                        syncInput();
                    }
                });

                syncInput();
            }

            department?.addEventListener('change', () => {
                if (employee) employee.value = '';
                form?.requestSubmit();
            });
            employee?.addEventListener('change', () => form?.requestSubmit());
            document.querySelectorAll('#workDurationFilters select').forEach(enhanceSelect);

            document.querySelectorAll('[data-collapse-target]').forEach(button => {
                button.addEventListener('click', () => {
                    const target = document.getElementById(button.dataset.collapseTarget);
                    if (!target) return;

                    const willCollapse = !target.hidden;
                    target.hidden = willCollapse;
                    button.textContent = willCollapse ? 'ขยาย' : 'ย่อ';
                    button.setAttribute('aria-expanded', willCollapse ? 'false' : 'true');
                });
            });

            document.querySelectorAll('[data-completed-toggle]').forEach(button => {
                button.addEventListener('click', () => {
                    const group = button.dataset.completedToggle;
                    const willShow = button.getAttribute('aria-expanded') !== 'true';
                    document.querySelectorAll(`[data-completed-group="${group}"]`).forEach(item => {
                        item.classList.toggle('is-hidden', !willShow);
                    });

                    const defaultEmpty = document.querySelector(`[data-default-empty="${group}"]`);
                    if (defaultEmpty) defaultEmpty.hidden = willShow;

                    button.textContent = willShow ? button.dataset.hideText : button.dataset.showText;
                    button.setAttribute('aria-expanded', willShow ? 'true' : 'false');
                });
            });
        })();
    </script>
</body>
</html>

            --wd-accent-dark: var(--pt-accent-dark, #0c675f);
            --wd-success: #18a67f;
            --wd-warning: #f59e0b;
            --wd-danger: #ef476f;
            --wd-planned: #8291a7;
            --wd-blue: #2f6fec;

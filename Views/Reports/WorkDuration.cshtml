        .variance.late { color: var(--wd-danger); }
        .variance.early { color: var(--wd-success); }
        .timeline { width: fit-content; max-width: 100%; overflow-x: auto; overflow-y: hidden; border: 2px solid var(--wd-grid); scrollbar-color: var(--wd-accent) var(--wd-soft); }

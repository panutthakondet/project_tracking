@model ProjectTracking.ViewModels.WorkDurationReportViewModel
@using System.Globalization

@{
    Layout = null;
    var report = Model ?? new ProjectTracking.ViewModels.WorkDurationReportViewModel();
    var th = new CultureInfo("th-TH");
    var incompleteTaskCount = report.Tasks.Count(task => !task.IsCompleted);
    var completedTaskCount = report.Tasks.Count(task => task.IsCompleted);
    var workflowStatusRows = report.AssignStatusDefinitions
        .Select((definition, index) => new
        {
            Definition = definition,
            Count = report.Tasks.Count(task => string.Equals(task.WorkflowStatusCode, definition.StatusCode, StringComparison.OrdinalIgnoreCase)),
            StackCount = report.Tasks.Count(task =>
                string.Equals(task.WorkflowStatusCode, definition.StatusCode, StringComparison.OrdinalIgnoreCase)
                && !task.IsOverdue),
            Color = ProjectTracking.Services.WorkflowStatusPresentation.Color(definition, index)
        })
        .ToList();
    var timelineStart = new DateTime(report.StartDate.Year, report.StartDate.Month, 1);
    var timelineEnd = new DateTime(report.EndDate.Year, report.EndDate.Month, DateTime.DaysInMonth(report.EndDate.Year, report.EndDate.Month));
    var timelineMonthCount = ((timelineEnd.Year - timelineStart.Year) * 12) + timelineEnd.Month - timelineStart.Month + 1;
    var timelineColumnCount = Math.Max(4, timelineMonthCount * 4);
    var timelineMonths = new List<(DateTime Start, DateTime End, int Tone, decimal Width)>();
    var timelineWeeks = new List<(DateTime Start, DateTime End, int Number, int Tone, decimal Width)>();
    var monthCursor = timelineStart;
    var monthIndex = 0;
    while (monthCursor <= timelineEnd)
    {
        var calendarMonthEnd = new DateTime(monthCursor.Year, monthCursor.Month, DateTime.DaysInMonth(monthCursor.Year, monthCursor.Month));
        var tone = monthIndex % 8;
        timelineMonths.Add((monthCursor, calendarMonthEnd, tone, 400m / timelineColumnCount));
        for (var weekNumber = 1; weekNumber <= 4; weekNumber++)
        {
            var weekStartDay = weekNumber switch { 1 => 1, 2 => 8, 3 => 15, _ => 22 };
            var weekStart = new DateTime(monthCursor.Year, monthCursor.Month, weekStartDay);
            var weekEnd = weekNumber < 4 ? weekStart.AddDays(6) : calendarMonthEnd;
            timelineWeeks.Add((weekStart, weekEnd, weekNumber, tone, 100m / timelineColumnCount));
        }
        monthCursor = monthCursor.AddMonths(1);
        monthIndex++;
    }

    var timelineYears = timelineMonths
        .GroupBy(month => month.Start.Year)
        .Select(group => (Year: group.Key, Width: group.Count() * 400m / timelineColumnCount))
        .ToList();
    var timelineAxisWidth = timelineWeeks.Count * 24;
    var maxEmployeeDays = Math.Max(1, report.Employees.Select(row => Math.Max(row.PlanDays, row.ActualDays)).DefaultIfEmpty(1).Max());

    string DateText(DateTime? value) => value?.ToString("dd MMM yy", th) ?? "-";
    string DateInput(DateTime value) => value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    string Number(decimal value) => value.ToString("0.#", CultureInfo.InvariantCulture);
    string Percent(int value, int total) => total <= 0 ? "0" : (value * 100d / total).ToString("0.##", CultureInfo.InvariantCulture);

    (decimal Left, decimal Width) TimelinePosition(DateTime? start, DateTime? end)
    {
        if (!start.HasValue)
        {
            return (0, 0);
        }

        var clippedStart = start.Value.Date < report.StartDate.Date ? report.StartDate.Date : start.Value.Date;
        var rawEnd = end?.Date ?? clippedStart;
        var clippedEnd = rawEnd > report.EndDate.Date ? report.EndDate.Date : rawEnd;
        if (clippedEnd < report.StartDate.Date || clippedStart > report.EndDate.Date || clippedEnd < clippedStart)
        {
            return (0, 0);
        }

        decimal AxisCoordinate(DateTime date, bool afterDay)
        {
            var axisMonthIndex = ((date.Year - timelineStart.Year) * 12) + date.Month - timelineStart.Month;
            var weekIndex = date.Day <= 7 ? 0 : date.Day <= 14 ? 1 : date.Day <= 21 ? 2 : 3;
            var bucketStartDay = weekIndex switch { 0 => 1, 1 => 8, 2 => 15, _ => 22 };
            var bucketEndDay = weekIndex < 3 ? bucketStartDay + 6 : DateTime.DaysInMonth(date.Year, date.Month);
            var bucketDays = bucketEndDay - bucketStartDay + 1;
            var dayOffset = date.Day - bucketStartDay + (afterDay ? 1 : 0);
            return (axisMonthIndex * 4m) + weekIndex + ((decimal)dayOffset / bucketDays);
        }

        var leftCoordinate = AxisCoordinate(clippedStart, false);
        var rightCoordinate = AxisCoordinate(clippedEnd, true);
        var left = leftCoordinate * 100m / timelineColumnCount;
        var width = (rightCoordinate - leftCoordinate) * 100m / timelineColumnCount;
        return (left, Math.Max(width, .45m));
    }
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>วิเคราะห์สถานะและระยะเวลางาน</title>
    <style>

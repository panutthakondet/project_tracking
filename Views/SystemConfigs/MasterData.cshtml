@using Microsoft.AspNetCore.Http
@model ProjectTracking.ViewModels.SystemConfigMasterDataViewModel
@{
    var isDepartments = Model.ActiveSection == "departments";
    var isEmployeeDocumentTypes = Model.ActiveSection == "employee-document-types";
    var isProjectDocumentTypes = Model.ActiveSection == "project-document-types";
    var isAnnouncements = Model.ActiveSection == "announcements";
    var isDocumentTypes = isEmployeeDocumentTypes || isProjectDocumentTypes;
    var pageTitle = isAnnouncements
        ? "จัดการประกาศ"
        : isDepartments
        ? "จัดการฝ่าย"
        : isEmployeeDocumentTypes
            ? "ประเภทเอกสารพนักงาน"
            : isProjectDocumentTypes
                ? "ประเภทเอกสารโครงการ"
                : "จัดการตำแหน่ง";
    var activeCount = isAnnouncements
        ? Model.Announcements.Count
        : isDepartments
        ? Model.Departments.Count
        : isEmployeeDocumentTypes
            ? Model.EmployeeDocumentTypes.Count
            : isProjectDocumentTypes
                ? Model.ProjectDocumentTypes.Count
                : Model.Positions.Count;
    ViewData["Title"] = pageTitle;
    var role = (Context.Session.GetString("Role") ?? "").Trim();
    var allowedMenus = (Context.Session.GetString("Menus") ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim())
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var canManageHolidays = role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)
        || allowedMenus.Contains("AttendanceHolidays.Index");
}

<style>
    .master-config-page {
        color: var(--pt-surface-contrast, #10233f);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
    }

    .master-config-page * { text-shadow: none; }

    .master-config-layout {
        display: grid;
        grid-template-columns: minmax(250px, 310px) minmax(0, 1fr);
        align-items: start;
        gap: 18px;
    }

    .master-config-nav,
    .master-config-content {
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--pt-border, #d8e3ef);
        border-radius: 18px;
        background: var(--pt-surface, #fff);
        box-shadow: 0 14px 32px rgba(15, 35, 64, .08);
    }

    /* Reflow rows from the usable width of the right pane, not the whole viewport. */
    .master-config-content { container-type: inline-size; }

    .master-config-nav { position: sticky; top: 14px; }

    .master-config-heading {
        min-height: 78px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 16px;
        border-bottom: 1px solid var(--pt-border, #dbe7f3);
        background: var(--pt-surface-soft, #f8fbff);
    }

    .master-config-heading span {
        display: block;
        margin-bottom: 3px;
        color: var(--pt-surface-contrast-muted, #64748b);
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .04em;
    }

    .master-config-heading h2,
    .master-config-heading h3 {
        margin: 0;
        color: var(--pt-surface-contrast, #10233f);
        font-size: 1.05rem;
        font-weight: 650;
    }

    .master-config-heading strong {
        min-width: 34px;
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--pt-accent, #14b8a6);
        border-radius: 8px;
        color: var(--pt-accent-dark, #0f766e);
        background: var(--pt-surface, #fff);
        font-size: .84rem;
        font-weight: 600;
    }

    .master-config-nav-list { display: grid; gap: 5px; padding: 8px; }

    .master-config-nav-label {
        padding: 11px 10px 4px;
        color: var(--pt-surface-contrast-muted, #64748b);
        font-size: .7rem;
        font-weight: 650;
        letter-spacing: .04em;
    }

    .master-config-nav-link {
        min-height: 62px;
        display: grid;
        grid-template-columns: 38px minmax(0, 1fr) auto;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        border: 1px solid transparent;
        border-radius: 10px;
        color: var(--pt-surface-contrast, #10233f);
        text-decoration: none;
        transition: background .16s ease, border-color .16s ease;
    }

    .master-config-nav-link:hover,
    .master-config-nav-link.is-active {
        color: var(--pt-surface-contrast, #10233f);
        border-color: var(--pt-border, #bfdbfe);
        background: var(--pt-accent-soft, #eff6ff);
    }

    .master-config-nav-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border: 1px solid var(--pt-border, #dbe7f3);
        border-radius: 8px;
        background: var(--pt-surface, #fff);
    }

    .master-config-nav-icon img { width: 30px; height: 30px; object-fit: contain; }
    .master-config-nav-copy { min-width: 0; display: grid; gap: 2px; }
    .master-config-nav-copy strong { font-size: .9rem; font-weight: 600; }
    .master-config-nav-copy small { color: var(--pt-surface-contrast-muted, #64748b); font-size: .74rem; }
    .master-config-nav-arrow { color: var(--pt-surface-contrast-muted, #94a3b8); font-size: 1.3rem; }

    .master-config-body { padding: 16px; }

    .master-config-alert {
        margin-bottom: 14px;
        padding: 11px 14px;
        border: 1px solid;
        border-radius: 10px;
        font-size: .9rem;
        font-weight: 500;
    }

    .master-config-alert.success { color: #047857; border-color: #6ee7b7; background: #ecfdf5; }
    .master-config-alert.error { color: #b91c1c; border-color: #fecaca; background: #fef2f2; }

    .master-config-create {
        display: grid;
        gap: 12px;
        margin-bottom: 16px;
        padding: 14px;
        border: 1px solid var(--pt-border, #dbe7f3);
        border-radius: 12px;
        background: var(--pt-surface-soft, #f8fafc);
    }

    .master-config-create.position { grid-template-columns: minmax(220px, 1fr) 110px auto; }
    .master-config-create.department { grid-template-columns: 180px minmax(220px, 1fr) 110px auto; }
    .master-config-create.document { grid-template-columns: 170px minmax(220px, 1fr) 110px auto; }

    .announcement-editor {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 12px;
        padding: 16px;
        border: 1px solid var(--pt-border, #dbe7f3);
        border-radius: 12px;
        background: var(--pt-surface-soft, #f8fafc);
    }

    .announcement-editor + .announcement-editor { margin-top: 14px; }
    .announcement-editor.is-inactive { opacity: .74; }
    .announcement-field { grid-column: span 3; }
    .announcement-field.wide { grid-column: span 6; }
    .announcement-field.full { grid-column: 1 / -1; }
    .announcement-field textarea { min-height: 82px; resize: vertical; }
    .announcement-departments {
        grid-column: 1 / -1;
        display: grid;
        gap: 8px;
    }
    .announcement-department-list {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
    }
    .announcement-department {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 11px;
        border: 1px solid var(--pt-border, #dbe7f3);
        border-radius: 8px;
        color: var(--pt-surface-contrast, #10233f);
        background: var(--pt-surface, #fff);
        font-size: .82rem;
    }
    .announcement-department input { accent-color: var(--pt-accent, #14b8a6); }
    .announcement-hint { color: var(--pt-surface-contrast-muted, #64748b); font-size: .75rem; }
    .announcement-actions {
        grid-column: 1 / -1;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding-top: 2px;
    }
    .announcement-actions form { margin: 0; }
    .announcement-button-danger {
        min-height: 42px;
        padding: 8px 16px;
        border: 1px solid #ef4444;
        border-radius: 8px;
        color: #dc2626;
        background: var(--pt-surface, #fff);
        font-weight: 600;
    }

    .master-config-field { min-width: 0; display: grid; gap: 5px; }
    .master-config-field label { color: var(--pt-surface-contrast-muted, #64748b); font-size: .75rem; font-weight: 600; }

    .master-config-input {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        min-height: 42px;
        padding: 8px 11px;
        border: 1px solid var(--pt-border, #cbd5e1);
        border-radius: 8px;
        color: var(--pt-surface-contrast, #10233f);
        background: var(--pt-surface, #fff);
        font: inherit;
        font-size: .9rem;
    }

    .master-config-button {
        min-width: 0;
        box-sizing: border-box;
        min-height: 42px;
        align-self: end;
        padding: 8px 16px;
        border: 1px solid var(--pt-accent, #14b8a6);
        border-radius: 8px;
        color: #fff;
        background: var(--pt-accent-dark, #0f766e);
        font-weight: 600;
        white-space: nowrap;
    }

    .master-config-list { display: grid; gap: 9px; }

    .master-config-row {
        display: grid;
        align-items: end;
        gap: 10px;
        padding: 12px;
        border: 1px solid var(--pt-border, #dbe7f3);
        border-radius: 11px;
        background: var(--pt-surface, #fff);
    }

    .master-config-row.position { grid-template-columns: minmax(220px, 1fr) 90px 115px auto 150px; }
    .master-config-row.department { grid-template-columns: 150px minmax(220px, 1fr) 90px 145px auto 150px; }
    .master-config-row.document { grid-template-columns: 150px minmax(220px, 1fr) 90px 110px auto 150px; }

    .master-config-create > *,
    .master-config-row > * { min-width: 0; }

    .master-config-row.is-inactive .master-config-field,
    .master-config-row.is-inactive .master-config-usage { opacity: .68; }

    .master-config-usage {
        min-width: 0;
        min-height: 42px;
        display: flex;
        align-items: center;
        color: var(--pt-surface-contrast-muted, #64748b);
        font-size: .78rem;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .master-config-status {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        min-height: 42px;
        align-self: end;
        display: grid;
        grid-template-columns: 10px minmax(0, 1fr);
        align-items: center;
        gap: 9px;
        padding: 7px 10px;
        border: 1px solid var(--pt-border, #cbd5e1);
        border-radius: 8px;
        color: var(--pt-surface-contrast, #10233f);
        background: var(--pt-surface, #fff);
        text-align: left;
        transition: border-color .16s ease, background .16s ease, box-shadow .16s ease;
    }

    .master-config-status:hover,
    .master-config-status:focus-visible {
        border-color: var(--pt-accent, #14b8a6);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--pt-accent, #14b8a6) 16%, transparent);
        outline: none;
    }

    .master-config-status-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #94a3b8;
        box-shadow: 0 0 0 4px rgba(148, 163, 184, .14);
    }

    .master-config-status-copy { min-width: 0; display: grid; gap: 1px; }
    .master-config-status-copy strong { font-size: .8rem; font-weight: 650; line-height: 1.2; overflow-wrap: anywhere; }
    .master-config-status-copy small { color: var(--pt-surface-contrast-muted, #64748b); font-size: .68rem; font-weight: 500; overflow-wrap: anywhere; }

    .master-config-status.is-active {
        border-color: #6ee7b7;
        background: color-mix(in srgb, var(--pt-surface, #fff) 88%, #10b981);
    }

    .master-config-status.is-active .master-config-status-dot {
        background: #10b981;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, .14);
    }

    .master-config-status.is-inactive {
        border-color: #cbd5e1;
        background: color-mix(in srgb, var(--pt-surface, #fff) 92%, #94a3b8);
    }

    .master-config-empty { padding: 32px; text-align: center; color: var(--pt-surface-contrast-muted, #64748b); }

    /* The page sidebar and setting navigation reduce this pane below 1200px
       even on large screens.  Reflow all setting screens before controls can
       be clipped at the right edge. */
    @@container (max-width: 1220px) {
        .master-config-create.position,
        .master-config-create.department,
        .master-config-create.document,
        .master-config-row.position,
        .master-config-row.department,
        .master-config-row.document { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .announcement-field,
        .announcement-field.wide { grid-column: span 6; }
        .announcement-department-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @@container (max-width: 680px) {
        .master-config-create.position,
        .master-config-create.department,
        .master-config-create.document,
        .master-config-row.position,
        .master-config-row.department,
        .master-config-row.document { grid-template-columns: minmax(0, 1fr); }
        .announcement-field,
        .announcement-field.wide { grid-column: 1 / -1; }
        .announcement-department-list { grid-template-columns: 1fr; }
    }

    @@media (max-width: 1200px) {
        .master-config-create.position,
        .master-config-create.department,
        .master-config-create.document,
        .master-config-row.position,
        .master-config-row.department,
        .master-config-row.document { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @@media (max-width: 900px) {
        .master-config-layout { grid-template-columns: 1fr; }
        .master-config-nav { position: static; }
        .master-config-nav-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .master-config-nav-label { grid-column: 1 / -1; }
    }

    @@media (max-width: 620px) {
        .master-config-nav-list,
        .master-config-create.position,
        .master-config-create.department,
        .master-config-create.document,
        .master-config-row.position,
        .master-config-row.department,
        .master-config-row.document { grid-template-columns: 1fr; }
    }
</style>

<div class="master-config-page">
    <div class="index-hero pt-form-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h1 class="index-title">@pageTitle</h1>
            <p class="index-subtitle">จัดการข้อมูลกลางที่ใช้ร่วมกันทั้งระบบ</p>
        </div>
    </div>

    <section class="master-config-layout">
        <aside class="master-config-nav" aria-label="เมนูตั้งค่าระบบ">
            <div class="master-config-heading">
                <div>
                    <span>ตั้งค่าระบบ</span>
                    <h3>การตั้งค่าระบบ</h3>
                </div>
            </div>
            <nav class="master-config-nav-list">
                <div class="master-config-nav-label">ค่าระบบ</div>
                <a class="master-config-nav-link" asp-action="Index">
                    <span class="master-config-nav-icon"><img src="/images/menu-icons/settings.svg" alt="" /></span>
                    <span class="master-config-nav-copy"><strong>ค่าระบบ</strong><small>การแจ้งเตือนและค่ากลาง</small></span>
                    <span class="master-config-nav-arrow">›</span>
                </a>
                @if (canManageHolidays)
                {
                    <a class="master-config-nav-link" asp-controller="AttendanceHolidays" asp-action="Index">
                        <span class="master-config-nav-icon"><img src="/images/menu-icons/attendance.svg" alt="" /></span>
                        <span class="master-config-nav-copy"><strong>จัดการวันหยุด</strong><small>ปฏิทินวันหยุดบริษัท</small></span>
                        <span class="master-config-nav-arrow">›</span>
                    </a>
                }
                <a class="master-config-nav-link @(isAnnouncements ? "is-active" : "")" asp-action="MasterData" asp-route-type="announcements">
                    <span class="master-config-nav-icon"><img src="/images/menu-icons/meetings.svg" alt="" /></span>
                    <span class="master-config-nav-copy"><strong>จัดการประกาศ</strong><small>@Model.Announcements.Count ประกาศ</small></span>
                    <span class="master-config-nav-arrow">›</span>
                </a>

                <div class="master-config-nav-label">ข้อมูลบุคลากร</div>
                <a class="master-config-nav-link @(!isDepartments && !isDocumentTypes && !isAnnouncements ? "is-active" : "")" asp-action="MasterData" asp-route-type="positions">
                    <span class="master-config-nav-icon"><img src="/images/menu-icons/employees.svg" alt="" /></span>
                    <span class="master-config-nav-copy"><strong>จัดการตำแหน่ง</strong><small>@Model.Positions.Count ตำแหน่ง</small></span>
                    <span class="master-config-nav-arrow">›</span>
                </a>
                <a class="master-config-nav-link @(isDepartments ? "is-active" : "")" asp-action="MasterData" asp-route-type="departments">
                    <span class="master-config-nav-icon"><img src="/images/menu-icons/projects.svg" alt="" /></span>
                    <span class="master-config-nav-copy"><strong>จัดการฝ่าย</strong><small>@Model.Departments.Count ฝ่าย</small></span>
                    <span class="master-config-nav-arrow">›</span>
                </a>

                <div class="master-config-nav-label">เอกสาร</div>
                <a class="master-config-nav-link @(isEmployeeDocumentTypes ? "is-active" : "")" asp-action="MasterData" asp-route-type="employee-document-types">
                    <span class="master-config-nav-icon"><img src="/images/menu-icons/employees.svg" alt="" /></span>
                    <span class="master-config-nav-copy"><strong>ประเภทเอกสารพนักงาน</strong><small>@Model.EmployeeDocumentTypes.Count ประเภท</small></span>
                    <span class="master-config-nav-arrow">›</span>
                </a>
                <a class="master-config-nav-link @(isProjectDocumentTypes ? "is-active" : "")" asp-action="MasterData" asp-route-type="project-document-types">
                    <span class="master-config-nav-icon"><img src="/images/menu-icons/projects.svg" alt="" /></span>
                    <span class="master-config-nav-copy"><strong>ประเภทเอกสารโครงการ</strong><small>@Model.ProjectDocumentTypes.Count ประเภท</small></span>
                    <span class="master-config-nav-arrow">›</span>
                </a>
            </nav>
        </aside>

        <div class="master-config-content">
            <div class="master-config-heading">
                <div>
                    <span>ข้อมูลกลาง</span>
                    <h2>@(isAnnouncements ? "ประกาศ" : isDepartments ? "ฝ่าย" : isEmployeeDocumentTypes ? "ประเภทเอกสารพนักงาน" : isProjectDocumentTypes ? "ประเภทเอกสารโครงการ" : "ตำแหน่ง")</h2>
                </div>
                <strong>@activeCount</strong>
            </div>

            <div class="master-config-body">
                @if (TempData["Success"] != null)
                {
                    <div class="master-config-alert success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="master-config-alert error">@TempData["Error"]</div>
                }

                @if (isAnnouncements)
                {
                    <form asp-action="SaveAnnouncement" method="post" class="announcement-editor">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="updateId" value="0" />
                        <div class="master-config-field announcement-field wide">
                            <label for="newAnnouncementTitle">หัวข้อประกาศ *</label>
                            <input id="newAnnouncementTitle" class="master-config-input" name="title" maxlength="255" required placeholder="หัวข้อที่ต้องการแจ้งให้พนักงานทราบ" />
                        </div>
                        <div class="master-config-field announcement-field">
                            <label for="newAnnouncementVersion">รหัส/เวอร์ชัน (ถ้ามี)</label>
                            <input id="newAnnouncementVersion" class="master-config-input" name="version" maxlength="50" placeholder="เช่น ANN-001" />
                        </div>
                        <div class="master-config-field announcement-field full">
                            <label for="newAnnouncementSummary">ข้อความสรุป</label>
                            <textarea id="newAnnouncementSummary" class="master-config-input" name="summary" maxlength="500" placeholder="ข้อความสั้นที่แสดงใต้หัวข้อ"></textarea>
                        </div>
                        <div class="master-config-field announcement-field full">
                            <label for="newAnnouncementDetails">รายละเอียดประกาศ</label>
                            <textarea id="newAnnouncementDetails" class="master-config-input" name="details" maxlength="10000" placeholder="รายละเอียดประกาศฉบับเต็ม"></textarea>
                        </div>
                        <div class="master-config-field announcement-field">
                            <label for="newAnnouncementStartDate">วันที่เริ่มแสดง *</label>
                            <input id="newAnnouncementStartDate" class="master-config-input" name="startDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="master-config-field announcement-field">
                            <label for="newAnnouncementEndDate">วันที่สิ้นสุด</label>
                            <input id="newAnnouncementEndDate" class="master-config-input" name="endDate" type="date" />
                        </div>
                        <div class="master-config-field announcement-field">
                            <label for="newAnnouncementMaxDisplays">จำนวนครั้งที่แสดงต่อคน/วัน *</label>
                            <input id="newAnnouncementMaxDisplays" class="master-config-input" name="maxDisplaysPerDay" type="number" min="1" max="99" value="1" required />
                        </div>
                        <div class="announcement-departments">
                            <div>
                                <strong>ฝ่ายที่ต้องการประกาศ</strong>
                                <div class="announcement-hint">เลือกได้หลายฝ่าย หากไม่เลือก ระบบจะแสดงประกาศกับทุกฝ่าย</div>
                            </div>
                            <div class="announcement-department-list">
                                @foreach (var department in Model.Departments.Where(x => x.IsActive))
                                {
                                    <label class="announcement-department">
                                        <input type="checkbox" name="departmentIds" value="@department.DepartmentId" />
                                        <span>@department.DepartmentName</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="announcement-actions">
                            <button class="master-config-button" type="submit">＋ เพิ่มประกาศ</button>
                        </div>
                    </form>

                    @if (Model.Announcements.Count == 0)
                    {
                        <div class="master-config-empty">ยังไม่มีประกาศในระบบ</div>
                    }
                    else
                    {
                        <div class="master-config-list" style="margin-top:14px">
                            @foreach (var item in Model.Announcements)
                            {
                                var announcementFormId = $"announcementForm{item.UpdateId}";
                                <form id="@announcementFormId" asp-action="SaveAnnouncement" method="post" class="announcement-editor @(!item.IsActive ? "is-inactive" : "")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="updateId" value="@item.UpdateId" />
                                    <div class="master-config-field announcement-field wide">
                                        <label>หัวข้อประกาศ *</label>
                                        <input class="master-config-input" name="title" maxlength="255" value="@item.Title" required />
                                    </div>
                                    <div class="master-config-field announcement-field">
                                        <label>รหัส/เวอร์ชัน (ถ้ามี)</label>
                                        <input class="master-config-input" name="version" maxlength="50" value="@item.Version" />
                                    </div>
                                    <div class="master-config-field announcement-field full">
                                        <label>ข้อความสรุป</label>
                                        <textarea class="master-config-input" name="summary" maxlength="500">@item.Summary</textarea>
                                    </div>
                                    <div class="master-config-field announcement-field full">
                                        <label>รายละเอียดประกาศ</label>
                                        <textarea class="master-config-input" name="details" maxlength="10000">@item.Details</textarea>
                                    </div>
                                    <div class="master-config-field announcement-field">
                                        <label>วันที่เริ่มแสดง *</label>
                                        <input class="master-config-input" name="startDate" type="date" value="@item.StartDate.ToString("yyyy-MM-dd")" required />
                                    </div>
                                    <div class="master-config-field announcement-field">
                                        <label>วันที่สิ้นสุด</label>
                                        <input class="master-config-input" name="endDate" type="date" value="@(item.EndDate?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                    <div class="master-config-field announcement-field">
                                        <label>จำนวนครั้งที่แสดงต่อคน/วัน *</label>
                                        <input class="master-config-input" name="maxDisplaysPerDay" type="number" min="1" max="99" value="@item.MaxDisplaysPerDay" required />
                                    </div>
                                    <div class="announcement-departments">
                                        <div>
                                            <strong>ฝ่ายที่ประกาศ: @item.DepartmentNames</strong>
                                            <div class="announcement-hint">เลือกได้หลายฝ่าย หากไม่เลือก ระบบจะแสดงประกาศกับทุกฝ่าย</div>
                                        </div>
                                        <div class="announcement-department-list">
                                            @foreach (var department in Model.Departments.Where(x => x.IsActive || item.DepartmentIds.Contains(x.DepartmentId)))
                                            {
                                                <label class="announcement-department">
                                                    <input type="checkbox" name="departmentIds" value="@department.DepartmentId" @(item.DepartmentIds.Contains(department.DepartmentId) ? "checked" : null) />
                                                    <span>@department.DepartmentName</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                    <div class="announcement-actions">
                                        <button class="master-config-status @(item.IsActive ? "is-active" : "is-inactive")" type="submit" formaction="@Url.Action("ToggleAnnouncement")" formnovalidate>
                                            <span class="master-config-status-dot" aria-hidden="true"></span>
                                            <span class="master-config-status-copy"><strong>@(item.IsActive ? "เปิดใช้งาน" : "ปิดใช้งาน")</strong><small>กดเพื่อปรับสถานะ</small></span>
                                        </button>
                                        <button class="announcement-button-danger" type="submit" formaction="@Url.Action("DeleteAnnouncement")" formnovalidate onclick="return confirm('ยืนยันลบประกาศนี้?');">ลบ</button>
                                        <button class="master-config-button" type="submit">บันทึกข้อมูล</button>
                                    </div>
                                </form>
                            }
                        </div>
                    }
                }
                else if (isDocumentTypes)
                {
                    var documentTypes = isEmployeeDocumentTypes ? Model.EmployeeDocumentTypes : Model.ProjectDocumentTypes;
                    var saveAction = isEmployeeDocumentTypes ? "SaveEmployeeDocumentType" : "SaveProjectDocumentType";
                    var toggleAction = isEmployeeDocumentTypes ? "ToggleEmployeeDocumentType" : "ToggleProjectDocumentType";
                    var documentLabel = isEmployeeDocumentTypes ? "เอกสารพนักงาน" : "เอกสารโครงการ";
                    <form asp-action="@saveAction" method="post" class="master-config-create document">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="documentTypeId" value="0" />
                        <div class="master-config-field">
                            <label for="newDocumentTypeCode">รหัสประเภท</label>
                            <input id="newDocumentTypeCode" class="master-config-input" name="documentTypeCode" maxlength="20" required placeholder="เช่น ID_CARD" />
                        </div>
                        <div class="master-config-field">
                            <label for="newDocumentTypeName">ชื่อประเภทเอกสาร</label>
                            <input id="newDocumentTypeName" class="master-config-input" name="documentTypeName" maxlength="100" required placeholder="ชื่อประเภทเอกสาร" />
                        </div>
                        <div class="master-config-field">
                            <label for="newDocumentTypeSort">ลำดับ</label>
                            <input id="newDocumentTypeSort" class="master-config-input" name="sortOrder" type="number" value="@((documentTypes.LastOrDefault()?.SortOrder ?? 0) + 10)" />
                        </div>
                        <button class="master-config-button" type="submit">＋ เพิ่มประเภท</button>
                    </form>

                    <div class="master-config-list">
                        @foreach (var item in documentTypes)
                        {
                            <form asp-action="@saveAction" method="post" class="master-config-row document @(!item.IsActive ? "is-inactive" : "")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="documentTypeId" value="@item.DocumentTypeId" />
                                <div class="master-config-field"><label>รหัสประเภท</label><input class="master-config-input" name="documentTypeCode" value="@item.DocumentTypeCode" maxlength="20" required /></div>
                                <div class="master-config-field"><label>ชื่อประเภทเอกสาร</label><input class="master-config-input" name="documentTypeName" value="@item.DocumentTypeName" maxlength="100" required /></div>
                                <div class="master-config-field"><label>ลำดับ</label><input class="master-config-input" name="sortOrder" type="number" value="@item.SortOrder" /></div>
                                <div class="master-config-usage">ใช้แล้ว @item.DocumentCount ไฟล์</div>
                                <button class="master-config-button" type="submit">บันทึกข้อมูล</button>
                                <button class="master-config-status @(item.IsActive ? "is-active" : "is-inactive")" type="submit" formaction="@Url.Action(toggleAction)" formnovalidate>
                                    <span class="master-config-status-dot" aria-hidden="true"></span>
                                    <span class="master-config-status-copy">
                                        <strong>@(item.IsActive ? "เปิดใช้งาน" : "ปิดใช้งาน")</strong>
                                        <small>ปรับสถานะ</small>
                                    </span>
                                </button>
                            </form>
                        }
                    </div>
                }
                else if (isDepartments)
                {
                    <form asp-action="SaveDepartment" method="post" class="master-config-create department">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="departmentId" value="0" />
                        <div class="master-config-field">
                            <label for="newDepartmentCode">รหัสฝ่าย</label>
                            <input id="newDepartmentCode" class="master-config-input" name="departmentCode" maxlength="50" required placeholder="เช่น BD" />
                        </div>
                        <div class="master-config-field">
                            <label for="newDepartmentName">ชื่อฝ่าย</label>
                            <input id="newDepartmentName" class="master-config-input" name="departmentName" maxlength="150" required placeholder="ชื่อฝ่าย" />
                        </div>
                        <div class="master-config-field">
                            <label for="newDepartmentSort">ลำดับ</label>
                            <input id="newDepartmentSort" class="master-config-input" name="sortOrder" type="number" value="@((Model.Departments.LastOrDefault()?.SortOrder ?? 0) + 10)" />
                        </div>
                        <button class="master-config-button" type="submit">＋ เพิ่มฝ่าย</button>
                    </form>

                    <div class="master-config-list">
                        @foreach (var item in Model.Departments)
                        {
                            <form asp-action="SaveDepartment" method="post" class="master-config-row department @(!item.IsActive ? "is-inactive" : "")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="departmentId" value="@item.DepartmentId" />
                                <div class="master-config-field"><label>รหัสฝ่าย</label><input class="master-config-input" name="departmentCode" value="@item.DepartmentCode" maxlength="50" required /></div>
                                <div class="master-config-field"><label>ชื่อฝ่าย</label><input class="master-config-input" name="departmentName" value="@item.DepartmentName" maxlength="150" required /></div>
                                <div class="master-config-field"><label>ลำดับ</label><input class="master-config-input" name="sortOrder" type="number" value="@item.SortOrder" /></div>
                                <div class="master-config-usage">พนักงาน @item.EmployeeCount คน<br />โครงการ @item.ProjectCount รายการ</div>
                                <button class="master-config-button" type="submit">บันทึกข้อมูล</button>
                                <button class="master-config-status @(item.IsActive ? "is-active" : "is-inactive")" type="submit" formaction="@Url.Action("ToggleDepartment")" formnovalidate>
                                    <span class="master-config-status-dot" aria-hidden="true"></span>
                                    <span class="master-config-status-copy">
                                        <strong>@(item.IsActive ? "เปิดใช้งาน" : "ปิดใช้งาน")</strong>
                                        <small>ปรับสถานะ</small>
                                    </span>
                                </button>
                            </form>
                        }
                    </div>
                }
                else
                {
                    <form asp-action="SavePosition" method="post" class="master-config-create position">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="positionId" value="0" />
                        <div class="master-config-field">
                            <label for="newPositionName">ชื่อตำแหน่ง</label>
                            <input id="newPositionName" class="master-config-input" name="positionName" maxlength="150" required placeholder="ชื่อตำแหน่ง" />
                        </div>
                        <div class="master-config-field">
                            <label for="newPositionSort">ลำดับ</label>
                            <input id="newPositionSort" class="master-config-input" name="sortOrder" type="number" value="@((Model.Positions.LastOrDefault()?.SortOrder ?? 0) + 10)" />
                        </div>
                        <button class="master-config-button" type="submit">＋ เพิ่มตำแหน่ง</button>
                    </form>

                    <div class="master-config-list">
                        @foreach (var item in Model.Positions)
                        {
                            <form asp-action="SavePosition" method="post" class="master-config-row position @(!item.IsActive ? "is-inactive" : "")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="positionId" value="@item.PositionId" />
                                <div class="master-config-field"><label>ชื่อตำแหน่ง</label><input class="master-config-input" name="positionName" value="@item.PositionName" maxlength="150" required /></div>
                                <div class="master-config-field"><label>ลำดับ</label><input class="master-config-input" name="sortOrder" type="number" value="@item.SortOrder" /></div>
                                <div class="master-config-usage">พนักงาน @item.EmployeeCount คน</div>
                                <button class="master-config-button" type="submit">บันทึกข้อมูล</button>
                                <button class="master-config-status @(item.IsActive ? "is-active" : "is-inactive")" type="submit" formaction="@Url.Action("TogglePosition")" formnovalidate>
                                    <span class="master-config-status-dot" aria-hidden="true"></span>
                                    <span class="master-config-status-copy">
                                        <strong>@(item.IsActive ? "เปิดใช้งาน" : "ปิดใช้งาน")</strong>
                                        <small>ปรับสถานะ</small>
                                    </span>
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
</div>

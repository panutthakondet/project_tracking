@using Microsoft.AspNetCore.Http
@model ProjectTracking.ViewModels.SystemConfigPageViewModel
@{
    ViewData["Title"] = "System Config";
    var groups = Model.Items.GroupBy(x => x.Group).ToList();
    var initialGroup = groups.FirstOrDefault()?.Key ?? "";
    var configPreferenceUser = (Context.Session.GetString("Username") ?? "anonymous")
        .Trim()
        .ToLowerInvariant();
    var role = (Context.Session.GetString("Role") ?? "").Trim();
    var allowedMenus = (Context.Session.GetString("Menus") ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim())
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var canManageHolidays = role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)
        || allowedMenus.Contains("AttendanceHolidays.Index");
    var index = 0;

    string GroupSubtitle(string group)
    {
        return group switch
        {
            "Auto Meetings" => "เวลาส่งแจ้งเตือนประชุมอัตโนมัติ",
            "Auto Overdue" => "เวลาส่งและจำนวนวันที่ใช้ตรวจงานล่าช้า/เสี่ยงล่าช้า",
            "LINE Notification" => "เปิด/ปิดการส่ง LINE ตามเหตุการณ์",
            "Telegram Notification" => "เปิด/ปิดการส่ง Telegram ตามเหตุการณ์",
            "Attendance" => "ค่ากลางสำหรับการลงเวลา",
            _ => "ค่ากลางอื่นของระบบ"
        };
    }

    string GroupIconPath(string group)
    {
        return group switch
        {
            "Auto Meetings" => "/images/menu-icons/meetings.svg",
            "Auto Overdue" => "/images/menu-icons/issues.svg",
            "LINE Notification" => "/images/menu-icons/followups.svg",
            "Telegram Notification" => "/images/menu-icons/reports.svg",
            "Attendance" => "/images/menu-icons/attendance.svg",
            _ => "/images/menu-icons/settings.svg"
        };
    }
}

<style>
    .system-config-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
        color: #111827;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
    }

    .system-config-page * {
        letter-spacing: 0;
        text-shadow: none;
    }

    .system-config-hero {
        width: 100%;
        max-width: 100%;
        margin-left: 0;
        margin-right: 0;
    }

    .system-config-panel {
        padding: 0;
    }

    .system-config-browser {
        display: grid;
        grid-template-columns: minmax(250px, 310px) minmax(0, 1fr);
        align-items: start;
        gap: 18px;
    }

    .system-config-nav,
    .system-config-content {
        min-width: 0;
        overflow: hidden;
        color: var(--pt-surface-contrast, #10233f);
        border: 1px solid var(--pt-border, #d8e3ef);
        border-radius: 18px;
        background: var(--pt-surface, rgba(255, 255, 255, .94));
        box-shadow: 0 14px 32px rgba(15, 35, 64, .08);
    }

    .system-config-nav {
        position: sticky;
        top: 14px;
    }

    .system-config-panel-heading {
        min-height: 78px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 14px 16px;
        border-bottom: 1px solid var(--pt-border, #dbe7f3);
        background: var(--pt-surface-soft, linear-gradient(180deg, #f8fbff, #edf6ff));
    }

    .system-config-panel-heading > div {
        min-width: 0;
    }

    .system-config-panel-heading span {
        display: block;
        margin-bottom: 3px;
        color: var(--pt-surface-contrast-muted, #64748b);
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .04em;
    }

    .system-config-panel-heading h3 {
        margin: 0;
        color: var(--pt-surface-contrast, #10233f);
        font-size: 1.05rem;
        font-weight: 650;
        line-height: 1.3;
    }

    .system-config-panel-heading small {
        display: block;
        margin-top: 3px;
        overflow: hidden;
        color: var(--pt-surface-contrast-muted, #64748b);
        font-size: .78rem;
        font-weight: 400;
        line-height: 1.4;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .system-config-panel-heading > strong {
        flex: 0 0 auto;
        min-width: 32px;
        min-height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--pt-accent-dark, #0f766e);
        background: var(--pt-surface, #fff);
        border: 1px solid var(--pt-accent, #14b8a6);
        border-radius: 8px;
        font-size: .84rem;
        font-weight: 600;
    }

    .system-config-nav-list {
        display: grid;
        gap: 5px;
        padding: 8px;
    }

    .system-config-nav-option {
        width: 100%;
        min-height: 64px;
        display: grid;
        grid-template-columns: 38px minmax(0, 1fr) auto;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        color: var(--pt-surface-contrast, #10233f);
        background: transparent;
        border: 1px solid transparent;
        border-radius: 10px;
        text-align: left;
        transition: background .16s ease, border-color .16s ease;
    }

    .system-config-nav-link {
        text-decoration: none;
    }

    .system-config-nav-section {
        margin: 5px 4px 0;
        padding: 10px 6px 3px;
        border-top: 1px solid var(--pt-border, #dbe7f3);
        color: var(--pt-surface-contrast-muted, #64748b);
        font-size: .7rem;
        font-weight: 650;
        letter-spacing: .04em;
    }

    .system-config-nav-option:hover,
    .system-config-nav-option:focus-visible {
        color: var(--pt-surface-contrast, #10233f);
        background: var(--pt-accent-soft, #eff6ff);
        border-color: var(--pt-border, #bfdbfe);
        outline: none;
    }

    .system-config-nav-option.is-active {
        color: var(--pt-surface-contrast, #10233f);
        background: var(--pt-accent-soft, rgba(20, 184, 166, .12));
        border-color: color-mix(in srgb, var(--pt-accent, #14b8a6) 52%, var(--pt-border, #dbe7f3));
    }

    .system-config-nav-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border: 1px solid var(--pt-border, #dbe7f3);
        border-radius: 8px;
        background: var(--pt-surface, #fff);
    }

    .system-config-nav-icon img {
        width: 30px;
        height: 30px;
        object-fit: contain;
    }

    .system-config-nav-copy {
        min-width: 0;
        display: grid;
        gap: 2px;
    }

    .system-config-nav-copy strong {
        overflow: hidden;
        color: inherit;
        font-size: .9rem;
        font-weight: 600;
        line-height: 1.25;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .system-config-nav-copy small {
        color: var(--pt-surface-contrast-muted, #64748b);
        font-size: .75rem;
        font-weight: 400;
    }

    .system-config-nav-arrow {
        color: #94a3b8;
        font-size: 1.35rem;
        font-weight: 400;
    }

    .system-config-nav-option.is-active .system-config-nav-arrow {
        color: var(--pt-accent-dark, #0f766e);
    }

    .system-config-alert {
        border-radius: 8px;
        padding: 12px 14px;
        margin-bottom: 14px;
        font-size: 14px;
        font-weight: 700;
    }

    .system-config-alert.success {
        color: #065f46;
        background: #d1fae5;
        border: 1px solid #a7f3d0;
    }

    .system-config-alert.error {
        color: #991b1b;
        background: #fee2e2;
        border: 1px solid #fecaca;
    }

    .system-config-toolbar {
        display: grid;
        grid-template-columns: minmax(220px, 1fr) auto;
        gap: 12px;
        align-items: center;
        background: var(--pt-surface-soft, #f8fafc);
        border-bottom: 1px solid var(--pt-border, #d8e3ef);
        padding: 10px;
        margin: 0;
    }

    .system-config-search-wrap {
        position: relative;
    }

    .system-config-search-mark {
        position: absolute;
        left: 14px;
        top: 50%;
        width: 10px;
        height: 10px;
        border: 2px solid #0ea5e9;
        border-radius: 50%;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .system-config-search-mark::after {
        content: "";
        position: absolute;
        right: -6px;
        bottom: -5px;
        width: 7px;
        height: 2px;
        border-radius: 999px;
        background: #0ea5e9;
        transform: rotate(45deg);
    }

    .system-config-search {
        width: 100%;
        height: 44px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 0 14px 0 38px;
        color: #10233f;
        font-size: 14px;
        font-weight: 600;
        outline: none;
    }

    .system-config-search:focus {
        border-color: #0ea5e9;
        box-shadow: 0 0 0 3px rgba(14, 165, 233, .14);
    }

    .system-config-count {
        color: #334155;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
        background: #e2e8f0;
        border-radius: 8px;
        padding: 10px 14px;
    }

    .system-config-groups {
        display: block;
        padding: 10px;
    }

    .system-config-group {
        --group-color: #0ea5e9;
        --group-soft: #eff6ff;
        --group-border: #bfdbfe;
        --group-ring: rgba(14, 165, 233, .16);
        border: 1px solid var(--group-border);
        border-radius: 10px;
        overflow: hidden;
        background: #ffffff;
    }

    .system-config-group.is-hidden {
        display: none;
    }

    .system-config-group.theme-meeting {
        --group-color: #2563eb;
        --group-soft: #eff6ff;
        --group-border: #bfdbfe;
        --group-ring: rgba(37, 99, 235, .16);
    }

    .system-config-group.theme-overdue {
        --group-color: #dc2626;
        --group-soft: #fff1f2;
        --group-border: #fecdd3;
        --group-ring: rgba(220, 38, 38, .14);
    }

    .system-config-group.theme-line {
        --group-color: #16a34a;
        --group-soft: #f0fdf4;
        --group-border: #bbf7d0;
        --group-ring: rgba(22, 163, 74, .14);
    }

    .system-config-group.theme-telegram {
        --group-color: #0284c7;
        --group-soft: #f0f9ff;
        --group-border: #bae6fd;
        --group-ring: rgba(2, 132, 199, .14);
    }

    .system-config-group.theme-attendance {
        --group-color: #7c3aed;
        --group-soft: #f5f3ff;
        --group-border: #ddd6fe;
        --group-ring: rgba(124, 58, 237, .14);
    }

    .system-config-group.theme-system {
        --group-color: #475569;
        --group-soft: #f8fafc;
        --group-border: #cbd5e1;
        --group-ring: rgba(71, 85, 105, .14);
    }

    .system-config-group-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: var(--group-soft);
        border-bottom: 1px solid var(--group-border);
        padding: 12px 14px;
    }

    .system-config-group-title-wrap {
        min-width: 0;
    }

    .system-config-group-title {
        color: #10233f;
        font-size: 17px;
        font-weight: 800;
        line-height: 1.2;
    }

    .system-config-group-subtitle {
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        margin-top: 3px;
    }

    .system-config-group-count {
        color: var(--group-color);
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
        background: #ffffff;
        border: 1px solid var(--group-border);
        border-radius: 999px;
        padding: 7px 12px;
    }

    .system-config-list {
        display: grid;
        gap: 0;
    }

    .system-config-list-head {
        display: grid;
        grid-template-columns: minmax(260px, 1.25fr) minmax(150px, .55fr) minmax(320px, 1.8fr) minmax(150px, .6fr);
        gap: 16px;
        padding: 10px 14px;
        background: #fbfdff;
        border-bottom: 1px solid #e5edf5;
    }

    .system-config-head-cell {
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.2;
        text-transform: uppercase;
    }

    .system-config-row {
        display: grid;
        grid-template-columns: minmax(260px, 1.25fr) minmax(150px, .55fr) minmax(320px, 1.8fr) minmax(150px, .6fr);
        gap: 16px;
        align-items: start;
        padding: 12px 14px;
        border-bottom: 1px solid #edf2f7;
    }

    .system-config-row:last-child {
        border-bottom: 0;
    }

    .system-config-row:hover {
        background: #fbfdff;
    }

    .system-config-label {
        display: none;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 6px;
        text-transform: uppercase;
    }

    .system-config-key {
        display: flex;
        align-items: center;
        width: 100%;
        min-height: 42px;
        color: #10233f;
        background: #f8fafc;
        border: 1px solid #d8e3ef;
        border-radius: 8px;
        padding: 8px 12px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.25;
        word-break: break-word;
    }

    .system-config-updated {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        color: #475569;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 10px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .system-config-input,
    .system-config-textarea {
        width: 100%;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        color: #10233f;
        background: #ffffff;
        font-size: 14px;
        font-weight: 600;
        outline: none;
        transition: border-color .16s ease, box-shadow .16s ease;
    }

    .system-config-input {
        height: 42px;
        padding: 0 12px;
        text-align: center;
    }

    .system-config-textarea {
        min-height: 42px;
        height: 66px;
        padding: 9px 12px;
        resize: vertical;
        line-height: 1.35;
    }

    .system-config-input:focus,
    .system-config-textarea:focus {
        border-color: var(--group-color);
        box-shadow: 0 0 0 3px var(--group-ring);
    }

    .system-config-actions {
        position: sticky;
        bottom: 0;
        z-index: 2;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin: 0;
        padding: 12px 16px;
        background: var(--pt-surface, #ffffff);
        border-top: 1px solid var(--pt-border, #d8e3ef);
    }

    .system-config-btn {
        border: 0;
        border-radius: 8px;
        padding: 10px 16px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        min-width: 126px;
    }

    .system-config-btn.primary {
        color: #fff;
        background: #0f766e;
    }

    .system-config-btn.muted {
        color: #10233f;
        background: #e5eaf0;
    }

    @@media (max-width: 1100px) {
        .system-config-list-head {
            display: none;
        }

        .system-config-row {
            grid-template-columns: minmax(220px, 1fr) minmax(160px, 220px);
        }

        .system-config-label {
            display: block;
        }

        .system-config-col.description,
        .system-config-col.updated {
            grid-column: 1 / -1;
        }

        .system-config-updated {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 900px) {
        .system-config-browser {
            grid-template-columns: 1fr;
        }

        .system-config-nav {
            position: static;
        }

        .system-config-nav-list {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .system-config-panel {
            padding: 0;
        }

        .system-config-toolbar,
        .system-config-row {
            grid-template-columns: 1fr;
        }

        .system-config-count {
            white-space: normal;
        }

        .system-config-group-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .system-config-actions {
            flex-direction: column;
            align-items: stretch;
            margin: 0;
        }

        .system-config-nav-list {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="system-config-page">
    <div class="index-hero pt-form-hero system-config-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="index-title">System Config</h2>
            <p class="index-subtitle">จัดการค่ากลางของระบบ เช่น Auto Meetings, Auto Overdue และ Notification</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="system-config-alert success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="system-config-alert error">@TempData["Error"]</div>
    }

    <form asp-action="Save" method="post" class="system-config-panel">
        @Html.AntiForgeryToken()

        @if (groups.Count > 0)
        {
            <section class="system-config-browser">
                <aside class="system-config-nav" aria-label="หมวดการตั้งค่าระบบ">
                    <div class="system-config-panel-heading">
                        <div>
                            <span>CONFIG GROUPS</span>
                            <h3>หมวดการตั้งค่า</h3>
                        </div>
                        <strong>@groups.Count</strong>
                    </div>
                    <nav class="system-config-nav-list">
                        @foreach (var group in groups)
                        {
                            <button type="button"
                                    class="system-config-nav-option @(group.Key == initialGroup ? "is-active" : "")"
                                    data-config-filter="@group.Key"
                                    data-config-subtitle="@GroupSubtitle(group.Key)"
                                    data-config-count="@group.Count()">
                                <span class="system-config-nav-icon">
                                    <img src="@GroupIconPath(group.Key)" alt="" />
                                </span>
                                <span class="system-config-nav-copy">
                                    <strong>@group.Key</strong>
                                    <small>@group.Count() รายการ</small>
                                </span>
                                <span class="system-config-nav-arrow" aria-hidden="true">›</span>
                            </button>
                        }
                        <div class="system-config-nav-section">การจัดการข้อมูลกลาง</div>
                        @if (canManageHolidays)
                        {
                            <a class="system-config-nav-option system-config-nav-link"
                               asp-controller="AttendanceHolidays" asp-action="Index">
                                <span class="system-config-nav-icon"><img src="/images/menu-icons/attendance.svg" alt="" /></span>
                                <span class="system-config-nav-copy">
                                    <strong>จัดการวันหยุด</strong>
                                    <small>ปฏิทินวันหยุดบริษัท</small>
                                </span>
                                <span class="system-config-nav-arrow" aria-hidden="true">›</span>
                            </a>
                        }
                        <a class="system-config-nav-option system-config-nav-link"
                           asp-action="MasterData" asp-route-type="positions">
                            <span class="system-config-nav-icon"><img src="/images/menu-icons/employees.svg" alt="" /></span>
                            <span class="system-config-nav-copy">
                                <strong>จัดการตำแหน่ง</strong>
                                <small>ข้อมูลตำแหน่งพนักงาน</small>
                            </span>
                            <span class="system-config-nav-arrow" aria-hidden="true">›</span>
                        </a>
                        <a class="system-config-nav-option system-config-nav-link"
                           asp-action="MasterData" asp-route-type="departments">
                            <span class="system-config-nav-icon"><img src="/images/menu-icons/projects.svg" alt="" /></span>
                            <span class="system-config-nav-copy">
                                <strong>จัดการฝ่าย</strong>
                                <small>ข้อมูลฝ่ายพนักงานและโครงการ</small>
                            </span>
                            <span class="system-config-nav-arrow" aria-hidden="true">›</span>
                        </a>
                    </nav>
                </aside>

                <div class="system-config-content">
                    <div class="system-config-panel-heading">
                        <div>
                            <span>AVAILABLE CONFIGS</span>
                            <h3 id="systemConfigTitle">@initialGroup</h3>
                            <small id="systemConfigSubtitle">@GroupSubtitle(initialGroup)</small>
                        </div>
                        <strong id="systemConfigGroupCount">@groups.First().Count()</strong>
                    </div>

                    <div class="system-config-toolbar">
                        <div class="system-config-search-wrap">
                            <span class="system-config-search-mark" aria-hidden="true"></span>
                            <input id="systemConfigSearch"
                                   class="system-config-search"
                                   type="search"
                                   placeholder="ค้นหา config key, value หรือ description..."
                                   autocomplete="off" />
                        </div>
                        <div id="systemConfigCount" class="system-config-count">ทั้งหมด @Model.TotalCount รายการ</div>
                    </div>

                    <div class="system-config-groups">
                        @foreach (var group in groups)
                        {
                            var groupItems = group.ToList();
                            var groupClass = group.Key switch
                            {
                                "Auto Meetings" => "theme-meeting",
                                "Auto Overdue" => "theme-overdue",
                                "LINE Notification" => "theme-line",
                                "Telegram Notification" => "theme-telegram",
                                "Attendance" => "theme-attendance",
                                _ => "theme-system"
                            };

                            <section class="system-config-group @groupClass @(group.Key == initialGroup ? "" : "is-hidden")"
                                     data-config-group
                                     data-config-section="@group.Key">
                                <div class="system-config-group-head">
                                    <div class="system-config-group-title-wrap">
                                        <div class="system-config-group-title">@group.Key</div>
                                        <div class="system-config-group-subtitle">@GroupSubtitle(group.Key)</div>
                                    </div>
                                    <div class="system-config-group-count">@groupItems.Count รายการ</div>
                                </div>
                                <div class="system-config-list">
                                    <div class="system-config-list-head">
                                        <div class="system-config-head-cell">Config Key</div>
                                        <div class="system-config-head-cell">Value</div>
                                        <div class="system-config-head-cell">Description</div>
                                        <div class="system-config-head-cell">Updated</div>
                                    </div>
                                    @foreach (var item in groupItems)
                                    {
                                        <div class="system-config-row"
                                             data-config-row
                                             data-config-section="@group.Key"
                                             data-config-text="@($"{item.Group} {item.ConfigKey} {item.ConfigValue} {item.Description}".ToLowerInvariant())">
                                            <div class="system-config-col key">
                                                <span class="system-config-label">Config Key</span>
                                                <input type="hidden" name="Items[@index].ConfigKey" value="@item.ConfigKey" />
                                                <div class="system-config-key">@item.ConfigKey</div>
                                            </div>
                                            <div class="system-config-col value">
                                                <label class="system-config-label" for="config_value_@index">Value</label>
                                                <input id="config_value_@index"
                                                       class="system-config-input"
                                                       name="Items[@index].ConfigValue"
                                                       value="@item.ConfigValue"
                                                       autocomplete="off" />
                                            </div>
                                            <div class="system-config-col description">
                                                <label class="system-config-label" for="config_description_@index">Description</label>
                                                <textarea id="config_description_@index"
                                                          class="system-config-textarea"
                                                          name="Items[@index].Description">@item.Description</textarea>
                                            </div>
                                            <div class="system-config-col updated">
                                                <span class="system-config-label">Updated</span>
                                                <div class="system-config-updated">
                                                    @(item.UpdatedAt.HasValue ? item.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                                </div>
                                            </div>
                                        </div>

                                        index++;
                                    }
                                </div>
                            </section>
                        }
                    </div>

                    <div class="system-config-actions">
                        <a asp-controller="UserManagement" asp-action="Index" class="system-config-btn muted">กลับ Settings</a>
                        <button type="submit" class="system-config-btn primary">บันทึก</button>
                    </div>
                </div>
            </section>
        }
        else
        {
            <div class="system-config-alert error">ยังไม่มีรายการใน system_config</div>
        }
    </form>
</div>

<script>
    (function () {
        const search = document.getElementById('systemConfigSearch');
        const count = document.getElementById('systemConfigCount');
        const title = document.getElementById('systemConfigTitle');
        const subtitle = document.getElementById('systemConfigSubtitle');
        const groupCount = document.getElementById('systemConfigGroupCount');
        const rows = Array.from(document.querySelectorAll('[data-config-row]'));
        const groups = Array.from(document.querySelectorAll('[data-config-group]'));
        const filterButtons = Array.from(document.querySelectorAll('[data-config-filter]'));
        const configPreferenceUser = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(configPreferenceUser));
        const activeGroupStorageKey = `ProjectTracking.SystemConfigs.ActiveGroup:${configPreferenceUser}`;
        let activeGroup = filterButtons.find(button => button.classList.contains('is-active'))?.dataset.configFilter || '';

        function readRememberedGroup() {
            try {
                return window.localStorage.getItem(activeGroupStorageKey) || '';
            } catch {
                return '';
            }
        }

        function rememberGroup(groupName) {
            if (!groupName) return;

            try {
                window.localStorage.setItem(activeGroupStorageKey, groupName);
            } catch {
                // หน้ายังใช้งานต่อได้ หาก browser ปิด local storage
            }
        }

        function applySearch() {
            const term = (search?.value || '').trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(row => {
                const inActiveGroup = (row.dataset.configSection || '') === activeGroup;
                const matched = inActiveGroup && (!term || (row.dataset.configText || '').includes(term));
                row.style.display = matched ? '' : 'none';
                if (matched) visibleCount++;
            });

            groups.forEach(group => {
                const isActive = (group.dataset.configSection || '') === activeGroup;
                group.classList.toggle('is-hidden', !isActive);
            });

            const activeTotal = rows.filter(row => (row.dataset.configSection || '') === activeGroup).length;
            if (count) count.textContent = `แสดง ${visibleCount} รายการ จาก ${activeTotal} รายการ`;
        }

        function applyGroup(button) {
            if (!button) return;

            activeGroup = button.dataset.configFilter || activeGroup;
            filterButtons.forEach(item => item.classList.toggle('is-active', item === button));
            if (title) title.textContent = activeGroup;
            if (subtitle) subtitle.textContent = button.dataset.configSubtitle || '';
            if (groupCount) groupCount.textContent = button.dataset.configCount || '0';
            if (search) search.value = '';
            rememberGroup(activeGroup);
            applySearch();
        }

        search?.addEventListener('input', applySearch);
        filterButtons.forEach(button => button.addEventListener('click', () => applyGroup(button)));

        if (filterButtons.length > 0) {
            const rememberedGroup = readRememberedGroup();
            const initialButton = filterButtons.find(button => button.dataset.configFilter === rememberedGroup)
                || filterButtons.find(button => button.classList.contains('is-active'))
                || filterButtons[0];
            applyGroup(initialButton);
        }
    })();
</script>

@model IEnumerable<ProjectTracking.Models.VwPhaseOwnerStatus>
@using System.Globalization
@using System.Linq
@{
    Layout = null;
    var th = new CultureInfo("th-TH");
    var rows = (Model ?? Enumerable.Empty<ProjectTracking.Models.VwPhaseOwnerStatus>())
        .OrderBy(x => x.CoopName)
        .ThenBy(x => x.ProjectName)
        .ThenBy(x => x.PhaseOrder)
        .ThenBy(x => x.PeriodOrder)
        .ThenBy(x => x.PhaseId)
        .ThenBy(x => x.EmpName)
        .ToList();

    string FormatDate(DateTime? value)
    {
        return value?.ToString("dd MMM yyyy", th) ?? "-";
    }

    string FormatRange(DateTime? start, DateTime? end)
    {
        return $"{FormatDate(start)} - {FormatDate(end)}";
    }

    string StatusText(string? status)
    {
        return (status ?? "").Trim().ToUpperInvariant() switch
        {
            "DONE" => "เสร็จสิ้น",
            "IN_PROGRESS" => "กำลังดำเนินการ",
            "DELAY" => "ล่าช้า",
            "PLAN" => "วางแผน",
            "ALL STATUSES" => "ทั้งหมด",
            _ => string.IsNullOrWhiteSpace(status) ? "-" : status
        };
    }

    string StatusTextClass(string? status)
    {
        return (status ?? "").Trim().ToUpperInvariant() switch
        {
            "DONE" => "phase-status-text is-done",
            "IN_PROGRESS" => "phase-status-text is-progress",
            "DELAY" => "phase-status-text is-delay",
            "PLAN" => "phase-status-text is-plan",
            _ => "phase-status-text is-muted"
        };
    }

    string CardToneClass(string? status)
    {
        return (status ?? "").Trim().ToUpperInvariant() switch
        {
            "DONE" => "is-done",
            "IN_PROGRESS" => "is-progress",
            "DELAY" => "is-delay",
            "PLAN" => "is-plan",
            _ => "is-muted"
        };
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Section Owner Status Report</title>
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&display=swap");
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 18px;
            color: #10233f;
            background: #eef5fb;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 13px;
        }

        .print-header {
            margin-bottom: 18px;
            padding: 18px;
            border-radius: 18px;
            color: #fff;
            background: linear-gradient(135deg, #102443 0%, #1f5f72 100%);
        }

        .print-header h2 {
            margin: 0 0 8px;
            font-size: 26px;
            font-weight: 900;
        }

        .print-meta {
            color: rgba(255,255,255,.82);
            line-height: 1.7;
            font-weight: 700;
        }

        .phase-report-empty {
            padding: 34px 20px;
            border: 1px dashed #cbd5e1;
            border-radius: 18px;
            background: #fff;
            color: #64748b;
            text-align: center;
            font-weight: 800;
        }

        .phase-status-card-list {
            display: grid;
            gap: 10px;
        }

        .phase-project-group {
            display: grid;
            gap: 10px;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .phase-project-group + .phase-project-group {
            margin-top: 14px;
        }

        .phase-coop-group {
            display: grid;
            gap: 10px;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .phase-coop-group + .phase-coop-group {
            margin-top: 18px;
        }

        .phase-coop-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 11px 14px;
            color: #10233f;
            background: #dff7f1;
            border: 1px solid #b8e7dc;
            border-radius: 14px;
            font-weight: 900;
        }

        .phase-coop-label {
            color: #0f766e;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .phase-project-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 13px;
            color: #fff;
            background: #18365e;
            border-radius: 14px;
            font-weight: 900;
        }

        .phase-project-label {
            color: #8df1e4;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .phase-project-count {
            flex: 0 0 auto;
            color: rgba(255,255,255,.78);
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

        .phase-status-card {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(300px, .4fr);
            align-items: stretch;
            min-height: 0;
            overflow: hidden;
            border: 1px solid #d8e3ef;
            border-left: 5px solid #f59e0b;
            border-radius: 16px;
            background: #fff;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .phase-status-card.is-done {
            border-left-color: #22c55e;
        }

        .phase-status-card.is-delay {
            border-left-color: #ef4444;
        }

        .phase-status-card.is-plan {
            border-left-color: #38bdf8;
        }

        .phase-status-card-left,
        .phase-status-card-right {
            min-width: 0;
            padding: 14px;
        }

        .phase-status-card-right {
            display: flex;
            flex-direction: column;
            justify-content: center;
            border-left: 1px solid #e2e8f0;
        }

        .phase-status-card-header {
            display: flex;
            flex-wrap: nowrap;
            align-items: flex-start;
            gap: 10px;
            width: 100%;
            margin-bottom: 8px;
        }

        .phase-status-seq {
            flex: 0 0 auto;
            min-width: 58px;
            min-height: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #062b2f;
            background: rgba(20, 184, 166, .18);
            border-radius: 999px;
            font-size: 12px;
            font-weight: 900;
            white-space: nowrap;
        }

        .phase-status-project {
            display: block;
            color: #10233f;
            font-size: 16px;
            font-weight: 900;
            line-height: 1.35;
            overflow-wrap: anywhere;
        }

        .phase-status-employee {
            color: #64748b;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.45;
            overflow-wrap: anywhere;
        }

        .phase-status-employee strong {
            color: #10233f;
            font-weight: 900;
        }

        .phase-status-inline {
            display: inline-block;
            margin-left: 10px;
        }

        .phase-status-meta-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 6px 8px;
            margin: 10px 0;
        }

        .phase-status-meta-pill {
            display: inline-flex;
            align-items: center;
            min-height: 26px;
            padding: 5px 8px;
            color: #475569;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
        }

        .phase-status-role,
        .phase-status-remark {
            color: #475569;
            font-size: 12px;
            font-weight: 700;
            line-height: 1.55;
            overflow-wrap: anywhere;
        }

        .phase-status-role span {
            color: #10233f;
        }

        .phase-status-text {
            font-weight: 900;
        }

        .phase-status-text.is-done {
            color: #138a4c;
        }

        .phase-status-text.is-progress {
            color: #d97706;
        }

        .phase-status-text.is-delay {
            color: #dc2626;
        }

        .phase-status-text.is-plan {
            color: #0284c7;
        }

        .phase-status-text.is-muted {
            color: #64748b;
        }

        @@page {
            size: A4 landscape;
            margin: 10mm;
        }

        @@media print {
            body {
                background: #fff;
                padding: 0;
            }

            .print-header {
                box-shadow: none;
            }

            h2, h3,
            .project-group-row,
            .scenario-project__header,
            .scenario-group__header,
            .phase-project-group {
                break-after: avoid;
                page-break-after: avoid;
            }

            h2 + table,
            h2 + .empty,
            h2 + .report-table-scroll,
            h3 + table,
            h3 + .empty,
            .project-group-row + tr {
                break-before: avoid;
                page-break-before: avoid;
            }

            .report-section,
            .scenario-project,
            .scenario-group,
            .project-group-row,
            .phase-project-group {
                break-inside: avoid-page;
                page-break-inside: avoid;
            }
        }
    
        /* Crisp typography normalization for standalone pages. */
        :root { --pt-readable-thai-font: "Noto Sans Thai", "Leelawadee UI", Tahoma, "Segoe UI", Arial, sans-serif; }
        html, body {
            font-family: var(--pt-readable-thai-font) !important;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }
        body :where(*):not(svg):not(svg *) {
            font-family: var(--pt-readable-thai-font) !important;
            font-stretch: normal !important;
            letter-spacing: 0 !important;
            text-shadow: none !important;
        }
        body :is(h1, h2, h3, h4, h5, h6, th, label, strong, b, .report-btn, .btn, .badge, .status-text, .cell-title, .project-group-name, [class*="title"], [class*="heading"], [class*="eyebrow"], [class*="status"], [class*="badge"], [class*="count"], [class*="total"], [class*="value"]) {
            font-weight: 700 !important;
        }
        body :is(p, li, td, small, em, time, .cell-sub, .detail-block div, .meta-label, .meta-value, .empty, [class*="detail"], [class*="meta"], [class*="subtitle"], [class*="description"], [class*="desc"], [class*="remark"], [class*="note"], [class*="empty"]):not(.btn):not(.badge):not(.status-text):not([class*="status-"]):not([class*="Status"]) {
            font-weight: 400 !important;
        }
</style>
</head>

<body onload="window.print()">
    <header class="print-header">
        <h2>รายงานสถานะงานตามพนักงาน</h2>
        <div class="print-meta">
            <b>Project:</b> @(ViewBag.ProjectName ?? "All") <br />
            <b>Employee:</b> @(ViewBag.EmpName ?? "All") <br />
            <b>Status:</b> @(StatusText(ViewBag.PhaseStatus as string)) <br />
            <b>Printed:</b> @((ViewBag.PrintDate as DateTime?)?.ToString("dd MMM yyyy HH:mm", th) ?? DateTime.Now.ToString("dd MMM yyyy HH:mm", th))
        </div>
    </header>

    @if (!rows.Any())
    {
        <div class="phase-report-empty">ไม่พบข้อมูลสำหรับการพิมพ์</div>
    }
    else
    {
        <div class="phase-status-card-list">
            @{
                var coopGroups = rows
                    .GroupBy(x => string.IsNullOrWhiteSpace(x.CoopName) ? "-" : x.CoopName)
                    .OrderBy(group => group.Key)
                    .ToList();
            }

            @foreach (var coopGroup in coopGroups)
            {
                var projectGroups = coopGroup
                    .GroupBy(x => string.IsNullOrWhiteSpace(x.ProjectName) ? "-" : x.ProjectName)
                    .OrderBy(group => group.Key)
                    .ToList();

                <section class="phase-coop-group">
                    <div class="phase-coop-header">
                        <div>
                            <span class="phase-coop-label">Cooperative</span>
                            @coopGroup.Key
                        </div>
                        <span class="phase-project-count">@coopGroup.Count() รายการ</span>
                    </div>

                    @foreach (var projectGroup in projectGroups)
                    {
                        var seq = 1;
                        <section class="phase-project-group">
                            <div class="phase-project-header">
                                <div>
                                    <span class="phase-project-label">Project</span>
                                    @projectGroup.Key
                                </div>
                                <span class="phase-project-count">@projectGroup.Count() รายการ</span>
                            </div>

                            @foreach (var r in projectGroup)
                            {
                                <article class="phase-status-card @CardToneClass(r.PhaseStatus)">
                                    <section class="phase-status-card-left">
                                        <div class="phase-status-card-header">
                                            <span class="phase-status-seq">Seq @seq</span>
                                            <div>
                                                <div class="phase-status-employee">
                                                    Employee: <strong>@r.EmpName</strong>
                                                    <span class="phase-status-inline">
                                                        Status:
                                                        <span class="@StatusTextClass(r.PhaseStatus)">
                                                            @StatusText(r.PhaseStatus)
                                                        </span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="phase-status-meta-grid">
                                            <span class="phase-status-meta-pill">ส่วนที่ @r.PhaseOrder / งวดที่ @r.PeriodOrder</span>
                                            <span class="phase-status-meta-pill">Project Period: @FormatRange(r.StartDate, r.EndDate)</span>
                                            <span class="phase-status-meta-pill">Plan: @FormatRange(r.PlanStart, r.PlanEnd)</span>
                                            <span class="phase-status-meta-pill">Plan Days: @(r.PlanDays?.ToString() ?? "-")</span>
                                            <span class="phase-status-meta-pill">กำหนดส่งงวดงาน: @FormatDate(r.ActualEnd)</span>
                                            <span class="phase-status-meta-pill">Overdue: @(r.OverdueDays ?? 0) days</span>
                                        </div>
                                    </section>

                                    <section class="phase-status-card-right">
                                        <div class="phase-status-card-role">
                                            <span>Role</span>
                                            <strong>@(string.IsNullOrWhiteSpace(r.Role) ? "-" : r.Role)</strong>
                                        </div>
                                        <div class="phase-status-card-remark">
                                            <span>Remark</span>
                                            <p>@(string.IsNullOrWhiteSpace(r.Remark) ? "-" : r.Remark)</p>
                                        </div>
                                    </section>
                                </article>

                                seq++;
                            }
                        </section>
                    }
                </section>
            }
        </div>
    }
</body>
</html>

@using System.Linq
@using System.Globalization
@using Microsoft.AspNetCore.Http
@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}
@model IEnumerable<ProjectTracking.Models.VwPhaseOwnerStatus>

@{
    ViewData["Title"] = "รายงานสถานะงานตามพนักงาน";
    var th = new CultureInfo("th-TH");

    var sortedModel = Model
        .OrderByDescending(x => x.ProjectId)
        .ThenBy(x => x.PhaseId)
        .ToList();

    var total = sortedModel.Count();
    var done = sortedModel.Count(x => x.PhaseStatus == "DONE");
    var inProgress = sortedModel.Count(x => x.PhaseStatus == "IN_PROGRESS");
    var delay = sortedModel.Count(x => x.PhaseStatus == "DELAY");
    var overdueDays = sortedModel.Sum(x => x.OverdueDays);
}

<div class="phase-report-page">
<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">รายงานสถานะงานตามพนักงาน</h2>
        <p class="index-subtitle">สรุปสถานะ Phase และงานที่ล่าช้าของผู้รับผิดชอบ</p>
    </div>
</div>

<!-- ================= SUMMARY ================= -->
<div class="row g-3 mb-4 no-print phase-summary-row">
    <div class="col-md-2">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total Phase</div>
                <h4 class="fw-bold">@total</h4>
            </div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card text-center shadow-sm border-success">
            <div class="card-body">
                <div class="text-muted">Done</div>
                <h4 class="fw-bold text-success">@done</h4>
            </div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card text-center shadow-sm border-info">
            <div class="card-body">
                <div class="text-muted">In Progress</div>
                <h4 class="fw-bold text-info">@inProgress</h4>
            </div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card text-center shadow-sm border-danger">
            <div class="card-body">
                <div class="text-muted">Delay</div>
                <h4 class="fw-bold text-danger">@delay</h4>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-center shadow-sm border-warning">
            <div class="card-body">
                <div class="text-muted">Total Overdue (Days)</div>
                <h4 class="fw-bold text-warning">@overdueDays</h4>
            </div>
        </div>
    </div>
</div>

<!-- ================= FILTER ================= -->
<form method="get" class="row g-3 mb-3 no-print phase-filter-row">
    <div class="col-md-4">
        <label class="form-label fw-semibold">👤 Employee</label>
        <select name="empName" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Employees --</option>
            @foreach (var e in ViewBag.EmpList)
            {
                <option value="@e" selected="@(ViewBag.SelectedEmp == e)">
                    @e
                </option>
            }
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label fw-semibold">📁 Project</label>
        <select name="projectName" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Projects --</option>
            @foreach (var p in ViewBag.ProjectList)
            {
                <option value="@p" selected="@(ViewBag.SelectedProject == p)">
                    @p
                </option>
            }
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label fw-semibold">📌 Status</label>
        <select name="phaseStatus" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Statuses --</option>
            @foreach (var status in ViewBag.StatusList)
            {
                <option value="@status" selected="@(ViewBag.SelectedStatus == status)">
                    @status
                </option>
            }
        </select>
    </div>
</form>

<!-- ================= ACTION BUTTONS ================= -->
<div class="row mb-4 no-print">
    <div class="col-md-12 text-end">

        <!-- ✅ SEND MAIL (POST FORM แยกเดี่ยว) -->
        @if (CanMenu("PhaseStatusReport.SendMail"))
        {
            <form asp-action="SendOverdueMail"
                  method="post"
                  class="d-inline">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-warning me-2"
                        title="ส่งอีเมลแจ้ง Phase ที่ Overdue"
                        onclick="return confirm('ต้องการส่ง Email แจ้ง Phase Overdue หรือไม่?');">
                    📧 ส่งเมลแจ้ง Overdue
                </button>
            </form>
        }
        else
        {
            <button class="btn btn-warning me-2" disabled title="ไม่มีสิทธิ์ส่งเมลแจ้ง Overdue">
                📧 ส่งเมลแจ้ง Overdue
            </button>
        }

        @if (CanMenu("PhaseStatusReport.Print"))
        {
            <a class="btn btn-outline-secondary"
               target="_blank"
               title="พิมพ์รายงาน"
               asp-action="Print"
               asp-route-empName="@ViewBag.SelectedEmp"
               asp-route-projectName="@ViewBag.SelectedProject"
               asp-route-phaseStatus="@ViewBag.SelectedStatus">
                🖨 พิมพ์รายงาน
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary" disabled title="ไม่มีสิทธิ์พิมพ์รายงาน">
                🖨 พิมพ์รายงาน
            </button>
        }
    </div>
</div>

<!-- ================= TABLE ================= -->
<div class="table-responsive phase-report-table-wrap">
    <table class="table table-bordered table-striped table-sm align-middle phase-report-table"
           style="min-width:2200px;">
        <thead>
            <tr>
                <th style="min-width:260px;">Project</th>
                <th style="min-width:80px;">Order</th>
                <th style="min-width:200px;">Employee</th>
                <th style="min-width:500px;">Role</th>
                <th style="min-width:320px;">Project Period</th>
                <th style="min-width:260px;">Plan</th>
                <th style="min-width:260px;">Actual</th>
                <th style="min-width:100px;">Plan Days</th>
                <th style="min-width:110px;">Actual Days</th>
                <th style="min-width:100px;">Overdue</th>
                <th style="min-width:120px;">Status</th>
                <th style="min-width:360px;">Remark</th>
            </tr>
        </thead>

        <tbody>
        @foreach (var r in sortedModel)
        {
            <tr class="@(r.PhaseStatus == "DELAY" ? "table-danger" : "")">
                <td>@r.ProjectName</td>
                <td class="text-center">@r.PhaseOrder</td>
                <td>@r.EmpName</td>
                <td>@r.Role</td>
                <td class="text-center">
                    @r.StartDate?.ToString("dd MMM yyyy", th)
                    –
                    @r.EndDate?.ToString("dd MMM yyyy", th)
                </td>
                <td class="text-center">
                    @r.PlanStart?.ToString("dd MMM yyyy", th)
                    –
                    @r.PlanEnd?.ToString("dd MMM yyyy", th)
                </td>
                <td class="text-center">
                    @r.ActualStart?.ToString("dd MMM yyyy", th)
                    –
                    @r.ActualEnd?.ToString("dd MMM yyyy", th)
                </td>
                <td class="text-center">@r.PlanDays</td>
                <td class="text-center">@r.ActualDays</td>
                <td class="text-center">@r.OverdueDays</td>
                <td class="text-center">@r.PhaseStatus</td>
                <td>@r.Remark</td>
            </tr>
        }
        </tbody>
    </table>
</div>
</div>

<style>
.phase-report-page {
    color: #111827;
}

.phase-report-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 16px;
}

.phase-report-title h2 {
    margin: 0;
    color: #172033;
    font-size: 28px;
    font-weight: 900;
    letter-spacing: 0;
}

.title-mark {
    display: inline-flex;
    align-items: flex-end;
    height: 34px;
    color: transparent;
    font-size: 0;
}

.title-mark::before {
    content: "";
    width: 34px;
    height: 28px;
    display: block;
    border-radius: 7px;
    background:
        linear-gradient(90deg, #22c55e 0 27%, transparent 27% 36%, #2563eb 36% 63%, transparent 63% 72%, #ef4444 72% 100%);
    box-shadow: 0 8px 18px rgba(37,99,235,.16);
}

.phase-summary-row .card {
    border: 0 !important;
    border-radius: 18px;
    box-shadow: 0 12px 28px rgba(15,23,42,.08) !important;
}

.phase-summary-row .card-body {
    padding: 18px 16px;
}

.phase-filter-row {
    margin-bottom: 22px !important;
}

.phase-filter-row .form-label {
    color: #1f2937;
}

.phase-filter-row .form-select {
    min-height: 42px;
    border-radius: 10px;
}

.phase-report-table-wrap {
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 14px 36px rgba(15,23,42,.08);
    border: 1px solid rgba(148,163,184,.28);
}

.phase-report-table {
    margin-bottom: 0;
    border-color: #e2e8f0;
}

.phase-report-table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    padding: 16px 18px;
    color: #f8fbff;
    background: linear-gradient(180deg, #18345d 0%, #102443 100%);
    border-color: rgba(255,255,255,.08) !important;
    font-size: 14px;
    font-weight: 900;
    text-align: center;
    white-space: nowrap;
    vertical-align: middle;
    box-shadow: inset 0 -1px 0 rgba(255,255,255,.08);
}

.phase-report-table thead th:first-child {
    border-top-left-radius: 14px;
}

.phase-report-table thead th:last-child {
    border-top-right-radius: 14px;
}

.phase-report-table tbody td {
    padding: 16px 18px;
    border-color: #dbe4ef;
    font-size: 14px;
    line-height: 1.5;
    vertical-align: middle;
}

.phase-report-table tbody tr:nth-child(odd) td {
    background: #fbfdff;
}

.phase-report-table tbody tr:hover td {
    background: #eef7ff;
}

@@media print {
    .no-print {
        display: none !important;
    }
}
</style>

@model ProjectTracking.ViewModels.LineOverdueSelectionViewModel
@using System.Globalization
@{
    Layout = null;
    var th = new CultureInfo("th-TH");

    string FormatDate(DateTime? value) => value?.ToString("dd MMM yyyy", th) ?? "-";
    string SeverityClass(string severity) => string.Equals(severity, "DANGER", StringComparison.OrdinalIgnoreCase) ? "danger" : "warning";
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>Send Overdue Line</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 16px;
            color: #10233f;
            background: #fff;
            font-family: "Noto Sans Thai", "Leelawadee UI", Tahoma, Arial, sans-serif;
            font-size: 12px;
        }
        .actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }
        .btn {
            min-height: 34px;
            padding: 7px 13px;
            border: 1px solid #102443;
            border-radius: 999px;
            color: #102443;
            background: #fff;
            font: inherit;
            font-weight: 800;
            line-height: 1.1;
            text-decoration: none;
            cursor: pointer;
        }
        .btn.primary {
            color: #fff;
            background: #102443;
        }
        .btn.warning {
            border-color: #f59e0b;
            color: #7c4a03;
        }
        .btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }
        .header {
            margin-bottom: 12px;
            padding: 16px;
            color: #fff;
            background: #102443;
        }
        .header h1 {
            margin: 0 0 6px;
            font-size: 22px;
        }
        .header div {
            color: rgba(255,255,255,.82);
            font-weight: 700;
            line-height: 1.55;
        }
        .notice {
            margin-bottom: 10px;
            padding: 10px 12px;
            border: 1px solid #bfdbfe;
            background: #eff6ff;
            color: #1e3a8a;
            font-weight: 700;
        }
        .notice.error {
            border-color: #fecdd3;
            background: #fff1f2;
            color: #be123c;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(160px, 1fr));
            gap: 8px;
            margin-bottom: 12px;
        }
        .kpi {
            padding: 10px;
            border: 1px solid #d8e3ef;
            border-left: 4px solid #258cfb;
        }
        .kpi.ready { border-left-color: #14b8a6; }
        .kpi.missing { border-left-color: #f43f5e; }
        .kpi span,
        .kpi small {
            display: block;
            color: #64748b;
            font-weight: 700;
        }
        .kpi strong {
            display: block;
            margin: 5px 0;
            color: #10233f;
            font-size: 20px;
            font-weight: 900;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            background: #fff;
        }
        th {
            padding: 9px 7px;
            color: #fff;
            background: #102443;
            border: 1px solid rgba(255,255,255,.18);
            font-size: 11px;
            font-weight: 900;
            text-align: center;
            vertical-align: middle;
        }
        td {
            padding: 7px 6px;
            border: 1px solid #d8e3ef;
            line-height: 1.45;
            vertical-align: top;
            overflow-wrap: anywhere;
        }
        tr:nth-child(even) td {
            background: #f8fbff;
        }
        .text-center { text-align: center; }
        .muted { color: #64748b; }
        .badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 22px;
            padding: 3px 8px;
            border-radius: 999px;
            font-weight: 900;
            max-width: 100%;
            white-space: normal;
            overflow-wrap: anywhere;
            text-align: center;
            line-height: 1.25;
        }
        .badge.danger {
            color: #be123c;
            background: #ffe4e6;
        }
        .badge.warning {
            color: #92400e;
            background: #fef3c7;
        }
        .badge.ready {
            color: #0f766e;
            background: #ccfbf1;
        }
        .badge.missing {
            color: #be123c;
            background: #ffe4e6;
        }
        .empty {
            padding: 28px;
            border: 1px dashed #cbd5e1;
            color: #64748b;
            text-align: center;
            font-weight: 800;
        }
        input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #102443;
        }
    </style>
</head>
<body>
    <div class="actions">
        <a asp-action="Index" class="btn">Back to Report</a>
        <button type="button" class="btn" id="selectAllButton">Select All Ready</button>
        <button type="button" class="btn" id="clearButton">Clear</button>
        <button type="submit" form="sendForm" class="btn warning">Send Selected Line</button>
    </div>

    <header class="header">
        <h1>Send Overdue Line</h1>
        <div>
            เลือกรายการงานเสี่ยงล่าช้า/งานล่าช้าเพื่อส่ง LINE<br />
            ข้อมูล ณ @DateTime.Now.ToString("dd MMM yyyy HH:mm", th)
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="notice">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="notice error">@TempData["Error"]</div>
    }

    <section class="kpi-grid">
        <article class="kpi">
            <span>Total</span>
            <strong>@Model.TotalCount</strong>
            <small>รายการปลายทางทั้งหมด</small>
        </article>
        <article class="kpi ready">
            <span>Ready</span>
            <strong>@Model.ReadyCount</strong>
            <small>ผูก LINE แล้ว</small>
        </article>
        <article class="kpi missing">
            <span>Missing LINE</span>
            <strong>@Model.MissingLineCount</strong>
            <small>ยังส่งไม่ได้</small>
        </article>
    </section>

    @if (!Model.Items.Any())
    {
        <div class="empty">ไม่พบงานเสี่ยงล่าช้า/งานล่าช้า</div>
    }
    else
    {
        <form id="sendForm" asp-action="SendSelectedLineOverdue" method="post">
            @Html.AntiForgeryToken()
            <table>
                <thead>
                    <tr>
                        <th style="width:44px;">Send</th>
                        <th style="width:92px;">LINE</th>
                        <th style="width:92px;">Type</th>
                        <th style="width:150px;">State</th>
                        <th>Cooperative / Project</th>
                        <th>Title</th>
                        <th style="width:150px;">Recipient</th>
                        <th style="width:140px;">Owner / BA</th>
                        <th style="width:110px;">Start</th>
                        <th style="width:110px;">End</th>
                        <th style="width:90px;">Overdue</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox"
                                       class="row-check"
                                       name="selectedKeys"
                                       value="@item.Key"
                                       @(item.HasLineRecipient ? "" : "disabled") />
                            </td>
                            <td class="text-center">
                                <span class="badge @(item.HasLineRecipient ? "ready" : "missing")">
                                    @(item.HasLineRecipient ? "Ready" : "No LINE")
                                </span>
                            </td>
                            <td class="text-center">@item.SourceLabel</td>
                            <td class="text-center">
                                <span class="badge @SeverityClass(item.Severity)">@item.StateText</span>
                            </td>
                            <td>
                                <strong>@item.CoopName</strong><br />
                                <span class="muted">@item.ProjectName</span>
                            </td>
                            <td>@item.Title</td>
                            <td>
                                <strong>@item.RecipientName</strong><br />
                                <span class="muted">@item.RecipientRole</span>
                            </td>
                            <td>
                                Owner: @item.OwnerName<br />
                                BA: @item.BaName
                            </td>
                            <td class="text-center">@FormatDate(item.StartDate)</td>
                            <td class="text-center">@FormatDate(item.EndDate)</td>
                            <td class="text-center">
                                <strong>@item.OverdueDays</strong> วัน
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    }

    <script>
        (function () {
            const checks = Array.from(document.querySelectorAll('.row-check'));
            const selectAllButton = document.getElementById('selectAllButton');
            const clearButton = document.getElementById('clearButton');

            selectAllButton?.addEventListener('click', function () {
                checks.filter(x => !x.disabled).forEach(x => x.checked = true);
            });

            clearButton?.addEventListener('click', function () {
                checks.forEach(x => x.checked = false);
            });
        })();
    </script>
</body>
</html>

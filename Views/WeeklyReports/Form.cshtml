@model ProjectTracking.Models.WeeklyReportFormViewModel

@{
    var isEdit = Model.Report.ReportId > 0;
    ViewData["Title"] = isEdit ? "Edit Weekly Report" : "Create Weekly Report";
    var formAction = isEdit
        ? Url.Action("Edit", "WeeklyReports", new { id = Model.Report.ReportId })
        : Url.Action("Create", "WeeklyReports");
}

@functions {
    string DueText(DateTime? date) => date.HasValue ? date.Value.ToString("dd/MM/yyyy") : "-";
    string TypeClass(string? type) => (type ?? "").ToUpperInvariant() switch
    {
        "ASSIGNS" => "type-assign",
        "ISSUE" => "type-issue",
        "SUPPORT" => "type-support",
        "FOLLOWUP" => "type-followup",
        _ => "type-default"
    };
}

<style>
    .weekly-form-page { padding-top: 0; }
    .weekly-hero {
        border-radius: 24px;
        padding: 28px 32px;
        margin-bottom: 20px;
        color: #fff;
        background: linear-gradient(135deg, #10233f 0%, #113c58 58%, #0f8f84 100%);
        box-shadow: 0 16px 34px rgba(15, 35, 64, .18);
        display: flex;
        justify-content: space-between;
        gap: 18px;
        align-items: center;
    }
    .weekly-eyebrow { color: #9ff4e6; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
    .weekly-title { font-size: clamp(2rem, 3vw, 3rem); font-weight: 1000; margin: 6px 0 0; }
    .weekly-subtitle { color: rgba(255,255,255,.78); font-weight: 800; margin: 6px 0 0; }
    .weekly-panel {
        background: #fff;
        border: 1px solid #d9e4f2;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 14px 34px rgba(16, 35, 63, .08);
        margin-bottom: 18px;
    }
    .weekly-panel h3 { color: #10233f; font-weight: 1000; margin-bottom: 16px; }
    .weekly-input, .weekly-textarea {
        width: 100%;
        border: 1px solid #cbd8e8;
        border-radius: 16px;
        padding: 13px 16px;
        min-height: 50px;
        color: #10233f;
        font-weight: 800;
        background: #fbfdff;
    }
    .weekly-textarea { min-height: 180px; resize: vertical; }
    .weekly-label { font-weight: 1000; color: #10233f; margin-bottom: 8px; }
    .pending-list { display: grid; gap: 10px; max-height: 560px; overflow: auto; padding-right: 4px; }
    .pending-item {
        border: 1px solid #d9e4f2;
        border-left: 5px solid #23c6b8;
        border-radius: 16px;
        padding: 14px 16px;
        background: #fbfdff;
    }
    .pending-item h4 { color: #10233f; font-size: 1rem; font-weight: 1000; margin: 8px 0 6px; overflow-wrap: anywhere; }
    .pending-meta { color: #64748b; font-size: .9rem; font-weight: 800; display: flex; flex-wrap: wrap; gap: 10px; }
    .pending-type { font-weight: 1000; }
    .type-assign { color: #0f766e; }
    .type-issue { color: #e11d48; }
    .type-support { color: #f59e0b; }
    .type-followup { color: #2563eb; }
    .weekly-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: flex-end;
        border-top: 1px solid #e4edf7;
        padding-top: 18px;
        margin-top: 18px;
    }
    .weekly-btn {
        min-height: 48px;
        min-width: 180px;
        border-radius: 999px;
        border: 1px solid #cbd8e8;
        padding: 10px 18px;
        font-weight: 1000;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #fff;
        color: #10233f;
    }
    .weekly-btn.primary { background: linear-gradient(135deg, #28d6c5, #108a7c); color: #fff; border-color: transparent; }
    .weekly-btn.dark { background: #10233f; color: #fff; border-color: #10233f; }
    .attachment-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .attachment-pill { border: 1px solid #d9e4f2; border-radius: 999px; padding: 8px 12px; color: #10233f; font-weight: 900; text-decoration: none; background: #f8fbff; }
    @@media (max-width: 780px) {
        .weekly-hero { display: grid; }
        .weekly-btn { width: 100%; }
    }
</style>

<div class="container weekly-form-page">
    <section class="weekly-hero">
        <div>
            <div class="weekly-eyebrow">ProjectTracking</div>
            <h1 class="weekly-title">@(isEdit ? "Edit Weekly Report" : "Create Weekly Report")</h1>
            <p class="weekly-subtitle">ดึงรายการงานค้างของ BA มาแสดง แล้วบันทึกสรุปประจำสัปดาห์พร้อมไฟล์แนบ</p>
        </div>
        <a class="weekly-btn" style="background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.42);" asp-action="Index">กลับรายการ</a>
    </section>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
    }

    <form method="post" enctype="multipart/form-data" action="@formAction">
        @Html.AntiForgeryToken()

        <div class="weekly-panel">
            <h3>ข้อมูลรายงาน</h3>
            <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="weekly-label" asp-for="Report.WeekStart">วันที่เริ่มสัปดาห์</label>
                    <input class="weekly-input" type="date" asp-for="Report.WeekStart" />
                </div>
                <div class="col-md-6">
                    <label class="weekly-label" asp-for="Report.WeekEnd">วันที่สิ้นสุดสัปดาห์</label>
                    <input class="weekly-input" type="date" asp-for="Report.WeekEnd" />
                </div>
                <div class="col-12">
                    <label class="weekly-label" asp-for="Report.Subject">หัวข้อรายงาน</label>
                    <input class="weekly-input" asp-for="Report.Subject" />
                </div>
                <div class="col-12">
                    <label class="weekly-label" asp-for="Report.Summary">สรุปรายงานประจำสัปดาห์</label>
                    <textarea class="weekly-textarea" asp-for="Report.Summary" placeholder="สรุปงานค้าง ความคืบหน้า ปัญหา และสิ่งที่ต้องการให้ Project Manager ตรวจ"></textarea>
                </div>
                <div class="col-12">
                    <label class="weekly-label">ไฟล์แนบ</label>
                    <input class="weekly-input" type="file" name="files" multiple />
                    @if (isEdit && Model.Report.Attachments.Any())
                    {
                        <div class="attachment-list">
                            @foreach (var attachment in Model.Report.Attachments.OrderByDescending(x => x.UploadedAt))
                            {
                                <a class="attachment-pill" asp-action="DownloadAttachment" asp-route-id="@attachment.AttachmentId">@attachment.FileName</a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="weekly-panel">
            <h3>รายการงานค้างของ BA</h3>
            <div class="pending-list">
                @if (!Model.PendingItems.Any())
                {
                    <div class="text-muted fw-bold">ไม่พบรายการงานค้างของ BA ในโครงการที่รับผิดชอบ</div>
                }
                else
                {
                    @foreach (var item in Model.PendingItems)
                    {
                        <div class="pending-item">
                            <div class="pending-meta">
                                <span class="pending-type @TypeClass(item.Type)">@item.Type</span>
                                <span>@item.ProjectName</span>
                                <span>กำหนด: @DueText(item.DueDate)</span>
                                @if (!string.IsNullOrWhiteSpace(item.OwnerName))
                                {
                                    <span>ผู้รับผิดชอบ: @item.OwnerName</span>
                                }
                            </div>
                            <h4>@item.Title</h4>
                            <div class="pending-meta">
                                <span>สถานะ: @(item.Status ?? "-")</span>
                                <a href="@item.TargetUrl">ดูงาน</a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="weekly-panel">
            <div class="weekly-actions">
                <button class="weekly-btn dark" type="submit" name="submitAction" value="draft">บันทึกร่าง</button>
                <button class="weekly-btn primary" type="submit" name="submitAction" value="send">ส่งรายงาน</button>
            </div>
        </div>
    </form>
</div>

@model IEnumerable<ProjectTracking.Models.ProjectFollowup>

@if (TempData["FollowupMessage"] != null)
{
    <script>
        alert("@TempData["FollowupMessage"]");
    </script>
}
@using System.Linq
@{
    var menus = Context.Session.GetString("Menus") ?? "";
    var allowedMenus = menus.Split(',').Select(x => x.Trim()).ToList();
    var selectedProjectId = Context.Request.Query["projectId"].ToString();
    var selectedOwnerEmpId = Context.Request.Query["ownerEmpId"].ToString();
    var ownerEmployees = ViewBag.OwnerEmployees as IEnumerable<ProjectTracking.Models.Employee> ?? Enumerable.Empty<ProjectTracking.Models.Employee>();

    bool HasMenu(string key)
    {
        return allowedMenus.Contains(key);
}
}

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">งานที่ต้องติดตาม</h2>
        <p class="index-subtitle">ติดตามงาน นัดหมาย และการประสานงานที่ยังต้องดำเนินการต่อ</p>
    </div>

    <div class="index-actions">
        @if (HasMenu("Followups.Create"))
        {
            <a href="/Followups/Create?projectId=@Context.Request.Query["projectId"]"
               class="btn btn-primary"
               title="สร้างงานติดตาม">
                สร้างงานติดตาม
            </a>
        }
        else
        {
            <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์สร้างงานติดตาม">
                สร้างงานติดตาม
            </button>
        }
    </div>
</div>

<form method="get" action="/Followups/Index" class="followup-filter mb-2">
    <div class="followup-filter__field">
        <label for="projectId">📁 Select Project</label>
        <select id="projectId"
                name="projectId"
                class="form-select"
                onchange="this.form.submit()"
                asp-items="@(new SelectList(ViewBag.Projects, "ProjectId", "ProjectName", selectedProjectId))">
            <option value="">-- ทุก Project --</option>
        </select>
    </div>

    <div class="followup-filter__field">
        <label for="ownerEmpId">👤 ผู้รับผิดชอบ</label>
        <select id="ownerEmpId"
                name="ownerEmpId"
                class="form-select"
                onchange="this.form.submit()">
            <option value="">-- ทุกคน --</option>
            @foreach (var owner in ownerEmployees)
            {
                var value = owner.EmpId.ToString();
                <option value="@value" selected="@(selectedOwnerEmpId == value ? "selected" : null)">
                    @owner.EmpName
                </option>
            }
        </select>
    </div>
</form>

@if (string.IsNullOrEmpty(selectedProjectId) && string.IsNullOrEmpty(selectedOwnerEmpId))
{
    <div class="alert alert-secondary mt-3 p-3">
        ⬆ กรุณาเลือก Project หรือผู้รับผิดชอบก่อน
    </div>
}

@if (!string.IsNullOrEmpty(selectedProjectId) || !string.IsNullOrEmpty(selectedOwnerEmpId))
{
    int no = 1;
    <div class="mb-2">
        <strong>จำนวน Follow-up:</strong> @Model.Count()
    </div>

    <div class="table-responsive" style="display:none;">
    <table class="table table-bordered">
    <thead>
        <tr>
            <th style="width:60px; text-align:center;">No.</th>
            <th style="text-align:center;">Task</th>
            <th style="text-align:center;">Partner</th>
            <th style="text-align:center;">Owner</th>
            <th style="text-align:center;">Next Follow-up</th>
            <th style="text-align:center;">Last Contact</th>
            <th style="text-align:center;">Status</th>
            <th style="width:260px; text-align:center;">Action</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
        var rowClass = "";
        if (item.NextFollowupDate != null)
        {
            var d = item.NextFollowupDate.Value.Date;
            if (d < DateTime.Today)
                rowClass = "table-danger";
            else if (d == DateTime.Today)
                rowClass = "table-warning";
            else
                rowClass = "table-success";
        }

        <tr class="@rowClass">
            <td>@no</td>
            <td>@item.TaskTitle</td>
            <td>@item.PartnerName</td>
            <td>@item.Owner?.EmpName</td>
            <td>@item.NextFollowupDate?.ToString("dd/MM/yyyy")</td>
            <td>
                @if(item.LastContactDate != null)
                {
                    @(item.LastContactDate?.ToString("dd/MM/yyyy")) @("(" + item.LastContactType + ")")
                }
            </td>
            <td>@item.Status</td>
            <td style="white-space:nowrap; text-align:center;">
                @if (HasMenu("Followups.Details"))
                {
                    <a href="/Followups/Details/@item.FollowupId" 
                       class="btn btn-sm btn-outline-secondary"
                       title="ดูรายละเอียด">
                        View
                    </a>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดู">
                        View
                    </button>
                }

                @if (HasMenu("Followups.Edit"))
                {
                    <a href="/Followups/Edit/@item.FollowupId" 
                       class="btn btn-sm btn-outline-primary"
                       title="แก้ไข">
                        Edit
                    </a>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                        Edit
                    </button>
                }

                @if (HasMenu("Followups.Delete"))
                {
                    <form method="post" action="/Followups/Delete" style="display:inline;" onsubmit="return confirm('ต้องการลบ Follow-up นี้หรือไม่?');">
                        <input type="hidden" name="followupId" value="@item.FollowupId" />
                        <input type="hidden" name="projectId" value="@Context.Request.Query["projectId"]" />
                        <button class="btn btn-sm btn-outline-danger" title="ลบ">Delete</button>
                    </form>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                        Delete
                    </button>
                }

                @if (HasMenu("Followups.Done"))
                {
                    if(item.Status == "DONE" || item.Status == "ACK")
                    {
                        <button class="btn btn-sm btn-outline-success"
                                title="รายการนี้ถูก DONE หรือ ACK แล้ว"
                                onclick="alert('ไม่สามารถกด DONE ได้ เนื่องจากรายการนี้ถูก DONE หรือ ACK แล้ว'); return false;">
                            Done
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-success"
                                title="ปิดงาน"
                                onclick="openDonePopup(@item.FollowupId)">
                            Done
                        </button>
                    }
                }
                else
                {
                    <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ปิดงาน">
                        Done
                    </button>
                }

                @if (HasMenu("Followups.Log"))
                {
                    if(item.Status == "DONE" || item.Status == "ACK")
                    {
                        <button class="btn btn-sm btn-outline-primary"
                                title="รายการนี้ถูก DONE หรือ ACK แล้ว"
                                onclick="alert('ไม่สามารถ Log ได้ เนื่องจากรายการนี้ถูก DONE หรือ ACK แล้ว'); return false;">
                            Log
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-primary"
                                title="บันทึกการติดตาม"
                                onclick="openQuickLog(@item.FollowupId)">
                            Log
                        </button>
                    }
                }
                else
                {
                    <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์บันทึก">
                        Log
                    </button>
                }
            </td>
        </tr>
    no++;
    }
    </tbody>
    </table>
    </div>

    <div class="followup-cards">
    @foreach (var item in Model)
    {
        var rowClass = "";
        if (item.NextFollowupDate != null)
        {
            var d = item.NextFollowupDate.Value.Date;
            if (d < DateTime.Today)
                rowClass = "table-danger";
            else if (d == DateTime.Today)
                rowClass = "table-warning";
            else
                rowClass = "table-success";
        }
        var ownerAvatar = item.Owner?.LoginUser?.ProfileImagePath;
        if (string.IsNullOrWhiteSpace(ownerAvatar))
        {
            ownerAvatar = "/images/Profile/profile.png";
        }
    <div class="followup-card @rowClass">

        <div class="followup-card-header">
            <img class="followup-avatar"
                 src="@ownerAvatar"
                 alt="@item.Owner?.EmpName"
                 onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />

            <div class="followup-header-content">
                <div class="followup-title">@item.TaskTitle</div>
                <div class="followup-partner">@item.PartnerName</div>
            </div>

            <span class="badge bg-secondary">@item.Status</span>
        </div>

        <div class="followup-info">

            <div class="followup-info-row">
                <span class="followup-label">Owner</span>
                <span>@item.Owner?.EmpName</span>
            </div>

            <div class="followup-info-row">
                <span class="followup-label">Next</span>
                <span>@item.NextFollowupDate?.ToString("dd/MM/yyyy")</span>
            </div>

            <div class="followup-info-row">
                <span class="followup-label">Last</span>
                <span>
                    @if(item.LastContactDate != null)
                    {
                        @(item.LastContactDate?.ToString("dd/MM/yyyy")) @(" (" + item.LastContactType + ")")
                    }
                </span>
            </div>
        </div>

        <div class="followup-actions">
            @if (HasMenu("Followups.Details"))
            {
                <a href="/Followups/Details/@item.FollowupId" 
                   class="btn btn-sm btn-outline-secondary"
                   title="ดูรายละเอียด">
                    View
                </a>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดู">
                    View
                </button>
            }

            @if (HasMenu("Followups.Edit"))
            {
                <a href="/Followups/Edit/@item.FollowupId" 
                   class="btn btn-sm btn-outline-primary"
                   title="แก้ไข">
                    Edit
                </a>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                    Edit
                </button>
            }

            @if (HasMenu("Followups.Delete"))
            {
                <form method="post" action="/Followups/Delete" style="display:inline;" onsubmit="return confirm('ต้องการลบ Follow-up นี้หรือไม่?');">
                    <input type="hidden" name="followupId" value="@item.FollowupId" />
                    <input type="hidden" name="projectId" value="@Context.Request.Query["projectId"]" />
                    <button class="btn btn-sm btn-outline-danger" title="ลบ">Delete</button>
                </form>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                    Delete
                </button>
            }

            @if (HasMenu("Followups.Done"))
            {
                if(item.Status == "DONE" || item.Status == "ACK")
                {
                    <button class="btn btn-sm btn-outline-success"
                            title="รายการนี้ถูก DONE หรือ ACK แล้ว"
                            onclick="alert('ไม่สามารถกด DONE ได้ เนื่องจากรายการนี้ถูก DONE หรือ ACK แล้ว'); return false;">
                        Done
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-success"
                            title="ปิดงาน"
                            onclick="openDonePopup(@item.FollowupId)">
                        Done
                    </button>
                }
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ปิดงาน">
                    Done
                </button>
            }

            @if (HasMenu("Followups.Log"))
            {
                if(item.Status == "DONE" || item.Status == "ACK")
                {
                    <button class="btn btn-sm btn-outline-primary"
                            title="รายการนี้ถูก DONE หรือ ACK แล้ว"
                            onclick="alert('ไม่สามารถ Log ได้ เนื่องจากรายการนี้ถูก DONE หรือ ACK แล้ว'); return false;">
                        Log
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-primary"
                            title="บันทึกการติดตาม"
                            onclick="openQuickLog(@item.FollowupId)">
                        Log
                    </button>
                }
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์บันทึก">
                    Log
                </button>
            }
        </div>

    </div>
    no++;
    }
    </div>

}

<style>
.followup-filter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px;
    padding: 18px;
    margin-top: 16px;
    background: #fff;
    border: 1px solid #dbeafe;
    border-radius: 22px;
    box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
}

.followup-filter__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.followup-filter__field label {
    margin: 0;
    color: #0f2748;
    font-weight: 800;
}

.followup-filter .form-select {
    width: 100%;
    min-height: 54px;
    border: 1px solid #d7e2f2;
    border-radius: 16px;
    color: #10233f;
    font-family: 'Sarabun', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    background-color: #f8fbff;
}

.followup-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
}

.followup-card {
    background: #fff;
    border-radius: 22px;
    padding: 20px;
    border: 2px solid #dbeafe;
    box-shadow: 0 8px 22px rgba(15,23,42,.06);
}

.followup-card.table-danger {
    border-color: #fecaca;
    background: #fff5f5;
}

.followup-card.table-warning {
    border-color: #fde68a;
    background: #fffdf4;
}

.followup-card.table-success {
    border-color: #bbf7d0;
    background: #f0fdf4;
}

.followup-card-header {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 16px;
}

.followup-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    background: #fff;
    border: 3px solid #14b8a6;
    box-shadow: 0 10px 22px rgba(15,23,42,.16);
    flex-shrink: 0;
}

.followup-header-content {
    flex: 1;
}

.followup-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
}

.followup-partner {
    font-size: .92rem;
    color: #6b7280;
}

.followup-info {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.followup-info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    background: rgba(255,255,255,.75);
    border: 1px solid rgba(0,0,0,.05);
    border-radius: 14px;
    padding: 10px 14px;
}

.followup-label {
    color: #64748b;
    min-width: 70px;
    font-weight: 600;
}

.followup-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
}

.followup-actions .btn {
    flex: 1 1 calc(33.33% - 8px);
    min-width: 90px;
}

.followup-modal {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(4, 18, 39, .62);
    backdrop-filter: blur(4px);
    z-index: 26000;
}

.followup-modal__panel {
    width: min(760px, calc(100vw - 32px));
    max-height: calc(100vh - 48px);
    overflow: auto;
    background: #ffffff;
    border: 1px solid rgba(148, 163, 184, .35);
    border-radius: 24px;
    box-shadow: 0 28px 70px rgba(15, 23, 42, .34);
}

.followup-modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    padding: 24px 28px;
    color: #fff;
    background: linear-gradient(135deg, #0f2748 0%, #123b5c 64%, #0f766e 100%);
}

.followup-modal__eyebrow {
    display: block;
    margin-bottom: 6px;
    color: rgba(255, 255, 255, .72);
    font-size: .82rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.followup-modal__title {
    margin: 0;
    font-size: 1.55rem;
    font-weight: 800;
    line-height: 1.25;
}

.followup-modal__subtitle {
    margin: 8px 0 0;
    color: rgba(255, 255, 255, .78);
    font-size: .98rem;
}

.followup-modal__close {
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, .4);
    border-radius: 999px;
    background: rgba(255, 255, 255, .12);
    color: #fff;
    font-size: 1.45rem;
    line-height: 1;
}

.followup-modal__body {
    padding: 26px 28px 28px;
}

.followup-modal__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 18px;
}

.followup-modal__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.followup-modal__field--full {
    grid-column: 1 / -1;
}

.followup-modal__field label {
    margin: 0;
    color: #0f2748;
    font-weight: 800;
}

.followup-modal .form-control,
.followup-modal .form-select {
    min-height: 54px;
    border: 1px solid #d7e2f2;
    border-radius: 16px;
    color: #10233f;
    font-family: 'Sarabun', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    background-color: #f8fbff;
}

.followup-modal textarea.form-control {
    min-height: 160px;
    resize: vertical;
    line-height: 1.55;
}

.followup-modal__actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid #e5edf7;
}

.followup-modal__actions .btn {
    min-width: 150px;
    min-height: 48px;
    border-radius: 999px;
    font-weight: 800;
}

.followup-modal-open {
    overflow: hidden;
}

@@media (max-width:768px){
    .followup-filter {
        grid-template-columns: 1fr;
        padding: 14px;
    }

    .followup-cards {
        grid-template-columns: 1fr;
    }

    .followup-modal {
        padding: 14px;
    }

    .followup-modal__header,
    .followup-modal__body {
        padding: 20px;
    }

    .followup-modal__grid {
        grid-template-columns: 1fr;
    }

    .followup-modal__actions {
        flex-direction: column-reverse;
    }

    .followup-modal__actions .btn {
        width: 100%;
    }
}
</style>

<!-- Quick Log Modal -->
<div id="quickLogModal" class="followup-modal" onclick="if (event.target === this) closeQuickLog()">
    <div class="followup-modal__panel" role="dialog" aria-modal="true" aria-labelledby="quickLogTitle">
        <div class="followup-modal__header">
            <div>
                <span class="followup-modal__eyebrow">Follow-up Log</span>
                <h5 id="quickLogTitle" class="followup-modal__title">บันทึกการติดตาม</h5>
                <p class="followup-modal__subtitle">เพิ่มประวัติการติดต่อและกำหนดวันติดตามครั้งถัดไป</p>
            </div>
            <button type="button" class="followup-modal__close" onclick="closeQuickLog()" aria-label="ปิด">×</button>
        </div>

        <form method="post" action="/Followups/AddLog" class="followup-modal__body">
            <input type="hidden" name="projectId" value="@Context.Request.Query["projectId"]" />
            <input type="hidden" name="FollowupId" id="quickFollowupId" />

            <div class="followup-modal__grid">
                <div class="followup-modal__field">
                    <label for="quickContactType">Contact Type</label>
                    <select id="quickContactType" name="ContactType" class="form-select">
                        <option value="Call">Call</option>
                        <option value="Email">Email</option>
                        <option value="Meeting">Meeting</option>
                    </select>
                </div>

                <div class="followup-modal__field">
                    <label for="quickNextDate">Next Follow-up</label>
                    <input id="quickNextDate" type="date" name="NextFollowupDate" class="form-control" />
                </div>

                <div class="followup-modal__field followup-modal__field--full">
                    <label for="quickNote">Note</label>
                    <textarea id="quickNote" name="Note" class="form-control" rows="5" placeholder="บันทึกการติดต่อ..."></textarea>
                </div>
            </div>

            <div class="followup-modal__actions">
                <button type="button" class="btn btn-secondary" onclick="closeQuickLog()">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Done Popup -->
<div id="doneModal" class="followup-modal" onclick="if (event.target === this) closeDonePopup()">
    <div class="followup-modal__panel" role="dialog" aria-modal="true" aria-labelledby="doneModalTitle">
        <div class="followup-modal__header">
            <div>
                <span class="followup-modal__eyebrow">Follow-up Done</span>
                <h5 id="doneModalTitle" class="followup-modal__title">ปิดงานติดตาม</h5>
                <p class="followup-modal__subtitle">บันทึกผลก่อนเปลี่ยนสถานะงานติดตามเป็น Done</p>
            </div>
            <button type="button" class="followup-modal__close" onclick="closeDonePopup()" aria-label="ปิด">×</button>
        </div>

        <form method="post" action="/Followups/MarkDone" class="followup-modal__body">
            <input type="hidden" name="followupId" id="doneFollowupId" />
            <input type="hidden" name="projectId" value="@Context.Request.Query["projectId"]" />

            <div class="followup-modal__field">
                <label for="doneNote">Note</label>
                <textarea id="doneNote" name="Note" class="form-control" rows="5"
                          placeholder="บันทึกผลการดำเนินการ..."></textarea>
            </div>

            <div class="followup-modal__actions">
                <button type="button" class="btn btn-secondary" onclick="closeDonePopup()">Cancel</button>
                <button type="submit" class="btn btn-success">Done</button>
            </div>
        </form>
    </div>
</div>

<script>
function setFollowupModalOpen(isOpen){
    document.body.classList.toggle("followup-modal-open", isOpen);
}

function openQuickLog(id){
    document.getElementById("quickFollowupId").value = id;
    document.getElementById("quickLogModal").style.display = "flex";
    setFollowupModalOpen(true);
    setTimeout(function(){
        document.getElementById("quickNote")?.focus();
    }, 50);
}

function closeQuickLog(){
    document.getElementById("quickLogModal").style.display = "none";
    setFollowupModalOpen(false);
}

function openDonePopup(id){
    document.getElementById("doneFollowupId").value = id;
    document.getElementById("doneModal").style.display = "flex";
    setFollowupModalOpen(true);
    setTimeout(function(){
        document.getElementById("doneNote")?.focus();
    }, 50);
}

function closeDonePopup(){
    document.getElementById("doneModal").style.display = "none";
    setFollowupModalOpen(false);
}

document.addEventListener("keydown", function(event){
    if (event.key !== "Escape") return;
    closeQuickLog();
    closeDonePopup();
});
</script>

@model ProjectTracking.Models.ProjectFollowup
@using System.Globalization

@{
    ViewData["Title"] = "รายละเอียดงานติดตาม";
    var th = new CultureInfo("th-TH");

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string ThaiDate(DateTime? value) => value?.ToString("dd MMM yyyy", th) ?? "-";
    string ThaiDateTime(DateTime? value) => value?.ToString("dd MMM yyyy HH:mm", th) ?? "-";
}

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">รายละเอียดงานติดตาม</h2>
        <p class="index-subtitle">Follow-up #@Model.FollowupId</p>
    </div>
</div>

<style>
.followup-detail-card {
    border: 2px solid #dbeafe;
    border-radius: 24px;
    box-shadow: 0 8px 24px rgba(15,23,42,.06);
}

.followup-info-block {
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 16px 18px;
    display: grid;
    gap: 10px;
}

.followup-info-line {
    min-width: 0;
    color: #0f172a;
    font-size: 1rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
}

.followup-info-label {
    color: #0f172a;
    font-size: 1rem;
    font-weight: 700;
    line-height: inherit;
    margin-right: 6px;
}

.followup-info-value {
    color: #0f172a;
    font-size: 1rem;
    font-weight: 400;
    line-height: inherit;
    overflow-wrap: anywhere;
}

.history-card {
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 16px;
    background: #fff;
    margin-bottom: 12px;
}

.history-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    flex-wrap: wrap;
}

.history-date {
    font-weight: 700;
}

.history-type {
    background: #dbeafe;
    color: #1d4ed8;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: .82rem;
    font-weight: 700;
}

.history-note {
    color: #334155;
    white-space: pre-wrap;
}

.followup-section-title {
    margin: 0 0 14px;
    color: #10233f;
    font-size: 1.08rem;
    font-weight: 900;
}

@@media (max-width:768px){
    .followup-info-block {
        padding: 14px;
    }
}
</style>

<div class="card mb-4 followup-detail-card border-0">
    <div class="card-body">
        <div class="followup-info-block">
            <div class="followup-info-line">
                <span class="followup-info-label">โครงการ:</span>
                <span class="followup-info-value">@TextOrDash(Model.Project?.ProjectDisplayName)</span>
            </div>

            <div class="followup-info-line">
                <span class="followup-info-label">ผู้รับผิดชอบ:</span>
                <span class="followup-info-value">@TextOrDash(Model.Owner?.EmpName)</span>
            </div>

            <div class="followup-info-line">
                <span class="followup-info-label">ผู้สั่งงาน:</span>
                <span class="followup-info-value">@TextOrDash(Model.CreatedByEmployee?.EmpName)</span>
            </div>

            <div class="followup-info-line">
                <span class="followup-info-label">งาน:</span>
                <span class="followup-info-value">@TextOrDash(Model.TaskTitle)</span>
            </div>

            <div class="followup-info-line">
                <span class="followup-info-label">คู่ติดต่อ:</span>
                <span class="followup-info-value">@TextOrDash(Model.PartnerName)</span>
            </div>

            <div class="followup-info-line">
                <span class="followup-info-label">วันที่ติดตามถัดไป:</span>
                <span class="followup-info-value">@ThaiDate(Model.NextFollowupDate)</span>
            </div>

            <div class="followup-info-line">
                <span class="followup-info-label">ติดต่อล่าสุด:</span>
                <span class="followup-info-value">@ThaiDateTime(Model.LastContactDate)</span>
            </div>

            <div class="followup-info-line">
                <span class="followup-info-label">ประเภทการติดต่อ:</span>
                <span class="followup-info-value">@TextOrDash(Model.LastContactType)</span>
            </div>

            <div class="followup-info-line">
                <span class="followup-info-label">สร้างเมื่อ:</span>
                <span class="followup-info-value">@ThaiDateTime(Model.CreatedAt)</span>
            </div>

            <div class="followup-info-line">
                <span class="followup-info-label">สถานะ:</span>
                <span class="followup-info-value">@TextOrDash(Model.Status)</span>
            </div>
        </div>
    </div>
</div>


<h3 class="followup-section-title">ประวัติการติดตาม</h3>


<div class="p-3">
@if(((List<ProjectTracking.Models.ProjectFollowupLog>)ViewBag.Logs).Any())
{
    @foreach(var log in (List<ProjectTracking.Models.ProjectFollowupLog>)ViewBag.Logs)
    {
        <div class="history-card">
            <div class="history-header">
                <div class="history-date">
                    @log.ContactDate.ToString("dd MMM yyyy HH:mm", th)
                </div>

                <div class="history-type">
                    @log.ContactType
                </div>
            </div>

            <div class="history-note">
                @(string.IsNullOrWhiteSpace(log.Note) ? "-" : log.Note)
            </div>
        </div>
    }
}
else
{
    <div class="text-center text-muted py-4">
        ไม่พบประวัติการติดตาม
    </div>
}
</div>


<div class="pt-form-actions">
    <a asp-action="Index"
       asp-route-projectId="@Model.ProjectId"
       class="btn btn-outline-secondary">
        กลับ
    </a>
</div>

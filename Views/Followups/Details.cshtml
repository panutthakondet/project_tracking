@model ProjectTracking.Models.ProjectFollowup

<h3 class="fw-bold mb-4">📌 Follow‑up Detail</h3>

<style>
.followup-detail-card {
    border: 2px solid #dbeafe;
    border-radius: 24px;
    box-shadow: 0 8px 24px rgba(15,23,42,.06);
}

.info-box {
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 14px 18px;
    height: 100%;
}

.info-label {
    font-size: .82rem;
    color: #64748b;
    margin-bottom: 4px;
    font-weight: 600;
}

.info-value {
    font-size: 1rem;
    font-weight: 700;
    color: #0f172a;
    word-break: break-word;
}

.history-card {
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 16px;
    background: #fff;
    margin-bottom: 12px;
}

.history-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    flex-wrap: wrap;
}

.history-date {
    font-weight: 700;
}

.history-type {
    background: #dbeafe;
    color: #1d4ed8;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: .82rem;
    font-weight: 700;
}

.history-note {
    color: #334155;
    white-space: pre-wrap;
}

@@media (max-width:768px){
    .info-box {
        margin-bottom: 12px;
    }
}
</style>

<div class="card mb-4 followup-detail-card border-0">
    <div class="card-body">
        <div class="row">
            <div class="col-12 mb-3">
                <div class="info-box">
                    <div class="info-label">Project</div>
                    <div class="info-value">@Model.Project?.ProjectName</div>
                </div>
            </div>
            <div class="col-12 mb-3">
                <div class="info-box">
                    <div class="info-label">Owner</div>
                    <div class="info-value">@Model.Owner?.EmpName</div>
                </div>
            </div>
            <div class="col-12 mb-3">
                <div class="info-box">
                    <div class="info-label">Task</div>
                    <div class="info-value">@Model.TaskTitle</div>
                </div>
            </div>
            <div class="col-12 mb-3">
                <div class="info-box">
                    <div class="info-label">Partner</div>
                    <div class="info-value">@Model.PartnerName</div>
                </div>
            </div>
            <div class="col-12 mb-3">
                <div class="info-box">
                    <div class="info-label">Next Follow‑up</div>
                    <div class="info-value">@Model.NextFollowupDate?.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
            <div class="col-12 mb-3">
                <div class="info-box">
                    <div class="info-label">Last Contact</div>
                    <div class="info-value">
                        @if(Model.LastContactDate != null)
                        {
                            @Model.LastContactDate?.ToString("dd/MM/yyyy HH:mm")
                        }
                    </div>
                </div>
            </div>
            <div class="col-12 mb-3">
                <div class="info-box">
                    <div class="info-label">Contact Type</div>
                    <div class="info-value">@Model.LastContactType</div>
                </div>
            </div>
            <div class="col-12 mb-3">
                <div class="info-box">
                    <div class="info-label">Created</div>
                    <div class="info-value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
            <div class="col-12 mb-3">
                <div class="info-box">
                    <div class="info-label">Status</div>
                    <div class="info-value">
                        <span class="badge bg-primary px-3 py-2">@Model.Status</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<h5 class="fw-bold mb-3">📜 History</h5>


<div class="p-3">
@if(((List<ProjectTracking.Models.ProjectFollowupLog>)ViewBag.Logs).Any())
{
    @foreach(var log in (List<ProjectTracking.Models.ProjectFollowupLog>)ViewBag.Logs)
    {
        <div class="history-card">
            <div class="history-header">
                <div class="history-date">
                    @log.ContactDate.ToString("dd/MM/yyyy HH:mm")
                </div>

                <div class="history-type">
                    @log.ContactType
                </div>
            </div>

            <div class="history-note">
                @(string.IsNullOrWhiteSpace(log.Note) ? "-" : log.Note)
            </div>
        </div>
    }
}
else
{
    <div class="text-center text-muted py-4">
        No history found
    </div>
}
</div>


<div class="mt-4">
    <a asp-action="Index"
       asp-route-projectId="@Model.ProjectId"
       class="btn btn-secondary">
        ← Back
    </a>
</div>

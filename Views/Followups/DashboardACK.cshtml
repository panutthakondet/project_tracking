@using Microsoft.AspNetCore.Http
@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Follow-up DONE (Waiting ACK)";
    var th = new System.Globalization.CultureInfo("th-TH");
    int i = 1;
    var owners = Model.Select(x => (string)x.Owner).Distinct().OrderBy(x => x).ToList();

    Func<string, bool> HasMenu = key =>
    {
        var menus = Context.Session.GetString("Menus");
        if (string.IsNullOrEmpty(menus)) return false;
        return menus.Split(',').Any(m => m.Trim().Equals(key, StringComparison.OrdinalIgnoreCase));
    };
}

@if (!HasMenu("Followups.DashboardACK"))
{
    <div class="container">
        <div class="alert alert-danger fw-bold">
            ❌ ไม่มีสิทธิ์เข้าหน้านี้
        </div>
        <a class="btn btn-outline-secondary" href="/Followups">← กลับ</a>
    </div>
    return;
}

<div class="container-fluid">

    <div class="index-hero pt-form-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="index-title">งานติดตามรอรับทราบ</h2>
            <p class="index-subtitle">รายการที่ Owner ทำเสร็จแล้วและรอ ACK</p>
        </div>
        <div class="index-actions">
            <a class="btn btn-outline-secondary" href="/Followups">กลับรายการ</a>
        </div>
    </div>

    <div class="followup-dashboard-filter mb-3">
        <label class="form-label fw-bold">Filter Owner</label>
        <select id="ownerFilter"
                class="form-select form-select-lg"
                data-placeholder="🔍 ค้นหา Owner..."
                onchange="filterOwner()">
            <option value="">-- All Owner --</option>
            @foreach (var o in owners)
            {
                <option value="@o">@o</option>
            }
        </select>
    </div>

    <div class="table-responsive" style="display:none;">
        <table class="table table-bordered table-hover align-middle">

            <thead class="table-dark text-center">
                <tr>
                    <th style="width:60px">No.</th>
                    <th>Project</th>
                    <th style="width:200px">Task</th>
                    <th style="width:100px">Partner</th>
                    <th style="width:180px">Owner</th>
                    <th style="width:150px">Follow-up Date</th>
                    <th style="width:120px">State</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {

                    var projectId = item.ProjectId;
                    var targetUrl = projectId != null ? Url.Action("Index", "Followups", new { projectId = projectId }) : null;

                    string rowClass = "table-success";

                    <tr class="@rowClass" data-owner="@item.Owner"
                        style="cursor:@(targetUrl != null && HasMenu("Followups.Index") ? "pointer" : "default")"
                        onclick="@(targetUrl != null && HasMenu("Followups.Index") ? $"window.location.href='{targetUrl}'" : "")">

                        <td class="text-center">@i</td>

                        <td>
                            @item.Project
                        </td>

                        <td>
                            @item.TaskTitle
                        </td>

                        <td class="text-center">
                            @item.PartnerName
                        </td>

                        <td>
                            @item.Owner
                        </td>

                        <td class="text-center">
                            @{
                                DateTime? fdate = item.NextFollowupDate;
                            }
                            @(fdate != null ? fdate.Value.ToString("dd MMM yyyy", th) : "-")
                        </td>

                        <td class="text-center fw-bold">
                            <span class="badge bg-success">DONE</span>
                        </td>

                    </tr>

                    i++;
                }

            </tbody>

        </table>
    </div>

<div class="followup-dashboard-cards">

@{
    i = 1;
}

@foreach (var item in Model)
{
    var projectId = item.ProjectId;
    var targetUrl = projectId != null
        ? Url.Action("Index", "Followups", new { projectId = projectId })
        : null;
    string ownerAvatar = Convert.ToString(item.OwnerAvatar);
    if (string.IsNullOrWhiteSpace(ownerAvatar))
    {
        ownerAvatar = "/images/Profile/profile.png";
    }

    <div class="followup-dashboard-card success"
         data-owner="@item.Owner"
         style="cursor:@(targetUrl != null && HasMenu("Followups.Index") ? "pointer" : "default")"
         onclick="@(targetUrl != null && HasMenu("Followups.Index") ? $"window.location.href='{targetUrl}'" : "")">

        <div class="followup-dashboard-header">
            <img class="followup-dashboard-avatar"
                 src="@ownerAvatar"
                 alt="@item.Owner"
                 onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />

            <div class="followup-dashboard-header-content">
                <div class="followup-dashboard-project">
                    @i. @item.Project
                </div>

                <div class="followup-dashboard-task">
                    @item.TaskTitle
                </div>
            </div>

            <span class="badge bg-success">
                DONE
            </span>
        </div>

        <div class="followup-dashboard-info">

            <div class="followup-dashboard-row">
                <span class="label">Partner</span>
                <span>@item.PartnerName</span>
            </div>

            <div class="followup-dashboard-row">
                <span class="label">Owner</span>
                <span>@item.Owner</span>
            </div>

            <div class="followup-dashboard-row">
                <span class="label">Date</span>
                <span>
                    @{
                        DateTime? fdate = item.NextFollowupDate;
                    }
                    @(fdate != null ? fdate.Value.ToString("dd MMM yyyy", th) : "-")
                </span>
            </div>
        </div>
    </div>

    i++;
}

</div>

<style>
.followup-dashboard-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
}

.followup-dashboard-card {
    background: #fff;
    border-radius: 22px;
    padding: 20px;
    border: 2px solid #bbf7d0;
    background: #f0fdf4;
    box-shadow: 0 8px 22px rgba(15,23,42,.06);
    transition: .2s ease;
}

.followup-dashboard-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(15,23,42,.10);
}

.followup-dashboard-header {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 16px;
}

.followup-dashboard-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    background: #fff;
    border: 3px solid #14b8a6;
    box-shadow: 0 10px 22px rgba(15,23,42,.16);
    flex-shrink: 0;
}

.followup-dashboard-header-content {
    flex: 1;
}

.followup-dashboard-project {
    font-size: 1.05rem;
    font-weight: 700;
}

.followup-dashboard-task {
    font-size: .92rem;
    color: #64748b;
    margin-top: 4px;
}

.followup-dashboard-info {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.followup-dashboard-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    background: rgba(255,255,255,.75);
    border: 1px solid rgba(0,0,0,.05);
    border-radius: 14px;
    padding: 10px 14px;
}

.followup-dashboard-row .label {
    color: #64748b;
    font-weight: 600;
}

@@media (max-width:768px){
    .followup-dashboard-cards {
        grid-template-columns: 1fr;
    }
}
</style>

<script>
function filterOwner() {
    const selected = document.getElementById("ownerFilter").value.toLowerCase();
    const rows = document.querySelectorAll("tbody tr");
    const cards = document.querySelectorAll(".followup-dashboard-card");

    rows.forEach(r => {
        const owner = (r.getAttribute("data-owner") || "").toLowerCase();

        if (selected === "" || owner === selected) {
            r.style.display = "";
        } else {
            r.style.display = "none";
        }
    });

    cards.forEach(c => {
        const owner = (c.getAttribute("data-owner") || "").toLowerCase();

        if (selected === "" || owner === selected) {
            c.style.display = "";
        } else {
            c.style.display = "none";
        }
    });
}
</script>

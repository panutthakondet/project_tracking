@using Microsoft.AspNetCore.Http
@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Follow-up Dashboard";
    var th = new System.Globalization.CultureInfo("th-TH");
    int i = 1;
    var selectedOwnerEmpId = Convert.ToString(ViewBag.SelectedOwnerEmpId ?? "") ?? "";
    var ownerEmployees = ViewBag.OwnerEmployees as IEnumerable<ProjectTracking.Models.Employee> ?? Enumerable.Empty<ProjectTracking.Models.Employee>();
    var selectedStatus = Convert.ToString(ViewBag.SelectedStatus ?? "") ?? "";
    var statusList = ViewBag.StatusList as IEnumerable<string> ?? Enumerable.Empty<string>();

    string StatusText(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "เปิดงาน",
        "DONE" => "เสร็จแล้ว",
        "ACK" => "รับทราบแล้ว",
        _ => string.IsNullOrWhiteSpace(status) ? "-" : status.Trim()
    };

    Func<string, bool> HasMenu = key =>
    {
        var menus = Context.Session.GetString("Menus");
        if (string.IsNullOrEmpty(menus)) return false;
        return menus.Split(',').Any(m => m.Trim().Equals(key, StringComparison.OrdinalIgnoreCase));
    };
}

@if (!HasMenu("Followups.Dashboard"))
{
    <div class="container">
        <div class="alert alert-danger fw-bold">
            ❌ ไม่มีสิทธิ์เข้าหน้านี้
        </div>
        <a class="btn btn-outline-secondary" href="/Followups">← กลับ</a>
    </div>
    return;
}

<div class="container-fluid">

    <div class="index-hero pt-form-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h2 class="index-title">แดชบอร์ดงานติดตาม</h2>
            <p class="index-subtitle">ดูงานติดตามตามเจ้าของงานและกำหนดติดตาม</p>
        </div>
        <div class="index-actions">
            <a class="btn btn-outline-secondary" href="/Followups">กลับรายการ</a>
        </div>
    </div>

    <form method="get" action="/Followups/Dashboard" class="followup-dashboard-filter mb-3">
        <div class="followup-dashboard-filter__field">
            <label class="form-label fw-bold" for="ownerEmpId">👤 ผู้รับผิดชอบ</label>
            <select id="ownerEmpId"
                    name="ownerEmpId"
                    class="form-select form-select-lg"
                    data-placeholder="🔍 ค้นหา Owner..."
                    onchange="this.form.submit()">
                <option value="">-- ทุกคน --</option>
                @foreach (var owner in ownerEmployees)
                {
                    var value = owner.EmpId.ToString();
                    <option value="@value" selected="@(selectedOwnerEmpId == value ? "selected" : null)">
                        @owner.EmpName
                    </option>
                }
            </select>
        </div>

        <div class="followup-dashboard-filter__field">
            <label class="form-label fw-bold" for="status">📌 สถานะ</label>
            <select id="status"
                    name="status"
                    class="form-select form-select-lg"
                    data-placeholder="🔍 ค้นหาสถานะ..."
                    onchange="this.form.submit()">
                <option value="">-- ทุกสถานะ --</option>
                @foreach (var status in statusList)
                {
                    <option value="@status" selected="@(selectedStatus == status ? "selected" : null)">
                        @StatusText(status)
                    </option>
                }
            </select>
        </div>
    </form>

    <div class="table-responsive" style="display:none;">
        <table class="table table-bordered table-hover align-middle">

            <thead class="table-dark text-center">
                <tr>
                    <th style="width:60px">No.</th>
                    <th>Project</th>
                    <th style="width:200px">Task</th>
                    <th style="width:100px">Partner</th>
                    <th style="width:180px">Owner</th>
                    <th style="width:150px">Follow-up Date</th>
                    <th style="width:120px">สถานะ</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {

                    var projectId = item.ProjectId;
                    var ownerEmpId = item.OwnerEmpId;
                    var coopName = Convert.ToString(item.CoopName) ?? "";
                    var targetUrl = projectId != null
                        ? Url.Action("Index", "Followups", new { coopName = coopName, projectId = projectId, ownerEmpId = ownerEmpId })
                        : Url.Action("Index", "Followups", new { coopName = coopName, ownerEmpId = ownerEmpId });
                    var followupStatus = Convert.ToString(item.Status) ?? "";

                    string rowClass = "";

                    if (followupStatus == "DONE")
                    {
                        rowClass = "table-success";
                    }
                    else if (followupStatus == "ACK")
                    {
                        rowClass = "table-primary";
                    }
                    else
                    {
                        rowClass = "table-warning";
                    }

                    <tr class="@rowClass" data-owner="@item.Owner"
                        style="cursor:@(targetUrl != null && HasMenu("Followups.Index") ? "pointer" : "default")"
                        onclick="@(targetUrl != null && HasMenu("Followups.Index") ? $"window.location.href='{targetUrl}'" : "")">

                        <td class="text-center">@i</td>

                        <td>
                            @item.Project
                        </td>

                        <td>
                            @item.TaskTitle
                        </td>

                        <td class="text-center">
                            @item.PartnerName
                        </td>

                        <td>
                            @item.Owner
                        </td>

                        <td class="text-center">
                            @(((DateTime)item.NextFollowupDate).ToString("dd MMM yyyy", th))
                        </td>

                        <td class="text-center fw-bold">
                            @StatusText(followupStatus)
                        </td>

                    </tr>

                    i++;
                }

            </tbody>

        </table>
    </div>

    <div class="followup-dashboard-cards">

@{
    i = 1;
}

@foreach (var item in Model)
{
    var projectId = item.ProjectId;
    var ownerEmpId = item.OwnerEmpId;
    var coopName = Convert.ToString(item.CoopName) ?? "";
    var targetUrl = projectId != null
        ? Url.Action("Index", "Followups", new { coopName = coopName, projectId = projectId, ownerEmpId = ownerEmpId })
        : Url.Action("Index", "Followups", new { coopName = coopName, ownerEmpId = ownerEmpId });
    var followupStatus = Convert.ToString(item.Status) ?? "";

    string rowClass = "";

    if (followupStatus == "DONE")
    {
        rowClass = "done";
    }
    else if (followupStatus == "ACK")
    {
        rowClass = "ack";
    }
    else
    {
        rowClass = "open";
    }
    string ownerAvatar = ProjectTracking.Services.ProfileImagePathResolver.Normalize(
        Convert.ToString(item.OwnerAvatar));

    <div class="followup-dashboard-card @rowClass"
         data-owner="@item.Owner"
         style="cursor:@(targetUrl != null && HasMenu("Followups.Index") ? "pointer" : "default")"
         onclick="@(targetUrl != null && HasMenu("Followups.Index") ? $"window.location.href='{targetUrl}'" : "")">

        <div class="followup-dashboard-header">
            <img class="followup-dashboard-avatar"
                 src="@ownerAvatar"
                 alt="@item.Owner"
                 onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />

            <div class="followup-dashboard-header-content">
                <div class="followup-dashboard-project">
                    @i. @item.Project
                </div>

                <div class="followup-dashboard-task">
                    @item.TaskTitle
                </div>
            </div>

            <span class="badge followup-status-badge @followupStatus.ToLowerInvariant()">
                @StatusText(followupStatus)
            </span>
        </div>

        <div class="followup-dashboard-info">

            <div class="followup-dashboard-row">
                <span class="label">Partner</span>
                <span>@item.PartnerName</span>
            </div>

            <div class="followup-dashboard-row">
                <span class="label">Owner</span>
                <span>@item.Owner</span>
            </div>

            <div class="followup-dashboard-row">
                <span class="label">Date</span>
                <span>@(((DateTime)item.NextFollowupDate).ToString("dd MMM yyyy", th))</span>
            </div>
        </div>
    </div>

    i++;
}

</div>

</div>
<style>
.followup-dashboard-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
}

.followup-dashboard-filter {
    width: 100%;
    padding: 16px;
    border: 1px solid #d8e3ef;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.followup-dashboard-filter__field {
    min-width: 0;
}

.followup-dashboard-filter .form-label {
    color: #10233f;
    margin-bottom: 8px;
}

.followup-dashboard-filter .pt-search-select,
.followup-dashboard-filter .form-select {
    width: 100%;
}

.followup-dashboard-filter .pt-search-select__input {
    min-height: 54px;
    font-size: 1rem !important;
    font-weight: 800;
}

.followup-dashboard-card {
    background: #fff;
    border-radius: 22px;
    padding: 20px;
    border: 2px solid #dbeafe;
    box-shadow: 0 8px 22px rgba(15,23,42,.06);
    transition: .2s ease;
}

.followup-dashboard-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(15,23,42,.10);
}

.followup-dashboard-card.overdue {
    border-color: #fecaca;
    background: #fff5f5;
}

.followup-dashboard-card.today {
    border-color: #fde68a;
    background: #fffdf4;
}

.followup-dashboard-card.future {
    border-color: #bbf7d0;
    background: #f0fdf4;
}

.followup-dashboard-card.open {
    border-color: #fde68a;
    background: #fffbeb;
}

.followup-dashboard-card.done {
    border-color: #86efac;
    background: #ecfdf5;
}

.followup-dashboard-card.ack {
    border-color: #93c5fd;
    background: #eff6ff;
}

.followup-status-badge.open {
    background: #f59e0b;
}

.followup-status-badge.done {
    background: #16a34a;
}

.followup-status-badge.ack {
    background: #2563eb;
}

.followup-dashboard-header {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 16px;
}

.followup-dashboard-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    background: #fff;
    border: 3px solid #14b8a6;
    box-shadow: 0 10px 22px rgba(15,23,42,.16);
    flex-shrink: 0;
}

.followup-dashboard-header-content {
    flex: 1;
}

.followup-dashboard-project {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
}

.followup-dashboard-task {
    font-size: .92rem;
    color: #64748b;
    margin-top: 4px;
}

.followup-dashboard-info {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.followup-dashboard-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    background: rgba(255,255,255,.75);
    border: 1px solid rgba(0,0,0,.05);
    border-radius: 14px;
    padding: 10px 14px;
}

.followup-dashboard-row .label {
    color: #64748b;
    font-weight: 600;
}

@@media (max-width:768px){
    .followup-dashboard-cards {
        grid-template-columns: 1fr;
    }

    .followup-dashboard-filter {
        grid-template-columns: 1fr;
    }
}
</style>

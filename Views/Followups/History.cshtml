

@model List<ProjectTracking.Models.ProjectFollowupLog>

@{
    ViewData["Title"] = "Follow-up History";
    var followup = ViewBag.Followup;
}

<h2 class="fw-bold mb-4">📜 Follow-up History</h2>

@if (followup != null)
{
    <div class="followup-task-box">
        <div class="followup-task-label">
            FOLLOW-UP TASK
        </div>

        <div class="followup-task-title">
            @followup.TaskTitle
        </div>
    </div>
}

<style>
.followup-history-card {
    border: 2px solid #dbeafe;
    border-radius: 24px;
    padding: 22px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(15,23,42,.06);
    margin-bottom: 18px;
}

.followup-task-box {
    background: linear-gradient(135deg,#eff6ff,#dbeafe);
    border: 1px solid #bfdbfe;
    border-radius: 18px;
    padding: 16px 20px;
    margin-bottom: 20px;
}

.followup-task-label {
    font-size: .82rem;
    color: #64748b;
    font-weight: 700;
    margin-bottom: 4px;
}

.followup-task-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
}

.history-item {
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    background: #fff;
    padding: 18px;
    margin-bottom: 14px;
}

.history-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
}

.history-number {
    font-size: 1rem;
    font-weight: 700;
    color: #1d4ed8;
}

.history-type {
    background: #dbeafe;
    color: #1d4ed8;
    border-radius: 999px;
    padding: 6px 12px;
    font-size: .82rem;
    font-weight: 700;
}

.history-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-bottom: 14px;
}

.history-box {
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 12px 14px;
}

.history-label {
    font-size: .78rem;
    color: #64748b;
    font-weight: 700;
    margin-bottom: 4px;
}

.history-value {
    font-weight: 600;
    color: #0f172a;
}

.history-note {
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 14px;
    white-space: pre-wrap;
    color: #334155;
}

@@media (max-width:768px){
    .history-header {
        flex-direction: column;
        align-items: stretch;
    }
}
</style>

<div class="followup-history-card">

    @{
        int no = 1;
    }

    @if (Model.Any())
    {
        @foreach (var log in Model)
        {
            <div class="history-item">

                <div class="history-header">
                    <div class="history-number">
                        #@no Follow-up
                    </div>

                    <div class="history-type">
                        @log.ContactType
                    </div>
                </div>

                <div class="history-grid">

                    <div class="history-box">
                        <div class="history-label">Contact Date</div>
                        <div class="history-value">
                            @log.ContactDate.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    <div class="history-box">
                        <div class="history-label">Next Follow-up</div>
                        <div class="history-value">
                            @(log.NextFollowupDate?.ToString("dd/MM/yyyy") ?? "-")
                        </div>
                    </div>
                </div>

                <div class="history-label mb-2">Note</div>
                <div class="history-note">
                    @(string.IsNullOrWhiteSpace(log.Note) ? "-" : log.Note)
                </div>
            </div>

            no++;
        }
    }
    else
    {
        <div class="text-center text-muted py-5">
            No history found
        </div>
    }

</div>

<div class="mt-3">
    <a asp-action="Index"
       asp-route-projectId="@followup?.ProjectId"
       class="btn btn-outline-secondary px-4 rounded-pill">
        Back
    </a>
</div>

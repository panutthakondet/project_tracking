@model ProjectTracking.Models.ProjectFollowup
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "แก้ไขงานติดตาม";
    var statusList = ViewBag.StatusList as IEnumerable<string> ?? Enumerable.Empty<string>();

    string StatusText(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "เปิดงาน",
        "DONE" => "เสร็จแล้ว",
        "ACK" => "รับทราบแล้ว",
        _ => string.IsNullOrWhiteSpace(status) ? "-" : status.Trim()
    };
}

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">แก้ไขงานติดตาม</h2>
        <p class="index-subtitle">Follow-up #@Model.FollowupId</p>
    </div>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="FollowupId" />
    <input type="hidden" asp-for="ProjectId" />

    <div class="mb-3">
        <label class="form-label">Project</label>
        <input type="text" class="form-control" value="@ViewBag.ProjectName" readonly />
    </div>

    <div class="form-group mb-3">
        <label asp-for="TaskTitle" class="form-label">Task</label>
        <input asp-for="TaskTitle" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label class="form-label">ผู้สั่งงาน</label>
        <input type="text" class="form-control" value="@(Model.CreatedByEmployee?.EmpName ?? "-")" readonly />
    </div>

    <div class="form-group mb-3">
        <label asp-for="PartnerName" class="form-label">Partner</label>
        <input asp-for="PartnerName" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="OwnerEmpId" class="form-label">Owner</label>
        <select asp-for="OwnerEmpId"
                class="form-select form-select-lg"
                data-placeholder="🔍 ค้นหา Owner..."
                asp-items="@(new SelectList(ViewBag.Employees ?? new List<ProjectTracking.Models.Employee>(), "EmpId", "EmpName"))">
            <option value="">-- เลือก Owner --</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="NextFollowupDate" class="form-label">Next Follow-up Date</label>
        <input asp-for="NextFollowupDate" type="date" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Status" class="form-label">สถานะ</label>
        <select asp-for="Status"
                class="form-select form-select-lg"
                data-placeholder="🔍 ค้นหาสถานะ...">
            @foreach (var status in statusList)
            {
                <option value="@status" selected="@(Model.Status == status ? "selected" : null)">
                    @StatusText(status)
                </option>
            }
        </select>
    </div>

    <div class="pt-form-actions">
        <button type="submit" class="btn btn-primary">
            Save
        </button>

        <a asp-action="Index"
           asp-route-projectId="@Model.ProjectId"
           class="btn btn-outline-secondary">
            Back
        </a>
    </div>
</form>

@using System.Linq
@model IEnumerable<ProjectTracking.Models.Employee>

@{
    ViewData["Title"] = "Employee List";

    var menus = Context.Session.GetString("Menus") ?? "";
    var allowedMenus = menus.Split(',').Select(x => x.Trim()).ToList();

    bool HasMenu(string key)
    {
        return allowedMenus.Contains(key);
    }

    string EmployeeAvatar(ProjectTracking.Models.Employee emp)
    {
        var profileImages = ViewBag.EmployeeProfileImages as IReadOnlyDictionary<int, string>;
        var path = profileImages != null && profileImages.TryGetValue(emp.EmpId, out var resolvedPath)
            ? resolvedPath?.Trim()
            : emp.LoginUser?.ProfileImagePath?.Trim();
        return ProjectTracking.Services.ProfileImagePathResolver.Normalize(path);
    }

    var lineLinkedEmpIds = ViewBag.LineLinkedEmpIds as ISet<int> ?? new HashSet<int>();
    var telegramLinkedEmpIds = ViewBag.TelegramLinkedEmpIds as ISet<int> ?? new HashSet<int>();
    var departments = ViewBag.ProjectDepartments as IEnumerable<ProjectTracking.Models.ProjectDepartment>
        ?? Enumerable.Empty<ProjectTracking.Models.ProjectDepartment>();
    var selectedDepartment = ViewBag.SelectedDepartment as string ?? "all";

    bool HasLineLink(ProjectTracking.Models.Employee emp)
    {
        return lineLinkedEmpIds.Contains(emp.EmpId);
    }

    bool HasTelegramLink(ProjectTracking.Models.Employee emp)
    {
        return telegramLinkedEmpIds.Contains(emp.EmpId);
    }
}

<!-- ================= HEADER ================= -->
<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">บันทึกข้อมูลพนักงาน</h2>
        <p class="index-subtitle">รายชื่อพนักงานทั้งหมดในระบบ</p>
    </div>

    <div class="index-actions">
        @if (HasMenu("Employees.Create"))
        {
            <a asp-action="Create"
               class="btn btn-primary"
               title="เพิ่มพนักงาน">
                Add Employee
            </a>
        }
        else
        {
            <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์เพิ่มพนักงาน">
                Add Employee
            </button>
        }
    </div>
</div>

<form asp-action="Index" method="get" class="employee-department-filter">
    <div class="employee-department-filter__field">
        <label for="employeeDepartmentFilter">ฝ่าย</label>
        <select id="employeeDepartmentFilter"
                name="department"
                class="form-select"
                onchange="this.form.submit()">
            <option value="all" selected="@(selectedDepartment == "all" ? "selected" : null)">ทุกฝ่าย</option>
            @foreach (var department in departments)
            {
                var departmentValue = department.DepartmentId.ToString();
                <option value="@departmentValue"
                        selected="@(selectedDepartment == departmentValue ? "selected" : null)">@department.DepartmentName</option>
            }
            <option value="unassigned" selected="@(selectedDepartment == "unassigned" ? "selected" : null)">ยังไม่กำหนดฝ่าย</option>
        </select>
    </div>
    <span class="employee-department-filter__count">@Model.Count() คน</span>
</form>

<!-- ================= TABLE ================= -->
<div class="table-responsive" style="display:none;">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th width="80">#</th>
                <th width="80">Profile</th>
                <th>Name</th>
                <th>Position</th>
                <th>Department</th>
                <th>Email</th>
                <th width="120">Status</th>
                <th width="190">LINE / Telegram</th>
                <th width="180">Action</th>
            </tr>
        </thead>

        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="9"
                    class="text-center text-muted">
                    — No employee data —
                </td>
            </tr>
        }
        else
        {
            var row = 0;
            foreach (var emp in Model.OrderBy(e => e.Position).ThenBy(e => e.EmpId))
            {
                <tr id="employee-@emp.EmpId">
                    @{ row++; }
                    <td class="text-center">@row</td>

                    <td class="text-center">
                        <img class="employee-table-avatar"
                             src="@EmployeeAvatar(emp)"
                             alt="@emp.EmpName"
                             loading="lazy"
                             onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                    </td>

                    <td>
                        <b>@emp.EmpName</b>
                    </td>

                    <td>
                        @emp.Position
                    </td>

                    <td>
                        @(emp.Department?.DepartmentName ?? "-")
                    </td>

                    <td class="employee-table-email">
                        @if (emp.LoginUser != null)
                        {
                            @emp.LoginUser.Email
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>

                    <td class="text-center">
                        <span class="badge
                            @(emp.Status == "ACTIVE"
                                ? "bg-success"
                                : "bg-secondary")">
                            @emp.Status
                        </span>
                    </td>

                    <td class="text-center">
                        <div class="employee-link-status-list">
                            <span class="employee-line-badge @(HasLineLink(emp) ? "is-linked" : "is-missing")">
                                LINE: @(HasLineLink(emp) ? "LINK แล้ว" : "ยังไม่ลิงค์")
                            </span>
                            <span class="employee-line-badge @(HasTelegramLink(emp) ? "is-linked" : "is-missing")">
                                Telegram: @(HasTelegramLink(emp) ? "LINK แล้ว" : "ยังไม่ลิงค์")
                            </span>
                        </div>
                    </td>

                    <td class="text-center">
                        @if (HasMenu("Employees.Edit"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@emp.EmpId"
                               class="btn btn-sm btn-outline-primary me-1"
                               title="แก้ไขพนักงาน">
                                ✏️ Edit
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary me-1" disabled title="ไม่มีสิทธิ์แก้ไข">
                                ✏️ Edit
                            </button>
                        }

                        @if (HasMenu("Employees.Delete"))
                        {
                            <a asp-action="Delete"
                               asp-route-id="@emp.EmpId"
                               class="btn btn-sm btn-outline-danger"
                               title="ลบพนักงาน"
                               onclick="return confirm('ยืนยันลบพนักงานคนนี้?');">
                                🗑 Delete
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                🗑 Delete
                            </button>
                        }
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
<!-- END TABLE -->
</div>

<!-- Mobile Card View -->
<div class="employee-mobile-cards">
    @if (Model.Any())
    {
        var mobileRow = 0;

        foreach (var emp in Model.OrderBy(e => e.Position).ThenBy(e => e.EmpId))
        {
            mobileRow++;

            <div class="employee-card" id="employee-card-@emp.EmpId">

                <div class="employee-card-header">
                    <img class="employee-avatar"
                         src="@EmployeeAvatar(emp)"
                         alt="@emp.EmpName"
                         loading="lazy"
                         onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />

                    <div>
                        <div class="employee-name">
                            @mobileRow. @emp.EmpName
                        </div>

                        <div class="employee-email-text">
                            @(emp.LoginUser?.Email ?? "-")
                        </div>

                        <div class="employee-position">
                            @emp.Position
                        </div>

                        <div class="employee-line-inline">
                            <span class="employee-line-label">LINE</span>
                            <span class="employee-line-text @(HasLineLink(emp) ? "is-linked" : "is-missing")">
                                @(HasLineLink(emp) ? "LINK แล้ว" : "ยังไม่ลิงค์")
                            </span>
                        </div>

                        <div class="employee-line-inline">
                            <span class="employee-line-label">Telegram</span>
                            <span class="employee-line-text @(HasTelegramLink(emp) ? "is-linked" : "is-missing")">
                                @(HasTelegramLink(emp) ? "LINK แล้ว" : "ยังไม่ลิงค์")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="employee-info">
                    <div class="employee-info-row">
                        <span class="employee-label">ฝ่าย</span>
                        <span>@(emp.Department?.DepartmentName ?? "-")</span>
                    </div>
                    <div class="employee-info-row">
                        <span class="employee-label">Status</span>
                        <span class="badge @(emp.Status == "ACTIVE" ? "bg-success" : "bg-secondary")">
                            @emp.Status
                        </span>
                    </div>
                </div>

                <div class="employee-actions">
                    @if (HasMenu("Employees.Edit"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@emp.EmpId"
                           class="btn btn-outline-primary btn-sm">
                            ✏️ Edit
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            ✏️ Edit
                        </button>
                    }

                    @if (HasMenu("Employees.Delete"))
                    {
                        <a asp-action="Delete"
                           asp-route-id="@emp.EmpId"
                           class="btn btn-outline-danger btn-sm"
                           onclick="return confirm('ยืนยันลบพนักงานคนนี้?');">
                            🗑 Delete
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🗑 Delete
                        </button>
                    }
                </div>
            </div>
        }
    }
</div>

<style>
/* Department filter */
.employee-department-filter {
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:16px;
    margin:0 0 16px;
    padding:14px 16px;
    border:1px solid var(--pt-border-soft, #dbeafe);
    border-radius:16px;
    color:var(--pt-body-contrast, #10233f);
    background:var(--pt-surface, #fff);
    box-shadow:0 8px 22px rgba(15,23,42,.05);
}

.employee-department-filter__field {
    width:min(420px, 100%);
}

.employee-department-filter__field label {
    display:block;
    margin:0 0 6px;
    font-size:.88rem;
    font-weight:600;
}

.employee-department-filter__count {
    flex:0 0 auto;
    padding-bottom:11px;
    color:var(--pt-body-muted, #64748b);
    font-size:.88rem;
    font-weight:500;
}

/* Employee Cards Global Styles */
.employee-mobile-cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.employee-card {
    display: grid;
    grid-template-columns: minmax(320px, 1fr) minmax(220px, .45fr) minmax(210px, auto);
    align-items: center;
    gap: 20px;
    background: #fff;
    border-radius: 16px;
    padding: 16px;
    border: 2px solid #dbeafe;
    box-shadow: 0 8px 22px rgba(15,23,42,.06);
    transition: .2s ease;
}

.employee-card:hover {
    transform: translateY(-2px);
    border-color: #93c5fd;
    box-shadow: 0 14px 30px rgba(15,23,42,.10);
}

.employee-card:target {
    border-color: #14b8a6;
    box-shadow: 0 0 0 4px rgba(20,184,166,.18), 0 16px 34px rgba(15,23,42,.14);
}

.employee-card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
}

.employee-card-header > div {
    min-width: 0;
}

.employee-avatar {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    background: #fff;
    border: 3px solid #14b8a6;
    box-shadow: 0 8px 18px rgba(15, 35, 64, .16);
    flex-shrink: 0;
}

.employee-table-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    background: #fff;
    border: 2px solid #14b8a6;
    box-shadow: 0 5px 12px rgba(15, 35, 64, .12);
}

.employee-name {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
}

.employee-position {
    font-size: .92rem;
    color: #6b7280;
}

.employee-email-text {
    color: #6b7280;
    font-size: .92rem;
    font-weight: 400;
    line-height: 1.35;
    overflow-wrap: anywhere;
    word-break: break-word;
}

.employee-info {
    display: grid;
    grid-template-columns: minmax(180px, 1fr);
    gap: 10px;
    min-width: 0;
    margin-top: 0;
}

.employee-info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-width: 0;
    overflow: hidden;
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 10px 14px;
    font-size: .92rem;
}

.employee-info-row > span:last-child {
    min-width: 0;
    text-align: right;
}

.employee-email,
.employee-table-email {
    overflow-wrap: anywhere;
    word-break: break-word;
    line-height: 1.35;
}

.employee-label {
    color: #64748b;
    min-width: 70px;
    font-weight: 600;
    flex: 0 0 auto;
}

.employee-line-inline {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    min-width: 0;
}

.employee-link-status-list {
    display: inline-grid;
    gap: 6px;
    justify-items: center;
}

.employee-line-label {
    color: #64748b;
    font-size: .82rem;
    font-weight: 800;
    line-height: 1;
}

.employee-line-text {
    font-size: .88rem;
    font-weight: 900;
    line-height: 1.2;
}

.employee-line-text.is-linked {
    color: #047857;
}

.employee-line-text.is-missing {
    color: #b45309;
}

.employee-line-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-width: 88px;
    max-width: 100%;
    min-height: 26px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: .82rem;
    font-weight: 900;
    line-height: 1.1;
    white-space: nowrap;
}

.employee-line-badge.is-linked {
    color: #047857;
    background: #d1fae5;
    border: 1px solid #6ee7b7;
}

.employee-line-badge.is-missing {
    color: #b45309;
    background: #fef3c7;
    border: 1px solid #fcd34d;
}

.employee-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    min-width: 210px;
    margin-top: 0;
    position: relative;
    z-index: 1;
}

.employee-actions .btn {
    flex: 1;
    border-radius: 12px;
}

@@media (max-width: 575.98px) {
    .employee-department-filter {
        align-items:stretch;
        flex-direction:column;
        gap:8px;
    }

    .employee-department-filter__count {
        padding-bottom:0;
        text-align:right;
    }
}

@@media (max-width: 768px) {
    .table-responsive {
        display: none !important;
    }
    .employee-mobile-cards {
        display: grid;
        grid-template-columns: 1fr;
    }

    .employee-card,
    .employee-info {
        display: grid;
        grid-template-columns: 1fr;
    }

    .employee-actions {
        justify-content: stretch;
        min-width: 0;
        margin-top: 4px;
    }
}
</style>

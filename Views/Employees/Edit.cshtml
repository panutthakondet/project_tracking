@model ProjectTracking.Models.Employee

@{
    ViewData["Title"] = "แก้ไขข้อมูลพนักงาน";
}

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">@ViewData["Title"]</h2>
        <p class="index-subtitle mb-0">แก้ไขข้อมูลพนักงานในระบบ</p>
    </div>
</div>

<div class="card pt-form-card">
    <div class="card-body">

        <form asp-action="Edit" asp-route-id="@Model.EmpId" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="EmpId" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="EmpName" class="form-label">ชื่อพนักงาน</label>
                    <input asp-for="EmpName"
                           class="form-control"
                           placeholder="ระบุชื่อพนักงาน" />
                    <span asp-validation-for="EmpName"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Position" class="form-label">ตำแหน่ง</label>
                    <input asp-for="Position"
                           class="form-control"
                           placeholder="เช่น Developer, QA, PM" />
                    <span asp-validation-for="Position"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Status" class="form-label">สถานะ</label>
                    <select asp-for="Status"
                            class="form-select">
                        <option value="ACTIVE">ACTIVE</option>
                        <option value="INACTIVE">INACTIVE</option>
                    </select>
                    <span asp-validation-for="Status"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="mt-4 d-flex justify-content-end gap-2 flex-wrap">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    กลับ
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    บันทึกการแก้ไข
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

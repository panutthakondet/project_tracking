@using System.Globalization
@model ProjectTracking.ViewModels.EmployeeWorkSummaryViewModel
@{
    ViewData["Title"] = $"สรุปงานของ {Model.EmployeeName}";
    var culture = new CultureInfo("th-TH");
    var metrics = new[] {
        (Key: "done", Label: "งานเสร็จแล้ว", Count: Model.DoneCount, Icon: "✅"),
        (Key: "pending", Label: "งานยังไม่เสร็จ", Count: Model.PendingCount, Icon: "📋"),
        (Key: "risk", Label: "งานเสี่ยงเกินกำหนด", Count: Model.RiskCount, Icon: "⏳"),
        (Key: "overdue", Label: "งานเกินกำหนด", Count: Model.OverdueCount, Icon: "⚠️")
    };
    var filterLabel = metrics.FirstOrDefault(x => x.Key == Model.Filter).Label ?? "งานทั้งหมด";
    var rows = Model.VisibleItems.ToList();
}
<style>
    .employee-work-summary {
        --pt-local-text: var(--pt-surface-contrast, #10233f);
        --pt-local-muted: var(--pt-surface-contrast-muted, #64748b);
        color: var(--pt-local-text);
    }
    .employee-work-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 20px; }
    .employee-work-metric {
        display: flex; flex-direction: column; gap: 8px; padding: 20px;
        border: 1px solid var(--pt-border, #d8e3ef); border-radius: 18px;
        background: var(--pt-surface, #fff); color: var(--pt-surface-contrast, #10233f) !important;
        text-decoration: none; box-shadow: 0 8px 20px var(--pt-shadow, rgba(0,0,0,.05));
    }
    .employee-work-metric:hover, .employee-work-metric.is-active { border-color: var(--pt-accent, #0ea5a6); background: var(--pt-surface-soft, #f4f7fb); }
    .employee-work-metric.is-active { outline: 2px solid var(--pt-accent, #0ea5a6); outline-offset: 2px; }
    .employee-work-metric strong { font-size: 2rem; }
    .employee-work-summary .summary-help { color: var(--pt-surface-contrast-muted, #64748b); }
    .employee-work-summary .summary-heading { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .employee-work-summary .summary-table { --bs-table-color: var(--pt-surface-contrast, #10233f); --bs-table-bg: var(--pt-surface, #fff); }
    .employee-work-summary .summary-table thead th { background: var(--pt-surface-soft, #f4f7fb) !important; color: var(--pt-surface-contrast, #10233f) !important; }
    .employee-work-summary .summary-table td { color: var(--pt-surface-contrast, #10233f) !important; }
    .employee-work-summary .summary-task-title { min-width: 220px; white-space: pre-wrap; overflow-wrap: anywhere; font-weight: 600; }
    .employee-work-summary .summary-due { white-space: nowrap; }
    .employee-work-summary .summary-category { display: inline-block; padding: 5px 10px; border: 1px solid var(--pt-border, #d8e3ef); border-radius: 20px; background: var(--pt-surface-soft, #f4f7fb); white-space: nowrap; }
    @@media (max-width: 900px) { .employee-work-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 480px) { .employee-work-metrics { gap: 10px; } .employee-work-metric { padding: 14px; } }
</style>
<div class="container-fluid employee-work-summary py-3">
    <div class="index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">สรุปงานรายพนักงาน</span>
            <h1 class="index-title">@Model.EmployeeName</h1>
            <p class="index-subtitle">@Model.DepartmentName · ข้อมูล ณ @Model.Today.ToString("dd MMM yyyy", culture)</p>
        </div>
        <div class="index-actions"><a asp-action="Index" class="btn btn-outline-light">กลับไปพนักงาน</a></div>
    </div>

    <div class="employee-work-metrics">
        @foreach (var metric in metrics)
        {
            <a asp-action="WorkSummary" asp-route-id="@Model.EmpId" asp-route-filter="@metric.Key"
               class="employee-work-metric @(Model.Filter == metric.Key ? "is-active" : "")" aria-current="@(Model.Filter == metric.Key ? "page" : null)">
                <span>@metric.Icon @metric.Label</span>
                <strong>@metric.Count.ToString("N0")</strong>
                <span>กดดูรายการ</span>
            </a>
        }
    </div>
    <p class="summary-help">รวมงานมอบหมาย (Phase Assign), Issue และ Support ที่พนักงานเป็นผู้รับผิดชอบ · งานเสี่ยงและเกินกำหนดนับรวมในงานยังไม่เสร็จ</p>
    <p class="summary-help">เสี่ยงเกินกำหนด = งานที่ยังไม่เสร็จและครบกำหนดตั้งแต่วันนี้ถึงอีก @Model.RiskDays วัน ตามค่าตั้งระบบ · เกินกำหนด = วันกำหนดส่งก่อนวันนี้ · งานไม่ระบุวันส่งอยู่ในงานยังไม่เสร็จ</p>
    <p class="summary-help">งานเสร็จแล้วรวมงานที่ปิดตามสถานะระบบ (เช่น PASS, REJECT, DONE, CLOSED) · งานที่ส่งแก้แล้วแต่ยังไม่ปิดยังนับเป็นงานไม่เสร็จ</p>

    <div class="card">
        <div class="card-header summary-heading">
            <strong>@filterLabel (@rows.Count.ToString("N0") รายการ)</strong>
            <a asp-action="WorkSummary" asp-route-id="@Model.EmpId" class="btn btn-sm btn-outline-primary">ดูทั้งหมด (@Model.Items.Count.ToString("N0"))</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table summary-table mb-0 align-middle">
                    <thead><tr><th>ประเภท</th><th>โครงการ / งาน</th><th>สถานะเดิม</th><th>กำหนดส่ง</th><th>สรุปสถานะ</th><th>จัดการ</th></tr></thead>
                    <tbody>
                    @if (rows.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center py-4">ไม่พบงานในกลุ่มนี้</td></tr>
                    }
                    @foreach (var row in rows)
                    {
                        var category = row.Category(Model.Today, Model.RiskDays);
                        var label = category switch { "done" => "✅ เสร็จแล้ว / ปิดงาน", "overdue" => "⚠️ เกินกำหนด", "risk" => "⏳ เสี่ยงเกินกำหนด", _ => "📋 ยังไม่เสร็จ" };
                        <tr>
                            <td>@row.Type</td>
                            <td><div class="summary-task-title">@row.Title</div><small class="text-muted">@row.ProjectName</small></td>
                            <td>@row.Status</td>
                            <td class="summary-due">
                                @(row.DueDate?.ToString("dd MMM yyyy", culture) ?? "ไม่ระบุ")
                                @if (category == "overdue") { <div>เกิน @((Model.Today - row.DueDate!.Value.Date).Days) วัน</div> }
                                @if (category == "risk") { <div>@(row.DueDate!.Value.Date == Model.Today ? "ครบกำหนดวันนี้" : $"เหลือ {(row.DueDate.Value.Date - Model.Today).Days} วัน")</div> }
                            </td>
                            <td><span class="summary-category">@label</span></td>
                            <td><a href="@row.Url" class="btn btn-sm btn-outline-primary">ดูงาน</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

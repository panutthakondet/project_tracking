            async function enforceCurrentDndMode(options = {}) {
                if (!isCurrentDnd()) return false;

                window.clearTimeout(proximityVoiceTimer);
                closeWaveNotification();
                closeAllRtcPeers();
                stopSpeakingDetector(currentUserId);
                desiredMicOn = false;
                desiredCameraOn = false;
                desiredScreenOn = false;

                if (useLiveKitMedia()) {
                    await disconnectLiveKitRoom();
                } else {
                    if (micStream) {
                        removeStreamTracksFromRtcPeers(micStream);
                        stopMediaStream(micStream);
                        micStream = null;
                    }

                    if (cameraStream) {
                        removeStreamTracksFromRtcPeers(cameraStream);
                        stopMediaStream(cameraStream);
                        cameraStream = null;
                    }

                    if (screenStream) {
                        removeStreamTracksFromRtcPeers(screenStream);
                        stopMediaStream(screenStream);
                        screenStream = null;
                    }

                    setDockMediaState('toggleMic', false, 'Microphone on', 'Microphone muted');
                    setDockMediaState('toggleCamera', false, 'Camera on', 'Camera off');
                    setDockMediaState('shareScreen', false, 'Screen sharing', 'Screen share off');
                }

                meetingMediaStates.set(currentUserId, {
                    userId: currentUserId,
                    areaKey: normalizeAreaKey(currentConversationArea().key),
                    micOn: false,
                    cameraOn: false,
                    screenOn: false,
                    isSpeaking: false,
                    updatedAt: new Date().toISOString()
                });

                if (isMeetingPanelOpen()) {
                    activeMeetingArea = null;
                    closeMeetingScreenViewer();
                    meetingPanel.hidden = true;
                }

                await broadcastMeetingMediaState({ micOn: false, cameraOn: false, screenOn: false, isSpeaking: false });
                scheduleMeetingVideosRender();
                scheduleMeetingParticipantsRender();
                syncMeetingConnectionStatus();

                if (options.toast !== false) {
                    showToast('เปิด Do Not Disturb แล้ว ระบบจะไม่รับเสียง Wave Message หรือคำชวนประชุม');
                }
                return true;
            }

            function showToast(message, options = {}) {
                window.clearTimeout(toastTimer);
                toast.replaceChildren();
                toast.classList.toggle('has-action', Boolean(options.actionLabel && options.onAction));

                const text = document.createElement('span');
                text.className = 'mr-toast-message';
                text.textContent = message;
                toast.appendChild(text);

                if (options.actionLabel && options.onAction) {
                    const action = document.createElement('button');
                    action.type = 'button';
                    action.className = 'mr-toast-action';
                    action.textContent = options.actionLabel;
                    action.addEventListener('click', event => {
                        event.stopPropagation();
                        toast.classList.remove('is-show');
                        toast.classList.remove('has-action');
                        options.onAction();
                    });
                    toast.appendChild(action);
                }

                toast.classList.add('is-show');
                toastTimer = window.setTimeout(() => {
                    toast.classList.remove('is-show');
                    toast.classList.remove('has-action');
                }, options.duration || (options.actionLabel ? 7000 : 2600));
            }

            function playWaveSound() {
                try {
                    const AudioContextCtor = window.AudioContext || window.webkitAudioContext;
                    if (!AudioContextCtor) return;

                    waveAudioContext ||= new AudioContextCtor();
                    if (waveAudioContext.state === 'suspended') {
                        void waveAudioContext.resume();
                    }

                    const now = waveAudioContext.currentTime;
                    [740, 980].forEach((frequency, index) => {
                        const oscillator = waveAudioContext.createOscillator();
                        const gain = waveAudioContext.createGain();
                        oscillator.type = 'sine';
                        oscillator.frequency.setValueAtTime(frequency, now + (index * .08));
                        gain.gain.setValueAtTime(0, now + (index * .08));
                        gain.gain.linearRampToValueAtTime(.12, now + (index * .08) + .015);
                        gain.gain.exponentialRampToValueAtTime(.001, now + (index * .08) + .18);
                        oscillator.connect(gain);
                        gain.connect(waveAudioContext.destination);
                        oscillator.start(now + (index * .08));
                        oscillator.stop(now + (index * .08) + .2);
                    });
                } catch {
                    // Browsers can block audio until the user has interacted with the page.
                }
            }


            function clampCustomizePanel(left, top) {
                const panel = document.getElementById('customizePanel');
                if (!panel) return { left, top };

                const roomRect = root.getBoundingClientRect();
                const panelRect = panel.getBoundingClientRect();
                const padding = 10;
                const maxLeft = Math.max(padding, roomRect.width - panelRect.width - padding);
                const maxTop = Math.max(padding, roomRect.height - panelRect.height - padding);

                return {
                    left: clampPercent(left, padding, maxLeft),
                    top: clampPercent(top, padding, maxTop)
                };
            }

            function setCustomizePanelPosition(left, top) {
                const panel = document.getElementById('customizePanel');
                if (!panel) return;

                const next = clampCustomizePanel(left, top);
                panel.style.left = `${next.left}px`;
                panel.style.top = `${next.top}px`;
                panel.style.right = 'auto';
            }

            function ensureCustomizePanelInView() {
                const panel = document.getElementById('customizePanel');
                if (!panel || panel.hidden) return;

                const roomRect = root.getBoundingClientRect();
                const panelRect = panel.getBoundingClientRect();
                const left = panelRect.left - roomRect.left;
                const top = panelRect.top - roomRect.top;
                setCustomizePanelPosition(left, top);
            }

            function openCustomizePanel() {
                if (!canCustomize) return;

                closePopovers();
                isCustomizeOpen = true;
                root.classList.add('is-customizing');
                setCustomizeMode(customizeMode);
                const panel = document.getElementById('customizePanel');
                panel.hidden = false;
                if (!panel.style.left) {
                    const roomRect = root.getBoundingClientRect();
                    const panelRect = panel.getBoundingClientRect();
                    setCustomizePanelPosition(roomRect.width - panelRect.width - 14, 74);
                } else {
                    ensureCustomizePanelInView();
                }
                renderCustomAreas();
                renderCustomObjects();
                showToast('ลากบนพื้นที่ว่างเพื่อสร้างแอเรียใหม่');
            }

            function closeCustomizePanel() {
                isCustomizeOpen = false;
                root.classList.remove('is-customizing');
                document.getElementById('customizePanel').hidden = true;
                document.getElementById('areaDraft')?.setAttribute('hidden', '');
                document.getElementById('objectDraft')?.setAttribute('hidden', '');
                world.querySelectorAll('.mr-area-shape.is-selected').forEach(shape => shape.classList.remove('is-selected'));
                world.querySelectorAll('.mr-room-object.is-selected').forEach(shape => shape.classList.remove('is-selected'));
            }

            function closePopovers() {
                personPopover.hidden = true;
                selfPopover.hidden = true;
                document.getElementById('messageForm').hidden = true;
                document.querySelectorAll('.mr-person-row.is-selected').forEach(row => row.classList.remove('is-selected'));
            }

            function hasOpenPopover() {
                return !personPopover.hidden || !selfPopover.hidden;
            }

            function positionPopover(popover, source) {
                const roomRect = root.getBoundingClientRect();
                const sourceRect = source.getBoundingClientRect();
                const width = Math.min(popover.offsetWidth || 360, window.innerWidth - 24);
                let left = sourceRect.left - roomRect.left + sourceRect.width + 12;
                let top = sourceRect.top - roomRect.top - 24;

                if (left + width > window.innerWidth - 12) {
                    left = sourceRect.left - roomRect.left - width - 12;
                }

                if (left < 12) {
                    left = 12;
                }

                top = Math.max(66, Math.min(top, window.innerHeight - Math.min(popover.offsetHeight || 430, window.innerHeight - 24) - 12));
                popover.style.left = `${left}px`;
                popover.style.top = `${top}px`;
            }

            function focusPerson(userId) {
                const marker = map.querySelector(`.mr-person[data-user-id="${userId}"]`);
                if (!marker) return;

                marker.scrollIntoView({ block: 'center', inline: 'center', behavior: 'smooth' });
                marker.classList.remove('is-pulse');
                void marker.offsetWidth;
                marker.classList.add('is-pulse');
                window.setTimeout(() => marker.classList.remove('is-pulse'), 3200);
            }

            function syncFollowButton() {
                const button = document.getElementById('followPerson');
                if (!button || !selectedUserId) return;

                const isFollowing = followedUserId === selectedUserId;
                button.classList.toggle('is-active', isFollowing);
                button.querySelector('.mr-menu-text strong')?.replaceChildren(document.createTextNode(isFollowing ? 'Following' : 'Follow'));
                button.querySelector('.mr-menu-text span')?.replaceChildren(document.createTextNode(isFollowing ? 'กำลังติดตามตำแหน่งคนนี้' : 'ติดตามตำแหน่งคนนี้ในหน้าแผนที่'));
            }

            function stopFollowing() {
                followedUserId = null;
                window.clearInterval(followTimer);
                followTimer = null;
                syncFollowButton();
            }

            function toggleFollowPerson(userId) {
                if (!userId) return;

                if (followedUserId === Number(userId)) {
                    stopFollowing();
                    showToast('หยุดติดตามแล้ว');
                    return;
                }

                followedUserId = Number(userId);
                window.clearInterval(followTimer);
                focusPerson(followedUserId);
                followTimer = window.setInterval(() => {
                    if (!followedUserId || !getPersonMarker(followedUserId)) {
                        stopFollowing();
                        return;
                    }

                    focusPerson(followedUserId);
                }, 5000);
                syncFollowButton();
                const person = peopleById.get(followedUserId);
                showToast(person ? `กำลังติดตาม ${person.displayName}` : 'Follow enabled.');
            }

            function getPersonMarker(userId) {
                return map.querySelector(`.mr-person[data-user-id="${userId}"]`);
            }

            function markerPercent(marker, key, fallback) {
                const value = Number(marker?.dataset?.[key] || fallback);
                return Number.isFinite(value) ? value : fallback;
            }

            function clampPercent(value, min, max) {
                const next = Number(value);
                if (!Number.isFinite(next)) return min;
                return Math.max(min, Math.min(max, next));
            }

            function normalizeAreaKey(value) {
                return String(value || '')
                    .trim()
                    .toLowerCase()
                    .replace(/[^a-z0-9ก-๙]+/g, '-')
                    .replace(/^-+|-+$/g, '') || 'open-area';
            }

            function fallbackAreaForPoint(point) {
                const row = point.y < 37 ? 'north' : point.y < 65 ? 'middle' : 'south';
                const column = point.x < 33 ? 'left' : point.x < 66 ? 'center' : 'right';
                const titles = {
                    'north-left': 'North Lobby Walkway',
                    'north-center': 'North Work Walkway',
                    'north-right': 'North Garden Walkway',
                    'middle-left': 'West Work Walkway',
                    'middle-center': 'Center Work Walkway',
                    'middle-right': 'East Work Walkway',
                    'south-left': 'South Lobby Walkway',
                    'south-center': 'South Board Walkway',
                    'south-right': 'South Meeting Walkway'
                };
                const key = `${row}-${column}`;

                return {
                    key,
                    title: titles[key] || 'Open Area',
                    x: column === 'left' ? walkBounds.minX : column === 'center' ? 33 : 66,
                    y: row === 'north' ? walkBounds.minY : row === 'middle' ? 37 : 65,
                    w: column === 'left' ? 29 : 33,
                    h: row === 'north' ? 30 : row === 'middle' ? 28 : walkBounds.maxY - 65
                };
            }

            function areaForPoint(x, y) {
                const point = {
                    x: clampPercent(x, walkBounds.minX, walkBounds.maxX),
                    y: clampPercent(y, walkBounds.minY, walkBounds.maxY)
                };

                const matched = voiceAreas.find(area =>
                    point.x >= area.x &&
                    point.x <= area.x + area.w &&
                    point.y >= area.y &&
                    point.y <= area.y + area.h
                );

                if (!matched) {
                    return fallbackAreaForPoint(point);
                }

                return {
                    ...matched,
                    key: normalizeAreaKey(matched.key || matched.title)
                };
            }

            function markerArea(marker) {
                if (!marker) {
                    return fallbackAreaForPoint({ x: 50, y: 50 });
                }

                return areaForPoint(markerPercent(marker, 'x', 50), markerPercent(marker, 'y', 50));
            }

            function syncRowArea(userId, areaTitle) {
                document.querySelectorAll(`.mr-person-row[data-user-id="${userId}"]`).forEach(row => {
                    const person = peopleById.get(Number(userId));
                    const text = row.querySelector('.mr-row-main span');
                    if (text && person) {
                        text.textContent = `${person.statusLabel} · ${areaTitle}`;
                    }
                });
            }

            function syncMarkerArea(marker) {
                if (!marker) return fallbackAreaForPoint({ x: 50, y: 50 });

                const area = markerArea(marker);
                const userId = Number(marker.dataset.userId || 0);
                marker.dataset.zone = area.title;
                marker.dataset.voiceArea = area.key;

                const person = peopleById.get(userId);
                if (person) {
                    person.zone = area.title;
                    person.voiceArea = area.key;
                }

                syncRowArea(userId, area.title);
                return area;
            }

            function currentConversationArea() {
                return syncMarkerArea(getPersonMarker(currentUserId));
            }

            function targetConversationArea(userId) {
                return syncMarkerArea(getPersonMarker(userId));
            }

            function sameConversationArea(targetUserId) {
                const currentArea = currentConversationArea();
                const targetArea = targetConversationArea(targetUserId);
                return currentArea.key === targetArea.key;
            }

            function requireSameConversationArea(targetUserId, actionLabel) {
                if (!targetUserId) return false;

                const person = peopleById.get(Number(targetUserId));
                const currentArea = currentConversationArea();
                const targetArea = targetConversationArea(targetUserId);
                if (currentArea.key === targetArea.key) {
                    return true;
                }

                showToast(`ต้องอยู่เอเรียเดียวกันก่อนถึงจะ${actionLabel}ได้ (${currentArea.title} → ${targetArea.title})`);
                if (person) {
                    focusPerson(targetUserId);
                }
                return false;
            }

            function constrainPointToArea(point, area) {
                if (!area) return clampPoint(point);

                const padding = 2.2;
                return clampPoint({
                    x: clampPercent(point.x, area.x + padding, area.x + area.w - padding),
                    y: clampPercent(point.y, area.y + padding, area.y + area.h - padding)
                });
            }

            function applyRoomZoom(nextZoom, options = {}) {
                roomZoom = Number(clampPercent(nextZoom, zoomConfig.min, zoomConfig.max).toFixed(2));
                world.style.setProperty('--mr-zoom', roomZoom);
                map.classList.toggle('is-pannable', roomZoom > 1.01);

                if (options.resetPan || roomZoom <= 1) {
                    setRoomPan(0, 0);
                } else {
                    setRoomPan(roomPanX, roomPanY);
                }

                document.getElementById('zoomInRoom')?.toggleAttribute('disabled', roomZoom >= zoomConfig.max);
                document.getElementById('zoomOutRoom')?.toggleAttribute('disabled', roomZoom <= zoomConfig.min);

                if (options.announce) {
                    showToast(`Zoom ${Math.round(roomZoom * 100)}%`);
                }
            }

            function changeRoomZoom(delta, options = {}) {
                applyRoomZoom(roomZoom + delta, options);
            }

            function maxRoomPan() {
                const rect = map.getBoundingClientRect();
                return {
                    x: Math.max(0, (rect.width * (roomZoom - 1)) / 2),
                    y: Math.max(0, (rect.height * (roomZoom - 1)) / 2)
                };
            }

            function setRoomPan(x, y) {
                const max = maxRoomPan();
                roomPanX = clampPercent(x, -max.x, max.x);
                roomPanY = clampPercent(y, -max.y, max.y);
                world.style.setProperty('--mr-pan-x', `${roomPanX}px`);
                world.style.setProperty('--mr-pan-y', `${roomPanY}px`);
            }

            function mapEventToWorldPoint(event) {
                const rect = map.getBoundingClientRect();
                const localX = event.clientX - rect.left - roomPanX;
                const localY = event.clientY - rect.top - roomPanY;
                const worldX = ((localX - (rect.width / 2)) / roomZoom) + (rect.width / 2);
                const worldY = ((localY - (rect.height / 2)) / roomZoom) + (rect.height / 2);

                return {
                    x: (worldX / rect.width) * 100,
                    y: (worldY / rect.height) * 100
                };
            }

            function normalizedDraftArea(from, to) {
                const start = clampAreaPoint(from);
                const end = clampAreaPoint(to);
                const x = Math.min(start.x, end.x);
                const y = Math.min(start.y, end.y);
                const w = Math.max(2, Math.abs(end.x - start.x));
                const h = Math.max(2, Math.abs(end.y - start.y));

                return {
                    x: Math.round(x),
                    y: Math.round(y),
                    w: Math.round(w),
                    h: Math.round(h),
                    tone: normalizeAreaTone(document.getElementById('areaToneInput')?.value || 'teal')
                };
            }

            function startAreaDraw(event) {
                if (!canCustomize || !isCustomizeOpen) return false;
                if (customizeMode !== 'area') return false;
                if (event.target.closest('.mr-person, .mr-map-tools, .mr-popover, .mr-customize-panel, .mr-area-shape, .mr-room-object')) return false;

                const point = mapEventToWorldPoint(event);
                areaDrawState = {
                    pointerId: event.pointerId,
                    start: point,
                    current: point,
                    moved: false
                };

                selectedAreaId = null;
                map.setPointerCapture?.(event.pointerId);
                syncDraftFromArea(normalizedDraftArea(point, point));
                event.preventDefault();
                return true;
            }

            function syncDraftFromArea(area) {
                const draft = document.getElementById('areaDraft');
                if (!draft) return;

                draft.hidden = false;
                draft.className = `mr-area-draft tone-${normalizeAreaTone(area.tone)}`;
                setAreaBounds(draft, area);
            }

            function updateAreaDraw(event) {
                if (!areaDrawState || event.pointerId !== areaDrawState.pointerId) return false;

                const point = mapEventToWorldPoint(event);
                areaDrawState.current = point;
                if (pointDistance(areaDrawState.start, point) > 1) {
                    areaDrawState.moved = true;
                }

                syncDraftFromArea(normalizedDraftArea(areaDrawState.start, point));
                event.preventDefault();
                return true;
            }

            function endAreaDraw(event) {
                if (!areaDrawState || (event && event.pointerId !== areaDrawState.pointerId)) return false;

                const area = normalizedDraftArea(areaDrawState.start, areaDrawState.current);
                const moved = areaDrawState.moved && area.w >= 5 && area.h >= 5;

                if (event && map.hasPointerCapture?.(event.pointerId)) {
                    map.releasePointerCapture(event.pointerId);
                }

                areaDrawState = null;
                if (!moved) {
                    document.getElementById('areaDraft')?.setAttribute('hidden', '');
                    return true;
                }

                setAreaForm({
                    areaType: document.getElementById('areaTypeInput')?.value || 'MEETING',
                    tone: area.tone,
                    x: area.x,
                    y: area.y,
                    w: area.w,
                    h: area.h
                });
                syncDraftFromForm();
                document.getElementById('areaTitleInput')?.focus();
                showToast('ตั้งชื่อพื้นที่แล้วกด Save area');
                return true;
            }

            function clampPoint(point) {
                return {
                    x: clampPercent(point.x, walkBounds.minX, walkBounds.maxX),
                    y: clampPercent(point.y, walkBounds.minY, walkBounds.maxY)
                };
            }

            function clampAreaPoint(point) {
                return {
                    x: clampPercent(point.x, areaBounds.minX, areaBounds.maxX),
                    y: clampPercent(point.y, areaBounds.minY, areaBounds.maxY)
                };
            }

            function roundPercent(value) {
                return Number(value.toFixed(2));
            }

            function pointDistance(a, b) {
                return Math.hypot(a.x - b.x, a.y - b.y);
            }

            function setMarkerPosition(marker, x, y) {
                marker.dataset.x = String(x);
                marker.dataset.y = String(y);
                marker.style.setProperty('--x', x);
                marker.style.setProperty('--y', y);
                syncMarkerArea(marker);
            }

            function wait(ms) {
                return new Promise(resolve => window.setTimeout(resolve, ms));
            }

            function setMarkerDirection(marker, from, to) {
                const deltaX = to.x - from.x;
                if (Math.abs(deltaX) > .2) {
                    marker.style.setProperty('--avatar-dir', deltaX < 0 ? '-1' : '1');
                }
            }

            function buildWalkObstacles(ignoreUserId = null) {
                const obstacles = [...staticObstacles];
                const ignored = Number(ignoreUserId || 0);

                customObjects
                    .filter(item => item.isObstacle !== false && String(item.objectType || '').toUpperCase() !== 'RUG')
                    .forEach(item => {
                        const object = clampObject(item);
                        obstacles.push({
                            x1: object.x - .5,
                            x2: object.x + object.w + .5,
                            y1: object.y - .5,
                            y2: object.y + object.h + .5
                        });
                    });

                document.querySelectorAll('.mr-person').forEach(marker => {
                    const userId = Number(marker.dataset.userId || 0);
                    if (!userId || userId === currentUserId || userId === ignored || marker.hidden) return;

                    const x = markerPercent(marker, 'x', 50);
                    const y = markerPercent(marker, 'y', 50);
                    obstacles.push({
                        x1: x - pathConfig.dynamicRadiusX,
                        x2: x + pathConfig.dynamicRadiusX,
                        y1: y - pathConfig.dynamicRadiusY,
                        y2: y + pathConfig.dynamicRadiusY
                    });
                });

                return obstacles;
            }

            function isPointBlocked(point, obstacles, padding = pathConfig.pointPadding) {
                if (point.x < walkBounds.minX || point.x > walkBounds.maxX || point.y < walkBounds.minY || point.y > walkBounds.maxY) {
                    return true;
                }

                return obstacles.some(obstacle =>
                    point.x >= obstacle.x1 - padding &&
                    point.x <= obstacle.x2 + padding &&
                    point.y >= obstacle.y1 - padding &&
                    point.y <= obstacle.y2 + padding
                );
            }

            function nearestWalkablePoint(point, obstacles) {
                const preferred = clampPoint(point);
                if (!isPointBlocked(preferred, obstacles)) {
                    return preferred;
                }

                for (let radius = 1; radius <= 18; radius += 1) {
                    const candidates = [];
                    for (let angle = 0; angle < 360; angle += 22.5) {
                        const radians = angle * Math.PI / 180;
                        candidates.push(clampPoint({
                            x: preferred.x + Math.cos(radians) * radius,
                            y: preferred.y + Math.sin(radians) * radius
                        }));
                    }

                    candidates.sort((a, b) => pointDistance(a, preferred) - pointDistance(b, preferred));
                    const openPoint = candidates.find(candidate => !isPointBlocked(candidate, obstacles));
                    if (openPoint) {
                        return openPoint;
                    }
                }

                return preferred;
            }

            function gridKey(xIndex, yIndex) {
                return `${xIndex}:${yIndex}`;
            }

            function maxGridIndex(axis) {
                const min = axis === 'x' ? walkBounds.minX : walkBounds.minY;
                const max = axis === 'x' ? walkBounds.maxX : walkBounds.maxY;
                return Math.ceil((max - min) / pathConfig.step);
            }

            function pointToGrid(point) {
                const safePoint = clampPoint(point);
                return {
                    x: Math.round((safePoint.x - walkBounds.minX) / pathConfig.step),
                    y: Math.round((safePoint.y - walkBounds.minY) / pathConfig.step)
                };
            }

            function gridToPoint(xIndex, yIndex) {
                return clampPoint({
                    x: walkBounds.minX + (xIndex * pathConfig.step),
                    y: walkBounds.minY + (yIndex * pathConfig.step)
                });
            }

            function isSegmentClear(from, to, obstacles) {
                const samples = Math.max(1, Math.ceil(pointDistance(from, to) / .85));
                for (let index = 0; index <= samples; index += 1) {
                    const t = index / samples;
                    const point = {
                        x: from.x + ((to.x - from.x) * t),
                        y: from.y + ((to.y - from.y) * t)
                    };
                    if (isPointBlocked(point, obstacles)) {
                        return false;
                    }
                }

                return true;
            }

            function simplifyPath(points, obstacles) {
                if (points.length <= 2) {
                    return points;
                }

                const simplified = [points[0]];
                let currentIndex = 0;

                while (currentIndex < points.length - 1) {
                    let nextIndex = points.length - 1;
                    while (nextIndex > currentIndex + 1 && !isSegmentClear(points[currentIndex], points[nextIndex], obstacles)) {
                        nextIndex -= 1;
                    }

                    simplified.push(points[nextIndex]);
                    currentIndex = nextIndex;
                }

                return simplified;
            }

            function findWalkPath(start, destination, obstacles) {
                const startPoint = nearestWalkablePoint(start, obstacles);
                const endPoint = nearestWalkablePoint(destination, obstacles);

                if (pointDistance(startPoint, endPoint) < .4) {
                    return [startPoint];
                }

                if (isSegmentClear(startPoint, endPoint, obstacles)) {
                    return [startPoint, endPoint];
                }

                const startGrid = pointToGrid(startPoint);
                const endGrid = pointToGrid(endPoint);
                const endKey = gridKey(endGrid.x, endGrid.y);
                const maxXIndex = maxGridIndex('x');
                const maxYIndex = maxGridIndex('y');
                const nodes = new Map();
                const open = [];
                const closed = new Set();

                function getNode(xIndex, yIndex) {
                    const key = gridKey(xIndex, yIndex);
                    let node = nodes.get(key);
                    if (!node) {
                        node = { x: xIndex, y: yIndex, key, g: Infinity, f: Infinity, parent: null };
                        nodes.set(key, node);
                    }

                    return node;
                }

                const startNode = getNode(startGrid.x, startGrid.y);
                startNode.g = 0;
                startNode.f = Math.hypot(endGrid.x - startGrid.x, endGrid.y - startGrid.y);
                open.push(startNode);

                for (let iteration = 0; open.length && iteration < 5200; iteration += 1) {
                    open.sort((a, b) => a.f - b.f);
                    const current = open.shift();
                    if (!current || closed.has(current.key)) continue;

                    if (current.key === endKey) {
                        const points = [];
                        let node = current;
                        while (node) {
                            points.push(gridToPoint(node.x, node.y));
                            node = node.parent;
                        }

                        points.reverse();
                        points[0] = startPoint;
                        points[points.length - 1] = endPoint;
                        return simplifyPath(points, obstacles);
                    }

                    closed.add(current.key);

                    for (let dx = -1; dx <= 1; dx += 1) {
                        for (let dy = -1; dy <= 1; dy += 1) {
                            if (dx === 0 && dy === 0) continue;

                            const nextX = current.x + dx;
                            const nextY = current.y + dy;
                            if (nextX < 0 || nextY < 0 || nextX > maxXIndex || nextY > maxYIndex) continue;

                            const nextPoint = gridToPoint(nextX, nextY);
                            if (isPointBlocked(nextPoint, obstacles)) continue;

                            if (dx !== 0 && dy !== 0) {
                                const sideA = gridToPoint(current.x + dx, current.y);
                                const sideB = gridToPoint(current.x, current.y + dy);
                                if (isPointBlocked(sideA, obstacles) || isPointBlocked(sideB, obstacles)) continue;
                            }

                            const neighbor = getNode(nextX, nextY);
                            if (closed.has(neighbor.key)) continue;

                            const moveCost = dx !== 0 && dy !== 0 ? Math.SQRT2 : 1;
                            const tentativeG = current.g + moveCost;
                            if (tentativeG >= neighbor.g) continue;

                            neighbor.parent = current;
                            neighbor.g = tentativeG;
                            neighbor.f = tentativeG + Math.hypot(endGrid.x - nextX, endGrid.y - nextY);
                            open.push(neighbor);
                        }
                    }
                }

                return null;
            }

            function walkDuration(distance) {
                return Math.round(clampPercent(distance * pathConfig.msPerPercent, pathConfig.minDuration, pathConfig.maxDuration));
            }

            async function animateMarkerTo(marker, x, y, options = {}) {
                const start = {
                    x: markerPercent(marker, 'x', 50),
                    y: markerPercent(marker, 'y', 50)
                };
                const obstacles = buildWalkObstacles(options.ignoreUserId);
                const path = findWalkPath(start, { x, y }, obstacles);

                if (!path) {
                    if (!options.silentBlocked) {
                        showToast('ทางเดินติดสิ่งกีดขวาง ลองเลือกจุดใกล้ทางเดิน');
                    }
                    return false;
                }

                if (path.length <= 1) {
                    return true;
                }

                const token = ++activeWalkToken;
                marker.classList.add('is-walking');
                marker.style.transitionTimingFunction = 'cubic-bezier(.28,.86,.22,1)';

                let previous = path[0];
                for (let index = 1; index < path.length; index += 1) {
                    if (token !== activeWalkToken) {
                        return false;
                    }

                    const next = path[index];
                    const duration = walkDuration(pointDistance(previous, next));
                    marker.style.transitionDuration = `${duration}ms, ${duration}ms, 180ms, 180ms`;
                    setMarkerDirection(marker, previous, next);
                    setMarkerPosition(marker, roundPercent(next.x), roundPercent(next.y));
                    await wait(duration + 32);
                    previous = next;
                }

                if (token === activeWalkToken) {
                    marker.classList.remove('is-walking');
                    marker.style.transitionDuration = '';
                    marker.style.transitionTimingFunction = '';
                }

                return true;
            }

            async function walkCurrentToPoint(x, y, options = {}) {
                if (isGuest) {
                    showToast('Guest view ต้อง sign in ก่อนเดินในห้อง');
                    return false;
                }

                const marker = getPersonMarker(currentUserId);
                if (!marker) return false;

                const nextX = clampPercent(x, 4, 96);
                const nextY = clampPercent(y, walkBounds.minY, walkBounds.maxY);
                if (options.closePopovers !== false) {
                    closePopovers();
                }

                const moved = await animateMarkerTo(marker, nextX, nextY, options);

                if (moved && options.message) {
                    showToast(options.message);
                }

                return moved;
            }

            async function walkCurrentHome() {
                if (isGuest) {
                    showToast('Guest view ต้อง sign in ก่อนเดินในห้อง');
                    return;
                }

                const marker = getPersonMarker(currentUserId);
                if (!marker) return;

                const homeX = markerPercent(marker, 'homeX', markerPercent(marker, 'x', 50));
                const homeY = markerPercent(marker, 'homeY', markerPercent(marker, 'y', 50));
                const moved = await walkCurrentToPoint(homeX, homeY, { closePopovers: false });
                if (moved) {
                    focusPerson(currentUserId);
                    showToast('เดินกลับโต๊ะของคุณแล้ว');
                }
            }

            async function walkCurrentTo(targetUserId, intent) {
                if (isGuest) {
                    showToast('Guest view ต้อง sign in ก่อนเดินไปหาเพื่อน');
                    return;
                }

                if (!targetUserId || targetUserId === currentUserId) {
                    return;
                }

                const selfMarker = getPersonMarker(currentUserId);
                const targetMarker = getPersonMarker(targetUserId);
                const targetPerson = peopleById.get(Number(targetUserId));
                if (!selfMarker || !targetMarker || !targetPerson) return;

                const targetX = markerPercent(targetMarker, 'x', 50);
                const targetY = markerPercent(targetMarker, 'y', 50);
                const selfX = markerPercent(selfMarker, 'x', 50);
                const sideOffset = selfX <= targetX ? -5 : 5;
                const targetArea = targetConversationArea(targetUserId);
                const destination = constrainPointToArea({ x: targetX + sideOffset, y: targetY + 2 }, targetArea);
                const nextX = destination.x;
                const nextY = destination.y;

                closePopovers();
                selectedUserId = Number(targetUserId);
                const moved = await animateMarkerTo(selfMarker, nextX, nextY, { ignoreUserId: targetUserId });
                if (!moved) return;

                focusPerson(currentUserId);
                if (!sameConversationArea(targetUserId)) {
                    showToast(`ต้องอยู่ใน ${targetArea.title} ก่อนถึงจะคุยกันได้`);
                    return;
                }

                if (intent === 'talk') {
                    openPerson(targetUserId, targetMarker);
                    const form = document.getElementById('messageForm');
                    form.hidden = false;
                    document.getElementById('messageText').focus();
                    showToast(`เดินไปหา ${targetPerson.displayName} แล้ว`);
                    return;
                }

                if (intent === 'meeting') {
                    const area = currentConversationArea();
                    try {
                        const payload = await postForm(root.dataset.messageUrl, {
                            targetUserId,
                            message: `ขอคุยหรือประชุมกันใน ${area.title} ของ Meeting Room`
                        });
                        showToast(payload.message || `ส่งคำชวนประชุมหา ${targetPerson.displayName} แล้ว`);
                    } catch (error) {
                        showToast(error.message);
                    }
                }
            }

            function openPerson(userId, source) {
                const person = peopleById.get(Number(userId));
                if (!person) return;

                if (Number(userId) === currentUserId) {
                    openSelf(source);
                    return;
                }

                selectedUserId = Number(userId);
                const area = targetConversationArea(userId);
                closePopovers();
                personPopover.hidden = false;
                personPopover.dataset.status = person.status;
                personPopover.dataset.online = String(person.isOnline).toLowerCase();
                document.getElementById('personAvatar').src = person.avatarPath;
                document.getElementById('personName').textContent = person.displayName;
                document.getElementById('personStatus').textContent = `${person.statusLabel}${person.statusText ? ` · ${person.statusText}` : ''}`;
                const workloadText = isGuest ? '' : ` · ${person.workloadTotal} open work`;
                document.getElementById('personMeta').textContent = `${person.position || 'Team'} · ${area.title}${workloadText}`;
                const profileUrl = person.empId ? `/Employees#employee-card-${person.empId}` : '/Employees';
                document.getElementById('viewProfileLink').setAttribute('href', profileUrl);
                document.querySelectorAll(`.mr-person-row[data-user-id="${userId}"]`).forEach(row => row.classList.add('is-selected'));
                syncFollowButton();
                positionPopover(personPopover, source);
            }

            function openSelf(source) {
                closePopovers();
                selfPopover.hidden = false;
                const current = peopleById.get(currentUserId);
                if (current) {
                    const area = currentConversationArea();
                    selfPopover.dataset.status = current.status;
                    selfPopover.querySelector('.mr-profile-meta').textContent = `${current.position || 'Team'} · ${area.title}`;
                    const displayNameInput = document.getElementById('displayNameInput');
                    if (displayNameInput) {
                        displayNameInput.value = current.roomDisplayName || '';
                    }
                    document.querySelectorAll('.mr-status-option').forEach(option => {
                        option.classList.toggle('is-active', option.dataset.status === current.status);
                    });
                    document.querySelectorAll('.mr-character-option').forEach(option => {
                        option.classList.toggle('is-active', option.dataset.character === current.characterPreset);
                    });
                    document.querySelectorAll('.mr-color-option').forEach(option => {
                        option.classList.toggle('is-active', option.dataset.avatarColor === current.avatarColor);
                    });
                    const avatarColorInput = document.getElementById('avatarColorInput');
                    if (avatarColorInput) {
                        avatarColorInput.value = current.avatarColor || defaultAvatarColor;
                    }
                }
                positionPopover(selfPopover, source);
            }

            function updateCurrentStatus(status, statusText, label) {
                const current = peopleById.get(currentUserId);
                if (current) {
                    current.status = status;
                    current.statusLabel = label || statusLabels[status] || status;
                    current.statusText = statusText || '';
                }

                root.querySelectorAll(`[data-user-id="${currentUserId}"]`).forEach(element => {
                    if (element.classList.contains('mr-person')) {
                        element.className = element.className.replace(/status-\S+/g, '').trim();
                        element.classList.add(`status-${status.toLowerCase()}`);
                    }
                    element.dataset.status = status;
                });

                document.getElementById('selfStatusText').textContent = `${label || statusLabels[status] || status}${statusText ? ` · ${statusText}` : ''}`;
                document.getElementById('topCurrentStatus')?.replaceChildren(document.createTextNode(`${label || statusLabels[status] || status}${statusText ? ` · ${statusText}` : ''}`));
                selfPopover.dataset.status = status;
                document.querySelectorAll('.mr-status-option').forEach(option => {
                    option.classList.toggle('is-active', option.dataset.status === status);
                });
            }

            function updateCurrentDisplayName(displayName, roomDisplayName, initial) {
                const current = peopleById.get(currentUserId);
                if (current) {
                    current.displayName = displayName;
                    current.roomDisplayName = roomDisplayName || '';
                    current.initial = initial;
                }

                document.getElementById('topCurrentName')?.replaceChildren(document.createTextNode(displayName));
                document.getElementById('selfDisplayName')?.replaceChildren(document.createTextNode(displayName));
                const displayNameInput = document.getElementById('displayNameInput');
                if (displayNameInput) {
                    displayNameInput.value = roomDisplayName || '';
                }

                const dockSelfMenu = document.getElementById('dockSelfMenu');
                if (dockSelfMenu) {
                    dockSelfMenu.textContent = initial;
                }

                root.querySelectorAll(`[data-user-id="${currentUserId}"]`).forEach(element => {
                    element.dataset.name = displayName;

                    if (element.classList.contains('mr-person')) {
                        element.setAttribute('aria-label', displayName);
                        element.title = displayName;
                        element.querySelector('.mr-name-text')?.replaceChildren(document.createTextNode(displayName));
                        element.querySelector('.mr-name-badge')?.replaceChildren(document.createTextNode(initial));
                    }

                    if (element.classList.contains('mr-person-row')) {
                        const current = peopleById.get(currentUserId);
                        element.querySelector('.mr-row-main strong')?.replaceChildren(document.createTextNode(displayName));
                        element.dataset.search = `${displayName} ${current?.username || ''} ${current?.position || ''}`.toLowerCase();
                    }
                });
            }

            function updateCurrentCharacter(character, avatarColor) {
                character = character || defaultCharacter;
                avatarColor = avatarColor || defaultAvatarColor;
                const current = peopleById.get(currentUserId);
                if (current) {
                    current.characterPreset = character;
                    current.avatarColor = avatarColor;
                }

                root.querySelectorAll(`.mr-person[data-user-id="${currentUserId}"]`).forEach(element => {
                    element.className = element.className.replace(/character-\S+/g, '').trim();
                    element.classList.add(`character-${character}`);
                    element.dataset.character = character;
                    element.dataset.avatarColor = avatarColor;
                    element.style.setProperty('--person-avatar-color', avatarColor);
                });

                document.querySelectorAll('.mr-character-option').forEach(option => {
                    option.classList.toggle('is-active', option.dataset.character === character);
                });

                document.querySelectorAll('.mr-color-option').forEach(option => {
                    option.classList.toggle('is-active', option.dataset.avatarColor === avatarColor);
                });

                const avatarColorInput = document.getElementById('avatarColorInput');
                if (avatarColorInput) {
                    avatarColorInput.value = avatarColor;
                }
            }

            function stopMediaStream(stream) {
                if (!stream) return;
                stream.getTracks().forEach(track => track.stop());
            }

            function setDockMediaState(buttonId, isActive, onText, offText) {
                const button = document.getElementById(buttonId);
                if (!button) return;

                button.classList.toggle('is-off', !isActive);
                button.classList.toggle('is-active', isActive);
                button.title = isActive ? onText : offText;
                button.setAttribute('aria-label', button.title);
            }

            function mediaErrorMessage(error, label) {
                if (error?.name === 'NotAllowedError') {
                    return `ไม่ได้รับสิทธิ์เปิด${label}`;
                }

                if (error?.name === 'NotFoundError') {
                    return `ไม่พบอุปกรณ์${label}`;
                }

                if (error?.name === 'NotReadableError') {
                    return `${label}ถูกใช้งานอยู่ในแอปอื่น`;
                }

                return `เปิด${label}ไม่สำเร็จ`;
            }

            async function toggleMicrophone() {
                if (micStream) {
                    stopMediaStream(micStream);
                    micStream = null;
                    setDockMediaState('toggleMic', false, 'Microphone on', 'Microphone muted');
                    showToast('ปิดไมโครโฟนแล้ว');
                    return;
                }

                if (!navigator.mediaDevices?.getUserMedia) {
                    showToast('เบราว์เซอร์นี้ยังไม่รองรับไมโครโฟน');
                    return;
                }

                try {
                    micStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                    micStream.getAudioTracks().forEach(track => {
                        track.addEventListener('ended', () => {
                            micStream = null;
                            setDockMediaState('toggleMic', false, 'Microphone on', 'Microphone muted');
                        }, { once: true });
                    });
                    setDockMediaState('toggleMic', true, 'Microphone on', 'Microphone muted');
                    showToast(`เปิดไมโครโฟนใน ${currentConversationArea().title} แล้ว`);
                } catch (error) {
                    micStream = null;
                    setDockMediaState('toggleMic', false, 'Microphone on', 'Microphone muted');
                    showToast(mediaErrorMessage(error, 'ไมโครโฟน'));
                }
            }

            async function toggleCameraStream() {
                if (cameraStream) {
                    stopMediaStream(cameraStream);
                    cameraStream = null;
                    setDockMediaState('toggleCamera', false, 'Camera on', 'Camera off');
                    showToast('ปิดกล้องแล้ว');
                    return;
                }

                if (!navigator.mediaDevices?.getUserMedia) {
                    showToast('เบราว์เซอร์นี้ยังไม่รองรับกล้อง');
                    return;
                }

                try {
                    cameraStream = await navigator.mediaDevices.getUserMedia({ audio: false, video: true });
                    cameraStream.getVideoTracks().forEach(track => {
                        track.addEventListener('ended', () => {
                            cameraStream = null;
                            setDockMediaState('toggleCamera', false, 'Camera on', 'Camera off');
                        }, { once: true });
                    });
                    setDockMediaState('toggleCamera', true, 'Camera on', 'Camera off');
                    showToast('เปิดกล้องแล้ว');
                } catch (error) {
                    cameraStream = null;
                    setDockMediaState('toggleCamera', false, 'Camera on', 'Camera off');
                    showToast(mediaErrorMessage(error, 'กล้อง'));
                }
            }

            async function toggleScreenShare() {
                if (screenStream) {
                    stopMediaStream(screenStream);
                    screenStream = null;
                    setDockMediaState('shareScreen', false, 'Screen sharing', 'Screen share off');
                    showToast('หยุดแชร์หน้าจอแล้ว');
                    return;
                }

                if (!navigator.mediaDevices?.getDisplayMedia) {
                    showToast('เบราว์เซอร์นี้ยังไม่รองรับแชร์หน้าจอ');
                    return;
                }

                try {
                    screenStream = await navigator.mediaDevices.getDisplayMedia({ video: true, audio: true });
                    screenStream.getTracks().forEach(track => {
                        track.addEventListener('ended', () => {
                            screenStream = null;
                            setDockMediaState('shareScreen', false, 'Screen sharing', 'Screen share off');
                            showToast('หยุดแชร์หน้าจอแล้ว');
                        }, { once: true });
                    });
                    setDockMediaState('shareScreen', true, 'Screen sharing', 'Screen share off');
                    showToast(`กำลังแชร์หน้าจอใน ${currentConversationArea().title}`);
                } catch (error) {
                    screenStream = null;
                    setDockMediaState('shareScreen', false, 'Screen sharing', 'Screen share off');
                    showToast(mediaErrorMessage(error, 'แชร์หน้าจอ'));
                }
            }

            function describeActiveTrack(stream, fallback) {
                const track = stream?.getTracks().find(item => item.readyState === 'live');
                return track?.label || fallback;
            }

            function isMapPanTarget(event) {
                return roomZoom > 1.01 &&
                    !isCustomizeOpen &&
                    event.isPrimary !== false &&
                    event.button !== 2 &&
                    event.target.closest('.mr-map') &&
                    !event.target.closest('.mr-person, .mr-map-tools, .mr-popover');
            }

            function endMapPan(event) {
                if (!mapPanState || (event && event.pointerId !== mapPanState.pointerId)) {
                    return;
                }

                const moved = mapPanState.moved;
                if (event && map.hasPointerCapture?.(event.pointerId)) {
                    map.releasePointerCapture(event.pointerId);
                }

                mapPanState = null;
                map.classList.remove('is-panning');

                if (moved) {
                    suppressMapClick = true;
                    window.setTimeout(() => {
                        suppressMapClick = false;
                    }, 140);
                }
            }

            map.addEventListener('pointerdown', event => {
                if (startAreaDraw(event)) {
                    return;
                }

                if (!isMapPanTarget(event)) {
                    return;
                }

                mapPanState = {
                    pointerId: event.pointerId,
                    startX: event.clientX,
                    startY: event.clientY,
                    panX: roomPanX,
                    panY: roomPanY,
                    moved: false
                };

                map.setPointerCapture?.(event.pointerId);
                map.classList.add('is-panning');
                event.preventDefault();
            });

            map.addEventListener('pointermove', event => {
                if (updateAreaDraw(event)) {
                    return;
                }

                if (!mapPanState || event.pointerId !== mapPanState.pointerId) {
                    return;
                }

                const dx = event.clientX - mapPanState.startX;
                const dy = event.clientY - mapPanState.startY;
                if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
                    mapPanState.moved = true;
                }

                setRoomPan(mapPanState.panX + dx, mapPanState.panY + dy);
                event.preventDefault();
            });

            map.addEventListener('pointerup', event => {
                if (endAreaDraw(event)) {
                    suppressMapClick = true;
                    window.setTimeout(() => {
                        suppressMapClick = false;
                    }, 140);
                    return;
                }

                endMapPan(event);
            });
            map.addEventListener('pointercancel', event => {
                if (endAreaDraw(event)) {
                    return;
                }

                endMapPan(event);
            });
            map.addEventListener('lostpointercapture', () => {
                if (areaDrawState) {
                    areaDrawState = null;
                }

                if (mapPanState) {
                    mapPanState = null;
                    map.classList.remove('is-panning');
                }
            });

            const customizePanel = document.getElementById('customizePanel');
            const customizeHead = customizePanel?.querySelector('.mr-customize-head');
            customizeHead?.addEventListener('pointerdown', event => {
                if (event.target.closest('button, input, select, textarea, a')) {
                    return;
                }

                const panel = document.getElementById('customizePanel');
                if (!panel || panel.hidden) return;

                const roomRect = root.getBoundingClientRect();
                const panelRect = panel.getBoundingClientRect();
                customizeDragState = {
                    pointerId: event.pointerId,
                    startX: event.clientX,
                    startY: event.clientY,
                    left: panelRect.left - roomRect.left,
                    top: panelRect.top - roomRect.top
                };

                panel.classList.add('is-dragging');
                customizeHead.setPointerCapture?.(event.pointerId);
                event.preventDefault();
            });

            customizeHead?.addEventListener('pointermove', event => {
                if (!customizeDragState || event.pointerId !== customizeDragState.pointerId) {
                    return;
                }

                const dx = event.clientX - customizeDragState.startX;
                const dy = event.clientY - customizeDragState.startY;
                setCustomizePanelPosition(customizeDragState.left + dx, customizeDragState.top + dy);
                event.preventDefault();
            });

            function endCustomizeDrag(event) {
                if (!customizeDragState || (event && event.pointerId !== customizeDragState.pointerId)) {
                    return;
                }

                if (event && customizeHead?.hasPointerCapture?.(event.pointerId)) {
                    customizeHead.releasePointerCapture(event.pointerId);
                }

                customizeDragState = null;
                customizePanel?.classList.remove('is-dragging');
            }

            customizeHead?.addEventListener('pointerup', endCustomizeDrag);
            customizeHead?.addEventListener('pointercancel', endCustomizeDrag);
            customizeHead?.addEventListener('lostpointercapture', () => {
                customizeDragState = null;
                customizePanel?.classList.remove('is-dragging');
            });

            root.addEventListener('click', async event => {
                if (suppressMapClick) {
                    event.preventDefault();
                    event.stopPropagation();
                    return;
                }

                const idTarget = event.target.closest('[id]');
                const targetId = idTarget?.id || '';
                const close = event.target.closest('[data-close-popover]');
                const isEmptyMapClick = event.target.closest('.mr-map') &&
                    !event.target.closest('.mr-person, .mr-map-tools, .mr-popover, .mr-customize-panel, .mr-area-shape, .mr-room-object');
                if (close) {
                    closePopovers();
                    return;
                }

                if (isCustomizeOpen && canCustomize && customizeMode === 'object' && isEmptyMapClick) {
                    placeObjectAtPoint(mapEventToWorldPoint(event));
                    return;
                }

                const areaButton = event.target.closest('.mr-area-shape');
                if (areaButton && canCustomize) {
                    if (!isCustomizeOpen) {
                        openCustomizePanel();
                    }
                    selectArea(Number(areaButton.dataset.areaId || 0));
                    return;
                }

                const areaItem = event.target.closest('.mr-area-item');
                if (areaItem && canCustomize) {
                    selectArea(Number(areaItem.dataset.areaId || 0));
                    return;
                }

                const objectButton = event.target.closest('.mr-room-object');
                if (objectButton && canCustomize && isCustomizeOpen) {
                    selectObject(Number(objectButton.dataset.objectId || 0));
                    return;
                }

                const objectItem = event.target.closest('.mr-object-item');
                if (objectItem && canCustomize) {
                    selectObject(Number(objectItem.dataset.objectId || 0));
                    return;
                }

                const objectOption = event.target.closest('.mr-object-option');
                if (objectOption && canCustomize) {
                    setObjectTemplateActive(objectOption.dataset.objectKey || 'desk-basic');
                    selectedObjectId = null;
                    setCustomizeMode('object');
                    setObjectForm(currentObjectTemplate());
                    document.getElementById('objectDraft')?.setAttribute('hidden', '');
                    showToast('คลิกบนแผนที่เพื่อวางของชิ้นนี้');
                    return;
                }

                const personButton = event.target.closest('.mr-person');
                if (personButton) {
                    openPerson(Number(personButton.dataset.userId), personButton);
                    return;
                }

                const rowButton = event.target.closest('.mr-person-row');
                if (rowButton) {
                    const marker = map.querySelector(`.mr-person[data-user-id="${rowButton.dataset.userId}"]`) || rowButton;
                    focusPerson(rowButton.dataset.userId);
                    openPerson(Number(rowButton.dataset.userId), marker);
                    return;
                }

                if (targetId === 'openSelfMenu') {
                    openSelf(idTarget);
                    return;
                }

                if (targetId === 'openCustomizeRoom') {
                    openCustomizePanel();
                    return;
                }

                if (targetId === 'customizeAreasTab') {
                    setCustomizeMode('area');
                    document.getElementById('objectDraft')?.setAttribute('hidden', '');
                    showToast('ลากบนแผนที่เพื่อสร้างพื้นที่ หรือเลือกพื้นที่เดิมเพื่อแก้');
                    return;
                }

                if (targetId === 'customizeBuildTab') {
                    setCustomizeMode('object');
                    showToast('เลือกของ แล้วคลิกบนแผนที่เพื่อวาง');
                    return;
                }

                if (targetId === 'closeCustomizeRoom') {
                    closeCustomizePanel();
                    return;
                }

                if (targetId === 'newAreaDraft') {
                    setCustomizeMode('area');
                    idTarget.classList.add('is-active');
                    clearAreaDraft();
                    openCustomizePanel();
                    document.getElementById('areaTitleInput')?.focus();
                    showToast('ลากบนแผนที่เพื่อกำหนดขนาดพื้นที่');
                    return;
                }

                if (targetId === 'clearAreaDraft') {
                    clearAreaDraft();
                    return;
                }

                if (targetId === 'clearObjectDraft') {
                    clearObjectDraft();
                    return;
                }

                if (targetId === 'rotateObjectLeft') {
                    rotateObjectForm(-90);
                    return;
                }

                if (targetId === 'rotateObjectRight') {
                    rotateObjectForm(90);
                    return;
                }

                if (targetId === 'deleteObject') {
                    const objectId = Number(document.getElementById('objectIdInput').value || 0);
                    if (!objectId) return;

                    try {
                        const payload = await postForm(root.dataset.deleteObjectUrl, { objectId });
                        customObjects = customObjects.filter(item => Number(item.objectId) !== Number(payload.objectId || objectId));
                        selectedObjectId = null;
                        document.querySelector(`.mr-room-object[data-object-id="${objectId}"]`)?.remove();
                        clearObjectDraft();
                        renderCustomObjects();
                        showToast('ลบของแล้ว');
                    } catch (error) {
                        showToast(error.message);
                    }
                    return;
                }

                if (targetId === 'deleteArea') {
                    const areaId = Number(document.getElementById('areaIdInput').value || 0);
                    if (!areaId) return;

                    try {
                        const payload = await postForm(root.dataset.deleteAreaUrl, { areaId });
                        customAreas = customAreas.filter(area => Number(area.areaId) !== Number(payload.areaId || areaId));
                        selectedAreaId = null;
                        document.querySelector(`.mr-area-shape[data-area-id="${areaId}"]`)?.remove();
                        clearAreaDraft();
                        rebuildVoiceAreas();
                        renderCustomAreas();
                        showToast('ลบพื้นที่แล้ว');
                    } catch (error) {
                        showToast(error.message);
                    }
                    return;
                }

                if (targetId === 'toggleRightPanel') {
                    root.classList.toggle('is-right-panel-collapsed');
                    syncRightPanelToggle();
                    return;
                }

                if (targetId === 'dockSelfMenu') {
                    if (isGuest) {
                        showToast('Guest view ต้อง sign in ก่อนปรับสถานะ');
                        return;
                    }

                    openSelf(idTarget);
                    return;
                }

                if (targetId === 'toggleMic') {
                    await toggleMicrophone();
                    return;
                }

                if (targetId === 'toggleCamera') {
                    await toggleCameraStream();
                    return;
                }

                if (targetId === 'shareScreen') {
                    await toggleScreenShare();
                    return;
                }

                if (targetId === 'micOptions') {
                    showToast(micStream ? `${describeActiveTrack(micStream, 'Microphone active')} · ${currentConversationArea().title}` : 'ไมโครโฟนยังปิดอยู่');
                    return;
                }

                if (targetId === 'cameraOptions') {
                    showToast(cameraStream ? describeActiveTrack(cameraStream, 'Camera active') : 'กล้องยังปิดอยู่');
                    return;
                }

                if (targetId === 'leaveRoom') {
                    window.location.href = isGuest ? '/Auth/Login' : '@Url.Action("Index", "Home")';
                    return;
                }

                if (targetId === 'copyGuestLink') {
                    try {
                        await copyToClipboard(shareLink);
                        showToast('คัดลอก Copy desk link แล้ว');
                    } catch (error) {
                        showToast('คัดลอกลิงก์ไม่สำเร็จ');
                    }
                    return;
                }

                if (targetId === 'zoomInRoom') {
                    changeRoomZoom(zoomConfig.step, { announce: true });
                    return;
                }

                if (targetId === 'zoomOutRoom') {
                    changeRoomZoom(-zoomConfig.step, { announce: true });
                    return;
                }

                if (targetId === 'resetRoomZoom') {
                    applyRoomZoom(1, { announce: true });
                    return;
                }

                if (targetId === 'walkToDesk') {
                    await walkCurrentHome();
                    return;
                }

                if (targetId === 'refreshRoom') {
                    window.location.reload();
                    return;
                }

                if (targetId === 'openMessageBox') {
                    if (isGuest) {
                        showToast('Guest view ต้อง sign in ก่อนส่ง Message');
                        return;
                    }

                    if (!requireSameConversationArea(selectedUserId, 'คุย')) {
                        return;
                    }

                    const form = document.getElementById('messageForm');
                    form.hidden = !form.hidden;
                    if (!form.hidden) {
                        document.getElementById('messageText').focus();
                    }
                    return;
                }

                if (targetId === 'wavePerson' && selectedUserId) {
                    if (isGuest) {
                        showToast('Guest view ต้อง sign in ก่อน Wave');
                        return;
                    }

                    try {
                        const payload = await postForm(root.dataset.waveUrl, { targetUserId: selectedUserId });
                        showToast(payload.message || 'Wave sent.');
                    } catch (error) {
                        showToast(error.message);
                    }
                    return;
                }

                if (targetId === 'walkToTalkPerson' && selectedUserId) {
                    await walkCurrentTo(selectedUserId, 'talk');
                    return;
                }

                if (targetId === 'walkToMeetingPerson' && selectedUserId) {
                    await walkCurrentTo(selectedUserId, 'meeting');
                    return;
                }

                if (targetId === 'locatePerson' && selectedUserId) {
                    focusPerson(selectedUserId);
                    showToast('เจอตำแหน่งบนแผนที่แล้ว');
                    return;
                }

                if (targetId === 'followPerson' && selectedUserId) {
                    toggleFollowPerson(selectedUserId);
                    return;
                }

                if (targetId === 'requestJoinPerson' && selectedUserId) {
                    if (isGuest) {
                        showToast('Guest view ต้อง sign in ก่อนส่งคำขอ');
                        return;
                    }

                    const area = currentConversationArea();
                    try {
                        const payload = await postForm(root.dataset.messageUrl, {
                            targetUserId: selectedUserId,
                            message: `ขอให้เข้ามาคุยด้วยที่ ${area.title} ใน Meeting Room`
                        });
                        showToast(payload.message || 'Request sent.');
                    } catch (error) {
                        showToast(error.message);
                    }

        .mr-person {
            position: absolute;
            z-index: 9;
            left: calc(var(--x) * 1%);
            top: calc(var(--y) * 1%);
            width: 150px;
            min-height: 116px;
            transform: translate(-50%, -50%);
            border: 0;
            padding: 0;
            color: #fff;
            background: transparent;
            cursor: pointer;
            outline: none;
            filter: drop-shadow(0 10px 16px rgba(0,0,0,.28));
            transition: left .82s cubic-bezier(.25,.9,.28,1), top .82s cubic-bezier(.25,.9,.28,1), filter .18s ease, opacity .18s ease;
            will-change: left, top;
        }

        .mr-person.is-offline {
            opacity: .54;
        }

        .mr-person.is-walking {
            z-index: 24;
            filter: drop-shadow(0 18px 24px rgba(0,0,0,.34));
        }

        .mr-person.is-focus .mr-character,
        .mr-person:focus-visible .mr-character,
        .mr-person:hover .mr-character {
            transform: scaleX(var(--avatar-dir, 1)) scale(calc(var(--avatar-scale) + .04)) translateY(-4px);
        }

        .mr-character {
            position: relative;
            width: 56px;
            height: 84px;
            display: block;
            margin: 22px auto 0;
            --avatar-scale: .64;
            --avatar-dir: 1;
            transform: scaleX(var(--avatar-dir, 1)) scale(var(--avatar-scale));
            transform-origin: center top;
            image-rendering: pixelated;
            --skin: var(--avatar-skin, #f2c19b);
            --skin-shadow: color-mix(in srgb, var(--avatar-skin, #f2c19b) 72%, #6b3a24);
            --hair: var(--avatar-hair, #2d3442);
            --hair-hi: #4b5563;
            --outfit: var(--avatar-top, #3b82f6);
            --outfit-dark: color-mix(in srgb, var(--avatar-top, #3b82f6) 64%, #111827);
            --accent: #7dd3fc;
            --pants: var(--avatar-bottom, #1f2937);
            --shoe: var(--avatar-shoes, #e5e7eb);
            --jacket: var(--avatar-jacket, #111827);
            --hat: var(--avatar-hat, #3b82f6);
            --glasses: var(--avatar-glasses, #111827);
            --other: var(--avatar-other, #ef4444);
            --avatar-color: var(--person-avatar-color, #3b82f6);
            transition: transform .18s ease;
        }

        .mr-character::before {
            content: "";
            position: absolute;
            left: 11px;
            right: 9px;
            bottom: 2px;
            height: 9px;
            background: rgba(7,12,18,.42);
            transform: skewX(-18deg);
            z-index: 0;
        }

        .mr-character::after {
            content: "";
            position: absolute;
            left: 6px;
            top: 3px;
            width: 43px;
            height: 39px;
            background: var(--hair);
            box-shadow:
                4px -4px 0 var(--hair-hi),
                0 0 0 3px #0b0f16,
                -4px 8px 0 #0b0f16,
                4px 14px 0 var(--hair);
            z-index: 1;
        }

        .mr-pixel-head,
        .mr-pixel-face,
        .mr-pixel-hair,
        .mr-pixel-facial-hair,
        .mr-pixel-glasses,
        .mr-pixel-hat,
        .mr-pixel-other,
        .mr-pixel-body,
        .mr-pixel-jacket,
        .mr-pixel-arm,
        .mr-pixel-leg,
        .mr-pixel-shoe {
            position: absolute;
            display: block;
            z-index: 2;
            border-radius: 0;
        }

        .mr-pixel-head {
            left: 15px;
            top: 10px;
            width: 27px;
            height: 28px;
            background: var(--skin);
            border-radius: 8px 8px 6px 6px;
            box-shadow: 0 0 0 3px #0b0f16;
            overflow: visible;
            z-index: 3;
        }

        .mr-pixel-head::after {
            content: "";
            position: absolute;
            left: 11px;
            top: 26px;
            width: 7px;
            height: 9px;
            background: var(--skin-shadow);
            box-shadow: 0 0 0 2px #0b0f16;
            z-index: 0;
        }

        .mr-pixel-face {
            left: 15px;
            top: 10px;
            width: 27px;
            height: 28px;
            overflow: hidden;
            background: var(--skin);
            border-radius: 8px 8px 6px 6px;
            z-index: 4;
        }

        .mr-pixel-face::before {
            content: "";
            position: absolute;
            left: 7px;
            top: 10px;
            width: 3px;
            height: 4px;
            background: #101827;
            box-shadow: 12px 0 0 #101827;
        }

        .mr-pixel-face::after {
            content: "";
            position: absolute;
            left: 10px;
            top: 20px;
            width: 9px;
            height: 2px;
            background: rgba(88,45,32,.72);
            box-shadow: 0 2px 0 rgba(255,255,255,.18);
        }

        .mr-person.is-speaking .mr-pixel-face::after,
        .mr-character.is-speaking .mr-pixel-face::after {
            left: 10px;
            top: 20px;
            width: 8px;
            height: 5px;
            border-radius: 0 0 6px 6px;
            background: #4a1f1f;
            box-shadow: inset 0 -2px 0 rgba(255,255,255,.22);
            animation: mrTalkMouth .18s steps(2, end) infinite;
        }

        .mr-speaking-bubble {
            position: absolute;
            left: 40px;
            top: 5px;
            width: 32px;
            height: 26px;
            opacity: 0;
            transform: translate(3px, -3px) scale(.82);
            transform-origin: 8px 24px;
            transition: opacity .12s ease, transform .12s ease;
            pointer-events: none;
            z-index: 28;
        }

        .mr-speaking-bubble::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 30px;
            height: 21px;
            border: 3px solid #0b0f16;
            border-radius: 999px;
            background: #ffffff;
            box-shadow: 0 2px 0 rgba(7,12,18,.18);
        }

        .mr-speaking-bubble::after {
            content: "";
            position: absolute;
            left: 3px;
            bottom: 1px;
            width: 10px;
            height: 9px;
            border-left: 3px solid #0b0f16;
            border-bottom: 3px solid #0b0f16;
            border-bottom-left-radius: 2px;
            background: #ffffff;
            transform: rotate(-26deg);
        }

        .mr-speaking-bubble span {
            position: absolute;
            left: 8px;
            top: 9px;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: #0b0f16;
            box-shadow: 7px 0 0 #0b0f16, 14px 0 0 #0b0f16;
            z-index: 1;
            animation: mrSpeakingDots .92s steps(3, end) infinite;
        }

        .mr-person.is-speaking .mr-speaking-bubble,
        .mr-character.is-speaking .mr-speaking-bubble {
            opacity: 1;
            transform: translate(0, -4px) scale(1);
            animation: mrSpeechBubble .9s ease-in-out infinite;
        }

        .mr-pixel-hair {
            left: 9px;
            top: 1px;
            width: 39px;
            height: 24px;
            background: var(--hair);
            border-radius: 13px 13px 5px 5px;
            box-shadow:
                0 0 0 3px #0b0f16,
                5px -4px 0 color-mix(in srgb, var(--hair) 70%, #ffffff),
                -4px 11px 0 -1px var(--hair);
            z-index: 3;
        }

        .mr-pixel-facial-hair {
            display: none;
            left: 22px;
            top: 29px;
            width: 16px;
            height: 6px;
            background: var(--hair);
            box-shadow: 0 0 0 2px #0b0f16;
            z-index: 6;
        }

        .mr-pixel-glasses {
            display: none;

                const roomRect = root.getBoundingClientRect();
                const panelRect = panel.getBoundingClientRect();
                customizeDragState = {
                    pointerId: event.pointerId,
                    startX: event.clientX,
                    startY: event.clientY,
                    left: panelRect.left - roomRect.left,
                    top: panelRect.top - roomRect.top
                };

                panel.classList.add('is-dragging');
                customizeHead.setPointerCapture?.(event.pointerId);
                event.preventDefault();
            });

            customizeHead?.addEventListener('pointermove', event => {
                if (!customizeDragState || event.pointerId !== customizeDragState.pointerId) {
                    return;
                }

                const dx = event.clientX - customizeDragState.startX;
                const dy = event.clientY - customizeDragState.startY;
                setCustomizePanelPosition(customizeDragState.left + dx, customizeDragState.top + dy);
                event.preventDefault();
            });

            function endCustomizeDrag(event) {
                if (!customizeDragState || (event && event.pointerId !== customizeDragState.pointerId)) {
                    return;
                }

                if (event && customizeHead?.hasPointerCapture?.(event.pointerId)) {
                    customizeHead.releasePointerCapture(event.pointerId);
                }

                customizeDragState = null;
                customizePanel?.classList.remove('is-dragging');
            }

            customizeHead?.addEventListener('pointerup', endCustomizeDrag);
            customizeHead?.addEventListener('pointercancel', endCustomizeDrag);
            customizeHead?.addEventListener('lostpointercapture', () => {
                customizeDragState = null;
                customizePanel?.classList.remove('is-dragging');
            });

            const meetingHead = meetingPanel?.querySelector('.mr-meeting-head');
            meetingHead?.addEventListener('pointerdown', event => {

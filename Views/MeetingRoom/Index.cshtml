                    setDockMediaState('shareScreen', false, 'Screen sharing', 'Screen share off');
                    await broadcastMeetingMediaState({ screenOn: false });
                    refreshProximityVoice();
                    scheduleMeetingVideosRender();
                    scheduleMeetingParticipantsRender();
                    showToast('หยุดแชร์หน้าจอแล้ว');
                    return;
                }

                if (!navigator.mediaDevices?.getDisplayMedia) {
                    showToast('เบราว์เซอร์นี้ยังไม่รองรับแชร์หน้าจอ');
                    return;
                }

                try {
                    const stream = await navigator.mediaDevices.getDisplayMedia({ video: true, audio: true });
                    screenStream = stream;
                    screenStream.getTracks().forEach(track => {
                        track.addEventListener('ended', () => {
                            removeStreamTracksFromRtcPeers(stream);
                            screenStream = null;
                            setDockMediaState('shareScreen', false, 'Screen sharing', 'Screen share off');
                            void broadcastMeetingMediaState({ screenOn: false });
                            refreshProximityVoice();
                            scheduleMeetingVideosRender();
                            scheduleMeetingParticipantsRender();
                            showToast('หยุดแชร์หน้าจอแล้ว');
                        }, { once: true });
                    });
                    addStreamTracksToRtcPeers(screenStream);
                    setDockMediaState('shareScreen', true, 'Screen sharing', 'Screen share off');
                    await broadcastMeetingMediaState({ screenOn: true });
                    await openMeetingPanel('screen');
                    scheduleMeetingVideosRender();
                    scheduleMeetingParticipantsRender();
                    showToast(`กำลังแชร์หน้าจอใน ${currentConversationArea().title}`);
                } catch (error) {
                    screenStream = null;
                    setDockMediaState('shareScreen', false, 'Screen sharing', 'Screen share off');
                    await broadcastMeetingMediaState({ screenOn: false });
                    showToast(mediaErrorMessage(error, 'แชร์หน้าจอ'));
                }
            }

            function describeActiveTrack(stream, fallback) {
                const track = stream?.getTracks().find(item => item.readyState === 'live');
                return track?.label || fallback;
            }

            function clampMeetingPanelPosition(left, top) {
                if (!meetingPanel) return { left, top };

                const roomRect = root.getBoundingClientRect();
                const panelRect = meetingPanel.getBoundingClientRect();
                const padding = 10;
                return {
                    left: clampPercent(left, padding, Math.max(padding, roomRect.width - panelRect.width - padding)),
                    top: clampPercent(top, padding, Math.max(padding, roomRect.height - panelRect.height - padding))
                };
            }

            function setMeetingPanelPosition(left, top) {
                if (!meetingPanel) return;

                const next = clampMeetingPanelPosition(left, top);
                meetingPanel.style.left = `${next.left}px`;
                meetingPanel.style.top = `${next.top}px`;
                meetingPanel.style.right = 'auto';
                meetingPanel.style.bottom = 'auto';
                meetingPanelPositioned = true;
            }

            function defaultMeetingPanelPosition() {
                const roomRect = root.getBoundingClientRect();
                const topbarRect = root.querySelector('.mr-topbar')?.getBoundingClientRect();
                const left = topbarRect
                    ? Math.max(10, topbarRect.left - roomRect.left + 4)
                    : 22;
                const top = topbarRect
                    ? Math.max(10, topbarRect.bottom - roomRect.top + 10)
                    : 92;

                return clampMeetingPanelPosition(left, top);
            }

            function setDefaultMeetingPanelPosition() {
                const next = defaultMeetingPanelPosition();
                setMeetingPanelPosition(next.left, next.top);
            }

            function ensureMeetingPanelInView() {
                if (!meetingPanel || meetingPanel.hidden || !meetingPanelPositioned) return;

                const roomRect = root.getBoundingClientRect();
                const panelRect = meetingPanel.getBoundingClientRect();
                setMeetingPanelPosition(panelRect.left - roomRect.left, panelRect.top - roomRect.top);
            }

            function isMeetingPanelOpen() {
                return meetingPanel && !meetingPanel.hidden;
            }

            function liveAudioTracks(stream) {
                return stream?.getAudioTracks?.().filter(track => track.readyState === 'live' && track.enabled !== false) || [];
            }

            function liveVideoTracks(stream) {
                return stream?.getVideoTracks?.().filter(track => track.readyState === 'live') || [];
            }

            function streamLooksLikeScreen(stream) {
                const labels = liveVideoTracks(stream)
                    .map(track => String(track.label || '').toLowerCase())
                    .join(' ');
                return /screen|display|window|tab|share/.test(labels);
            }

            function resetMeetingScreenView() {
                screenViewerZoom = 1;
                screenViewerPanX = 0;
                screenViewerPanY = 0;
                applyMeetingScreenTransform();
            }

            function applyMeetingScreenTransform() {
                const canvas = document.getElementById('meetingScreenCanvas');
                const viewport = document.getElementById('meetingScreenViewport');
                const value = document.getElementById('meetingScreenZoomValue');
                if (!canvas) return;

                if (viewport) {
                    const rect = viewport.getBoundingClientRect();
                    const maxX = Math.max(0, (rect.width * (screenViewerZoom - 1)) / 2);
                    const maxY = Math.max(0, (rect.height * (screenViewerZoom - 1)) / 2);
                    screenViewerPanX = clampPercent(screenViewerPanX, -maxX, maxX);
                    screenViewerPanY = clampPercent(screenViewerPanY, -maxY, maxY);
                }

                canvas.style.setProperty('--screen-zoom', screenViewerZoom);
                canvas.style.setProperty('--screen-pan-x', `${screenViewerPanX}px`);
                canvas.style.setProperty('--screen-pan-y', `${screenViewerPanY}px`);
                viewport?.classList.toggle('is-pannable', screenViewerZoom > 1.01);
                if (value) {
                    value.textContent = `${Math.round(screenViewerZoom * 100)}%`;
                }
            }

            function setMeetingScreenZoom(nextZoom) {
                screenViewerZoom = Number(clampPercent(nextZoom, screenViewerZoomConfig.min, screenViewerZoomConfig.max).toFixed(2));
                if (screenViewerZoom <= 1.01) {
                    screenViewerPanX = 0;
                    screenViewerPanY = 0;
                }
                applyMeetingScreenTransform();
            }

            function closeMeetingScreenViewer() {
                const viewer = document.getElementById('meetingScreenViewer');
                const video = document.getElementById('meetingScreenVideo');
                if (video) {
                    detachLiveKitElement(video);
                    video.srcObject = null;
                }
                activeScreenSourceId = '';
                screenViewerPanState = null;
                document.getElementById('meetingScreenViewport')?.classList.remove('is-panning');
                if (viewer) {
                    viewer.hidden = true;
                }
            }

            function openMeetingScreenViewer(sourceId) {
                const source = meetingScreenSources.get(sourceId);
                const hasLiveKitTrack = source?.track && isLiveKitTrackLive(source.track);
                if (!source || (!hasLiveKitTrack && !liveVideoTracks(source.stream).length)) {
                    showToast('ยังไม่มีจอแชร์ให้ขยาย');
                    return;
                }

                activeScreenSourceId = sourceId;
                document.getElementById('meetingScreenViewerTitle')?.replaceChildren(document.createTextNode(source.label || 'Shared screen'));
                document.getElementById('meetingScreenViewerMeta')?.replaceChildren(document.createTextNode('ซูมได้ด้วยปุ่มหรือ scroll แล้วลากเพื่อเลื่อน'));

                const video = document.getElementById('meetingScreenVideo');
                if (video) {
                    detachLiveKitElement(video);
                    if (hasLiveKitTrack) {
                        attachLiveKitTrackToElement(source.track, video, source.publication);
                    } else {
                        video.srcObject = source.stream;
                    }
                    video.muted = true;
                    video.play?.().catch(() => { });
                }

                document.getElementById('meetingScreenViewer')?.removeAttribute('hidden');
                resetMeetingScreenView();
            }

            function meetingArea() {
                if (!activeMeetingArea) {
                    activeMeetingArea = currentConversationArea();
                }

                return activeMeetingArea;
            }

            function sameMeetingArea(area) {
                return normalizeAreaKey(area?.key || area?.areaKey || '') === normalizeAreaKey(meetingArea()?.key || '');
            }

            function meetingParticipantsForArea(area) {
                return [...peopleById.values()]
                    .filter(person => {
                        if (isDndStatus(person.status)) return false;
                        const marker = getPersonMarker(person.userId);
                        if (!marker || marker.hidden) return false;
                        return markerArea(marker).key === area.key;
                    })
                    .sort((a, b) => Number(b.userId === currentUserId) - Number(a.userId === currentUserId) ||
                        String(a.displayName || '').localeCompare(String(b.displayName || ''), 'th'));
            }

            function createVideoTile(label, stream, options = {}) {
                const tile = document.createElement('div');
                const liveKitTrack = options.liveKitTrack || null;
                const hasVideo = Boolean((stream && liveVideoTracks(stream).length) ||
                    (liveKitTrack && isLiveKitTrackLive(liveKitTrack)));
                const sourceId = options.sourceId || '';
                tile.className = `mr-video-tile${options.isScreen ? ' is-screen' : ''}${hasVideo ? ' is-expandable' : ''}`;
                tile.classList.toggle('is-camera-off', !hasVideo);
                if (hasVideo && sourceId) {
                    tile.dataset.screenSourceId = sourceId;
                    tile.tabIndex = 0;
                    tile.setAttribute('role', 'button');
                    tile.setAttribute('aria-label', `Expand ${label}`);
                    meetingScreenSources.set(sourceId, {
                        label,
                        stream,
                        track: liveKitTrack,
                        publication: options.liveKitPublication || null
                    });
                }

                if (hasVideo) {
                    const video = document.createElement('video');
                    video.autoplay = true;
                    video.playsInline = true;
                    video.muted = options.muted !== false;
                    if (liveKitTrack) {
                        attachLiveKitTrackToElement(liveKitTrack, video, options.liveKitPublication || null);
                    } else {
                        video.srcObject = stream;
                    }
                    tile.appendChild(video);
                    const expand = document.createElement('span');
                    expand.className = 'mr-video-expand';
                    expand.textContent = '⛶';
                    tile.appendChild(expand);
                } else {
                    const placeholder = document.createElement('div');
                    placeholder.className = 'mr-video-placeholder';
                    if (options.initial) {
                        const avatar = document.createElement('span');
                        avatar.className = 'mr-video-avatar';
                        avatar.textContent = options.initial;
                        placeholder.appendChild(avatar);
                    }
                    const placeholderText = document.createElement('span');
                    placeholderText.textContent = options.placeholder || 'Camera off';
                    placeholder.appendChild(placeholderText);
                    tile.appendChild(placeholder);
                }

                const state = document.createElement('span');
                state.className = `mr-video-state ${options.isScreen ? 'is-on' : (options.micOn ? 'is-on' : 'is-off')}`;
                state.textContent = options.isScreen ? 'Share' : (options.micOn ? 'Mic' : 'Mute');
                tile.appendChild(state);

                const caption = document.createElement('span');
                caption.className = 'mr-video-label';
                caption.textContent = label;
                tile.appendChild(caption);

                return tile;
            }

            function renderMeetingVideos() {
                const grid = document.getElementById('meetingVideoGrid');
                if (!grid) return;

                detachLiveKitElements(grid);
                grid.replaceChildren();
                meetingScreenSources.clear();
                const area = meetingArea();
                const participants = meetingParticipantsForArea(area);
                const current = peopleById.get(currentUserId);
                const currentName = current?.displayName || 'You';
                const localScreenPublication = liveKitLocalPublication((publication, track) =>
                    isLiveKitVideoEntry(track, publication) && isLiveKitScreenSource(liveKitPublicationSource(publication)));
                const localScreenTrack = liveKitPublicationTrack(localScreenPublication);
                const localCameraPublication = liveKitLocalPublication((publication, track) =>
                    isLiveKitVideoEntry(track, publication) && !isLiveKitScreenSource(liveKitPublicationSource(publication)));
                const localCameraTrack = liveKitPublicationTrack(localCameraPublication);

                if ((screenStream && liveVideoTracks(screenStream).length) || localScreenTrack) {
                    grid.appendChild(createVideoTile(`${currentName} · Screen`, screenStream, {
                        isScreen: true,
                        muted: true,
                        sourceId: 'local-screen',
                        initial: current?.initial || 'Y',
                        micOn: Boolean(micStream),
                        liveKitTrack: localScreenTrack,
                        liveKitPublication: localScreenPublication
                    }));
                }

                participants
                    .filter(person => Number(person.userId) !== currentUserId)
                    .forEach(person => {
                        const liveKitScreens = liveKitRemoteEntriesForUser(person.userId).filter(liveKitEntryIsScreen);
                        if (liveKitScreens.length) {
                            liveKitScreens.forEach(entry => {
                                const media = meetingMediaStateForUser(person.userId);
                                grid.appendChild(createVideoTile(`${person.displayName || `User ${person.userId}`} · Screen`, null, {
                                    muted: true,
                                    isScreen: true,
                                    sourceId: `livekit-screen-${person.userId}-${liveKitTrackSid(entry.track, entry.publication) || entry.updatedAt}`,
                                    initial: person.initial || 'U',
                                    micOn: Boolean(media.micOn),
                                    liveKitTrack: entry.track,
                                    liveKitPublication: entry.publication
                                }));
                            });
                            return;
                        }

                        remoteMediaEntriesForUser(person.userId)
                            .filter(entry => liveVideoTracks(entry.stream).length)
                            .filter(entry => isRemoteScreenStream(person.userId, entry.stream))
                            .forEach(entry => {
                                const media = meetingMediaStateForUser(person.userId);
                                grid.appendChild(createVideoTile(`${person.displayName || `User ${person.userId}`} · Screen`, entry.stream, {
                                    muted: true,
                                    isScreen: true,
                                    sourceId: `remote-screen-${person.userId}-${entry.stream.id || 'video'}`,
                                    initial: person.initial || 'U',
                                    micOn: Boolean(media.micOn)
                                }));
                            });
                    });

                participants.forEach(person => {
                    const userId = Number(person.userId);
                    const isSelf = userId === currentUserId;
                    const media = meetingMediaStateForUser(userId);
                    let stream = null;
                    let liveKitTrack = null;
                    let liveKitPublication = null;

                    if (isSelf) {
                        stream = cameraStream;
                        liveKitTrack = localCameraTrack;
                        liveKitPublication = localCameraPublication;
                    } else {
                        const liveKitCameraEntry = liveKitRemoteEntriesForUser(userId).find(liveKitEntryIsCamera);
                        if (liveKitCameraEntry) {
                            liveKitTrack = liveKitCameraEntry.track;
                            liveKitPublication = liveKitCameraEntry.publication;
                        } else {
                            const cameraEntry = remoteMediaEntriesForUser(userId)
                                .filter(entry => liveVideoTracks(entry.stream).length)
                                .find(entry => !isRemoteScreenStream(userId, entry.stream));
                            stream = cameraEntry?.stream || null;
                        }
                    }

                    const label = isSelf ? `${person.displayName || currentName} · You` : (person.displayName || `User ${userId}`);
                    grid.appendChild(createVideoTile(label, stream, {
                        muted: true,
                        placeholder: stream || liveKitTrack ? 'Camera starting' : 'กล้องปิด',
                        sourceId: isSelf ? 'local-camera' : `remote-camera-${userId}`,
                        initial: person.initial || (isSelf ? 'Y' : 'U'),
                        micOn: Boolean(media.micOn),
                        liveKitTrack,
                        liveKitPublication
                    }));
                });

                if (!grid.children.length) {
                    grid.appendChild(createVideoTile('Meeting', null, {
                        muted: true,
                        placeholder: 'ยังไม่มีคนในเอเรียนี้'
                    }));
                }

                const tileCount = grid.querySelectorAll(':scope > .mr-video-tile').length;
                grid.dataset.tileCount = String(tileCount);
                grid.classList.toggle('is-single', tileCount === 1);
                grid.classList.toggle('is-many', tileCount >= 5);
                grid.classList.toggle('is-crowded', tileCount >= 9);

                if (activeScreenSourceId && !meetingScreenSources.has(activeScreenSourceId)) {
                    closeMeetingScreenViewer();
                }
            }

            function renderMeetingParticipants() {
                const list = document.getElementById('meetingParticipants');
                const count = document.getElementById('meetingParticipantCount');
                if (!list) return;

                const participants = meetingParticipantsForArea(meetingArea());
                if (count) {
                    count.textContent = String(participants.length);
                }

                list.replaceChildren();
                if (!participants.length) {
                    const empty = document.createElement('div');
                    empty.className = 'mr-meeting-empty';
                    empty.textContent = 'ไม่มีคนในเอเรียนี้';
                    list.appendChild(empty);
                    return;
                }

                participants.forEach(person => {
                    const media = meetingMediaStateForUser(person.userId);
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'mr-meeting-person';
                    button.classList.toggle('is-speaking', Boolean(media.isSpeaking));
                    button.dataset.userId = String(person.userId);
                    button.title = `${person.displayName} · ${media.micOn ? 'ไมค์เปิด' : 'ไมค์ปิด'}`;

                    const avatar = document.createElement('span');
                    avatar.className = 'mr-meeting-avatar';
                    avatar.textContent = person.initial || 'U';

                    const copy = document.createElement('span');
                    copy.className = 'mr-meeting-person-copy';
                    const name = document.createElement('strong');
                    name.textContent = person.userId === currentUserId ? `${person.displayName} · You` : person.displayName;
                    const meta = document.createElement('span');
                    meta.textContent = `${person.statusLabel || 'Available'} · ${media.micOn ? 'ไมค์เปิด' : 'ไมค์ปิด'}`;
                    copy.append(name, meta);

                    const mic = document.createElement('span');
                    mic.className = `mr-meeting-mic ${media.micOn ? 'is-on' : 'is-off'}`;
                    mic.textContent = media.micOn ? 'เปิด' : 'ปิด';

                    button.append(avatar, copy, mic);
                    list.appendChild(button);
                });
            }

            function renderMeetingFiles() {
                const list = document.getElementById('meetingFiles');
                if (!list) return;

                list.replaceChildren();
                if (!meetingFiles.length) {
                    const empty = document.createElement('div');
                    empty.className = 'mr-meeting-empty';
                    empty.textContent = 'ยังไม่มีไฟล์ในเอเรียนี้';
                    list.appendChild(empty);
                    return;
                }

                meetingFiles.forEach(file => {
                    const link = document.createElement('a');
                    link.className = 'mr-meeting-file';
                    link.href = file.url || '#';
                    link.target = '_blank';
                    link.rel = 'noopener';

                    const avatar = document.createElement('span');
                    avatar.className = 'mr-meeting-avatar';
                    avatar.textContent = 'F';

                    const copy = document.createElement('span');
                    const name = document.createElement('strong');
                    name.textContent = file.fileName || 'File';
                    const meta = document.createElement('span');
                    meta.textContent = `${file.fileSizeText || ''}${file.uploadedByName ? ` · ${file.uploadedByName}` : ''}`;
                    copy.append(name, meta);

                    link.append(avatar, copy);
                    list.appendChild(link);
                });
            }

            async function loadMeetingFiles(force = false) {
                if (isGuest || !root.dataset.filesUrl || !isMeetingPanelOpen()) return;

                const area = meetingArea();
                if (!force && meetingFilesAreaKey === area.key) {
                    renderMeetingFiles();
                    return;
                }

                try {
                    const url = `${root.dataset.filesUrl}?areaKey=${encodeURIComponent(area.key)}`;
                    const response = await fetch(url, {
                        headers: { 'Accept': 'application/json' },
                        cache: 'no-store'
                    });
                    const payload = await response.json().catch(() => null);
                    if (!response.ok || !payload?.ok || !Array.isArray(payload.files)) return;

                    meetingFilesAreaKey = area.key;
                    meetingFiles = payload.files;
                    renderMeetingFiles();
                } catch {
                    renderMeetingFiles();
                }
            }

            function renderMeetingPanel() {
                if (!isMeetingPanelOpen()) return;

                const area = meetingArea();
                document.getElementById('meetingPanelTitle')?.replaceChildren(document.createTextNode('Meeting'));
                document.getElementById('meetingPanelArea')?.replaceChildren(document.createTextNode(area.title || 'Meeting area'));
                setDockMediaState('toggleMic', Boolean(micStream), 'Microphone on', 'Microphone muted');
                setDockMediaState('toggleCamera', Boolean(cameraStream), 'Camera on', 'Camera off');
                setDockMediaState('shareScreen', Boolean(screenStream), 'Screen sharing', 'Screen share off');
                syncMeetingConnectionStatus();
                renderMeetingVideos();
                renderMeetingParticipants();
                renderMeetingFiles();
            }

            async function openMeetingPanel(reason = 'meeting') {
                if (isGuest) {
                    showToast('Guest view ต้อง sign in ก่อนเข้าประชุม');
                    return false;
                }
                if (isCurrentDnd()) {
                    await enforceCurrentDndMode({ toast: false });
                    if (reason !== 'auto') {
                        showToast('คุณอยู่ในสถานะ Do Not Disturb ต้องเปลี่ยนสถานะก่อนเข้าประชุม');
                    }
                    return false;
                }

                activeMeetingArea = currentConversationArea();
                if (reason !== 'auto') {
                    dismissedMeetingAreaKey = '';
                }
                meetingPanel.hidden = false;
                if (meetingPanelPositioned) {
                    ensureMeetingPanelInView();
                } else {
                    setDefaultMeetingPanelPosition();
                }
                closePopovers();
                if (useLiveKitMedia()) {
                    await ensureLiveKitRoom(activeMeetingArea);
                }
                renderMeetingPanel();
                if (reason === 'file') {
                    document.getElementById('meetingFileInput')?.click();
                }

                await announceVoiceArea();
                await loadMeetingFiles(true);
                refreshProximityVoice();

                return true;
            }

            function dismissAutoMeetingForCurrentArea() {
                const area = activeMeetingArea || currentConversationArea();
                if (isMeetingArea(area)) {
                    dismissedMeetingAreaKey = normalizeAreaKey(area.key || area.title || '');
                }
                clearAutoMeetingTimer();
            }

            function minimizeMeetingPanel() {
                dismissAutoMeetingForCurrentArea();
                if (meetingPanel) {
                    meetingPanel.hidden = true;
                }
            }

            function leaveMeetingPanel(options = {}) {
                dismissAutoMeetingForCurrentArea();
                if (useLiveKitMedia()) {
                    void disconnectLiveKitRoom();
                } else {
                    if (micStream) {
                        stopSpeakingDetector(currentUserId);
                        stopMediaStream(micStream);
                        micStream = null;
                        setDockMediaState('toggleMic', false, 'Microphone on', 'Microphone muted');
                    }

                    if (cameraStream) {
                        removeStreamTracksFromRtcPeers(cameraStream);
                        stopMediaStream(cameraStream);
                        cameraStream = null;
                        setDockMediaState('toggleCamera', false, 'Camera on', 'Camera off');
                    }

                    if (screenStream) {
                        removeStreamTracksFromRtcPeers(screenStream);
                        stopMediaStream(screenStream);
                        screenStream = null;
                        setDockMediaState('shareScreen', false, 'Screen sharing', 'Screen share off');
                    }
                }

                closeAllRtcPeers();
                void broadcastMeetingMediaState({ micOn: false, cameraOn: false, screenOn: false, isSpeaking: false });
                activeMeetingArea = null;
                closeMeetingScreenViewer();
                minimizeMeetingPanel();
                showToast(options.message || 'ออกจาก Meeting แล้ว');
            }

            function refreshMeetingPanel() {
                if (!isMeetingPanelOpen()) return;

                const currentArea = currentConversationArea();
                const previousArea = activeMeetingArea;
                if (previousArea && isMeetingArea(previousArea) &&
                    normalizeAreaKey(currentArea.key || currentArea.title || '') !== normalizeAreaKey(previousArea.key || previousArea.title || '')) {
                    leaveMeetingPanel({ message: 'ออกจาก Meeting เพราะเดินออกจากพื้นที่ประชุมแล้ว' });
                    return;
                }

                if (!activeMeetingArea || currentArea.key !== activeMeetingArea.key) {
                    activeMeetingArea = currentArea;
                    meetingFilesAreaKey = '';
                    loadMeetingFiles(true);
                }

                renderMeetingPanel();
            }

            async function uploadMeetingFile(file) {
                if (!file || !root.dataset.shareFileUrl) return;

                const opened = await openMeetingPanel('file');
                if (!opened) return;

                const area = meetingArea();
                const formData = new FormData();
                formData.append('__RequestVerificationToken', token);
                formData.append('file', file);
                formData.append('areaKey', area.key);
                formData.append('areaTitle', area.title || area.key);

                try {
                    const response = await fetch(root.dataset.shareFileUrl, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' },
                        body: formData
                    });
                    const payload = await response.json().catch(() => null);
                    if (!response.ok || !payload?.ok) {
                        throw new Error(payload?.message || 'แชร์ไฟล์ไม่สำเร็จ');
                    }

                    if (payload.file && sameMeetingArea(payload.file)) {
                        meetingFiles = [payload.file, ...meetingFiles.filter(item => item.shareId !== payload.file.shareId)];
                        renderMeetingFiles();
                    }

                    showToast(payload.message || 'แชร์ไฟล์แล้ว');
                } catch (error) {
                    showToast(error.message || 'แชร์ไฟล์ไม่สำเร็จ');
                }
            }

            function isMapPanTarget(event) {
                return roomZoom > 1.01 &&
                    !isCustomizeOpen &&
                    event.isPrimary !== false &&
                    event.button !== 2 &&
                    event.target.closest('.mr-map') &&
                    !event.target.closest('.mr-person, .mr-map-tools, .mr-popover');
            }

            function endMapPan(event) {
                if (!mapPanState || (event && event.pointerId !== mapPanState.pointerId)) {
                    return;
                }

                const moved = mapPanState.moved;
                if (event && map.hasPointerCapture?.(event.pointerId)) {
                    map.releasePointerCapture(event.pointerId);
                }

                mapPanState = null;
                map.classList.remove('is-panning');

                if (moved) {
                    suppressMapClick = true;
                    window.setTimeout(() => {
                        suppressMapClick = false;
                    }, 140);
                }
            }

            map.addEventListener('pointerdown', event => {
                if (beginExistingAreaDrag(event)) {
                    return;
                }

                if (startAreaDraw(event)) {
                    return;
                }

                if (beginExistingObjectDrag(event)) {
                    return;
                }

                if (!isMapPanTarget(event)) {
                    return;
                }

                mapPanState = {
                    pointerId: event.pointerId,
                    startX: event.clientX,
                    startY: event.clientY,
                    panX: roomPanX,
                    panY: roomPanY,
                    moved: false
                };

                map.setPointerCapture?.(event.pointerId);
                map.classList.add('is-panning');
                event.preventDefault();
            });

            map.addEventListener('pointermove', event => {
                if (updateAreaDrag(event)) {
                    return;
                }

                if (updateAreaDraw(event)) {
                    return;
                }

                if (!mapPanState || event.pointerId !== mapPanState.pointerId) {
                    return;
                }

                const dx = event.clientX - mapPanState.startX;
                const dy = event.clientY - mapPanState.startY;
                if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
                    mapPanState.moved = true;
                }

                setRoomPan(mapPanState.panX + dx, mapPanState.panY + dy);
                event.preventDefault();
            });

            map.addEventListener('pointerup', event => {
                if (endAreaDrag(event)) {
                    return;
                }

                if (endAreaDraw(event)) {
                    suppressMapClick = true;
                    window.setTimeout(() => {
                        suppressMapClick = false;
                    }, 140);
                    return;
                }

                endMapPan(event);
            });
            map.addEventListener('pointercancel', event => {
                if (endAreaDrag(event)) {
                    return;
                }

                if (endAreaDraw(event)) {
                    return;
                }

                endMapPan(event);
            });

            document.addEventListener('pointerdown', event => {
                const option = event.target.closest('.mr-object-option');
                if (option) {
                    beginPaletteObjectDrag(event, option);
                }
            });

            document.addEventListener('pointermove', event => {
                updateObjectDrag(event);
            });

            document.addEventListener('pointerup', event => {
                endObjectDrag(event);
            });

            document.addEventListener('pointercancel', event => {
                endObjectDrag(event);
            });

            document.addEventListener('dragstart', event => {
                if (event.target.closest('.mr-object-option')) {
                    event.preventDefault();
                }
            });
            map.addEventListener('lostpointercapture', () => {
                if (areaDragState) {
                    areaDragState = null;
                    root.classList.remove('is-area-dragging');
                }

                if (areaDrawState) {
                    areaDrawState = null;
                }

                if (mapPanState) {
                    mapPanState = null;
                    map.classList.remove('is-panning');
                }
            });

            const customizePanel = document.getElementById('customizePanel');

@model ProjectTracking.ViewModels.MeetingRoomViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Meeting Room";

    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
    var peopleJson = JsonSerializer.Serialize(Model.People, jsonOptions);
    var zonesJson = JsonSerializer.Serialize(Model.Zones, jsonOptions);
    var objectsJson = JsonSerializer.Serialize(Model.Objects, jsonOptions);
    var current = Model.CurrentUser;
    var isGuest = Model.IsGuest;
    var shareLink = Model.ShareLink;
    if (string.IsNullOrWhiteSpace(shareLink))
    {
        shareLink = Url.Action("Guest", "MeetingRoom", null, Context.Request.Scheme) ?? "/MeetingRoom/Guest";
    }
}

@section Styles {
    <style>
        :root {
            --mr-ink: #eff6ff;
            --mr-muted: rgba(239,246,255,.68);
            --mr-panel: rgba(22,31,67,.94);
            --mr-panel-2: rgba(36,48,92,.94);
            --mr-line: rgba(190,207,255,.18);
            --mr-teal: #19d3b2;
            --mr-blue: #60a5fa;
            --mr-yellow: #f8d85d;
            --mr-red: #ff4b6b;
            --mr-map-bg: #efe6d8;
            --mr-floor-line: rgba(232,184,137,.42);
            --mr-floor-mark: rgba(238,196,155,.34);
        }

        .meeting-room {
            --mr-safe-top: env(safe-area-inset-top, 0px);
            --mr-safe-right: env(safe-area-inset-right, 0px);
            --mr-safe-bottom: env(safe-area-inset-bottom, 0px);
            --mr-safe-left: env(safe-area-inset-left, 0px);
            --mr-dock-bottom: 18px;
            --mr-map-tools-bottom: 18px;
            position: relative;
            width: 100%;
            height: 100%;
            min-height: 0;
            max-height: 100%;
            display: grid;
            grid-template-rows: auto minmax(0, 1fr);
            gap: 8px;
            padding: 10px;
            box-sizing: border-box;
            overflow: hidden;
            color: var(--mr-ink);
            font-family: var(--pt-font-family, Inter, "Segoe UI", sans-serif);
            background:
                linear-gradient(180deg, rgba(7,18,39,.98), rgba(11,23,48,.96) 58%, rgba(8,20,42,.98)),
                #0b1730;
        }

        #meetingRoomAntiForgery {
            display: none !important;
        }

        .mr-topbar {
            position: relative;
            z-index: 20;
            min-height: 52px;
            display: grid;
            grid-template-columns: minmax(300px, 1fr) auto minmax(420px, auto);
            align-items: center;
            gap: 10px;
            padding: 7px 10px;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 18px;
            background: rgba(12,21,45,.84);
            box-shadow: 0 18px 54px rgba(0,0,0,.24);
            backdrop-filter: blur(18px);
        }

        .mr-title {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .mr-logo {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,.15);
            background: linear-gradient(135deg, rgba(25,211,178,.9), rgba(96,165,250,.82));
            color: #061728;
            font-weight: 900;
            letter-spacing: 0;
        }

        .mr-title h1 {
            margin: 0;
            font-size: 18px;
            line-height: 1.15;
            font-weight: 850;
            letter-spacing: 0;
            color: #fff;
        }

        .mr-title p {
            margin: 1px 0 0;
            color: var(--mr-muted);
            font-size: 11px;
            line-height: 1.25;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .mr-stats {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-width: 0;
            flex-wrap: nowrap;
        }

        .mr-stat {
            min-width: 0;
            min-height: 34px;
            display: inline-flex;
            align-items: baseline;
            justify-content: center;
            gap: 5px;
            padding: 0 10px;
            border: 1px solid rgba(255,255,255,.11);
            border-radius: 12px;
            background: rgba(255,255,255,.08);
            white-space: nowrap;
        }

        .mr-stat strong,
        .mr-stat span {
            display: inline;
            line-height: 1.1;
        }

        .mr-stat strong {
            font-size: 15px;
            color: #fff;
        }

        .mr-stat span {
            font-size: 10px;
            color: var(--mr-muted);
        }

        .mr-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 6px;
            min-width: 0;
            flex-wrap: nowrap;
        }

        .meeting-room :is(.mr-popover, .mr-customize-panel, .mr-meeting-panel) :is(input:not([type="checkbox"]):not([type="radio"]):not([type="file"]), textarea, select),
        .meeting-room :is(.mr-name-input, .mr-status-input, .mr-message-input) {
            color: #f8fafc !important;
            caret-color: #f8fafc !important;
            -webkit-text-fill-color: #f8fafc !important;
        }

        .meeting-room :is(.mr-popover, .mr-customize-panel, .mr-meeting-panel) :is(input:not([type="checkbox"]):not([type="radio"]):not([type="file"]), textarea, select)::placeholder,
        .meeting-room :is(.mr-name-input, .mr-status-input, .mr-message-input)::placeholder {
            color: rgba(226,232,240,.62) !important;
            -webkit-text-fill-color: rgba(226,232,240,.62) !important;
        }

        .meeting-room :is(.mr-popover, .mr-customize-panel, .mr-meeting-panel) :is(input:not([type="checkbox"]):not([type="radio"]):not([type="file"]), textarea, select):focus,
        .meeting-room :is(.mr-name-input, .mr-status-input, .mr-message-input):focus {
            border-color: rgba(25,211,178,.46);
            box-shadow: 0 0 0 3px rgba(25,211,178,.14);
        }

        .mr-icon-btn,
        .mr-text-btn {
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 1px solid rgba(255,255,255,.13);
            border-radius: 12px;
            color: #fff;
            background: rgba(255,255,255,.1);
            text-decoration: none;
            cursor: pointer;
            transition: transform .16s ease, background .16s ease, border-color .16s ease;
        }

        .mr-icon-btn {
            width: 36px;
            font-size: 16px;
        }

        .mr-text-btn {
            padding: 0 12px;
            font-weight: 750;
            font-size: 12px;
            white-space: nowrap;
        }

        .mr-icon-btn:hover,
        .mr-text-btn:hover {
            transform: translateY(-1px);
            border-color: rgba(255,255,255,.25);
            background: rgba(255,255,255,.16);
            color: #fff;
        }

        .mr-icon-btn:disabled {
            opacity: .42;
            cursor: default;
            transform: none;
        }

        .mr-btn-svg {
            width: 18px;
            height: 18px;
            display: block;
            fill: none;
            stroke: currentColor;
            stroke-width: 2.2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .mr-tooltip-btn {
            position: relative;
        }

        .mr-tooltip-btn::before,
        .mr-tooltip-btn::after {
            position: absolute;
            left: 50%;
            bottom: -10px;
            transform: translate(-50%, 100%);
            opacity: 0;
            pointer-events: none;
            transition: opacity .14s ease, transform .14s ease;
        }

        .mr-tooltip-btn::before {
            content: "";
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-bottom: 8px solid rgba(14,14,16,.96);
            transform: translate(-50%, 4px);
        }

        .mr-tooltip-btn::after {
            content: attr(data-tooltip);
            min-width: max-content;
            padding: 8px 12px;
            border-radius: 12px;
            color: #fff;
            background: rgba(14,14,16,.96);
            font-size: 13px;
            font-weight: 760;
            box-shadow: 0 10px 28px rgba(0,0,0,.26);
        }

        .mr-tooltip-btn:hover::before,
        .mr-tooltip-btn:hover::after,
        .mr-tooltip-btn:focus-visible::before,
        .mr-tooltip-btn:focus-visible::after {
            opacity: 1;
        }

        .mr-stage-shell {
            position: relative;
            min-height: 0;
            height: 100%;
            display: grid;
            grid-template-columns: minmax(0, 1fr) 390px;
            gap: 14px;
            padding: 0;
            overflow: hidden;
            transition: grid-template-columns .2s ease;
        }

        .meeting-room.is-right-panel-collapsed .mr-stage-shell {
            grid-template-columns: minmax(0, 1fr) 54px;
        }

        .mr-map {
            position: relative;
            min-width: 0;
            min-height: 0;
            overflow: hidden;
            cursor: crosshair;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 22px;
            background: var(--mr-map-bg);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.05), 0 24px 70px rgba(0,0,0,.28);
        }

        .mr-map.is-pannable {
            cursor: grab;
        }

        .mr-map.is-panning {
            cursor: grabbing;
        }

        .meeting-room[data-guest="true"] .mr-map {
            cursor: default;
        }

        .meeting-room[data-guest="true"] .mr-map.is-pannable {
            cursor: grab;
        }

        .meeting-room[data-guest="true"] .mr-map.is-panning {
            cursor: grabbing;
        }

        .mr-map-world {
            position: absolute;
            inset: 0;
            min-width: 100%;
            min-height: 100%;
            transform: translate(var(--mr-pan-x, 0px), var(--mr-pan-y, 0px)) scale(var(--mr-zoom, 1));
            transform-origin: 50% 50%;
            transition: transform .18s ease;
            background:
                linear-gradient(90deg, transparent 0 36px, var(--mr-floor-mark) 36px 37px, transparent 37px 74px) 0 0 / 148px 32px repeat,
                linear-gradient(90deg, transparent 0 72px, var(--mr-floor-mark) 72px 73px, transparent 73px 148px) 0 16px / 148px 32px repeat,
                repeating-linear-gradient(0deg, var(--mr-map-bg) 0 14px, var(--mr-floor-line) 14px 15px, var(--mr-map-bg) 15px 31px, rgba(238,196,155,.28) 31px 32px);
            will-change: transform;
        }

        .mr-map.is-panning .mr-map-world {
            transition: none;
        }

        .mr-game-layer {
            position: absolute;
            inset: 0;
            z-index: 1;
            overflow: hidden;
            pointer-events: none;
        }

        .mr-game-layer canvas {
            width: 100% !important;
            height: 100% !important;
            display: block;
            image-rendering: pixelated;
        }

        .mr-map-world::before,
        .mr-map-world::after {
            content: "";
            position: absolute;
            display: none;
            pointer-events: none;
        }

        .mr-map-world::before {
            inset: 3% 2% 8% 2%;
            border-radius: 20px;
            background:
                linear-gradient(90deg, transparent 0 19%, rgba(74,89,99,.8) 19% 20.6%, transparent 20.6% 100%),
                linear-gradient(90deg, transparent 0 61%, rgba(74,89,99,.72) 61% 62.4%, transparent 62.4% 100%),
                linear-gradient(0deg, transparent 0 35%, rgba(74,89,99,.75) 35% 36.6%, transparent 36.6% 100%),
                linear-gradient(0deg, transparent 0 67%, rgba(74,89,99,.75) 67% 68.6%, transparent 68.6% 100%);
            opacity: .62;
        }

        .mr-map-world::after {
            left: 2%;
            right: 2%;
            bottom: 4%;
            height: 8%;
            border-radius: 22px;
            background:
                repeating-linear-gradient(90deg, rgba(59,75,83,.7) 0 22px, rgba(47,61,68,.8) 22px 44px);
            opacity: .48;
        }

        .mr-zone {
            position: absolute;
            left: calc(var(--x) * 1%);
            top: calc(var(--y) * 1%);
            width: calc(var(--w) * 1%);
            height: calc(var(--h) * 1%);
            z-index: 2;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 14px;
            border-radius: 18px;
            border: 2px solid rgba(255,255,255,.18);
            color: rgba(255,255,255,.95);
            text-decoration: none;
            background: rgba(18,31,58,.26);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
            backdrop-filter: blur(1px);
        }

        .mr-zone:hover {
            color: #fff;
            border-color: rgba(255,255,255,.38);
            background: rgba(18,31,58,.36);
        }

        .mr-zone-title {
            font-weight: 850;
            font-size: 14px;
            line-height: 1.15;
        }

        .mr-zone-subtitle {
            margin-top: 3px;
            display: block;
            color: rgba(255,255,255,.64);
            font-size: 11px;
            line-height: 1.2;
        }

        .mr-zone-count {
            align-self: flex-start;
            min-width: 31px;
            height: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 9px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 850;
            color: #061728;
            background: rgba(255,255,255,.88);
        }

        .mr-zone.tone-blue { background-color: rgba(37,99,235,.22); }
        .mr-zone.tone-teal { background-color: rgba(20,184,166,.22); }
        .mr-zone.tone-violet { background-color: rgba(124,58,237,.2); }
        .mr-zone.tone-rose { background-color: rgba(244,63,94,.2); }
        .mr-zone.tone-orange { background-color: rgba(249,115,22,.2); }
        .mr-zone.tone-green { background-color: rgba(34,197,94,.2); }
        .mr-zone.tone-cyan { background-color: rgba(6,182,212,.2); }

        .mr-area-shape,
        .mr-area-draft {
            position: absolute;
            left: calc(var(--x) * 1%);
            top: calc(var(--y) * 1%);
            width: calc(var(--w) * 1%);
            height: calc(var(--h) * 1%);
            z-index: 3;
            border: 2px solid rgba(255,255,255,.28);
            border-radius: 10px;
            background: rgba(20,184,166,.13);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);
        }

        .mr-area-shape {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
            padding: 7px 8px;
            color: rgba(255,255,255,.82);
            text-align: left;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
            -webkit-user-select: none;
            user-select: none;
        }

        .mr-area-title,
        .mr-area-owner {
            display: inline-flex;
            max-width: 100%;
            padding: 3px 7px;
            border-radius: 999px;
            background: rgba(7,18,39,.68);
            font-size: 10px;
            font-weight: 850;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            -webkit-user-select: none;
            user-select: none;
            pointer-events: none;
        }

        .mr-area-owner {
            color: #052018;
            background: rgba(25,211,178,.92);
            font-size: 9px;
            font-weight: 900;
        }

        .mr-area-shape:hover,
        .mr-area-shape.is-selected {
            border-color: rgba(255,255,255,.68);
            background: rgba(96,165,250,.18);
        }

        .mr-area-shape.is-owned:not(.is-current-desk) {
            border-color: rgba(25,211,178,.68);
            background: rgba(25,211,178,.13);
        }

        .mr-area-shape.is-current-desk {
            border-color: rgba(25,211,178,.95);
            background: rgba(25,211,178,.16);
            box-shadow:
                0 0 0 1px rgba(25,211,178,.24),
                0 14px 34px rgba(25,211,178,.18),
                inset 0 0 0 1px rgba(255,255,255,.12);
        }

        .mr-area-shape.is-current-desk::after {
            content: "My room";
            position: absolute;
            right: 8px;
            bottom: 7px;
            display: inline-flex;
            align-items: center;
            min-height: 20px;
            padding: 3px 8px;
            border-radius: 999px;
            color: #032016;
            background: rgba(25,211,178,.96);
            font-size: 10px;
            font-weight: 900;
            line-height: 1;
            box-shadow: 0 8px 18px rgba(0,0,0,.18);
            pointer-events: none;
        }

        .mr-area-draft {
            z-index: 7;
            border-style: dashed;
            border-color: rgba(255,255,255,.74);
            background: rgba(96,165,250,.18);
            pointer-events: none;
        }

        .mr-area-shape.tone-blue,
        .mr-area-draft.tone-blue { background-color: rgba(37,99,235,.16); border-color: rgba(96,165,250,.48); }
        .mr-area-shape.tone-teal,
        .mr-area-draft.tone-teal { background-color: rgba(20,184,166,.16); border-color: rgba(45,212,191,.48); }
        .mr-area-shape.tone-violet,
        .mr-area-draft.tone-violet { background-color: rgba(124,58,237,.15); border-color: rgba(167,139,250,.48); }
        .mr-area-shape.tone-rose,
        .mr-area-draft.tone-rose { background-color: rgba(244,63,94,.15); border-color: rgba(251,113,133,.48); }
        .mr-area-shape.tone-orange,
        .mr-area-draft.tone-orange { background-color: rgba(249,115,22,.16); border-color: rgba(251,146,60,.48); }
        .mr-area-shape.tone-green,
        .mr-area-draft.tone-green { background-color: rgba(34,197,94,.15); border-color: rgba(74,222,128,.48); }
        .mr-area-shape.tone-cyan,
        .mr-area-draft.tone-cyan { background-color: rgba(6,182,212,.15); border-color: rgba(34,211,238,.48); }

        .mr-room-object,
        .mr-object-draft {
            position: absolute;
            left: calc(var(--x) * 1%);
            top: calc(var(--y) * 1%);
            width: calc(var(--w) * 1%);
            height: calc(var(--h) * 1%);
            z-index: 6;
            display: grid;
            place-items: center;
            border: 0;
            padding: 0;
            background: transparent;
            transform: rotate(var(--rotation, 0deg));
            transform-origin: center;
            image-rendering: pixelated;
        }

        .mr-room-object {
            pointer-events: none;
        }

        .meeting-room.is-customizing .mr-room-object {
            pointer-events: auto;
            cursor: pointer;
        }

        .mr-room-object:hover,
        .mr-room-object.is-selected {
            filter: drop-shadow(0 0 0 rgba(0,0,0,0)) drop-shadow(0 0 10px rgba(96,165,250,.75));
        }

        .mr-object-draft {
            z-index: 8;
            opacity: .78;
            pointer-events: none;
            filter: drop-shadow(0 0 12px rgba(45,212,191,.55));
        }

        .mr-object-pixel {
            position: relative;
            display: block;
            width: 88%;
            height: 80%;
            border-radius: 4px;
            background: #bf7b4f;
            box-shadow:
                inset 0 4px 0 rgba(255,255,255,.16),
                inset 0 -7px 0 rgba(69,45,33,.34),
                0 7px 0 rgba(7,12,18,.22),
                0 14px 18px rgba(7,12,18,.16);
        }

        .mr-object-pixel::before,
        .mr-object-pixel::after {
            content: "";
            position: absolute;
            pointer-events: none;
        }

        .mr-object-pixel::before {
            left: 8%;
            top: 9%;
            width: 42%;
            height: 12%;
            border-radius: inherit;
            background: rgba(255,255,255,.22);
            mix-blend-mode: screen;
        }

        .mr-object-pixel::after {
            left: 10%;
            right: 10%;
            bottom: -9px;
            height: 10px;
            border-radius: 50%;
            background: rgba(7,12,18,.24);
            transform: skewX(-22deg);
            z-index: -1;
        }

        .object-desk-basic .mr-object-pixel {
            width: 92%;
            height: 58%;
            border: 3px solid #3f2c24;
            border-radius: 3px;
            background:
                linear-gradient(90deg, transparent 0 12%, rgba(255,255,255,.16) 12% 15%, transparent 15% 100%),
                linear-gradient(180deg, #cc8250, #ad6640);
            box-shadow:
                inset 0 -7px 0 rgba(58,37,30,.3),
                -2px 9px 0 -3px #493229,
                2px 9px 0 -3px #493229,
                0 8px 0 rgba(7,12,18,.2);
        }

        .object-chair-office .mr-object-pixel {
            width: 54%;
            height: 78%;
            border: 3px solid #253142;
            border-radius: 5px;
            background:
                linear-gradient(180deg, #5fb3ff 0 42%, #3669d8 42% 100%);
            box-shadow:
                0 12px 0 -6px #1f2937,
                -10px 11px 0 -7px #64748b,
                10px 11px 0 -7px #64748b,
                inset 0 -5px 0 rgba(15,23,42,.24);
        }

        .object-sofa-blue .mr-object-pixel {
            width: 94%;
            height: 70%;
            border: 3px solid #253142;
            border-radius: 10px 10px 5px 5px;
            background:
                linear-gradient(90deg, rgba(255,255,255,.2) 0 48%, transparent 48% 52%, rgba(255,255,255,.16) 52% 100%),
                linear-gradient(180deg, #67a6ff, #386bd8);
            box-shadow:
                -7px 8px 0 -4px #253142,
                7px 8px 0 -4px #253142,
                inset 0 -10px 0 rgba(22,45,115,.4);
        }

        .object-table-round .mr-object-pixel {
            width: min(80%, 90px);
            height: 82%;
            border: 3px solid #3f2c24;
            border-radius: 50%;
            background:
                radial-gradient(circle at 35% 28%, rgba(255,255,255,.22), transparent 32%),
                #c98555;
            box-shadow:
                inset 0 -8px 0 rgba(81,54,39,.22),
                0 7px 0 rgba(7,12,18,.22);
        }

        .object-plant-pot .mr-object-pixel {
            width: 54%;
            height: 82%;
            border-radius: 4px 4px 9px 9px;
            background:
                radial-gradient(circle at 50% 12%, #31c66b 0 18%, transparent 19%),
                radial-gradient(circle at 32% 22%, #65db87 0 17%, transparent 18%),
                radial-gradient(circle at 66% 24%, #239b55 0 18%, transparent 19%),
                linear-gradient(180deg, transparent 0 44%, #c17a47 44% 100%);
            box-shadow:
                0 0 0 3px rgba(18,29,39,.9),
                inset 0 -5px 0 rgba(65,42,28,.25);
        }

        .object-plant-tall .mr-object-pixel {
            width: 46%;
            height: 96%;
            border-radius: 18px 18px 7px 7px;
            background:
                radial-gradient(circle at 48% 10%, #4ade80 0 16%, transparent 17%),
                radial-gradient(circle at 31% 22%, #22c55e 0 18%, transparent 19%),
                radial-gradient(circle at 66% 24%, #15803d 0 18%, transparent 19%),
                radial-gradient(circle at 48% 35%, #86efac 0 13%, transparent 14%),
                linear-gradient(90deg, transparent 0 42%, #8b5a35 42% 58%, transparent 58% 100%),
                linear-gradient(180deg, transparent 0 66%, #c47a45 66% 100%);
            box-shadow:
                0 0 0 3px rgba(18,29,39,.9),
                inset 0 -6px 0 rgba(65,42,28,.25);

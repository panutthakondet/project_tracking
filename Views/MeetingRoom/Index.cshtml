                    Object.assign(person, avatar);
                }

                root.querySelectorAll(`.mr-person[data-user-id="${userId}"]`).forEach(marker => {
                    applyAvatarToElement(marker, avatar);
                });
            }

            function setNameBadgeImage(marker, imagePath) {
                const badge = marker?.querySelector?.('.mr-name-badge');
                if (!badge || !imagePath) return;

                let image = badge.querySelector('img');
                if (!image) {
                    badge.replaceChildren();
                    image = document.createElement('img');
                    image.alt = '';
                    image.onerror = () => {
                        image.onerror = null;
                        image.src = '/images/Profile/profile.png';
                    };
                    badge.appendChild(image);
                }

                image.src = imagePath;
            }

            function renderAvatarTabs() {
                const tabs = document.getElementById('avatarTabs');
                if (!tabs) return;

                tabs.replaceChildren();
                avatarCategories.forEach(category => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = `mr-avatar-tab${category.key === avatarActiveCategory ? ' is-active' : ''}`;
                    button.dataset.avatarCategory = category.key;

                    const icon = document.createElement('span');
                    icon.className = 'mr-avatar-tab-icon';
                    const iconMini = document.createElement('span');
                    iconMini.className = `mr-avatar-tab-mini is-${category.key}`;
                    let iconAvatar = normalizeAvatar(avatarDraft || peopleById.get(currentUserId) || {});
                    if (category.field) {
                        const currentValue = iconAvatar[category.field];
                        const fallback = category.options.find(option => option.value === currentValue) ||
                            category.options.find(option => option.value !== 'none') ||
                            category.options[0];
                        if (fallback) {
                            iconAvatar = avatarForOption(category, fallback);
                        }
                    }
                    const iconCharacter = createAvatarCharacterNode();
                    applyAvatarToElement(iconCharacter, iconAvatar);
                    iconMini.appendChild(iconCharacter);
                    icon.appendChild(iconMini);

                    const label = document.createElement('span');
                    label.textContent = category.label;

                    button.append(icon, label);
                    tabs.appendChild(button);
                });
            }

            function createAvatarCharacterNode() {
                const character = document.createElement('span');
                character.className = 'mr-character character-human';
                [
                    'mr-pixel-hair',
                    'mr-pixel-head',
                    'mr-pixel-face',
                    'mr-pixel-facial-hair',
                    'mr-pixel-glasses',
                    'mr-pixel-hat',
                    'mr-pixel-other',
                    'mr-pixel-body',
                    'mr-pixel-jacket',
                    'mr-pixel-arm',
                    'mr-pixel-arm two',
                    'mr-pixel-leg one',
                    'mr-pixel-leg two',
                    'mr-pixel-shoe one',
                    'mr-pixel-shoe two'
                ].forEach(className => {
                    const part = document.createElement('span');
                    part.className = className;
                    character.appendChild(part);
                });

                const bubble = document.createElement('span');
                bubble.className = 'mr-speaking-bubble';
                bubble.setAttribute('aria-hidden', 'true');
                bubble.appendChild(document.createElement('span'));
                character.appendChild(bubble);

                return character;
            }

            function avatarForOption(category, option) {
                const avatar = normalizeAvatar(avatarDraft);
                if (category.field) {
                    avatar[category.field] = option.value;
                }
                if (category.key === 'skin') {
                    avatar.skinTone = option.value;
                    avatar.hairStyle = 'bald';
                    avatar.facialHairStyle = 'none';
                    avatar.hatStyle = 'none';
                    avatar.glassesStyle = 'none';
                    avatar.otherStyle = 'none';
                }
                if (category.key === 'hair') {
                    avatar.hatStyle = 'none';
                    avatar.glassesStyle = 'none';
                    avatar.facialHairStyle = 'none';
                    avatar.otherStyle = 'none';
                }
                if (category.key === 'facial') {
                    avatar.hairStyle = avatar.hairStyle === 'bald' ? 'short' : avatar.hairStyle;
                    avatar.hatStyle = 'none';
                    avatar.glassesStyle = 'none';
                    avatar.otherStyle = 'none';
                }
                if (category.key === 'top') {
                    avatar.jacketStyle = avatar.jacketStyle || 'none';
                    avatar.hatStyle = 'none';
                    avatar.glassesStyle = 'none';
                    avatar.otherStyle = 'none';
                }
                if (category.key === 'jacket' && option.value !== 'none') {
                    avatar.topStyle = avatar.topStyle || 'shirt';
                    avatar.hatStyle = 'none';
                    avatar.glassesStyle = 'none';
                    avatar.otherStyle = 'none';
                }
                if (category.key === 'hat' && option.value !== 'none' && avatar.hairStyle === 'bald') {
                    avatar.hairStyle = 'short';
                }
                if (category.key === 'hat') {
                    avatar.glassesStyle = 'none';
                    avatar.facialHairStyle = 'none';
                    avatar.otherStyle = 'none';
                }
                if (category.key === 'glasses' && option.value !== 'none') {
                    avatar.hatStyle = 'none';
                    avatar.facialHairStyle = 'none';
                    avatar.otherStyle = 'none';
                    avatar.hairStyle = avatar.hairStyle === 'bald' ? 'short' : avatar.hairStyle;
                }
                if (category.key === 'other') {
                    avatar.hairStyle = avatar.hairStyle === 'bald' ? 'short' : avatar.hairStyle;
                    avatar.facialHairStyle = 'none';
                    avatar.hatStyle = 'none';
                    avatar.glassesStyle = 'none';
                    avatar.topStyle = 'shirt';
                    avatar.jacketStyle = 'none';
                    avatar.bottomStyle = 'pants';
                }
                return avatar;
            }

            function renderAvatarOptionMini(category, option) {
                const mini = document.createElement('span');
                mini.className = `mr-avatar-mini is-${category.key}`;
                mini.dataset.preview = option.value;

                const character = createAvatarCharacterNode();
                applyAvatarToElement(character, avatarForOption(category, option));
                mini.appendChild(character);

                return mini;
            }

            function renderAvatarOptions() {
                const category = avatarCategories.find(item => item.key === avatarActiveCategory) || avatarCategories[0];
                const grid = document.getElementById('avatarOptionGrid');
                if (!grid || !avatarDraft) return;

                grid.replaceChildren();
                category.options.forEach(option => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'mr-avatar-option-card';
                    button.dataset.avatarOption = option.value;
                    if (!category.field || avatarDraft[category.field] === option.value) {
                        button.classList.add('is-active');
                    }
                    button.title = option.label;
                    button.appendChild(renderAvatarOptionMini(category, option));
                    grid.appendChild(button);
                });

                renderAvatarPalette(category);
            }

            function renderAvatarPalette(category) {
                const palette = document.getElementById('avatarColorPalette');
                if (!palette || !avatarDraft) return;

                palette.replaceChildren();
                if (!category.colorField) {
                    const empty = document.createElement('span');
                    empty.className = 'mr-meeting-empty';
                    empty.textContent = 'No color option for this category';
                    palette.appendChild(empty);
                    return;
                }

                (category.palette || avatarColorPalettes.clothes).forEach(color => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = `mr-avatar-swatch${avatarDraft[category.colorField] === color ? ' is-active' : ''}`;
                    button.dataset.avatarColorField = category.colorField;
                    button.dataset.avatarColorValue = color;
                    button.style.setProperty('--swatch', color);
                    button.title = color;
                    palette.appendChild(button);
                });

                </svg>
            </button>
        </div>

        <button class="mr-dock-btn mr-auth-only is-off" type="button" id="shareScreen" title="Screen share off" aria-label="Screen share off">
            <svg class="mr-btn-svg" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="4" y="5" width="16" height="11" rx="2"></rect>
                <path d="M12 16v4"></path>
                <path d="M8 20h8"></path>
                <path d="m9 11 3-3 3 3"></path>
                <path d="M12 8v6"></path>
            </svg>
        </button>
        <button class="mr-dock-btn mr-auth-only" type="button" id="shareMeetingFile" title="Share file" aria-label="Share file">
            <svg class="mr-btn-svg" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 2v6h6"></path>

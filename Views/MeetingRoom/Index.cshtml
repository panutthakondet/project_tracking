            background: rgba(239,68,68,.1);
        }

        .mr-dock-btn.leave:hover,
        .mr-dock-btn.leave:focus-visible {
            color: #fecaca;
            background: rgba(239,68,68,.18);
        }

        .mr-dock-btn.is-active {
            color: #10233f;
            background: var(--mr-teal);
        }

        .meeting-room[data-guest="true"] .mr-control-dock .mr-auth-only {
            display: none !important;
        }

        .mr-person.is-pulse .mr-character {
            animation: mrPulse 1s ease-in-out 3;
        }

        .mr-person.is-waving .mr-character {
            animation: mrWaveCharacter .52s ease-in-out 3;
        }

        .mr-person.is-waving::after {
            content: "Wave";
            position: absolute;
            left: 50%;
            top: 12px;
            transform: translate(-50%, -100%);
            padding: 5px 9px;
            border: 2px solid rgba(255,255,255,.92);
            border-radius: 999px;
            color: #071421;
            background: #ffffff;
            font-size: 11px;
            font-weight: 950;
            line-height: 1;
            box-shadow: 0 12px 22px rgba(0,0,0,.22);
            pointer-events: none;
            animation: mrWaveBadge 1.45s ease both;
        }

        @@keyframes mrPulse {
            0%, 100% { box-shadow: 0 0 0 3px rgba(255,255,255,.18), 0 10px 18px rgba(0,0,0,.22); }
            50% { box-shadow: 0 0 0 10px rgba(25,211,178,.34), 0 16px 28px rgba(0,0,0,.24); }
        }

        @@keyframes mrWaveCharacter {
            0%, 100% { transform: scaleX(var(--avatar-dir, 1)) scale(var(--avatar-scale)) rotate(0deg); }
            35% { transform: scaleX(var(--avatar-dir, 1)) scale(var(--avatar-scale)) rotate(-5deg) translateY(-3px); }
            70% { transform: scaleX(var(--avatar-dir, 1)) scale(var(--avatar-scale)) rotate(5deg) translateY(-2px); }
        }

        @@keyframes mrWaveBadge {
            0% { opacity: 0; transform: translate(-50%, -86%) scale(.86); }
            14%, 78% { opacity: 1; transform: translate(-50%, -112%) scale(1); }
            100% { opacity: 0; transform: translate(-50%, -132%) scale(.92); }
        }

        @@keyframes mrWalkBody {
            0%, 100% { transform: scaleX(var(--avatar-dir, 1)) scale(var(--avatar-scale)) translateY(0); }
            50% { transform: scaleX(var(--avatar-dir, 1)) scale(var(--avatar-scale)) translateY(-4px); }
        }

        @@keyframes mrWalkArm {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(5px); }
        }

        @@keyframes mrWalkLegOne {
            0%, 100% { transform: translateX(-3px); }
            50% { transform: translateX(3px); }
        }

        @@keyframes mrWalkLegTwo {
            0%, 100% { transform: translateX(3px); }
            50% { transform: translateX(-3px); }
        }

        @@keyframes mrTalkMouth {
            0%, 100% {
                height: 2px;
                transform: translateY(0);
            }
            50% {
                height: 6px;
                transform: translateY(-1px);
            }
        }

        @@keyframes mrSpeechBubble {
            0%, 100% { transform: translate(0, -4px) scale(1); }
            50% { transform: translate(0, -7px) scale(1.03); }
        }

        @@keyframes mrSpeakingDots {
            0% {
                opacity: .35;
                box-shadow: 7px 0 0 rgba(11,15,22,.35), 14px 0 0 rgba(11,15,22,.35);
            }
            34% {
                opacity: 1;
                box-shadow: 7px 0 0 rgba(11,15,22,.35), 14px 0 0 rgba(11,15,22,.35);
            }
            67% {
                opacity: 1;
                box-shadow: 7px 0 0 #0b0f16, 14px 0 0 rgba(11,15,22,.35);
            }
            100% {
                opacity: 1;
                box-shadow: 7px 0 0 #0b0f16, 14px 0 0 #0b0f16;
            }
        }


        .mr-character-option[data-character="jaian"] .mr-character-chip { background: linear-gradient(90deg, transparent 0 7px, #1f1714 7px 15px, transparent 15px), linear-gradient(180deg, #1f1714 0 25%, #f7c891 25% 52%, #f97316 52% 80%, #2f3749 80% 100%); }
        .mr-character-option[data-character="dorami"] .mr-character-chip { border-radius: 13px; background: radial-gradient(circle at 50% 38%, #fff 0 34%, transparent 35%), linear-gradient(180deg, #ffd84d 0 68%, #c98500 68% 100%); }

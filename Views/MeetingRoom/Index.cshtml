            background: rgba(255,255,255,.12);
        }

        .mr-object-palette {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 7px;
            max-height: 260px;
            overflow: auto;
            padding-right: 2px;
        }

        .mr-object-option {
            min-height: 56px;
            display: grid;
            place-items: center;
            gap: 4px;
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 12px;
            padding: 6px;
            color: #fff;
            background: rgba(255,255,255,.07);
            font-size: 9px;
            font-weight: 800;
            cursor: grab;
            touch-action: none;
            user-select: none;
        }

        .mr-object-option:hover,
        .mr-object-option.is-active {
            border-color: rgba(45,212,191,.58);
            background: rgba(45,212,191,.14);
        }

        .mr-object-option:active,
        .meeting-room.is-object-dragging .mr-object-option.is-active {
            cursor: grabbing;
        }

        .mr-object-option .mr-object-pixel {
            width: 44px;
            height: 28px;
            transform: none;
        }

        .mr-object-option small {
            color: rgba(239,246,255,.5);
            font-size: 8px;
            font-weight: 800;
            line-height: 1;
        }

        .mr-object-list {
            display: grid;
            gap: 6px;
            max-height: 112px;
            overflow: auto;
        }

        .mr-object-item {
            min-height: 38px;
            display: grid;
            grid-template-columns: 24px minmax(0, 1fr);
            align-items: center;
            gap: 8px;
            border: 1px solid rgba(255,255,255,.09);
            border-radius: 12px;
            padding: 7px;
            color: #fff;
            background: rgba(255,255,255,.07);
            text-align: left;
            cursor: pointer;
        }

        .mr-object-item:hover,
        .mr-object-item.is-active {
            border-color: rgba(255,255,255,.24);
            background: rgba(255,255,255,.13);
        }

        .mr-object-mini {
            width: 24px;
            height: 20px;
            display: grid;
            place-items: center;
        }

        .mr-object-mini .mr-object-pixel {
            width: 22px;
            height: 16px;
        }

        .mr-object-item strong,
        .mr-object-item small {
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .mr-object-item strong {
            font-size: 11px;
            font-weight: 850;
        }

        .mr-object-item small {
            margin-top: 1px;
            color: var(--mr-muted);
            font-size: 9px;
        }

        .mr-area-form {
            display: grid;
            gap: 9px;
            border-top: 1px solid rgba(255,255,255,.12);
            padding-top: 10px;
        }

        .mr-area-form label {
            display: grid;
            gap: 5px;
            color: var(--mr-muted);
            font-size: 10px;
            font-weight: 750;
        }

        .mr-area-form input,
        .mr-area-form select {
            min-width: 0;
            height: 34px;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 10px;
            padding: 0 10px;
            color: #fff;
            background: rgba(255,255,255,.08);
            outline: none;
        }

        .mr-area-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .mr-area-form-grid.four {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .mr-area-actions {
            display: grid;
            grid-template-columns: 1fr auto auto;
            gap: 7px;
        }

        .mr-object-obstacle {
            display: flex !important;
            grid-column: 1 / -1;
            align-items: center;
            gap: 8px;
        }

        .mr-object-obstacle input {
            width: 16px;
            height: 16px;
            min-width: 16px;
        }

        .mr-rotate-control {
            display: grid !important;
            gap: 5px;
        }

        .mr-rotate-row {
            display: grid;
            grid-template-columns: 34px minmax(0, 1fr) 34px;
            gap: 5px;
        }

        .mr-rotate-btn {
            width: 34px;
            height: 34px;
            display: inline-grid;
            place-items: center;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 10px;
            color: #fff;
            background: rgba(255,255,255,.09);
            font-size: 16px;
            font-weight: 850;
            cursor: pointer;
        }

        .mr-rotate-btn:hover {
            background: rgba(255,255,255,.16);
        }

        .mr-self-panel .mr-popover-inner {
            padding: 10px;
        }

        .mr-self-panel .mr-profile-head {
            grid-template-columns: 42px minmax(0, 1fr) 28px;
            gap: 9px;
        }

        .mr-self-panel .mr-profile-photo {
            width: 42px;
            height: 42px;
            border-radius: 13px;
        }

        .mr-self-panel .mr-profile-status {
            width: 11px;
            height: 11px;
            border-width: 2px;
        }

        .mr-self-panel .mr-profile-name h2 {
            font-size: 13px;
            line-height: 1.15;
        }

        .mr-self-panel .mr-profile-name p,
        .mr-self-panel .mr-profile-meta {
            font-size: 10px;
            line-height: 1.25;
        }

        .mr-self-panel .mr-close {
            width: 28px;
            height: 28px;
            border-radius: 10px;
        }

        .mr-self-panel .mr-status-input {
            height: 38px;
            margin: 10px 0 7px;
            border-radius: 12px;
            padding: 0 12px;
            font-size: 12px;
        }

        .mr-self-panel .mr-divider {
            margin: 8px 0;
        }

        .mr-name-editor {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 58px;
            gap: 6px;
            margin: 10px 0 7px;
        }

        .mr-name-input {
            min-width: 0;
            height: 38px;
            border: 1px solid rgba(255,255,255,.17);
            border-radius: 12px;
            padding: 0 12px;
            color: #fff;
            background: rgba(255,255,255,.08);
            font-size: 12px;
            outline: none;
        }

        .mr-name-save {
            height: 38px;
            border: 0;
            border-radius: 12px;
            color: #061728;
            background: var(--mr-teal);
            font-size: 12px;
            font-weight: 850;
            cursor: pointer;
        }

        .mr-status-list {
            display: grid;
            gap: 8px;
        }

        .mr-status-option {
            width: 100%;
            min-height: 54px;
            display: grid;
            grid-template-columns: 22px minmax(0, 1fr) auto;
            align-items: center;
            gap: 12px;
            border: 0;
            border-radius: 16px;
            padding: 10px 12px;
            color: #fff;
            background: rgba(255,255,255,.07);
            text-align: left;
            cursor: pointer;
        }

        .mr-self-panel .mr-status-list {
            gap: 5px;
        }

        .mr-self-panel .mr-status-option {
            min-height: 38px;
            grid-template-columns: 16px minmax(0, 1fr) auto;
            gap: 8px;
            border-radius: 12px;
            padding: 7px 9px;
        }

        .mr-self-panel .mr-status-mini {
            width: 13px;
            height: 13px;
        }

        .mr-self-panel .mr-status-copy strong {
            font-size: 12px;
            line-height: 1.1;
        }

        .mr-self-panel .mr-status-copy span {
            margin-top: 1px;
            font-size: 9px;
            line-height: 1.25;
        }

        .mr-self-panel .mr-menu-action {
            grid-template-columns: 26px minmax(0, 1fr) auto;
            gap: 7px;
            min-height: 34px;
            border-radius: 10px;
            padding: 4px 6px;
        }

        .mr-self-panel .mr-menu-icon {
            width: 26px;
            height: 26px;
            border-radius: 9px;
            font-size: 12px;
        }

        .mr-self-panel .mr-menu-text strong {
            font-size: 12px;
        }

        .mr-self-panel .mr-menu-text span,
        .mr-self-panel .mr-shortcut {
            font-size: 9px;
        }

        .mr-status-option:hover,
        .mr-status-option.is-active {
            background: rgba(255,255,255,.14);
        }

        .mr-status-mini {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: var(--mr-teal);
        }

        .mr-status-option[data-status="BUSY"] .mr-status-mini,
        .mr-status-option[data-status="MEETING"] .mr-status-mini { background: var(--mr-yellow); }
        .mr-status-option[data-status="DND"] .mr-status-mini { background: var(--mr-red); }
        .mr-status-option[data-status="AWAY"] .mr-status-mini { background: #94a3b8; }

        .mr-status-copy strong,
        .mr-status-copy span {
            display: block;
        }

        .mr-status-copy strong {
            font-size: 14px;
            font-weight: 850;
        }

        .mr-status-copy span {
            margin-top: 3px;
            color: var(--mr-muted);
            font-size: 12px;
        }

        .mr-status-input {
            width: 100%;
            height: 52px;
            margin: 14px 0 4px;
            border: 1px solid rgba(255,255,255,.17);
            border-radius: 17px;
            padding: 0 16px;
            color: #fff;
            background: rgba(255,255,255,.08);
            outline: none;
        }

        .mr-message-form {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 8px;
            margin-top: 12px;
        }

        .mr-message-form[hidden] {
            display: none !important;
        }

        .mr-message-input {
            min-width: 0;
            height: 44px;
            border: 1px solid rgba(255,255,255,.17);
            border-radius: 14px;
            padding: 0 14px;
            color: #fff;
            background: rgba(255,255,255,.08);
            outline: none;
        }

        .mr-send-btn {
            height: 44px;
            border: 0;
            border-radius: 14px;
            padding: 0 16px;
            color: #061728;
            background: var(--mr-teal);
            font-weight: 850;
            cursor: pointer;
        }

        .mr-toast {
            position: absolute;
            z-index: 90;
            left: 50%;
            bottom: 84px;
            max-width: min(460px, calc(100vw - 28px));
            transform: translateX(-50%) translateY(20px);
            opacity: 0;
            pointer-events: none;
            padding: 12px 16px;
            border: 1px solid rgba(255,255,255,.16);
            border-radius: 16px;
            color: #fff;
            background: rgba(12,21,45,.94);
            box-shadow: 0 20px 48px rgba(0,0,0,.3);
            transition: transform .18s ease, opacity .18s ease;
        }

        .mr-toast.has-action {
            display: flex;
            align-items: center;
            gap: 10px;
            pointer-events: auto;
        }

        .mr-toast-message {
            min-width: 0;
        }

        .mr-toast-action {
            flex: 0 0 auto;
            border: 0;
            border-radius: 999px;
            padding: 7px 11px;
            color: #061728;
            background: var(--mr-teal);
            font: inherit;
            font-size: 12px;
            font-weight: 900;
            line-height: 1;
            cursor: pointer;
        }

        .mr-toast.is-show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

        .mr-wave-notification {
            position: fixed;
            z-index: 96;
            top: max(16px, calc(16px + var(--mr-safe-top)));
            right: max(16px, calc(16px + var(--mr-safe-right)));
            max-width: min(420px, calc(100vw - 32px - var(--mr-safe-left) - var(--mr-safe-right)));
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 9px 8px 13px;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 12px;
            color: #fff;
            background: rgba(12,21,45,.96);
            box-shadow: 0 20px 46px rgba(0,0,0,.34);
            backdrop-filter: blur(16px);
        }

        .mr-wave-notification[hidden] {
            display: none !important;
        }

        .mr-wave-notification strong {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 12px;
            font-weight: 900;
        }

        .mr-wave-walk,
        .mr-wave-close {
            flex: 0 0 auto;
            border: 0;
            cursor: pointer;
            font: inherit;
            line-height: 1;
        }

        .mr-wave-walk {
            min-height: 28px;
            padding: 0 12px;
            border-radius: 999px;
            color: #061728;
            background: var(--mr-teal);
            font-size: 11px;
            font-weight: 950;
        }

        .mr-wave-close {
            width: 28px;
            height: 28px;
            display: inline-grid;
            place-items: center;
            border-radius: 9px;
            color: rgba(226,232,240,.82);
            background: rgba(255,255,255,.08);
            font-size: 16px;
            font-weight: 900;
        }

        .mr-wave-walk:hover,
        .mr-wave-walk:focus-visible {
            background: #4be8d4;
            outline: none;
        }

        .mr-wave-close:hover,
        .mr-wave-close:focus-visible {
            color: #fff;
            background: rgba(255,255,255,.14);
            outline: none;
        }

        .mr-map-tools {
            position: absolute;
            z-index: 18;
            right: max(18px, calc(18px + var(--mr-safe-right)));
            bottom: max(var(--mr-map-tools-bottom), calc(var(--mr-map-tools-bottom) + var(--mr-safe-bottom)));
            display: grid;
            gap: 8px;
        }

        .mr-map-tools .mr-icon-btn {
            background: rgba(12,21,45,.78);
            backdrop-filter: blur(12px);
        }

        .mr-map-tools #resetRoomZoom {
            font-size: 11px;
            font-weight: 850;
        }

        .mr-meeting-panel {
            position: absolute;
            z-index: 34;
            left: 22px;
            top: 92px;
            bottom: auto;
            width: min(1080px, calc(100% - 430px));
            min-width: 520px;
            max-height: min(178px, calc(100% - 138px));
            display: grid;
            grid-template-rows: auto minmax(0, 1fr);
            overflow: visible;
            border: 0;
            border-radius: 0;
            color: #f8fbff;
            background: transparent;
            box-shadow: none;
            backdrop-filter: none;
        }

        .mr-meeting-panel.is-dragging {
            user-select: none;
        }

        .mr-meeting-panel[hidden] {
            display: none !important;
        }

        .meeting-room.is-right-panel-collapsed .mr-meeting-panel {
            width: min(1120px, calc(100% - 46px));
        }

        .mr-meeting-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            min-height: 30px;
            padding: 0 0 6px;
            border-bottom: 0;
            background: transparent;
            cursor: grab;
            touch-action: none;
        }

        .mr-meeting-panel.is-dragging .mr-meeting-head {
            cursor: grabbing;
        }

        .mr-meeting-head-left {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 7px;
            max-width: min(340px, 48vw);
            padding: 4px 8px;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 10px;
            background: rgba(15,23,42,.66);
            box-shadow: 0 10px 24px rgba(0,0,0,.22);
            backdrop-filter: blur(12px);
        }

        .mr-meeting-title {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .mr-meeting-title strong {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 11px;
            font-weight: 900;
        }

        .mr-meeting-title span {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: rgba(226,232,240,.72);
            font-size: 10px;
            font-weight: 750;
        }

        .mr-meeting-status-pill {
            min-width: 44px;
            height: 22px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            padding: 0 7px;
            border: 1px solid rgba(45,212,191,.34);
            border-radius: 999px;
            color: rgba(204,251,241,.96);
            background: rgba(20,184,166,.13);
            font-size: 10px;
            font-weight: 900;
            white-space: nowrap;
        }

        .mr-meeting-status-pill::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,.12);
        }

        .mr-meeting-status-pill.is-ready {
            color: rgba(226,232,240,.72);
            border-color: rgba(148,163,184,.28);
            background: rgba(148,163,184,.12);
        }

        .mr-meeting-status-pill.is-ready::before {
            background: #94a3b8;
            box-shadow: none;
        }

        .mr-meeting-head-actions {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            flex: 0 0 auto;
            padding: 3px;
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 11px;
            background: rgba(15,23,42,.62);
            box-shadow: 0 10px 24px rgba(0,0,0,.18);
            backdrop-filter: blur(12px);
        }

        .mr-meeting-head-actions .mr-icon-btn,
        .mr-file-plus {
            width: 28px;
            height: 28px;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 9px;
            color: #fff;
            background: rgba(255,255,255,.07);
            cursor: pointer;
        }

        .mr-meeting-head-actions .mr-icon-btn:hover,
        .mr-meeting-head-actions .mr-icon-btn:focus-visible,
        .mr-file-plus:hover,
        .mr-file-plus:focus-visible {
            background: rgba(255,255,255,.13);
            outline: none;
        }

        .mr-meeting-head-actions .danger {
            color: #ff7777;
            background: rgba(239,68,68,.12);
        }

        .mr-meeting-body {
            min-height: 0;
            display: block;
            overflow: visible;
        }

        .mr-meeting-stage {
            min-width: 0;
            min-height: 112px;
            height: clamp(112px, 15vh, 134px);
            overflow: visible;
            display: block;
            padding: 0;
            background: transparent;
        }

        .mr-video-grid {
            min-height: 0;
            height: 100%;
            display: grid;
            grid-auto-flow: column;
            grid-auto-columns: clamp(176px, 24vw, 292px);
            grid-template-columns: none;
            grid-auto-rows: 100%;
            gap: 5px;
            align-content: start;
            overflow-x: auto;
            overflow-y: hidden;
            overscroll-behavior: contain;
            padding: 0 2px 4px 0;
            scrollbar-width: thin;
            scrollbar-color: rgba(148,163,184,.45) transparent;
        }

        .mr-video-grid::-webkit-scrollbar {
            width: 6px;
        }

        .mr-video-grid::-webkit-scrollbar-thumb {
            border-radius: 999px;
            background: rgba(148,163,184,.42);
        }

        .mr-video-grid.is-single {
            grid-auto-columns: clamp(220px, 30vw, 360px);
        }

        .mr-video-grid.is-many {
            grid-template-columns: none;
            grid-auto-columns: clamp(150px, 20vw, 240px);
            grid-auto-rows: 100%;
        }

        .mr-video-grid.is-crowded {
            grid-template-columns: none;
            grid-auto-columns: clamp(132px, 18vw, 220px);
            grid-auto-rows: 100%;
        }

        .mr-video-tile {
            position: relative;
            min-height: 112px;
            height: 100%;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 6px;
            background:
                linear-gradient(145deg, rgba(255,255,255,.03), rgba(255,255,255,0)),
                #111418;
            box-shadow: 0 16px 34px rgba(0,0,0,.34), inset 0 0 0 1px rgba(255,255,255,.04);
        }

        .mr-video-tile.is-expandable {
            cursor: zoom-in;
        }

        .mr-video-tile video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            background: #020617;
        }

        .mr-video-tile.is-screen {
            grid-column: auto;
        }

        .mr-video-expand {
            position: absolute;
            top: 7px;
            right: 7px;
            width: 24px;
            height: 24px;
            display: inline-grid;
            place-items: center;
            border-radius: 8px;
            color: #fff;
            background: rgba(2,6,23,.68);
            box-shadow: 0 10px 20px rgba(0,0,0,.22);
            font-size: 12px;
            font-weight: 900;
            opacity: .78;
            pointer-events: none;
        }

        .mr-video-tile.is-expandable:hover .mr-video-expand {
            opacity: 1;
        }

        .mr-video-placeholder {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 6px;
            padding: 10px;
            text-align: center;
            color: rgba(226,232,240,.82);
            font-size: 11px;
            font-weight: 850;
        }

        .mr-video-avatar {
            width: 36px;
            height: 36px;
            display: inline-grid;
            place-items: center;
            border-radius: 50%;
            color: #5c3b18;
            background: #ffd19a;
            box-shadow: 0 0 0 3px rgba(255,255,255,.08);
            font-size: 16px;
            font-weight: 900;
        }

        .mr-video-label {
            position: absolute;
            left: 7px;
            bottom: 7px;
            max-width: calc(100% - 20px);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            padding: 4px 7px;
            border-radius: 999px;
            color: #fff;
            background: rgba(2,6,23,.72);
            font-size: 10px;
            font-weight: 850;
        }

        .mr-video-state {
            position: absolute;
            top: auto;
            left: 7px;
            bottom: 30px;
            min-width: 18px;
            height: 18px;
            display: inline-grid;
            place-items: center;
            border-radius: 999px;
            color: rgba(248,250,252,.92);
            background: rgba(2,6,23,.68);
            box-shadow: 0 8px 18px rgba(0,0,0,.18);
            font-size: 0;
            font-weight: 900;
        }

        .mr-video-state.is-on {
            color: #052e2b;
            background: rgba(45,212,191,.94);
        }

        .mr-video-state.is-off {
            color: #fecaca;
            background: rgba(127,29,29,.78);
        }

        .mr-meeting-side {
            min-width: 0;

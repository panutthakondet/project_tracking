                }

                if (targetId === 'meetingScreenZoomReset') {
                    resetMeetingScreenView();
                    return;
                }

                if (targetId === 'meetingScreenClose') {
                    closeMeetingScreenViewer();
                    return;
                }

                if (targetId === 'micOptions') {
                    showToast(micStream ? `${describeActiveTrack(micStream, 'Microphone active')} · ${currentConversationArea().title}` : 'ไมโครโฟนยังปิดอยู่');
                    return;
                }

                if (targetId === 'cameraOptions') {
                    showToast(cameraStream ? describeActiveTrack(cameraStream, 'Camera active') : 'กล้องยังปิดอยู่');
                    return;
                }

                if (targetId === 'leaveRoom') {
                    window.location.href = isGuest ? '/Auth/Login' : '@Url.Action("Index", "Home")';
                    return;
                }

                if (targetId === 'copyGuestLink') {
                    try {
                        await copyToClipboard(shareLink);
                        showToast('คัดลอก Copy desk link แล้ว');
                    } catch (error) {
                        showToast('คัดลอกลิงก์ไม่สำเร็จ');
                    }
                    return;
                }

                if (targetId === 'zoomInRoom') {
                    changeRoomZoom(zoomConfig.step, { announce: true });
                    return;
                }

                if (targetId === 'zoomOutRoom') {
                    changeRoomZoom(-zoomConfig.step, { announce: true });
                    return;
                }

                if (targetId === 'resetRoomZoom') {
                    applyRoomZoom(1, { announce: true });
                    return;
                }

                if (targetId === 'walkToDesk') {
                    await walkCurrentHome();
                    return;
                }

                if (targetId === 'refreshRoom') {
                    window.location.reload();
                    return;
                }

                if (targetId === 'morePersonActions') {
                    const menu = document.getElementById('personMoreActions');
                    if (menu) {
                        menu.hidden = !menu.hidden;
                    }
                    return;
                }

                if (targetId === 'openMessageBox') {
                    if (isGuest) {
                        showToast('Guest view ต้อง sign in ก่อนส่ง Message');
                        return;
                    }

                    if (!canContactPerson(selectedUserId, 'ส่งข้อความ')) {
                        return;
                    }

                    if (!requireSameConversationArea(selectedUserId, 'คุย')) {
                        return;
                    }

                    const form = document.getElementById('messageForm');
                    form.hidden = !form.hidden;
                    if (!form.hidden) {
                        document.getElementById('messageText').focus();
                    }
                    return;
                }

                if (targetId === 'wavePerson' && selectedUserId) {
                    if (isGuest) {
                        showToast('Guest view ต้อง sign in ก่อน Wave');
                        return;
                    }

                    if (!canContactPerson(selectedUserId, 'Wave')) {
                        return;
                    }

                    try {
                        const payload = await postForm(root.dataset.waveUrl, { targetUserId: selectedUserId });
                        showToast(payload.message || 'Wave sent.');
                    } catch (error) {
                        showToast(error.message);
                    }
                    return;
                }

                if (targetId === 'walkToTalkPerson' && selectedUserId) {
                    await walkCurrentTo(selectedUserId, 'talk');
                    return;
                }

                if (targetId === 'walkToMeetingPerson' && selectedUserId) {
                    await walkCurrentTo(selectedUserId, 'meeting');
                    return;
                }

                if (targetId === 'locatePerson' && selectedUserId) {
                    focusPerson(selectedUserId);
                    showToast('เจอตำแหน่งบนแผนที่แล้ว');
                    return;
                }

                if (targetId === 'followPerson' && selectedUserId) {
                    toggleFollowPerson(selectedUserId);
                    return;
                }

                if (targetId === 'requestJoinPerson' && selectedUserId) {
                    if (isGuest) {
                        showToast('Guest view ต้อง sign in ก่อนส่งคำขอ');
                        return;
                    }

                    if (!canContactPerson(selectedUserId, 'ส่งคำชวน')) {
                        return;
                    }

                    const area = currentConversationArea();
                    try {
                        const payload = await postForm(root.dataset.messageUrl, {
                            targetUserId: selectedUserId,
                            message: `ขอให้เข้ามาคุยด้วยที่ ${area.title} ใน Meeting Room`
                        });
                        showToast(payload.message || 'Request sent.');
                    } catch (error) {
                        showToast(error.message);
                    }
                    return;
                }

                if (targetId === 'openAvatarEditor') {
                    openAvatarEditor();
                    return;
                }

                if (targetId === 'closeAvatarEditor' || targetId === 'cancelAvatarEditor') {
                    closeAvatarEditor();
                    return;
                }

                if (targetId === 'saveAvatarEditor') {
                    await saveAvatarEditor();
                    return;
                }

                if (targetId === 'avatarRandomize') {
                    randomAvatar();
                    return;
                }

                if (targetId === 'saveDisplayName') {
                    if (isGuest) {
                        showToast('Guest view ต้อง sign in ก่อนตั้งชื่อ');
                        return;
                    }

                    const input = document.getElementById('displayNameInput');
                    try {
                        const payload = await postForm(root.dataset.displayNameUrl, {
                            displayName: input.value.trim()
                        });
                        updateCurrentDisplayName(payload.displayName, payload.roomDisplayName || '', payload.initial);
                        showToast('อัปเดตชื่อในห้องแล้ว');
                    } catch (error) {
                        showToast(error.message);
                    }
                    return;
                }

                const statusOption = event.target.closest('.mr-status-option');
                if (statusOption) {
                    const status = statusOption.dataset.status;
                    const statusText = document.getElementById('statusTextInput').value.trim();
                    try {
                        const payload = await postForm(root.dataset.presenceUrl, { status, statusText });
                        updateCurrentStatus(payload.status || status, payload.statusText || statusText, payload.label);
                        showToast('อัปเดตสถานะแล้ว');
                    } catch (error) {
                        showToast(error.message);
                    }
                    return;
                }

                const avatarTab = event.target.closest('.mr-avatar-tab');
                if (avatarTab && avatarDraft) {
                    avatarActiveCategory = avatarTab.dataset.avatarCategory || 'skin';
                    updateAvatarPreview();
                    return;
                }

                const avatarOption = event.target.closest('.mr-avatar-option-card');
                if (avatarOption && avatarDraft) {
                    const category = avatarCategories.find(item => item.key === avatarActiveCategory);
                    if (category?.field) {
                        avatarDraft[category.field] = avatarOption.dataset.avatarOption;
                        updateAvatarPreview();
                    }
                    return;
                }

                const avatarSwatch = event.target.closest('.mr-avatar-swatch');
                if (avatarSwatch && avatarDraft) {
                    const field = avatarSwatch.dataset.avatarColorField;
                    const value = avatarSwatch.dataset.avatarColorValue;
                    if (field && value) {
                        avatarDraft[field] = value;
                        if (field === 'topColor') {
                            avatarDraft.avatarColor = value;
                        }
                        updateAvatarPreview();
                    }
                    return;
                }

                if (hasOpenPopover() && isEmptyMapClick) {
                    closePopovers();
                }
            });

            map.addEventListener('dblclick', event => {
                const personButton = event.target.closest('.mr-person');
                if (personButton) {
                    event.preventDefault();
                    event.stopPropagation();
                    closePopovers();

                    const targetUserId = Number(personButton.dataset.userId || 0);
                    if (targetUserId && targetUserId !== currentUserId) {
                        void walkCurrentTo(targetUserId, 'talk');
                    }
                    return;
                }

                if (event.target.closest('.mr-map-tools, .mr-popover, .mr-customize-panel, .mr-room-object')) {
                    return;
                }

                const areaButton = event.target.closest('.mr-area-shape');
                if (isCustomizeOpen && areaButton) {
                    return;
                }

                cancelPendingDeskAreaSelection();
                cancelPendingObjectPlacement();
                document.getElementById('areaDraft')?.setAttribute('hidden', '');
                event.preventDefault();
                event.stopPropagation();

                if (areaButton && walkToAreaPoint(areaButton, event)) {
                    return;
                }

                const point = mapEventToWorldPoint(event);
                walkCurrentToPoint(point.x, point.y, { closePopovers: false });
            });

            map.addEventListener('wheel', event => {
                if (event.target.closest('.mr-map-tools, .mr-popover')) {
                    return;
                }

                event.preventDefault();
                changeRoomZoom(event.deltaY < 0 ? zoomConfig.step : -zoomConfig.step);
            }, { passive: false });

            document.getElementById('displayNameInput')?.addEventListener('keydown', event => {
                if (event.key !== 'Enter') {
                    return;
                }

                event.preventDefault();
                document.getElementById('saveDisplayName')?.click();
            });

            document.getElementById('meetingFileInput')?.addEventListener('change', async event => {
                const file = event.target.files?.[0];
                event.target.value = '';
                if (file) {
                    await uploadMeetingFile(file);
                }
            });

	            window.addEventListener('beforeunload', () => {
		                window.clearInterval(followTimer);
                window.clearInterval(roomStateTimer);
                window.clearTimeout(pendingPositionSyncTimer);
                window.clearTimeout(pendingObjectPlacementTimer);
                window.clearTimeout(pendingDeskAreaSelectionTimer);
	                window.clearTimeout(autoMeetingTimer);
	                window.clearTimeout(proximityVoiceTimer);
	                window.clearTimeout(meetingParticipantsRenderTimer);
	                window.clearTimeout(meetingVideosRenderTimer);
	                stopAllSpeakingDetectors();
	                void disconnectLiveKitRoom({ keepDesiredMedia: true });
                closeAllRtcPeers();
                stopMediaStream(micStream);
                stopMediaStream(cameraStream);
                stopMediaStream(screenStream);
                meetingRoomEngineHandle?.destroy?.();
                realtimeConnection?.stop?.();
            });

            window.addEventListener('resize', () => {
                setRoomPan(roomPanX, roomPanY);
                ensureCustomizePanelInView();
                ensureMeetingPanelInView();
            });

            document.getElementById('areaForm')?.addEventListener('submit', async event => {
                event.preventDefault();
                if (!canCustomize || !isCustomizeOpen) return;

                const area = formArea();
                if (!area.title) {
                    showToast('กรุณาตั้งชื่อพื้นที่');
                    document.getElementById('areaTitleInput')?.focus();
                    return;
                }

                try {
                    const payload = await postForm(root.dataset.saveAreaUrl, area);
                    const saved = payload.area;
                    const nextArea = {
                        areaId: Number(saved.areaId || saved.AreaId || area.areaId),
                        key: saved.key || saved.areaKey || area.title,
                        title: saved.title || area.title,
                        areaType: saved.areaType || area.areaType,
                        tone: saved.tone || area.tone,
                        isCustom: true,
                        x: Number(saved.x ?? area.x),
                        y: Number(saved.y ?? area.y),
                        w: Number(saved.w ?? area.w),
                        h: Number(saved.h ?? area.h)
                    };

                    const existingIndex = customAreas.findIndex(item => Number(item.areaId) === Number(nextArea.areaId));
                    if (existingIndex >= 0) {
                        customAreas[existingIndex] = nextArea;
                    } else {
                        customAreas.push(nextArea);
                    }

                    selectedAreaId = nextArea.areaId;
                    setAreaForm(nextArea);
                    document.getElementById('areaDraft')?.setAttribute('hidden', '');
                    rebuildVoiceAreas();
                    renderCustomAreas();
                    showToast('บันทึกพื้นที่แล้ว');
                } catch (error) {
                    showToast(error.message);
                }
            });

            ['areaTitleInput', 'areaTypeInput', 'areaToneInput', 'areaXInput', 'areaYInput', 'areaWInput', 'areaHInput'].forEach(id => {
                document.getElementById(id)?.addEventListener('input', () => {
                    if (isCustomizeOpen) {
                        syncDraftFromForm();
                    }
                });
                document.getElementById(id)?.addEventListener('change', () => {
                    if (isCustomizeOpen) {
                        syncDraftFromForm();
                    }
                });
            });

            document.getElementById('objectForm')?.addEventListener('submit', async event => {
                event.preventDefault();
                if (!canCustomize || !isCustomizeOpen) return;

                const item = formObject();
                if (!item.title) {
                    showToast('กรุณาตั้งชื่อของ');
                    document.getElementById('objectTitleInput')?.focus();
                    return;
                }

                try {
                    const payload = await postForm(root.dataset.saveObjectUrl, {
                        objectId: item.objectId,
                        objectKey: item.objectKey,
                        objectType: item.objectType,
                        title: item.title,
                        tone: item.tone,
                        x: item.x,
                        y: item.y,
                        w: item.w,
                        h: item.h,
                        rotation: item.rotation,
                        isObstacle: item.isObstacle
                    });
                    const saved = payload.item;
                    const nextObject = clampObject({
                        objectId: Number(saved.objectId || saved.ObjectId || item.objectId),
                        objectKey: saved.objectKey || item.objectKey,
                        objectType: saved.objectType || item.objectType,
                        title: saved.title || item.title,
                        tone: saved.tone || item.tone,
                        x: Number(saved.x ?? item.x),
                        y: Number(saved.y ?? item.y),
                        w: Number(saved.w ?? item.w),
                        h: Number(saved.h ?? item.h),
                        rotation: Number(saved.rotation ?? item.rotation),
                        isObstacle: saved.isObstacle ?? item.isObstacle,
                        isCustom: true
                    });

                    const existingIndex = customObjects.findIndex(object => Number(object.objectId) === Number(nextObject.objectId));
                    if (existingIndex >= 0) {
                        customObjects[existingIndex] = nextObject;
                    } else {
                        customObjects.push(nextObject);
                    }

                    selectedObjectId = nextObject.objectId;
                    setObjectForm(nextObject);
                    document.getElementById('objectDraft')?.setAttribute('hidden', '');
                    renderCustomObjects();
                    showToast('บันทึกของในห้องแล้ว');
                } catch (error) {
                    showToast(error.message);
                }
            });

            ['objectTitleInput', 'objectToneInput', 'objectRotationInput', 'objectXInput', 'objectYInput', 'objectWInput', 'objectHInput', 'objectObstacleInput'].forEach(id => {
                document.getElementById(id)?.addEventListener('input', () => {
                    if (isCustomizeOpen && customizeMode === 'object') {
                        syncObjectDraftFromForm();
                    }
                });
                document.getElementById(id)?.addEventListener('change', () => {
                    if (isCustomizeOpen && customizeMode === 'object') {
                        syncObjectDraftFromForm();
                    }
                });
            });

            document.getElementById('messageForm').addEventListener('submit', async event => {
                event.preventDefault();
                if (isGuest) return;
                if (!selectedUserId) return;

                const input = document.getElementById('messageText');
                const message = input.value.trim();
                if (!message) {
                    input.focus();
                    return;
                }

                if (!canContactPerson(selectedUserId, 'ส่งข้อความ')) {
                    return;
                }

                if (!requireSameConversationArea(selectedUserId, 'ส่งข้อความคุย')) {
                    return;
                }

                try {
                    const payload = await postForm(root.dataset.messageUrl, { targetUserId: selectedUserId, message });
                    input.value = '';
                    document.getElementById('messageForm').hidden = true;
                    showToast(payload.message || 'Message sent.');
                } catch (error) {
                    showToast(error.message);
                }
            });

            document.addEventListener('keydown', event => {
                const typingTarget = event.target instanceof HTMLElement &&
                    (event.target.matches('input, textarea, select') || event.target.isContentEditable);

                if (event.key === 'Escape') {
                    if (meetingScreenViewer && !meetingScreenViewer.hidden) {
                        closeMeetingScreenViewer();
                        return;
                    }

                    closePopovers();
                    return;
                }

                const arrowSteps = {
                    ArrowUp: [0, -1],
                    ArrowDown: [0, 1],
                    ArrowLeft: [-1, 0],
                    ArrowRight: [1, 0]
                };

                if (Object.prototype.hasOwnProperty.call(arrowSteps, event.key)) {
                    const [dx, dy] = arrowSteps[event.key];
                    if (nudgeObjectWithKeyboard(dx, dy, event.metaKey || event.ctrlKey ? 10 : event.shiftKey ? 5 : 1)) {
                        event.preventDefault();
                        return;
                    }

                    if (typingTarget) {
                        return;
                    }

                    event.preventDefault();
                    if (isGuest) {
                        showToast('Guest view ต้อง sign in ก่อนเดินในห้อง');
                        return;
                    }

                    const marker = getPersonMarker(currentUserId);
                    if (!marker) return;

                    const step = event.shiftKey ? 7 : 3;
                    const nextX = markerPercent(marker, 'x', 50) + (dx * step);
                    const nextY = markerPercent(marker, 'y', 50) + (dy * step);
                    walkCurrentToPoint(nextX, nextY, { closePopovers: false });
                    return;
                }

                if (typingTarget) {
                    return;
                }

                if (event.key.toLowerCase() === 'd') {
                    focusPerson(currentUserId);
                }
            });

            document.querySelectorAll('.mr-avatar, .mr-row-avatar img, .mr-profile-photo img').forEach(image => {
                const useDefaultAvatar = () => {
                    if (!image.src.endsWith('/images/Profile/profile.png')) {
                        image.src = '/images/Profile/profile.png';
                    }
                };

                image.addEventListener('error', useDefaultAvatar, { once: true });
                if (image.complete && image.naturalWidth === 0) {
                    useDefaultAvatar();
                }
            });

            renderObjectPalette();
            renderCustomAreas();
            renderCustomObjects();
            document.querySelectorAll('.mr-person').forEach(marker => {
                const person = peopleById.get(Number(marker.dataset.userId));
                applyAvatarToElement(marker, person || marker.dataset);
                const area = syncMarkerArea(marker);
                if (Number(marker.dataset.userId || 0) === currentUserId) {
                    scheduleAutoMeetingMode(area);
                }
            });
            startCanvasEngine();
            startRealtimeRoom();
            startRoomStatePolling(12000);

            if (focusUserId) {
                window.setTimeout(() => focusPerson(focusUserId), 650);
            }

            applyRoomZoom(1);
            syncRightPanelToggle();
        })();
    </script>
}

@model ProjectTracking.ViewModels.MeetingRoomViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Meeting Room";

    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
    var peopleJson = JsonSerializer.Serialize(Model.People, jsonOptions);
    var zonesJson = JsonSerializer.Serialize(Model.Zones, jsonOptions);
    var objectsJson = JsonSerializer.Serialize(Model.Objects, jsonOptions);
    var current = Model.CurrentUser;
    var isGuest = Model.IsGuest;
    var shareLink = Model.ShareLink;
    if (string.IsNullOrWhiteSpace(shareLink))
    {
        shareLink = Url.Action("Guest", "MeetingRoom", null, Context.Request.Scheme) ?? "/MeetingRoom/Guest";
    }
}

@section Styles {
    <style>
        :root {
            --mr-ink: #eff6ff;
            --mr-muted: rgba(239,246,255,.68);
            --mr-panel: rgba(22,31,67,.94);
            --mr-panel-2: rgba(36,48,92,.94);
            --mr-line: rgba(190,207,255,.18);
            --mr-teal: #19d3b2;
            --mr-blue: #60a5fa;
            --mr-yellow: #f8d85d;
            --mr-red: #ff4b6b;
            --mr-map-bg: #efe6d8;
            --mr-floor-line: rgba(232,184,137,.42);
            --mr-floor-mark: rgba(238,196,155,.34);
        }

        .meeting-room {
            position: relative;
            width: 100%;
            height: 100%;
            min-height: 0;
            max-height: 100%;
            display: grid;
            grid-template-rows: auto minmax(0, 1fr);
            gap: 8px;
            padding: 10px;
            box-sizing: border-box;
            overflow: hidden;
            color: var(--mr-ink);
            font-family: var(--pt-font-family, Inter, "Segoe UI", sans-serif);
            background:
                linear-gradient(180deg, rgba(7,18,39,.98), rgba(11,23,48,.96) 58%, rgba(8,20,42,.98)),
                #0b1730;
        }

        #meetingRoomAntiForgery {
            display: none !important;
        }

        .mr-topbar {
            position: relative;
            z-index: 20;
            min-height: 52px;
            display: grid;
            grid-template-columns: minmax(300px, 1fr) auto minmax(420px, auto);
            align-items: center;
            gap: 10px;
            padding: 7px 10px;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 18px;
            background: rgba(12,21,45,.84);
            box-shadow: 0 18px 54px rgba(0,0,0,.24);
            backdrop-filter: blur(18px);
        }

        .mr-title {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .mr-logo {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,.15);
            background: linear-gradient(135deg, rgba(25,211,178,.9), rgba(96,165,250,.82));
            color: #061728;
            font-weight: 900;
            letter-spacing: 0;
        }

        .mr-title h1 {
            margin: 0;
            font-size: 18px;
            line-height: 1.15;
            font-weight: 850;
            letter-spacing: 0;
            color: #fff;
        }

        .mr-title p {
            margin: 1px 0 0;
            color: var(--mr-muted);
            font-size: 11px;
            line-height: 1.25;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .mr-stats {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-width: 0;
        }

        .mr-stat {
            min-width: 74px;
            padding: 6px 9px;
            border: 1px solid rgba(255,255,255,.11);
            border-radius: 12px;
            background: rgba(255,255,255,.08);
        }

        .mr-stat strong,
        .mr-stat span {
            display: block;
            line-height: 1.1;
        }

        .mr-stat strong {
            font-size: 15px;
            color: #fff;
        }

        .mr-stat span {
            margin-top: 2px;
            font-size: 10px;
            color: var(--mr-muted);
        }

        .mr-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 6px;
            min-width: 0;
            flex-wrap: nowrap;
        }

        .mr-search {
            min-width: 160px;
            width: clamp(160px, 17vw, 240px);
            flex: 0 1 auto;
            height: 36px;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 12px;
            padding: 0 12px;
            color: #fff;
            background: rgba(255,255,255,.1);
            outline: none;
        }

        .mr-search::placeholder {
            color: rgba(239,246,255,.48);
        }

        .mr-icon-btn,
        .mr-text-btn {
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 1px solid rgba(255,255,255,.13);
            border-radius: 12px;
            color: #fff;
            background: rgba(255,255,255,.1);
            text-decoration: none;
            cursor: pointer;
            transition: transform .16s ease, background .16s ease, border-color .16s ease;
        }

        .mr-icon-btn {
            width: 36px;
            font-size: 16px;
        }

        .mr-text-btn {
            padding: 0 12px;
            font-weight: 750;
            font-size: 12px;
            white-space: nowrap;
        }

        .mr-icon-btn:hover,
        .mr-text-btn:hover {
            transform: translateY(-1px);
            border-color: rgba(255,255,255,.25);
            background: rgba(255,255,255,.16);
            color: #fff;
        }

        .mr-icon-btn:disabled {
            opacity: .42;
            cursor: default;
            transform: none;
        }

        .mr-btn-svg {
            width: 18px;
            height: 18px;
            display: block;
            fill: none;
            stroke: currentColor;
            stroke-width: 2.2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .mr-tooltip-btn {
            position: relative;
        }

        .mr-tooltip-btn::before,
        .mr-tooltip-btn::after {
            position: absolute;
            left: 50%;
            bottom: -10px;
            transform: translate(-50%, 100%);
            opacity: 0;
            pointer-events: none;
            transition: opacity .14s ease, transform .14s ease;
        }

        .mr-tooltip-btn::before {
            content: "";
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-bottom: 8px solid rgba(14,14,16,.96);
            transform: translate(-50%, 4px);
        }

        .mr-tooltip-btn::after {
            content: attr(data-tooltip);
            min-width: max-content;
            padding: 8px 12px;
            border-radius: 12px;
            color: #fff;
            background: rgba(14,14,16,.96);
            font-size: 13px;
            font-weight: 760;
            box-shadow: 0 10px 28px rgba(0,0,0,.26);
        }

        .mr-tooltip-btn:hover::before,
        .mr-tooltip-btn:hover::after,
        .mr-tooltip-btn:focus-visible::before,
        .mr-tooltip-btn:focus-visible::after {
            opacity: 1;
        }

        .mr-stage-shell {
            position: relative;
            min-height: 0;
            height: 100%;
            display: grid;
            grid-template-columns: minmax(0, 1fr) 390px;
            gap: 14px;
            padding: 0;
            overflow: hidden;
            transition: grid-template-columns .2s ease;
        }

        .meeting-room.is-right-panel-collapsed .mr-stage-shell {
            grid-template-columns: minmax(0, 1fr) 54px;
        }

        .mr-map {
            position: relative;
            min-width: 0;
            min-height: 0;
            overflow: hidden;
            cursor: crosshair;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 22px;
            background: var(--mr-map-bg);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.05), 0 24px 70px rgba(0,0,0,.28);
        }

        .mr-map.is-pannable {
            cursor: grab;
        }

        .mr-map.is-panning {
            cursor: grabbing;
        }

        .meeting-room[data-guest="true"] .mr-map {
            cursor: default;
        }

        .meeting-room[data-guest="true"] .mr-map.is-pannable {
            cursor: grab;
        }

        .meeting-room[data-guest="true"] .mr-map.is-panning {
            cursor: grabbing;
        }

        .mr-map-world {
            position: absolute;
            inset: 0;
            min-width: 100%;
            min-height: 100%;
            transform: translate(var(--mr-pan-x, 0px), var(--mr-pan-y, 0px)) scale(var(--mr-zoom, 1));
            transform-origin: 50% 50%;
            transition: transform .18s ease;
            background:
                linear-gradient(90deg, transparent 0 36px, var(--mr-floor-mark) 36px 37px, transparent 37px 74px) 0 0 / 148px 32px repeat,
                linear-gradient(90deg, transparent 0 72px, var(--mr-floor-mark) 72px 73px, transparent 73px 148px) 0 16px / 148px 32px repeat,
                repeating-linear-gradient(0deg, var(--mr-map-bg) 0 14px, var(--mr-floor-line) 14px 15px, var(--mr-map-bg) 15px 31px, rgba(238,196,155,.28) 31px 32px);
            will-change: transform;
        }

        .mr-map.is-panning .mr-map-world {
            transition: none;
        }

        .mr-map-world::before,
        .mr-map-world::after {
            content: "";
            position: absolute;
            display: none;
            pointer-events: none;
        }

        .mr-map-world::before {
            inset: 3% 2% 8% 2%;
            border-radius: 20px;
            background:
                linear-gradient(90deg, transparent 0 19%, rgba(74,89,99,.8) 19% 20.6%, transparent 20.6% 100%),
                linear-gradient(90deg, transparent 0 61%, rgba(74,89,99,.72) 61% 62.4%, transparent 62.4% 100%),
                linear-gradient(0deg, transparent 0 35%, rgba(74,89,99,.75) 35% 36.6%, transparent 36.6% 100%),
                linear-gradient(0deg, transparent 0 67%, rgba(74,89,99,.75) 67% 68.6%, transparent 68.6% 100%);
            opacity: .62;
        }

        .mr-map-world::after {
            left: 2%;
            right: 2%;
            bottom: 4%;
            height: 8%;
            border-radius: 22px;
            background:
                repeating-linear-gradient(90deg, rgba(59,75,83,.7) 0 22px, rgba(47,61,68,.8) 22px 44px);
            opacity: .48;
        }

        .mr-zone {
            position: absolute;
            left: calc(var(--x) * 1%);
            top: calc(var(--y) * 1%);
            width: calc(var(--w) * 1%);
            height: calc(var(--h) * 1%);
            z-index: 2;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 14px;
            border-radius: 18px;
            border: 2px solid rgba(255,255,255,.18);
            color: rgba(255,255,255,.95);
            text-decoration: none;
            background: rgba(18,31,58,.26);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
            backdrop-filter: blur(1px);
        }

        .mr-zone:hover {
            color: #fff;
            border-color: rgba(255,255,255,.38);
            background: rgba(18,31,58,.36);
        }

        .mr-zone-title {
            font-weight: 850;
            font-size: 14px;
            line-height: 1.15;
        }

        .mr-zone-subtitle {
            margin-top: 3px;
            display: block;
            color: rgba(255,255,255,.64);
            font-size: 11px;
            line-height: 1.2;
        }

        .mr-zone-count {
            align-self: flex-start;
            min-width: 31px;
            height: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 9px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 850;
            color: #061728;
            background: rgba(255,255,255,.88);
        }

        .mr-zone.tone-blue { background-color: rgba(37,99,235,.22); }
        .mr-zone.tone-teal { background-color: rgba(20,184,166,.22); }
        .mr-zone.tone-violet { background-color: rgba(124,58,237,.2); }
        .mr-zone.tone-rose { background-color: rgba(244,63,94,.2); }
        .mr-zone.tone-orange { background-color: rgba(249,115,22,.2); }
        .mr-zone.tone-green { background-color: rgba(34,197,94,.2); }
        .mr-zone.tone-cyan { background-color: rgba(6,182,212,.2); }

        .mr-area-shape,
        .mr-area-draft {
            position: absolute;
            left: calc(var(--x) * 1%);
            top: calc(var(--y) * 1%);
            width: calc(var(--w) * 1%);
            height: calc(var(--h) * 1%);
            z-index: 3;
            border: 2px solid rgba(255,255,255,.28);
            border-radius: 10px;
            background: rgba(20,184,166,.13);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);
        }

        .mr-area-shape {
            display: block;
            padding: 7px 8px;
            color: rgba(255,255,255,.82);
            text-align: left;
            cursor: pointer;
        }

        .mr-area-shape span {
            display: inline-flex;
            max-width: 100%;
            padding: 3px 7px;
            border-radius: 999px;
            background: rgba(7,18,39,.68);
            font-size: 10px;
            font-weight: 850;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .mr-area-shape:hover,
        .mr-area-shape.is-selected {
            border-color: rgba(255,255,255,.68);
            background: rgba(96,165,250,.18);
        }

        .mr-area-draft {
            z-index: 7;
            border-style: dashed;
            border-color: rgba(255,255,255,.74);
            background: rgba(96,165,250,.18);
            pointer-events: none;
        }

        .mr-area-shape.tone-blue,
        .mr-area-draft.tone-blue { background-color: rgba(37,99,235,.16); border-color: rgba(96,165,250,.48); }
        .mr-area-shape.tone-teal,
        .mr-area-draft.tone-teal { background-color: rgba(20,184,166,.16); border-color: rgba(45,212,191,.48); }
        .mr-area-shape.tone-violet,
        .mr-area-draft.tone-violet { background-color: rgba(124,58,237,.15); border-color: rgba(167,139,250,.48); }
        .mr-area-shape.tone-rose,
        .mr-area-draft.tone-rose { background-color: rgba(244,63,94,.15); border-color: rgba(251,113,133,.48); }
        .mr-area-shape.tone-orange,
        .mr-area-draft.tone-orange { background-color: rgba(249,115,22,.16); border-color: rgba(251,146,60,.48); }
        .mr-area-shape.tone-green,
        .mr-area-draft.tone-green { background-color: rgba(34,197,94,.15); border-color: rgba(74,222,128,.48); }
        .mr-area-shape.tone-cyan,
        .mr-area-draft.tone-cyan { background-color: rgba(6,182,212,.15); border-color: rgba(34,211,238,.48); }

        .mr-room-object,
        .mr-object-draft {
            position: absolute;
            left: calc(var(--x) * 1%);
            top: calc(var(--y) * 1%);
            width: calc(var(--w) * 1%);
            height: calc(var(--h) * 1%);
            z-index: 6;
            display: grid;
            place-items: center;
            border: 0;
            padding: 0;
            background: transparent;
            transform: rotate(var(--rotation, 0deg));
            transform-origin: center;
            image-rendering: pixelated;
        }

        .mr-room-object {
            pointer-events: none;
        }

        .meeting-room.is-customizing .mr-room-object {
            pointer-events: auto;
            cursor: pointer;
        }

        .mr-room-object:hover,
        .mr-room-object.is-selected {
            filter: drop-shadow(0 0 0 rgba(0,0,0,0)) drop-shadow(0 0 10px rgba(96,165,250,.75));
        }

        .mr-object-draft {
            z-index: 8;
            opacity: .78;
            pointer-events: none;
            filter: drop-shadow(0 0 12px rgba(45,212,191,.55));
        }

        .mr-object-pixel {
            position: relative;
            display: block;
            width: 88%;
            height: 80%;
            border-radius: 4px;
            background: #bf7b4f;
            box-shadow: inset 0 -5px 0 rgba(69,45,33,.34), 0 5px 0 rgba(7,12,18,.22);
        }

        .object-desk-basic .mr-object-pixel {
            width: 92%;
            height: 58%;
            border: 3px solid #3f2c24;
            border-radius: 3px;
            background:
                linear-gradient(90deg, transparent 0 12%, rgba(255,255,255,.16) 12% 15%, transparent 15% 100%),
                linear-gradient(180deg, #cc8250, #ad6640);
            box-shadow:
                inset 0 -7px 0 rgba(58,37,30,.3),
                -2px 9px 0 -3px #493229,
                2px 9px 0 -3px #493229,
                0 8px 0 rgba(7,12,18,.2);
        }

        .object-chair-office .mr-object-pixel {
            width: 54%;
            height: 78%;
            border: 3px solid #253142;
            border-radius: 5px;
            background:
                linear-gradient(180deg, #5fb3ff 0 42%, #3669d8 42% 100%);
            box-shadow:
                0 12px 0 -6px #1f2937,
                -10px 11px 0 -7px #64748b,
                10px 11px 0 -7px #64748b,
                inset 0 -5px 0 rgba(15,23,42,.24);
        }

        .object-sofa-blue .mr-object-pixel {
            width: 94%;
            height: 70%;
            border: 3px solid #253142;
            border-radius: 10px 10px 5px 5px;
            background:
                linear-gradient(90deg, rgba(255,255,255,.2) 0 48%, transparent 48% 52%, rgba(255,255,255,.16) 52% 100%),
                linear-gradient(180deg, #67a6ff, #386bd8);
            box-shadow:
                -7px 8px 0 -4px #253142,
                7px 8px 0 -4px #253142,
                inset 0 -10px 0 rgba(22,45,115,.4);
        }

        .object-table-round .mr-object-pixel {
            width: min(80%, 90px);
            height: 82%;
            border: 3px solid #3f2c24;
            border-radius: 50%;
            background:
                radial-gradient(circle at 35% 28%, rgba(255,255,255,.22), transparent 32%),
                #c98555;
            box-shadow:
                inset 0 -8px 0 rgba(81,54,39,.22),
                0 7px 0 rgba(7,12,18,.22);
        }

        .object-plant-pot .mr-object-pixel {
            width: 54%;
            height: 82%;
            border-radius: 4px 4px 9px 9px;
            background:
                radial-gradient(circle at 50% 12%, #31c66b 0 18%, transparent 19%),
                radial-gradient(circle at 32% 22%, #65db87 0 17%, transparent 18%),
                radial-gradient(circle at 66% 24%, #239b55 0 18%, transparent 19%),
                linear-gradient(180deg, transparent 0 44%, #c17a47 44% 100%);
            box-shadow:
                0 0 0 3px rgba(18,29,39,.9),
                inset 0 -5px 0 rgba(65,42,28,.25);
        }

        .object-plant-tall .mr-object-pixel {
            width: 46%;
            height: 96%;
            border-radius: 18px 18px 7px 7px;
            background:
                radial-gradient(circle at 48% 10%, #4ade80 0 16%, transparent 17%),
                radial-gradient(circle at 31% 22%, #22c55e 0 18%, transparent 19%),
                radial-gradient(circle at 66% 24%, #15803d 0 18%, transparent 19%),
                radial-gradient(circle at 48% 35%, #86efac 0 13%, transparent 14%),
                linear-gradient(90deg, transparent 0 42%, #8b5a35 42% 58%, transparent 58% 100%),
                linear-gradient(180deg, transparent 0 66%, #c47a45 66% 100%);
            box-shadow:
                0 0 0 3px rgba(18,29,39,.9),
                inset 0 -6px 0 rgba(65,42,28,.25);
        }

        .object-rug-blue .mr-object-pixel {
            width: 96%;
            height: 76%;
            border: 2px solid rgba(255,255,255,.5);
            border-radius: 8px;
            background:
                radial-gradient(circle, rgba(255,255,255,.42) 0 10%, transparent 11%),
                repeating-linear-gradient(45deg, rgba(255,255,255,.16) 0 5px, transparent 5px 10px),
                #38a1db;
            box-shadow: inset 0 0 0 5px rgba(14,116,144,.38);
        }

        .object-rug-round .mr-object-pixel {
            width: 88%;
            height: 88%;
            border: 2px solid rgba(255,255,255,.58);
            border-radius: 50%;
            background:
                radial-gradient(circle at 50% 50%, rgba(255,255,255,.42) 0 10%, transparent 11% 23%, rgba(255,255,255,.18) 24% 28%, transparent 29%),
                repeating-conic-gradient(from 0deg, rgba(255,255,255,.15) 0 12deg, transparent 12deg 24deg),
                #7c3aed;
            box-shadow: inset 0 0 0 6px rgba(91,33,182,.42), 0 5px 0 rgba(7,12,18,.18);
        }

        .object-partition .mr-object-pixel {
            width: 92%;
            height: 86%;
            border: 3px solid #3b4558;
            border-radius: 5px;
            background:
                linear-gradient(90deg, transparent 0 31%, rgba(59,69,88,.95) 31% 34%, transparent 34% 65%, rgba(59,69,88,.95) 65% 68%, transparent 68% 100%),
                linear-gradient(180deg, rgba(255,255,255,.35), rgba(148,163,184,.2)),
                #dbeafe;
            box-shadow:
                inset 0 0 0 4px rgba(255,255,255,.38),
                0 8px 0 -5px #3b4558,
                0 9px 0 rgba(7,12,18,.2);
        }

        .object-screen .mr-object-pixel,
        .object-board .mr-object-pixel {
            width: 82%;
            height: 74%;
            border: 3px solid #2d3748;
            border-radius: 4px;
            background:
                linear-gradient(90deg, rgba(96,165,250,.8) 0 14%, transparent 14% 100%),
                linear-gradient(180deg, #dff6ff, #91c8e4);
            box-shadow:
                0 10px 0 -6px #2d3748,
                inset 0 0 0 4px rgba(255,255,255,.34);
        }

        .object-board .mr-object-pixel {
            background:
                linear-gradient(90deg, transparent 0 18%, rgba(34,197,94,.7) 18% 24%, transparent 24% 100%),
                linear-gradient(180deg, #f8fafc, #cbd5e1);
        }

        .meeting-room.is-customizing .mr-map {
            cursor: crosshair;
        }

        .meeting-room.is-customizing[data-customize-mode="object"] .mr-map {
            cursor: copy;
        }

        .mr-person {
            position: absolute;
            z-index: 9;
            left: calc(var(--x) * 1%);
            top: calc(var(--y) * 1%);
            width: 150px;
            min-height: 116px;
            transform: translate(-50%, -50%);
            border: 0;
            padding: 0;
            color: #fff;
            background: transparent;
            cursor: pointer;
            outline: none;
            filter: drop-shadow(0 10px 16px rgba(0,0,0,.28));
            transition: left .82s cubic-bezier(.25,.9,.28,1), top .82s cubic-bezier(.25,.9,.28,1), filter .18s ease, opacity .18s ease;
            will-change: left, top;
        }

        .mr-person.is-offline {
            opacity: .54;
        }

        .mr-person.is-walking {
            z-index: 24;
            filter: drop-shadow(0 18px 24px rgba(0,0,0,.34));
        }

        .mr-person.is-focus .mr-character,
        .mr-person:focus-visible .mr-character,
        .mr-person:hover .mr-character {
            transform: scaleX(var(--avatar-dir, 1)) scale(calc(var(--avatar-scale) + .04)) translateY(-4px);
        }

        .mr-character {
            position: relative;
            width: 58px;
            height: 86px;
            display: block;
            margin: 22px auto 0;
            --avatar-scale: .68;
            --avatar-dir: 1;
            transform: scaleX(var(--avatar-dir, 1)) scale(var(--avatar-scale));
            transform-origin: center top;
            image-rendering: pixelated;
            --skin: #efbd83;
            --skin-shadow: #b6764f;
            --hair: #2d3442;
            --hair-hi: #4b5563;
            --outfit: #3154db;
            --outfit-dark: #1e3189;
            --accent: #7dd3fc;
            --pants: #1f2937;
            --shoe: #0f172a;
            --avatar-color: var(--person-avatar-color, #2d9cff);
            transition: transform .18s ease;
        }

        .mr-character::before {
            content: "";
            position: absolute;
            left: 11px;
            right: 9px;
            bottom: 2px;
            height: 9px;
            background: rgba(7,12,18,.42);
            transform: skewX(-18deg);
            z-index: 0;
        }

        .mr-character::after {
            content: "";
            position: absolute;
            left: 6px;
            top: 3px;
            width: 43px;
            height: 39px;
            background: var(--hair);
            box-shadow:
                4px -4px 0 var(--hair-hi),
                0 0 0 3px #0b0f16,
                -4px 8px 0 #0b0f16,
                4px 14px 0 var(--hair);
            z-index: 1;
        }

        .mr-pixel-head,
        .mr-pixel-face,
        .mr-pixel-body,
        .mr-pixel-arm,
        .mr-pixel-leg {
            position: absolute;
            display: block;
            z-index: 2;
            border-radius: 0;
        }

        .mr-pixel-head {
            left: 16px;
            top: 11px;
            width: 28px;
            height: 28px;
            background: var(--skin);
            box-shadow:
                0 0 0 3px #0b0f16,
                -5px 4px 0 var(--hair),
                18px 6px 0 -5px var(--skin-shadow);
            z-index: 3;
        }

        .mr-pixel-face {
            left: 16px;
            top: 11px;
            width: 28px;
            height: 28px;
            overflow: hidden;
            background: var(--skin);
            z-index: 4;
        }

        .mr-pixel-face img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            image-rendering: auto;
            filter: saturate(.96) contrast(1.04);
        }

        .mr-pixel-body {
            left: 20px;
            top: 42px;
            width: 28px;
            height: 30px;
            background: var(--outfit);
            box-shadow:
                0 0 0 3px #0b0f16,
                inset 0 8px 0 var(--accent),
                inset 0 -7px 0 var(--outfit-dark);
            z-index: 2;
        }

        .mr-pixel-arm {
            left: 13px;
            top: 46px;
            width: 9px;
            height: 24px;
            background: var(--outfit-dark);
            box-shadow:
                0 0 0 3px #0b0f16,
                0 20px 0 -2px var(--skin);
            z-index: 4;
        }

        .mr-pixel-leg {
            bottom: 8px;
            width: 9px;
            height: 18px;
            background: var(--pants);
            box-shadow:
                0 0 0 3px #0b0f16,
                0 15px 0 -2px var(--shoe);
            z-index: 1;
        }

        .mr-pixel-leg.one { left: 23px; }
        .mr-pixel-leg.two { left: 38px; }

        .mr-pixel-body::after {
            content: "";
            position: absolute;
            display: none;
            left: 7px;
            top: 8px;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: rgba(255,255,255,.9);
            box-shadow: inset 0 -3px 0 rgba(15,23,42,.16);
        }

        .character-doraemon .mr-character,

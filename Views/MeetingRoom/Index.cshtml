<form id="meetingRoomAntiForgery" method="post" hidden>
    @Html.AntiForgeryToken()
</form>

<div class="meeting-room is-right-panel-collapsed"
     id="meetingRoom"
     data-guest="@isGuest.ToString().ToLowerInvariant()"
     data-share-link="@shareLink"
     data-can-customize="@Model.CanCustomize.ToString().ToLowerInvariant()"
     data-focus-user-id="@(Model.FocusUserId?.ToString() ?? "")"
     data-current-user-id="@current.UserId"
     data-wave-url="@Url.Action("Wave", "MeetingRoom")"
     data-message-url="@Url.Action("Message", "MeetingRoom")"
     data-display-name-url="@Url.Action("UpdateDisplayName", "MeetingRoom")"
     data-presence-url="@Url.Action("UpdatePresence", "MeetingRoom")"
     data-character-url="@Url.Action("UpdateCharacter", "MeetingRoom")"
     data-position-url="@Url.Action("UpdatePosition", "MeetingRoom")"
     data-state-url="@Url.Action("State", "MeetingRoom")"
     data-hub-url="/hubs/meeting-room"
     data-map-url="/meeting-room/maps/default-map.json"
     data-files-url="@Url.Action("Files", "MeetingRoom")"
     data-share-file-url="@Url.Action("ShareFile", "MeetingRoom")"
     data-livekit-token-url="@Url.Action("LiveKitToken", "MeetingRoom")"
     data-set-desk-area-url="@Url.Action("SetDeskArea", "MeetingRoom")"
     data-save-area-url="@Url.Action("SaveArea", "MeetingRoom")"
     data-delete-area-url="@Url.Action("DeleteArea", "MeetingRoom")"
     data-save-object-url="@Url.Action("SaveObject", "MeetingRoom")"
     data-delete-object-url="@Url.Action("DeleteObject", "MeetingRoom")">
    <header class="mr-topbar">
        <div class="mr-title">
            <span class="mr-logo">SO</span>
            <div>
                <h1>Meeting Room</h1>
                @if (isGuest)
                {
                    <p>Guest view · Read only · Copy link เพื่อส่งต่อได้</p>
                }
                else
                {
                    <p><span id="topCurrentName">@current.DisplayName</span> · <span id="topCurrentStatus">@current.StatusLabel@if (!string.IsNullOrWhiteSpace(current.StatusText)) { <text> · @current.StatusText</text> }</span></p>
                }
            </div>
        </div>

        <div class="mr-stats" aria-label="Meeting room summary">
            <div class="mr-stat">
                <strong>@Model.Stats.OnlineCount</strong>
                <span>Online</span>
            </div>
            <div class="mr-stat">
                @if (isGuest)
                {
                    <strong>@Model.Stats.TotalPeople</strong>
                    <span>People</span>
                }
                else
                {
                    <strong>@Model.Stats.TodayMeetingCount</strong>
                    <span>Meetings</span>
                }
            </div>
            <div class="mr-stat">
                @if (isGuest)
                {
                    <strong>View</strong>
                    <span>Guest</span>
                }
                else
                {
                    <strong>@(Model.Stats.OpenIssueCount + Model.Stats.OpenSupportCount + Model.Stats.OpenFollowupCount)</strong>
                    <span>Open work</span>
                }
            </div>
        </div>

        <div class="mr-actions">
            <button class="mr-icon-btn mr-tooltip-btn" type="button" id="copyGuestLink" data-tooltip="Copy desk link" title="Copy desk link" aria-label="Copy desk link">
                <svg class="mr-btn-svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M10 13a5 5 0 0 0 7.1 0l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1"></path>
                    <path d="M14 11a5 5 0 0 0-7.1 0l-2 2A5 5 0 0 0 12 20.1l1.1-1.1"></path>
                </svg>
            </button>
            @if (isGuest)
            {
                <a class="mr-text-btn" href="@Url.Action("Login", "Auth", new { returnUrl = Url.Action("Index", "MeetingRoom") })">Sign in</a>
            }
            else
            {
                @if (Model.CanCustomize)
                {
                    <button class="mr-text-btn" type="button" id="openCustomizeRoom">Customize</button>
                }
                <a class="mr-icon-btn" href="@Url.Action("Index", "Home")" title="Dashboard" aria-label="Dashboard">⌂</a>
                <a class="mr-icon-btn" href="@Url.Action("Index", "RequirementBoard")" title="Project Board" aria-label="Project Board">▦</a>
                <button class="mr-text-btn" type="button" id="openSelfMenu">My status</button>
            }
        </div>
    </header>

    <main class="mr-stage-shell">
        <section class="mr-map" id="meetingRoomMap" aria-label="SO-AT virtual office map">
            <div class="mr-map-world" id="meetingRoomWorld">
                <div class="mr-game-layer" id="meetingRoomGameLayer" aria-hidden="true"></div>
                @foreach (var area in Model.Zones.Where(zone => zone.IsCustom))
                {
                    var areaLabel = area.OwnerUserId.HasValue
                        ? $"{area.Title} · เจ้าของ {area.OwnerName}"
                        : area.Title;
                    <button type="button"
                            class="mr-area-shape tone-@area.Tone @(area.OwnerUserId.HasValue ? "is-owned" : "")"
                            style="--x:@area.X;--y:@area.Y;--w:@area.W;--h:@area.H;"
                            data-area-id="@area.AreaId"
                            data-area-key="@area.Key"
                            data-title="@area.Title"
                            data-area-type="@area.AreaType"
                            data-tone="@area.Tone"
                            data-owner-user-id="@(area.OwnerUserId?.ToString() ?? "")"
                            data-owner-name="@area.OwnerName"
                            data-owner-initial="@area.OwnerInitial"
                            data-x="@area.X"
                            data-y="@area.Y"
                            data-w="@area.W"
                            data-h="@area.H"
                            aria-label="@areaLabel"
                            title="@areaLabel">
                        <span class="mr-area-title">@area.Title</span>
                        <span class="mr-area-owner" hidden="@(!area.OwnerUserId.HasValue)">เจ้าของ · @area.OwnerName</span>
                    </button>
                }
                @if (Model.CanCustomize)
                {
                    <div class="mr-area-draft" id="areaDraft" hidden></div>
                }
                @foreach (var item in Model.Objects)
                {
                    <button type="button"
                            class="mr-room-object object-@item.ObjectKey tone-@item.Tone"
                            style="--x:@item.X;--y:@item.Y;--w:@item.W;--h:@item.H;--rotation:@(item.Rotation)deg;"
                            data-object-id="@item.ObjectId"
                            data-object-key="@item.ObjectKey"
                            data-object-type="@item.ObjectType"
                            data-title="@item.Title"
                            data-tone="@item.Tone"
                            data-x="@item.X"
                            data-y="@item.Y"
                            data-w="@item.W"
                            data-h="@item.H"
                            data-rotation="@item.Rotation"
                            data-is-obstacle="@item.IsObstacle.ToString().ToLowerInvariant()"
                            aria-label="@item.Title"
                            title="@item.Title">
                        <span class="mr-object-pixel"></span>
                    </button>
                }
                @if (Model.CanCustomize)
                {
                    <div class="mr-object-draft object-desk-basic tone-wood" id="objectDraft" hidden>
                        <span class="mr-object-pixel"></span>
                    </div>
                }
                @foreach (var person in Model.People)
                {
                    var statusClass = (person.Status ?? "AVAILABLE").ToLowerInvariant();
                    var onlineClass = person.IsOnline ? "is-online" : "is-offline";
                    var selfClass = person.IsCurrentUser ? "is-self" : "";
                    var statusTextClass = string.IsNullOrWhiteSpace(person.StatusText) ? "" : "has-status-text";
                    <button type="button"
                            class="mr-person @onlineClass @selfClass @statusTextClass status-@statusClass character-@person.CharacterPreset"
                            style="--x:@person.X;--y:@person.Y;--person-avatar-color:@person.AvatarColor;--avatar-skin:@person.SkinTone;--avatar-hair:@person.HairColor;--avatar-top:@person.TopColor;--avatar-jacket:@person.JacketColor;--avatar-bottom:@person.BottomColor;--avatar-shoes:@person.ShoesColor;"
                            data-user-id="@person.UserId"
                            data-emp-id="@(person.EmpId?.ToString() ?? "")"
                            data-name="@person.DisplayName"
                            data-username="@person.Username"
                            data-position="@person.Position"
                            data-avatar="@person.AvatarPath"
                            data-joined-text="@person.JoinedText"
                            data-status="@person.Status"
                            data-status-label="@person.StatusLabel"
                            data-status-text="@person.StatusText"
                            data-zone="@person.Zone"
                            data-x="@person.X"
                            data-y="@person.Y"
                            data-home-x="@person.HomeX"
                            data-home-y="@person.HomeY"
                            data-home-zone="@person.Zone"
                            data-online="@person.IsOnline.ToString().ToLowerInvariant()"
                            data-character="@person.CharacterPreset"
                            data-avatar-color="@person.AvatarColor"
                            data-skin-tone="@person.SkinTone"
                            data-hair-style="@person.HairStyle"
                            data-hair-color="@person.HairColor"
                            data-facial-hair-style="@person.FacialHairStyle"
                            data-top-style="@person.TopStyle"
                            data-top-color="@person.TopColor"
                            data-jacket-style="@person.JacketStyle"
                            data-jacket-color="@person.JacketColor"
                            data-bottom-style="@person.BottomStyle"
                            data-bottom-color="@person.BottomColor"
                            data-shoes-style="@person.ShoesStyle"
                            data-shoes-color="@person.ShoesColor"
                            data-hat-style="@person.HatStyle"
                            data-hat-color="@person.HatColor"
                            data-glasses-style="@person.GlassesStyle"
                            data-glasses-color="@person.GlassesColor"
                            data-other-style="@person.OtherStyle"
                            data-other-color="@person.OtherColor"
                            data-workload="@person.WorkloadTotal"
                            aria-label="@person.DisplayName"
                            title="@person.DisplayName">
                        <span class="mr-person-name">
                            <span class="mr-name-badge">
                                <img src="@person.AvatarPath" alt="" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                            </span>
                            <span class="mr-name-text">@person.DisplayName</span>
                            <span class="mr-name-status">@person.StatusText</span>
                        </span>
                        <span class="mr-character">
                            <span class="mr-pixel-hair"></span>
                            <span class="mr-pixel-head"></span>
                            <span class="mr-pixel-face"></span>
                            <span class="mr-pixel-facial-hair"></span>
                            <span class="mr-pixel-glasses"></span>
                            <span class="mr-pixel-hat"></span>
                            <span class="mr-pixel-other"></span>
                            <span class="mr-pixel-body"></span>
                            <span class="mr-pixel-jacket"></span>
                            <span class="mr-pixel-arm"></span>
                            <span class="mr-pixel-arm two"></span>
                            <span class="mr-pixel-leg one"></span>
                            <span class="mr-pixel-leg two"></span>
                            <span class="mr-pixel-shoe one"></span>
                            <span class="mr-pixel-shoe two"></span>
                            <span class="mr-speaking-bubble" aria-hidden="true"><span></span></span>
                        </span>
                    </button>
                }
            </div>

            <div class="mr-map-tools" aria-label="Map tools">
                <button type="button" class="mr-icon-btn" id="zoomInRoom" title="Zoom in" aria-label="Zoom in">＋</button>
                <button type="button" class="mr-icon-btn" id="zoomOutRoom" title="Zoom out" aria-label="Zoom out">−</button>
                <button type="button" class="mr-icon-btn" id="resetRoomZoom" title="Reset zoom" aria-label="Reset zoom">100</button>
                <button type="button" class="mr-icon-btn" id="refreshRoom" title="Refresh room" aria-label="Refresh room">↻</button>
            </div>
        </section>

        <aside class="mr-right-panel" id="meetingRoomSidePanel">
            <button class="mr-right-toggle" type="button" id="toggleRightPanel" aria-expanded="false" aria-label="Show side panel">
                <span class="mr-right-toggle-icon" aria-hidden="true">‹</span>
            </button>
            <section class="mr-panel">
                <div class="mr-panel-head">
                    <h2>People</h2>
                    <span>@Model.Stats.OnlineCount / @Model.Stats.TotalPeople online</span>
                </div>
                <div class="mr-people-list" id="meetingRoomPeopleList">
                    @foreach (var person in Model.People)
                    {
                        var rowOnlineClass = person.IsOnline ? "" : "is-offline";
                        <button type="button"
                                class="mr-person-row @rowOnlineClass"
                                data-user-id="@person.UserId"
                                data-emp-id="@(person.EmpId?.ToString() ?? "")"
                                data-status="@person.Status"
                                data-search="@($"{person.DisplayName} {person.Username} {person.Position}".ToLowerInvariant())">
                            <span class="mr-row-avatar">
                                <img src="@person.AvatarPath" alt="" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                <span></span>
                            </span>
                            <span class="mr-row-main">
                                <strong>@person.DisplayName</strong>
                                <span>@person.StatusLabel · @person.Zone</span>
                            </span>
                            <span class="mr-row-load">@person.WorkloadTotal</span>
                        </button>
                    }
                </div>
            </section>

            <section class="mr-panel mr-meetings">
                <h2>Today</h2>
                @if (isGuest)
                {
                    <p class="mr-empty">Guest view ไม่แสดงตารางประชุมภายใน</p>
                }
                else if (Model.TodayMeetings.Any())
                {
                    foreach (var meeting in Model.TodayMeetings)
                    {
                        <a class="mr-meeting-card" href="@Url.Action("Details", "Meetings", new { id = meeting.Id })">
                            <strong>@meeting.TimeText · @meeting.Title</strong>
                            <span>@meeting.ProjectName · @meeting.Location</span>
                        </a>
                    }
                }
                else
                {
                    <p class="mr-empty">วันนี้ยังไม่มี meeting ในระบบ</p>
                }
            </section>
        </aside>
    </main>

    <section class="mr-popover" id="personPopover" hidden data-status="AVAILABLE" data-online="true">
        <div class="mr-popover-inner">
            <div class="mr-profile-head">
                <span class="mr-profile-photo">
                    <img id="personAvatar" src="/images/Profile/profile.png" alt="" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                    <span class="mr-profile-status"></span>
                </span>
                <span class="mr-profile-name">
                    <h2 id="personName">Name</h2>
                    <span class="mr-profile-meta" id="personMeta">Joined on</span>
                    <p id="personStatus">Available</p>
                </span>
                <button class="mr-close" type="button" data-close-popover aria-label="Close">×</button>
            </div>

            <div class="mr-quick-actions mr-auth-only">
                <button class="mr-action-btn icon-only" type="button" id="wavePerson" title="Wave" aria-label="Wave">👋</button>
                <button class="mr-action-btn success primary-join" type="button" id="walkToMeetingPerson">
                    <span aria-hidden="true">↪</span>
                    <span>Join</span>
                </button>
                <button class="mr-action-btn secondary icon-only" type="button" id="walkToTalkPerson" title="Walk to talk" aria-label="Walk to talk">▣</button>
                <button class="mr-action-btn secondary icon-only" type="button" id="openMessageBox" title="Message" aria-label="Message">☁</button>
                <button class="mr-action-btn secondary icon-only" type="button" id="morePersonActions" title="More" aria-label="More">⋮</button>
            </div>

            <form class="mr-message-form mr-auth-only" id="messageForm" hidden>
                <input class="mr-message-input" id="messageText" maxlength="500" placeholder="Type a short message" autocomplete="off" />
                <button class="mr-send-btn" type="submit">Send</button>
            </form>

            <p class="mr-guest-note mr-guest-only">Guest view เปิดให้ดูตำแหน่งและสถานะของทีมแบบ read-only ถ้าต้องการ Wave หรือ Message ให้ sign in ด้วยบัญชีในระบบ</p>

            <div class="mr-menu-actions" id="personMoreActions" hidden>
                <a class="mr-menu-action mr-auth-only" id="viewProfileLink" href="#">
                    <span class="mr-menu-icon">👤</span>
                    <span class="mr-menu-text">
                        <strong>View profile</strong>
                        <span>เปิดข้อมูลพนักงาน</span>
                    </span>
                    <span class="mr-shortcut">↗</span>
                </a>
                <button class="mr-menu-action" type="button" id="locatePerson">
                    <span class="mr-menu-icon">⌖</span>
                    <span class="mr-menu-text">
                        <strong>Locate on map</strong>
                        <span>โฟกัสตำแหน่งในห้อง</span>
                    </span>
                    <span class="mr-shortcut">L</span>
                </button>
                <button class="mr-menu-action" type="button" id="followPerson">
                    <span class="mr-menu-icon">⇢</span>
                    <span class="mr-menu-text">
                        <strong>Follow</strong>
                        <span>ติดตามตำแหน่งคนนี้ในหน้าแผนที่</span>
                    </span>
                    <span class="mr-shortcut">F</span>
                </button>
                <button class="mr-menu-action mr-auth-only" type="button" id="requestJoinPerson">
                    <span class="mr-menu-icon">＋</span>
                    <span class="mr-menu-text">
                        <strong>Request to join me</strong>
                        <span>ส่งข้อความชวนเข้าห้องเดียวกัน</span>
                    </span>
                    <span class="mr-shortcut">J</span>
                </button>
            </div>
        </div>
    </section>

    <section class="mr-popover mr-self-panel" id="selfPopover" hidden data-status="@current.Status">
        <div class="mr-popover-inner">
            <div class="mr-profile-head">
                <span class="mr-profile-photo">
                    <img id="selfAvatar" src="@current.AvatarPath" alt="" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                    <span class="mr-profile-status"></span>
                </span>
                <span class="mr-profile-name">
                    <h2 id="selfDisplayName">@current.DisplayName</h2>
                    <p id="selfStatusText">@current.StatusLabel@if (!string.IsNullOrWhiteSpace(current.StatusText)) { <text> · @current.StatusText</text> }</p>
                    <span class="mr-profile-meta">@current.Position · @current.Zone</span>
                </span>
                <button class="mr-close" type="button" data-close-popover aria-label="Close">×</button>
            </div>

            <div class="mr-name-editor">
                <input class="mr-name-input" id="displayNameInput" maxlength="50" value="@current.RoomDisplayName" placeholder="Display name" />
                <button class="mr-name-save" type="button" id="saveDisplayName">Save</button>
            </div>
            <input class="mr-status-input" id="statusTextInput" maxlength="120" value="@current.StatusText" placeholder="Add text status" />

            <div class="mr-status-list" aria-label="Status options">
                <button type="button" class="mr-status-option" data-status="AVAILABLE">
                    <span class="mr-status-mini"></span>
                    <span class="mr-status-copy"><strong>Available</strong><span>พร้อมคุยและรับข้อความ</span></span>
                    <span class="mr-shortcut">⌘ + O</span>
                </button>
                <button type="button" class="mr-status-option" data-status="BUSY">
                    <span class="mr-status-mini"></span>
                    <span class="mr-status-copy"><strong>Busy</strong><span>กำลังทำงาน ขอเวลาแป๊บหนึ่ง</span></span>
                    <span class="mr-shortcut">⌘ + I</span>
                </button>
                <button type="button" class="mr-status-option" data-status="DND">
                    <span class="mr-status-mini"></span>
                    <span class="mr-status-copy"><strong>Do Not Disturb</strong><span>ไม่สะดวกให้ติดต่อชั่วคราว</span></span>
                    <span class="mr-shortcut">⌘ + U</span>
                </button>
                <button type="button" class="mr-status-option" data-status="AWAY">
                    <span class="mr-status-mini"></span>
                    <span class="mr-status-copy"><strong>Away</strong><span>ไม่อยู่หน้าจอ</span></span>
                    <span class="mr-shortcut">A</span>
                </button>
                <button type="button" class="mr-status-option" data-status="MEETING">
                    <span class="mr-status-mini"></span>
                    <span class="mr-status-copy"><strong>In Meeting</strong><span>กำลังประชุม</span></span>
                    <span class="mr-shortcut">M</span>
                </button>
            </div>

            <div class="mr-divider"></div>

            <div class="mr-menu-actions">
                <button class="mr-menu-action" type="button" id="openAvatarEditor">
                    <span class="mr-menu-icon">▣</span>
                    <span class="mr-menu-text">
                        <strong>Edit avatar</strong>
                        <span>ปรับผิว ผม เสื้อผ้า แว่น และเครื่องแต่งตัว</span>
                    </span>
                    <span class="mr-shortcut">›</span>
                </button>

                <button class="mr-menu-action" type="button" id="walkToDesk">
                    <span class="mr-menu-icon">⌂</span>
                    <span class="mr-menu-text">
                        <strong>Walk to my desk</strong>
                        <span>โฟกัสตำแหน่งของคุณ</span>
                    </span>
                    <span class="mr-shortcut">D</span>
                </button>
            </div>
        </div>
    </section>

    <section class="mr-avatar-editor" id="avatarEditor" hidden aria-label="Edit avatar">
        <div class="mr-avatar-dialog">
            <header class="mr-avatar-head">
                <h2>Edit Avatar</h2>
                <button class="mr-avatar-close" type="button" id="closeAvatarEditor" aria-label="Close avatar editor">×</button>
            </header>

            <div class="mr-avatar-workspace">
                <nav class="mr-avatar-tabs" id="avatarTabs" aria-label="Avatar categories"></nav>

                <main class="mr-avatar-options">
                    <div class="mr-avatar-option-grid" id="avatarOptionGrid"></div>
                    <div class="mr-avatar-palette" id="avatarColorPalette"></div>
                </main>

                <aside class="mr-avatar-preview">
                    <button class="mr-avatar-download" type="button" id="avatarRandomize" title="Randomize avatar" aria-label="Randomize avatar">↻</button>
                    <div class="mr-avatar-scene">
                        <span class="mr-person-name avatar-preview-name">
                            <span class="mr-name-badge">
                                <img src="@current.AvatarPath" alt="" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                            </span>
                            <span class="mr-name-text">@current.DisplayName</span>
                        </span>
                        <span class="mr-character character-human"
                              id="avatarPreviewCharacter"
                              data-hair-style="@current.HairStyle"
                              data-facial-hair-style="@current.FacialHairStyle"
                              data-top-style="@current.TopStyle"
                              data-jacket-style="@current.JacketStyle"
                              data-bottom-style="@current.BottomStyle"
                              data-shoes-style="@current.ShoesStyle"
                              data-hat-style="@current.HatStyle"
                              data-hat-color="@current.HatColor"
                              data-glasses-style="@current.GlassesStyle"
                              data-glasses-color="@current.GlassesColor"
                              data-other-style="@current.OtherStyle"
                              data-other-color="@current.OtherColor"
                              style="--avatar-skin:@current.SkinTone;--avatar-hair:@current.HairColor;--avatar-top:@current.TopColor;--avatar-jacket:@current.JacketColor;--avatar-bottom:@current.BottomColor;--avatar-shoes:@current.ShoesColor;--avatar-hat:@current.HatColor;--avatar-glasses:@current.GlassesColor;--avatar-other:@current.OtherColor;">
                            <span class="mr-pixel-hair"></span>
                            <span class="mr-pixel-head"></span>
                            <span class="mr-pixel-face"></span>
                            <span class="mr-pixel-facial-hair"></span>
                            <span class="mr-pixel-glasses"></span>
                            <span class="mr-pixel-hat"></span>
                            <span class="mr-pixel-other"></span>
                            <span class="mr-pixel-body"></span>
                            <span class="mr-pixel-jacket"></span>
                            <span class="mr-pixel-arm"></span>
                            <span class="mr-pixel-arm two"></span>
                            <span class="mr-pixel-leg one"></span>
                            <span class="mr-pixel-leg two"></span>
                            <span class="mr-pixel-shoe one"></span>
                            <span class="mr-pixel-shoe two"></span>
                            <span class="mr-speaking-bubble" aria-hidden="true"><span></span></span>
                        </span>
                    </div>
                </aside>
            </div>

            <footer class="mr-avatar-footer">
                <button type="button" class="mr-avatar-secondary" id="cancelAvatarEditor">Cancel</button>
                <button type="button" class="mr-avatar-primary" id="saveAvatarEditor">Done</button>
            </footer>
        </div>
    </section>

    <section class="mr-meeting-panel mr-auth-only" id="meetingPanel" hidden aria-label="Active meeting">
        <div class="mr-meeting-head">
            <div class="mr-meeting-head-left">
                <div class="mr-meeting-title">
                    <strong id="meetingPanelTitle">Meeting</strong>
                    <span id="meetingPanelArea">Lobby</span>
                </div>
                <span class="mr-meeting-status-pill" id="meetingConnectionStatus">Live</span>
            </div>
            <div class="mr-meeting-head-actions">
                <button class="mr-icon-btn" type="button" id="meetingAttachFile" title="Share file" aria-label="Share file">＋</button>
                <button class="mr-icon-btn" type="button" id="meetingPanelMinimize" title="Minimize meeting" aria-label="Minimize meeting">−</button>
                <button class="mr-icon-btn danger" type="button" id="meetingPanelLeave" title="Leave meeting" aria-label="Leave meeting">↪</button>
            </div>
        </div>

	        <div class="mr-meeting-body">
	            <div class="mr-meeting-stage">
	                <div class="mr-video-grid" id="meetingVideoGrid"></div>
	            </div>

            <aside class="mr-meeting-side">
                <section class="mr-meeting-box">
                    <div class="mr-meeting-box-head">
                        <strong>Participants</strong>
                        <span id="meetingParticipantCount">0</span>
                    </div>
                    <div class="mr-meeting-participants" id="meetingParticipants"></div>
                </section>

                <section class="mr-meeting-box">
                    <div class="mr-meeting-box-head">
                        <strong>Files</strong>
                        <button class="mr-file-plus" type="button" id="meetingFileButton" title="Share file" aria-label="Share file">＋</button>
                        <input id="meetingFileInput" type="file" hidden />
                    </div>
                    <div class="mr-meeting-files" id="meetingFiles"></div>
                </section>
            </aside>
        </div>
    </section>

    <section class="mr-screen-viewer mr-auth-only" id="meetingScreenViewer" hidden aria-label="Shared screen viewer">
        <div class="mr-screen-head">
            <div class="mr-screen-title">
                <strong id="meetingScreenViewerTitle">Shared screen</strong>
                <span id="meetingScreenViewerMeta">Click and drag when zoomed</span>
            </div>
            <div class="mr-screen-controls">
                <button class="mr-icon-btn" type="button" id="meetingScreenZoomOut" title="Zoom out" aria-label="Zoom out">−</button>
                <span class="mr-screen-zoom-value" id="meetingScreenZoomValue">100%</span>
                <button class="mr-icon-btn" type="button" id="meetingScreenZoomIn" title="Zoom in" aria-label="Zoom in">＋</button>
                <button class="mr-icon-btn" type="button" id="meetingScreenZoomReset" title="Reset zoom" aria-label="Reset zoom">100</button>
                <button class="mr-icon-btn" type="button" id="meetingScreenClose" title="Close shared screen" aria-label="Close shared screen">×</button>
            </div>
        </div>
        <div class="mr-screen-viewport" id="meetingScreenViewport">
            <div class="mr-screen-canvas" id="meetingScreenCanvas">
                <video id="meetingScreenVideo" autoplay playsinline muted></video>
            </div>
        </div>
    </section>

    @if (Model.CanCustomize)
    {
        <section class="mr-customize-panel" id="customizePanel" hidden>
            <div class="mr-customize-head">
                <div>
                    <strong>Customize</strong>
                    <span>Build meeting areas</span>
                </div>
                <button class="mr-close" type="button" id="closeCustomizeRoom" aria-label="Close customize">×</button>
            </div>

            <div class="mr-customize-tabs" aria-label="Customize mode">

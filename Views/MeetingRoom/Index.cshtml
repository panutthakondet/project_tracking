        .mr-dock-avatar {
            position: relative;
            width: 48px;
            height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            border: 4px solid rgba(15,23,42,.9);
            border-radius: 50%;
            color: #5c3b18;
            background: #ffd19a;
            font-size: 22px;
            font-weight: 900;

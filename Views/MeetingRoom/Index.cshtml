            meetingScreenViewport?.addEventListener('wheel', event => {
                if (meetingScreenViewer?.hidden) return;

                event.preventDefault();
                const delta = event.deltaY > 0 ? -screenViewerZoomConfig.step : screenViewerZoomConfig.step;
                setMeetingScreenZoom(screenViewerZoom + delta);
            }, { passive: false });

            meetingScreenViewport?.addEventListener('pointerdown', event => {
                if (screenViewerZoom <= 1.01 || event.button !== 0) return;

                screenViewerPanState = {
                    pointerId: event.pointerId,
                    startX: event.clientX,
                    startY: event.clientY,
                    panX: screenViewerPanX,
                    panY: screenViewerPanY
                };
                meetingScreenViewport.classList.add('is-panning');
                meetingScreenViewport.setPointerCapture?.(event.pointerId);
                event.preventDefault();
            });

            meetingScreenViewport?.addEventListener('pointermove', event => {
                if (!screenViewerPanState || event.pointerId !== screenViewerPanState.pointerId) return;

                screenViewerPanX = screenViewerPanState.panX + (event.clientX - screenViewerPanState.startX);
                screenViewerPanY = screenViewerPanState.panY + (event.clientY - screenViewerPanState.startY);
                applyMeetingScreenTransform();
                event.preventDefault();
            });

            function endScreenViewerPan(event) {
                if (!screenViewerPanState || (event && event.pointerId !== screenViewerPanState.pointerId)) return;

                if (event && meetingScreenViewport?.hasPointerCapture?.(event.pointerId)) {
                    meetingScreenViewport.releasePointerCapture(event.pointerId);
                }
                screenViewerPanState = null;
                meetingScreenViewport?.classList.remove('is-panning');
            }

            meetingScreenViewport?.addEventListener('pointerup', endScreenViewerPan);
            meetingScreenViewport?.addEventListener('pointercancel', endScreenViewerPan);
            meetingScreenViewport?.addEventListener('lostpointercapture', () => {
                screenViewerPanState = null;
                meetingScreenViewport?.classList.remove('is-panning');
            });

            document.getElementById('meetingVideoGrid')?.addEventListener('keydown', event => {
                if (event.key !== 'Enter' && event.key !== ' ') return;

                const tile = event.target.closest('.mr-video-tile[data-screen-source-id]');
                if (!tile) return;

                event.preventDefault();
                openMeetingScreenViewer(tile.dataset.screenSourceId);
            });

            root.addEventListener('click', async event => {
                if (suppressMapClick) {
                    event.preventDefault();
                    event.stopPropagation();
                    return;
                }

                if (suppressObjectClick) {
                    event.preventDefault();
                    event.stopPropagation();
                    suppressObjectClick = false;
                    return;
                }

                const idTarget = event.target.closest('[id]');
                const targetId = idTarget?.id || '';
                const close = event.target.closest('[data-close-popover]');
                const waveAction = event.target.closest('[data-wave-action]');
                const isEmptyMapClick = event.target.closest('.mr-map') &&
                    !event.target.closest('.mr-person, .mr-map-tools, .mr-popover, .mr-customize-panel, .mr-area-shape, .mr-room-object');
                if (!(isCustomizeOpen && canCustomize && customizeMode === 'object' && isEmptyMapClick)) {
                    cancelPendingObjectPlacement();
                }
                if (!event.target.closest('.mr-area-shape')) {
                    cancelPendingDeskAreaSelection();
                }

                if (close) {
                    closePopovers();
                    return;
                }

                if (waveAction) {
                    const action = waveAction.dataset.waveAction || '';
                    if (action === 'close') {
                        closeWaveNotification();
                        return;
                    }

                    if (action === 'walk') {
                        const sourceUserId = Number(waveNotification?.dataset.userId || 0);
                        closeWaveNotification();
                        if (sourceUserId) {
                            await walkCurrentTo(sourceUserId, 'wave');
                        }
                        return;
                    }
                }

                if (isCustomizeOpen && canCustomize && customizeMode === 'object' && isEmptyMapClick) {
                    if (event.detail > 1) {
                        cancelPendingObjectPlacement();
                        return;
                    }

                    scheduleObjectPlacement(mapEventToWorldPoint(event));
                    return;
                }

                const areaButton = event.target.closest('.mr-area-shape');
                if (areaButton) {
                    if (canCustomize && isCustomizeOpen) {
                        selectArea(Number(areaButton.dataset.areaId || 0));
                        return;
                    }

                    if (event.detail > 1) {
                        cancelPendingDeskAreaSelection();
                        return;
                    }

                    if (normalizeAreaTypeValue(areaButton.dataset.areaType) === 'DESK') {
                        scheduleDeskAreaSelection(areaButton);
                        return;
                    }
                    return;
                }

                const areaItem = event.target.closest('.mr-area-item');
                if (areaItem && canCustomize && isCustomizeOpen) {
                    selectArea(Number(areaItem.dataset.areaId || 0));
                    return;
                }

                const objectButton = event.target.closest('.mr-room-object');
                if (objectButton && canCustomize && isCustomizeOpen) {
                    selectObject(Number(objectButton.dataset.objectId || 0));
                    return;
                }

                const objectItem = event.target.closest('.mr-object-item');
                if (objectItem && canCustomize && isCustomizeOpen) {
                    selectObject(Number(objectItem.dataset.objectId || 0));
                    return;
                }

                const objectCategory = event.target.closest('.mr-object-category-tab');
                if (objectCategory && canCustomize && isCustomizeOpen) {
                    selectedObjectCategory = objectCategory.dataset.objectCategory || 'Desk';
                    renderObjectPalette();
                    return;
                }

                const objectOption = event.target.closest('.mr-object-option');
                if (objectOption && canCustomize && isCustomizeOpen) {
                    setObjectTemplateActive(objectOption.dataset.objectKey || 'desk-basic');
                    selectedObjectId = null;
                    setCustomizeMode('object');
                    setObjectForm(currentObjectTemplate());
                    document.getElementById('objectDraft')?.setAttribute('hidden', '');
                    showToast('คลิกบนแผนที่เพื่อวางของชิ้นนี้');
                    return;
                }

                const personButton = event.target.closest('.mr-person');
                if (personButton) {
                    openPerson(Number(personButton.dataset.userId), personButton);
                    return;
                }

                const rowButton = event.target.closest('.mr-person-row');
                if (rowButton) {
                    const marker = map.querySelector(`.mr-person[data-user-id="${rowButton.dataset.userId}"]`) || rowButton;
                    focusPerson(rowButton.dataset.userId);
                    openPerson(Number(rowButton.dataset.userId), marker);
                    return;
                }

                const meetingPerson = event.target.closest('.mr-meeting-person');
                if (meetingPerson) {
                    const userId = Number(meetingPerson.dataset.userId || 0);
                    if (userId) {
                        focusPerson(userId);
                        const marker = getPersonMarker(userId);
                        if (marker) {
                            openPerson(userId, marker);

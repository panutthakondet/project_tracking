@section Scripts {
    <script>
        (() => {
            const people = @Html.Raw(peopleJson);
            const modelZones = @Html.Raw(zonesJson);
            const roomObjects = @Html.Raw(objectsJson);
            const root = document.getElementById('meetingRoom');
            const map = document.getElementById('meetingRoomMap');
            const world = document.getElementById('meetingRoomWorld');
            const isGuest = root.dataset.guest === 'true';
            const shareLink = root.dataset.shareLink || window.location.href;
            const focusUserId = Number(root.dataset.focusUserId || 0);
            const currentUserId = Number(root.dataset.currentUserId || 0);
            const token = document.querySelector('#meetingRoomAntiForgery input[name="__RequestVerificationToken"]')?.value || '';
            const personPopover = document.getElementById('personPopover');
            const selfPopover = document.getElementById('selfPopover');
            const toast = document.getElementById('meetingRoomToast');
            const rightPanelToggle = document.getElementById('toggleRightPanel');
            const peopleById = new Map(people.map(person => [Number(person.userId), person]));
            let selectedUserId = null;
            let followedUserId = null;
            let followTimer = null;
            let toastTimer = null;
            let activeWalkToken = 0;
            let roomZoom = 1;
            let roomPanX = 0;
            let roomPanY = 0;
            let mapPanState = null;
            let suppressMapClick = false;
            let isCustomizeOpen = false;
            let customizeMode = 'area';
            let areaDrawState = null;
            let selectedAreaId = null;
            let selectedObjectId = null;
            let selectedObjectKey = 'desk-basic';
            let customizeDragState = null;
            let micStream = null;
            let cameraStream = null;
            let screenStream = null;
            const defaultCharacter = 'doraemon';
            const defaultAvatarColor = '#2d9cff';
            const canCustomize = root.dataset.canCustomize === 'true';
            const persistedAreas = modelZones
                .filter(area => area?.key && area?.title)
                .map(area => ({
                    areaId: Number(area.areaId || 0),
                    key: String(area.key),
                    title: String(area.title),
                    areaType: String(area.areaType || 'MEETING'),
                    tone: String(area.tone || 'teal'),
                    isCustom: Boolean(area.isCustom),
                    x: Number(area.x),
                    y: Number(area.y),
                    w: Number(area.w),
                    h: Number(area.h)
                }))
                .filter(area =>
                    Number.isFinite(area.x) &&
                    Number.isFinite(area.y) &&
                    Number.isFinite(area.w) &&
                    Number.isFinite(area.h)
                );
            const defaultVoiceAreas = [
                { key: 'lobby', title: 'Lobby', x: 4, y: 7, w: 20, h: 30 },
                { key: 'war-table', title: 'War Table', x: 24, y: 7, w: 17, h: 30 },
                { key: 'design-review', title: 'Design Review', x: 41, y: 7, w: 20, h: 30 },
                { key: 'report-wall', title: 'Report Wall', x: 61, y: 7, w: 15, h: 30 },
                { key: 'garden-talk', title: 'Garden Talk', x: 76, y: 7, w: 20, h: 30 },
                { key: 'support-desk', title: 'Support Desk', x: 4, y: 37, w: 21, h: 28 },
                { key: 'developer-area', title: 'Developer Area', x: 25, y: 37, w: 30, h: 28 },
                { key: 'pm-room', title: 'PM Room', x: 55, y: 37, w: 13, h: 28 },
                { key: 'issue-desk', title: 'Issue Desk', x: 68, y: 37, w: 15, h: 28 },
                { key: 'meeting-room', title: 'Meeting Room', x: 83, y: 37, w: 13, h: 28 },
                { key: 'project-board', title: 'Project Board', x: 28, y: 65, w: 40, h: 20 },
                { key: 'followup-corner', title: 'Followup Corner', x: 68, y: 65, w: 28, h: 20 }
            ];
            let customAreas = persistedAreas.filter(area => area.isCustom);
            let customObjects = roomObjects
                .map(item => ({
                    objectId: Number(item.objectId || 0),
                    objectKey: String(item.objectKey || 'desk-basic'),
                    objectType: String(item.objectType || 'DESK'),
                    title: String(item.title || 'Desk'),
                    tone: String(item.tone || 'wood'),
                    x: Number(item.x),
                    y: Number(item.y),
                    w: Number(item.w),
                    h: Number(item.h),
                    rotation: Number(item.rotation || 0),
                    isObstacle: item.isObstacle !== false,
                    isCustom: item.isCustom !== false
                }))
                .filter(item =>
                    Number.isFinite(item.x) &&
                    Number.isFinite(item.y) &&
                    Number.isFinite(item.w) &&
                    Number.isFinite(item.h)
                );
            let voiceAreas = [
                ...customAreas,
                ...defaultVoiceAreas,
                ...persistedAreas.filter(area => !area.isCustom)
            ];

            const walkBounds = { minX: 4, maxX: 96, minY: 7, maxY: 84.5 };
            const areaBounds = { minX: 0, maxX: 100, minY: 0, maxY: 100 };
            const zoomConfig = { min: .85, max: 1.8, step: .15 };
            const pathConfig = {
                step: 2,
                pointPadding: .45,
                dynamicRadiusX: 2.6,
                dynamicRadiusY: 4.2,
                minDuration: 150,
                maxDuration: 560,
                msPerPercent: 44
            };
            const staticObstacles = [
                { x1: 21.3, x2: 23.6, y1: 10, y2: 34.5 },
                { x1: 21.3, x2: 23.6, y1: 41.5, y2: 58.5 },
                { x1: 21.3, x2: 23.6, y1: 67, y2: 85.8 },
                { x1: 59.5, x2: 61.8, y1: 10, y2: 34.5 },
                { x1: 59.5, x2: 61.8, y1: 41.5, y2: 58.5 },
                { x1: 59.5, x2: 61.8, y1: 67, y2: 85.8 },
                { x1: 6, x2: 18.4, y1: 36, y2: 38.4 },
                { x1: 28.2, x2: 56.7, y1: 36, y2: 38.4 },
                { x1: 65.6, x2: 94, y1: 36, y2: 38.4 },
                { x1: 6, x2: 18.4, y1: 62.8, y2: 65 },
                { x1: 28.2, x2: 56.7, y1: 62.8, y2: 65 },
                { x1: 65.6, x2: 94, y1: 62.8, y2: 65 },
                { x1: 3.5, x2: 96.5, y1: 86, y2: 94 }
            ];

            const statusLabels = {
                AVAILABLE: 'Available',
                BUSY: 'Busy',
                DND: 'Do Not Disturb',
                AWAY: 'Away',
                MEETING: 'In Meeting'
            };

            function showToast(message) {
                window.clearTimeout(toastTimer);
                toast.textContent = message;
                toast.classList.add('is-show');
                toastTimer = window.setTimeout(() => toast.classList.remove('is-show'), 2600);
            }

            function syncRightPanelToggle() {
                const isCollapsed = root.classList.contains('is-right-panel-collapsed');
                if (!rightPanelToggle) return;

                rightPanelToggle.setAttribute('aria-expanded', String(!isCollapsed));
                rightPanelToggle.setAttribute('aria-label', isCollapsed ? 'Show side panel' : 'Hide side panel');
                const icon = rightPanelToggle.querySelector('.mr-right-toggle-icon');
                if (icon) {
                    icon.textContent = isCollapsed ? '‹' : '›';
                }
            }

            async function postForm(url, values) {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'RequestVerificationToken': token
                    },
                    body: new URLSearchParams(values)
                });

                const payload = await response.json().catch(() => ({ ok: false, message: 'Request failed.' }));
                if (!response.ok || payload.ok === false) {
                    throw new Error(payload.message || 'Request failed.');
                }

                return payload;
            }

            async function copyToClipboard(text) {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(text);
                    return;
                }

                const textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.setAttribute('readonly', '');
                textarea.style.position = 'fixed';
                textarea.style.left = '-9999px';
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                textarea.remove();
            }

            function areaTypeLabel(areaType) {
                switch (String(areaType || 'MEETING').toUpperCase()) {
                    case 'DESK': return 'พื้นที่โต๊ะทำงาน';
                    case 'LOUNGE': return 'พื้นที่คุยสบายๆ';
                    case 'WORK': return 'พื้นที่ทำงานร่วมกัน';
                    case 'QUIET': return 'พื้นที่เงียบ';
                    default: return 'พื้นที่ประชุม';
                }
            }

            function normalizeAreaTone(tone) {
                const allowed = new Set(['blue', 'teal', 'violet', 'rose', 'orange', 'green', 'cyan']);
                tone = String(tone || 'teal').toLowerCase();
                return allowed.has(tone) ? tone : 'teal';
            }

            function normalizeObjectKey(objectKey) {
                const allowed = new Set(['desk-basic', 'chair-office', 'sofa-blue', 'table-round', 'plant-pot', 'plant-tall', 'rug-blue', 'rug-round', 'partition', 'screen', 'board']);
                objectKey = String(objectKey || 'desk-basic').toLowerCase();
                return allowed.has(objectKey) ? objectKey : 'desk-basic';
            }

            function normalizeObjectTone(tone) {
                const allowed = new Set(['wood', 'blue', 'teal', 'violet', 'green', 'orange', 'rose', 'gray']);
                tone = String(tone || 'wood').toLowerCase();
                return allowed.has(tone) ? tone : 'wood';
            }

            function objectTypeLabel(objectType) {
                switch (String(objectType || 'DESK').toUpperCase()) {
                    case 'CHAIR': return 'Chair';
                    case 'SOFA': return 'Sofa';
                    case 'TABLE': return 'Table';
                    case 'PLANT': return 'Plant';
                    case 'RUG': return 'Rug';
                    case 'DIVIDER': return 'Partition';
                    case 'SCREEN': return 'Screen';
                    case 'BOARD': return 'Board';
                    default: return 'Desk';
                }
            }

            function normalizeObjectRotation(rotation) {
                const value = Number(rotation || 0);
                if (!Number.isFinite(value)) return 0;
                const normalized = ((Math.round(value / 90) * 90) % 360 + 360) % 360;
                return normalized;
            }

            function clampObject(object) {
                const w = clampPercent(Math.round(Number(object.w || 8)), 2, 24);
                const h = clampPercent(Math.round(Number(object.h || 5)), 2, 20);
                return {
                    ...object,
                    objectKey: normalizeObjectKey(object.objectKey),
                    tone: normalizeObjectTone(object.tone),
                    x: clampPercent(Math.round(Number(object.x || 30)), 4, Math.max(4, 97 - w)),
                    y: clampPercent(Math.round(Number(object.y || 30)), 7, Math.max(7, 88 - h)),
                    w,
                    h,
                    rotation: normalizeObjectRotation(object.rotation)
                };
            }

            function currentObjectTemplate() {
                const option = document.querySelector(`.mr-object-option[data-object-key="${selectedObjectKey}"]`) ||
                    document.querySelector('.mr-object-option');
                return clampObject({
                    objectId: 0,
                    objectKey: option?.dataset.objectKey || 'desk-basic',
                    objectType: option?.dataset.objectType || 'DESK',
                    title: option?.dataset.title || 'Desk',
                    tone: option?.dataset.tone || 'wood',
                    x: 30,
                    y: 30,
                    w: Number(option?.dataset.w || 8),
                    h: Number(option?.dataset.h || 5),
                    rotation: 0,
                    isObstacle: option?.dataset.obstacle !== 'false'
                });
            }

            function setCustomizeMode(mode) {
                customizeMode = mode === 'object' ? 'object' : 'area';
                root.dataset.customizeMode = customizeMode;
                document.getElementById('customizeAreasTab')?.classList.toggle('is-active', customizeMode === 'area');
                document.getElementById('customizeBuildTab')?.classList.toggle('is-active', customizeMode === 'object');
                document.getElementById('newAreaDraft')?.classList.toggle('is-active', false);
                const help = document.querySelector('.mr-customize-help');
                if (help) {
                    help.textContent = customizeMode === 'object'
                        ? 'เลือกของใน Build objects แล้วคลิกบนพื้นที่ว่างเพื่อวาง จากนั้นกด Save object'
                        : 'ลากบนพื้นที่ว่างเพื่อกำหนดกรอบห้อง หรือเลือกกรอบเดิมบนแผนที่เพื่อแก้ไข';
                }
            }

            function setObjectBounds(element, item) {
                const object = clampObject(item);
                element.style.setProperty('--x', object.x);
                element.style.setProperty('--y', object.y);
                element.style.setProperty('--w', object.w);
                element.style.setProperty('--h', object.h);
                element.style.setProperty('--rotation', `${object.rotation}deg`);
            }

            function upsertObjectShape(item) {
                if (!item?.objectId) return;

                const object = clampObject(item);
                let shape = world.querySelector(`.mr-room-object[data-object-id="${object.objectId}"]`);
                if (!shape) {
                    shape = document.createElement('button');
                    shape.type = 'button';
                    shape.className = 'mr-room-object';
                    shape.innerHTML = '<span class="mr-object-pixel"></span>';
                    const draft = document.getElementById('objectDraft');
                    world.insertBefore(shape, draft || world.querySelector('.mr-person'));
                }

                shape.className = `mr-room-object object-${object.objectKey} tone-${normalizeObjectTone(object.tone)}`;
                shape.dataset.objectId = String(object.objectId);
                shape.dataset.objectKey = object.objectKey;
                shape.dataset.objectType = object.objectType || 'DESK';
                shape.dataset.title = object.title || objectTypeLabel(object.objectType);
                shape.dataset.tone = normalizeObjectTone(object.tone);
                shape.dataset.x = String(object.x);
                shape.dataset.y = String(object.y);
                shape.dataset.w = String(object.w);
                shape.dataset.h = String(object.h);
                shape.dataset.rotation = String(object.rotation);
                shape.dataset.isObstacle = String(object.isObstacle !== false && object.objectType !== 'RUG');
                shape.title = object.title || '';
                shape.setAttribute('aria-label', object.title || 'Room object');
                setObjectBounds(shape, object);
                shape.classList.toggle('is-selected', Number(object.objectId) === selectedObjectId);
            }

            function renderObjectList() {
                const list = document.getElementById('objectList');
                if (!list) return;


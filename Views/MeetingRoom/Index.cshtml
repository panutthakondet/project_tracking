	                }

	                if (targetId === 'toggleCamera') {
	                    await toggleCameraStream();
	                    return;
	                }

	                if (targetId === 'shareScreen') {
	                    await toggleScreenShare();
	                    return;
	                }

	                if (targetId === 'meetingAttachFile' || targetId === 'meetingFileButton' || targetId === 'shareMeetingFile') {
	                    await openMeetingPanel('file');
	                    return;
	                }

                if (targetId === 'meetingPanelMinimize') {
                    minimizeMeetingPanel();
                    return;
                }

                if (targetId === 'meetingPanelLeave') {
                    leaveMeetingPanel();
	                    return;
	                }

	                if (targetId === 'meetingScreenZoomIn') {
                    setMeetingScreenZoom(screenViewerZoom + screenViewerZoomConfig.step);
                    return;
                }

                if (targetId === 'meetingScreenZoomOut') {
                    setMeetingScreenZoom(screenViewerZoom - screenViewerZoomConfig.step);

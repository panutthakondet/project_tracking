                    }

                    desiredScreenOn = true;
                    if (!await ensureLiveKitRoom(currentConversationArea())) {
                        desiredScreenOn = false;
                        syncLiveKitLocalMediaStreams();
                        await broadcastMeetingMediaState({ screenOn: false });
                        return;
                    }

                    try {
                        if (!screenStream) {
                            await liveKitRoom.localParticipant.setScreenShareEnabled(true);
                        }

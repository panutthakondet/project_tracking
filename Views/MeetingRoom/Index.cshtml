            function updateAvatarPreview() {
                if (!avatarDraft) return;

                const preview = document.getElementById('avatarPreviewCharacter');
                if (preview) {
                    applyAvatarToElement(preview, avatarDraft);
                }

                renderAvatarTabs();
                renderAvatarOptions();
            }

            function openAvatarEditor() {
                if (isGuest) {
                    showToast('Guest view ต้อง sign in ก่อนแต่ง avatar');
                    return;
                }

                const current = peopleById.get(currentUserId) || {};
                avatarDraft = normalizeAvatar(current);
                avatarActiveCategory = 'skin';
                document.getElementById('avatarEditor').hidden = false;
                closePopovers();
                updateAvatarPreview();
            }

            function closeAvatarEditor() {
                document.getElementById('avatarEditor').hidden = true;
                avatarDraft = null;
            }

            function randomAvatar() {
                avatarDraft = normalizeAvatar(avatarDraft || peopleById.get(currentUserId) || {});
                avatarCategories.forEach(category => {
                    if (category.field && category.options?.length) {
                        const options = category.options;
                        avatarDraft[category.field] = options[Math.floor(Math.random() * options.length)].value;
                    }
                    if (category.colorField && category.palette?.length) {
                        avatarDraft[category.colorField] = category.palette[Math.floor(Math.random() * category.palette.length)];
                    }
                });
                updateAvatarPreview();
            }

            async function saveAvatarEditor() {
                if (!avatarDraft) return;

                try {
                    const payload = await postForm(root.dataset.characterUrl, avatarPayload(avatarDraft));
                    const avatar = normalizeAvatar(payload.avatar || avatarDraft);
                    applyAvatarToPerson(currentUserId, avatar);
                    closeAvatarEditor();
                    showToast('อัปเดต avatar แล้ว');
                } catch (error) {
                    showToast(error.message || 'อัปเดต avatar ไม่สำเร็จ');
                }
            }

            function syncRightPanelToggle() {
                const isCollapsed = root.classList.contains('is-right-panel-collapsed');
                if (!rightPanelToggle) return;

                rightPanelToggle.setAttribute('aria-expanded', String(!isCollapsed));
                rightPanelToggle.setAttribute('aria-label', isCollapsed ? 'Show side panel' : 'Hide side panel');
                const icon = rightPanelToggle.querySelector('.mr-right-toggle-icon');
                if (icon) {
                    icon.textContent = isCollapsed ? '‹' : '›';
                }
            }

            async function postForm(url, values) {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'RequestVerificationToken': token
                    },
                    body: new URLSearchParams(values)
                });

                const payload = await response.json().catch(() => ({ ok: false, message: 'Request failed.' }));
                if (!response.ok || payload.ok === false) {
                    throw new Error(payload.message || 'Request failed.');
                }

                return payload;
            }

            async function copyToClipboard(text) {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(text);
                    return;
                }

                const textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.setAttribute('readonly', '');
                textarea.style.position = 'fixed';
                textarea.style.left = '-9999px';
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                textarea.remove();
            }

            function areaTypeLabel(areaType) {
                switch (String(areaType || 'MEETING').toUpperCase()) {
                    case 'DESK': return 'พื้นที่โต๊ะทำงาน';
                    case 'LOUNGE': return 'พื้นที่คุยสบายๆ';
                    case 'WORK': return 'พื้นที่ทำงานร่วมกัน';
                    case 'QUIET': return 'พื้นที่เงียบ';
                    default: return 'พื้นที่ประชุม';
                }
            }

            function normalizeAreaTypeValue(areaType) {
                return String(areaType || 'MEETING').trim().toUpperCase();
            }

            function normalizeAreaTone(tone) {
                const allowed = new Set(['blue', 'teal', 'violet', 'rose', 'orange', 'green', 'cyan']);
                tone = String(tone || 'teal').toLowerCase();
                return allowed.has(tone) ? tone : 'teal';
            }

            function normalizeObjectKey(objectKey) {
                objectKey = String(objectKey || 'desk-basic').toLowerCase();
                return objectCatalog.some(item => item.key === objectKey) ? objectKey : 'desk-basic';
            }

            function normalizeObjectTone(tone) {
                const allowed = new Set(['wood', 'blue', 'teal', 'violet', 'green', 'orange', 'rose', 'gray', 'cyan']);
                tone = String(tone || 'wood').toLowerCase();
                return allowed.has(tone) ? tone : 'wood';
            }

            function objectTypeLabel(objectType) {
                switch (String(objectType || 'DESK').toUpperCase()) {
                    case 'CHAIR': return 'Chair';
                    case 'SOFA': return 'Sofa';
                    case 'TABLE': return 'Table';
                    case 'PLANT': return 'Plant';
                    case 'RUG': return 'Rug';
                    case 'DIVIDER': return 'Partition';
                    case 'SCREEN': return 'Screen';
                    case 'BOARD': return 'Board';
                    case 'COMPUTER': return 'Computer';
                    case 'STORAGE': return 'Storage';
                    case 'DECOR': return 'Decor';
                    case 'LIGHT': return 'Light';
                    case 'DOOR': return 'Door';
                    case 'WINDOW': return 'Window';
                    default: return 'Desk';
                }
            }

            function normalizeObjectRotation(rotation) {
                const value = Number(rotation || 0);
                if (!Number.isFinite(value)) return 0;
                const normalized = ((Math.round(value / 90) * 90) % 360 + 360) % 360;
                return normalized;
            }

            function clampObject(object) {
                const w = clampPercent(Math.round(Number(object.w || 8)), 2, 24);
                const h = clampPercent(Math.round(Number(object.h || 5)), 2, 20);
                return {
                    ...object,
                    objectKey: normalizeObjectKey(object.objectKey),
                    tone: normalizeObjectTone(object.tone),
                    x: clampPercent(Math.round(Number(object.x || 30)), 4, Math.max(4, 97 - w)),
                    y: clampPercent(Math.round(Number(object.y || 30)), 7, Math.max(7, 88 - h)),
                    w,
                    h,
                    rotation: normalizeObjectRotation(object.rotation)
                };
            }

            function currentObjectTemplate() {
                const objectKey = normalizeObjectKey(selectedObjectKey);
                const catalogItem = objectCatalog.find(item => item.key === objectKey) || objectCatalog[0];
                return clampObject({
                    objectId: 0,
                    objectKey: catalogItem.key,
                    objectType: catalogItem.type,
                    title: catalogItem.title,
                    tone: catalogItem.tone,
                    x: 30,
                    y: 30,
                    w: Number(catalogItem.w || 8),
                    h: Number(catalogItem.h || 5),
                    rotation: objectTemplateRotations.get(catalogItem.key) ?? 0,
                    isObstacle: catalogItem.obstacle !== false
                });
            }

            function setCustomizeMode(mode) {
                cancelPendingObjectPlacement();
                customizeMode = mode === 'object' ? 'object' : 'area';
                root.dataset.customizeMode = customizeMode;
                document.getElementById('customizeAreasTab')?.classList.toggle('is-active', customizeMode === 'area');
                document.getElementById('customizeBuildTab')?.classList.toggle('is-active', customizeMode === 'object');
                document.getElementById('newAreaDraft')?.classList.toggle('is-active', false);
                const help = document.querySelector('.mr-customize-help');
                if (help) {
                    help.textContent = customizeMode === 'object'
                        ? 'เลือกของใน Build objects แล้วคลิกบนพื้นที่ว่างเพื่อวาง จากนั้นกด Save object'
                        : 'ลากบนพื้นที่ว่างเพื่อกำหนดกรอบห้อง หรือเลือกกรอบเดิมบนแผนที่เพื่อแก้ไข';
                }
            }

            function setObjectBounds(element, item) {
                const object = clampObject(item);
                element.style.setProperty('--x', object.x);
                element.style.setProperty('--y', object.y);
                element.style.setProperty('--w', object.w);
                element.style.setProperty('--h', object.h);
                element.style.setProperty('--rotation', `${object.rotation}deg`);
            }

            function upsertObjectShape(item) {
                if (!item?.objectId) return;

                const object = clampObject(item);
                let shape = world.querySelector(`.mr-room-object[data-object-id="${object.objectId}"]`);
                if (!shape) {
                    shape = document.createElement('button');
                    shape.type = 'button';
                    shape.className = 'mr-room-object';
                    shape.innerHTML = '<span class="mr-object-pixel"></span>';
                    const draft = document.getElementById('objectDraft');
                    world.insertBefore(shape, draft || world.querySelector('.mr-person'));
                }

                shape.className = `mr-room-object object-${object.objectKey} tone-${normalizeObjectTone(object.tone)}`;
                shape.dataset.objectId = String(object.objectId);
                shape.dataset.objectKey = object.objectKey;
                shape.dataset.objectType = object.objectType || 'DESK';
                shape.dataset.title = object.title || objectTypeLabel(object.objectType);
                shape.dataset.tone = normalizeObjectTone(object.tone);
                shape.dataset.x = String(object.x);
                shape.dataset.y = String(object.y);
                shape.dataset.w = String(object.w);
                shape.dataset.h = String(object.h);
                shape.dataset.rotation = String(object.rotation);
                shape.dataset.isObstacle = String(object.isObstacle !== false && object.objectType !== 'RUG');
                shape.title = object.title || '';
                shape.setAttribute('aria-label', object.title || 'Room object');
                setObjectBounds(shape, object);
                shape.classList.toggle('is-selected', Number(object.objectId) === selectedObjectId);
            }

            function objectCategories() {
                return [...new Set(objectCatalog.map(item => item.category || objectTypeLabel(item.type)))];
            }

            function renderObjectCategories() {
                const tabs = document.getElementById('objectCategoryTabs');
                if (!tabs) return;

                tabs.replaceChildren();
                objectCategories().forEach(category => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = `mr-object-category-tab${category === selectedObjectCategory ? ' is-active' : ''}`;
                    button.dataset.objectCategory = category;
                    button.textContent = category;
                    tabs.appendChild(button);
                });
            }

            function renderObjectPalette() {
                const palette = document.getElementById('objectPalette');
                if (!palette) return;

                renderObjectCategories();
                palette.replaceChildren();
                objectCatalog
                    .filter(item => (item.category || objectTypeLabel(item.type)) === selectedObjectCategory)
                    .forEach(item => {
                        const tone = normalizeObjectTone(item.tone);
                        const option = document.createElement('button');
                        option.type = 'button';
                        option.className = `mr-object-option object-${item.key} tone-${tone}`;
                        option.dataset.objectKey = item.key;
                        option.dataset.objectType = item.type;
                        option.dataset.title = item.title;
                        option.dataset.category = item.category || objectTypeLabel(item.type);
                        option.dataset.w = String(item.w);
                        option.dataset.h = String(item.h);
                        option.dataset.tone = tone;
                        option.dataset.obstacle = String(item.obstacle !== false);
                        option.classList.toggle('is-active', normalizeObjectKey(item.key) === selectedObjectKey);
                        option.draggable = true;
                        option.title = `${item.title} · drag to map`;

                        const pixel = document.createElement('span');
                        pixel.className = 'mr-object-pixel';
                        const title = document.createElement('span');
                        title.textContent = item.title;
                        const category = document.createElement('small');
                        category.textContent = item.category || objectTypeLabel(item.type);
                        option.append(pixel, title, category);
                        palette.appendChild(option);
                    });
            }

            function renderObjectList() {
                const list = document.getElementById('objectList');
                if (!list) return;

                list.replaceChildren();
                customObjects.forEach(item => {
                    const object = clampObject(item);
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'mr-object-item';
                    button.dataset.objectId = String(object.objectId);
                    button.classList.toggle('is-active', Number(object.objectId) === selectedObjectId);

                    const mini = document.createElement('span');
                    mini.className = `mr-object-mini object-${object.objectKey} tone-${normalizeObjectTone(object.tone)}`;
                    mini.innerHTML = '<span class="mr-object-pixel"></span>';
                    const text = document.createElement('span');
                    const title = document.createElement('strong');
                    title.textContent = object.title || objectTypeLabel(object.objectType);
                    const meta = document.createElement('small');
                    meta.textContent = `${objectTypeLabel(object.objectType)} · ${object.x},${object.y} · ${object.w}x${object.h} · ${object.rotation}deg`;
                    text.append(title, meta);
                    button.append(mini, text);
                    list.appendChild(button);
                });
            }

            function renderCustomObjects() {
                world.querySelectorAll('.mr-room-object').forEach(shape => {
                    const objectId = Number(shape.dataset.objectId || 0);
                    if (!customObjects.some(item => Number(item.objectId) === objectId)) {
                        shape.remove();
                    }
                });
                customObjects.forEach(upsertObjectShape);
                renderObjectList();
            }

            function setObjectTemplateActive(objectKey) {
                selectedObjectKey = normalizeObjectKey(objectKey);
                const catalogItem = objectCatalog.find(item => item.key === selectedObjectKey);
                if (catalogItem?.category) {
                    selectedObjectCategory = catalogItem.category;
                }
                document.querySelectorAll('.mr-object-option').forEach(option => {
                    option.classList.toggle('is-active', normalizeObjectKey(option.dataset.objectKey) === selectedObjectKey);
                });
                renderObjectCategories();
            }

            function rememberObjectTemplateRotation(objectKey, rotation) {
                objectTemplateRotations.set(normalizeObjectKey(objectKey), normalizeObjectRotation(rotation));
            }

            function setObjectForm(item = null, options = {}) {
                const object = clampObject(item || currentObjectTemplate());
                document.getElementById('objectIdInput').value = object.objectId ? String(object.objectId) : '';
                document.getElementById('objectKeyInput').value = object.objectKey;
                document.getElementById('objectTypeInput').value = object.objectType || 'DESK';
                document.getElementById('objectTitleInput').value = object.title || objectTypeLabel(object.objectType);
                document.getElementById('objectToneInput').value = normalizeObjectTone(object.tone);
                document.getElementById('objectRotationInput').value = String(normalizeObjectRotation(object.rotation));
                document.getElementById('objectXInput').value = Math.round(object.x);
                document.getElementById('objectYInput').value = Math.round(object.y);
                document.getElementById('objectWInput').value = Math.round(object.w);
                document.getElementById('objectHInput').value = Math.round(object.h);
                document.getElementById('objectObstacleInput').checked = object.objectType !== 'RUG' && object.isObstacle !== false;
                document.getElementById('objectObstacleInput').disabled = object.objectType === 'RUG';
                document.getElementById('deleteObject').hidden = !object.objectId;
                selectedObjectId = object.objectId ? Number(object.objectId) : null;
                setObjectTemplateActive(object.objectKey);
                rememberObjectTemplateRotation(object.objectKey, object.rotation);
                if (options.render !== false) {
                    renderCustomObjects();
                }
            }

            function rotateObjectForm(delta) {
                const input = document.getElementById('objectRotationInput');
                if (!input) return;

                input.value = String(normalizeObjectRotation(Number(input.value || 0) + delta));
                rememberObjectTemplateRotation(document.getElementById('objectKeyInput')?.value || selectedObjectKey, input.value);
                if (isCustomizeOpen && customizeMode === 'object') {
                    syncObjectDraftFromForm();
                }
            }

            function formObject() {
                const objectType = document.getElementById('objectTypeInput').value || 'DESK';
                return clampObject({
                    objectId: Number(document.getElementById('objectIdInput').value || 0),
                    objectKey: document.getElementById('objectKeyInput').value || 'desk-basic',
                    objectType,
                    title: document.getElementById('objectTitleInput').value.trim() || objectTypeLabel(objectType),
                    tone: normalizeObjectTone(document.getElementById('objectToneInput').value),
                    x: Math.round(Number(document.getElementById('objectXInput').value || 30)),
                    y: Math.round(Number(document.getElementById('objectYInput').value || 30)),
                    w: Math.round(Number(document.getElementById('objectWInput').value || 8)),
                    h: Math.round(Number(document.getElementById('objectHInput').value || 5)),
                    rotation: normalizeObjectRotation(document.getElementById('objectRotationInput').value),
                    isObstacle: objectType !== 'RUG' && document.getElementById('objectObstacleInput').checked
                });
            }

            function syncObjectDraftFromForm() {
                const draft = document.getElementById('objectDraft');
                if (!draft) return;

                const object = formObject();
                rememberObjectTemplateRotation(object.objectKey, object.rotation);
                draft.hidden = false;
                draft.className = `mr-object-draft object-${object.objectKey} tone-${object.tone}`;
                setObjectBounds(draft, object);
            }

            function nudgeObjectWithKeyboard(dx, dy, step = 1) {
                if (!canCustomize || !isCustomizeOpen || customizeMode !== 'object') {
                    return false;
                }

                const xInput = document.getElementById('objectXInput');
                const yInput = document.getElementById('objectYInput');
                if (!xInput || !yInput) {
                    return false;
                }

                const object = formObject();
                const movedObject = clampObject({
                    ...object,
                    x: object.x + (dx * step),
                    y: object.y + (dy * step)
                });

                xInput.value = Math.round(movedObject.x);
                yInput.value = Math.round(movedObject.y);
                const wInput = document.getElementById('objectWInput');
                const hInput = document.getElementById('objectHInput');
                if (wInput) wInput.value = Math.round(movedObject.w);
                if (hInput) hInput.value = Math.round(movedObject.h);
                syncObjectDraftFromForm();
                return true;
            }

            function clearObjectDraft() {
                selectedObjectId = null;
                document.getElementById('objectDraft')?.setAttribute('hidden', '');
                setObjectForm(currentObjectTemplate());
            }

            function selectObject(objectId) {
                const object = customObjects.find(item => Number(item.objectId) === Number(objectId));
                if (!object) return;

                setCustomizeMode('object');
                setObjectForm(object);
                renderObjectPalette();
                syncObjectDraftFromForm();
            }

            function placeObjectAtPoint(point) {
                const template = currentObjectTemplate();
                const object = clampObject({
                    ...template,
                    objectId: 0,
                    x: Math.round(point.x - (template.w / 2)),
                    y: Math.round(point.y - (template.h / 2))
                });

                setObjectForm(object);
                syncObjectDraftFromForm();
                document.getElementById('objectTitleInput')?.focus();
                showToast('ปรับตำแหน่งได้ แล้วกด Save object');
            }

            function cancelPendingObjectPlacement() {
                window.clearTimeout(pendingObjectPlacementTimer);
                pendingObjectPlacementTimer = null;
            }

            function scheduleObjectPlacement(point) {
                cancelPendingObjectPlacement();
                pendingObjectPlacementTimer = window.setTimeout(() => {
                    pendingObjectPlacementTimer = null;
                    if (isCustomizeOpen && customizeMode === 'object') {
                        placeObjectAtPoint(point);
                    }
                }, 220);
            }

            function objectAtPoint(point, baseObject = currentObjectTemplate(), objectId = 0) {
                return clampObject({
                    ...baseObject,
                    objectId,
                    x: Math.round(point.x - (Number(baseObject.w || 8) / 2)),
                    y: Math.round(point.y - (Number(baseObject.h || 5) / 2))
                });
            }

            function beginPaletteObjectDrag(event, option) {
                if (!canCustomize || !isCustomizeOpen || event.button !== 0) return false;

                setCustomizeMode('object');
                setObjectTemplateActive(option.dataset.objectKey || 'desk-basic');
                selectedObjectId = null;

                const point = mapEventToWorldPoint(event);
                const template = currentObjectTemplate();
                const object = objectAtPoint(point, template);
                objectDragState = {
                    pointerId: event.pointerId,
                    capture: option,
                    source: 'palette',
                    startX: event.clientX,
                    startY: event.clientY,
                    moved: false,
                    template
                };

                option.setPointerCapture?.(event.pointerId);
                root.classList.add('is-object-dragging');
                setObjectForm(object, { render: false });
                syncObjectDraftFromForm();
                event.preventDefault();
                return true;
            }

            function beginExistingObjectDrag(event) {
                const shape = event.target.closest('.mr-room-object');
                if (!shape || !canCustomize || !isCustomizeOpen || customizeMode !== 'object' || event.button !== 0) {
                    return false;
                }

                const objectId = Number(shape.dataset.objectId || 0);
                const object = customObjects.find(item => Number(item.objectId) === objectId);
                if (!object) return false;

                const point = mapEventToWorldPoint(event);
                const clamped = clampObject(object);
                objectDragState = {
                    pointerId: event.pointerId,
                    capture: map,
                    source: 'existing',
                    objectId,
                    startX: event.clientX,
                    startY: event.clientY,
                    moved: false,
                    offsetX: point.x - clamped.x,
                    offsetY: point.y - clamped.y
                };

                map.setPointerCapture?.(event.pointerId);
                root.classList.add('is-object-dragging');
                setObjectForm(clamped, { render: false });
                syncObjectDraftFromForm();
                event.preventDefault();
                return true;
            }

            function updateObjectDrag(event) {
                if (!objectDragState || event.pointerId !== objectDragState.pointerId) return false;

                const dx = event.clientX - objectDragState.startX;
                const dy = event.clientY - objectDragState.startY;
                if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
                    objectDragState.moved = true;
                }

                const point = mapEventToWorldPoint(event);
                const object = objectDragState.source === 'existing'
                    ? clampObject({
                        ...formObject(),
                        objectId: objectDragState.objectId,
                        x: Math.round(point.x - objectDragState.offsetX),
                        y: Math.round(point.y - objectDragState.offsetY)
                    })
                    : objectAtPoint(point, objectDragState.template);

                setObjectForm(object, { render: false });
                syncObjectDraftFromForm();
                event.preventDefault();
                return true;
            }

            function endObjectDrag(event) {
                if (!objectDragState || (event && event.pointerId !== objectDragState.pointerId)) return false;

                const moved = objectDragState.moved;
                const capture = objectDragState.capture;
                if (event && capture?.hasPointerCapture?.(event.pointerId)) {
                    capture.releasePointerCapture(event.pointerId);
                }

                objectDragState = null;
                root.classList.remove('is-object-dragging');

                if (moved) {
                    suppressMapClick = true;
                    suppressObjectClick = true;
                    window.setTimeout(() => {
                        suppressMapClick = false;
                        suppressObjectClick = false;
                    }, 160);
                    showToast('จัดตำแหน่งแล้ว กด Save object เพื่อบันทึก');
                }

                return true;
            }

            function rebuildVoiceAreas() {
                voiceAreas = [
                    ...customAreas,
                    ...defaultVoiceAreas,
                    ...persistedAreas.filter(area => !area.isCustom)
                ];
                document.querySelectorAll('.mr-person').forEach(marker => syncMarkerArea(marker));
            }

            function setAreaBounds(element, area) {
                element.style.setProperty('--x', area.x);
                element.style.setProperty('--y', area.y);
                element.style.setProperty('--w', area.w);
                element.style.setProperty('--h', area.h);
            }

            function upsertAreaShape(area) {
                if (!area?.areaId) return;

                let shape = world.querySelector(`.mr-area-shape[data-area-id="${area.areaId}"]`);
                if (!shape) {
                    shape = document.createElement('button');
                    shape.type = 'button';
                    shape.className = 'mr-area-shape';
                    shape.innerHTML = '<span></span>';
                    const draft = document.getElementById('areaDraft');
                    world.insertBefore(shape, draft || world.querySelector('.mr-person'));
                }

                const ownerUserId = Number(area.ownerUserId || 0);
                const ownerName = String(area.ownerName || '').trim();
                const areaTitle = area.title || 'Meeting area';
                const areaLabel = ownerUserId && ownerName
                    ? `${areaTitle} · เจ้าของ ${ownerName}`
                    : areaTitle;

                shape.className = `mr-area-shape tone-${normalizeAreaTone(area.tone)}${ownerUserId ? ' is-owned' : ''}`;
                shape.dataset.areaId = String(area.areaId);
                shape.dataset.areaKey = area.key || '';
                shape.dataset.title = areaTitle;
                shape.dataset.areaType = area.areaType || 'MEETING';
                shape.dataset.tone = normalizeAreaTone(area.tone);
                shape.dataset.ownerUserId = ownerUserId ? String(ownerUserId) : '';
                shape.dataset.ownerName = ownerName;
                shape.dataset.ownerInitial = area.ownerInitial || '';
                shape.dataset.x = String(area.x);
                shape.dataset.y = String(area.y);
                shape.dataset.w = String(area.w);
                shape.dataset.h = String(area.h);
                shape.title = areaLabel;
                shape.setAttribute('aria-label', areaLabel);

                let titleEl = shape.querySelector('.mr-area-title');
                let ownerEl = shape.querySelector('.mr-area-owner');
                if (!titleEl || !ownerEl) {
                    shape.replaceChildren();
                    titleEl = document.createElement('span');
                    titleEl.className = 'mr-area-title';
                    ownerEl = document.createElement('span');
                    ownerEl.className = 'mr-area-owner';
                    shape.append(titleEl, ownerEl);
                }

                titleEl.replaceChildren(document.createTextNode(areaTitle));
                ownerEl.replaceChildren(document.createTextNode(ownerName ? `เจ้าของ · ${ownerName}` : ''));
                ownerEl.hidden = !ownerUserId || !ownerName;
                setAreaBounds(shape, area);
                shape.classList.toggle('is-selected', Number(area.areaId) === selectedAreaId);
                shape.classList.toggle('is-current-desk', Number(currentDeskAreaId || 0) === Number(area.areaId));
            }

            function renderAreaList() {
                const list = document.getElementById('areaList');
                if (!list) return;

                list.replaceChildren();
                customAreas.forEach(area => {
                    const item = document.createElement('button');
                    item.type = 'button';
                    item.className = 'mr-area-item';
                    item.dataset.areaId = String(area.areaId);
                    item.classList.toggle('is-active', Number(area.areaId) === selectedAreaId);
                    item.classList.toggle('is-current-desk', Number(currentDeskAreaId || 0) === Number(area.areaId));

                    const swatch = document.createElement('span');
                    swatch.className = `mr-area-swatch tone-${normalizeAreaTone(area.tone)}`;
                    const text = document.createElement('span');
                    const title = document.createElement('strong');
                    title.textContent = area.title || 'Meeting area';
                    const meta = document.createElement('small');
                    const ownerText = Number(area.ownerUserId || 0) && area.ownerName
                        ? ` · เจ้าของ ${area.ownerName}`
                        : '';
                    meta.textContent = `${areaTypeLabel(area.areaType)} · ${area.x},${area.y} · ${area.w}x${area.h}${ownerText}`;
                    text.append(title, meta);
                    item.append(swatch, text);
                    list.appendChild(item);
                });
            }

            function renderCustomAreas() {
                world.querySelectorAll('.mr-area-shape').forEach(shape => {
                    const areaId = Number(shape.dataset.areaId || 0);
                    if (!customAreas.some(area => Number(area.areaId) === areaId)) {
                        shape.remove();
                    }
                });
                customAreas.forEach(upsertAreaShape);
                renderAreaList();
                syncCurrentDeskAreaHighlight();
            }

            function setAreaForm(area = {}) {
                document.getElementById('areaIdInput').value = area.areaId ? String(area.areaId) : '';
                document.getElementById('areaTitleInput').value = area.title || '';
                document.getElementById('areaTypeInput').value = area.areaType || 'MEETING';
                document.getElementById('areaToneInput').value = normalizeAreaTone(area.tone);
                document.getElementById('areaXInput').value = Math.round(area.x ?? 30);
                document.getElementById('areaYInput').value = Math.round(area.y ?? 30);
                document.getElementById('areaWInput').value = Math.round(area.w ?? 18);
                document.getElementById('areaHInput').value = Math.round(area.h ?? 14);
                document.getElementById('deleteArea').hidden = !area.areaId;
                selectedAreaId = area.areaId ? Number(area.areaId) : null;
                renderCustomAreas();
            }

            function formArea() {
                return {
                    areaId: Number(document.getElementById('areaIdInput').value || 0),
                    title: document.getElementById('areaTitleInput').value.trim(),
                    areaType: document.getElementById('areaTypeInput').value,
                    tone: normalizeAreaTone(document.getElementById('areaToneInput').value),
                    x: Math.round(Number(document.getElementById('areaXInput').value || 30)),
                    y: Math.round(Number(document.getElementById('areaYInput').value || 30)),
                    w: Math.round(Number(document.getElementById('areaWInput').value || 18)),
                    h: Math.round(Number(document.getElementById('areaHInput').value || 14))
                };
            }

            function syncDraftFromForm() {
                const draft = document.getElementById('areaDraft');
                if (!draft) return;

                const area = formArea();
                draft.hidden = false;
                draft.className = `mr-area-draft tone-${area.tone}`;
                setAreaBounds(draft, area);
            }

            function clearAreaDraft() {
                selectedAreaId = null;
                document.getElementById('areaDraft')?.setAttribute('hidden', '');
                setAreaForm({ tone: 'teal', areaType: 'MEETING', x: 30, y: 30, w: 18, h: 14 });
            }

            function selectArea(areaId) {
                const area = customAreas.find(item => Number(item.areaId) === Number(areaId));
                if (!area) return;

                setAreaForm(area);
                syncDraftFromForm();
            }

            function clampCustomizePanel(left, top) {
                const panel = document.getElementById('customizePanel');
                if (!panel) return { left, top };

                const roomRect = root.getBoundingClientRect();
                const panelRect = panel.getBoundingClientRect();
                const padding = 10;
                const maxLeft = Math.max(padding, roomRect.width - panelRect.width - padding);
                const maxTop = Math.max(padding, roomRect.height - panelRect.height - padding);

                return {
                    left: clampPercent(left, padding, maxLeft),
                    top: clampPercent(top, padding, maxTop)
                };
            }

            function setCustomizePanelPosition(left, top) {
                const panel = document.getElementById('customizePanel');
                if (!panel) return;

                const next = clampCustomizePanel(left, top);
                panel.style.left = `${next.left}px`;
                panel.style.top = `${next.top}px`;
                panel.style.right = 'auto';
            }

            function ensureCustomizePanelInView() {
                const panel = document.getElementById('customizePanel');
                if (!panel || panel.hidden) return;

                const roomRect = root.getBoundingClientRect();
                const panelRect = panel.getBoundingClientRect();
                const left = panelRect.left - roomRect.left;
                const top = panelRect.top - roomRect.top;
                setCustomizePanelPosition(left, top);
            }

            function openCustomizePanel() {
                if (!canCustomize) return;

                closePopovers();
                isCustomizeOpen = true;
                root.classList.add('is-customizing');
                setCustomizeMode(customizeMode);
                const panel = document.getElementById('customizePanel');
                panel.hidden = false;
                if (!panel.style.left) {
                    const roomRect = root.getBoundingClientRect();
                    const panelRect = panel.getBoundingClientRect();
                    setCustomizePanelPosition(roomRect.width - panelRect.width - 14, 74);
                } else {
                    ensureCustomizePanelInView();
                }
                renderCustomAreas();
                renderCustomObjects();
                showToast('ลากบนพื้นที่ว่างเพื่อสร้างแอเรียใหม่');
            }

            function closeCustomizePanel() {
                cancelPendingObjectPlacement();
                isCustomizeOpen = false;
                root.classList.remove('is-customizing');
                document.getElementById('customizePanel').hidden = true;
                document.getElementById('areaDraft')?.setAttribute('hidden', '');
                document.getElementById('objectDraft')?.setAttribute('hidden', '');
                world.querySelectorAll('.mr-area-shape.is-selected').forEach(shape => shape.classList.remove('is-selected'));
                world.querySelectorAll('.mr-room-object.is-selected').forEach(shape => shape.classList.remove('is-selected'));
            }

            function closePopovers() {
                personPopover.hidden = true;
                selfPopover.hidden = true;
                document.getElementById('messageForm').hidden = true;
                document.querySelectorAll('.mr-person-row.is-selected').forEach(row => row.classList.remove('is-selected'));
            }

            function hasOpenPopover() {
                return !personPopover.hidden || !selfPopover.hidden;
            }

            function positionPopover(popover, source) {
                const roomRect = root.getBoundingClientRect();
                const sourceRect = source.getBoundingClientRect();
                const width = Math.min(popover.offsetWidth || 360, window.innerWidth - 24);
                let left = sourceRect.left - roomRect.left + sourceRect.width + 12;
                let top = sourceRect.top - roomRect.top - 24;

                if (left + width > window.innerWidth - 12) {
                    left = sourceRect.left - roomRect.left - width - 12;
                }

                if (left < 12) {
                    left = 12;
                }

                top = Math.max(66, Math.min(top, window.innerHeight - Math.min(popover.offsetHeight || 430, window.innerHeight - 24) - 12));
                popover.style.left = `${left}px`;
                popover.style.top = `${top}px`;
            }

            function focusPerson(userId) {
                const marker = map.querySelector(`.mr-person[data-user-id="${userId}"]`);
                if (!marker) return;

                marker.scrollIntoView({ block: 'center', inline: 'center', behavior: 'smooth' });
                marker.classList.remove('is-pulse');
                void marker.offsetWidth;
                marker.classList.add('is-pulse');
                window.setTimeout(() => marker.classList.remove('is-pulse'), 3200);
            }

            function syncFollowButton() {
                const button = document.getElementById('followPerson');
                if (!button || !selectedUserId) return;

                const isFollowing = followedUserId === selectedUserId;
                button.classList.toggle('is-active', isFollowing);
                button.querySelector('.mr-menu-text strong')?.replaceChildren(document.createTextNode(isFollowing ? 'Following' : 'Follow'));
                button.querySelector('.mr-menu-text span')?.replaceChildren(document.createTextNode(isFollowing ? 'กำลังติดตามตำแหน่งคนนี้' : 'ติดตามตำแหน่งคนนี้ในหน้าแผนที่'));
            }

            function stopFollowing() {
                followedUserId = null;
                window.clearInterval(followTimer);
                followTimer = null;
                syncFollowButton();
            }

            function toggleFollowPerson(userId) {
                if (!userId) return;

                if (followedUserId === Number(userId)) {
                    stopFollowing();
                    showToast('หยุดติดตามแล้ว');
                    return;
                }

                followedUserId = Number(userId);
                window.clearInterval(followTimer);
                focusPerson(followedUserId);
                followTimer = window.setInterval(() => {
                    if (!followedUserId || !getPersonMarker(followedUserId)) {
                        stopFollowing();
                        return;
                    }

                    focusPerson(followedUserId);
                }, 5000);
                syncFollowButton();
                const person = peopleById.get(followedUserId);
                showToast(person ? `กำลังติดตาม ${person.displayName}` : 'Follow enabled.');
            }

            function getPersonMarker(userId) {
                return map.querySelector(`.mr-person[data-user-id="${userId}"]`);
            }

            function markerPercent(marker, key, fallback) {
                const value = Number(marker?.dataset?.[key] || fallback);
                return Number.isFinite(value) ? value : fallback;
            }

            function clampPercent(value, min, max) {
                const next = Number(value);
                if (!Number.isFinite(next)) return min;
                return Math.max(min, Math.min(max, next));
            }

            function normalizeAreaKey(value) {
                return String(value || '')
                    .trim()
                    .toLowerCase()
                    .replace(/[^a-z0-9ก-๙]+/g, '-')
                    .replace(/^-+|-+$/g, '') || 'open-area';
            }

            function isDeskArea(area) {
                return normalizeAreaTypeValue(area?.areaType) === 'DESK';
            }

            function areaContainsPoint(area, point, padding = 0) {
                if (!area || !point) return false;

                return point.x >= area.x - padding &&
                    point.x <= area.x + area.w + padding &&
                    point.y >= area.y - padding &&
                    point.y <= area.y + area.h + padding;
            }

            function clearAreaOwnerForUser(userId) {
                const ownerId = Number(userId || 0);
                if (!ownerId) return false;

                let changed = false;
                customAreas.forEach(area => {
                    if (Number(area.ownerUserId || 0) === ownerId) {
                        area.ownerUserId = 0;
                        area.ownerName = '';
                        area.ownerInitial = '';
                        changed = true;
                    }
                });
                return changed;
            }

            function setAreaOwner(areaId, userId, ownerName, ownerInitial) {
                const area = customAreas.find(item => Number(item.areaId) === Number(areaId));
                const ownerId = Number(userId || 0);
                if (!area || !ownerId) return false;

                area.ownerUserId = ownerId;
                area.ownerName = String(ownerName || '').trim() || 'Someone';
                area.ownerInitial = String(ownerInitial || '').trim() || area.ownerName.charAt(0).toUpperCase();
                return true;
            }

            function personOwnsDeskArea(person, area) {
                if (!person || !isDeskArea(area)) return false;

                const homeKey = normalizeAreaKey(person.homeZone || '');
                const titleMatches = homeKey &&
                    (normalizeAreaKey(area.title) === homeKey || normalizeAreaKey(area.key) === homeKey);
                if (!titleMatches) return false;

                const homePoint = {
                    x: Number(person.homeX),
                    y: Number(person.homeY)
                };
                return Number.isFinite(homePoint.x) &&
                    Number.isFinite(homePoint.y) &&
                    areaContainsPoint(area, homePoint, .75);
            }

            function syncPersonDeskAreaOwner(userId) {
                const ownerId = Number(userId || 0);
                const person = peopleById.get(ownerId);
                if (!ownerId || !person) return false;

                let changed = clearAreaOwnerForUser(ownerId);
                const area = customAreas.find(item => personOwnsDeskArea(person, item));
                if (area) {
                    changed = setAreaOwner(area.areaId, ownerId, person.displayName, person.initial) || changed;
                }

                return changed;
            }

            function currentHomeState() {
                const marker = getPersonMarker(currentUserId);
                const person = peopleById.get(currentUserId) || {};
                const fallbackX = Number(person.homeX ?? person.x ?? 50);
                const fallbackY = Number(person.homeY ?? person.y ?? 50);

                return {
                    x: markerPercent(marker, 'homeX', Number.isFinite(fallbackX) ? fallbackX : 50),
                    y: markerPercent(marker, 'homeY', Number.isFinite(fallbackY) ? fallbackY : 50),
                    zone: marker?.dataset.homeZone || person.homeZone || ''
                };
            }

            function inferCurrentDeskAreaId() {
                const home = currentHomeState();
                const homeKey = normalizeAreaKey(home.zone);
                const matched = customAreas.find(area => {
                    if (!isDeskArea(area)) return false;

                    const titleMatches = homeKey &&
                        (normalizeAreaKey(area.title) === homeKey || normalizeAreaKey(area.key) === homeKey);
                    return titleMatches && areaContainsPoint(area, home, .75);
                });

                return matched ? Number(matched.areaId) : 0;
            }

            function syncCurrentDeskAreaHighlight() {
                if (currentDeskAreaId === null) {
                    currentDeskAreaId = inferCurrentDeskAreaId();
                }

                const activeAreaId = Number(currentDeskAreaId || 0);
                world.querySelectorAll('.mr-area-shape').forEach(shape => {
                    shape.classList.toggle('is-current-desk', activeAreaId > 0 && Number(shape.dataset.areaId || 0) === activeAreaId);
                });
                document.querySelectorAll('.mr-area-item').forEach(item => {
                    item.classList.toggle('is-current-desk', activeAreaId > 0 && Number(item.dataset.areaId || 0) === activeAreaId);
                });
            }

            function applyDeskAreaPayload(payload) {
                const marker = getPersonMarker(currentUserId);
                const person = peopleById.get(currentUserId);
                const homeX = Number(payload?.homeX);
                const homeY = Number(payload?.homeY);
                const homeZone = payload?.homeZone || '';

                if (marker) {
                    if (Number.isFinite(homeX)) {
                        marker.dataset.homeX = String(homeX);
                    }
                    if (Number.isFinite(homeY)) {
                        marker.dataset.homeY = String(homeY);
                    }
                    marker.dataset.homeZone = homeZone;
                }

                if (person) {
                    if (Number.isFinite(homeX)) {
                        person.homeX = homeX;
                    }
                    if (Number.isFinite(homeY)) {
                        person.homeY = homeY;
                    }
                    person.homeZone = homeZone;
                }

                currentDeskAreaId = payload?.selected
                    ? Number(payload.areaId || payload.area?.areaId || 0)
                    : 0;

                let ownerChanged = clearAreaOwnerForUser(currentUserId);
                if (payload?.selected && currentDeskAreaId) {
                    ownerChanged = setAreaOwner(
                        currentDeskAreaId,
                        currentUserId,
                        payload.ownerName || payload.area?.ownerName || person?.displayName || 'You',
                        payload.ownerInitial || payload.area?.ownerInitial || person?.initial || ''
                    ) || ownerChanged;
                }

                if (ownerChanged) {
                    renderCustomAreas();
                } else {
                    syncCurrentDeskAreaHighlight();
                }
            }

            async function toggleDeskAreaSelection(areaButton) {
                if (!areaButton) return false;

                if (isGuest) {
                    showToast('Guest view ต้อง sign in ก่อนเลือกห้องของตัวเอง');
                    return true;
                }

                if (!root.dataset.setDeskAreaUrl) {
                    showToast('ยังไม่ได้เปิดระบบเลือกห้องส่วนตัว');
                    return true;
                }

                const areaId = Number(areaButton.dataset.areaId || 0);
                const area = customAreas.find(item => Number(item.areaId) === areaId) || {
                    areaId,
                    title: areaButton.dataset.title || '',
                    areaType: areaButton.dataset.areaType || 'MEETING',
                    ownerUserId: Number(areaButton.dataset.ownerUserId || 0),
                    ownerName: areaButton.dataset.ownerName || ''
                };

                if (!areaId || !isDeskArea(area)) {
                    showToast('เลือกได้เฉพาะพื้นที่ชนิด Desk เท่านั้น');
                    return true;
                }

                const isSelected = Number(currentDeskAreaId || 0) === areaId;
                const ownerUserId = Number(area.ownerUserId || areaButton.dataset.ownerUserId || 0);
                const ownerName = area.ownerName || areaButton.dataset.ownerName || 'Someone';
                if (!isSelected && ownerUserId && ownerUserId !== currentUserId) {
                    showToast(`ห้องนี้มีเจ้าของแล้ว: ${ownerName}`);
                    return true;
                }

                const areaTitle = area.title || areaButton.dataset.title || 'พื้นที่นี้';
                const confirmMessage = isSelected
                    ? `ยืนยันยกเลิก "${areaTitle}" จากห้องของคุณ?`
                    : `ยืนยันจอง "${areaTitle}" เป็นห้องของคุณ?`;
                if (!window.confirm(confirmMessage)) {
                    showToast(isSelected ? 'ยังไม่ได้ยกเลิกห้องส่วนตัว' : 'ยังไม่ได้จองห้อง');
                    return true;
                }

                try {
                    const payload = await postForm(root.dataset.setDeskAreaUrl, {
                        areaId: isSelected ? 0 : areaId
                    });
                    applyDeskAreaPayload(payload);
                    showToast(payload.message || (isSelected ? 'ยกเลิกห้องส่วนตัวแล้ว' : 'ตั้งเป็นห้องของคุณแล้ว'));
                } catch (error) {
                    showToast(error.message || 'เลือกห้องไม่สำเร็จ');
                }

                return true;
            }

            function cancelPendingDeskAreaSelection() {
                window.clearTimeout(pendingDeskAreaSelectionTimer);
                pendingDeskAreaSelectionTimer = null;
            }

            function scheduleDeskAreaSelection(areaButton) {
                cancelPendingDeskAreaSelection();
                pendingDeskAreaSelectionTimer = window.setTimeout(async () => {
                    pendingDeskAreaSelectionTimer = null;
                    await toggleDeskAreaSelection(areaButton);
                }, 240);
            }

            function areaFromButton(areaButton) {
                if (!areaButton) return null;

                const areaId = Number(areaButton.dataset.areaId || 0);
                const area = customAreas.find(item => Number(item.areaId) === areaId);
                if (area) return area;

                return {
                    areaId,
                    key: areaButton.dataset.areaKey || '',
                    title: areaButton.dataset.title || '',
                    areaType: areaButton.dataset.areaType || 'MEETING',
                    x: Number(areaButton.dataset.x || 0),
                    y: Number(areaButton.dataset.y || 0),
                    w: Number(areaButton.dataset.w || 0),
                    h: Number(areaButton.dataset.h || 0)
                };
            }

            function clampPointToArea(point, area, margin = 1.2) {
                if (!area) return clampPoint(point);

                const x = Number(area.x || 0);
                const y = Number(area.y || 0);
                const w = Number(area.w || 0);
                const h = Number(area.h || 0);
                if (!Number.isFinite(x) || !Number.isFinite(y) || !Number.isFinite(w) || !Number.isFinite(h) || w <= 0 || h <= 0) {
                    return clampPoint(point);
                }

                const minX = Math.min(x + margin, x + (w / 2));
                const maxX = Math.max(x + w - margin, x + (w / 2));
                const minY = Math.min(y + margin, y + (h / 2));
                const maxY = Math.max(y + h - margin, y + (h / 2));
                return clampPoint({
                    x: clampPercent(point.x, minX, maxX),
                    y: clampPercent(point.y, minY, maxY)
                });
            }

            function walkToAreaPoint(areaButton, event) {
                const area = areaFromButton(areaButton);
                if (!area) return false;

                const clickedPoint = event ? mapEventToWorldPoint(event) : {
                    x: Number(area.x) + (Number(area.w) / 2),
                    y: Number(area.y) + (Number(area.h) / 2)
                };
                const destination = clampPointToArea(clickedPoint, area);
                const x = destination.x;
                const y = destination.y;
                if (!Number.isFinite(x) || !Number.isFinite(y)) return false;

                closePopovers();
                walkCurrentToPoint(x, y, { closePopovers: false, area });
                showToast(isDeskArea(area) ? 'กำลังเดินกลับห้อง' : `กำลังเดินไป ${area.title || 'พื้นที่นี้'}`);
                return true;
            }

            function fallbackAreaForPoint(point) {
                const row = point.y < 37 ? 'north' : point.y < 65 ? 'middle' : 'south';
                const column = point.x < 33 ? 'left' : point.x < 66 ? 'center' : 'right';
                const titles = {
                    'north-left': 'North Lobby Walkway',
                    'north-center': 'North Work Walkway',
                    'north-right': 'North Garden Walkway',
                    'middle-left': 'West Work Walkway',
                    'middle-center': 'Center Work Walkway',
                    'middle-right': 'East Work Walkway',
                    'south-left': 'South Lobby Walkway',
                    'south-center': 'South Board Walkway',
                    'south-right': 'South Meeting Walkway'
                };
                const key = `${row}-${column}`;

                return {
                    key,
                    title: titles[key] || 'Open Area',
                    x: column === 'left' ? walkBounds.minX : column === 'center' ? 33 : 66,
                    y: row === 'north' ? walkBounds.minY : row === 'middle' ? 37 : 65,
                    w: column === 'left' ? 29 : 33,
                    h: row === 'north' ? 30 : row === 'middle' ? 28 : walkBounds.maxY - 65
                };
            }

            function areaForPoint(x, y) {
                const point = {
                    x: clampPercent(x, walkBounds.minX, walkBounds.maxX),
                    y: clampPercent(y, walkBounds.minY, walkBounds.maxY)
                };

                const matched = voiceAreas.find(area =>
                    point.x >= area.x &&
                    point.x <= area.x + area.w &&
                    point.y >= area.y &&
                    point.y <= area.y + area.h
                );

                if (!matched) {
                    return fallbackAreaForPoint(point);
                }

                return {
                    ...matched,
                    key: normalizeAreaKey(matched.key || matched.title)
                };
            }

            function markerArea(marker) {
                if (!marker) {
                    return fallbackAreaForPoint({ x: 50, y: 50 });
                }

                return areaForPoint(markerPercent(marker, 'x', 50), markerPercent(marker, 'y', 50));
            }

            function syncRowArea(userId, areaTitle) {
                document.querySelectorAll(`.mr-person-row[data-user-id="${userId}"]`).forEach(row => {
                    const person = peopleById.get(Number(userId));
                    const text = row.querySelector('.mr-row-main span');
                    if (text && person) {
                        text.textContent = `${person.statusLabel} · ${areaTitle}`;
                    }
                });
            }

            function syncMarkerArea(marker) {
                if (!marker) return fallbackAreaForPoint({ x: 50, y: 50 });

                const area = markerArea(marker);
                const userId = Number(marker.dataset.userId || 0);
                marker.dataset.zone = area.title;
                marker.dataset.voiceArea = area.key;

                const person = peopleById.get(userId);
                if (person) {
                    person.zone = area.title;
                    person.voiceArea = area.key;
                }

                syncRowArea(userId, area.title);
                return area;
            }

            function currentConversationArea() {
                return syncMarkerArea(getPersonMarker(currentUserId));
            }

            function targetConversationArea(userId) {
                return syncMarkerArea(getPersonMarker(userId));
            }

            function sameConversationArea(targetUserId) {
                const currentArea = currentConversationArea();
                const targetArea = targetConversationArea(targetUserId);
                return currentArea.key === targetArea.key;
            }

            function isMeetingArea(area) {
                if (!area) return false;

                const type = String(area.areaType || '').trim().toUpperCase();
                const key = normalizeAreaKey(area.key || area.title || '');
                return type === 'MEETING' ||
                    key === 'meeting' ||
                    key === 'meeting-room';
            }

            function clearAutoMeetingTimer() {
                window.clearTimeout(autoMeetingTimer);
                autoMeetingTimer = null;
                autoMeetingAreaKey = '';
            }

            function scheduleAutoMeetingMode(area) {
                if (isGuest || !area || isCustomizeOpen || isCurrentDnd()) {
                    clearAutoMeetingTimer();
                    return;
                }

                if (!isMeetingArea(area)) {
                    dismissedMeetingAreaKey = '';
                    clearAutoMeetingTimer();
                    return;
                }

                const areaKey = normalizeAreaKey(area.key || area.title || '');
                if (!areaKey || dismissedMeetingAreaKey === areaKey) {
                    clearAutoMeetingTimer();
                    return;
                }

                if (isMeetingPanelOpen() && normalizeAreaKey(activeMeetingArea?.key || activeMeetingArea?.title || '') === areaKey) {
                    clearAutoMeetingTimer();
                    return;
                }

                if (autoMeetingTimer && autoMeetingAreaKey === areaKey) {
                    return;
                }

                window.clearTimeout(autoMeetingTimer);
                autoMeetingAreaKey = areaKey;
                autoMeetingTimer = window.setTimeout(async () => {
                    autoMeetingTimer = null;

                    const currentArea = currentConversationArea();
                    const currentKey = normalizeAreaKey(currentArea.key || currentArea.title || '');
                    if (currentKey !== areaKey || !isMeetingArea(currentArea) || dismissedMeetingAreaKey === areaKey || isCustomizeOpen) {
                        return;
                    }

                    const opened = await openMeetingPanel('auto');
                    if (opened) {
                        showToast(`เข้าสู่โหมดประชุม: ${currentArea.title || 'Meeting'}`);
                    }
                }, 320);
            }

            function requireSameConversationArea(targetUserId, actionLabel) {
                if (!targetUserId) return false;

                const person = peopleById.get(Number(targetUserId));
                const currentArea = currentConversationArea();
                const targetArea = targetConversationArea(targetUserId);
                if (currentArea.key === targetArea.key) {
                    return true;
                }

                showToast(`ต้องอยู่เอเรียเดียวกันก่อนถึงจะ${actionLabel}ได้ (${currentArea.title} → ${targetArea.title})`);
                if (person) {
                    focusPerson(targetUserId);
                }
                return false;
            }

            function constrainPointToArea(point, area) {
                if (!area) return clampPoint(point);

                const padding = 2.2;
                return clampPoint({
                    x: clampPercent(point.x, area.x + padding, area.x + area.w - padding),
                    y: clampPercent(point.y, area.y + padding, area.y + area.h - padding)
                });
            }

            function applyRoomZoom(nextZoom, options = {}) {
                roomZoom = Number(clampPercent(nextZoom, zoomConfig.min, zoomConfig.max).toFixed(2));
                world.style.setProperty('--mr-zoom', roomZoom);
                map.classList.toggle('is-pannable', roomZoom > 1.01);

                if (options.resetPan || roomZoom <= 1) {
                    setRoomPan(0, 0);
                } else {
                    setRoomPan(roomPanX, roomPanY);
                }

                document.getElementById('zoomInRoom')?.toggleAttribute('disabled', roomZoom >= zoomConfig.max);
                document.getElementById('zoomOutRoom')?.toggleAttribute('disabled', roomZoom <= zoomConfig.min);

                if (options.announce) {
                    showToast(`Zoom ${Math.round(roomZoom * 100)}%`);
                }
            }

            function changeRoomZoom(delta, options = {}) {
                applyRoomZoom(roomZoom + delta, options);
            }

            function maxRoomPan() {
                const rect = map.getBoundingClientRect();
                return {
                    x: Math.max(0, (rect.width * (roomZoom - 1)) / 2),
                    y: Math.max(0, (rect.height * (roomZoom - 1)) / 2)
                };
            }

            function setRoomPan(x, y) {
                const max = maxRoomPan();
                roomPanX = clampPercent(x, -max.x, max.x);
                roomPanY = clampPercent(y, -max.y, max.y);
                world.style.setProperty('--mr-pan-x', `${roomPanX}px`);
                world.style.setProperty('--mr-pan-y', `${roomPanY}px`);
            }

            function mapEventToWorldPoint(event) {
                const rect = map.getBoundingClientRect();
                const localX = event.clientX - rect.left - roomPanX;
                const localY = event.clientY - rect.top - roomPanY;
                const worldX = ((localX - (rect.width / 2)) / roomZoom) + (rect.width / 2);
                const worldY = ((localY - (rect.height / 2)) / roomZoom) + (rect.height / 2);

                return {
                    x: (worldX / rect.width) * 100,
                    y: (worldY / rect.height) * 100
                };
            }

            function normalizedDraftArea(from, to) {
                const start = clampAreaPoint(from);
                const end = clampAreaPoint(to);
                const x = Math.min(start.x, end.x);
                const y = Math.min(start.y, end.y);
                const w = Math.max(2, Math.abs(end.x - start.x));
                const h = Math.max(2, Math.abs(end.y - start.y));

                return {
                    x: Math.round(x),
                    y: Math.round(y),
                    w: Math.round(w),
                    h: Math.round(h),
                    tone: normalizeAreaTone(document.getElementById('areaToneInput')?.value || 'teal')
                };
            }

            function clampArea(area) {
                const maxW = areaBounds.maxX - areaBounds.minX;
                const maxH = areaBounds.maxY - areaBounds.minY;
                const w = clampPercent(Math.round(Number(area.w ?? 18)), 2, maxW);
                const h = clampPercent(Math.round(Number(area.h ?? 14)), 2, maxH);

                return {
                    ...area,
                    tone: normalizeAreaTone(area.tone),
                    x: clampPercent(Math.round(Number(area.x ?? 30)), areaBounds.minX, areaBounds.maxX - w),
                    y: clampPercent(Math.round(Number(area.y ?? 30)), areaBounds.minY, areaBounds.maxY - h),
                    w,
                    h
                };
            }

            function beginExistingAreaDrag(event) {
                const shape = event.target.closest('.mr-area-shape');
                if (!shape || !canCustomize || !isCustomizeOpen || customizeMode !== 'area' || event.button !== 0) {
                    return false;
                }

                const areaId = Number(shape.dataset.areaId || 0);
                const area = customAreas.find(item => Number(item.areaId) === areaId);
                if (!area) return false;

                const point = mapEventToWorldPoint(event);
                const clamped = clampArea(area);
                areaDragState = {
                    pointerId: event.pointerId,
                    areaId,
                    startX: event.clientX,
                    startY: event.clientY,
                    offsetX: point.x - clamped.x,
                    offsetY: point.y - clamped.y,
                    moved: false
                };

                map.setPointerCapture?.(event.pointerId);
                root.classList.add('is-area-dragging');
                setAreaForm(clamped);
                syncDraftFromForm();
                event.preventDefault();
                return true;
            }

            function updateAreaDrag(event) {
                if (!areaDragState || event.pointerId !== areaDragState.pointerId) return false;

                const dx = event.clientX - areaDragState.startX;
                const dy = event.clientY - areaDragState.startY;
                if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
                    areaDragState.moved = true;
                }

                const point = mapEventToWorldPoint(event);
                const area = clampArea({
                    ...formArea(),
                    areaId: areaDragState.areaId,
                    x: point.x - areaDragState.offsetX,
                    y: point.y - areaDragState.offsetY
                });

                setAreaForm(area);
                syncDraftFromForm();
                const shape = world.querySelector(`.mr-area-shape[data-area-id="${area.areaId}"]`);
                if (shape) {
                    setAreaBounds(shape, area);
                }

                event.preventDefault();
                return true;
            }

            function endAreaDrag(event) {
                if (!areaDragState || (event && event.pointerId !== areaDragState.pointerId)) return false;

                const moved = areaDragState.moved;
                if (event && map.hasPointerCapture?.(event.pointerId)) {
                    map.releasePointerCapture(event.pointerId);
                }

                areaDragState = null;
                root.classList.remove('is-area-dragging');

                if (moved) {
                    suppressMapClick = true;
                    window.setTimeout(() => {
                        suppressMapClick = false;
                    }, 160);
                    showToast('ย้ายพื้นที่แล้ว กด Save area เพื่อบันทึก');
                }

                return true;
            }

            function startAreaDraw(event) {
                if (!canCustomize || !isCustomizeOpen) return false;
                if (customizeMode !== 'area') return false;
                if (event.target.closest('.mr-person, .mr-map-tools, .mr-popover, .mr-customize-panel, .mr-area-shape, .mr-room-object')) return false;

                const point = mapEventToWorldPoint(event);
                areaDrawState = {
                    pointerId: event.pointerId,
                    start: point,
                    current: point,
                    moved: false
                };

                selectedAreaId = null;
                map.setPointerCapture?.(event.pointerId);
                syncDraftFromArea(normalizedDraftArea(point, point));
                event.preventDefault();
                return true;
            }

            function syncDraftFromArea(area) {
                const draft = document.getElementById('areaDraft');
                if (!draft) return;

                draft.hidden = false;
                draft.className = `mr-area-draft tone-${normalizeAreaTone(area.tone)}`;
                setAreaBounds(draft, area);
            }

            function updateAreaDraw(event) {
                if (!areaDrawState || event.pointerId !== areaDrawState.pointerId) return false;

                const point = mapEventToWorldPoint(event);
                areaDrawState.current = point;
                if (pointDistance(areaDrawState.start, point) > 1) {
                    areaDrawState.moved = true;
                }

                syncDraftFromArea(normalizedDraftArea(areaDrawState.start, point));
                event.preventDefault();
                return true;
            }

            function endAreaDraw(event) {
                if (!areaDrawState || (event && event.pointerId !== areaDrawState.pointerId)) return false;

                const area = normalizedDraftArea(areaDrawState.start, areaDrawState.current);
                const moved = areaDrawState.moved && area.w >= 5 && area.h >= 5;

                if (event && map.hasPointerCapture?.(event.pointerId)) {
                    map.releasePointerCapture(event.pointerId);
                }

                areaDrawState = null;
                if (!moved) {
                    document.getElementById('areaDraft')?.setAttribute('hidden', '');
                    return true;
                }

                setAreaForm({
                    areaType: document.getElementById('areaTypeInput')?.value || 'MEETING',
                    tone: area.tone,
                    x: area.x,
                    y: area.y,
                    w: area.w,
                    h: area.h
                });
                syncDraftFromForm();
                document.getElementById('areaTitleInput')?.focus();
                showToast('ตั้งชื่อพื้นที่แล้วกด Save area');
                return true;
            }

            function clampPoint(point) {
                return {
                    x: clampPercent(point.x, walkBounds.minX, walkBounds.maxX),
                    y: clampPercent(point.y, walkBounds.minY, walkBounds.maxY)
                };
            }

            function clampAreaPoint(point) {
                return {
                    x: clampPercent(point.x, areaBounds.minX, areaBounds.maxX),
                    y: clampPercent(point.y, areaBounds.minY, areaBounds.maxY)
                };
            }

            function roundPercent(value) {
                return Number(value.toFixed(2));
            }

            function pointDistance(a, b) {
                return Math.hypot(a.x - b.x, a.y - b.y);
            }

            function setMarkerPosition(marker, x, y) {
                marker.dataset.x = String(x);
                marker.dataset.y = String(y);
                marker.style.setProperty('--x', x);
                marker.style.setProperty('--y', y);
                const area = syncMarkerArea(marker);
                scheduleProximityVoiceRefresh();
                refreshMeetingPanel();
                if (Number(marker.dataset.userId || 0) === currentUserId) {
                    scheduleAutoMeetingMode(area);
                }
            }

            function updateMarkerStatusClasses(marker, status) {
                if (!marker) return;

                [...marker.classList]
                    .filter(className => className.startsWith('status-'))
                    .forEach(className => marker.classList.remove(className));
                marker.classList.add(`status-${String(status || 'AVAILABLE').toLowerCase()}`);
                marker.dataset.status = status || 'AVAILABLE';
            }

            function syncCurrentPosition(x, y, force = false) {
                if (isGuest || !currentUserId || !root.dataset.positionUrl) return;

                const now = Date.now();
                const send = () => {
                    lastPositionSyncAt = Date.now();
                    window.clearTimeout(pendingPositionSyncTimer);
                    pendingPositionSyncTimer = null;
                    postForm(root.dataset.positionUrl, {
                        x: Math.round(x),
                        y: Math.round(y)
                    }).catch(() => {
                        // Keep movement responsive even if a transient sync request fails.
                    });
                };

                if (force || now - lastPositionSyncAt >= 700) {
                    send();
                    return;
                }

                window.clearTimeout(pendingPositionSyncTimer);
                pendingPositionSyncTimer = window.setTimeout(send, 720 - (now - lastPositionSyncAt));
            }

            function animateRemoteMarkerTo(marker, x, y) {
                if (!marker || Number(marker.dataset.userId || 0) === currentUserId) return;

                const start = {
                    x: markerPercent(marker, 'x', 50),
                    y: markerPercent(marker, 'y', 50)
                };
                const destination = clampPoint({ x, y });
                const distance = pointDistance(start, destination);
                if (distance < .25) return;

                const token = `${Date.now()}:${Math.random()}`;
                marker.dataset.remoteWalkToken = token;
                const duration = walkDuration(distance);
                marker.classList.add('is-walking');
                marker.style.transitionDuration = `${duration}ms, ${duration}ms, 180ms, 180ms`;
                marker.style.transitionTimingFunction = 'cubic-bezier(.28,.86,.22,1)';
                setMarkerDirection(marker, start, destination);
                setMarkerPosition(marker, roundPercent(destination.x), roundPercent(destination.y));

                window.setTimeout(() => {
                    if (marker.dataset.remoteWalkToken !== token) return;
                    marker.classList.remove('is-walking');
                    marker.style.transitionDuration = '';
                    marker.style.transitionTimingFunction = '';
                }, duration + 50);
            }

            function applyRemotePersonState(state) {
                const userId = Number(state?.userId || 0);
                if (!userId) return;

                const marker = getPersonMarker(userId);
                const person = peopleById.get(userId);
                if (!marker || !person) return;

                const status = state.status || person.status || 'AVAILABLE';
                const statusLabel = state.statusLabel || statusLabels[status] || status;
                const statusText = state.statusText || '';
                const displayName = state.displayName || person.displayName;
                const initial = state.initial || person.initial;
                const avatarPath = state.avatarPath || person.avatarPath;
                const joinedText = state.joinedText || person.joinedText || '';
                const homeX = Number(state.homeX);
                const homeY = Number(state.homeY);
                const homeZone = state.homeZone || person.homeZone || marker.dataset.homeZone || '';
                const avatar = normalizeAvatar({ ...person, ...state, ...(state.avatar || {}) });

                person.status = status;
                person.statusLabel = statusLabel;
                person.statusText = statusText;
                person.displayName = displayName;
                person.initial = initial;
                person.avatarPath = avatarPath;
                person.joinedText = joinedText;
                if (Number.isFinite(homeX)) {
                    person.homeX = homeX;
                    marker.dataset.homeX = String(homeX);
                }
                if (Number.isFinite(homeY)) {
                    person.homeY = homeY;
                    marker.dataset.homeY = String(homeY);
                }
                person.homeZone = homeZone;
                Object.assign(person, avatar);
                person.isOnline = true;
                if (isDndStatus(status)) {
                    meetingMediaStates.delete(userId);
                    closeRtcPeer(userId);
                    forgetLiveKitRemoteTracksForUser(userId);
                    setPersonSpeaking(userId, false);
                    if (userId === currentUserId) {
                        void enforceCurrentDndMode({ toast: false });
                    }
                }

                marker.hidden = false;
                marker.dataset.name = displayName;
                marker.dataset.statusLabel = statusLabel;
                marker.dataset.statusText = statusText;
                marker.dataset.avatar = avatarPath;
                marker.dataset.joinedText = joinedText;
                marker.dataset.homeZone = homeZone;
                marker.setAttribute('aria-label', displayName);
                marker.title = displayName;
                updateMarkerStatusClasses(marker, status);
                applyAvatarToElement(marker, avatar);
                marker.querySelector('.mr-name-text')?.replaceChildren(document.createTextNode(displayName));
                setMarkerStatusText(marker, statusText);
                setNameBadgeImage(marker, avatarPath);

                const row = document.querySelector(`.mr-person-row[data-user-id="${userId}"]`);
                if (row) {
                    row.hidden = false;
                    row.dataset.status = status;
                    row.querySelector('.mr-row-main strong')?.replaceChildren(document.createTextNode(displayName));
                }

                if (userId !== currentUserId) {
                    animateRemoteMarkerTo(marker, Number(state.x), Number(state.y));
                }

                syncMarkerArea(marker);
                if (userId === currentUserId) {
                    if (currentDeskAreaId !== 0) {
                        currentDeskAreaId = null;
                    }
                }

                if (syncPersonDeskAreaOwner(userId)) {
                    renderCustomAreas();
                } else if (userId === currentUserId) {
                    syncCurrentDeskAreaHighlight();
                }

                if (selectedUserId === userId && !personPopover.hidden) {
                    renderPersonPopoverDetails(person, marker.dataset.zone || person.zone || 'Lobby');
                    updatePersonContactControls(person);
                }
            }

            function hideRemotePerson(userId) {
                userId = Number(userId || 0);
                if (!userId || userId === currentUserId) return;

                const marker = getPersonMarker(userId);
                const person = peopleById.get(userId);
                if (person) {
                    person.isOnline = false;
                }
                if (marker) {
                    marker.hidden = true;
                    marker.classList.remove('is-walking', 'is-speaking');
                    marker.dataset.remoteWalkToken = '';
                }

                const row = document.querySelector(`.mr-person-row[data-user-id="${userId}"]`);
                if (row) {
                    row.hidden = true;
                }

                meetingMediaStates.delete(userId);
                setPersonSpeaking(userId, false);
                closeRtcPeer(userId);
                if (selectedUserId === userId && !personPopover.hidden) {
                    closeAllPopovers();
                }
                scheduleProximityVoiceRefresh();
                refreshMeetingPanel();
                scheduleMeetingVideosRender();
                scheduleMeetingParticipantsRender();
            }

            async function pollRoomState() {
                if (!root.dataset.stateUrl || isPollingRoomState) return;

                isPollingRoomState = true;
                try {
                    const response = await fetch(root.dataset.stateUrl, {
                        headers: { 'Accept': 'application/json' },
                        cache: 'no-store'
                    });
                    const payload = await response.json().catch(() => null);
                    if (!response.ok || !payload?.ok || !Array.isArray(payload.people)) return;

                    const onlineIds = new Set(payload.people.map(person => Number(person.userId || 0)).filter(Boolean));
                    payload.people.forEach(applyRemotePersonState);

                    document.querySelectorAll('.mr-person').forEach(marker => {
                        const userId = Number(marker.dataset.userId || 0);
                        if (!userId || userId === currentUserId) return;
                        if (!onlineIds.has(userId)) {
                            hideRemotePerson(userId);
                        }
                    });
                    document.querySelectorAll('.mr-person-row').forEach(row => {
                        const userId = Number(row.dataset.userId || 0);
                        if (!userId || userId === currentUserId) return;
                        row.hidden = !onlineIds.has(userId);
                    });
                } finally {
                    isPollingRoomState = false;
                }
            }

            function startRoomStatePolling(interval = 1500) {
                if (roomStateTimer && roomStatePollingInterval <= interval) return;

                if (roomStateTimer) {
                    window.clearInterval(roomStateTimer);
                }

                roomStatePollingInterval = interval;
                pollRoomState();
                roomStateTimer = window.setInterval(pollRoomState, interval);
            }

            async function startCanvasEngine() {
                if (!window.MeetingRoomEngine) return;

                try {
                    meetingRoomEngineHandle = await window.MeetingRoomEngine.mount({
                        host: document.getElementById('meetingRoomGameLayer'),
                        mapUrl: root.dataset.mapUrl
                    });
                } catch {
                    meetingRoomEngineHandle = null;
                }
            }

            function upsertRealtimeArea(saved) {
                if (!saved) return;

                const area = {
                    areaId: Number(saved.areaId || saved.AreaId || 0),
                    key: saved.key || saved.areaKey || saved.title || 'area',
                    title: saved.title || 'Meeting area',
                    areaType: saved.areaType || 'MEETING',
                    tone: saved.tone || 'teal',
                    isCustom: true,
                    ownerUserId: Number(saved.ownerUserId || saved.OwnerUserId || 0),
                    ownerName: saved.ownerName || saved.OwnerName || '',
                    ownerInitial: saved.ownerInitial || saved.OwnerInitial || '',
                    x: Number(saved.x ?? 30),
                    y: Number(saved.y ?? 30),
                    w: Number(saved.w ?? 18),
                    h: Number(saved.h ?? 14)
                };
                if (!area.areaId) return;

                const index = customAreas.findIndex(item => Number(item.areaId) === Number(area.areaId));
                if (index >= 0) {
                    customAreas[index] = area;
                } else {
                    customAreas.push(area);
                }

                rebuildVoiceAreas();
                renderCustomAreas();
            }

            function deleteRealtimeArea(payload) {
                const areaId = Number(payload?.areaId || 0);
                if (!areaId) return;

                customAreas = customAreas.filter(area => Number(area.areaId) !== areaId);
                if (Number(currentDeskAreaId || 0) === areaId) {
                    currentDeskAreaId = 0;
                }
                document.querySelector(`.mr-area-shape[data-area-id="${areaId}"]`)?.remove();
                rebuildVoiceAreas();
                renderCustomAreas();
            }

            function upsertRealtimeObject(saved) {
                if (!saved) return;

                const item = clampObject({
                    objectId: Number(saved.objectId || saved.ObjectId || 0),
                    objectKey: saved.objectKey || 'desk-basic',
                    objectType: saved.objectType || 'DESK',
                    title: saved.title || 'Object',
                    tone: saved.tone || 'wood',
                    x: Number(saved.x ?? 30),
                    y: Number(saved.y ?? 30),
                    w: Number(saved.w ?? 8),
                    h: Number(saved.h ?? 5),
                    rotation: Number(saved.rotation ?? 0),
                    isObstacle: saved.isObstacle !== false,
                    isCustom: true
                });
                if (!item.objectId) return;

                const index = customObjects.findIndex(object => Number(object.objectId) === Number(item.objectId));
                if (index >= 0) {
                    customObjects[index] = item;
                } else {
                    customObjects.push(item);
                }

                renderCustomObjects();
            }

            function deleteRealtimeObject(payload) {
                const objectId = Number(payload?.objectId || 0);
                if (!objectId) return;

                customObjects = customObjects.filter(item => Number(item.objectId) !== objectId);
                document.querySelector(`.mr-room-object[data-object-id="${objectId}"]`)?.remove();
                renderCustomObjects();
            }

            function rtcTargetIds() {
                if (!hasRtcLocalMedia() || !realtimeReady || isGuest || isCurrentDnd()) return [];

                return [...peopleById.keys()]
                    .filter(userId => userId && userId !== currentUserId)
                    .filter(userId => isRtcPeerInRange(userId));
            }

            function isRtcPeerInRange(userId) {
                userId = Number(userId || 0);
                if (!userId || userId === currentUserId) return false;
                if (isCurrentDnd() || personIsDnd(userId)) return false;

                const currentMarker = getPersonMarker(currentUserId);
                if (!currentMarker) return false;

                const currentArea = markerArea(currentMarker);
                const currentPoint = {
                    x: markerPercent(currentMarker, 'x', 50),
                    y: markerPercent(currentMarker, 'y', 50)
                };
                const maxDistance = 18;
                const marker = getPersonMarker(userId);
                if (!marker || marker.hidden) return false;

                const area = markerArea(marker);
                if (area.key !== currentArea.key) return false;
                if (isMeetingArea(currentArea)) return true;

                const point = {
                    x: markerPercent(marker, 'x', 50),
                    y: markerPercent(marker, 'y', 50)
                };

                return pointDistance(currentPoint, point) <= maxDistance;
            }

            function remoteVolumeFor(userId) {
                if (isCurrentDnd() || personIsDnd(userId)) return 0;

                const currentMarker = getPersonMarker(currentUserId);
                const marker = getPersonMarker(userId);
                if (!currentMarker || !marker) return 0;

                const currentArea = markerArea(currentMarker);
                const targetArea = markerArea(marker);
                if (currentArea.key !== targetArea.key) return 0;
                if (isMeetingArea(currentArea)) return 1;

                const distance = pointDistance(
                    { x: markerPercent(currentMarker, 'x', 50), y: markerPercent(currentMarker, 'y', 50) },
                    { x: markerPercent(marker, 'x', 50), y: markerPercent(marker, 'y', 50) }
                );
                return Math.max(0, Math.min(1, 1 - (distance / 18)));
            }

            function setRemoteAudioVolume(userId) {
                const audio = rtcRemoteAudio.get(Number(userId));
                if (audio) {
                    audio.volume = remoteVolumeFor(Number(userId));
                }

                liveKitRemoteAudio.forEach(element => {
                    if (Number(element.dataset.userId || 0) === Number(userId)) {
                        element.volume = isMeetingArea(currentConversationArea()) ? 1 : remoteVolumeFor(Number(userId));
                    }
                });
            }

            function liveKitClient() {
                return window.LivekitClient || window.LiveKitClient || null;
            }

            function useLiveKitMedia() {
                return !isGuest && Boolean(root.dataset.livekitTokenUrl);
            }

            function liveKitSourceName(source) {
                return String(source || '').toLowerCase().replace(/-/g, '_');
            }

            function liveKitPublicationSource(publication) {
                return publication?.source || publication?.track?.source || '';
            }

            function liveKitPublicationTrack(publication) {
                return publication?.track || null;
            }

            function liveKitTrackKind(track, publication = null) {
                return String(track?.kind || publication?.kind || publication?.track?.kind || '').toLowerCase();
            }

            function isLiveKitScreenSource(source) {
                const value = liveKitSourceName(source);
                return value.includes('screen');
            }

            function isLiveKitAudioEntry(track, publication = null) {
                return liveKitTrackKind(track, publication) === 'audio';
            }

            function isLiveKitVideoEntry(track, publication = null) {
                return liveKitTrackKind(track, publication) === 'video';
            }

            function liveKitParticipantUserId(participant) {
                const match = String(participant?.identity || '').match(/^user-(\d+)$/i);
                return match ? Number(match[1]) : 0;
            }

            function liveKitPublications(participant) {
                if (!participant) return [];

                const seen = new Set();
                const result = [];
                ['trackPublications', 'audioTrackPublications', 'videoTrackPublications'].forEach(name => {
                    const map = participant[name];
                    if (!map?.values) return;

                    [...map.values()].forEach(publication => {
                        const id = publication?.trackSid || publication?.sid || publication?.track?.sid || publication?.source || result.length;
                        if (seen.has(id)) return;
                        seen.add(id);
                        result.push(publication);
                    });
                });

                return result;
            }

            function liveKitTrackSid(track, publication = null) {
                return String(track?.sid || publication?.trackSid || publication?.sid || track?.mediaStreamTrack?.id || '');
            }

            function liveKitRemoteTrackKey(userId, track, publication) {
                const source = liveKitPublicationSource(publication) || track?.source || track?.kind || 'track';
                const sid = liveKitTrackSid(track, publication) || source;
                return `${Number(userId || 0)}:${source}:${sid}`;
            }

            function isLiveKitTrackLive(track) {
                if (!track) return false;
                const mediaTrack = track.mediaStreamTrack;
                return !mediaTrack || mediaTrack.readyState === 'live';
            }

            function mediaStreamFromLiveKitTrack(track) {
                const mediaTrack = track?.mediaStreamTrack;
                if (!mediaTrack || mediaTrack.readyState !== 'live') return null;
                return new MediaStream([mediaTrack]);
            }

            function liveKitLocalPublications() {
                return liveKitPublications(liveKitRoom?.localParticipant);
            }

            function isLiveKitPublicationMuted(publication, track = null) {
                return Boolean(publication?.isMuted || publication?.muted || track?.isMuted || track?.mediaStreamTrack?.enabled === false);
            }

            function liveKitLocalPublication(predicate) {
                return liveKitLocalPublications().find(publication => {
                    const track = liveKitPublicationTrack(publication);
                    return track && isLiveKitTrackLive(track) && !isLiveKitPublicationMuted(publication, track) && predicate(publication, track);
                }) || null;
            }

            function liveKitLocalStream(predicate) {
                return mediaStreamFromLiveKitTrack(liveKitLocalPublication(predicate)?.track);
            }

            function syncLiveKitLocalMediaStreams() {
                if (!useLiveKitMedia() || !liveKitRoom) return;

                micStream = liveKitLocalStream((publication, track) =>
                    isLiveKitAudioEntry(track, publication) && !isLiveKitScreenSource(liveKitPublicationSource(publication)));
                cameraStream = liveKitLocalStream((publication, track) =>
                    isLiveKitVideoEntry(track, publication) && !isLiveKitScreenSource(liveKitPublicationSource(publication)));
                screenStream = liveKitLocalStream((publication, track) =>
                    isLiveKitVideoEntry(track, publication) && isLiveKitScreenSource(liveKitPublicationSource(publication)));

	                setDockMediaState('toggleMic', Boolean(micStream), 'Microphone on', 'Microphone muted');
	                setDockMediaState('toggleCamera', Boolean(cameraStream), 'Camera on', 'Camera off');
	                setDockMediaState('shareScreen', Boolean(screenStream), 'Screen sharing', 'Screen share off');
	                syncMeetingConnectionStatus();
	            }

            function syncLiveKitLocalMediaState(options = {}) {
                if (!useLiveKitMedia() || !liveKitRoom) return;

	                syncLiveKitLocalMediaStreams();
	                desiredMicOn = Boolean(micStream);
	                desiredCameraOn = Boolean(cameraStream);
	                desiredScreenOn = Boolean(screenStream);

                if (micStream) {
                    startSpeakingDetector(micStream, currentUserId);
                } else {
                    stopSpeakingDetector(currentUserId);
                }

                const mediaState = {
                    micOn: Boolean(micStream),
                    cameraOn: Boolean(cameraStream),
                    screenOn: Boolean(screenStream)
                };
                if (!micStream || options.clearSpeaking) {
                    mediaState.isSpeaking = false;
                }

                void broadcastMeetingMediaState(mediaState);
                scheduleMeetingVideosRender();
                scheduleMeetingParticipantsRender();
            }

	            function liveKitRemoteEntriesForUser(userId) {
                const id = Number(userId || 0);
                return [...liveKitRemoteTracks.values()]
                    .filter(entry => Number(entry.userId) === id && isLiveKitTrackLive(entry.track) && !isLiveKitPublicationMuted(entry.publication, entry.track));
            }

            function liveKitEntryIsScreen(entry) {
                return isLiveKitVideoEntry(entry.track, entry.publication) && isLiveKitScreenSource(entry.source);
            }

            function liveKitEntryIsCamera(entry) {
                return isLiveKitVideoEntry(entry.track, entry.publication) && !isLiveKitScreenSource(entry.source);
            }

            function liveKitEntryIsAudio(entry) {
                return isLiveKitAudioEntry(entry.track, entry.publication) && !isLiveKitScreenSource(entry.source);
            }

            function hasLiveKitRemoteAudio(userId) {
                return liveKitRemoteEntriesForUser(userId).some(liveKitEntryIsAudio);
            }

            function hasLiveKitRemoteCamera(userId) {
                return liveKitRemoteEntriesForUser(userId).some(liveKitEntryIsCamera);
            }

            function hasLiveKitRemoteScreen(userId) {
                return liveKitRemoteEntriesForUser(userId).some(liveKitEntryIsScreen);
            }

            function refreshLiveKitMediaStateForUser(userId) {
                userId = Number(userId || 0);
                if (!userId) return;

                applyMeetingMediaState({
                    userId,
                    areaKey: liveKitConnectedAreaKey || markerArea(getPersonMarker(userId))?.key || '',
                    micOn: hasLiveKitRemoteAudio(userId),
                    cameraOn: hasLiveKitRemoteCamera(userId),
                    screenOn: hasLiveKitRemoteScreen(userId),
                    isSpeaking: meetingMediaStates.get(userId)?.isSpeaking || false
                });
            }

            function findLiveKitTrackBySid(sid) {
                if (!sid) return null;

                for (const entry of liveKitRemoteTracks.values()) {
                    if (liveKitTrackSid(entry.track, entry.publication) === sid) {
                        return entry.track;
                    }
                }

                for (const publication of liveKitLocalPublications()) {
                    const track = liveKitPublicationTrack(publication);
                    if (liveKitTrackSid(track, publication) === sid) {
                        return track;
                    }
                }

                return null;
            }

            function attachLiveKitTrackToElement(track, element, publication = null) {
                if (!track || !element) return false;

                try {
                    track.attach(element);
                } catch {
                    const stream = mediaStreamFromLiveKitTrack(track);
                    if (!stream) return false;
                    element.srcObject = stream;
                }

                element.dataset.livekitAttached = 'true';
                element.dataset.livekitTrackSid = liveKitTrackSid(track, publication);
                return true;
            }

            function detachLiveKitElement(element) {
                if (!element?.dataset?.livekitAttached) return;

                const track = findLiveKitTrackBySid(element.dataset.livekitTrackSid);
                try {
                    track?.detach?.(element);
                } catch {
                    // Detach is best effort; clearing srcObject prevents stale playback.
                }

                element.srcObject = null;
                delete element.dataset.livekitAttached;
                delete element.dataset.livekitTrackSid;
            }

            function detachLiveKitElements(container) {
                container?.querySelectorAll?.('[data-livekit-attached="true"]').forEach(detachLiveKitElement);
            }

            function attachLiveKitRemoteAudio(key, track, publication, userId) {
                if (isCurrentDnd() || personIsDnd(userId)) return;

                let audio = liveKitRemoteAudio.get(key);
                if (!audio) {
                    audio = document.createElement('audio');
                    audio.autoplay = true;
                    audio.playsInline = true;
                    audio.dataset.userId = String(userId);
                    audio.style.display = 'none';
                    document.body.appendChild(audio);
                    liveKitRemoteAudio.set(key, audio);
                }

                attachLiveKitTrackToElement(track, audio, publication);
                audio.volume = isMeetingArea(currentConversationArea()) ? 1 : remoteVolumeFor(userId);
                audio.play?.().catch(() => { });
            }

            function rememberLiveKitRemoteTrack(track, publication, participant) {
                const userId = liveKitParticipantUserId(participant);
                if (!userId || userId === currentUserId || !isLiveKitTrackLive(track)) return;
                if (isCurrentDnd() || personIsDnd(userId)) return;

                const source = liveKitPublicationSource(publication) || track.source || track.kind || '';
                const key = liveKitRemoteTrackKey(userId, track, publication);
                liveKitRemoteTracks.set(key, {
                    userId,
                    participant,
                    publication,
                    track,
                    source,
                    updatedAt: Date.now()
                });

                if (isLiveKitAudioEntry(track, publication)) {
                    attachLiveKitRemoteAudio(key, track, publication, userId);
                    startSpeakingDetector(mediaStreamFromLiveKitTrack(track), userId);
                }

                refreshLiveKitMediaStateForUser(userId);
                scheduleMeetingVideosRender();
                scheduleMeetingParticipantsRender();
            }

            function forgetLiveKitRemoteTrack(key) {
                const entry = liveKitRemoteTracks.get(key);
                if (!entry) return;

                detachLiveKitElement(liveKitRemoteAudio.get(key));
                liveKitRemoteAudio.get(key)?.remove();
                liveKitRemoteAudio.delete(key);
                liveKitRemoteTracks.delete(key);

                if (entry.userId) {
                    if (!hasLiveKitRemoteAudio(entry.userId)) {
                        stopSpeakingDetector(entry.userId);
                    }
                    refreshLiveKitMediaStateForUser(entry.userId);
                }
            }

            function forgetLiveKitRemoteTrackBySource(track, publication, participant) {
                const userId = liveKitParticipantUserId(participant);
                const key = liveKitRemoteTrackKey(userId, track, publication);
                forgetLiveKitRemoteTrack(key);
            }

            function forgetLiveKitRemoteTracksForUser(userId) {
                const keys = [...liveKitRemoteTracks.entries()]
                    .filter(([, entry]) => Number(entry.userId) === Number(userId))
                    .map(([key]) => key);
                keys.forEach(forgetLiveKitRemoteTrack);
            }

            function rememberExistingLiveKitTracks(room) {
                if (!room?.remoteParticipants?.values) return;

                [...room.remoteParticipants.values()].forEach(participant => {
                    liveKitPublications(participant).forEach(publication => {
                        const track = liveKitPublicationTrack(publication);
                        if (track) {
                            rememberLiveKitRemoteTrack(track, publication, participant);
                        }
                    });
                });
            }

            function wireLiveKitRoom(room) {
                const events = liveKitClient()?.RoomEvent || {};

                const handleTrackMuteChange = (publication, participant) => {
                    const track = liveKitPublicationTrack(publication);
                    const userId = liveKitParticipantUserId(participant);
                    const isLocal = participant === room.localParticipant || userId === currentUserId;

                    if (isLocal) {
                        syncLiveKitLocalMediaState({ clearSpeaking: isLiveKitPublicationMuted(publication, track) });
                        return;
                    }

                    if (userId && track && !isLiveKitPublicationMuted(publication, track)) {
                        rememberLiveKitRemoteTrack(track, publication, participant);
                    }

                    if (userId && isLiveKitAudioEntry(track, publication) && isLiveKitPublicationMuted(publication, track)) {
                        stopSpeakingDetector(userId);
                    }

                    if (userId) {
                        refreshLiveKitMediaStateForUser(userId);
                    }
                    scheduleMeetingVideosRender();
                    scheduleMeetingParticipantsRender();
                };

                if (events.TrackSubscribed) {
                    room.on(events.TrackSubscribed, (track, publication, participant) => {
                        rememberLiveKitRemoteTrack(track, publication, participant);
                    });
                }

                if (events.TrackUnsubscribed) {
                    room.on(events.TrackUnsubscribed, (track, publication, participant) => {
                        forgetLiveKitRemoteTrackBySource(track, publication, participant);
                        scheduleMeetingVideosRender();
                        scheduleMeetingParticipantsRender();
                    });
                }

                if (events.TrackMuted) {
                    room.on(events.TrackMuted, handleTrackMuteChange);
                }

                if (events.TrackUnmuted) {
                    room.on(events.TrackUnmuted, handleTrackMuteChange);
                }

                if (events.ParticipantDisconnected) {
                    room.on(events.ParticipantDisconnected, participant => {
                        const userId = liveKitParticipantUserId(participant);
                        forgetLiveKitRemoteTracksForUser(userId);
                        applyMeetingMediaState({
                            userId,
                            areaKey: liveKitConnectedAreaKey,
                            micOn: false,
                            cameraOn: false,
                            screenOn: false,
                            isSpeaking: false
                        });
                    });
                }

                if (events.LocalTrackPublished) {
                    room.on(events.LocalTrackPublished, () => {
                        syncLiveKitLocalMediaState();
                    });
                }

                if (events.LocalTrackUnpublished) {
                    room.on(events.LocalTrackUnpublished, publication => {
                        const source = liveKitPublicationSource(publication);
                        const track = liveKitPublicationTrack(publication);
                        if (isLiveKitScreenSource(source)) {
                            desiredScreenOn = false;
                        } else if (isLiveKitAudioEntry(track, publication)) {
                            desiredMicOn = false;
                            stopSpeakingDetector(currentUserId);
                        } else if (isLiveKitVideoEntry(track, publication)) {
                            desiredCameraOn = false;
                        }

                        syncLiveKitLocalMediaState({ clearSpeaking: true });
                    });
                }

                if (events.ActiveSpeakersChanged) {
                    room.on(events.ActiveSpeakersChanged, speakers => {
                        const activeIds = new Set((speakers || []).map(liveKitParticipantUserId).filter(Boolean));
                        meetingParticipantsForArea(currentConversationArea()).forEach(person => {
                            if (person.userId === currentUserId) return;
                            applyMeetingMediaState({
                                userId: person.userId,
                                areaKey: liveKitConnectedAreaKey,
                                micOn: hasLiveKitRemoteAudio(person.userId),
                                isSpeaking: activeIds.has(Number(person.userId))
                            });
                        });
                    });
                }

                if (events.Reconnecting) {
                    room.on(events.Reconnecting, () => {
                        syncMeetingConnectionStatus();
                        showToast('LiveKit กำลังเชื่อมต่อใหม่...');
                    });
                }

                if (events.Reconnected) {
                    room.on(events.Reconnected, () => {
                        syncLiveKitLocalMediaStreams();
                        rememberExistingLiveKitTracks(room);
                        syncMeetingConnectionStatus();
                        void broadcastMeetingMediaState();
                        showToast('LiveKit กลับมาเชื่อมต่อแล้ว');
                    });
                }

                if (events.Disconnected) {
                    room.on(events.Disconnected, () => {
                        liveKitRemoteTracks.clear();
                        [...liveKitRemoteAudio.values()].forEach(audio => {
                            detachLiveKitElement(audio);
                            audio.remove();
                        });
                        liveKitRemoteAudio.clear();
                        syncMeetingConnectionStatus();
                        scheduleMeetingVideosRender();
                        scheduleMeetingParticipantsRender();
                    });
                }
            }

            async function restoreDesiredLiveKitMedia() {
                if (!liveKitRoom) return;

                if (desiredMicOn) {
                    await liveKitRoom.localParticipant.setMicrophoneEnabled(true, {
                        echoCancellation: true,
                        noiseSuppression: true,
                        autoGainControl: true
                    });
                }

                if (desiredCameraOn) {
                    await liveKitRoom.localParticipant.setCameraEnabled(true);
                }

                if (desiredScreenOn) {
                    await liveKitRoom.localParticipant.setScreenShareEnabled(true);
                }

                syncLiveKitLocalMediaStreams();
                if (micStream) {
                    startSpeakingDetector(micStream, currentUserId);
                }
            }

            async function disconnectLiveKitRoom(options = {}) {
	                const room = liveKitRoom;
	                liveKitRoom = null;
	                liveKitConnectedAreaKey = '';

	                [...liveKitRemoteAudio.values()].forEach(audio => {
                    detachLiveKitElement(audio);
                    audio.remove();
                });
                liveKitRemoteAudio.clear();
                liveKitRemoteTracks.clear();

                if (room) {
                    try {
                        room.disconnect();
                    } catch {
                        // LiveKit disconnect is best effort during navigation/area changes.
                    }
                }

                stopSpeakingDetector(currentUserId);
                micStream = null;
                cameraStream = null;
                screenStream = null;
                setDockMediaState('toggleMic', false, 'Microphone on', 'Microphone muted');
                setDockMediaState('toggleCamera', false, 'Camera on', 'Camera off');
                setDockMediaState('shareScreen', false, 'Screen sharing', 'Screen share off');
                syncMeetingConnectionStatus();

                if (!options.keepDesiredMedia) {
                    desiredMicOn = false;
                    desiredCameraOn = false;
                    desiredScreenOn = false;
                }

                scheduleMeetingVideosRender();
                scheduleMeetingParticipantsRender();
            }

            async function ensureLiveKitRoom(area = currentConversationArea()) {
                if (!useLiveKitMedia()) return false;
                if (isCurrentDnd()) {
                    await enforceCurrentDndMode({ toast: false });
                    return false;
                }

	                const areaKey = normalizeAreaKey(area?.key || area?.title || 'meeting-area');
	                if (liveKitRoom && liveKitConnectedAreaKey === areaKey) {
	                    syncMeetingConnectionStatus();
	                    return true;
	                }

	                if (liveKitConnectingPromise) {
	                    await liveKitConnectingPromise;
	                    if (liveKitRoom && liveKitConnectedAreaKey === areaKey) {
	                        return true;
	                    }
	                }

                liveKitConnectingPromise = (async () => {
                    const client = liveKitClient();
                    if (!client?.Room) {
                        showToast('โหลด LiveKit SDK ไม่สำเร็จ');
                        return false;
                    }

                    await disconnectLiveKitRoom({ keepDesiredMedia: true });

                    let payload;
                    try {
                        payload = await postForm(root.dataset.livekitTokenUrl, {
                            areaKey,
                            areaTitle: area?.title || areaKey
                        });
                    } catch (error) {
                        showToast(error.message || 'เชื่อมต่อ LiveKit ไม่สำเร็จ');
                        return false;
                    }

                    const room = new client.Room({
                        adaptiveStream: true,
                        dynacast: true
                    });

                    wireLiveKitRoom(room);

                    try {
                        await room.connect(payload.url, payload.token, { autoSubscribe: true });
                    } catch {
                        showToast('เชื่อมต่อ LiveKit room ไม่สำเร็จ');
                        return false;
                    }

	                    liveKitRoom = room;
	                    liveKitConnectedAreaKey = areaKey;
	                    rememberExistingLiveKitTracks(room);
                    await restoreDesiredLiveKitMedia();
                    syncMeetingConnectionStatus();
                    await broadcastMeetingMediaState();
                    scheduleMeetingVideosRender();
                    scheduleMeetingParticipantsRender();
                    return true;
                })();

                try {
                    return await liveKitConnectingPromise;
                } finally {
                    liveKitConnectingPromise = null;
                }
            }

            function hasRtcLocalMedia() {
                return Boolean(
                    liveAudioTracks(micStream).length ||
                    liveVideoTracks(cameraStream).length ||
                    liveAudioTracks(screenStream).length ||
                    liveVideoTracks(screenStream).length
                );
            }

            function scheduleMeetingParticipantsRender() {
                window.clearTimeout(meetingParticipantsRenderTimer);
                meetingParticipantsRenderTimer = window.setTimeout(() => {
                    if (isMeetingPanelOpen()) {
                        renderMeetingParticipants();
                    }
                }, 40);
            }

            function scheduleMeetingVideosRender() {
                window.clearTimeout(meetingVideosRenderTimer);
                meetingVideosRenderTimer = window.setTimeout(() => {
                    if (isMeetingPanelOpen()) {
                        renderMeetingVideos();
                    }
                }, 80);
            }

            function remoteStreamKey(userId, stream) {
                return `${Number(userId || 0)}:${stream?.id || 'stream'}`;
            }

            function remoteMediaEntriesForUser(userId) {
                const id = Number(userId || 0);
                return [...rtcRemoteMediaStreams.values()].filter(entry => Number(entry.userId) === id);
            }

            function isRemoteScreenStream(userId, stream) {
                if (!stream || !liveVideoTracks(stream).length) return false;
                if (streamLooksLikeScreen(stream)) return true;

                const saved = meetingMediaStates.get(Number(userId || 0)) || {};
                if (!saved.screenOn) return false;
                if (!saved.cameraOn) return true;

                const videoEntries = remoteMediaEntriesForUser(userId)
                    .filter(entry => liveVideoTracks(entry.stream).length)
                    .sort((a, b) => Number(b.updatedAt || 0) - Number(a.updatedAt || 0));
                return videoEntries.length > 1 && videoEntries[0]?.stream?.id === stream.id;
            }

            function rememberRemoteMediaStream(userId, stream) {
                const id = Number(userId || 0);
                if (!id || !stream) return null;

                const key = remoteStreamKey(id, stream);
                const entry = {
                    userId: id,
                    stream,
                    updatedAt: Date.now()
                };
                rtcRemoteMediaStreams.set(key, entry);
                rtcRemoteStreams.set(id, stream);

                stream.getTracks().forEach(track => {
                    track.addEventListener('ended', () => {
                        rtcRemoteMediaStreams.delete(key);
                        scheduleMeetingVideosRender();
                        scheduleMeetingParticipantsRender();
                    }, { once: true });
                });

                return entry;
            }

            function forgetRemoteMediaStreams(userId) {
                const id = Number(userId || 0);
                [...rtcRemoteMediaStreams.entries()].forEach(([key, entry]) => {
                    if (Number(entry.userId) === id) {
                        rtcRemoteMediaStreams.delete(key);
                    }
                });
            }

            function currentMeetingMediaState(extra = {}) {
                if (isCurrentDnd()) {
                    return {
                        userId: currentUserId,
                        areaKey: normalizeAreaKey(currentConversationArea().key),
                        ...extra,
                        micOn: false,
                        cameraOn: false,
                        screenOn: false,
                        isSpeaking: false
                    };
                }

                const detector = speechDetectors.get(speakingDetectorKey(currentUserId));
                const micOn = Boolean(micStream && liveAudioTracks(micStream).length);
                const state = {
                    userId: currentUserId,
                    areaKey: currentConversationArea().key,
                    micOn,
                    cameraOn: Boolean(cameraStream && liveVideoTracks(cameraStream).length),
                    screenOn: Boolean(screenStream && liveVideoTracks(screenStream).length),
                    isSpeaking: micOn && Boolean(detector?.isSpeaking),
                    ...extra
                };

                if (!state.micOn) {
                    state.isSpeaking = false;
                }

                return state;
            }

            function applyMeetingMediaState(state, options = {}) {
                const userId = Number(state?.userId ?? state?.UserId ?? 0);
                if (!userId) return;

                const previous = meetingMediaStates.get(userId) || {};
                const forceSilent = (userId === currentUserId && isCurrentDnd()) ||
                    (userId !== currentUserId && personIsDnd(userId));
                const hasMic = Object.prototype.hasOwnProperty.call(state || {}, 'micOn') ||
                    Object.prototype.hasOwnProperty.call(state || {}, 'MicOn');
                const hasCamera = Object.prototype.hasOwnProperty.call(state || {}, 'cameraOn') ||
                    Object.prototype.hasOwnProperty.call(state || {}, 'CameraOn');
                const hasScreen = Object.prototype.hasOwnProperty.call(state || {}, 'screenOn') ||
                    Object.prototype.hasOwnProperty.call(state || {}, 'ScreenOn');
                const hasSpeaking = Object.prototype.hasOwnProperty.call(state || {}, 'isSpeaking') ||
                    Object.prototype.hasOwnProperty.call(state || {}, 'IsSpeaking');
                const micOn = forceSilent ? false : (hasMic ? Boolean(state?.micOn ?? state?.MicOn) : Boolean(previous.micOn));
                const next = {
                    userId,
                    areaKey: normalizeAreaKey(state?.areaKey ?? state?.AreaKey ?? previous.areaKey ?? ''),
                    micOn,
                    cameraOn: forceSilent ? false : (hasCamera ? Boolean(state?.cameraOn ?? state?.CameraOn) : Boolean(previous.cameraOn)),
                    screenOn: forceSilent ? false : (hasScreen ? Boolean(state?.screenOn ?? state?.ScreenOn) : Boolean(previous.screenOn)),
                    isSpeaking: !forceSilent && micOn && (hasSpeaking ? Boolean(state?.isSpeaking ?? state?.IsSpeaking) : Boolean(previous.isSpeaking)),
                    updatedAt: state?.updatedAt ?? state?.UpdatedAt ?? new Date().toISOString()
                };

                meetingMediaStates.set(userId, next);
                setPersonSpeaking(userId, next.isSpeaking);
                const videoStateChanged = Boolean(previous.cameraOn) !== next.cameraOn ||
                    Boolean(previous.screenOn) !== next.screenOn;

                const marker = getPersonMarker(userId);
                if (marker) {
                    marker.dataset.micOn = next.micOn ? 'true' : 'false';
                }

                if (!options.silent) {
                    if (videoStateChanged) {
                        scheduleMeetingVideosRender();
                    }
                    scheduleMeetingParticipantsRender();
                }
            }

            async function broadcastMeetingMediaState(extra = {}) {
                const state = currentMeetingMediaState(extra);
                applyMeetingMediaState(state, { silent: false });

                if (!realtimeConnection || !realtimeReady || isGuest) return;

                try {
                    await realtimeConnection.invoke(
                        'UpdateMediaState',
                        state.areaKey,
                        Boolean(state.micOn),
                        Boolean(state.cameraOn),
                        Boolean(state.screenOn),
                        Boolean(state.isSpeaking)
                    );
                } catch {
                    // Media state is advisory; WebRTC/polling should keep the room usable.
                }
            }

            function meetingMediaStateForUser(userId) {
                const id = Number(userId || 0);
                if (!id) return { micOn: false, cameraOn: false, screenOn: false, isSpeaking: false };
                if (id === currentUserId) return currentMeetingMediaState();
                if (personIsDnd(id)) return { userId: id, micOn: false, cameraOn: false, screenOn: false, isSpeaking: false };

                const saved = meetingMediaStates.get(id) || {};
                const entries = remoteMediaEntriesForUser(id);
                const liveKitEntries = liveKitRemoteEntriesForUser(id);
                const hasRemoteAudio = entries.some(entry => liveAudioTracks(entry.stream).length);
                const hasRemoteScreen = entries.some(entry => isRemoteScreenStream(id, entry.stream));
                const hasRemoteCamera = entries.some(entry =>
                    liveVideoTracks(entry.stream).length && !isRemoteScreenStream(id, entry.stream));
                const hasLiveKitAudio = liveKitEntries.some(liveKitEntryIsAudio);
                const hasLiveKitScreen = liveKitEntries.some(liveKitEntryIsScreen);
                const hasLiveKitCamera = liveKitEntries.some(liveKitEntryIsCamera);
                const hasSavedMic = Object.prototype.hasOwnProperty.call(saved, 'micOn');
                const hasSavedCamera = Object.prototype.hasOwnProperty.call(saved, 'cameraOn');
                const hasSavedScreen = Object.prototype.hasOwnProperty.call(saved, 'screenOn');

                return {
                    userId: id,
                    areaKey: saved.areaKey || normalizeAreaKey(markerArea(getPersonMarker(id))?.key || ''),
                    micOn: hasSavedMic ? Boolean(saved.micOn) : (hasRemoteAudio || hasLiveKitAudio),
                    cameraOn: hasSavedCamera ? Boolean(saved.cameraOn) : (hasRemoteCamera || hasLiveKitCamera),
                    screenOn: hasSavedScreen ? Boolean(saved.screenOn) : (hasRemoteScreen || hasLiveKitScreen),
                    isSpeaking: Boolean(saved.isSpeaking)
                };
            }

            function canNegotiatePeer(peer) {
                return Boolean(peer?.connection) &&
                    peer.connection.signalingState === 'stable' &&
                    !peer.makingOffer;
            }

            function scheduleRtcOffer(userId) {
                if (!realtimeConnection || !realtimeReady || !hasRtcLocalMedia()) return;

                const peer = ensureRtcPeer(userId);
                if (!peer) return;

                window.clearTimeout(peer.offerTimer);
                peer.offerTimer = window.setTimeout(() => {
                    void callRtcPeer(userId);
                }, 120);
            }

            async function flushRtcIceCandidates(peer, userId) {
                if (!peer?.connection?.remoteDescription || !peer.pendingCandidates?.length) return;

                const pending = peer.pendingCandidates.splice(0);
                for (const candidate of pending) {
                    try {
                        await peer.connection.addIceCandidate(new RTCIceCandidate(candidate));
                    } catch {
                        closeRtcPeer(userId);
                        break;
                    }
                }
            }

            function ensureRtcPeer(userId) {
                userId = Number(userId);
                if (!userId || userId === currentUserId) return null;
                if (isCurrentDnd() || personIsDnd(userId)) return null;
                if (!window.RTCPeerConnection) return null;

                let peer = rtcPeers.get(userId);
                if (peer) return peer;

                const connection = new RTCPeerConnection({
                    iceServers: [{ urls: 'stun:stun.l.google.com:19302' }]
                });

                connection.onicecandidate = event => {
                    if (!event.candidate || !realtimeConnection || !realtimeReady) return;
                    realtimeConnection.invoke('SendRtcIceCandidate', userId, event.candidate).catch(() => { });
                };

                connection.onnegotiationneeded = () => {
                    scheduleRtcOffer(userId);
                };

                connection.oniceconnectionstatechange = () => {
                    if (connection.iceConnectionState === 'failed') {
                        try {
                            connection.restartIce?.();
                        } catch {
                            // Some browsers do not expose restartIce.
                        }
                        scheduleRtcOffer(userId);
                    }
                };

                connection.ontrack = event => {
                    const stream = event.streams[0];
                    if (!stream) return;

                    rememberRemoteMediaStream(userId, stream);
                    startSpeakingDetector(stream, userId);

                    if (liveAudioTracks(stream).length) {
                        let audio = rtcRemoteAudio.get(userId);
                        if (!audio) {
                            audio = document.createElement('audio');
                            audio.autoplay = true;
                            audio.playsInline = true;
                            audio.dataset.userId = String(userId);
                            audio.style.display = 'none';
                            document.body.appendChild(audio);
                            rtcRemoteAudio.set(userId, audio);
                        }

                        audio.srcObject = stream;
                        audio.play?.().catch(() => { });
                        setRemoteAudioVolume(userId);
                    }
                    applyMeetingMediaState({
                        userId,
                        areaKey: markerArea(getPersonMarker(userId)).key,
                        micOn: liveAudioTracks(stream).length > 0 || meetingMediaStateForUser(userId).micOn,
                        cameraOn: meetingMediaStateForUser(userId).cameraOn,
                        screenOn: meetingMediaStateForUser(userId).screenOn,
                        isSpeaking: false
                    }, { silent: true });
                    scheduleMeetingVideosRender();
                    scheduleMeetingParticipantsRender();
                };

                peer = {
                    connection,
                    makingOffer: false,
                    needsNegotiation: false,
                    pendingCandidates: [],
                    offerTimer: null
                };
                rtcPeers.set(userId, peer);

                [micStream, cameraStream, screenStream].filter(Boolean).forEach(stream => {
                    stream.getTracks().forEach(track => connection.addTrack(track, stream));
                });

                return peer;
            }

            async function callRtcPeer(userId) {
                if (!realtimeConnection || !realtimeReady || !hasRtcLocalMedia()) return;
                if (isCurrentDnd() || personIsDnd(userId)) {
                    closeRtcPeer(userId);
                    return;
                }

                const peer = ensureRtcPeer(userId);
                if (!peer) return;
                if (!canNegotiatePeer(peer)) {
                    peer.needsNegotiation = true;
                    return;
                }

                try {
                    peer.makingOffer = true;
                    await peer.connection.setLocalDescription(await peer.connection.createOffer());
                    await realtimeConnection.invoke('SendRtcOffer', Number(userId), peer.connection.localDescription, currentConversationArea().key);
                } catch {
                    closeRtcPeer(userId);
                } finally {
                    peer.makingOffer = false;
                    if (peer.needsNegotiation && peer.connection.signalingState === 'stable') {
                        peer.needsNegotiation = false;
                        scheduleRtcOffer(userId);
                    }
                }
            }

            async function handleRtcOffer(message) {
                const fromUserId = Number(message?.fromUserId || 0);
                const offer = message?.payload?.offer;
                const offerAreaKey = normalizeAreaKey(message?.payload?.areaKey || '');
                if (!fromUserId || !offer || !window.RTCSessionDescription) return;
                if (isCurrentDnd() || personIsDnd(fromUserId)) {
                    closeRtcPeer(fromUserId);
                    return;
                }
                if (offerAreaKey && offerAreaKey !== normalizeAreaKey(currentConversationArea().key)) return;

                const peer = ensureRtcPeer(fromUserId);
                if (!peer) return;

                try {
                    const offerCollision = peer.makingOffer || peer.connection.signalingState !== 'stable';
                    if (offerCollision) {
                        try {
                            await peer.connection.setLocalDescription({ type: 'rollback' });
                        } catch {
                            // Rollback is best-effort; setRemoteDescription below will decide if this offer is usable.
                        }
                    }

                    await peer.connection.setRemoteDescription(new RTCSessionDescription(offer));
                    await flushRtcIceCandidates(peer, fromUserId);
                    const answer = await peer.connection.createAnswer();
                    await peer.connection.setLocalDescription(answer);
                    await realtimeConnection.invoke('SendRtcAnswer', fromUserId, peer.connection.localDescription, currentConversationArea().key);
                    if (peer.needsNegotiation && hasRtcLocalMedia()) {
                        peer.needsNegotiation = false;
                        scheduleRtcOffer(fromUserId);
                    }
                } catch {
                    closeRtcPeer(fromUserId);
                }
            }

            async function handleRtcAnswer(message) {
                const fromUserId = Number(message?.fromUserId || 0);
                const answer = message?.payload?.answer;
                const peer = rtcPeers.get(fromUserId);
                if (!peer || !answer || !window.RTCSessionDescription) return;
                if (peer.connection.signalingState === 'stable') return;

                try {
                    await peer.connection.setRemoteDescription(new RTCSessionDescription(answer));
                    await flushRtcIceCandidates(peer, fromUserId);
                    if (peer.needsNegotiation && hasRtcLocalMedia()) {
                        peer.needsNegotiation = false;
                        scheduleRtcOffer(fromUserId);
                    }
                } catch {
                    closeRtcPeer(fromUserId);
                }
            }

            async function handleRtcIceCandidate(message) {
                const fromUserId = Number(message?.fromUserId || 0);
                const candidate = message?.payload?.candidate;
                if (isCurrentDnd() || personIsDnd(fromUserId)) {
                    closeRtcPeer(fromUserId);
                    return;
                }
                const peer = ensureRtcPeer(fromUserId);
                if (!peer || !candidate || !window.RTCIceCandidate) return;

                try {
                    if (!peer.connection.remoteDescription) {
                        peer.pendingCandidates.push(candidate);
                        return;
                    }
                    await peer.connection.addIceCandidate(new RTCIceCandidate(candidate));
                } catch {
                    closeRtcPeer(fromUserId);
                }
            }

            function closeRtcPeer(userId) {
                userId = Number(userId);
                stopSpeakingDetector(userId);

                const peer = rtcPeers.get(userId);
                if (peer) {
                    window.clearTimeout(peer.offerTimer);
                    peer.connection.close();
                    rtcPeers.delete(userId);
                }

                const audio = rtcRemoteAudio.get(userId);
                if (audio) {
                    audio.remove();
                    rtcRemoteAudio.delete(userId);
                }

                rtcRemoteStreams.delete(userId);
                forgetRemoteMediaStreams(userId);
                scheduleMeetingVideosRender();
                scheduleMeetingParticipantsRender();
            }

            function closeAllRtcPeers() {
                [...rtcPeers.keys()].forEach(closeRtcPeer);
            }

            function addStreamTracksToRtcPeers(stream) {
                if (!stream) return;

                rtcPeers.forEach((peer, userId) => {
                    let addedTrack = false;
                    stream.getTracks().forEach(track => {
                        const alreadyAdded = peer.connection.getSenders().some(sender => sender.track === track);
                        if (!alreadyAdded) {
                            peer.connection.addTrack(track, stream);
                            addedTrack = true;
                        }
                    });
                    if (addedTrack) {
                        scheduleRtcOffer(userId);
                    }
                });
            }

            function removeStreamTracksFromRtcPeers(stream) {
                if (!stream) return;

                const tracks = new Set(stream.getTracks());
                rtcPeers.forEach((peer, userId) => {
                    let removedTrack = false;
                    peer.connection.getSenders().forEach(sender => {
                        if (sender.track && tracks.has(sender.track)) {
                            peer.connection.removeTrack(sender);
                            removedTrack = true;
                        }
                    });
                    if (removedTrack) {
                        scheduleRtcOffer(userId);
                    }
                });
            }

            function scheduleProximityVoiceRefresh() {
                window.clearTimeout(proximityVoiceTimer);
                proximityVoiceTimer = window.setTimeout(refreshProximityVoice, 280);
            }

            function refreshProximityVoice() {
                if (isCurrentDnd()) {
                    void enforceCurrentDndMode({ toast: false });
                    return;
                }

                if (useLiveKitMedia()) {
                    closeAllRtcPeers();
                    const area = currentConversationArea();
                    const hasAreaCompany = meetingParticipantsForArea(area).some(person => Number(person.userId) !== currentUserId);
                    const shouldListen = hasAreaCompany ||
                        hasRtcLocalMedia() ||
                        desiredMicOn ||
                        desiredCameraOn ||
                        desiredScreenOn ||
                        isMeetingPanelOpen();

                    if (shouldListen) {
                        void ensureLiveKitRoom(area);
                    } else if (liveKitRoom) {
                        void disconnectLiveKitRoom({ keepDesiredMedia: true });
                    }
                    void broadcastMeetingMediaState();
                    return;
                }

                if (!realtimeReady) {
                    closeAllRtcPeers();
                    return;
                }

                if (hasRtcLocalMedia()) {
                    const targets = new Set(rtcTargetIds());
                    targets.forEach(userId => {
                        setRemoteAudioVolume(userId);
                        if (!rtcPeers.has(userId)) {
                            scheduleRtcOffer(userId);
                        }
                    });
                }

                [...rtcPeers.keys()].forEach(userId => {
                    if (!isRtcPeerInRange(userId)) {
                        closeRtcPeer(userId);
                    } else {
                        setRemoteAudioVolume(userId);
                    }
                });

                void broadcastMeetingMediaState();
            }

            async function announceVoiceArea() {
                if (!realtimeConnection || !realtimeReady || isGuest) return;
                if (isCurrentDnd()) {
                    await enforceCurrentDndMode({ toast: false });
                    return;
                }

                try {
                    await realtimeConnection.invoke('JoinVoiceArea', currentConversationArea().key);
                    await broadcastMeetingMediaState();
                } catch {
                    // Realtime presence is opportunistic; polling still keeps the room usable.
                }
            }

            async function startRealtimeRoom() {
                if (!window.signalR || !root.dataset.hubUrl) {
                    startRoomStatePolling();
                    return;
                }

                realtimeConnection = new signalR.HubConnectionBuilder()
                    .withUrl(`${root.dataset.hubUrl}?userId=${currentUserId || 0}&client=meeting-room`)
                    .withAutomaticReconnect([0, 1500, 5000, 10000])
                    .configureLogging(signalR.LogLevel.Warning)
                    .build();

                realtimeConnection.on('PersonMoved', state => {
                    applyRemotePersonState(state);
                    scheduleProximityVoiceRefresh();
                });
                realtimeConnection.on('PersonUpdated', state => {
                    applyRemotePersonState(state);
                    scheduleProximityVoiceRefresh();
                });
                realtimeConnection.on('PersonLeftRoom', state => {
                    hideRemotePerson(Number(state?.userId || 0));
                });
                realtimeConnection.on('MeetingRoomPresenceChanged', () => {
                    void pollRoomState();
                    scheduleProximityVoiceRefresh();
                });
                realtimeConnection.on('AreaSaved', area => {
                    upsertRealtimeArea(area);
                    scheduleProximityVoiceRefresh();
                });
                realtimeConnection.on('AreaDeleted', payload => {
                    deleteRealtimeArea(payload);
                    scheduleProximityVoiceRefresh();
                });
                realtimeConnection.on('ObjectSaved', item => {
                    upsertRealtimeObject(item);
                    scheduleProximityVoiceRefresh();
                });
                realtimeConnection.on('ObjectDeleted', payload => {
                    deleteRealtimeObject(payload);
                    scheduleProximityVoiceRefresh();
                });
                realtimeConnection.on('MeetingFileShared', file => {
                    if (!file || !isMeetingPanelOpen() || !sameMeetingArea(file)) return;

                    meetingFiles = [file, ...meetingFiles.filter(item => Number(item.shareId) !== Number(file.shareId))];
                    renderMeetingFiles();
                    showToast(`${file.uploadedByName || 'Someone'} แชร์ไฟล์ใน ${meetingArea().title}`);
                });
                realtimeConnection.on('VoiceAreaChanged', () => scheduleProximityVoiceRefresh());
                realtimeConnection.on('MeetingMediaStateChanged', state => {
                    applyMeetingMediaState(state);
                });
                realtimeConnection.on('WaveReceived', handleRealtimeWave);
                realtimeConnection.on('RtcOffer', handleRtcOffer);
                realtimeConnection.on('RtcAnswer', handleRtcAnswer);
                realtimeConnection.on('RtcIceCandidate', handleRtcIceCandidate);

                realtimeConnection.onreconnecting(() => {
                    realtimeReady = false;
                });

                realtimeConnection.onreconnected(async () => {
                    realtimeReady = true;
                    await pollRoomState();
                    await announceVoiceArea();
                    scheduleProximityVoiceRefresh();
                });

                realtimeConnection.onclose(() => {
                    realtimeReady = false;
                    closeAllRtcPeers();
                    startRoomStatePolling();
                });

                try {
                    await realtimeConnection.start();
                    realtimeReady = true;
                    await announceVoiceArea();
                    await pollRoomState();
                } catch {
                    realtimeReady = false;
                    startRoomStatePolling();
                }
            }

            function wait(ms) {
                return new Promise(resolve => window.setTimeout(resolve, ms));
            }

            function setMarkerDirection(marker, from, to) {
                const deltaX = to.x - from.x;
                if (Math.abs(deltaX) > .2) {
                    marker.style.setProperty('--avatar-dir', deltaX < 0 ? '-1' : '1');
                }
            }

            function buildWalkObstacles() {
                const obstacles = [];

                customObjects
                    .filter(item => item.isObstacle !== false && String(item.objectType || '').toUpperCase() !== 'RUG')
                    .forEach(item => {
                        const object = clampObject(item);
                        obstacles.push({
                            x1: object.x - .5,
                            x2: object.x + object.w + .5,
                            y1: object.y - .5,
                            y2: object.y + object.h + .5
                        });
                    });

                return obstacles;
            }

            function isPointBlocked(point, obstacles, padding = pathConfig.pointPadding) {
                if (point.x < walkBounds.minX || point.x > walkBounds.maxX || point.y < walkBounds.minY || point.y > walkBounds.maxY) {
                    return true;
                }

                return obstacles.some(obstacle =>
                    point.x >= obstacle.x1 - padding &&
                    point.x <= obstacle.x2 + padding &&
                    point.y >= obstacle.y1 - padding &&
                    point.y <= obstacle.y2 + padding
                );
            }

            function nearestWalkablePoint(point, obstacles) {
                const preferred = clampPoint(point);
                if (!isPointBlocked(preferred, obstacles)) {
                    return preferred;
                }

                for (let radius = 1; radius <= 18; radius += 1) {
                    const candidates = [];
                    for (let angle = 0; angle < 360; angle += 22.5) {
                        const radians = angle * Math.PI / 180;
                        candidates.push(clampPoint({
                            x: preferred.x + Math.cos(radians) * radius,
                            y: preferred.y + Math.sin(radians) * radius
                        }));
                    }

                    candidates.sort((a, b) => pointDistance(a, preferred) - pointDistance(b, preferred));
                    const openPoint = candidates.find(candidate => !isPointBlocked(candidate, obstacles));
                    if (openPoint) {
                        return openPoint;
                    }
                }

                return preferred;
            }

            function walkDestinationOverlapsPerson(point, ignoreUserId = currentUserId, minDistance = 2.4) {
                return [...map.querySelectorAll('.mr-person')].some(marker => {
                    const userId = Number(marker.dataset.userId || 0);
                    if (!userId || userId === Number(ignoreUserId || 0) || marker.hidden) return false;

                    const other = {
                        x: markerPercent(marker, 'x', 50),
                        y: markerPercent(marker, 'y', 50)
                    };
                    return pointDistance(point, other) < minDistance;
                });
            }

            function resolveWalkDestination(point, obstacles, options = {}) {
                const ignoreUserId = Number(options.ignoreUserId || currentUserId || 0);
                const preferred = options.area
                    ? clampPointToArea(nearestWalkablePoint(point, obstacles), options.area)
                    : nearestWalkablePoint(point, obstacles);

                if (!isPointBlocked(preferred, obstacles) && !walkDestinationOverlapsPerson(preferred, ignoreUserId)) {
                    return preferred;
                }

                for (let radius = .8; radius <= 8; radius += .8) {
                    const candidates = [];
                    for (let angle = 0; angle < 360; angle += 30) {
                        const radians = angle * Math.PI / 180;
                        const raw = {
                            x: preferred.x + (Math.cos(radians) * radius),
                            y: preferred.y + (Math.sin(radians) * radius)
                        };
                        candidates.push(options.area ? clampPointToArea(raw, options.area) : clampPoint(raw));
                    }

                    const seen = new Set();
                    const openPoint = candidates
                        .sort((a, b) => pointDistance(a, point) - pointDistance(b, point))
                        .find(candidate => {
                            const key = `${roundPercent(candidate.x)}:${roundPercent(candidate.y)}`;
                            if (seen.has(key)) return false;
                            seen.add(key);
                            if (isPointBlocked(candidate, obstacles)) return false;
                            if (walkDestinationOverlapsPerson(candidate, ignoreUserId)) return false;
                            return true;
                        });

                    if (openPoint) {
                        return openPoint;
                    }
                }

                return preferred;
            }

            function gridKey(xIndex, yIndex) {
                return `${xIndex}:${yIndex}`;
            }

            function maxGridIndex(axis) {
                const min = axis === 'x' ? walkBounds.minX : walkBounds.minY;
                const max = axis === 'x' ? walkBounds.maxX : walkBounds.maxY;
                return Math.ceil((max - min) / pathConfig.step);
            }

            function pointToGrid(point) {
                const safePoint = clampPoint(point);
                return {
                    x: Math.round((safePoint.x - walkBounds.minX) / pathConfig.step),
                    y: Math.round((safePoint.y - walkBounds.minY) / pathConfig.step)
                };
            }

            function gridToPoint(xIndex, yIndex) {
                return clampPoint({
                    x: walkBounds.minX + (xIndex * pathConfig.step),
                    y: walkBounds.minY + (yIndex * pathConfig.step)
                });
            }

            function isSegmentClear(from, to, obstacles) {
                const samples = Math.max(1, Math.ceil(pointDistance(from, to) / .85));
                for (let index = 0; index <= samples; index += 1) {
                    const t = index / samples;
                    const point = {
                        x: from.x + ((to.x - from.x) * t),
                        y: from.y + ((to.y - from.y) * t)
                    };
                    if (isPointBlocked(point, obstacles)) {
                        return false;
                    }
                }

                return true;
            }

            function simplifyPath(points, obstacles) {
                if (points.length <= 2) {
                    return points;
                }

                const simplified = [points[0]];
                let currentIndex = 0;

                while (currentIndex < points.length - 1) {
                    let nextIndex = points.length - 1;
                    while (nextIndex > currentIndex + 1 && !isSegmentClear(points[currentIndex], points[nextIndex], obstacles)) {
                        nextIndex -= 1;
                    }

                    simplified.push(points[nextIndex]);
                    currentIndex = nextIndex;
                }

                return simplified;
            }

            function findWalkPath(start, destination, obstacles) {
                const startPoint = nearestWalkablePoint(start, obstacles);
                const endPoint = nearestWalkablePoint(destination, obstacles);

                if (pointDistance(startPoint, endPoint) < .4) {
                    return [startPoint];
                }

                if (isSegmentClear(startPoint, endPoint, obstacles)) {
                    return [startPoint, endPoint];
                }

                const startGrid = pointToGrid(startPoint);
                const endGrid = pointToGrid(endPoint);
                const endKey = gridKey(endGrid.x, endGrid.y);
                const maxXIndex = maxGridIndex('x');
                const maxYIndex = maxGridIndex('y');
                const nodes = new Map();
                const open = [];
                const closed = new Set();

                function getNode(xIndex, yIndex) {
                    const key = gridKey(xIndex, yIndex);
                    let node = nodes.get(key);
                    if (!node) {
                        node = { x: xIndex, y: yIndex, key, g: Infinity, f: Infinity, parent: null };
                        nodes.set(key, node);
                    }

                    return node;
                }

                const startNode = getNode(startGrid.x, startGrid.y);
                startNode.g = 0;
                startNode.f = Math.hypot(endGrid.x - startGrid.x, endGrid.y - startGrid.y);
                open.push(startNode);

                for (let iteration = 0; open.length && iteration < 5200; iteration += 1) {
                    open.sort((a, b) => a.f - b.f);
                    const current = open.shift();
                    if (!current || closed.has(current.key)) continue;

                    if (current.key === endKey) {
                        const points = [];
                        let node = current;
                        while (node) {
                            points.push(gridToPoint(node.x, node.y));
                            node = node.parent;
                        }

                        points.reverse();
                        points[0] = startPoint;
                        points[points.length - 1] = endPoint;
                        return simplifyPath(points, obstacles);
                    }

                    closed.add(current.key);

                    for (let dx = -1; dx <= 1; dx += 1) {
                        for (let dy = -1; dy <= 1; dy += 1) {
                            if (dx === 0 && dy === 0) continue;

                            const nextX = current.x + dx;
                            const nextY = current.y + dy;
                            if (nextX < 0 || nextY < 0 || nextX > maxXIndex || nextY > maxYIndex) continue;

                            const nextPoint = gridToPoint(nextX, nextY);
                            if (isPointBlocked(nextPoint, obstacles)) continue;

                            if (dx !== 0 && dy !== 0) {
                                const sideA = gridToPoint(current.x + dx, current.y);
                                const sideB = gridToPoint(current.x, current.y + dy);
                                if (isPointBlocked(sideA, obstacles) || isPointBlocked(sideB, obstacles)) continue;
                            }

                            const neighbor = getNode(nextX, nextY);
                            if (closed.has(neighbor.key)) continue;

                            const moveCost = dx !== 0 && dy !== 0 ? Math.SQRT2 : 1;
                            const tentativeG = current.g + moveCost;
                            if (tentativeG >= neighbor.g) continue;

                            neighbor.parent = current;
                            neighbor.g = tentativeG;
                            neighbor.f = tentativeG + Math.hypot(endGrid.x - nextX, endGrid.y - nextY);
                            open.push(neighbor);
                        }
                    }
                }

                return null;
            }

            function walkDuration(distance) {
                return Math.round(clampPercent(distance * pathConfig.msPerPercent, pathConfig.minDuration, pathConfig.maxDuration));
            }

            async function animateMarkerTo(marker, x, y, options = {}) {
                const markerUserId = Number(marker?.dataset?.userId || 0);
                const start = {
                    x: markerPercent(marker, 'x', 50),
                    y: markerPercent(marker, 'y', 50)
                };
                const obstacles = buildWalkObstacles();
                const path = findWalkPath(start, { x, y }, obstacles);

                if (!path) {
                    if (!options.silentBlocked) {
                        showToast('ทางเดินติดสิ่งกีดขวาง ลองเลือกจุดใกล้ทางเดิน');
                    }
                    return false;
                }

                if (path.length <= 1) {
                    return true;
                }

                const token = ++activeWalkToken;
                marker.classList.add('is-walking');
                marker.style.transitionTimingFunction = 'cubic-bezier(.28,.86,.22,1)';

                let previous = path[0];
                for (let index = 1; index < path.length; index += 1) {
                    if (token !== activeWalkToken) {
                        return false;
                    }

                    const next = path[index];
                    const duration = walkDuration(pointDistance(previous, next));
                    marker.style.transitionDuration = `${duration}ms, ${duration}ms, 180ms, 180ms`;
                    setMarkerDirection(marker, previous, next);
                    setMarkerPosition(marker, roundPercent(next.x), roundPercent(next.y));
                    if (markerUserId === currentUserId) {
                        syncCurrentPosition(next.x, next.y);
                    }
                    await wait(duration + 32);
                    previous = next;
                }

                if (token === activeWalkToken) {
                    marker.classList.remove('is-walking');
                    marker.style.transitionDuration = '';
                    marker.style.transitionTimingFunction = '';
                }

                if (markerUserId === currentUserId) {
                    syncCurrentPosition(markerPercent(marker, 'x', x), markerPercent(marker, 'y', y), true);
                }

                return true;
            }

            async function walkCurrentToPoint(x, y, options = {}) {
                if (isGuest) {
                    showToast('Guest view ต้อง sign in ก่อนเดินในห้อง');
                    return false;
                }

                const marker = getPersonMarker(currentUserId);
                if (!marker) return false;

                const requested = clampPoint({
                    x: clampPercent(x, 4, 96),
                    y: clampPercent(y, walkBounds.minY, walkBounds.maxY)
                });
                const destination = resolveWalkDestination(requested, buildWalkObstacles(), {
                    area: options.area,
                    ignoreUserId: currentUserId
                });
                if (options.closePopovers !== false) {
                    closePopovers();
                }

                const moved = await animateMarkerTo(marker, destination.x, destination.y, options);

                if (moved && options.message) {
                    showToast(options.message);
                }

                return moved;
            }

            async function walkCurrentHome() {
                if (isGuest) {
                    showToast('Guest view ต้อง sign in ก่อนเดินในห้อง');
                    return;
                }

                const marker = getPersonMarker(currentUserId);
                if (!marker) return;

                const homeX = markerPercent(marker, 'homeX', markerPercent(marker, 'x', 50));
                const homeY = markerPercent(marker, 'homeY', markerPercent(marker, 'y', 50));
                const moved = await walkCurrentToPoint(homeX, homeY, { closePopovers: false });
                if (moved) {
                    focusPerson(currentUserId);
                    showToast('เดินกลับโต๊ะของคุณแล้ว');
                }
            }

            async function walkCurrentTo(targetUserId, intent) {
                if (isGuest) {
                    showToast('Guest view ต้อง sign in ก่อนเดินไปหาเพื่อน');
                    return;
                }

                if (!targetUserId || targetUserId === currentUserId) {
                    return;
                }

                const selfMarker = getPersonMarker(currentUserId);
                const targetMarker = getPersonMarker(targetUserId);
                const targetPerson = peopleById.get(Number(targetUserId));
                if (!selfMarker || !targetMarker || !targetPerson) return;
                if (!canContactPerson(targetUserId, intent === 'meeting' ? 'ประชุม' : 'คุย')) return;

                const targetX = markerPercent(targetMarker, 'x', 50);
                const targetY = markerPercent(targetMarker, 'y', 50);
                const selfX = markerPercent(selfMarker, 'x', 50);
                const sideOffset = selfX <= targetX ? -5 : 5;
                const targetArea = targetConversationArea(targetUserId);
                const destination = constrainPointToArea({ x: targetX + sideOffset, y: targetY + 2 }, targetArea);
                const nextX = destination.x;
                const nextY = destination.y;

                closePopovers();
                selectedUserId = Number(targetUserId);
                const moved = await animateMarkerTo(selfMarker, nextX, nextY, { ignoreUserId: targetUserId });
                if (!moved) return;

                focusPerson(currentUserId);
                if (!sameConversationArea(targetUserId)) {
                    showToast(`ต้องอยู่ใน ${targetArea.title} ก่อนถึงจะคุยกันได้`);
                    return;
                }

                if (intent === 'talk') {
                    openPerson(targetUserId, targetMarker);
                    showToast(`เดินไปหา ${targetPerson.displayName} แล้ว`);
                    return;
                }

                if (intent === 'wave') {
                    openPerson(targetUserId, targetMarker);
                    showToast(`เดินไปหา ${targetPerson.displayName} แล้ว`);
                    return;
                }

                if (intent === 'meeting') {
                    const area = currentConversationArea();
                    try {
                        const payload = await postForm(root.dataset.messageUrl, {
                            targetUserId,
                            message: `ขอคุยหรือประชุมกันใน ${area.title} ของ Meeting Room`
                        });
                        await openMeetingPanel('meeting');
                        showToast(payload.message || `ส่งคำชวนประชุมหา ${targetPerson.displayName} แล้ว`);
                    } catch (error) {
                        showToast(error.message);
                    }
                }
            }


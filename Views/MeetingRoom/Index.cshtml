                }

                if (targetId === 'editProfilePhoto') {
                    const input = document.getElementById('profileImageInput');
                    if (input) {
                        input.click();
                    } else {
                        showToast('ยังไม่พบฟอร์มแก้ไขรูปโปรไฟล์');
                    }
                    return;
                }

                if (targetId === 'saveDisplayName') {
                    if (isGuest) {
                        showToast('Guest view ต้อง sign in ก่อนตั้งชื่อ');
                        return;
                    }

                    const input = document.getElementById('displayNameInput');
                    try {
                        const payload = await postForm(root.dataset.displayNameUrl, {
                            displayName: input.value.trim()
                        });
                        updateCurrentDisplayName(payload.displayName, payload.roomDisplayName || '', payload.initial);
                        showToast('อัปเดตชื่อในห้องแล้ว');
                    } catch (error) {
                        showToast(error.message);
                    }
                    return;
                }

                const statusOption = event.target.closest('.mr-status-option');
                if (statusOption) {
                    const status = statusOption.dataset.status;
                    const statusText = document.getElementById('statusTextInput').value.trim();
                    try {
                        const payload = await postForm(root.dataset.presenceUrl, { status, statusText });
                        updateCurrentStatus(payload.status || status, payload.statusText || statusText, payload.label);
                        showToast('อัปเดตสถานะแล้ว');
                    } catch (error) {
                        showToast(error.message);
                    }
                    return;
                }

                const characterOption = event.target.closest('.mr-character-option');
                if (characterOption) {
                    const character = characterOption.dataset.character;
                    const avatarColor = characterOption.dataset.defaultColor || defaultAvatarColor;
                    try {
                        const payload = await postForm(root.dataset.characterUrl, { character, avatarColor });
                        updateCurrentCharacter(payload.character || character, payload.avatarColor || avatarColor);
                        showToast('อัปเดตตัวละครแล้ว');
                    } catch (error) {
                        showToast(error.message);
                    }
                    return;
                }

                const colorOption = event.target.closest('.mr-color-option');
                if (colorOption) {
                    const avatarColor = colorOption.dataset.avatarColor || defaultAvatarColor;
                    const current = peopleById.get(currentUserId);
                    const character = current?.characterPreset || defaultCharacter;
                    try {
                        const payload = await postForm(root.dataset.characterUrl, { character, avatarColor });
                        updateCurrentCharacter(payload.character || character, payload.avatarColor || avatarColor);
                        showToast('อัปเดตสีตัวแล้ว');
                    } catch (error) {
                        showToast(error.message);
                    }
                    return;
                }

                if (hasOpenPopover() && isEmptyMapClick) {
                    closePopovers();
                }
            });

            map.addEventListener('dblclick', event => {
                if (isCustomizeOpen) {
                    return;
                }

                if (event.target.closest('.mr-person, .mr-map-tools')) {
                    return;
                }

                event.preventDefault();
                const point = mapEventToWorldPoint(event);
                const x = point.x;
                const y = point.y;
                walkCurrentToPoint(x, y);
            });

            map.addEventListener('wheel', event => {
                if (event.target.closest('.mr-map-tools, .mr-popover')) {
                    return;
                }

                event.preventDefault();
                changeRoomZoom(event.deltaY < 0 ? zoomConfig.step : -zoomConfig.step);
            }, { passive: false });

            document.getElementById('displayNameInput')?.addEventListener('keydown', event => {
                if (event.key !== 'Enter') {
                    return;
                }

                event.preventDefault();
                document.getElementById('saveDisplayName')?.click();
            });

            document.getElementById('avatarColorInput')?.addEventListener('change', async event => {
                const avatarColor = event.target.value || defaultAvatarColor;
                const current = peopleById.get(currentUserId);
                const character = current?.characterPreset || defaultCharacter;

                try {
                    const payload = await postForm(root.dataset.characterUrl, { character, avatarColor });
                    updateCurrentCharacter(payload.character || character, payload.avatarColor || avatarColor);
                    showToast('อัปเดตสีตัวแล้ว');
                } catch (error) {
                    showToast(error.message);
                }
            });

            window.addEventListener('beforeunload', () => {
                window.clearInterval(followTimer);
                stopMediaStream(micStream);
                stopMediaStream(cameraStream);
                stopMediaStream(screenStream);
            });

            window.addEventListener('resize', () => {
                setRoomPan(roomPanX, roomPanY);
                ensureCustomizePanelInView();
            });

            document.getElementById('areaForm')?.addEventListener('submit', async event => {
                event.preventDefault();
                if (!canCustomize) return;

                const area = formArea();
                if (!area.title) {
                    showToast('กรุณาตั้งชื่อพื้นที่');
                    document.getElementById('areaTitleInput')?.focus();
                    return;
                }

                try {
                    const payload = await postForm(root.dataset.saveAreaUrl, area);
                    const saved = payload.area;
                    const nextArea = {
                        areaId: Number(saved.areaId || saved.AreaId || area.areaId),
                        key: saved.key || saved.areaKey || area.title,
                        title: saved.title || area.title,
                        areaType: saved.areaType || area.areaType,
                        tone: saved.tone || area.tone,
                        isCustom: true,
                        x: Number(saved.x ?? area.x),
                        y: Number(saved.y ?? area.y),
                        w: Number(saved.w ?? area.w),
                        h: Number(saved.h ?? area.h)
                    };

                    const existingIndex = customAreas.findIndex(item => Number(item.areaId) === Number(nextArea.areaId));
                    if (existingIndex >= 0) {
                        customAreas[existingIndex] = nextArea;
                    } else {
                        customAreas.push(nextArea);
                    }

                    selectedAreaId = nextArea.areaId;
                    setAreaForm(nextArea);
                    document.getElementById('areaDraft')?.setAttribute('hidden', '');
                    rebuildVoiceAreas();
                    renderCustomAreas();
                    showToast('บันทึกพื้นที่แล้ว');
                } catch (error) {
                    showToast(error.message);
                }
            });

            ['areaTitleInput', 'areaTypeInput', 'areaToneInput', 'areaXInput', 'areaYInput', 'areaWInput', 'areaHInput'].forEach(id => {
                document.getElementById(id)?.addEventListener('input', () => {
                    if (isCustomizeOpen) {
                        syncDraftFromForm();
                    }
                });
                document.getElementById(id)?.addEventListener('change', () => {
                    if (isCustomizeOpen) {
                        syncDraftFromForm();
                    }
                });
            });

            document.getElementById('objectForm')?.addEventListener('submit', async event => {
                event.preventDefault();
                if (!canCustomize) return;

                const item = formObject();
                if (!item.title) {
                    showToast('กรุณาตั้งชื่อของ');
                    document.getElementById('objectTitleInput')?.focus();
                    return;
                }

                try {
                    const payload = await postForm(root.dataset.saveObjectUrl, {
                        objectId: item.objectId,
                        objectKey: item.objectKey,
                        objectType: item.objectType,
                        title: item.title,
                        tone: item.tone,
                        x: item.x,
                        y: item.y,
                        w: item.w,
                        h: item.h,
                        rotation: item.rotation,
                        isObstacle: item.isObstacle
                    });
                    const saved = payload.item;
                    const nextObject = clampObject({
                        objectId: Number(saved.objectId || saved.ObjectId || item.objectId),
                        objectKey: saved.objectKey || item.objectKey,
                        objectType: saved.objectType || item.objectType,
                        title: saved.title || item.title,
                        tone: saved.tone || item.tone,
                        x: Number(saved.x ?? item.x),
                        y: Number(saved.y ?? item.y),
                        w: Number(saved.w ?? item.w),
                        h: Number(saved.h ?? item.h),
                        rotation: Number(saved.rotation ?? item.rotation),
                        isObstacle: saved.isObstacle ?? item.isObstacle,
                        isCustom: true
                    });

                    const existingIndex = customObjects.findIndex(object => Number(object.objectId) === Number(nextObject.objectId));
                    if (existingIndex >= 0) {
                        customObjects[existingIndex] = nextObject;
                    } else {
                        customObjects.push(nextObject);
                    }

                    selectedObjectId = nextObject.objectId;
                    setObjectForm(nextObject);
                    document.getElementById('objectDraft')?.setAttribute('hidden', '');
                    renderCustomObjects();
                    showToast('บันทึกของในห้องแล้ว');
                } catch (error) {
                    showToast(error.message);
                }
            });

            ['objectTitleInput', 'objectToneInput', 'objectRotationInput', 'objectXInput', 'objectYInput', 'objectWInput', 'objectHInput', 'objectObstacleInput'].forEach(id => {
                document.getElementById(id)?.addEventListener('input', () => {
                    if (isCustomizeOpen && customizeMode === 'object') {
                        syncObjectDraftFromForm();
                    }
                });
                document.getElementById(id)?.addEventListener('change', () => {
                    if (isCustomizeOpen && customizeMode === 'object') {
                        syncObjectDraftFromForm();
                    }
                });
            });

            document.getElementById('messageForm').addEventListener('submit', async event => {
                event.preventDefault();
                if (isGuest) return;
                if (!selectedUserId) return;

                const input = document.getElementById('messageText');
                const message = input.value.trim();
                if (!message) {
                    input.focus();
                    return;
                }

                if (!requireSameConversationArea(selectedUserId, 'ส่งข้อความคุย')) {
                    return;
                }

                try {
                    const payload = await postForm(root.dataset.messageUrl, { targetUserId: selectedUserId, message });
                    input.value = '';
                    document.getElementById('messageForm').hidden = true;
                    showToast(payload.message || 'Message sent.');
                } catch (error) {
                    showToast(error.message);
                }
            });

            document.getElementById('meetingRoomSearch').addEventListener('input', event => {
                const query = event.target.value.trim().toLowerCase();
                document.querySelectorAll('.mr-person-row').forEach(row => {
                    row.hidden = query && !row.dataset.search.includes(query);
                });
                document.querySelectorAll('.mr-person').forEach(person => {
                    const model = peopleById.get(Number(person.dataset.userId));
                    const haystack = `${model?.displayName || ''} ${model?.username || ''} ${model?.position || ''}`.toLowerCase();
                    person.hidden = query && !haystack.includes(query);
                });
            });

            document.addEventListener('keydown', event => {
                const typingTarget = event.target instanceof HTMLElement &&
                    (event.target.matches('input, textarea, select') || event.target.isContentEditable);

                if (event.key === 'Escape') {
                    closePopovers();
                    return;
                }

                if (typingTarget) {
                    return;
                }

                const arrowSteps = {
                    ArrowUp: [0, -1],
                    ArrowDown: [0, 1],
                    ArrowLeft: [-1, 0],
                    ArrowRight: [1, 0]
                };

                if (Object.prototype.hasOwnProperty.call(arrowSteps, event.key)) {
                    event.preventDefault();
                    if (isGuest) {
                        showToast('Guest view ต้อง sign in ก่อนเดินในห้อง');
                        return;
                    }

                    const marker = getPersonMarker(currentUserId);
                    if (!marker) return;

                    const [dx, dy] = arrowSteps[event.key];
                    const step = event.shiftKey ? 7 : 3;
                    const nextX = markerPercent(marker, 'x', 50) + (dx * step);
                    const nextY = markerPercent(marker, 'y', 50) + (dy * step);
                    walkCurrentToPoint(nextX, nextY, { closePopovers: false });
                    return;
                }

                if (event.key.toLowerCase() === 'd') {
                    focusPerson(currentUserId);
                }
            });

            document.querySelectorAll('.mr-avatar, .mr-row-avatar img, .mr-profile-photo img').forEach(image => {
                const useDefaultAvatar = () => {
                    if (!image.src.endsWith('/images/Profile/profile.png')) {
                        image.src = '/images/Profile/profile.png';
                    }
                };

                image.addEventListener('error', useDefaultAvatar, { once: true });
                if (image.complete && image.naturalWidth === 0) {
                    useDefaultAvatar();
                }
            });

            renderCustomAreas();
            renderCustomObjects();
            document.querySelectorAll('.mr-person').forEach(marker => syncMarkerArea(marker));

            if (focusUserId) {
                window.setTimeout(() => focusPerson(focusUserId), 650);
            }

            applyRoomZoom(1);
            syncRightPanelToggle();
        })();
    </script>
}

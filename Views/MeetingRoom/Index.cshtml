                    try {
                        const payload = await postForm(root.dataset.deleteAreaUrl, { areaId });
                        customAreas = customAreas.filter(area => Number(area.areaId) !== Number(payload.areaId || areaId));
                        if (Number(currentDeskAreaId || 0) === Number(payload.areaId || areaId)) {
                            currentDeskAreaId = 0;
                        }
                        selectedAreaId = null;
                        document.querySelector(`.mr-area-shape[data-area-id="${areaId}"]`)?.remove();
                        clearAreaDraft();
                        rebuildVoiceAreas();

            function stopMediaStream(stream) {
                if (!stream) return;
                stream.getTracks().forEach(track => track.stop());
            }

            function speakingDetectorKey(userId) {
                return Number(userId || 0) === currentUserId ? 'local' : `remote:${Number(userId || 0)}`;
            }

            function setPersonSpeaking(userId, isSpeaking) {
                const id = Number(userId || 0);
                const marker = getPersonMarker(id);
                if (marker) {
                    marker.classList.toggle('is-speaking', Boolean(isSpeaking));
                }

                if (id === currentUserId) {
                    document.getElementById('avatarPreviewCharacter')?.classList.toggle('is-speaking', Boolean(isSpeaking));
                }
            }

            function stopSpeakingDetector(userId = currentUserId) {
                const id = Number(userId || 0);
                if (!id) return;

                const key = speakingDetectorKey(id);
                const detector = speechDetectors.get(key);
                if (!detector) {
                    setPersonSpeaking(id, false);
                    return;
                }

                detector.stopped = true;
                window.cancelAnimationFrame(detector.frameId);

                try {
                    detector.source?.disconnect();
                } catch {
                    // Best effort cleanup for browser-specific Web Audio nodes.
                }

                try {
                    if (detector.audioContext && detector.audioContext.state !== 'closed') {
                        detector.audioContext.close().catch(() => { });
                    }
                } catch {
                    // AudioContext may already be closing.
                }

                speechDetectors.delete(key);
                setPersonSpeaking(id, false);
            }

            function stopAllSpeakingDetectors() {
                [...speechDetectors.values()].forEach(detector => stopSpeakingDetector(detector.userId));
            }

            function startSpeakingDetector(stream, userId = currentUserId) {
                const id = Number(userId || 0);
                if (!id || !stream?.getAudioTracks?.().some(track => track.readyState === 'live')) return;

                const AudioContextCtor = window.AudioContext || window.webkitAudioContext;
                if (!AudioContextCtor) return;

                stopSpeakingDetector(id);

                try {
                    const audioContext = new AudioContextCtor();
                    if (typeof audioContext.resume === 'function') {
                        audioContext.resume().catch(() => { });
                    }

                    const analyser = audioContext.createAnalyser();
                    analyser.fftSize = 512;
                    analyser.smoothingTimeConstant = .55;

                    const source = audioContext.createMediaStreamSource(stream);
                    source.connect(analyser);

                    const data = new Uint8Array(analyser.fftSize);
                    const key = speakingDetectorKey(id);
                    const detector = {
                        userId: id,
                        audioContext,
                        analyser,
                        source,
                        data,
                        frameId: 0,
                        lastVoiceAt: 0,
                        isSpeaking: false,
                        stopped: false
                    };

                    speechDetectors.set(key, detector);

                    const tick = () => {
                        if (detector.stopped || !speechDetectors.has(key)) return;

                        analyser.getByteTimeDomainData(data);
                        let sum = 0;
                        for (let i = 0; i < data.length; i += 1) {
                            const level = (data[i] - 128) / 128;
                            sum += level * level;
                        }

                        const rms = Math.sqrt(sum / data.length);
                        const now = performance.now();
                        if (rms > speechConfig.threshold) {
                            detector.lastVoiceAt = now;
                        }

                        const isSpeaking = now - detector.lastVoiceAt < speechConfig.holdMs;
                        if (detector.isSpeaking !== isSpeaking) {
                            detector.isSpeaking = isSpeaking;
                            setPersonSpeaking(id, isSpeaking);
                            if (id === currentUserId) {
                                void broadcastMeetingMediaState({ isSpeaking });
                            } else {
                                applyMeetingMediaState({
                                    userId: id,
                                    areaKey: markerArea(getPersonMarker(id)).key,
                                    micOn: true,
                                    isSpeaking
                                });
                            }
                        }

                        detector.frameId = window.requestAnimationFrame(tick);
                    };

                    stream.getAudioTracks().forEach(track => {
                        track.addEventListener('ended', () => stopSpeakingDetector(id), { once: true });
                    });

                    tick();
                } catch {
                    stopSpeakingDetector(id);
                }
            }

	            function setDockMediaState(buttonId, isActive, onText, offText) {
	                const button = document.getElementById(buttonId);
	                if (!button) return;

	                button.classList.toggle('is-off', !isActive);
	                button.classList.toggle('is-active', isActive);
	                button.title = isActive ? onText : offText;
	                button.setAttribute('aria-label', button.title);
	            }

	            function syncMeetingConnectionStatus() {
                const status = document.getElementById('meetingConnectionStatus');
                if (!status) return;

                const isConnected = useLiveKitMedia()
                    ? Boolean(liveKitRoom && String(liveKitRoom.state || '').toLowerCase() === 'connected')
                    : hasRtcLocalMedia();
                status.textContent = isConnected ? 'Live' : 'Ready';
                status.classList.toggle('is-ready', !isConnected);
            }

            function mediaErrorMessage(error, label) {
                if (error?.name === 'NotAllowedError') {
                    return `ไม่ได้รับสิทธิ์เปิด${label}`;
                }

                if (error?.name === 'NotFoundError') {
                    return `ไม่พบอุปกรณ์${label}`;
                }

                if (error?.name === 'NotReadableError') {
                    return `${label}ถูกใช้งานอยู่ในแอปอื่น`;
                }

                return `เปิด${label}ไม่สำเร็จ`;
            }

            async function toggleMicrophone() {
                if (isCurrentDnd()) {
                    await enforceCurrentDndMode({ toast: false });
                    showToast('คุณอยู่ในสถานะ Do Not Disturb ต้องเปลี่ยนสถานะก่อนเปิดไมค์');
                    return;
                }

                if (useLiveKitMedia()) {
	                    if (desiredMicOn || micStream) {
	                        desiredMicOn = false;
	                        stopSpeakingDetector(currentUserId);
                        try {
                            await liveKitRoom?.localParticipant?.setMicrophoneEnabled(false);
                        } catch {
                            // Local state is still updated so the UI does not get stuck.
                        }
                        syncLiveKitLocalMediaStreams();
                        await broadcastMeetingMediaState({ micOn: false, isSpeaking: false });
                        scheduleMeetingParticipantsRender();
                        showToast('ปิดไมโครโฟนแล้ว');
                        return;
	                    }

	                    desiredMicOn = true;
	                    if (!await ensureLiveKitRoom(currentConversationArea())) {
	                        desiredMicOn = false;
	                        syncLiveKitLocalMediaStreams();
                        await broadcastMeetingMediaState({ micOn: false, isSpeaking: false });
                        return;
                    }

                    try {
                        if (!micStream) {
                            await liveKitRoom.localParticipant.setMicrophoneEnabled(true, {
                                echoCancellation: true,
                                noiseSuppression: true,
                                autoGainControl: true
                            });
                        }
                        syncLiveKitLocalMediaStreams();
                        startSpeakingDetector(micStream, currentUserId);
                        await broadcastMeetingMediaState({ micOn: true, isSpeaking: false });
                        await announceVoiceArea();
                        scheduleMeetingParticipantsRender();
                        showToast(`เปิดไมโครโฟนใน ${currentConversationArea().title} แล้ว`);
	                    } catch (error) {
	                        desiredMicOn = false;
	                        stopSpeakingDetector(currentUserId);
                        try {
                            await liveKitRoom?.localParticipant?.setMicrophoneEnabled(false);
                        } catch {
                            // Best effort cleanup.
                        }
                        syncLiveKitLocalMediaStreams();
                        await broadcastMeetingMediaState({ micOn: false, isSpeaking: false });
                        showToast(mediaErrorMessage(error, 'ไมโครโฟน'));
                    }
                    return;
                }

	                if (micStream) {
	                    stopSpeakingDetector(currentUserId);
                    removeStreamTracksFromRtcPeers(micStream);
                    stopMediaStream(micStream);
                    micStream = null;
                    setDockMediaState('toggleMic', false, 'Microphone on', 'Microphone muted');
                    await broadcastMeetingMediaState({ micOn: false, isSpeaking: false });
                    showToast('ปิดไมโครโฟนแล้ว');
                    return;
                }

                if (!navigator.mediaDevices?.getUserMedia) {
                    showToast('เบราว์เซอร์นี้ยังไม่รองรับไมโครโฟน');
                    return;
                }

                try {
                    micStream = await navigator.mediaDevices.getUserMedia({
                        audio: {
                            echoCancellation: true,
                            noiseSuppression: true,
                            autoGainControl: true
                        },
                        video: false
                    });
                    micStream.getAudioTracks().forEach(track => {
	                        track.addEventListener('ended', () => {
	                            removeStreamTracksFromRtcPeers(micStream);
	                            stopSpeakingDetector(currentUserId);
	                            micStream = null;
	                            setDockMediaState('toggleMic', false, 'Microphone on', 'Microphone muted');
                            void broadcastMeetingMediaState({ micOn: false, isSpeaking: false });
                            scheduleMeetingParticipantsRender();
                        }, { once: true });
	                    });
	                    startSpeakingDetector(micStream, currentUserId);
	                    setDockMediaState('toggleMic', true, 'Microphone on', 'Microphone muted');
                    await broadcastMeetingMediaState({ micOn: true, isSpeaking: false });
                    await announceVoiceArea();
                    refreshProximityVoice();
                    showToast(`เปิดไมโครโฟนใน ${currentConversationArea().title} แล้ว`);
	                } catch (error) {
	                    stopSpeakingDetector(currentUserId);
	                    micStream = null;
	                    setDockMediaState('toggleMic', false, 'Microphone on', 'Microphone muted');
                    await broadcastMeetingMediaState({ micOn: false, isSpeaking: false });
                    showToast(mediaErrorMessage(error, 'ไมโครโฟน'));
                }
            }

            async function toggleCameraStream() {
                if (isCurrentDnd()) {
                    await enforceCurrentDndMode({ toast: false });
                    showToast('คุณอยู่ในสถานะ Do Not Disturb ต้องเปลี่ยนสถานะก่อนเปิดกล้อง');
                    return;
                }

                if (useLiveKitMedia()) {
                    if (desiredCameraOn || cameraStream) {
                        desiredCameraOn = false;
                        try {
                            await liveKitRoom?.localParticipant?.setCameraEnabled(false);
                        } catch {
                            // Local state is still updated so the UI does not get stuck.
                        }
                        syncLiveKitLocalMediaStreams();
                        await broadcastMeetingMediaState({ cameraOn: false });
                        scheduleMeetingVideosRender();
                        scheduleMeetingParticipantsRender();
                        showToast('ปิดกล้องแล้ว');
                        return;
                    }

                    desiredCameraOn = true;
                    if (!await ensureLiveKitRoom(currentConversationArea())) {
                        desiredCameraOn = false;
                        syncLiveKitLocalMediaStreams();
                        await broadcastMeetingMediaState({ cameraOn: false });
                        return;
                    }

                    try {
                        if (!cameraStream) {
                            await liveKitRoom.localParticipant.setCameraEnabled(true);
                        }
                        syncLiveKitLocalMediaStreams();
                        await broadcastMeetingMediaState({ cameraOn: true });
                        await openMeetingPanel('camera');
                        scheduleMeetingVideosRender();
                        scheduleMeetingParticipantsRender();
                        showToast('เปิดกล้องแล้ว');
                    } catch (error) {
                        desiredCameraOn = false;
                        try {
                            await liveKitRoom?.localParticipant?.setCameraEnabled(false);
                        } catch {
                            // Best effort cleanup.
                        }
                        syncLiveKitLocalMediaStreams();
                        await broadcastMeetingMediaState({ cameraOn: false });
                        showToast(mediaErrorMessage(error, 'กล้อง'));
                    }
                    return;
                }

                if (cameraStream) {
                    removeStreamTracksFromRtcPeers(cameraStream);
                    stopMediaStream(cameraStream);
                    cameraStream = null;
                    setDockMediaState('toggleCamera', false, 'Camera on', 'Camera off');
                    await broadcastMeetingMediaState({ cameraOn: false });
                    refreshProximityVoice();
                    scheduleMeetingVideosRender();
                    scheduleMeetingParticipantsRender();
                    showToast('ปิดกล้องแล้ว');
                    return;
                }

                if (!navigator.mediaDevices?.getUserMedia) {
                    showToast('เบราว์เซอร์นี้ยังไม่รองรับกล้อง');
                    return;
                }

                try {
                    const stream = await navigator.mediaDevices.getUserMedia({
                        audio: false,
                        video: {
                            width: { ideal: 1280 },
                            height: { ideal: 720 },
                            frameRate: { ideal: 24, max: 30 }
                        }
                    });
                    cameraStream = stream;
                    cameraStream.getVideoTracks().forEach(track => {
                        track.addEventListener('ended', () => {
                            removeStreamTracksFromRtcPeers(stream);
                            cameraStream = null;
                            setDockMediaState('toggleCamera', false, 'Camera on', 'Camera off');
                            void broadcastMeetingMediaState({ cameraOn: false });
                            refreshProximityVoice();
                            scheduleMeetingVideosRender();
                            scheduleMeetingParticipantsRender();
                        }, { once: true });
                    });
                    addStreamTracksToRtcPeers(cameraStream);
                    setDockMediaState('toggleCamera', true, 'Camera on', 'Camera off');
                    await broadcastMeetingMediaState({ cameraOn: true });
                    await openMeetingPanel('camera');
                    scheduleMeetingVideosRender();
                    scheduleMeetingParticipantsRender();
                    showToast('เปิดกล้องแล้ว');
                } catch (error) {
                    cameraStream = null;
                    setDockMediaState('toggleCamera', false, 'Camera on', 'Camera off');
                    await broadcastMeetingMediaState({ cameraOn: false });
                    showToast(mediaErrorMessage(error, 'กล้อง'));
                }
            }

            async function toggleScreenShare() {
                if (isCurrentDnd()) {
                    await enforceCurrentDndMode({ toast: false });
                    showToast('คุณอยู่ในสถานะ Do Not Disturb ต้องเปลี่ยนสถานะก่อนแชร์หน้าจอ');
                    return;
                }

                if (useLiveKitMedia()) {
                    if (desiredScreenOn || screenStream) {
                        desiredScreenOn = false;
                        try {
                            await liveKitRoom?.localParticipant?.setScreenShareEnabled(false);
                        } catch {
                            // Local state is still updated so the UI does not get stuck.
                        }

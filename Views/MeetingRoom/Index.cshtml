            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: 3px solid #172242;
            background: var(--mr-teal);
        }

        .mr-character .mr-status-dot {
            display: none !important;
        }

        .status-busy .mr-status-dot,
        .status-meeting .mr-status-dot {
            background: var(--mr-yellow);
        }

        .status-dnd .mr-status-dot {
            background: var(--mr-red);
        }

        .status-away .mr-status-dot,
        .is-offline .mr-status-dot {
            background: #94a3b8;
        }

        .mr-person-name {
            position: absolute;
            left: 50%;
            top: -18px;
            z-index: 8;
            transform: translateX(-50%);
            display: grid;
            grid-template-columns: 28px max-content;
            width: max-content;
            max-width: min(360px, calc(100vw - 32px));
            min-height: 32px;
            align-items: center;
            gap: 5px;
            padding: 4px 9px 4px 4px;
            border-radius: 11px;
            color: #fff;
            background: rgba(91,74,210,.96);
            border: 0;
            font-size: 12px;
            font-weight: 850;
            line-height: 1.15;
            box-shadow: 0 10px 22px rgba(52,45,160,.32);
        }

        .mr-person.has-status-text .mr-person-name {
            top: -30px;
            min-height: 44px;
            align-items: start;
            row-gap: 1px;
            padding-right: 10px;
        }

        .mr-person-name::after {
            content: "";
            position: absolute;
            left: 50%;
            bottom: -5px;
            width: 10px;
            height: 10px;
            background: rgba(91,74,210,.96);
            transform: translateX(-50%) rotate(45deg);
            border-radius: 2px;
        }

        .mr-name-badge {
            position: relative;
            width: 26px;
            height: 26px;
            display: inline-grid;
            place-items: center;
            border: 3px solid #23d264;
            border-radius: 50%;
            color: #66501d;
            background: #ffd090;
            font-size: 12px;
            font-weight: 850;
            line-height: 1;
            overflow: visible;
        }

        .mr-person.has-status-text .mr-name-badge {
            grid-row: 1 / span 2;
            align-self: center;
        }

        .mr-name-badge img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            border-radius: 50%;
            background: #ffd090;
            image-rendering: auto;
        }

        .mr-name-badge::after {
            content: "";
            position: absolute;
            right: -5px;
            bottom: -3px;
            width: 12px;
            height: 12px;
            border: 3px solid rgba(91,74,210,.96);
            border-radius: 50%;
            background: var(--mr-teal);

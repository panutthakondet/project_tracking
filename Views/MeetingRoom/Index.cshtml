                const dy = event.clientY - meetingPanelDragState.startY;
                setMeetingPanelPosition(meetingPanelDragState.left + dx, meetingPanelDragState.top + dy);
                event.preventDefault();
            });

            function endMeetingPanelDrag(event) {
                if (!meetingPanelDragState || (event && event.pointerId !== meetingPanelDragState.pointerId)) {
                    return;
                }


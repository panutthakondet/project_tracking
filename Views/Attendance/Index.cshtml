@{
    var hasCheckIn = ViewBag.HasCheckIn is bool checkIn && checkIn;
    var hasCheckOut = ViewBag.HasCheckOut is bool checkOut && checkOut;
    var checkInTime = ViewBag.CheckInTime as string ?? "-";
    var checkOutTime = ViewBag.CheckOutTime as string ?? "-";
    var distanceKm = ViewBag.DistanceKm as string ?? "-";
    var employeeName = ViewBag.EmployeeName as string ?? "-";
    var workDate = ViewBag.WorkDate as string ?? "-";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" />

<form id="antiForgeryForm" method="post" class="d-none" aria-hidden="true">
    @Html.AntiForgeryToken()
</form>

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">ระบบเช็คชื่อเข้างานและออกงาน</h2>
        <p class="index-subtitle">บันทึกเวลาเข้า-ออกงานพร้อมพิกัดและความแม่นยำของ GPS</p>
    </div>
    <div class="index-actions">
        <button type="button" id="btnCheckIn" onclick="checkAttendance('checkin')" class="btn btn-primary" @(hasCheckIn ? "disabled" : null)>เช็คเข้างาน</button>
        <button type="button" id="btnCheckOut" onclick="checkAttendance('checkout')" class="btn btn-outline-danger" @(!hasCheckIn || hasCheckOut ? "disabled" : null)>เช็คออกงาน</button>
    </div>
</div>

<section class="attendance-today-card">
    <div class="attendance-today-head">
        <div>
            <span class="attendance-eyebrow">การลงเวลาวันนี้</span>
            <h3>เวลาทำงานวันนี้</h3>
            <p>@employeeName · @workDate</p>
        </div>
        <span id="attendanceStatus" class="attendance-status @(hasCheckOut ? "done" : hasCheckIn ? "working" : "pending")">
            @(hasCheckOut ? "เช็คครบแล้ว" : hasCheckIn ? "อยู่ระหว่างทำงาน" : "ยังไม่เช็คเข้า")
        </span>
    </div>

    <div class="attendance-time-grid">
        <div class="attendance-time-box">
            <span>เช็คเข้างาน</span>
            <strong id="checkInTimeText">@checkInTime</strong>
            <small id="checkInHint">@(hasCheckIn ? "บันทึกเวลาเข้างานแล้ว" : "ยังไม่มีเวลาเข้างาน")</small>
        </div>
        <div class="attendance-time-box">
            <span>เช็คออกงาน</span>
            <strong id="checkOutTimeText">@checkOutTime</strong>
            <small id="checkOutHint">@(hasCheckOut ? "บันทึกเวลาออกงานแล้ว" : "ยังไม่มีเวลาออกงาน")</small>
        </div>
        <div class="attendance-time-box">
            <span>ระยะจากจุดเข้างาน</span>
            <strong id="distanceText">@(distanceKm == "-" ? "-" : $"{distanceKm} km")</strong>
            <small>คำนวณเมื่อเช็คออกงาน</small>
        </div>
    </div>
</section>

<div id="attendanceMessage" class="attendance-message" role="status" aria-live="polite"></div>
<div class="attendance-map">
    <iframe id="mapFrame" title="ตำแหน่งปัจจุบัน" width="100%" height="100%" style="border:0" loading="lazy"></iframe>
</div>

<section class="attendance-calendar-card" aria-labelledby="attendanceHolidayTitle">
    <div class="attendance-calendar-head">
        <div>
            <span class="attendance-eyebrow">วันหยุดบริษัท</span>
            <h3 id="attendanceHolidayTitle">ปฏิทินวันหยุด</h3>
        </div>
        <span class="attendance-holiday-legend"><span aria-hidden="true"></span> วันหยุด</span>
    </div>
    <div id="attendanceHolidayCalendar"></div>
</section>

<style>
    .attendance-today-card { margin-bottom:16px; padding:22px; border:1px solid var(--pt-border,#d8e3ef); border-radius:22px; color:var(--pt-surface-contrast,#10233f); background:var(--pt-surface,#fff); box-shadow:0 14px 32px var(--pt-shadow,rgba(15,35,64,.08)); }
    .attendance-today-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:18px; }
    .attendance-eyebrow { color:var(--pt-accent,#0f766e); font-size:.78rem; font-weight:700; letter-spacing:.04em; }
    .attendance-today-head h3 { margin:4px 0 0; color:var(--pt-surface-contrast,#10233f); font-size:1.35rem; font-weight:700; line-height:1.25; }
    .attendance-today-head p { margin:6px 0 0; color:var(--pt-surface-contrast-muted,#64748b); font-weight:400; }
    .attendance-status { min-height:38px; display:inline-flex; align-items:center; justify-content:center; padding:0 14px; border:1px solid var(--pt-border,#d8e3ef); border-radius:999px; color:var(--pt-surface-contrast-muted,#64748b); background:var(--pt-surface-soft,#eef4fb); font-weight:600; white-space:nowrap; }
    .attendance-status.working { color:#9a5a00; border-color:#f0bd5a; background:#fff3d7; }
    .attendance-status.done { color:#0f766e; border-color:#5fd4c5; background:#d9fbf5; }
    .attendance-time-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; }
    .attendance-time-box { min-height:122px; display:flex; flex-direction:column; justify-content:center; gap:6px; padding:18px; border:1px solid var(--pt-border,#d7e2f2); border-radius:18px; background:var(--pt-surface-soft,#f8fbff); }
    .attendance-time-box span { color:var(--pt-surface-contrast-muted,#64748b); font-weight:500; }
    .attendance-time-box strong { color:var(--pt-surface-contrast,#10233f); font-size:1.85rem; font-weight:700; line-height:1; }
    .attendance-time-box small { color:var(--pt-surface-contrast-muted,#7c8da5); font-weight:400; }
    .attendance-message { min-height:24px; margin:10px 0; color:var(--pt-surface-contrast,#10233f); font-weight:500; }
    .attendance-map { height:350px; margin-top:8px; border:1px solid var(--pt-border,#d7e2f2); border-radius:18px; overflow:hidden; background:var(--pt-surface,#fff); box-shadow:0 10px 24px var(--pt-shadow,rgba(15,35,64,.07)); }
    .attendance-calendar-card { margin-top:16px; padding:22px; border:1px solid var(--pt-border,#d8e3ef); border-radius:22px; color:var(--pt-surface-contrast,#10233f); background:var(--pt-surface,#fff); box-shadow:0 14px 32px var(--pt-shadow,rgba(15,35,64,.08)); }
    .attendance-calendar-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:18px; }
    .attendance-calendar-head h3 { margin:4px 0 0; color:var(--pt-surface-contrast,#10233f); font-size:1.35rem; font-weight:700; line-height:1.25; }
    .attendance-calendar-head p { margin:6px 0 0; color:var(--pt-surface-contrast-muted,#64748b); font-weight:400; }
    .attendance-holiday-legend { display:inline-flex; align-items:center; gap:7px; color:var(--pt-surface-contrast-muted,#64748b); font-size:.9rem; white-space:nowrap; }
    .attendance-holiday-legend span { width:12px; height:12px; border:2px solid #ef4444; background:#fff7f7; }
    #attendanceHolidayCalendar { min-height:570px; }
    #attendanceHolidayCalendar .fc { color:var(--pt-surface-contrast,#10233f); font-family:inherit; font-size:.9rem; }
    #attendanceHolidayCalendar .fc-theme-standard td,
    #attendanceHolidayCalendar .fc-theme-standard th,
    #attendanceHolidayCalendar .fc-theme-standard .fc-scrollgrid { border-color:var(--pt-border,#dbe5ef); }
    #attendanceHolidayCalendar .fc-col-header-cell { padding:8px 4px; background:var(--pt-surface-soft,#f8fafc); }
    #attendanceHolidayCalendar .fc-col-header-cell-cushion,
    #attendanceHolidayCalendar .fc-daygrid-day-number { color:var(--pt-surface-contrast,#10233f); text-decoration:none; font-weight:500; }
    #attendanceHolidayCalendar .fc-day-today { background:var(--pt-accent-soft,rgba(20,184,166,.08)) !important; }
    #attendanceHolidayCalendar .fc-button-primary { border-color:var(--pt-accent,#14b8a6); background:var(--pt-accent-dark,#0f766e); box-shadow:none; font-weight:500; }
    #attendanceHolidayCalendar .fc-button-primary:hover,
    #attendanceHolidayCalendar .fc-button-primary:not(:disabled).fc-button-active { border-color:var(--pt-accent-dark,#0f766e); background:var(--pt-accent,#14b8a6); }
    #attendanceHolidayCalendar .fc-toolbar-title { color:var(--pt-surface-contrast,#10233f); font-size:1.2rem; font-weight:700; text-shadow:none; }
    #attendanceHolidayCalendar .fc-daygrid-event,
    #attendanceHolidayCalendar .fc-list-event { padding:3px 6px; border-width:2px !important; border-radius:4px; box-shadow:none; font-weight:500; }
    #attendanceHolidayCalendar .fc-daygrid-event,
    #attendanceHolidayCalendar .fc-daygrid-event .fc-event-main-frame,
    #attendanceHolidayCalendar .fc-daygrid-event .fc-event-title-container,
    #attendanceHolidayCalendar .fc-daygrid-event .fc-event-title {
        min-width:0;
        overflow:visible;
        white-space:normal !important;
    }
    #attendanceHolidayCalendar .fc-daygrid-event .fc-event-main-frame { display:block; }
    #attendanceHolidayCalendar .fc-daygrid-event .fc-event-title {
        line-height:1.3;
        overflow-wrap:anywhere;
        word-break:break-word;
    }
    #attendanceHolidayCalendar .fc-list { border-color:var(--pt-border,#dbe5ef); }
    #attendanceHolidayCalendar .fc-list-day-cushion,
    #attendanceHolidayCalendar .fc-list-event:hover td { background:var(--pt-surface-soft,#f8fafc); }
    #btnCheckIn:disabled, #btnCheckOut:disabled { cursor:not-allowed; opacity:.5; }
    @@media (max-width:768px) {
        .attendance-today-head, .attendance-calendar-head { flex-direction:column; }
        .attendance-time-grid { grid-template-columns:1fr; }
        .attendance-calendar-card { padding:14px; }
        #attendanceHolidayCalendar { min-height:500px; }
        #attendanceHolidayCalendar .fc-header-toolbar { align-items:stretch; flex-direction:column; gap:10px; }
        #attendanceHolidayCalendar .fc-toolbar-chunk { display:flex; justify-content:center; }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/locales-all.global.min.js"></script>
<script>
    const attendanceState = {
        hasCheckIn: @hasCheckIn.ToString().ToLowerInvariant(),
        hasCheckOut: @hasCheckOut.ToString().ToLowerInvariant(),
        busy: false
    };

    function setButtonState() {
        const checkInButton = document.getElementById('btnCheckIn');
        const checkOutButton = document.getElementById('btnCheckOut');
        checkInButton.disabled = attendanceState.busy || attendanceState.hasCheckIn;
        checkOutButton.disabled = attendanceState.busy || !attendanceState.hasCheckIn || attendanceState.hasCheckOut;
    }

    function updateAttendanceStatus(status) {
        const badge = document.getElementById('attendanceStatus');
        badge.className = `attendance-status ${status}`;
        badge.textContent = status === 'done' ? 'เช็คครบแล้ว' : status === 'working' ? 'อยู่ระหว่างทำงาน' : 'ยังไม่เช็คเข้า';
    }

    function updateAttendanceTimes(result) {
        if (result.checkinTime) {
            document.getElementById('checkInTimeText').textContent = result.checkinTime;
            document.getElementById('checkInHint').textContent = 'บันทึกเวลาเข้างานแล้ว';
        }
        if (result.checkoutTime) {
            document.getElementById('checkOutTimeText').textContent = result.checkoutTime;
            document.getElementById('checkOutHint').textContent = 'บันทึกเวลาออกงานแล้ว';
        }
        if (result.distanceKm !== undefined && result.distanceKm !== null) {
            const distance = Number(result.distanceKm);
            if (Number.isFinite(distance)) document.getElementById('distanceText').textContent = `${distance.toFixed(2)} km`;
        }
    }

    function showPositionOnMap(position) {
        const lat = position.coords.latitude;
        const lng = position.coords.longitude;
        document.getElementById('mapFrame').src = `https://www.google.com/maps?q=${lat},${lng}&z=16&output=embed`;
    }

    function gpsErrorMessage(error) {
        if (error.code === error.PERMISSION_DENIED) return 'คุณยังไม่ได้อนุญาตให้เว็บไซต์ใช้ตำแหน่ง';
        if (error.code === error.POSITION_UNAVAILABLE) return 'ไม่สามารถระบุตำแหน่งปัจจุบันได้';
        if (error.code === error.TIMEOUT) return 'ใช้เวลาระบุตำแหน่งนานเกินไป';
        return 'ไม่สามารถใช้งาน GPS ได้';
    }

    function checkAttendance(type) {
        if (attendanceState.busy) return;
        if (!navigator.geolocation) {
            alert('อุปกรณ์นี้ไม่รองรับ Location / GPS');
            return;
        }

        attendanceState.busy = true;
        setButtonState();
        document.getElementById('attendanceMessage').textContent = 'กำลังตรวจสอบตำแหน่งปัจจุบัน...';

        navigator.geolocation.getCurrentPosition(async position => {
            showPositionOnMap(position);
            try {
                const response = await fetch('@Url.Action("Save", "Attendance")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        lat: position.coords.latitude,
                        lng: position.coords.longitude,
                        accuracy: position.coords.accuracy,
                        type
                    })
                });
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const result = await response.json();
                if (!result.success) {
                    alert(`❌ ${result.message}`);
                    return;
                }

                updateAttendanceTimes(result);
                if (type === 'checkin') attendanceState.hasCheckIn = true;
                if (type === 'checkout') attendanceState.hasCheckOut = true;
                updateAttendanceStatus(attendanceState.hasCheckOut ? 'done' : 'working');
                const accuracy = Number(result.accuracyM);
                document.getElementById('attendanceMessage').textContent = Number.isFinite(accuracy)
                    ? `บันทึกเรียบร้อย · ความแม่นยำ GPS ประมาณ ${accuracy.toFixed(0)} เมตร`
                    : 'บันทึกเรียบร้อย';
                alert(type === 'checkin' ? '✅ เช็คเข้างานเรียบร้อย' : '✅ เช็คออกงานเรียบร้อย');
            } catch (error) {
                console.error('Attendance save failed', error);
                alert('❌ เกิดข้อผิดพลาดในการบันทึก กรุณาลองใหม่');
            } finally {
                attendanceState.busy = false;
                setButtonState();
            }
        }, error => {
            attendanceState.busy = false;
            setButtonState();
            document.getElementById('attendanceMessage').textContent = '';
            alert(`❌ ${gpsErrorMessage(error)}\n\nกรุณาเปิด Location / GPS และอนุญาตเว็บไซต์ก่อนใช้งาน`);
        }, { enableHighAccuracy:true, timeout:30000, maximumAge:0 });
    }

    window.addEventListener('DOMContentLoaded', () => {
        setButtonState();
        initializeHolidayCalendar();
        if (!navigator.geolocation) return;
        navigator.geolocation.getCurrentPosition(showPositionOnMap, () => {}, { enableHighAccuracy:true, timeout:15000, maximumAge:0 });
    });

    function initializeHolidayCalendar() {
        const element = document.getElementById('attendanceHolidayCalendar');
        if (!element || typeof FullCalendar === 'undefined') return;

        const thaiMonths = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน', 'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'];
        const calendar = new FullCalendar.Calendar(element, {
            locale: 'th',
            initialView: window.matchMedia('(max-width: 767.98px)').matches ? 'listMonth' : 'dayGridMonth',
            firstDay: 0,
            height: 'auto',
            fixedWeekCount: false,
            dayMaxEvents: true,
            displayEventTime: false,
            eventDisplay: 'block',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,listMonth'
            },
            buttonText: {
                today: 'วันนี้',
                month: 'เดือน',
                list: 'รายการ'
            },
            events: '@Url.Action("HolidayEvents", "Attendance")',
            eventDidMount: function (info) {
                info.el.title = info.event.title;
            },
            datesSet: function () {
                window.requestAnimationFrame(function () {
                    const title = element.querySelector('.fc-toolbar-title');
                    if (!title) return;
                    const current = calendar.getDate();
                    title.textContent = `${thaiMonths[current.getMonth()]} ${current.getFullYear() + 543}`;
                });
            }
        });

        calendar.render();
    }
</script>

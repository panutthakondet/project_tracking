@model ProjectTracking.ViewModels.AttendanceReportViewModel
@using ProjectTracking.Models
@using ProjectTracking.Services

@functions {
    private static string ThaiDate(DateTime date) => $"{date:dd/MM}/{date.Year + 543}";
}

@{
    Layout = null;
    var rows = Model.Rows;
    var noCheckIn = rows.Where(x => x.CheckinTime == null).ToList();
    var noCheckOut = rows.Where(x => x.CheckinTime != null && x.CheckoutTime == null).ToList();
    var checkedInCount = rows.Count(x => x.CheckinTime != null);
    var checkedOutCount = rows.Count(x => x.CheckoutTime != null);
    var generatedAt = AttendancePolicyService.ThailandNow;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>รายงานการเช็คเวลาเข้า-ออกงาน</title>
    @await Html.PartialAsync("_StandaloneTheme")
    <style>
        * { box-sizing:border-box; }
        body { margin:0; padding:16px; color:var(--pt-surface-contrast,#10233f); background:var(--pt-body-bg,#eef3f9); font-family:var(--pt-font-family,"Noto Sans Thai",Tahoma,Arial,sans-serif); font-size:12px; text-rendering:optimizeLegibility; -webkit-font-smoothing:antialiased; }
        .report-shell { max-width:1900px; margin:0 auto; }
        .report-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:8px; margin-bottom:12px; }
        .report-btn { min-height:36px; display:inline-flex; align-items:center; justify-content:center; padding:7px 14px; border:1px solid var(--pt-accent,#258cfb); border-radius:10px; color:var(--pt-accent,#1d4ed8); background:var(--pt-surface,#fff); font:600 12px/1.2 inherit; text-decoration:none; cursor:pointer; }
        .report-btn.primary { color:var(--pt-accent-contrast,#fff); background:var(--pt-accent,#102443); }
        .print-header { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:12px; padding:16px 18px; border:1px solid var(--pt-border,#d8e3ef); color:var(--pt-surface-contrast,#10233f); background:var(--pt-surface,#fff); }
        .print-header h1 { margin:0 0 4px; font-size:21px; font-weight:700; }
        .print-header p { margin:0; color:var(--pt-surface-contrast-muted,#64748b); font-weight:400; }
        .print-header__meta { color:var(--pt-surface-contrast-muted,#64748b); text-align:right; }
        .filter-panel { position:relative; z-index:5; display:grid; grid-template-columns:minmax(180px,1.2fr) minmax(160px,.8fr) minmax(160px,.8fr) auto; align-items:end; gap:10px; margin-bottom:12px; padding:14px; border:1px solid var(--pt-border,#d8e3ef); background:var(--pt-surface,#fff); }
        .field label { display:block; margin-bottom:5px; color:var(--pt-surface-contrast,#10233f); font-weight:600; }
        .field input, .field select { width:100%; min-height:38px; padding:7px 10px; border:1px solid var(--pt-border,#cbd5e1); border-radius:8px; color:var(--pt-surface-contrast,#10233f); background:var(--pt-surface,#fff); font:400 12px/1.2 inherit; }
        .field input { text-align:center; }
        .validation { margin-bottom:12px; padding:10px 12px; border:1px solid #ef9a9a; color:#b42318; background:#fff1f1; font-weight:500; }
        .kpi-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:8px; margin-bottom:12px; }
        .kpi { padding:10px 12px; border:1px solid var(--pt-border,#d8e3ef); border-top:3px solid #14b8a6; color:var(--pt-surface-contrast,#10233f); background:var(--pt-surface,#fff); }
        .kpi.info { border-top-color:#258cfb; } .kpi.warning { border-top-color:#f59e0b; } .kpi.danger { border-top-color:#f43f5e; }
        .kpi span, .kpi small { display:block; color:var(--pt-surface-contrast-muted,#64748b); font-weight:400; }
        .kpi strong { display:block; margin:4px 0; font-size:20px; font-weight:700; }
        h2 { margin:14px 0 8px; font-size:16px; font-weight:700; }
        .table-wrap { overflow:auto; border:1px solid var(--pt-border,#d8e3ef); background:var(--pt-surface,#fff); }
        table { width:100%; min-width:980px; border-collapse:collapse; table-layout:fixed; }
        th { padding:8px 6px; border:1px solid color-mix(in srgb,var(--pt-accent,#102443) 70%,white); color:var(--pt-accent-contrast,#fff); background:var(--pt-accent-dark,#102443); font-weight:600; text-align:center; }
        td { padding:8px 6px; border:1px solid var(--pt-border,#d8e3ef); color:var(--pt-surface-contrast,#10233f); background:var(--pt-surface,#fff); font-weight:400; line-height:1.45; vertical-align:top; overflow-wrap:anywhere; }
        tbody tr:nth-child(even) td { background:var(--pt-surface-soft,#f8fbff); }
        .text-center { text-align:center; }
        .status-text { font-weight:600; } .success { color:#0f8f5f; } .warning { color:#b7790b; } .danger { color:#d6294f; }
        .map-link { min-height:28px; padding:4px 9px; border:1px solid var(--pt-accent,#14b8a6); border-radius:8px; color:var(--pt-accent,#0f766e); background:var(--pt-surface,#fff); font:500 11px/1.2 inherit; cursor:pointer; }
        .empty { padding:18px; border:1px dashed var(--pt-border,#cbd5e1); color:var(--pt-surface-contrast-muted,#64748b); background:var(--pt-surface,#fff); text-align:center; }
        .muted { color:var(--pt-surface-contrast-muted,#94a3b8); }
        @@page { size:A4 landscape; margin:8mm; }
        @@media print { body { padding:0; color:#111; background:#fff; } .report-actions,.filter-panel,.no-print,.validation { display:none!important; } .print-header,.kpi,.table-wrap,td { color:#111; background:#fff!important; box-shadow:none; } thead { display:table-header-group; } tr { break-inside:avoid; page-break-inside:avoid; } }
        @@media (max-width:900px) { .filter-panel,.kpi-grid { grid-template-columns:1fr; } .print-header { align-items:flex-start; flex-direction:column; } .print-header__meta { text-align:left; } }
    </style>
</head>
<body>
<main class="report-shell">
    <div class="report-actions">
        <button type="button" class="report-btn primary" onclick="window.print()">พิมพ์รายงาน</button>
        <a asp-controller="Reports" asp-action="Index" class="report-btn">ศูนย์รวมรายงาน</a>
        <a asp-controller="Home" asp-action="Index" class="report-btn">Dashboard</a>
    </div>

    <header class="print-header">
        <div>
            <h1>รายงานการเช็คเวลาเข้า-ออกงาน</h1>
            <p>แสดงเฉพาะวันทำการ จันทร์-ศุกร์ และตัดวันหยุดบริษัทที่ตั้งค่าไว้</p>
        </div>
        <div class="print-header__meta">ช่วงวันที่ @Model.FromDate - @Model.ToDate<br />ข้อมูล ณ @ThaiDate(generatedAt) @generatedAt.ToString("HH:mm") น.</div>
    </header>

    <form method="get" class="filter-panel">
        <div class="field">
            <label for="departmentId">ฝ่าย</label>
            <select id="departmentId" name="departmentId">
                <option value="">ทุกฝ่าย</option>
                @foreach (var department in (IEnumerable<ProjectDepartment>)(ViewBag.ProjectDepartments ?? Enumerable.Empty<ProjectDepartment>()))
                {
                    <option value="@department.DepartmentId" selected="@(ViewBag.SelectedDepartmentId is int id && id == department.DepartmentId ? "selected" : null)">@department.DepartmentName</option>
                }
            </select>
        </div>
        <div class="field"><label for="fromDate">จากวันที่</label><input id="fromDate" name="fromDate" value="@Model.FromDate" placeholder="วว/ดด/พ.ศ." /></div>
        <div class="field"><label for="toDate">ถึงวันที่</label><input id="toDate" name="toDate" value="@Model.ToDate" placeholder="วว/ดด/พ.ศ." /></div>
        <button type="submit" class="report-btn primary">แสดงข้อมูล</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ValidationMessage))
    {
        <div class="validation">@Model.ValidationMessage</div>
    }

    <section class="kpi-grid">
        <article class="kpi info"><span>รายการทั้งหมด</span><strong>@rows.Count</strong><small>คน × วันทำการ</small></article>
        <article class="kpi"><span>เช็คเข้าแล้ว</span><strong>@checkedInCount</strong><small>รายการ</small></article>
        <article class="kpi"><span>เช็คออกแล้ว</span><strong>@checkedOutCount</strong><small>รายการ</small></article>
        <article class="kpi danger"><span>ไม่เช็คเข้า</span><strong>@noCheckIn.Count</strong><small>รายการที่ต้องตรวจสอบ</small></article>
        <article class="kpi warning"><span>ไม่เช็คออก</span><strong>@noCheckOut.Count</strong><small>รายการที่ต้องตรวจสอบ</small></article>
    </section>

    <h2>รายการที่ต้องตรวจสอบ</h2>
    @if (!noCheckIn.Any() && !noCheckOut.Any())
    {
        <div class="empty">ไม่พบรายการผิดปกติในช่วงวันที่เลือก</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th style="width:50px">ลำดับ</th><th style="width:110px">สถานะ</th><th style="width:110px">วันที่</th><th>พนักงาน</th><th>ตำแหน่ง</th></tr></thead>
                <tbody>
                    @{ var issueSequence = 1; }
                    @foreach (var item in noCheckIn)
                    {
                        <tr><td class="text-center">@issueSequence</td><td class="text-center"><span class="status-text danger">ไม่เช็คเข้า</span></td><td class="text-center">@ThaiDate(item.WorkDate)</td><td>@item.EmpName</td><td>@item.Position</td></tr>
                        issueSequence++;
                    }
                    @foreach (var item in noCheckOut)
                    {
                        <tr><td class="text-center">@issueSequence</td><td class="text-center"><span class="status-text warning">ไม่เช็คออก</span></td><td class="text-center">@ThaiDate(item.WorkDate)</td><td>@item.EmpName</td><td>@item.Position</td></tr>
                        issueSequence++;
                    }
                </tbody>
            </table>
        </div>
    }

    <h2>ตารางเข้า-ออกงาน</h2>
    @if (!rows.Any())
    {
        <div class="empty">ไม่พบข้อมูลตามเงื่อนไขที่เลือก</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th style="width:50px">ลำดับ</th><th style="width:110px">วันที่</th><th>พนักงาน</th><th>ตำแหน่ง</th><th style="width:90px">เข้า</th><th style="width:90px">ออก</th><th style="width:115px">GPS เข้า/ออก</th><th style="width:90px">ระยะ</th><th class="no-print" style="width:90px">แผนที่</th></tr></thead>
                <tbody>
                    @{ var rowSequence = 1; }
                    @foreach (var item in rows)
                    {
                        <tr>
                            <td class="text-center">@rowSequence</td>
                            <td class="text-center">@ThaiDate(item.WorkDate)</td>
                            <td>@item.EmpName</td>
                            <td>@item.Position</td>
                            <td class="text-center">@if (item.CheckinTime.HasValue) { <span class="status-text success">@item.CheckinTime.Value.ToString("HH:mm")</span> } else { <span class="status-text danger">ไม่เช็ค</span> }</td>
                            <td class="text-center">@if (item.CheckoutTime.HasValue) { <span class="status-text success">@item.CheckoutTime.Value.ToString("HH:mm")</span> } else if (item.CheckinTime.HasValue) { <span class="status-text warning">ไม่เช็ค</span> } else { <span class="muted">-</span> }</td>
                            <td class="text-center">@(item.CheckinAccuracyM?.ToString("0") ?? "-") / @(item.CheckoutAccuracyM?.ToString("0") ?? "-") ม.</td>
                            <td class="text-center">@(item.DistanceKm?.ToString("0.00") ?? "-") กม.</td>
                            <td class="text-center no-print">
                                @if (item.CheckinLat.HasValue && item.CheckinLng.HasValue)
                                {
                                    <button type="button" class="map-link" data-in-lat="@item.CheckinLat" data-in-lng="@item.CheckinLng" data-out-lat="@item.CheckoutLat" data-out-lng="@item.CheckoutLng" onclick="openGoogleMap(this)">ดูแผนที่</button>
                                }
                                else { <span class="muted">-</span> }
                            </td>
                        </tr>
                        rowSequence++;
                    }
                </tbody>
            </table>
        </div>
    }
</main>

<script>
    function openGoogleMap(button) {
        const inLat = button.dataset.inLat;
        const inLng = button.dataset.inLng;
        const outLat = button.dataset.outLat;
        const outLng = button.dataset.outLng;
        const url = outLat && outLng
            ? `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(inLat + ',' + inLng)}&destination=${encodeURIComponent(outLat + ',' + outLng)}`
            : `https://www.google.com/maps?q=${encodeURIComponent(inLat + ',' + inLng)}`;
        window.open(url, '_blank', 'noopener');
    }
</script>
</body>
</html>

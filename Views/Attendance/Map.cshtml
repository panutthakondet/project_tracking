@model IEnumerable<dynamic>

<h3>📍 รายงานเข้า-ออกงาน</h3>

<form method="get" class="mb-3">
    <label>จากวันที่:</label>
    <input type="text" id="fromDate" name="fromDate" value="@(ViewBag.FromDate ?? DateTime.Now.ToString("dd/MM/yyyy"))" class="form-control" style="max-width:180px; display:inline-block;" placeholder="dd/MM/2569" />

    <label class="ms-2">ถึงวันที่:</label>
    <input type="text" id="toDate" name="toDate" value="@(ViewBag.ToDate ?? DateTime.Now.ToString("dd/MM/yyyy"))" class="form-control" style="max-width:180px; display:inline-block;" placeholder="dd/MM/2569" />

    <button type="submit" class="btn btn-primary ms-2">ค้นหา</button>

    <button type="button" class="btn btn-danger ms-2" onclick="openPdfNewTab()">
        🖨️ Preview PDF
    </button>
</form>

@{
    var noCheckin = Model
        .Where(x => x.CheckinTime == null)
        .Select(x => new {
            x.EmpName,
            x.Position,
            WorkDate = (DateTime)x.WorkDate
        })
        .ToList();

    var noCheckout = Model
        .Where(x => x.CheckinTime != null && x.CheckoutTime == null)
        .Select(x => new {
            x.EmpName,
            x.Position,
            WorkDate = (DateTime)x.WorkDate
        })
        .ToList();

    var attendanceIssues = noCheckin
        .Select(x => new {
            Status = "ไม่เช็คเข้า",
            Tone = "danger",
            x.WorkDate,
            x.EmpName,
            x.Position
        })
        .Concat(noCheckout.Select(x => new {
            Status = "ไม่เช็คออก",
            Tone = "warning",
            x.WorkDate,
            x.EmpName,
            x.Position
        }))
        .OrderBy(x => x.WorkDate)
        .ThenBy(x => x.EmpName)
        .ToList();
}

@if (noCheckin.Any() || noCheckout.Any())
{
    <div class="card shadow-sm mb-3 attendance-issue-card">
        <div class="card-header fw-bold">
            รายการที่ต้องตรวจสอบ
            <span class="badge bg-danger ms-2">ไม่เช็คเข้า @noCheckin.Count</span>
            <span class="badge bg-warning text-dark ms-1">ไม่เช็คออก @noCheckout.Count</span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover align-middle mb-0 attendance-issue-table">
                <thead class="table-light">
                    <tr>
                        <th style="width:140px;">สถานะ</th>
                        <th style="width:130px;">วันที่</th>
                        <th>ชื่อพนักงาน</th>
                        <th>ตำแหน่ง</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in attendanceIssues)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-@emp.Tone @(emp.Tone == "warning" ? "text-dark" : "")">@emp.Status</span>
                            </td>
                            <td>@emp.WorkDate.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("th-TH"))</td>
                            <td>@emp.EmpName</td>
                            <td>@emp.Position</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-success mb-3">ทุกคนเช็คเข้า-ออกครบตามช่วงวันที่เลือก</div>
}

<div class="card shadow-sm attendance-table-card">
    <div class="card-header fw-bold">ตารางเข้า-ออกงาน</div>
    <div class="table-responsive">
        <table class="table table-bordered table-sm table-hover align-middle mb-0 attendance-main-table">
            <thead class="table-light text-center">
                <tr>
                    <th style="width:70px;">ลำดับ</th>
                    <th style="width:130px;">วันที่</th>
                    <th>ชื่อพนักงาน</th>
                    <th>ตำแหน่ง</th>
                    <th style="width:120px;">เวลาเข้า</th>
                    <th style="width:120px;">เวลาออก</th>
                    <th style="width:130px;">ระยะทาง (km)</th>
                    <th style="width:120px;">แผนที่</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var i = 1;
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">@i</td>
                        <td class="text-center">
                            @{
                                DateTime d = item.WorkDate;
                                @d.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("th-TH"))
                            }
                        </td>
                        <td>@item.EmpName</td>
                        <td>@item.Position</td>
                        <td class="text-center">
                            @if (item.CheckinTime != null)
                            {
                                @item.CheckinTime?.ToString("HH:mm")
                            }
                            else
                            {
                                <span class="badge bg-danger">ไม่เช็คเข้า</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.CheckoutTime != null)
                            {
                                @item.CheckoutTime?.ToString("HH:mm")
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">ไม่เช็คออก</span>
                            }
                        </td>
                        <td class="text-center">@(item.DistanceKm != null ? string.Format("{0:0.00}", item.DistanceKm) : "-")</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-success"
                                    onclick="openGoogleMap('@item.CheckinLat','@item.CheckinLng','@item.CheckoutLat','@item.CheckoutLng')">
                                ดูแผนที่
                            </button>
                        </td>
                    @{ i++; }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .attendance-issue-card,
    .attendance-table-card {
        border:0;
        border-radius:14px;
        overflow:hidden;
    }

    .attendance-issue-card .card-header,
    .attendance-table-card .card-header {
        background:#10213f;
        color:#fff;
        border-bottom:0;
    }

    .attendance-issue-table thead th,
    .attendance-main-table thead th {
        color:#0f172a;
        font-weight:800;
        white-space:nowrap;
        vertical-align:middle;
    }

    .attendance-issue-table td,
    .attendance-main-table td {
        vertical-align:middle;
    }

    .attendance-main-table td:nth-child(3),
    .attendance-main-table td:nth-child(4),
    .attendance-issue-table td:nth-child(3),
    .attendance-issue-table td:nth-child(4) {
        min-width:220px;
    }
</style>

<!-- Modal -->
<div id="mapModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:#00000099; z-index:9999;">
    <div style="width:80%; height:80%; background:#fff; margin:5% auto; padding:10px; border-radius:10px;">
        <div style="display:flex; justify-content:space-between;">
            <h5 id="mapTitle"></h5>
            <button class="btn btn-danger btn-sm" onclick="closeMap()">ปิด</button>
        </div>
        <div id="map" style="width:100%; height:500px;"></div>
    </div>
</div>

<!-- PDF Modal -->
<div id="pdfModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:#00000099; z-index:9999;">
    <div style="width:90%; height:90%; background:#fff; margin:3% auto; padding:10px; border-radius:10px;">
        <div style="display:flex; justify-content:space-between;">
            <h5>Preview PDF</h5>
            <button class="btn btn-danger btn-sm" onclick="closePdf()">ปิด</button>
        </div>
        <iframe id="pdfFrame" style="width:100%; height:90%; border:none;"></iframe>
    </div>
</div>

<!-- 🔥 ใส่ Google Maps API KEY ของคุณแทน YOUR_KEY -->
<script src="https://maps.googleapis.com/maps/api/js?key=YOUR_KEY&callback=initMapLoader" defer></script>

<script>
    let map;

    function initMapLoader() {
        // placeholder to ensure API is ready
    }

    function openMap(inLat, inLng, outLat, outLng, name) {
        if (!inLat || !inLng) {
            alert('ไม่พบพิกัด Check-in');
            return;
        }

        document.getElementById("mapModal").style.display = "block";
        document.getElementById("mapTitle").innerText = name;

        const checkin = { lat: parseFloat(inLat), lng: parseFloat(inLng) };
        const mapOptions = {
            zoom: 14,
            center: checkin
        };

        map = new google.maps.Map(document.getElementById("map"), mapOptions);

        setTimeout(() => {
            google.maps.event.trigger(map, 'resize');
            map.setCenter(checkin);
        }, 300);

        // IN
        new google.maps.Marker({
            position: checkin,
            map: map,
            label: "IN"
        });

        // OUT
        if (outLat && outLng) {
            const checkout = { lat: parseFloat(outLat), lng: parseFloat(outLng) };

            new google.maps.Marker({
                position: checkout,
                map: map,
                label: "OUT"
            });

            new google.maps.Polyline({
                path: [checkin, checkout],
                map: map,
                strokeColor: "#007bff",
                strokeWeight: 3
            });
        }
    }

    function closeMap() {
        document.getElementById("mapModal").style.display = "none";
    }
</script>
<script>
function openGoogleMap(inLat, inLng, outLat, outLng) {
    if (!inLat || !inLng) {
        alert('ไม่พบพิกัด Check-in');
        return;
    }

    // ถ้ามีทั้งเข้าและออก → เปิด route
    if (outLat && outLng) {
        const url = `https://www.google.com/maps/dir/?api=1&origin=${inLat},${inLng}&destination=${outLat},${outLng}`;
        window.open(url, '_blank');
    } else {
        // ถ้ามีแค่เข้า → เปิดจุดเดียว
        const url = `https://www.google.com/maps?q=${inLat},${inLng}`;
        window.open(url, '_blank');
    }
}
</script>
<script>
function convertToThaiDate(inputId) {
    const el = document.getElementById(inputId);
    if (!el || !el.value) return;

    const parts = el.value.split('-');
    if (parts.length === 3) {
        const y = parseInt(parts[0]) + 543;
        const m = parts[1];
        const d = parts[2];
        el.value = `${d}/${m}/${y}`;
    }
}

window.onload = function() {
    convertToThaiDate('fromDate');
    convertToThaiDate('toDate');
};
</script>
<script>
function openPdfNewTab() {
    const fromDate = document.getElementById("fromDate").value;
    const toDate = document.getElementById("toDate").value;

    const url = `/Attendance/ExportPdf?fromDate=${fromDate}&toDate=${toDate}`;

    window.open(url, '_blank');
}

function closePdf() {
    document.getElementById("pdfModal").style.display = "none";
    document.getElementById("pdfFrame").src = "";
}
</script>

@model IEnumerable<dynamic>
@using System.Globalization

@{
    Layout = null;
    var th = new CultureInfo("th-TH");
    var rows = Model?.ToList() ?? new List<dynamic>();
    var currentDateText = DateTime.Now.ToString("dd/MM/yyyy", th);
    var fromDateText = ViewBag.FromDate as string ?? currentDateText;
    var toDateText = ViewBag.ToDate as string ?? currentDateText;

    var noCheckin = rows
        .Where(x => x.CheckinTime == null)
        .Select(x => new {
            x.EmpName,
            x.Position,
            WorkDate = (DateTime)x.WorkDate
        })
        .ToList();

    var noCheckout = rows
        .Where(x => x.CheckinTime != null && x.CheckoutTime == null)
        .Select(x => new {
            x.EmpName,
            x.Position,
            WorkDate = (DateTime)x.WorkDate
        })
        .ToList();

    var attendanceIssues = noCheckin
        .Select(x => new {
            Status = "ไม่เช็คเข้า",
            Tone = "danger",
            x.WorkDate,
            x.EmpName,
            x.Position
        })
        .Concat(noCheckout.Select(x => new {
            Status = "ไม่เช็คออก",
            Tone = "warning",
            x.WorkDate,
            x.EmpName,
            x.Position
        }))
        .OrderBy(x => x.WorkDate)
        .ThenBy(x => x.EmpName)
        .ToList();

    var checkedInCount = rows.Count(x => x.CheckinTime != null);
    var checkedOutCount = rows.Count(x => x.CheckoutTime != null);
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>Attendance Check-in/Check-out Report</title>
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&display=swap");
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 16px;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 11px;
        }
        .report-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 12px;
        }
        .report-btn {
            min-height: 34px;
            padding: 7px 13px;
            border: 1px solid #102443;
            border-radius: 999px;
            color: #102443;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 900;
            line-height: 1.1;
            text-decoration: none;
            cursor: pointer;
        }
        .report-btn.primary {
            color: #fff;
            background: #102443;
        }
        .print-header {
            margin-bottom: 12px;
            padding: 14px 16px;
            color: #fff;
            background: #102443;
        }
        .print-header h1 {
            margin: 0 0 6px;
            font-size: 22px;
        }
        .print-header div {
            color: rgba(255,255,255,.82);
            font-weight: 700;
            line-height: 1.55;
        }
        .filter-panel {
            display: grid;
            grid-template-columns: repeat(2, minmax(180px, 240px)) auto;
            align-items: end;
            gap: 10px;
            margin-bottom: 12px;
            padding: 12px;
            border: 1px solid #d8e3ef;
            background: #f8fbff;
        }
        .filter-submit {
            width: auto;
            min-width: 88px;
            justify-self: start;
        }
        .field label {
            display: block;
            margin-bottom: 5px;
            color: #64748b;
            font-weight: 900;
        }
        .field input {
            width: 100%;
            min-height: 34px;
            padding: 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            text-align: center;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin-bottom: 12px;
        }
        .kpi {
            padding: 10px;
            border: 1px solid #d8e3ef;
            border-left: 4px solid #14b8a6;
        }
        .kpi.warning { border-left-color: #f59e0b; }
        .kpi.danger { border-left-color: #f43f5e; }
        .kpi.info { border-left-color: #258cfb; }
        .kpi span,
        .kpi small {
            display: block;
            color: #64748b;
            font-weight: 800;
        }
        .kpi strong {
            display: block;
            margin: 5px 0;
            color: #10233f;
            font-size: 20px;
            font-weight: 900;
        }
        h2 {
            margin: 14px 0 8px;
            color: #10233f;
            font-size: 16px;
            font-weight: 900;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin-bottom: 12px;
        }
        th {
            padding: 7px 6px;
            color: #fff;
            background: #102443;
            border: 1px solid rgba(255,255,255,.18);
            font-weight: 900;
            text-align: center;
        }
        td {
            padding: 7px 6px;
            border: 1px solid #d8e3ef;
            line-height: 1.45;
            vertical-align: top;
            overflow-wrap: anywhere;
        }
        tr:nth-child(even) td { background: #f8fbff; }
        .text-center { text-align: center; }
        .status-text {
            font-weight: 900;
        }
        .status-text.success { color: #0f8f5f; }
        .status-text.warning { color: #b7790b; }
        .status-text.danger { color: #d6294f; }
        .map-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 28px;
            padding: 5px 10px;
            border: 1px solid #14b8a6;
            border-radius: 999px;
            color: #0f766e;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 11px;
            font-weight: 900;
            cursor: pointer;
        }
        .empty {
            padding: 18px;
            border: 1px dashed #cbd5e1;
            color: #64748b;
            text-align: center;
            font-weight: 800;
        }
        .muted {
            color: #94a3b8;
            font-weight: 800;
        }
        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
        @@media print {
            body { padding: 0; }
            .report-actions,
            .filter-panel,
            .no-print { display: none !important; }
            h2, h3,
            .project-group-row,
            .scenario-project__header,
            .scenario-group__header,
            .phase-project-group {
                break-after: avoid;
                page-break-after: avoid;
            }
            h2 + table,
            h2 + .empty,
            h2 + .report-table-scroll,
            h3 + table,
            h3 + .empty,
            .project-group-row + tr {
                break-before: avoid;
                page-break-before: avoid;
            }
            .report-section,
            .scenario-project,
            .scenario-group,
            .project-group-row,
            .phase-project-group {
                break-inside: avoid-page;
                page-break-inside: avoid;
            }
            thead { display: table-header-group; }
            tr { page-break-inside: avoid; }
        }
        @@media (max-width: 900px) {
            .filter-panel,
            .kpi-grid {
                grid-template-columns: 1fr;
            }
        }
    
        /* Crisp typography normalization for standalone pages. */
        :root { --pt-readable-thai-font: "Noto Sans Thai", "Leelawadee UI", Tahoma, "Segoe UI", Arial, sans-serif; }
        html, body {
            font-family: var(--pt-readable-thai-font) !important;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }
        body :where(*):not(svg):not(svg *) {
            font-family: var(--pt-readable-thai-font) !important;
            font-stretch: normal !important;
            letter-spacing: 0 !important;
            text-shadow: none !important;
        }
        body :is(h1, h2, h3, h4, h5, h6, th, label, strong, b, .report-btn, .btn, .badge, .status-text, .cell-title, .project-group-name, [class*="title"], [class*="heading"], [class*="eyebrow"], [class*="status"], [class*="badge"], [class*="count"], [class*="total"], [class*="value"]) {
            font-weight: 700 !important;
        }
        body :is(p, li, td, small, em, time, .cell-sub, .detail-block div, .meta-label, .meta-value, .empty, [class*="detail"], [class*="meta"], [class*="subtitle"], [class*="description"], [class*="desc"], [class*="remark"], [class*="note"], [class*="empty"]):not(.btn):not(.badge):not(.status-text):not([class*="status-"]):not([class*="Status"]) {
            font-weight: 400 !important;
        }
</style>
</head>
<body>
    <div class="report-actions">
        <button type="button" class="report-btn primary" onclick="window.print()">Print</button>
        <a asp-controller="Reports" asp-action="Index" class="report-btn">Report Center</a>
        <a asp-controller="Home" asp-action="Index" class="report-btn">Dashboard</a>
    </div>

    <header class="print-header">
        <h1>Attendance Check-in/Check-out Report</h1>
        <div>
            ช่วงวันที่ @fromDateText - @toDateText<br />
            ข้อมูล ณ @DateTime.Now.ToString("dd MMM yyyy HH:mm", th)
        </div>
    </header>

    <form method="get" class="filter-panel">
        <div class="field">
            <label for="fromDate">จากวันที่</label>
            <input type="text" id="fromDate" name="fromDate" value="@fromDateText" placeholder="dd/MM/2569" />
        </div>
        <div class="field">
            <label for="toDate">ถึงวันที่</label>
            <input type="text" id="toDate" name="toDate" value="@toDateText" placeholder="dd/MM/2569" />
        </div>
        <button type="submit" class="report-btn primary filter-submit">ค้นหา</button>
    </form>

    <section class="kpi-grid">
        <article class="kpi info">
            <span>Rows</span>
            <strong>@rows.Count</strong>
            <small>รายการตามช่วงวันที่</small>
        </article>
        <article class="kpi">
            <span>Checked In</span>
            <strong>@checkedInCount</strong>
            <small>เช็คเข้าแล้ว</small>
        </article>
        <article class="kpi">
            <span>Checked Out</span>
            <strong>@checkedOutCount</strong>
            <small>เช็คออกแล้ว</small>
        </article>
        <article class="kpi danger">
            <span>No Check-in</span>
            <strong>@noCheckin.Count</strong>
            <small>ยังไม่เช็คเข้า</small>
        </article>
        <article class="kpi warning">
            <span>No Check-out</span>
            <strong>@noCheckout.Count</strong>
            <small>เช็คเข้าแล้วแต่ยังไม่เช็คออก</small>
        </article>
    </section>

    <h2>รายการที่ต้องตรวจสอบ</h2>
    @if (!attendanceIssues.Any())
    {
        <div class="empty">ทุกคนเช็คเข้า-ออกครบตามช่วงวันที่เลือก</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th style="width:42px;">Seq</th>
                    <th style="width:120px;">Status</th>
                    <th style="width:110px;">Date</th>
                    <th>Employee</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var issueSeq = 1;
                }
                @foreach (var item in attendanceIssues)
                {
                    <tr>
                        <td class="text-center">@issueSeq</td>
                        <td class="text-center">
                            <span class="status-text @(item.Tone == "danger" ? "danger" : "warning")">@item.Status</span>
                        </td>
                        <td class="text-center">@item.WorkDate.ToString("dd/MM/yyyy", th)</td>
                        <td>@item.EmpName</td>
                        <td>@item.Position</td>
                    </tr>
                    issueSeq++;
                }
            </tbody>
        </table>
    }

    <h2>ตารางเข้า-ออกงาน</h2>
    <table>
        <thead>
            <tr>
                <th style="width:42px;">Seq</th>
                <th style="width:110px;">Date</th>
                <th>Employee</th>
                <th>Position</th>
                <th style="width:86px;">Check-in</th>
                <th style="width:86px;">Check-out</th>
                <th style="width:90px;">Distance</th>
                <th class="no-print" style="width:90px;">Map</th>
            </tr>
        </thead>
        <tbody>
            @{
                var rowSeq = 1;
            }
            @foreach (var item in rows)
            {
                DateTime workDate = item.WorkDate;
                var hasCheckinLocation = item.CheckinLat != null && item.CheckinLng != null;
                <tr>
                    <td class="text-center">@rowSeq</td>
                    <td class="text-center">@workDate.ToString("dd/MM/yyyy", th)</td>
                    <td>@item.EmpName</td>
                    <td>@item.Position</td>
                    <td class="text-center">
                        @if (item.CheckinTime != null)
                        {
                            <span class="status-text success">@item.CheckinTime?.ToString("HH:mm")</span>
                        }
                        else
                        {
                            <span class="status-text danger">ไม่เช็คเข้า</span>
                        }
                    </td>
                    <td class="text-center">
                        @if (item.CheckoutTime != null)
                        {
                            <span class="status-text success">@item.CheckoutTime?.ToString("HH:mm")</span>
                        }
                        else
                        {
                            <span class="status-text warning">ไม่เช็คออก</span>
                        }
                    </td>
                    <td class="text-center">@(item.DistanceKm != null ? string.Format("{0:0.00}", item.DistanceKm) : "-")</td>
                    <td class="text-center no-print">
                        @if (hasCheckinLocation)
                        {
                            <button type="button"
                                    class="map-link"
                                    onclick="openGoogleMap('@item.CheckinLat','@item.CheckinLng','@item.CheckoutLat','@item.CheckoutLng')">
                                ดูแผนที่
                            </button>
                        }
                        else
                        {
                            <span class="muted">-</span>
                        }
                    </td>
                </tr>
                rowSeq++;
            }
        </tbody>
    </table>

    <script>
        function openGoogleMap(inLat, inLng, outLat, outLng) {
            if (!inLat || !inLng) {
                alert('ไม่พบพิกัด Check-in');
                return;
            }

            if (outLat && outLng) {
                const url = `https://www.google.com/maps/dir/?api=1&origin=${inLat},${inLng}&destination=${outLat},${outLng}`;
                window.open(url, '_blank');
                return;
            }

            const url = `https://www.google.com/maps?q=${inLat},${inLng}`;
            window.open(url, '_blank');
        }
    </script>
</body>
</html>

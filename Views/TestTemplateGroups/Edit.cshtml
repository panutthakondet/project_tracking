@model ProjectTracking.Models.TestTemplateGroup

@{
    ViewData["Title"] = "แก้ไขกลุ่มแม่แบบ";
    var controls = ViewBag.Controls as IEnumerable<ProjectTracking.Models.TestTemplateGroupControl> ?? Enumerable.Empty<ProjectTracking.Models.TestTemplateGroupControl>();
}

<div class="container mt-3">
    <h3>แก้ไขกลุ่มแม่แบบ</h3>
    <hr />

    <form asp-action="Edit" asp-route-id="@Model.group_id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="group_id" />
        <input type="hidden" asp-for="is_active" />

        <div class="mb-3">
            <label class="form-label">Template Groups Control</label>
            <select asp-for="control_id" class="form-select">
                <option value="">-- ยังไม่กำหนด Control --</option>
                @foreach (var control in controls)
                {
                    <option value="@control.control_id">@(control.Department?.DepartmentName ?? "ยังไม่กำหนดฝ่าย") / @control.control_name</option>
                }
            </select>
            <span asp-validation-for="control_id" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="group_name" class="form-label"></label>
            <input asp-for="group_name" class="form-control" />
            <span asp-validation-for="group_name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Sort Order</label>
            <input asp-for="sort_order" class="form-control" type="number" />
        </div>

        <div class="pt-form-actions">
            <button type="submit" class="btn btn-primary">
                Save
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Back
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

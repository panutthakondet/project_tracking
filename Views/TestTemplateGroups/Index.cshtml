@model IEnumerable<ProjectTracking.Models.TestTemplateGroup>

@using Microsoft.AspNetCore.Http

@{
    var controls = ViewBag.Controls as IEnumerable<ProjectTracking.Models.TestTemplateGroupControl> ?? Enumerable.Empty<ProjectTracking.Models.TestTemplateGroupControl>();
    int? selectedControl = ViewBag.SelectedControl as int?;
    var groupedRows = (Model ?? Enumerable.Empty<ProjectTracking.Models.TestTemplateGroup>())
        .GroupBy(g => new
        {
            ControlId = g.control_id,
            ControlName = g.Control?.control_name ?? "ยังไม่กำหนด Control",
            ControlSort = g.Control?.sort_order ?? int.MaxValue
        })
        .OrderBy(g => g.Key.ControlSort)
        .ThenBy(g => g.Key.ControlName);
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

<style>
    .group-table thead th {
        background-color: #6f42c1 !important; /* purple */
        color: #ffffff;
        text-align: center;
        vertical-align: middle;
    }

    .text-center-col {
        text-align: center;
        vertical-align: middle;
    }

    .group-card-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 14px;
    }

    .template-control-sections {
        display: grid;
        gap: 18px;
    }

    .template-control-section {
        overflow: hidden;
        background: #f8fbff;
        border: 1px solid #cbddeb;
        border-radius: 10px;
    }

    .template-control-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 16px;
        background: #eef7ff;
        border-bottom: 1px solid #cbddeb;
    }

    .template-control-eyebrow {
        margin: 0 0 2px;
        color: #64748b;
        font-size: .78rem;
        font-weight: 400;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .template-control-title {
        margin: 0;
        color: #10233f;
        font-size: 1.05rem;
        font-weight: 500;
        line-height: 1.35;
    }

    .template-control-count {
        flex: 0 0 auto;
        color: #0f766e;
        font-size: .9rem;
        font-weight: 500;
    }

    .group-card {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) auto auto;
        align-items: center;
        gap: 16px;
        background: #fff;
        border: 2px solid #22c55e;
        border-radius: 14px !important;
        padding: 14px 16px;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    }

    .group-card.is-inactive { border-color: #ef4444; }

    .group-card-head {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .group-drag {
        flex: 0 0 auto;
        width: 34px;
        height: 34px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #062b2f;
        background: rgba(20, 184, 166, .18);
        cursor: grab;
        font-weight: 400 !important;
    }

    .group-card-title {
        color: #10233f;
        font-size: 1rem;
        font-weight: 300 !important;
        line-height: 1.35;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .group-card-subtitle {
        color: #64748b;
        font-size: .95rem;
        font-weight: 300 !important;
        line-height: 1.3;
    }

    .group-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
    }

    .group-pill {
        color: #334155;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: .84rem;
        font-weight: 400 !important;
    }

    main.route-controller-testtemplategroups .group-card .group-card-title,
    main.route-controller-testtemplategroups .group-card .group-card-subtitle,
    main.route-controller-testtemplategroups .group-card .group-pill,
    main.route-controller-testtemplategroups .group-card .group-drag {
        font-synthesis-weight: none;
    }

    main.route-controller-testtemplategroups .group-card .group-card-title {
        font-weight: 300 !important;
    }

    main.route-controller-testtemplategroups .group-card .group-card-subtitle {
        font-weight: 300 !important;
    }

    .group-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
        min-width: 180px;
    }

    @@media (max-width: 900px) {
        .group-card {
            grid-template-columns: 1fr;
            align-items: stretch;
            gap: 12px;
        }

        .group-card-meta,
        .group-actions {
            justify-content: flex-start;
            min-width: 0;
        }
    }
</style>

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">Template Groups</h2>
        <p class="index-subtitle">จัดกลุ่ม Template และลำดับการแสดงผล</p>
    </div>

    <div class="index-actions">
        <a asp-controller="TestTemplateGroupControls" asp-action="Index" class="btn btn-outline-primary">Manage Controls</a>
        @if (CanMenu("TestTemplateGroups.Create"))
        {
            <a asp-action="Create" asp-route-controlId="@selectedControl" class="btn btn-success" title="เพิ่มกลุ่ม Template">
                Add Group
            </a>
        }
        else
        {
            <button class="btn btn-success" disabled title="ไม่มีสิทธิ์เพิ่มกลุ่ม">
                Add Group
            </button>
        }
    </div>
</div>

<form asp-action="Index" method="get" class="card card-body mb-3">
    <label class="form-label">Template Groups Control</label>
    <div class="d-flex gap-2">
        <select name="controlId" class="form-select" onchange="this.form.submit()">
            <option value="">ทั้งหมด</option>
            @foreach (var control in controls)
            {
                <option value="@control.control_id" selected="@(selectedControl == control.control_id)">@control.control_name</option>
            }
        </select>
        @if (selectedControl.HasValue)
        {
            <a asp-action="Index" asp-route-clearControl="true" class="btn btn-outline-secondary">ล้าง</a>
        }
    </div>
</form>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning">ไม่พบ Template Group</div>
    return;
}

<div class="template-control-sections">
    @foreach (var controlGroup in groupedRows)
    {
        <section class="template-control-section">
            <header class="template-control-header">
                <div>
                    <p class="template-control-eyebrow">Template Groups Control</p>
                    <h3 class="template-control-title">@controlGroup.Key.ControlName</h3>
                </div>
                <span class="template-control-count">@controlGroup.Count() Group</span>
            </header>

            <div class="group-card-list" data-control-id="@(controlGroup.Key.ControlId?.ToString() ?? "unassigned")">
                @foreach (var g in controlGroup.OrderBy(x => x.sort_order).ThenBy(x => x.group_name))
                {
                    <article class="group-card @(g.is_active ? "is-active" : "is-inactive")" data-id="@g.group_id">
                        <div class="group-card-head">
                            @if (CanMenu("TestTemplateGroups.Sort"))
                            {
                                <span class="group-drag" title="ลากเพื่อสลับลำดับ">☰</span>
                            }
                            <div>
                                <div class="group-card-title">@g.group_name</div>
                                <div class="group-card-subtitle">ลำดับภายใน Control: @g.sort_order</div>
                            </div>
                        </div>

                        <div class="group-card-meta">
                            <span class="group-pill">Order: @g.sort_order</span>
                            <span class="group-pill">Created: @g.created_at.ToString("dd/MM/yyyy")</span>
                        </div>

                        <div class="group-actions">
                            @if (CanMenu("TestTemplateGroups.Edit"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@g.group_id"
                                   class="btn btn-sm btn-outline-primary"
                                   title="แก้ไขกลุ่ม">
                                    Edit
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                    Edit
                                </button>
                            }

                            @if (CanMenu("TestTemplateGroups.Delete"))
                            {
                                <form asp-action="Delete"
                                      asp-route-id="@g.group_id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this group?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="ลบกลุ่ม">
                                        Delete
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                    Delete
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

<script>
    if (@CanMenu("TestTemplateGroups.Sort").ToString().ToLower()) {
        document.querySelectorAll(".group-card-list").forEach(function (groupList) {
            new Sortable(groupList, {
                handle: ".group-drag",
                animation: 150,
                onEnd: function () {
                    var order = [];
                    groupList.querySelectorAll(".group-card").forEach((row, index) => {
                        order.push({
                            id: row.getAttribute("data-id"),
                            sort: index + 1
                        });
                    });

                    fetch('/TestTemplateGroups/UpdateSort', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(order)
                    });
                }
            });
        });
    }
</script>

    var libraryImagePalette = unsplashPhotoUrls
        .Select((url, index) =>
        {
            var categoryKeywords = index switch
            {
                < 18 => "nature landscape mountain hill snow forest lake sky outdoor ภูเขา ธรรมชาติ ป่า ท้องฟ้า หิมะ",
                < 32 => "city skyline urban building architecture street night เมือง ตึก อาคาร สถาปัตย์ กลางคืน",
                < 46 => "mountain snow peak valley landscape trail cloud ภูเขา หิมะ ยอดเขา เมฆ ธรรมชาติ",
                < 61 => "ocean sea beach water coast wave island blue ทะเล น้ำ ชายหาด คลื่น เกาะ สีฟ้า",
                < 77 => "forest green tree woods plant garden leaves ป่า ต้นไม้ เขียว ใบไม้ สวน",
                < 92 => "office workspace desk meeting business laptop team home house room interior work from home งาน ออฟฟิศ โต๊ะ ประชุม ธุรกิจ บ้าน ห้อง โฮมออฟฟิศ ทำงานที่บ้าน",
                _ => "technology digital abstract computer code network data home screen wallpaper เทคโนโลยี ดิจิทัล คอมพิวเตอร์ โค้ด พื้นหลัง"
            };

            return (
                Path: $"{url}?auto=format&fit=crop&w=960&h=540&q=80",
                Name: $"Unsplash {index + 1}",
                Keywords: $"{categoryKeywords} unsplash {index + 1}"
            );
        })
        .ToArray();
    var initialCoverChoiceCount = 6;

    string CoverBackground(string? value)
    {
        var clean = (value ?? "").Trim().ToLowerInvariant();
        var gradient = gradientPalette.FirstOrDefault(x => string.Equals(x.Value, clean, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(gradient.Css)) return gradient.Css;

        if (clean.StartsWith("#", StringComparison.Ordinal) && clean.Length == 7)
            return $"linear-gradient(135deg, color-mix(in srgb, {clean} 72%, white), {clean})";

        return gradientPalette[0].Css;
    }

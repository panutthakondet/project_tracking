                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const createLabelUrl = '@Url.Action("CreateLabel", "RequirementBoard")';
            const updateCardLabelsUrl = '@Url.Action("UpdateCardLabels", "RequirementBoard")';
            const boardLabels = @Html.Raw(labelOptionsJson);
            const searchInput = document.getElementById('requirementBoardSearch');
            const searchBox = searchInput?.closest('.rb-search');
            const clearSearchButton = searchBox?.querySelector('.rb-search-clear');
            let draggedCard = null;
            let draggedColumn = null;
            let dragImage = null;
            let originalList = null;
            let originalNextCard = null;
            let originalNextColumn = null;
            let didColumnDrop = false;
            let didDrop = false;
            let wasDragging = false;
            let suppressClickUntil = 0;

            function normalizeText(value) {
                return (value || '').toString().trim().toLowerCase();
            }

            function updateColumnCounts() {
                document.querySelectorAll('.rb-column').forEach(column => {
                    const visibleCount = [...column.querySelectorAll('.rb-card')]
                        .filter(card => card.style.display !== 'none')
                        .length;
                    const count = column.querySelector('.rb-column-count');
                    if (count) count.textContent = visibleCount;
                });
            }

            function filterCards() {
                const keyword = normalizeText(searchInput?.value);
                searchBox?.classList.toggle('has-value', Boolean(keyword));

                document.querySelectorAll('.rb-card').forEach(card => {
                    const text = normalizeText(card.dataset.searchText);
                    card.style.display = !keyword || text.includes(keyword) ? '' : 'none';
                });

                updateColumnCounts();
            }

            searchInput?.addEventListener('input', filterCards);
            clearSearchButton?.addEventListener('click', () => {
                if (!searchInput) return;
                searchInput.value = '';
                searchInput.focus();
                filterCards();
            });

            function setSaveStatus(status, message, type) {
                if (!status) return;

                status.textContent = message;
                status.classList.remove('is-success', 'is-error', 'is-visible');
                status.classList.add(type === 'error' ? 'is-error' : 'is-success', 'is-visible');

                window.clearTimeout(status.dataset.hideTimer);
                status.dataset.hideTimer = window.setTimeout(() => {
                    status.classList.remove('is-visible');
                }, 3600);
            }

            function normalizeHex(value) {
                const color = (value || '#22c7b8').toString().trim();
                return color.startsWith('#') ? color : `#${color}`;
            }

            function normalizeLabel(label) {
                return {
                    labelId: label?.labelId ?? label?.LabelId,
                    labelName: label?.labelName ?? label?.LabelName ?? '',
                    colorHex: label?.colorHex ?? label?.ColorHex ?? '#22c7b8'
                };
            }

            function labelTextColor(hex) {
                const color = normalizeHex(hex).replace('#', '');
                if (color.length !== 6) return '#10213a';

                const r = parseInt(color.slice(0, 2), 16);
                const g = parseInt(color.slice(2, 4), 16);
                const b = parseInt(color.slice(4, 6), 16);
                const brightness = (r * 299 + g * 587 + b * 114) / 1000;
                return brightness < 132 ? '#fff' : '#10213a';
            }

            function findLabel(labelId) {
                return boardLabels.find(label => Number(normalizeLabel(label).labelId) === Number(labelId));
            }

            function createLabelChip(label, compact = false) {
                const chip = document.createElement('span');
                chip.className = 'rb-card-label';
                chip.style.setProperty('--rb-label-color', normalizeHex(label.colorHex));
                chip.style.setProperty('--rb-label-text', labelTextColor(label.colorHex));
                chip.title = label.labelName;
                chip.textContent = compact ? '' : label.labelName;
                return chip;
            }

            function renderLabelCollection(container, labels, compact = false, showEmpty = true) {
                if (!container) return;
                container.replaceChildren();

                if (!labels || labels.length === 0) {
                    if (!compact && showEmpty) {
                        const empty = document.createElement('span');
                        empty.className = 'rb-label-empty';
                        empty.textContent = 'ยังไม่มีป้าย';
                        container.appendChild(empty);
                    }
                    return;
                }

                labels.forEach(label => container.appendChild(createLabelChip(label, compact)));
            }

            function selectedLabelsFor(control) {
                return [...control.querySelectorAll('[data-label-checkbox]:checked')]
                    .map(input => findLabel(input.value))
                    .filter(Boolean);
            }

            function syncLabelControl(control) {
                if (!control) return;

                const labels = selectedLabelsFor(control);
                renderLabelCollection(control.querySelector('[data-selected-labels]'), labels);

                const hiddenBox = control.querySelector('[data-label-hidden]');
                if (hiddenBox) {
                    hiddenBox.replaceChildren();
                    labels.forEach(label => {
                        const hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = 'labelIds';
                        hidden.value = label.labelId;
                        hiddenBox.appendChild(hidden);
                    });
                }
            }

            function sanitizeDescriptionHtml(value) {
                const text = (value || '').trim();
                if (!text) {
                    return '';
                }

                const looksLikeHtml = /<\/?[a-z][\s\S]*>/i.test(text);
                if (!looksLikeHtml) {
                    return text
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#39;')
                        .replace(/\r?\n/g, '<br>');
                }

                const template = document.createElement('template');
                template.innerHTML = text;
                const allowedTags = new Set(['A', 'B', 'BR', 'DIV', 'EM', 'FONT', 'H3', 'I', 'LI', 'OL', 'P', 'SPAN', 'STRONG', 'U', 'UL']);

                template.content.querySelectorAll('*').forEach(node => {
                    if (!allowedTags.has(node.tagName)) {
                        node.replaceWith(document.createTextNode(node.textContent || ''));
                        return;
                    }

                    [...node.attributes].forEach(attribute => {
                        const name = attribute.name.toLowerCase();
                        if (node.tagName === 'A' && name === 'href') {
                            const href = attribute.value.trim();
                            if (/^(https?:|mailto:|tel:|\/)/i.test(href)) {
                                node.setAttribute('target', '_blank');
                                node.setAttribute('rel', 'noopener noreferrer');
                                return;
                            }
                        }

                        if (node.tagName === 'FONT' && ['face', 'size'].includes(name)) {
                            if (name === 'face' && /^(Prompt|Sarabun|Tahoma|Arial)$/i.test(attribute.value.trim())) return;
                            if (name === 'size' && /^[2-5]$/.test(attribute.value.trim())) return;
                        }

                        if (!['target', 'rel'].includes(name)) {
                            node.removeAttribute(attribute.name);
                        }
                    });
                });

                return template.innerHTML;
            }

            function renderDescriptionPreview(value) {
                const html = sanitizeDescriptionHtml(value);
                return html || '<span class="rb-description-placeholder">เพิ่มคำอธิบายของการ์ด...</span>';
            }

            function openDescriptionEditor(control) {
                if (!control) return;

                const editor = control.querySelector('[data-description-editor]');
                const preview = control.querySelector('[data-description-preview]');
                const rich = editor?.querySelector('[data-description-rich]');
                if (!editor) return;

                if (preview) preview.hidden = true;
                editor.hidden = false;
                rich?.focus();
            }

            function closeDescriptionEditor(control) {
                if (!control) return;

                const editor = control.querySelector('[data-description-editor]');
                const preview = control.querySelector('[data-description-preview]');

                if (editor) editor.hidden = true;
                if (preview) preview.hidden = false;
            }

            function descriptionPlainText(html) {
                const container = document.createElement('div');
                container.innerHTML = sanitizeDescriptionHtml(html);
                return (container.textContent || '').trim();
            }

            function escapeHtmlAttribute(value) {
                return (value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }

            function syncDescriptionFromRich(control) {
                const rich = control?.querySelector('[data-description-rich]');
                const hidden = control?.querySelector('textarea[name="detail"]');
                if (!rich || !hidden) return;

                const html = sanitizeDescriptionHtml(rich.innerHTML);
                hidden.value = descriptionPlainText(html) ? html : '';
                syncDescriptionPreview(control, hidden.value);
            }

            function syncDescriptionEditors(root = document) {
                root.querySelectorAll('[data-description-control]').forEach(syncDescriptionFromRich);
            }

            function initDescriptionEditors(root = document) {
                root.querySelectorAll('[data-description-control]').forEach(control => {
                    const hidden = control.querySelector('textarea[name="detail"]');
                    const rich = control.querySelector('[data-description-rich]');
                    if (!hidden || !rich || rich.dataset.descriptionReady === '1') return;

                    rich.innerHTML = sanitizeDescriptionHtml(hidden.value);
                    rich.dataset.descriptionReady = '1';
                    syncDescriptionPreview(control, hidden.value);
                });
            }

            function runDescriptionCommand(button) {
                const editor = button.closest('[data-description-editor]');
                const rich = editor?.querySelector('[data-description-rich]');
                const command = button.dataset.descriptionCommand;
                if (!rich || !command) return;

                rich.focus();

                if (command === 'bold') {
                    document.execCommand('bold', false);
                    syncDescriptionFromRich(editor.closest('[data-description-control]'));
                    return;
                }

                if (command === 'italic') {
                    document.execCommand('italic', false);
                    syncDescriptionFromRich(editor.closest('[data-description-control]'));
                    return;
                }

                if (command === 'underline') {
                    document.execCommand('underline', false);
                    syncDescriptionFromRich(editor.closest('[data-description-control]'));
                    return;
                }

                if (command === 'bullet') {
                    document.execCommand('insertUnorderedList', false);
                    syncDescriptionFromRich(editor.closest('[data-description-control]'));
                    return;
                }

                if (command === 'link') {
                    const selection = window.getSelection();
                    const selected = selection?.toString() || '';
                    const url = window.prompt('ใส่ URL');
                    if (!url) {
                        rich.focus();
                        return;
                    }

                    if (!selected) {
                        document.execCommand(
                            'insertHTML',
                            false,
                            `<a href="${escapeHtmlAttribute(url)}" target="_blank" rel="noopener noreferrer">ข้อความลิงก์</a>`
                        );
                        syncDescriptionFromRich(editor.closest('[data-description-control]'));
                        return;
                    }

                    document.execCommand('createLink', false, url);
                    rich.querySelectorAll('a').forEach(link => {
                        link.target = '_blank';
                        link.rel = 'noopener noreferrer';
                    });
                    syncDescriptionFromRich(editor.closest('[data-description-control]'));
                    return;
                }
            }

            function syncDescriptionPreview(control, value) {
                const preview = control?.querySelector('[data-description-preview]');
                if (!preview) return;

                preview.innerHTML = renderDescriptionPreview(value);
            }

            async function saveCardLabels(control) {
                if (!control) return;

                const form = control.closest('[data-card-update-form]');
                const cardId = form?.dataset.cardId || form?.querySelector('[name="cardId"]')?.value;
                if (!cardId) return;

                const labels = selectedLabelsFor(control);
                const body = new FormData();
                body.append('__RequestVerificationToken', token);
                body.append('cardId', cardId);
                labels.forEach(label => body.append('labelIds', label.labelId));

                const triggerButton = control.querySelector('[data-open-label-picker]');
                triggerButton?.classList.add('is-saving');

                try {
                    const response = await fetch(updateCardLabelsUrl, {
                        method: 'POST',
                        body,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const result = await response.json();
                    if (!response.ok || !result.success) {
                        throw new Error(result.message || 'บันทึกป้ายไม่สำเร็จ');
                    }

                    const savedLabels = Array.isArray(result.labels)
                        ? result.labels.map(normalizeLabel)
                        : labels.map(normalizeLabel);
                    const card = document.querySelector(`.rb-card[data-card-id="${cardId}"]`);
                    if (card) {
                        const title = card.querySelector('[data-card-title]')?.textContent || '';
                        const detail = form.querySelector('[name="detail"]')?.value || '';
                        card.dataset.searchText = `${title} ${detail} ${savedLabels.map(label => label.labelName).join(' ')}`;
                        renderLabelCollection(card.querySelector('[data-card-labels]'), savedLabels, false, false);
                    }
                } catch (error) {
                    window.alert(error.message || 'บันทึกป้ายไม่สำเร็จ');
                } finally {
                    triggerButton?.classList.remove('is-saving');
                }
            }

            function createLabelOption(label, checked = false) {
                const option = document.createElement('label');
                option.className = 'rb-label-option';
                option.dataset.labelOption = '';
                option.dataset.labelText = label.labelName;

                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.value = label.labelId;
                checkbox.dataset.labelCheckbox = '';
                checkbox.checked = checked;

                const text = document.createElement('span');
                text.className = 'rb-label-option-text';
                text.style.setProperty('--rb-label-color', normalizeHex(label.colorHex));
                text.style.setProperty('--rb-label-text', labelTextColor(label.colorHex));
                text.textContent = label.labelName;

                option.append(checkbox, text);
                return option;
            }

            function appendLabelToAllPickers(label, selectedControl = null) {
                document.querySelectorAll('[data-label-list]').forEach(list => {
                    const control = list.closest('[data-label-control]');
                    const option = createLabelOption(label, control === selectedControl);
                    list.appendChild(option);
                    if (control === selectedControl) syncLabelControl(control);
                });
            }

            document.querySelectorAll('[data-label-control]').forEach(syncLabelControl);
            initDescriptionEditors();

            document.querySelectorAll('.rb-modal').forEach(modal => {
                modal.addEventListener('hidden.bs.modal', () => {
                    const descriptionControl = modal.querySelector('[data-description-control]');
                    syncDescriptionFromRich(descriptionControl);
                    const textarea = descriptionControl?.querySelector('textarea[name="detail"]');

                    syncDescriptionPreview(descriptionControl, textarea?.value || '');
                    closeDescriptionEditor(descriptionControl);
                });
            });

            document.addEventListener('mousedown', event => {
                const descriptionCommand = event.target.closest('[data-description-command]');
                if (descriptionCommand) {
                    event.preventDefault();
                }
            });

            document.addEventListener('click', async event => {
                const descriptionCommand = event.target.closest('[data-description-command]');
                if (descriptionCommand) {
                    runDescriptionCommand(descriptionCommand);
                    return;
                }

                const descriptionTrigger = event.target.closest('[data-description-toggle]');
                if (descriptionTrigger) {
                    openDescriptionEditor(descriptionTrigger.closest('[data-description-control]'));
                    return;
                }

                const openButton = event.target.closest('[data-open-label-picker]');
                if (openButton) {
                    const control = openButton.closest('[data-label-control]');
                    const picker = control?.querySelector('[data-label-picker]');
                    if (!picker) return;

                    document.querySelectorAll('[data-label-picker]').forEach(item => {
                        if (item !== picker) item.hidden = true;
                    });
                    picker.hidden = !picker.hidden;
                    picker.querySelector('[data-label-search]')?.focus();
                    return;
                }

                const closeButton = event.target.closest('[data-close-label-picker]');
                if (closeButton) {
                    const picker = closeButton.closest('[data-label-picker]');
                    if (picker) picker.hidden = true;
                    return;
                }

                const colorButton = event.target.closest('[data-label-color]');
                if (colorButton) {
                    const form = colorButton.closest('[data-label-create-form]');
                    form?.querySelectorAll('[data-label-color]').forEach(button => button.classList.remove('is-selected'));
                    colorButton.classList.add('is-selected');
                    const input = form?.querySelector('[data-label-color-value]');
                    if (input) input.value = colorButton.dataset.labelColor || '#22c7b8';
                    return;
                }

                const createButton = event.target.closest('[data-create-label]');
                if (!createButton) return;

                const control = createButton.closest('[data-label-control]');
                const form = createButton.closest('[data-label-create-form]');
                const nameInput = form?.querySelector('[data-label-name]');
                const colorInput = form?.querySelector('[data-label-color-value]');
                const labelName = (nameInput?.value || '').trim();
                if (!labelName) {
                    nameInput?.focus();
                    return;
                }

                createButton.disabled = true;
                createButton.classList.add('is-loading');

                try {
                    const body = new FormData();
                    body.append('__RequestVerificationToken', token);
                    body.append('labelName', labelName);
                    body.append('colorHex', colorInput?.value || '#22c7b8');

                    const response = await fetch(createLabelUrl, {
                        method: 'POST',
                        body,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const result = await response.json();
                    if (!response.ok || !result.success || !result.label) {
                        throw new Error(result.message || 'สร้างป้ายไม่สำเร็จ');
                    }

                    const createdLabel = normalizeLabel(result.label);
                    boardLabels.push(createdLabel);
                    appendLabelToAllPickers(createdLabel, control);
                    await saveCardLabels(control);
                    if (nameInput) nameInput.value = '';
                } catch (error) {
                    window.alert(error.message || 'สร้างป้ายไม่สำเร็จ');
                } finally {
                    createButton.disabled = false;
                    createButton.classList.remove('is-loading');
                }
            });

            document.addEventListener('keydown', event => {
                const descriptionPreview = event.target.closest('[data-description-preview]');
                if (!descriptionPreview || (event.key !== 'Enter' && event.key !== ' ')) return;

                event.preventDefault();
                openDescriptionEditor(descriptionPreview.closest('[data-description-control]'));
            });

            document.addEventListener('input', event => {
                const richDescription = event.target.closest('[data-description-rich]');
                if (richDescription) {
                    syncDescriptionFromRich(richDescription.closest('[data-description-control]'));
                    return;
                }

                const search = event.target.closest('[data-label-search]');
                if (!search) return;

                const keyword = normalizeText(search.value);
                const picker = search.closest('[data-label-picker]');
                picker?.querySelectorAll('[data-label-option]').forEach(option => {
                    const text = normalizeText(option.dataset.labelText);
                    option.style.display = !keyword || text.includes(keyword) ? '' : 'none';
                });
            });

            document.addEventListener('change', async event => {
                const checkbox = event.target.closest('[data-label-checkbox]');
                if (!checkbox) return;

                const control = checkbox.closest('[data-label-control]');
                syncLabelControl(control);
                await saveCardLabels(control);
            });

            function updateBoardCard(data, form) {
                const cardId = data.cardId || form.dataset.cardId;
                const card = document.querySelector(`.rb-card[data-card-id="${cardId}"]`);
                const title = data.title || form.querySelector('[name="title"]')?.value || '';
                const detail = data.detail || form.querySelector('[name="detail"]')?.value || '';
                const labels = Array.isArray(data.labels)
                    ? data.labels.map(normalizeLabel)
                    : selectedLabelsFor(form).map(normalizeLabel);

                if (card) {
                    const titleNode = card.querySelector('[data-card-title]');
                    if (titleNode) titleNode.textContent = title;

                    card.dataset.searchText = `${title} ${detail} ${labels.map(label => label.labelName).join(' ')}`;
                    renderLabelCollection(card.querySelector('[data-card-labels]'), labels, false, false);

                    if (data.coverImagePath) {
                        let cover = card.querySelector('.rb-card-cover');
                        if (!cover) {
                            cover = document.createElement('img');
                            cover.className = 'rb-card-cover';
                            card.insertBefore(cover, card.firstElementChild);
                        }
                        cover.src = data.coverImagePath;
                        cover.alt = title;
                    }
                }

                const modal = form.closest('.rb-modal');
                if (!modal) return;

                const descriptionControl = modal.querySelector('[data-description-control]');
                syncDescriptionPreview(descriptionControl, detail);
                closeDescriptionEditor(descriptionControl);

                const modalMeta = modal.querySelector('[data-card-modal-meta]');
                if (modalMeta && data.updatedAt) {
                    modalMeta.textContent = modalMeta.textContent.replace(/อัปเดต .*/, `อัปเดต ${data.updatedAt}`);
                }

                const modalHeader = modal.querySelector('.modal-header');
                if (modalHeader && data.coverImagePath) {
                    modalHeader.classList.add('has-cover');
                    modalHeader.style.backgroundImage = `url('${data.coverImagePath}')`;
                }

                const attachmentHeading = modal.querySelector('[data-attachment-heading]');
                if (attachmentHeading && Number.isFinite(Number(data.attachmentCount))) {
                    attachmentHeading.dataset.attachmentCount = data.attachmentCount;
                    attachmentHeading.textContent = `ไฟล์แนบ (${data.attachmentCount})`;
                }
            }

            document.addEventListener('submit', async event => {
                const form = event.target.closest('[data-card-update-form]');
                if (!form) return;

                event.preventDefault();
                if (!window.confirm('ต้องการบันทึกการ์ดนี้หรือไม่?')) return;
                syncDescriptionEditors(form);

                const submitButton = form.querySelector('button[type="submit"]');
                const status = form.querySelector('[data-card-save-status]');

                submitButton?.classList.add('is-loading');
                if (submitButton) submitButton.disabled = true;
                setSaveStatus(status, 'กำลังบันทึก...', 'success');

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const contentType = response.headers.get('content-type') || '';
                    const result = contentType.includes('application/json')
                        ? await response.json()
                        : { success: false, message: 'บันทึกไม่สำเร็จ กรุณาลองใหม่อีกครั้ง' };

                    if (!response.ok || !result.success) {
                        throw new Error(result.message || 'บันทึกไม่สำเร็จ');
                    }

                    updateBoardCard(result, form);
                    form.querySelectorAll('input[type="file"]').forEach(input => {
                        input.value = '';
                    });
                    setSaveStatus(status, result.message || 'บันทึกแล้ว', 'success');
                } catch (error) {
                    setSaveStatus(status, error.message || 'บันทึกไม่สำเร็จ', 'error');
                } finally {
                    submitButton?.classList.remove('is-loading');
                    if (submitButton) submitButton.disabled = false;
                }
            });

            function reindexPhaseRows(list) {
                if (!list) return;

                list.querySelectorAll('[data-phase-row]').forEach((row, index) => {
                    row.querySelectorAll('[data-phase-field]').forEach(field => {
                        const fieldName = field.dataset.phaseField;
                        if (!fieldName) return;
                        field.name = `phaseItems[${index}].${fieldName}`;
                    });
                });
            }

            function resetPhaseRow(row, sourceList) {
                if (!row) return;

                const rows = sourceList
                    ? Array.from(sourceList.querySelectorAll('[data-phase-row]'))
                    : [];
                const lastRow = rows[rows.length - 1];
                const lastPhaseOrder = sourceList ? Number(lastRow?.querySelector('[data-phase-field="PhaseOrder"]')?.value || 1) : 1;
                const lastPeriodOrder = sourceList ? Number(lastRow?.querySelector('[data-phase-field="PeriodOrder"]')?.value || 0) : 0;

                row.querySelectorAll('input, select, textarea').forEach(field => {
                    const fieldName = field.dataset.phaseField;

                    if (fieldName === 'ItemId' || fieldName === 'PhaseName' || field.matches('[data-rb-date], [data-rb-native-date]')) {
                        field.value = '';
                        return;
                    }

                    if (fieldName === 'PhaseOrder') {
                        field.value = String(Number.isFinite(lastPhaseOrder) && lastPhaseOrder > 0 ? lastPhaseOrder : 1);
                        return;
                    }

                    if (fieldName === 'PeriodOrder') {
                        field.value = String(Number.isFinite(lastPeriodOrder) && lastPeriodOrder > 0 ? lastPeriodOrder + 1 : 1);
                        return;
                    }

                    if (fieldName === 'PhaseType') {
                        field.value = 'MAIN';
                        return;
                    }

                    if (fieldName === 'PhaseStatus') {
                        field.value = 'วางแผน';
                    }
                });
            }

            document.addEventListener('click', event => {
                const addButton = event.target.closest('[data-add-phase-row]');
                if (addButton) {
                    const block = addButton.closest('.rb-phase-draft');
                    const list = block?.querySelector('[data-phase-list]');
                    const firstRow = list?.querySelector('[data-phase-row]');
                    if (!list || !firstRow) return;

                    const newRow = firstRow.cloneNode(true);
                    resetPhaseRow(newRow, list);
                    list.appendChild(newRow);
                    reindexPhaseRows(list);
                    newRow.querySelector('[data-phase-field="PhaseName"]')?.focus();
                    return;
                }

                const removeButton = event.target.closest('[data-remove-phase-row]');
                if (!removeButton) return;

                const list = removeButton.closest('[data-phase-list]');
                const row = removeButton.closest('[data-phase-row]');
                if (!list || !row) return;

                const rows = list.querySelectorAll('[data-phase-row]');
                if (rows.length <= 1) {
                    resetPhaseRow(row, null);
                } else {
                    row.remove();
                }

                reindexPhaseRows(list);
            });

            document.addEventListener('input', event => {
                const input = event.target.closest('[data-rb-date]');
                if (!input) return;

                let value = input.value.replace(/\D/g, '');
                if (value.length > 8) value = value.substring(0, 8);

                if (value.length >= 5) {
                    value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
                } else if (value.length >= 3) {
                    value = `${value.substring(0, 2)}/${value.substring(2)}`;
                }

                input.value = value;
            });

            function parseThaiDateToIso(value) {
                const match = (value || '').trim().match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})$/);
                if (!match) return '';

                const day = Number(match[1]);
                const month = Number(match[2]);
                let year = Number(match[3]);
                if (year < 100) year += 2500;
                if (year > 2400) year -= 543;

                if (!day || !month || !year || month < 1 || month > 12 || day < 1 || day > 31) return '';
                return `${year.toString().padStart(4, '0')}-${month.toString().padStart(2, '0')}-${day.toString().padStart(2, '0')}`;
            }

            function formatIsoDateToThai(value) {
                const match = (value || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
                if (!match) return '';

                const year = Number(match[1]) + 543;
                return `${match[3]}/${match[2]}/${year}`;
            }

            function syncDateInputFromNative(textInput, nativeInput) {
                if (!textInput || !nativeInput?.value) return;

                textInput.value = formatIsoDateToThai(nativeInput.value);
                textInput.dispatchEvent(new Event('input', { bubbles: true }));
                textInput.dispatchEvent(new Event('change', { bubbles: true }));
                textInput.focus();
            }

            function openDatePickerFor(wrap) {
                const textInput = wrap?.querySelector('[data-rb-date]');
                const nativeInput = wrap?.querySelector('[data-rb-native-date]');
                if (!textInput || !nativeInput) return;

                nativeInput.value = parseThaiDateToIso(textInput.value);

                if (typeof nativeInput.showPicker === 'function') {
                    nativeInput.showPicker();
                } else {
                    nativeInput.click();
                }
            }

            document.addEventListener('click', event => {
                const button = event.target.closest('[data-rb-date-button]');
                if (!button) return;

                openDatePickerFor(button.closest('.rb-date-input-wrap'));
            });

            document.addEventListener('change', event => {
                const nativeInput = event.target.closest('[data-rb-native-date]');
                if (!nativeInput) return;

                const wrap = nativeInput.closest('.rb-date-input-wrap');
                syncDateInputFromNative(wrap?.querySelector('[data-rb-date]'), nativeInput);
            });

            function cleanupDragImage() {
                if (dragImage) {
                    dragImage.remove();
                    dragImage = null;
                }
            }

            function getDragAfterElement(list, y) {
                const cards = [...list.querySelectorAll('.rb-card:not(.is-dragging)')];

                return cards.reduce((closest, child) => {
                    const box = child.getBoundingClientRect();
                    const offset = y - box.top - box.height / 2;

                    if (offset < 0 && offset > closest.offset) {
                        return { offset, element: child };
                    }

                    return closest;
                }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
            }

            function clearColumnDropMarkers() {
                document.querySelectorAll('.rb-column.is-column-drop-before, .rb-column.is-column-drop-after')
                    .forEach(column => column.classList.remove('is-column-drop-before', 'is-column-drop-after'));
            }

            function getColumnAfterElement(board, x) {
                const columns = [...board.querySelectorAll('.rb-column:not(.is-column-dragging)')];

                return columns.reduce((closest, child) => {
                    const box = child.getBoundingClientRect();
                    const offset = x - box.left - box.width / 2;

                    if (offset < 0 && offset > closest.offset) {
                        return { offset, element: child };
                    }

                    return closest;
                }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
            }

            async function persistColumnOrder(board) {
                const orderedColumnIds = Array.from(board.querySelectorAll('.rb-column'))
                    .map(column => Number(column.dataset.columnId || 0))
                    .filter(Boolean);

                if (orderedColumnIds.length === 0) return;

                try {
                    const response = await fetch('@Url.Action("ReorderColumns", "RequirementBoard")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ orderedColumnIds })
                    });

                    if (!response.ok) {
                        window.location.reload();
                    }
                } catch {
                    window.location.reload();
                }
            }

            document.querySelectorAll('[data-column-drag-handle]').forEach(handle => {
                handle.addEventListener('dragstart', event => {
                    const column = handle.closest('.rb-column');
                    if (!column) return;

                    draggedColumn = column;
                    originalNextColumn = column.nextElementSibling;
                    didColumnDrop = false;
                    wasDragging = true;
                    column.classList.add('is-column-dragging');
                    event.dataTransfer.effectAllowed = 'move';
                    event.dataTransfer.setData('text/plain', column.dataset.columnId || '');

                    dragImage = column.cloneNode(true);
                    dragImage.classList.add('rb-column-drag-image');
                    dragImage.classList.remove('is-column-dragging', 'is-column-drop-before', 'is-column-drop-after');
                    dragImage.style.width = `${column.offsetWidth}px`;
                    document.body.appendChild(dragImage);

                    const rect = column.getBoundingClientRect();
                    event.dataTransfer.setDragImage(
                        dragImage,
                        event.clientX - rect.left,
                        Math.min(event.clientY - rect.top, 80)
                    );
                });

                handle.addEventListener('dragend', () => {
                    if (!didColumnDrop && draggedColumn) {
                        const board = draggedColumn.closest('.rb-board');
                        if (board) {
                            if (originalNextColumn && originalNextColumn.parentElement === board) {
                                board.insertBefore(draggedColumn, originalNextColumn);
                            } else {
                                const addColumn = board.querySelector('.rb-add-list-column');
                                if (addColumn) {
                                    board.insertBefore(draggedColumn, addColumn);
                                } else {
                                    board.appendChild(draggedColumn);
                                }
                            }
                        }
                    }

                    draggedColumn?.classList.remove('is-column-dragging');
                    clearColumnDropMarkers();
                    cleanupDragImage();
                    suppressClickUntil = Date.now() + 250;
                    setTimeout(() => {
                        draggedColumn = null;
                        originalNextColumn = null;
                        didColumnDrop = false;
                        wasDragging = false;
                    }, 0);
                });
            });

            document.querySelectorAll('.rb-board').forEach(board => {
                board.addEventListener('dragover', event => {
                    if (!draggedColumn) return;

                    event.preventDefault();
                    clearColumnDropMarkers();

                    const afterElement = getColumnAfterElement(board, event.clientX);
                    const addColumn = board.querySelector('.rb-add-list-column');
                    if (afterElement == null) {
                        if (addColumn) {
                            board.insertBefore(draggedColumn, addColumn);
                        } else {
                            board.appendChild(draggedColumn);
                        }
                        draggedColumn.previousElementSibling?.classList.add('is-column-drop-after');
                    } else {
                        board.insertBefore(draggedColumn, afterElement);
                        afterElement.classList.add('is-column-drop-before');
                    }
                });

                board.addEventListener('dragleave', event => {
                    if (!draggedColumn || board.contains(event.relatedTarget)) return;
                    clearColumnDropMarkers();
                });

                board.addEventListener('drop', async event => {
                    if (!draggedColumn) return;

                    event.preventDefault();
                    didColumnDrop = true;
                    clearColumnDropMarkers();
                    await persistColumnOrder(board);
                });
            });

            document.querySelectorAll('.rb-card').forEach(card => {
                card.addEventListener('dragstart', event => {
                    if (draggedColumn) return;
                    draggedCard = card;
                    originalList = card.closest('.rb-card-list');
                    originalNextCard = card.nextElementSibling;
                    didDrop = false;
                    wasDragging = true;
                    card.classList.add('is-dragging');
                    event.dataTransfer.effectAllowed = 'move';
                    event.dataTransfer.setData('text/plain', card.dataset.cardId || '');

                    dragImage = card.cloneNode(true);
                    dragImage.classList.add('rb-drag-image');
                    dragImage.style.width = `${card.offsetWidth}px`;
                    document.body.appendChild(dragImage);

                    const rect = card.getBoundingClientRect();
                    event.dataTransfer.setDragImage(
                        dragImage,
                        event.clientX - rect.left,
                        event.clientY - rect.top
                    );
                });

                card.addEventListener('dragend', () => {
                    if (!didDrop && originalList && draggedCard) {
                        if (originalNextCard && originalNextCard.parentElement === originalList) {
                            originalList.insertBefore(draggedCard, originalNextCard);
                        } else {
                            originalList.appendChild(draggedCard);
                        }
                    }

                    card.classList.remove('is-dragging');
                    document.querySelectorAll('.rb-card-list.is-over').forEach(item => item.classList.remove('is-over'));
                    cleanupDragImage();
                    suppressClickUntil = Date.now() + 250;
                    setTimeout(() => {
                        draggedCard = null;
                        originalList = null;
                        originalNextCard = null;
                        didDrop = false;
                        wasDragging = false;
                    }, 0);
                });

                card.addEventListener('click', event => {
                    if (wasDragging || Date.now() < suppressClickUntil) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                });
            });

            document.querySelectorAll('.rb-card-list').forEach(list => {
                list.addEventListener('dragover', event => {
                    if (draggedColumn) return;
                    event.preventDefault();
                    list.classList.add('is-over');

                    if (!draggedCard) return;

                    const afterElement = getDragAfterElement(list, event.clientY);
                    if (afterElement == null) {
                        list.appendChild(draggedCard);
                    } else {
                        list.insertBefore(draggedCard, afterElement);
                    }
                });

                list.addEventListener('dragleave', () => {
                    list.classList.remove('is-over');
                });

                list.addEventListener('drop', async event => {
                    if (draggedColumn) return;
                    event.preventDefault();
                    list.classList.remove('is-over');
                    if (!draggedCard) return;

                    didDrop = true;
                    const cardId = Number(draggedCard.dataset.cardId || 0);
                    const columnId = Number(list.dataset.columnId || 0);
                    const orderedCardIds = Array.from(list.querySelectorAll('.rb-card'))
                        .map(card => Number(card.dataset.cardId || 0))
                        .filter(Boolean);

                    try {
                        const response = await fetch('@Url.Action("MoveCard", "RequirementBoard")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify({ cardId, columnId, orderedCardIds })
                        });

                        if (!response.ok) {
                            window.location.reload();
                        }
                    } catch {
                        window.location.reload();
                    }
                });
            });
        })();
    </script>
}

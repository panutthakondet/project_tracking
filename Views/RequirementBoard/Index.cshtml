            grid-template-columns: 1fr auto;
            gap: 8px;
            align-items: center;
        }

        .boards-close-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 38px;
            padding: 0 12px;
            border: 1px solid #d7e1ec;
            border-radius: 8px;
            background: #fff;
            color: #475569;
            font-size: .88rem;
            font-weight: 850;
            cursor: pointer;
        }

        .boards-close-button:hover {
            border-color: #b9c8d9;
            color: #0f172a;
            background: #f8fafc;
        }

        .boards-danger-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 38px;
            width: 100%;
            padding: 0 12px;
            border: 1px solid #fecaca;
            border-radius: 8px;
            background: #fff5f5;
            color: #b91c1c;
            font-size: .88rem;
            font-weight: 850;
            cursor: pointer;
        }

        .boards-danger-button:hover {
            background: #fee2e2;
            border-color: #fca5a5;
        }

        .boards-panel-divider {
            height: 1px;
            margin: 2px 0;
            background: #e5edf6;
        }

        .boards-main {
            display: grid;
            align-content: start;
            gap: 26px;
            min-width: 0;
        }

        .boards-topbar {
            display: grid;
            grid-template-columns: minmax(280px, 620px) auto;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 2px 0 8px;
        }

        .boards-search-wrap {
            position: relative;
        }

        .boards-search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #3b5877;
            font-size: 1.05rem;
            font-weight: 900;
            pointer-events: none;
        }

        .boards-search {
            width: 100%;
            min-height: 42px;
            padding: 0 14px 0 42px;
            border: 2px solid #bfd1e6;
            border-radius: 8px;
            background: #fff;
            color: #172033;
            font-size: .94rem;
            font-weight: 750;
            outline: none;
            box-shadow: 0 12px 28px rgba(28, 44, 72, .10), inset 0 1px 0 rgba(255, 255, 255, .72);
        }

        .boards-search:focus {
            border-color: #0c66e4;
            box-shadow: 0 0 0 3px rgba(12, 102, 228, .13);
        }

        .boards-actions {
            display: inline-flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
        }

        .boards-online-users {
            display: inline-flex;
            align-items: center;
            min-height: 38px;
            padding: 0 9px;
            border: 1px solid #d7e1ec;
            border-radius: 999px;
            background: #fff;
            box-shadow: 0 8px 18px rgba(28, 44, 72, .05);
        }

        .boards-online-avatar {
            position: relative;
            width: 28px;
            height: 28px;
            margin-left: -5px;
            border: 2px solid #fff;
            border-radius: 999px;
            background: #2563eb;
            font-size: .72rem;
        }

        .boards-online-avatar:first-child {
            margin-left: 0;
        }

        .boards-online-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .boards-online-more {
            padding: 0 3px 0 7px;
            color: #475569;
            font-size: .76rem;
            font-weight: 850;
        }

        .boards-stat {
            display: inline-flex;
            align-items: center;
            min-height: 38px;
            padding: 0 12px;
            border: 1px solid #d7e1ec;
            border-radius: 8px;
            background: linear-gradient(135deg, rgba(255, 255, 255, .98), rgba(240, 249, 255, .94));
            color: #273246;
            font-size: .9rem;
            font-weight: 900;
            white-space: nowrap;
            box-shadow: 0 10px 22px rgba(28, 44, 72, .07);
        }

        .boards-section {
            display: grid;
            gap: 16px;
            padding: 18px 20px 24px;
            border: 1px solid var(--boards-section-border, rgba(203, 213, 225, .7));
            border-radius: 8px;
            background:
                linear-gradient(180deg, rgba(255, 255, 255, .52), rgba(255, 255, 255, .18)),
                linear-gradient(135deg, var(--boards-section-wash, rgba(20, 184, 166, .05)), rgba(12, 102, 228, .045));
            box-shadow: 0 18px 38px rgba(28, 44, 72, .06);
        }

        .boards-section-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            min-height: 50px;
            padding: 0 0 2px;
        }

        .boards-section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
            color: #172033;
            font-size: 1.28rem;
            font-weight: 900;
            letter-spacing: 0;
        }

        .boards-section-subtitle {
            color: #475569;
            font-size: .9rem;
            font-weight: 850;
            white-space: nowrap;
        }

        .boards-section-actions {
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .boards-rename {
            position: relative;
        }

        .boards-rename summary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 32px;
            padding: 0 10px;
            border: 1px solid #d7e1ec;
            border-radius: 8px;
            background: #fff;
            color: #475569;
            font-size: .8rem;
            font-weight: 850;
            cursor: pointer;
            list-style: none;
            box-shadow: 0 8px 18px rgba(28, 44, 72, .06);
        }

        .boards-rename summary::-webkit-details-marker {
            display: none;
        }

        .boards-rename summary:hover {
            border-color: #b9c8d9;
            color: #0c66e4;
        }

        .boards-rename-panel {
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            z-index: 20;
            width: 320px;
            padding: 12px;
            border: 1px solid #d7e1ec;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 18px 40px rgba(28, 44, 72, .16);
        }

        .boards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 18px;
            align-items: stretch;
        }

        .boards-board-tile {
            position: relative;
            min-height: 150px;
        }

        .boards-card,
        .boards-create-board {
            min-height: 150px;
            border-radius: 8px;
        }

        .boards-card {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(203, 213, 225, .88);
            background: linear-gradient(180deg, #fff, #fbfdff);
            color: #172033;
            text-decoration: none;
            box-shadow: 0 16px 30px rgba(28, 44, 72, .12);
            transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
        }

        .boards-card::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient(180deg, rgba(255, 255, 255, .18), transparent 40%);
        }

        .boards-board-tile .boards-card {
            display: block;
            height: 100%;
        }

        .boards-card:hover {
            transform: translateY(-4px);
            border-color: rgba(12, 102, 228, .28);
            box-shadow: 0 22px 42px rgba(28, 44, 72, .18);
        }

        .boards-card-cover {
            height: 74px;
            background: var(--board-cover);
            background-position: center;
            background-size: cover;
        }

        .boards-card.has-image .boards-card-cover {
            background-image:
                linear-gradient(180deg, rgba(15, 23, 42, .08), rgba(15, 23, 42, .18)),
                var(--board-image);
        }

        .boards-card-title {
            display: flex;
            align-items: center;
            min-height: 76px;
            padding: 14px 16px 16px;
            font-size: 1.02rem;
            font-weight: 900;
            line-height: 1.3;
        }

        .boards-card-meta {
            position: absolute;
            right: 12px;
            top: 12px;
            padding: 5px 10px;
            border-radius: 999px;
            background: rgba(255, 255, 255, .92);
            color: #334155;
            font-size: .76rem;
            font-weight: 900;
            box-shadow: 0 8px 18px rgba(15, 23, 42, .12);
        }

        .boards-card-menu {
            position: absolute;
            inset: 0;
            z-index: 5;
            pointer-events: none;
        }

        .boards-card-menu[open] {
            z-index: 40;
            pointer-events: auto;
        }

        .boards-card-menu summary {
            position: absolute;
            right: 10px;
            bottom: 10px;
            width: fit-content;
            min-height: 30px;
            padding: 0 10px;
            background: rgba(255, 255, 255, .92);
            font-size: .76rem;
            pointer-events: auto;
        }

        .boards-card-menu .boards-rename-panel {
            position: fixed;
            left: 50%;
            right: auto;
            top: 16px;
            z-index: 2100;
            width: min(720px, calc(100vw - 32px));
            max-height: calc(100vh - 32px);
            overflow: auto;
            transform: translateX(-50%);
            box-shadow: 0 18px 42px rgba(28, 44, 72, .22);
        }

        .boards-card-menu[open] summary {
            display: none;
        }

        .boards-create-board {
            border: 1px dashed rgba(12, 102, 228, .34);
            background:
                linear-gradient(135deg, rgba(255, 255, 255, .72), rgba(240, 249, 255, .62)),
                repeating-linear-gradient(-45deg, rgba(12, 102, 228, .055) 0 8px, transparent 8px 18px);
            overflow: visible;
            position: relative;
            transform: none !important;
            transition: border-color .15s ease, background .15s ease, box-shadow .15s ease;
        }

        .boards-create-board:hover {
            border-color: rgba(12, 102, 228, .6);
            background:
                linear-gradient(135deg, rgba(255, 255, 255, .9), rgba(236, 253, 245, .72)),
                repeating-linear-gradient(-45deg, rgba(20, 184, 166, .07) 0 8px, transparent 8px 18px);
            box-shadow: 0 16px 28px rgba(28, 44, 72, .08);
        }

        .boards-create-board.is-create-open,
        .boards-create-board:has(details[open]),
        .boards-create-board.is-create-open:hover,
        .boards-create-board:has(details[open]):hover {
            transform: none;
            z-index: 2300;
        }

        .boards-create-board details {
            position: relative;
            height: 100%;
        }

        .boards-create-board details[open] {
            z-index: 2300;
        }

        .boards-create-board details[open]::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: 2290;
            background: rgba(15, 23, 42, .34);
            backdrop-filter: blur(2px);
        }

        .boards-create-board summary {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 150px;
            padding: 12px;
            color: #334155;
            font-size: 1rem;
            font-weight: 900;
            cursor: pointer;
            list-style: none;
        }

        .boards-create-board details[open] summary {
            display: none;
        }

        .boards-create-panel {
            position: fixed;
            left: 50%;
            top: 50%;
            z-index: 2301;
            width: min(720px, calc(100vw - 32px));
            max-height: calc(100vh - 32px);
            overflow: auto;
            transform: translate(-50%, -50%);
            padding: 14px;
            border: 1px solid #d7e1ec;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 28px 70px rgba(15, 23, 42, .28);
        }

        .boards-create-panel .boards-form {
            margin: 0;
        }

        .boards-cover-picker {
            display: grid;
            gap: 14px;
        }

        .boards-picker-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .boards-picker-title {
            color: #475569;
            font-size: .76rem;
            font-weight: 900;
        }

        .boards-more-button {
            min-height: 28px;
            padding: 0 10px;
            border: 1px solid #d7e1ec;
            border-radius: 8px;
            background: #fff;
            color: #475569;
            font-size: .76rem;
            font-weight: 850;
            cursor: pointer;
        }

        .boards-more-button:hover {
            border-color: #b9c8d9;
            color: #0c66e4;
        }

        .boards-cover-picker .is-extra-choice {
            display: none !important;
        }

        .boards-image-row {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
        }

        .boards-image-swatch {
            display: block;
            position: relative;
            width: 100%;
            min-height: 112px;
            aspect-ratio: 16 / 9;
            overflow: hidden;
            border: 2px solid #fff;
            border-radius: 8px;
            background-color: #e2e8f0;
            background-position: center;
            background-size: cover;
            box-shadow: 0 0 0 1px rgba(15, 23, 42, .18);
            cursor: pointer;
        }

        .boards-image-swatch input,
        .boards-color-swatch input {
            display: none !important;
        }

        .boards-image-swatch:has(input:checked),
        .boards-color-swatch:has(input:checked),
        .boards-image-swatch.is-selected,
        .boards-color-swatch.is-selected {
            box-shadow: 0 0 0 3px rgba(34, 197, 94, .24), 0 0 0 1px #16a34a;
        }

        .boards-swatch-check {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            display: none;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            border-radius: 999px;
            background: rgba(255, 255, 255, .95);
            color: #16a34a;
            font-size: 1.8rem;
            font-weight: 900;
            line-height: 1;
            box-shadow: 0 8px 18px rgba(22, 163, 74, .22);
        }

        .boards-image-swatch:has(input:checked) .boards-swatch-check,
        .boards-color-swatch:has(input:checked) .boards-swatch-check,
        .boards-image-swatch.is-selected .boards-swatch-check,
        .boards-color-swatch.is-selected .boards-swatch-check {
            display: inline-flex;
        }

        .boards-color-row {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
        }

        .boards-color-swatch {
            display: block !important;
            position: relative;
            width: 100%;
            overflow: hidden;
            border: 2px solid #fff;
            border-radius: 8px;
            background: #e2e8f0;
            box-shadow: 0 0 0 1px rgba(15, 23, 42, .2);
            cursor: pointer;
        }

        .boards-color-visual {
            display: block;
            width: 100%;
            min-height: 112px;
            border-radius: 6px;
            background-color: #e2e8f0;
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
        }

        .boards-color-fill {
            display: none !important;
        }

        .boards-empty {
            padding: 16px;
            border: 1px solid #dbe5f0;
            border-radius: 8px;
            background: #fff;
            color: #64748b;
            font-size: .92rem;
            font-weight: 750;
        }

        .boards-cover-modal {
            position: fixed;
            inset: 0;
            z-index: 2400;
            display: none;
            place-items: center;
            padding: 14px;
            background: rgba(15, 23, 42, .34);
        }

        .boards-cover-modal.is-open {
            display: grid;
        }

        .boards-cover-modal-panel {
            display: grid;
            grid-template-rows: auto auto minmax(0, 1fr);
            width: min(620px, calc(100vw - 18px));
            max-height: min(920px, calc(100vh - 18px));
            overflow: hidden;
            border: 1px solid #d7e1ec;
            border-radius: 10px;
            background: #fff;
            box-shadow: 0 28px 70px rgba(15, 23, 42, .26);
        }

        .boards-cover-modal-head {
            display: grid;
            grid-template-columns: 42px minmax(0, 1fr) 42px;
            align-items: center;
            gap: 8px;
            padding: 12px 16px 8px;
        }

        .boards-cover-modal-title {
            margin: 0;
            color: #475569;
            font-size: 1.12rem;
            font-weight: 900;
            text-align: center;
        }

        .boards-cover-modal-title a {
            color: #0c66e4;
            text-decoration: underline;
        }

        .boards-cover-modal-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border: 0;
            border-radius: 10px;
            background: transparent;
            color: #172033;
            font-size: 1.7rem;
            line-height: 1;
            cursor: pointer;
        }

        .boards-cover-modal-icon:hover {
            background: #f1f5f9;
        }

        .boards-cover-modal-search {
            position: relative;
            padding: 0 20px 12px;
        }

        .boards-cover-modal-search span {
            position: absolute;
            left: 34px;
            top: 0;
            bottom: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            color: #475569;
            pointer-events: none;
        }

        .boards-cover-modal-search span svg {
            width: 24px;
            height: 24px;
        }

        .boards-cover-modal-search input {
            width: 100%;
            min-height: 54px;
            padding: 0 14px 0 62px;
            border: 1px solid #94a3b8;
            border-radius: 8px;
            color: #172033;
            font-size: 1.05rem;
            font-weight: 800;
            outline: none;
        }

        .boards-cover-modal-body {
            min-height: 0;
            overflow: auto;
            padding: 0 20px 20px;
        }

        .boards-library-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .boards-library-empty {
            margin: 18px 0 0;
            padding: 22px;
            border: 1px dashed #cbd5e1;
            border-radius: 8px;
            color: #64748b;
            font-weight: 900;
            text-align: center;
        }

        .boards-library-image,
        .boards-library-color {
            position: relative;
            border: 0;
            border-radius: 8px;
            background-position: center;
            background-size: cover;
            cursor: pointer;
        }

        .boards-library-image,
        .boards-library-color {
            min-height: 150px;
            aspect-ratio: 16 / 9;
        }

        .boards-library-image.is-selected,
        .boards-library-color.is-selected {
            box-shadow: 0 0 0 3px rgba(34, 197, 94, .24), 0 0 0 1px #16a34a;
        }

        .boards-library-image.is-selected::after,
        .boards-library-color.is-selected::after {
            content: "✓";
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            border-radius: 999px;
            background: rgba(255, 255, 255, .95);
            color: #16a34a;
            font-size: 1.8rem;
            font-weight: 900;
            box-shadow: 0 8px 18px rgba(22, 163, 74, .22);
        }

        .boards-cover-modal[data-mode="color"] .boards-cover-modal-search {
            display: none;
        }

        .boards-cover-modal[data-mode="color"] .boards-library-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            padding-top: 14px;
        }

        .boards-cover-modal[data-mode="color"] .boards-library-color {
            min-height: 128px;
            aspect-ratio: auto;
        }

        @@media (max-width: 980px) {
            .boards-page {
                grid-template-columns: 1fr;
                padding: 14px 0 32px;
            }

            .boards-sidebar {
                position: static;
            }

            .boards-topbar {
                grid-template-columns: 1fr;
            }

            .boards-actions {
                justify-content: flex-start;
                flex-wrap: wrap;
            }

            .boards-rename:not(.boards-card-menu) .boards-rename-panel {
                right: auto;
                left: 0;
            }

            .boards-card-menu .boards-rename-panel,
            .boards-create-panel {
                left: 50%;
                transform: translateX(-50%);
                width: min(720px, calc(100vw - 28px));
            }

            .boards-library-grid,
            .boards-cover-modal[data-mode="color"] .boards-library-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }
    </style>
}

<div class="boards-page">
    <aside class="boards-sidebar">
        <nav class="boards-nav" aria-label="Project Board navigation">
            <a class="boards-nav-link is-active" asp-controller="RequirementBoard" asp-action="Index">
                <span class="boards-icon board">▦</span>
                <span>กระดาน</span>
            </a>
            <a class="boards-nav-link dashboard" asp-controller="Home" asp-action="Index">
                <span class="boards-icon dashboard">⌂</span>
                <span>Dashboard</span>
            </a>
        </nav>

        <div>
            <div class="boards-sidebar-title">พื้นที่ทำงานต่างๆ</div>
            <div class="boards-group-list">
                @foreach (var groupItem in Model.Groups.Select((Group, Index) => new { Group, Index }))
                {
                    var group = groupItem.Group;
                    var toneClass = groupToneClasses[groupItem.Index % groupToneClasses.Length];
                    var initial = string.IsNullOrWhiteSpace(group.GroupName)
                        ? "?"
                        : group.GroupName.Trim().Substring(0, 1).ToUpperInvariant();
                    var sidebarGroupCardTotal = group.Boards
                        .SelectMany(x => x.Columns)
                        .Sum(x => x.Cards.Count);
                    <a class="boards-group-link @toneClass" href="#group-@group.GroupId">
                        <span class="boards-avatar">@initial</span>
                        <span class="boards-group-copy">
                            <span class="boards-group-name">@group.GroupName</span>
                            <span class="boards-group-meta">@group.Boards.Count board · @sidebarGroupCardTotal cards</span>
                        </span>
                    </a>
                }
            </div>
        </div>

        @if (canCreate)
        {
            <div class="boards-create-box">
                <details>
                    <summary class="boards-create-summary">
                        <span class="boards-icon create">+</span>
                        <span>เพิ่ม group</span>
                    </summary>
                    <form class="boards-form" asp-action="CreateGroup" method="post">
                        @Html.AntiForgeryToken()
                        <input class="boards-input" name="groupName" maxlength="150" placeholder="ชื่อ group" required />
                        <div class="boards-form-actions">
                            <button class="boards-button" type="submit">สร้าง group</button>
                            <button class="boards-close-button" type="button" data-close-details>ปิด</button>
                        </div>
                    </form>
                </details>
            </div>
        }
    </aside>

    <main class="boards-main">
        <section class="boards-topbar">
            <div class="boards-search-wrap">
                <span class="boards-search-icon">⌕</span>
                <input class="boards-search" type="search" placeholder="ค้นหา board..." data-board-search autocomplete="off" />
            </div>
            <div class="boards-actions">
                @if (visibleOnlineUsers.Count > 0)
                {
                    <div class="boards-online-users" aria-label="Online users">
                        @foreach (var user in visibleOnlineUsers)
                        {
                            <span class="boards-online-avatar" title="@user.DisplayName">
                                <img src="@user.AvatarPath"
                                     alt="@user.DisplayName"
                                     onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                            </span>
                        }
                        @if (hiddenOnlineCount > 0)
                        {
                            <span class="boards-online-more">+@hiddenOnlineCount</span>
                        }
                    </div>
                }
                <span class="boards-stat">@Model.TotalBoards board · @Model.TotalCards cards</span>
            </div>
        </section>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (Model.Groups.Count == 0)
        {
            <div class="boards-empty">ยังไม่มี group สำหรับกระดาน</div>
        }

        @foreach (var groupItem in Model.Groups.Select((Group, Index) => new { Group, Index }))
        {
            var group = groupItem.Group;
            var toneClass = groupToneClasses[groupItem.Index % groupToneClasses.Length];
            var initial = string.IsNullOrWhiteSpace(group.GroupName)
                ? "?"
                : group.GroupName.Trim().Substring(0, 1).ToUpperInvariant();
            var groupCardTotal = group.Boards
                .SelectMany(x => x.Columns)
                .Sum(x => x.Cards.Count);
            <section class="boards-section @toneClass" id="group-@group.GroupId" data-board-section>
                <div class="boards-section-head">
                    <h2 class="boards-section-title">
                        <span class="boards-avatar">@initial</span>
                        <span>@group.GroupName</span>
                    </h2>
                    <div class="boards-section-actions">
                        <div class="boards-section-subtitle">@group.Boards.Count board · @groupCardTotal cards</div>
                        @if (canEdit || canDelete)
                        {
                            <details class="boards-rename">
                                <summary>แก้ไข</summary>
                                <div class="boards-rename-panel">
                                    @if (canEdit)
                                    {
                                        <form class="boards-form"
                                              asp-action="RenameGroup"
                                              method="post"
                                              onsubmit="return confirm('บันทึกการแก้ไขชื่อ group นี้หรือไม่?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="groupId" value="@group.GroupId" />
                                            <input class="boards-input" name="groupName" maxlength="150" value="@group.GroupName" required />
                                            <div class="boards-form-actions">
                                                <button class="boards-button" type="submit">บันทึกชื่อ group</button>
                                                <button class="boards-close-button" type="button" data-close-details>ปิด</button>
                                            </div>
                                        </form>
                                    }
                                    @if (canEdit && canDelete)
                                    {
                                        <div class="boards-panel-divider"></div>
                                    }
                                    @if (canDelete)
                                    {
                                        <form class="boards-form"
                                              asp-action="DeleteGroup"
                                              method="post"
                                              onsubmit="return confirm('ลบ group นี้พร้อมซ่อน board ทั้งหมดใน group หรือไม่?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="groupId" value="@group.GroupId" />
                                            <button class="boards-danger-button" type="submit">ลบ group</button>
                                        </form>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                </div>

                <div class="boards-grid">
                    @foreach (var board in group.Boards)
                    {
                        var cardCount = board.Columns.Sum(x => x.Cards.Count);
                        var color = string.IsNullOrWhiteSpace(board.CoverColor) ? gradientPalette[0].Value : board.CoverColor;
                        var coverBackground = CoverBackground(color);
                        var imagePath = string.IsNullOrWhiteSpace(board.CoverImagePath) ? "" : Url.Content(board.CoverImagePath);
                        var cardClass = string.IsNullOrWhiteSpace(imagePath) ? "boards-card" : "boards-card has-image";
                        var boardStyle = string.IsNullOrWhiteSpace(imagePath)
                            ? $"--board-cover: {coverBackground};"
                            : $"--board-cover: {coverBackground}; --board-image: url('{imagePath}');";
                        <div class="boards-board-tile"
                             data-board-card
                             data-board-text="@($"{group.GroupName} {board.BoardName}")">
                            <a class="@cardClass"
                               asp-controller="RequirementBoard"
                               asp-action="Board"
                               asp-route-id="@board.BoardId"
                               style="@boardStyle">
                                <div class="boards-card-cover"></div>
                                <div class="boards-card-meta">@cardCount cards</div>
                                <div class="boards-card-title">@board.BoardName</div>
                            </a>
                            @if (canEdit || canDelete)
                            {
                                <details class="boards-rename boards-card-menu">
                                <summary>แก้ไข</summary>
                                    <div class="boards-rename-panel">
                                        @if (canEdit)
                                        {
                                            <form class="boards-form"
                                                  asp-action="RenameBoard"
                                                  method="post"
                                                  onsubmit="return confirm('บันทึกการแก้ไข board นี้หรือไม่?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="boardId" value="@board.BoardId" />
                                                <input class="boards-input" name="boardName" maxlength="150" value="@board.BoardName" required />
                                                <div class="boards-cover-picker">
                                            <div class="boards-picker-head">
                                                <div class="boards-picker-title">รูปพื้นหลัง</div>
                                                <button class="boards-more-button" type="button" data-open-cover-library="image">ดูเพิ่มเติม</button>
                                            </div>
                                            <div class="boards-image-row" aria-label="เลือกรูป board">
                                                @foreach (var image in previewImagePalette)
                                                {
                                                    var isChecked = string.Equals(board.CoverImagePath, image.Path, StringComparison.OrdinalIgnoreCase);
                                                    <label class="boards-image-swatch"
                                                           style="background-image: url('@Url.Content(image.Path)');"
                                                           title="@image.Name">
                                                        <input type="radio" name="coverChoice" value="image:@image.Path" checked="@isChecked" hidden />
                                                        <span class="boards-swatch-check" aria-hidden="true">✓</span>
                                                    </label>
                                                }
                                            </div>
                                            <div class="boards-picker-head">
                                                <div class="boards-picker-title">สี</div>
                                                <button class="boards-more-button" type="button" data-open-cover-library="color">ดูเพิ่มเติม</button>
                                            </div>
                                            <div class="boards-color-row" aria-label="เลือกสี board">
                                                @foreach (var swatch in gradientPalette.Take(initialCoverChoiceCount))
                                                {
                                                    var isChecked = string.IsNullOrWhiteSpace(board.CoverImagePath)
                                                        && string.Equals(color, swatch.Value, StringComparison.OrdinalIgnoreCase);
                                                    <label class="boards-color-swatch" title="@swatch.Name">
                                                        <input type="radio" name="coverChoice" value="color:@swatch.Value" checked="@isChecked" hidden />
                                                        <span class="boards-color-visual" style="background-image: @swatch.Css;" aria-hidden="true"></span>
                                                        <span class="boards-swatch-check" aria-hidden="true">✓</span>
                                                    </label>
                                                }
                                            </div>
                                                </div>
                                                <div class="boards-form-actions">
                                                    <button class="boards-button" type="submit">บันทึก</button>
                                                    <button class="boards-close-button" type="button" data-close-details>ปิด</button>
                                                </div>
                                            </form>
                                        }
                                        @if (canEdit && canDelete)
                                        {
                                            <div class="boards-panel-divider"></div>
                                        }
                                        @if (canDelete)
                                        {
                                            <form class="boards-form"
                                                  asp-action="DeleteBoard"
                                                  method="post"
                                                  onsubmit="return confirm('ลบ board นี้หรือไม่? การ์ดจะถูกซ่อนจากหน้า board แต่ข้อมูลยังอยู่ในฐานข้อมูล');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="boardId" value="@board.BoardId" />
                                                <button class="boards-danger-button" type="submit">ลบ board</button>
                                            </form>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    }

                    @if (canCreate)
                    {
                        <div class="boards-create-board">
                            <details>
                                <summary><span>+</span><span>สร้างบอร์ดใหม่</span></summary>
                                <div class="boards-create-panel">
                                    <form class="boards-form" asp-action="CreateBoard" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="groupId" value="@group.GroupId" />
                                    <input class="boards-input" name="boardName" maxlength="150" placeholder="ชื่อ board" required />
                                    <div class="boards-cover-picker">
                                        <div class="boards-picker-head">
                                            <div class="boards-picker-title">รูปพื้นหลัง</div>
                                            <button class="boards-more-button" type="button" data-open-cover-library="image">ดูเพิ่มเติม</button>
                                        </div>
                                        <div class="boards-image-row" aria-label="เลือกรูป board">
                                            @foreach (var image in previewImagePalette)
                                            {
                                                <label class="boards-image-swatch"
                                                       style="background-image: url('@Url.Content(image.Path)');"
                                                       title="@image.Name">
                                                    <input type="radio" name="coverChoice" value="image:@image.Path" hidden />
                                                    <span class="boards-swatch-check" aria-hidden="true">✓</span>
                                                </label>
                                            }
                                        </div>
                                        <div class="boards-picker-head">
                                            <div class="boards-picker-title">สี</div>
                                            <button class="boards-more-button" type="button" data-open-cover-library="color">ดูเพิ่มเติม</button>
                                        </div>
                                        <div class="boards-color-row" aria-label="เลือกสี board">
                                            @for (var i = 0; i < initialCoverChoiceCount; i++)
                                            {
                                                var swatch = gradientPalette[i];
                                                <label class="boards-color-swatch" title="@swatch.Name">
                                                    <input type="radio" name="coverChoice" value="color:@swatch.Value" checked="@(i == 0)" hidden />
                                                    <span class="boards-color-visual" style="background-image: @swatch.Css;" aria-hidden="true"></span>
                                                    <span class="boards-swatch-check" aria-hidden="true">✓</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                    <div class="boards-form-actions">
                                        <button class="boards-button" type="submit">สร้าง board</button>
                                        <button class="boards-close-button" type="button" data-close-details>ปิด</button>
                                    </div>
                                    </form>
                                </div>
                            </details>
                        </div>
                    }
                </div>
            </section>
        }
    </main>
</div>

<div class="boards-cover-modal" data-cover-modal hidden>
    <div class="boards-cover-modal-panel" role="dialog" aria-modal="true" aria-labelledby="coverLibraryTitle">
        <div class="boards-cover-modal-head">
            <button class="boards-cover-modal-icon" type="button" data-cover-modal-back aria-label="ย้อนกลับ">‹</button>
            <h3 class="boards-cover-modal-title" id="coverLibraryTitle" data-cover-modal-title>รูปภาพ โดย <a href="https://unsplash.com/?utm_source=trello&utm_medium=referral&utm_campaign=api-credit" target="_blank" rel="noopener">Unsplash</a></h3>
            <button class="boards-cover-modal-icon" type="button" data-cover-modal-close aria-label="ปิด">×</button>
        </div>
        <div class="boards-cover-modal-search">
            <span aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M10.8 18.1a7.3 7.3 0 1 1 0-14.6 7.3 7.3 0 0 1 0 14.6Z" stroke="currentColor" stroke-width="2.4" />
                    <path d="m16.2 16.2 4.1 4.1" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                </svg>
            </span>
            <input type="search" placeholder="รูป" data-cover-library-search autocomplete="off" />
        </div>
        <div class="boards-cover-modal-body">
            <div class="boards-library-grid" data-cover-image-library>
                @foreach (var image in libraryImagePalette)
                {
                    <button class="boards-library-image"
                            type="button"
                            style="background-image: url('@Url.Content(image.Path)');"
                            data-cover-library-option
                            data-cover-mode="image"
                            data-cover-value="image:@image.Path"
                            data-cover-text="@image.Keywords"
                            aria-label="@image.Name"></button>
                }
            </div>
            <div class="boards-library-empty" data-cover-library-empty hidden>ไม่พบรูปที่ค้นหา</div>
            <div class="boards-library-grid" data-cover-color-library hidden>
                @foreach (var swatch in gradientPalette)
                {
                    <button class="boards-library-color"
                            type="button"
                            style="background: @swatch.Css;"
                            data-cover-library-option
                            data-cover-mode="color"
                            data-cover-value="color:@swatch.Value"
                            data-cover-text="@swatch.Name"
                            aria-label="@swatch.Name"></button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const search = document.querySelector('[data-board-search]');
            const coverModal = document.querySelector('[data-cover-modal]');
            const coverModalTitle = document.querySelector('[data-cover-modal-title]');
            const coverSearch = document.querySelector('[data-cover-library-search]');
            const imageLibrary = document.querySelector('[data-cover-image-library]');
            const colorLibrary = document.querySelector('[data-cover-color-library]');
            const coverLibraryEmpty = document.querySelector('[data-cover-library-empty]');
            let activeCoverPicker = null;

            document.querySelectorAll('.boards-create-board details').forEach(details => {
                const tile = details.closest('.boards-create-board');
                const summary = details.querySelector('summary');
                const syncCreateState = () => {
                    if (details.open) {
                        document.querySelectorAll('.boards-create-board details[open]').forEach(other => {
                            if (other !== details) other.open = false;
                        });
                    }
                    tile?.classList.toggle('is-create-open', details.open);
                };

                summary?.addEventListener('pointerdown', () => {
                    if (!details.open) tile?.classList.add('is-create-open');
                });

                summary?.addEventListener('keydown', event => {
                    if ((event.key === 'Enter' || event.key === ' ') && !details.open) {
                        tile?.classList.add('is-create-open');
                    }
                });

                details.addEventListener('toggle', syncCreateState);
                syncCreateState();
            });

            const syncCoverSwatchSelection = (picker) => {
                const scope = picker || document;
                scope.querySelectorAll('.boards-image-swatch, .boards-color-swatch').forEach(label => {
                    const input = label.querySelector('input[type="radio"]');
                    label.classList.toggle('is-selected', !!input?.checked);
                });
            };

            const filterCoverImages = () => {
                if (!coverSearch) return;

                const keywords = (coverSearch.value || '')
                    .trim()
                    .toLowerCase()
                    .split(/\s+/)
                    .filter(Boolean);
                let visibleCount = 0;

                document.querySelectorAll('[data-cover-library-option][data-cover-mode="image"]').forEach(option => {
                    const text = (option.dataset.coverText || '').toLowerCase();
                    const isMatch = keywords.length === 0 || keywords.every(keyword => text.includes(keyword));
                    option.hidden = !isMatch;
                    if (isMatch) visibleCount += 1;
                });

                if (coverLibraryEmpty) coverLibraryEmpty.hidden = visibleCount > 0;
            };

            const closeCoverModal = () => {
                if (!coverModal) return;
                coverModal.classList.remove('is-open');
                coverModal.hidden = true;
                activeCoverPicker = null;
                if (coverSearch) coverSearch.value = '';
                if (coverLibraryEmpty) coverLibraryEmpty.hidden = true;
                document.querySelectorAll('[data-cover-library-option]').forEach(option => {
                    option.hidden = false;
                    option.classList.remove('is-selected');
                });
            };

            const openCoverModal = (picker, mode) => {
                if (!coverModal || !coverModalTitle || !imageLibrary || !colorLibrary) return;

                activeCoverPicker = picker;
                coverModal.dataset.mode = mode;
                coverModal.hidden = false;
                coverModal.classList.add('is-open');

                const isImageMode = mode === 'image';
                imageLibrary.hidden = !isImageMode;
                colorLibrary.hidden = isImageMode;
                if (coverLibraryEmpty) coverLibraryEmpty.hidden = true;
                if (coverSearch) {
                    coverSearch.value = '';
                    coverSearch.placeholder = isImageMode ? 'รูป' : 'สี';
                }

                coverModalTitle.innerHTML = isImageMode
                    ? 'รูปภาพ โดย <a href="https://unsplash.com/?utm_source=trello&utm_medium=referral&utm_campaign=api-credit" target="_blank" rel="noopener">Unsplash</a>'
                    : 'สี';

                const checkedValue = activeCoverPicker?.querySelector('input[name="coverChoice"]:checked')?.value || '';
                document.querySelectorAll('[data-cover-library-option]').forEach(option => {
                    const isMode = option.dataset.coverMode === mode;
                    option.hidden = !isMode;
                    option.classList.toggle('is-selected', isMode && option.dataset.coverValue === checkedValue);
                });

                if (isImageMode) {
                    requestAnimationFrame(() => coverSearch?.focus());
                }
            };

            search?.addEventListener('input', () => {
                const keyword = (search.value || '').trim().toLowerCase();
                document.querySelectorAll('[data-board-card]').forEach(card => {
                    const text = (card.dataset.boardText || '').toLowerCase();
                    card.style.display = !keyword || text.includes(keyword) ? '' : 'none';
                });
            });

            coverSearch?.addEventListener('input', () => {
                filterCoverImages();
            });

            document.addEventListener('click', event => {
                const swatch = event.target.closest('.boards-image-swatch, .boards-color-swatch');
                if (swatch) {
                    const radio = swatch.querySelector('input[name="coverChoice"]');
                    if (radio && !radio.checked) {
                        radio.checked = true;
                        radio.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    return;
                }

                const libraryButton = event.target.closest('[data-open-cover-library]');
                if (libraryButton) {
                    const picker = libraryButton.closest('.boards-cover-picker');
                    if (!picker) return;

                    openCoverModal(picker, libraryButton.dataset.openCoverLibrary || 'image');
                    return;
                }

                const libraryOption = event.target.closest('[data-cover-library-option]');
                if (libraryOption && activeCoverPicker) {
                    const value = libraryOption.dataset.coverValue || '';
                    let radio = activeCoverPicker.querySelector(`input[name="coverChoice"][value="${CSS.escape(value)}"]`);
                    if (!radio) {
                        radio = document.createElement('input');
                        radio.type = 'radio';
                        radio.name = 'coverChoice';
                        radio.value = value;
                        radio.hidden = true;
                        radio.dataset.coverHiddenChoice = 'true';
                        activeCoverPicker.appendChild(radio);
                    }
                    if (radio) {
                        radio.checked = true;
                        radio.dispatchEvent(new Event('change', { bubbles: true }));
                        syncCoverSwatchSelection(activeCoverPicker);
                    }
                    closeCoverModal();
                    return;
                }

                if (event.target.closest('[data-cover-modal-close]') || event.target.closest('[data-cover-modal-back]')) {
                    closeCoverModal();
                    return;
                }

                if (event.target === coverModal) {
                    closeCoverModal();
                    return;
                }

                const openCreateDetails = document.querySelector('.boards-create-board details[open]');
                if (openCreateDetails && event.target === openCreateDetails) {
                    openCreateDetails.open = false;
                    return;
                }

                const moreButton = event.target.closest('[data-toggle-cover-more]');
                if (moreButton) {
                    const picker = moreButton.closest('.boards-cover-picker');
                    if (!picker) return;

                    picker.classList.toggle('is-expanded');
                    const label = picker.classList.contains('is-expanded') ? 'ย่อน้อยลง' : 'ดูเพิ่มเติม';
                    picker.querySelectorAll('[data-toggle-cover-more]').forEach(button => {
                        button.textContent = label;
                    });
                    return;
                }

                const closeButton = event.target.closest('[data-close-details]');
                if (!closeButton) return;

                const details = closeButton.closest('details');
                if (details) details.open = false;
            });

            document.addEventListener('change', event => {
                const radio = event.target.closest('.boards-cover-picker input[name="coverChoice"]');
                if (!radio) return;
                syncCoverSwatchSelection(radio.closest('.boards-cover-picker'));
            });

            document.addEventListener('keydown', event => {
                if (event.key === 'Escape' && coverModal?.classList.contains('is-open')) {
                    closeCoverModal();
                    return;
                }

                if (event.key === 'Escape') {
                    document.querySelectorAll('.boards-create-board details[open]').forEach(details => {
                        details.open = false;
                    });
                }
            });

            syncCoverSwatchSelection();
        })();
    </script>
}

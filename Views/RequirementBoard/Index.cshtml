@model ProjectTracking.ViewModels.RequirementBoardViewModel

@{
    ViewData["Title"] = "Project Board";

    string FileSize(long bytes)
    {
        if (bytes <= 0) return "-";
        if (bytes >= 1048576) return $"{bytes / 1048576.0:N1} MB";
        return $"{bytes / 1024.0:N0} KB";
    }

    string PersonName(ProjectTracking.Models.RequirementCard card)
    {
        if (!string.IsNullOrWhiteSpace(card.CreatedByEmployee?.EmpName)) return card.CreatedByEmployee.EmpName;
        if (!string.IsNullOrWhiteSpace(card.CreatedByUser?.Username)) return card.CreatedByUser.Username;
        return "ไม่ระบุผู้สร้าง";
    }

    bool IsImage(ProjectTracking.Models.RequirementCardAttachment file)
    {
        return (file.ContentType ?? "").StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    }

    string ThaiDateValue(DateTime? date)
    {
        if (!date.HasValue) return "";
        var value = date.Value;
        return $"{value:dd/MM/}{value.Year + 543}";
    }

    var allCards = Model.Columns.SelectMany(x => x.Cards).OrderByDescending(x => x.UpdatedAt).ToList();
    var visibleOnlineUsers = Model.OnlineUsers.Take(5).ToList();
    var hiddenOnlineCount = Math.Max(0, Model.OnlineUsers.Count - visibleOnlineUsers.Count);
}


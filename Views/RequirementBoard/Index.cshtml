            padding-top: 2px;
        }

        .rb-phase-add-footer .rb-btn {
            min-height: 42px;
            min-width: 92px;
            border-radius: 14px;
            border: 0;
            background: linear-gradient(135deg, #21d4c2, #0f8f80);
            color: #fff;
            box-shadow: 0 10px 22px rgba(15, 143, 128, .18);
        }

        .rb-phase-date-grid {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: repeat(4, minmax(140px, 1fr));
            gap: 10px;
        }

        .rb-phase-remove {
            position: absolute;
            top: 12px;
            right: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            padding: 0;
            border: 1px solid rgba(251, 113, 133, .35);
            border-radius: 50%;
            background: linear-gradient(180deg, #fff, #fff1f2);
            color: #e11d48;
            font-size: 0;
            font-weight: 900;
            line-height: 1;
            box-shadow: 0 8px 18px rgba(190, 18, 60, .12);
            transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
        }

        .rb-phase-remove::before,
        .rb-phase-remove::after {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            width: 14px;
            height: 2px;
            border-radius: 999px;
            background: currentColor;
            transform-origin: center;
        }

        .rb-phase-remove::before {
            transform: translate(-50%, -50%) rotate(45deg);
        }

        .rb-phase-remove::after {
            transform: translate(-50%, -50%) rotate(-45deg);
        }

        .rb-phase-remove:hover {
            transform: translateY(-1px);
            background: #ffe4e6;
            box-shadow: 0 12px 22px rgba(190, 18, 60, .18);
        }

        @@media (max-width: 1200px) {
            .rb-phase-row {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .rb-phase-name-field,
            .rb-phase-date-grid {
                grid-column: 1 / -1;
            }

            .rb-phase-date-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 700px) {
            .rb-phase-row,
            .rb-phase-date-grid {
                grid-template-columns: 1fr;
            }

            .rb-phase-name-field,
            .rb-phase-date-grid {
                grid-column: 1 / -1;
            }

            .rb-phase-remove {
                position: static;
                width: 100%;
            }

            .rb-file-upload-grid {
                grid-template-columns: 1fr;
            }
        }

        .rb-alert {
            margin-bottom: 14px;
            border-radius: 18px;
            border: 0;
            font-weight: 800;
        }

        @@media (max-width: 900px) {
            .rb-page {
                width: 100%;
            }

            .rb-hero,
            .rb-toolbar {
                grid-template-columns: 1fr;
                flex-direction: column;
                align-items: stretch;
            }

            .rb-search {
                flex-basis: auto;
                width: 100%;
                min-width: 0;
            }

            .rb-toolbar-actions {
                justify-content: flex-end;
            }

            .rb-stats {
                justify-content: flex-start;
            }

        }
    </style>
}

<div class="rb-page">
    <section class="rb-hero">
        <div>
            <p class="rb-eyebrow">ProjectTracking</p>
            <h1>Project Board</h1>
        </div>
        <div class="rb-stats" aria-label="Project board summary">
            <div class="rb-stat">
                <strong>@Model.Columns.Count</strong>
                <span>หัวข้อทั้งหมด</span>
            </div>
            <div class="rb-stat">
                <strong>@Model.TotalCards</strong>
                <span>การ์ดทั้งหมด</span>
            </div>
            <div class="rb-stat">
                <strong>@Model.TotalAttachments</strong>
                <span>ไฟล์แนบ</span>
            </div>
        </div>
    </section>

    <section class="rb-toolbar rb-board-strip">
        <div class="rb-search">
            <span class="rb-search-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M10.8 18.1a7.3 7.3 0 1 1 0-14.6 7.3 7.3 0 0 1 0 14.6Z" stroke="currentColor" stroke-width="2.4" />
                    <path d="m16.2 16.2 4.1 4.1" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                </svg>
            </span>
            <input id="requirementBoardSearch"
                   class="rb-search-input"
                   type="search"
                   placeholder="ค้นหาการ์ด..."
                   autocomplete="off" />
            <button class="rb-search-clear" type="button" aria-label="ล้างคำค้น">×</button>
        </div>
        <div class="rb-toolbar-actions">
            @if (visibleOnlineUsers.Count > 0)
            {
                <div class="rb-online-users" aria-label="Online users">
                    @foreach (var user in visibleOnlineUsers)
                    {
                        <span class="rb-online-avatar @user.ColorClass"
                              title="@user.DisplayName">
                            <img src="@user.AvatarPath"
                                 alt="@user.DisplayName"
                                 onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                        </span>
                    }
                    @if (hiddenOnlineCount > 0)
                    {
                        <span class="rb-online-more">+@hiddenOnlineCount</span>
                    }
                </div>
            }
            <a class="rb-btn secondary" asp-controller="Home" asp-action="Index">Dashboard</a>
        </div>
    </section>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rb-alert">@TempData["Error"]</div>
    }

    <div class="rb-board-wrap">
        <div class="rb-board">
            @foreach (var column in Model.Columns)
            {
                <section class="rb-column" data-column-id="@column.ColumnId">
                    <header class="rb-column-head">
                        <h2 class="rb-column-title">@column.ColumnName</h2>
                        <span class="rb-column-count">@column.Cards.Count</span>
                    </header>

                    <div class="rb-card-list" data-column-id="@column.ColumnId">
                        @foreach (var card in column.Cards.OrderBy(x => x.SortOrder).ThenBy(x => x.CardId))
                        {
                            var coverPath = card.CoverImagePath;
                            <article class="rb-card"
                                     draggable="true"
                                     data-card-id="@card.CardId"
                                     data-search-text="@($"{card.Title} {card.Detail}")"
                                     data-bs-toggle="modal"
                                     data-bs-target="#requirementCardModal-@card.CardId">
                                @if (!string.IsNullOrWhiteSpace(coverPath))
                                {
                                    <img class="rb-card-cover" src="@coverPath" alt="@card.Title" />
                                }
                                <div class="rb-card-body">
                                    <h3 class="rb-card-title" data-card-title>@card.Title</h3>
                                </div>
                            </article>
                        }
                    </div>

                    <div class="rb-add-card">
                        <details>
                            <summary><span>เพิ่มการ์ด</span><span>⊞</span></summary>
                            <form asp-action="CreateCard" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="columnId" value="@column.ColumnId" />
                                <input class="rb-input" name="title" maxlength="255" placeholder="หัวข้อ" required />
                                <button class="rb-btn" type="submit">บันทึกการ์ด</button>
                            </form>
                        </details>
                    </div>
                </section>
            }

            <section class="rb-add-list-column">
                <details>
                    <summary><span>เพิ่มลิสต์รายการอื่นอีก</span></summary>
                    <form asp-action="CreateColumn" method="post">
                        @Html.AntiForgeryToken()
                        <input class="rb-input" name="columnName" maxlength="150" placeholder="ชื่อหัวข้อ เช่น Hardware, Complete" required />
                        <button class="rb-btn" type="submit">เพิ่มหัวข้อ</button>
                    </form>
                </details>
            </section>
        </div>
    </div>
</div>

@foreach (var card in allCards)
{
    var modalHeaderStyle = !string.IsNullOrWhiteSpace(card.CoverImagePath)
        ? $"background-image: url('{card.CoverImagePath}');"
        : "";

    <div class="modal fade rb-modal" id="requirementCardModal-@card.CardId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header @(string.IsNullOrWhiteSpace(card.CoverImagePath) ? "" : "has-cover")" style="@modalHeaderStyle">
                    <div class="rb-modal-header-info">
                        <div class="rb-eyebrow">Project Card #@card.CardId</div>
                        <div class="rb-modal-meta" data-card-modal-meta>
                            สร้างโดย @PersonName(card) · อัปเดต @card.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="UpdateCard" method="post" enctype="multipart/form-data" class="row g-3 rb-card-edit-form" data-card-update-form data-card-id="@card.CardId">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="cardId" value="@card.CardId" />
                        <div class="col-12">
                            <div class="rb-edit-panel">
                                <div class="rb-edit-panel-head">ข้อมูลการ์ด</div>
                                <div>
                                    <label class="rb-field-label">หัวข้อ</label>
                                    <input class="rb-input" name="title" maxlength="255" value="@card.Title" required />
                                </div>
                                <div>
                                    <label class="rb-field-label">รายละเอียด</label>
                                    <textarea class="rb-textarea" name="detail">@card.Detail</textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            @{
                                var phaseDrafts = card.PhaseItems
                                    .OrderBy(x => x.PhaseSort == 0 ? int.MaxValue : x.PhaseSort)
                                    .ThenBy(x => x.PhaseOrder)
                                    .ThenBy(x => x.PeriodOrder)
                                    .ThenBy(x => x.ItemId)
                                    .ToList();
                                var phaseDraftRows = Math.Max(phaseDrafts.Count, 1);
                            }
                            <div class="rb-phase-draft">
                                <div class="rb-phase-draft-list" data-phase-list>
                                    @for (var i = 0; i < phaseDraftRows; i++)
                                    {
                                        var phaseItem = i < phaseDrafts.Count ? phaseDrafts[i] : null;
                                        <div class="rb-phase-row" data-phase-row>
                                            <input type="hidden" name="phaseItems[@i].ItemId" value="@(phaseItem?.ItemId)" data-phase-field="ItemId" />
                                            <div>
                                                <label>ส่วนที่</label>
                                                <input class="form-control" type="number" min="1" name="phaseItems[@i].PhaseOrder" value="@(phaseItem?.PhaseOrder ?? 1)" data-phase-field="PhaseOrder" />
                                            </div>
                                            <div>
                                                <label>งวดที่</label>
                                                <input class="form-control" type="number" min="1" name="phaseItems[@i].PeriodOrder" value="@(phaseItem?.PeriodOrder ?? 1)" data-phase-field="PeriodOrder" />
                                            </div>
                                            <input type="hidden" name="phaseItems[@i].PhaseType" value="@(phaseItem?.PhaseType ?? "MAIN")" data-phase-field="PhaseType" />
                                            <input type="hidden" name="phaseItems[@i].PhaseStatus" value="@(phaseItem?.PhaseStatus ?? "วางแผน")" data-phase-field="PhaseStatus" />
                                            <div class="rb-phase-name-field">
                                                <label>รายละเอียดงาน</label>
                                                <textarea class="form-control" maxlength="500" name="phaseItems[@i].PhaseName" data-phase-field="PhaseName" placeholder="เพิ่มรายละเอียดงาน">@(phaseItem?.PhaseName)</textarea>
                                            </div>
                                            <button class="rb-phase-remove" type="button" data-remove-phase-row title="ลบแถว" aria-label="ลบแถว">&times;</button>
                                            <div class="rb-phase-date-grid">
                                                <div>
                                                    <label>Plan Start</label>
                                                    <input class="form-control" type="text" name="phaseItems[@i].PlanStart" value="@ThaiDateValue(phaseItem?.PlanStart)" data-phase-field="PlanStart" data-rb-date placeholder="วัน/เดือน/พ.ศ." />
                                                </div>
                                                <div>
                                                    <label>Plan End</label>
                                                    <input class="form-control" type="text" name="phaseItems[@i].PlanEnd" value="@ThaiDateValue(phaseItem?.PlanEnd)" data-phase-field="PlanEnd" data-rb-date placeholder="วัน/เดือน/พ.ศ." />
                                                </div>
                                                <div>
                                                    <label>Period Start</label>
                                                    <input class="form-control" type="text" name="phaseItems[@i].PeriodStartDate" value="@ThaiDateValue(phaseItem?.PeriodStartDate)" data-phase-field="PeriodStartDate" data-rb-date placeholder="วัน/เดือน/พ.ศ." />
                                                </div>
                                                <div>
                                                    <label>Period End</label>
                                                    <input class="form-control" type="text" name="phaseItems[@i].PeriodEndDate" value="@ThaiDateValue(phaseItem?.PeriodEndDate)" data-phase-field="PeriodEndDate" data-rb-date placeholder="วัน/เดือน/พ.ศ." />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="rb-phase-add-footer">
                                    <button class="rb-btn"
                                            type="button"
                                            data-add-phase-row>
                                        เพิ่ม
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="rb-file-upload-grid">
                                <div class="rb-file-upload-card">
                                    <label class="rb-field-label mb-0">รูปพื้นหลังการ์ด</label>
                                    @if (!string.IsNullOrWhiteSpace(card.CoverImageName))
                                    {
                                        <div class="rb-file-info">รูปปัจจุบัน: @card.CoverImageName</div>
                                    }
                                    <input class="form-control" type="file" name="coverImage" accept="image/*" />
                                </div>
                                <div class="rb-file-upload-card">
                                    <label class="rb-field-label mb-0">เพิ่มไฟล์แนบ</label>
                                    <div class="rb-file-info">เลือกได้หลายไฟล์</div>
                                    <input class="form-control" type="file" name="files" multiple />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 rb-modal-actions">
                            <button class="rb-btn" type="submit">บันทึก</button>
                            <button class="rb-btn secondary" type="button" data-bs-dismiss="modal">ปิด</button>
                            <span class="rb-save-status" data-card-save-status aria-live="polite"></span>
                        </div>
                    </form>

                    <hr class="my-4" />

                    <div>
                        <h3 class="rb-field-label" data-attachment-heading data-attachment-count="@card.Attachments.Count">ไฟล์แนบ (@card.Attachments.Count)</h3>
                        @if (card.Attachments.Count == 0)
                        {
                            <div class="alert alert-light border mb-0">ยังไม่มีไฟล์แนบ</div>
                        }
                        else
                        {
                            <div class="rb-file-list">
                                @foreach (var file in card.Attachments.OrderByDescending(x => x.UploadedAt))
                                {
                                    <div class="rb-file-row">
                                        @if (IsImage(file))
                                        {
                                            <a class="rb-file-thumb-link"
                                               asp-action="PreviewAttachment"
                                               asp-route-id="@file.AttachmentId"
                                               target="_blank"
                                               rel="noopener">
                                                <img class="rb-file-thumb" src="@file.FilePath" alt="@file.FileName" />
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="rb-file-thumb-link rb-file-thumb"
                                               asp-action="PreviewAttachment"
                                               asp-route-id="@file.AttachmentId"
                                               target="_blank"
                                               rel="noopener">FILE</a>
                                        }
                                        <div>
                                            <div class="rb-file-name">@file.FileName</div>
                                            <div class="rb-file-info">@FileSize(file.FileSize) · @file.UploadedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        </div>
                                        <div class="rb-file-actions">
                                            <a class="rb-btn secondary"
                                               asp-action="PreviewAttachment"
                                               asp-route-id="@file.AttachmentId"
                                               target="_blank"
                                               rel="noopener">Preview</a>
                                            <a class="rb-btn secondary" asp-action="DownloadAttachment" asp-route-id="@file.AttachmentId">ดาวน์โหลด</a>
                                            <form asp-action="DeleteAttachment" method="post" onsubmit="return confirm('ลบไฟล์แนบนี้หรือไม่?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="attachmentId" value="@file.AttachmentId" />
                                                <button class="rb-btn danger" type="submit">ลบ</button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <hr class="my-4" />

                    <form asp-action="ArchiveCard" method="post" onsubmit="return confirm('ลบการ์ดนี้ออกจากบอร์ดหรือไม่?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="cardId" value="@card.CardId" />
                        <button class="rb-btn danger" type="submit">ลบการ์ดออกจากบอร์ด</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const searchInput = document.getElementById('requirementBoardSearch');
            const searchBox = searchInput?.closest('.rb-search');
            const clearSearchButton = searchBox?.querySelector('.rb-search-clear');
            let draggedCard = null;
            let dragImage = null;
            let originalList = null;
            let originalNextCard = null;
            let didDrop = false;
            let wasDragging = false;
            let suppressClickUntil = 0;

            function normalizeText(value) {
                return (value || '').toString().trim().toLowerCase();
            }

            function updateColumnCounts() {
                document.querySelectorAll('.rb-column').forEach(column => {
                    const visibleCount = [...column.querySelectorAll('.rb-card')]
                        .filter(card => card.style.display !== 'none')
                        .length;
                    const count = column.querySelector('.rb-column-count');
                    if (count) count.textContent = visibleCount;
                });
            }

            function filterCards() {
                const keyword = normalizeText(searchInput?.value);
                searchBox?.classList.toggle('has-value', Boolean(keyword));

                document.querySelectorAll('.rb-card').forEach(card => {
                    const text = normalizeText(card.dataset.searchText);
                    card.style.display = !keyword || text.includes(keyword) ? '' : 'none';
                });

                updateColumnCounts();
            }

            searchInput?.addEventListener('input', filterCards);
            clearSearchButton?.addEventListener('click', () => {
                if (!searchInput) return;
                searchInput.value = '';
                searchInput.focus();
                filterCards();
            });

            function setSaveStatus(status, message, type) {
                if (!status) return;

                status.textContent = message;
                status.classList.remove('is-success', 'is-error', 'is-visible');
                status.classList.add(type === 'error' ? 'is-error' : 'is-success', 'is-visible');

                window.clearTimeout(status.dataset.hideTimer);
                status.dataset.hideTimer = window.setTimeout(() => {
                    status.classList.remove('is-visible');
                }, 3600);
            }

            function updateBoardCard(data, form) {
                const cardId = data.cardId || form.dataset.cardId;
                const card = document.querySelector(`.rb-card[data-card-id="${cardId}"]`);
                const title = data.title || form.querySelector('[name="title"]')?.value || '';
                const detail = data.detail || form.querySelector('[name="detail"]')?.value || '';

                if (card) {
                    const titleNode = card.querySelector('[data-card-title]');
                    if (titleNode) titleNode.textContent = title;

                    card.dataset.searchText = `${title} ${detail}`;

                    if (data.coverImagePath) {
                        let cover = card.querySelector('.rb-card-cover');
                        if (!cover) {
                            cover = document.createElement('img');
                            cover.className = 'rb-card-cover';
                            card.insertBefore(cover, card.firstElementChild);
                        }
                        cover.src = data.coverImagePath;
                        cover.alt = title;
                    }
                }

                const modal = form.closest('.rb-modal');
                if (!modal) return;

                const modalMeta = modal.querySelector('[data-card-modal-meta]');
                if (modalMeta && data.updatedAt) {
                    modalMeta.textContent = modalMeta.textContent.replace(/อัปเดต .*/, `อัปเดต ${data.updatedAt}`);
                }

                const modalHeader = modal.querySelector('.modal-header');
                if (modalHeader && data.coverImagePath) {
                    modalHeader.classList.add('has-cover');
                    modalHeader.style.backgroundImage = `url('${data.coverImagePath}')`;
                }

                const attachmentHeading = modal.querySelector('[data-attachment-heading]');
                if (attachmentHeading && Number.isFinite(Number(data.attachmentCount))) {
                    attachmentHeading.dataset.attachmentCount = data.attachmentCount;
                    attachmentHeading.textContent = `ไฟล์แนบ (${data.attachmentCount})`;
                }
            }

            document.addEventListener('submit', async event => {
                const form = event.target.closest('[data-card-update-form]');
                if (!form) return;

                event.preventDefault();
                if (!window.confirm('ต้องการบันทึกการ์ดนี้หรือไม่?')) return;

                const submitButton = form.querySelector('button[type="submit"]');
                const status = form.querySelector('[data-card-save-status]');

                submitButton?.classList.add('is-loading');
                if (submitButton) submitButton.disabled = true;
                setSaveStatus(status, 'กำลังบันทึก...', 'success');

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const contentType = response.headers.get('content-type') || '';
                    const result = contentType.includes('application/json')
                        ? await response.json()
                        : { success: false, message: 'บันทึกไม่สำเร็จ กรุณาลองใหม่อีกครั้ง' };

                    if (!response.ok || !result.success) {
                        throw new Error(result.message || 'บันทึกไม่สำเร็จ');
                    }

                    updateBoardCard(result, form);
                    form.querySelectorAll('input[type="file"]').forEach(input => {
                        input.value = '';
                    });
                    setSaveStatus(status, result.message || 'บันทึกแล้ว', 'success');
                } catch (error) {
                    setSaveStatus(status, error.message || 'บันทึกไม่สำเร็จ', 'error');
                } finally {
                    submitButton?.classList.remove('is-loading');
                    if (submitButton) submitButton.disabled = false;
                }
            });

            function reindexPhaseRows(list) {
                if (!list) return;

                list.querySelectorAll('[data-phase-row]').forEach((row, index) => {
                    row.querySelectorAll('[data-phase-field]').forEach(field => {
                        const fieldName = field.dataset.phaseField;
                        if (!fieldName) return;
                        field.name = `phaseItems[${index}].${fieldName}`;
                    });
                });
            }

            function resetPhaseRow(row, sourceList) {
                if (!row) return;

                const rows = sourceList
                    ? Array.from(sourceList.querySelectorAll('[data-phase-row]'))
                    : [];
                const lastRow = rows[rows.length - 1];
                const lastPhaseOrder = sourceList ? Number(lastRow?.querySelector('[data-phase-field="PhaseOrder"]')?.value || 1) : 1;
                const lastPeriodOrder = sourceList ? Number(lastRow?.querySelector('[data-phase-field="PeriodOrder"]')?.value || 0) : 0;

                row.querySelectorAll('input, select, textarea').forEach(field => {
                    const fieldName = field.dataset.phaseField;

                    if (fieldName === 'ItemId' || fieldName === 'PhaseName' || field.matches('[data-rb-date]')) {
                        field.value = '';
                        return;
                    }

                    if (fieldName === 'PhaseOrder') {
                        field.value = String(Number.isFinite(lastPhaseOrder) && lastPhaseOrder > 0 ? lastPhaseOrder : 1);
                        return;
                    }

                    if (fieldName === 'PeriodOrder') {
                        field.value = String(Number.isFinite(lastPeriodOrder) && lastPeriodOrder > 0 ? lastPeriodOrder + 1 : 1);
                        return;
                    }

                    if (fieldName === 'PhaseType') {
                        field.value = 'MAIN';
                        return;
                    }

                    if (fieldName === 'PhaseStatus') {
                        field.value = 'วางแผน';
                    }
                });
            }

            document.addEventListener('click', event => {
                const addButton = event.target.closest('[data-add-phase-row]');
                if (addButton) {
                    const block = addButton.closest('.rb-phase-draft');
                    const list = block?.querySelector('[data-phase-list]');
                    const firstRow = list?.querySelector('[data-phase-row]');
                    if (!list || !firstRow) return;

                    const newRow = firstRow.cloneNode(true);
                    resetPhaseRow(newRow, list);
                    list.appendChild(newRow);
                    reindexPhaseRows(list);
                    newRow.querySelector('[data-phase-field="PhaseName"]')?.focus();
                    return;
                }

                const removeButton = event.target.closest('[data-remove-phase-row]');
                if (!removeButton) return;

                const list = removeButton.closest('[data-phase-list]');
                const row = removeButton.closest('[data-phase-row]');
                if (!list || !row) return;

                const rows = list.querySelectorAll('[data-phase-row]');
                if (rows.length <= 1) {
                    resetPhaseRow(row, null);
                } else {
                    row.remove();
                }

                reindexPhaseRows(list);
            });

            document.addEventListener('input', event => {
                const input = event.target.closest('[data-rb-date]');
                if (!input) return;

                let value = input.value.replace(/\D/g, '');
                if (value.length > 8) value = value.substring(0, 8);

                if (value.length >= 5) {
                    value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
                } else if (value.length >= 3) {
                    value = `${value.substring(0, 2)}/${value.substring(2)}`;
                }

                input.value = value;
            });

            function cleanupDragImage() {
                if (dragImage) {
                    dragImage.remove();
                    dragImage = null;
                }
            }

            function getDragAfterElement(list, y) {
                const cards = [...list.querySelectorAll('.rb-card:not(.is-dragging)')];

                return cards.reduce((closest, child) => {
                    const box = child.getBoundingClientRect();
                    const offset = y - box.top - box.height / 2;

                    if (offset < 0 && offset > closest.offset) {
                        return { offset, element: child };
                    }

                    return closest;
                }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
            }

            document.querySelectorAll('.rb-card').forEach(card => {
                card.addEventListener('dragstart', event => {
                    draggedCard = card;
                    originalList = card.closest('.rb-card-list');
                    originalNextCard = card.nextElementSibling;
                    didDrop = false;
                    wasDragging = true;
                    card.classList.add('is-dragging');
                    event.dataTransfer.effectAllowed = 'move';
                    event.dataTransfer.setData('text/plain', card.dataset.cardId || '');

                    dragImage = card.cloneNode(true);
                    dragImage.classList.add('rb-drag-image');
                    dragImage.style.width = `${card.offsetWidth}px`;
                    document.body.appendChild(dragImage);

                    const rect = card.getBoundingClientRect();
                    event.dataTransfer.setDragImage(
                        dragImage,
                        event.clientX - rect.left,
                        event.clientY - rect.top
                    );
                });

                card.addEventListener('dragend', () => {
                    if (!didDrop && originalList && draggedCard) {
                        if (originalNextCard && originalNextCard.parentElement === originalList) {
                            originalList.insertBefore(draggedCard, originalNextCard);
                        } else {
                            originalList.appendChild(draggedCard);
                        }
                    }

                    card.classList.remove('is-dragging');
                    document.querySelectorAll('.rb-card-list.is-over').forEach(item => item.classList.remove('is-over'));
                    cleanupDragImage();
                    suppressClickUntil = Date.now() + 250;
                    setTimeout(() => {
                        draggedCard = null;
                        originalList = null;
                        originalNextCard = null;
                        didDrop = false;
                        wasDragging = false;
                    }, 0);
                });

                card.addEventListener('click', event => {
                    if (wasDragging || Date.now() < suppressClickUntil) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                });
            });

            document.querySelectorAll('.rb-card-list').forEach(list => {
                list.addEventListener('dragover', event => {
                    event.preventDefault();
                    list.classList.add('is-over');

                    if (!draggedCard) return;

                    const afterElement = getDragAfterElement(list, event.clientY);
                    if (afterElement == null) {
                        list.appendChild(draggedCard);
                    } else {
                        list.insertBefore(draggedCard, afterElement);
                    }
                });

                list.addEventListener('dragleave', () => {
                    list.classList.remove('is-over');
                });

                list.addEventListener('drop', async event => {
                    event.preventDefault();
                    list.classList.remove('is-over');
                    if (!draggedCard) return;

                    didDrop = true;
                    const cardId = Number(draggedCard.dataset.cardId || 0);
                    const columnId = Number(list.dataset.columnId || 0);
                    const orderedCardIds = Array.from(list.querySelectorAll('.rb-card'))
                        .map(card => Number(card.dataset.cardId || 0))
                        .filter(Boolean);

                    try {
                        const response = await fetch('@Url.Action("MoveCard", "RequirementBoard")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify({ cardId, columnId, orderedCardIds })
                        });

                        if (!response.ok) {
                            window.location.reload();
                        }
                    } catch {
                        window.location.reload();
                    }
                });
            });
        })();
    </script>
}

@section Styles {
    <style>
        :root {
            --boards-page-bg:
                linear-gradient(180deg, rgba(226, 239, 251, .96) 0, rgba(238, 244, 251, .96) 360px, #eef4fb 100%),
                repeating-linear-gradient(90deg, rgba(30, 64, 175, .035) 0 1px, transparent 1px 96px);
        }

        body {
            background: var(--boards-page-bg);
        }

        body:has(main.route-controller-requirementboard.route-action-index),
        body:has(main.route-controller-requirementboard.route-action-index) .v2-shell,
        body:has(main.route-controller-requirementboard.route-action-index) .v2-page,
        main.route-controller-requirementboard.route-action-index {
            background: var(--boards-page-bg) !important;
        }

        main.route-controller-requirementboard.route-action-index {
            min-height: calc(100vh - 54px);
        }

        .boards-page {
            display: grid;
            grid-template-columns: 288px minmax(0, 1fr);
            gap: 30px;
            width: 100%;
            max-width: none;
            margin: 0;
            padding: 22px 0 46px;
            min-height: calc(100vh - 88px);
            color: #172033;
        }

        .boards-sidebar {
            position: sticky;
            top: 18px;
            align-self: start;
            display: grid;
            gap: 20px;
            padding: 18px;
            border: 1px solid rgba(170, 193, 219, .86);
            border-radius: 8px;
            background:
                linear-gradient(180deg, rgba(255, 255, 255, .96), rgba(248, 252, 255, .90)),
                linear-gradient(135deg, rgba(20, 184, 166, .16), rgba(12, 102, 228, .10) 48%, rgba(245, 158, 11, .08));
            box-shadow: 0 24px 52px rgba(28, 44, 72, .14);
            overflow: hidden;
        }

        .boards-sidebar > div,
        .boards-sidebar > nav {
            position: relative;
            z-index: 1;
        }

        .boards-nav {
            display: grid;
            gap: 8px;
        }

        .boards-nav-link,
        .boards-create-summary {
            position: relative;
            display: flex;
            align-items: center;
            gap: 10px;
            min-height: 64px;
            padding: 8px 12px 8px 20px;
            border: 1px solid rgba(191, 211, 235, .72);
            border-radius: 8px;
            color: #243044;
            font-size: .92rem;
            font-weight: 800;
            text-decoration: none;
            background: rgba(255, 255, 255, .72);
            overflow: hidden;
            transition: background .15s ease, color .15s ease, transform .15s ease, border-color .15s ease, box-shadow .15s ease;
        }

        .boards-nav-link::before,
        .boards-create-summary::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 4px;
            background: linear-gradient(180deg, var(--boards-row-accent, #60a5fa), rgba(96, 165, 250, .35));
            opacity: .88;
        }

        .boards-nav-link.dashboard {
            --boards-row-accent: #22c55e;
        }

        .boards-create-summary {
            --boards-row-accent: #f59e0b;
        }

        .boards-nav-link:hover,
        .boards-create-summary:hover {
            background: rgba(239, 246, 255, .92);
            color: #0c66e4;
            transform: translateX(2px);
            border-color: rgba(12, 102, 228, .34);
            box-shadow: 0 12px 22px rgba(12, 102, 228, .08);
        }

        .boards-nav-link.is-active {
            background: linear-gradient(135deg, #dff0ff, #d8fff2);
            color: #075985;
            border-color: rgba(20, 184, 166, .42);
            box-shadow: 0 14px 28px rgba(12, 102, 228, .13), inset 0 0 0 1px rgba(255, 255, 255, .68);
        }

        .boards-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 46px;
            height: 46px;
            flex: 0 0 46px;
            border-radius: 8px;
            background: #e2e8f0;
            color: #334155;
            text-align: center;
            font-size: 1.15rem;
            font-weight: 900;
            line-height: 1;
            border: 1px solid rgba(148, 163, 184, .22);
            box-shadow: 0 10px 18px rgba(15, 23, 42, .08), inset 0 1px 0 rgba(255, 255, 255, .68);
        }

        .boards-icon.board {
            background: linear-gradient(135deg, #dbeafe, #bfdbfe);
            color: #0b63e5;
            font-size: 1.48rem;
            border-color: rgba(59, 130, 246, .26);
            box-shadow: 0 12px 20px rgba(37, 99, 235, .16), inset 0 1px 0 rgba(255, 255, 255, .72);
        }

        .boards-icon.dashboard {
            background: linear-gradient(135deg, #bbf7d0, #dcfce7);
            color: #15803d;
            font-size: 1.42rem;
            border-color: rgba(34, 197, 94, .26);
            box-shadow: 0 12px 20px rgba(22, 163, 74, .14), inset 0 1px 0 rgba(255, 255, 255, .72);
        }

        .boards-icon.create {
            background: linear-gradient(135deg, #fef3c7, #fde68a);
            color: #b45309;
            font-size: 1.72rem;
            border-color: rgba(245, 158, 11, .34);
            box-shadow: 0 12px 20px rgba(245, 158, 11, .15), inset 0 1px 0 rgba(255, 255, 255, .72);
        }

        .boards-sidebar-title {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0 0 10px;
            color: #52657e;
            font-size: .78rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .boards-sidebar-title::after {
            content: "";
            height: 1px;
            flex: 1 1 auto;
            background: linear-gradient(90deg, rgba(100, 116, 139, .24), transparent);
        }

        .boards-group-list {
            display: grid;
            gap: 8px;
        }

        .boards-group-link {
            --boards-row-accent: #6366f1;
            --boards-row-accent-soft: rgba(99, 102, 241, .28);
            --boards-avatar-bg: linear-gradient(135deg, #2563eb, #7c3aed);
            --boards-avatar-shadow: rgba(67, 56, 202, .24);
            position: relative;
            display: grid;
            grid-template-columns: 46px minmax(0, 1fr);
            align-items: center;
            gap: 10px;
            min-height: 64px;
            padding: 8px 10px 8px 20px;
            border: 1px solid rgba(226, 232, 240, .72);
            border-radius: 8px;
            color: #273246;
            font-size: .9rem;
            font-weight: 800;
            text-decoration: none;
            background: rgba(255, 255, 255, .64);
            box-shadow: 0 10px 22px rgba(28, 44, 72, .05);
            overflow: hidden;
            transition: background .15s ease, transform .15s ease, border-color .15s ease, box-shadow .15s ease;
        }

        .boards-group-link::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 4px;
            background: linear-gradient(180deg, var(--boards-row-accent), var(--boards-row-accent-soft));
            opacity: .88;
        }

        .boards-group-link:hover {
            background: #fff;
            border-color: rgba(12, 102, 228, .22);
            box-shadow: 0 16px 28px rgba(28, 44, 72, .10);
            transform: translateX(3px);
        }

        .boards-avatar,
        .boards-online-avatar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            color: #fff;
            font-weight: 900;
        }

        .boards-avatar {
            width: 46px;
            height: 46px;
            border-radius: 8px;
            background: var(--boards-avatar-bg, linear-gradient(135deg, #2563eb, #7c3aed));
            font-size: 1rem;
            box-shadow: 0 12px 22px var(--boards-avatar-shadow, rgba(67, 56, 202, .24));
        }

        .boards-group-link.tone-blue,
        .boards-section.tone-blue {
            --boards-row-accent: #4f46e5;
            --boards-row-accent-soft: rgba(79, 70, 229, .26);
            --boards-avatar-bg: linear-gradient(135deg, #2563eb, #7c3aed);
            --boards-avatar-shadow: rgba(67, 56, 202, .24);
            --boards-section-wash: rgba(79, 70, 229, .055);
            --boards-section-border: rgba(79, 70, 229, .18);
        }

        .boards-group-link.tone-teal,
        .boards-section.tone-teal {
            --boards-row-accent: #14b8a6;
            --boards-row-accent-soft: rgba(20, 184, 166, .28);

@model ProjectTracking.ViewModels.RequirementBoardViewModel

@{
    ViewData["Title"] = "Project Board";
    var currentBoard = Model.CurrentBoard;
    var canCreate = Model.CanCreate;
    var canEdit = Model.CanEdit;
    var canDelete = Model.CanDelete;

    string FileSize(long bytes)
    {
        if (bytes <= 0) return "-";
        if (bytes >= 1048576) return $"{bytes / 1048576.0:N1} MB";
        return $"{bytes / 1024.0:N0} KB";
    }

    string PersonName(ProjectTracking.Models.RequirementCard card)
    {
        if (!string.IsNullOrWhiteSpace(card.CreatedByEmployee?.EmpName)) return card.CreatedByEmployee.EmpName;
        if (!string.IsNullOrWhiteSpace(card.CreatedByUser?.Username)) return card.CreatedByUser.Username;
        return "ไม่ระบุผู้สร้าง";
    }

    bool IsImage(ProjectTracking.Models.RequirementCardAttachment file)
    {
        return (file.ContentType ?? "").StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    }

    string ThaiDateValue(DateTime? date)
    {
        if (!date.HasValue) return "";
        var value = date.Value;
        return $"{value:dd/MM/}{value.Year + 543}";
    }

    List<ProjectTracking.Models.RequirementBoardLabel> ActiveCardLabels(ProjectTracking.Models.RequirementCard card)
    {
        return card.Labels
            .Where(x => x.Label != null && x.Label.IsActive)
            .OrderBy(x => x.Label!.SortOrder)
            .ThenBy(x => x.Label!.LabelName)
            .Select(x => x.Label!)
            .ToList();
    }

    var labelOptions = Model.Labels
        .Where(x => x.IsActive)
        .OrderBy(x => x.SortOrder)
        .ThenBy(x => x.LabelName)
        .ToList();
    var labelOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        labelOptions.Select(x => new
        {
            labelId = x.LabelId,
            labelName = x.LabelName,
            colorHex = x.ColorHex
        }));
    var allCards = Model.Columns.SelectMany(x => x.Cards).OrderByDescending(x => x.UpdatedAt).ToList();
    var visibleOnlineUsers = Model.OnlineUsers.Take(5).ToList();
    var hiddenOnlineCount = Math.Max(0, Model.OnlineUsers.Count - visibleOnlineUsers.Count);
    string BoardCoverBackground(string? value)
    {
        return (value ?? "").Trim().ToLowerInvariant() switch
        {
            "g:ocean" => "linear-gradient(135deg, #14b8a6, #22d3ee)",
            "g:sky" => "linear-gradient(135deg, #2563eb, #38bdf8)",
            "g:navy" => "linear-gradient(135deg, #0f4aa5, #172554)",
            "g:berry" => "linear-gradient(135deg, #db2777, #7c3aed)",
            "g:sunset" => "linear-gradient(135deg, #f97316, #facc15)",
            "g:forest" => "linear-gradient(135deg, #16a34a, #064e3b)",
            "g:violet" => "linear-gradient(135deg, #7c3aed, #ec4899)",
            "g:flame" => "linear-gradient(135deg, #ef4444, #f97316)",
            "g:lagoon" => "linear-gradient(135deg, #0891b2, #22c55e)",
            "g:steel" => "linear-gradient(135deg, #64748b, #cbd5e1)",
            "g:midnight" => "linear-gradient(135deg, #020617, #334155)",
            "g:gold" => "linear-gradient(135deg, #f59e0b, #b45309)",
            var hex when hex.StartsWith("#", StringComparison.Ordinal) && hex.Length == 7
                => $"linear-gradient(135deg, color-mix(in srgb, {hex} 72%, white), {hex})",
            _ => "linear-gradient(135deg, #73acd0, #9da8df 46%, #f0aebe)"
        };
    }

    var boardCover = BoardCoverBackground(currentBoard?.CoverColor);
    var boardImage = string.IsNullOrWhiteSpace(currentBoard?.CoverImagePath) ? "" : Url.Content(currentBoard.CoverImagePath);
    var boardPageStyle = string.IsNullOrWhiteSpace(boardImage)
        ? $"--rb-board-cover: {boardCover};"
        : $"--rb-board-cover: {boardCover}; --rb-board-image: url('{boardImage}');";
}


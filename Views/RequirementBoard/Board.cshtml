                                    <div class="rb-label-action-row">
                                        <div class="rb-selected-labels" data-selected-labels>
                                            @foreach (var label in cardLabels)
                                            {
                                                <span class="rb-card-label"
                                                      style="--rb-label-color: @label.ColorHex;">@label.LabelName</span>
                                            }
                                        </div>
                                        @if (canEdit)
                                        {
                                            <button class="rb-label-picker-button" type="button" data-open-label-picker title="เพิ่มป้าย" aria-label="เพิ่มป้าย"><span aria-hidden="true">+</span></button>
                                        }
                                    </div>
                                    <div data-label-hidden>
                                        @foreach (var label in cardLabels)
                                        {
                                            <input type="hidden" name="labelIds" value="@label.LabelId" />
                                        }
                                    </div>
                                    <div class="rb-label-popover" data-label-picker hidden>
                                        <div class="rb-label-picker-head">
                                            <span>ป้าย</span>
                                            <button class="rb-label-picker-close" type="button" data-close-label-picker aria-label="ปิด">×</button>
                                        </div>
                                        <input class="form-control rb-label-search" type="search" placeholder="ค้นหาป้าย..." data-label-search />
                                        <div class="rb-label-list" data-label-list>
                                            @foreach (var label in labelOptions)
                                            {
                                                <label class="rb-label-option" data-label-option data-label-text="@label.LabelName">
                                                    <input type="checkbox"
                                                           value="@label.LabelId"
                                                           data-label-checkbox
                                                           @(cardLabels.Any(x => x.LabelId == label.LabelId) ? "checked" : "") />
                                                    <span class="rb-label-option-text"
                                                          style="--rb-label-color: @label.ColorHex;">@label.LabelName</span>
                                                </label>
                                            }
                                        </div>
                                        @if (canEdit)
                                        {
                                            <details class="rb-label-create">
                                                <summary>สร้างป้ายใหม่</summary>
                                                <div class="rb-label-create-form" data-label-create-form>
                                                    <input class="rb-input" name="newLabelName" type="text" maxlength="100" placeholder="หัวข้อป้าย" data-label-name />
                                                    <input type="hidden" value="#52cc99" data-label-color-value />
                                                    <div class="rb-label-color-grid" data-label-colors>
                                                        @foreach (var color in new[] { "#b7f3db", "#f8ed82", "#ffe2a8", "#ffd0cc", "#ead2ff", "#52cc99", "#f5d328", "#f59e0b", "#f87171", "#c77af2", "#1f8f67", "#a57900", "#c65a00", "#d2352d", "#9a49c8", "#c7ddff", "#bdeafa", "#d7f2a8", "#f9c5e5", "#d1d5db", "#60a5fa", "#67c1d8", "#8cc63f", "#db69ad", "#8e939c", "#2563eb", "#228399", "#4f7d20", "#ad4b84", "#6b7280" })
                                                        {
                                                            <button class="rb-label-color @(color == "#52cc99" ? "is-selected" : "")"
                                                                    type="button"
                                                                    data-label-color="@color"
                                                                    style="--rb-label-color: @color;"
                                                                    aria-label="เลือกสี @color"></button>
                                                        }
                                                    </div>
                                                    <button class="rb-btn" type="button" data-create-label>สร้างป้าย</button>
                                                </div>
                                            </details>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            @{
                                var phaseDrafts = card.PhaseItems
                                    .OrderBy(x => x.PhaseSort == 0 ? int.MaxValue : x.PhaseSort)
                                    .ThenBy(x => x.PhaseOrder)
                                    .ThenBy(x => x.PeriodOrder)
                                    .ThenBy(x => x.ItemId)
                                    .ToList();
                                var phaseDraftRows = Math.Max(phaseDrafts.Count, 1);
                            }
                            <div class="rb-phase-draft">
                                <div class="rb-phase-draft-head">
                                    <div class="rb-phase-draft-title">บันทึกงวดงาน</div>
                                </div>
                                <div class="rb-phase-draft-list" data-phase-list>
                                    @for (var i = 0; i < phaseDraftRows; i++)
                                    {
                                        var phaseItem = i < phaseDrafts.Count ? phaseDrafts[i] : null;
                                        <div class="rb-phase-row" data-phase-row>
                                            <input type="hidden" name="phaseItems[@i].ItemId" value="@(phaseItem?.ItemId)" data-phase-field="ItemId" />
                                            <div>
                                                <label>ส่วนที่</label>
                                                <input class="form-control" type="number" min="1" name="phaseItems[@i].PhaseOrder" value="@(phaseItem?.PhaseOrder ?? 1)" data-phase-field="PhaseOrder" />
                                            </div>
                                            <div>
                                                <label>งวดที่</label>
                                                <input class="form-control" type="number" min="1" name="phaseItems[@i].PeriodOrder" value="@(phaseItem?.PeriodOrder ?? 1)" data-phase-field="PeriodOrder" />
                                            </div>
                                            <input type="hidden" name="phaseItems[@i].PhaseType" value="@(phaseItem?.PhaseType ?? "MAIN")" data-phase-field="PhaseType" />
                                            <input type="hidden" name="phaseItems[@i].PhaseStatus" value="@(phaseItem?.PhaseStatus ?? "วางแผน")" data-phase-field="PhaseStatus" />
                                            <div class="rb-phase-name-field">
                                                <label>รายละเอียดงาน</label>
                                                <textarea class="form-control" maxlength="500" name="phaseItems[@i].PhaseName" data-phase-field="PhaseName" placeholder="เพิ่มรายละเอียดงาน">@(phaseItem?.PhaseName)</textarea>
                                            </div>
                                            <button class="rb-phase-remove" type="button" data-remove-phase-row title="ลบแถว" aria-label="ลบแถว">&times;</button>
                                            <div class="rb-phase-date-grid">
                                                <div>
                                                    <label>วันที่เริ่ม แผนงาน</label>
                                                    <div class="rb-date-input-wrap">
                                                        <input class="form-control" type="text" name="phaseItems[@i].PlanStart" value="@ThaiDateValue(phaseItem?.PlanStart)" data-phase-field="PlanStart" data-rb-date placeholder="วัน/เดือน/พ.ศ." />
                                                        <button class="rb-date-button" type="button" data-rb-date-button aria-label="เลือกวันที่">📅</button>
                                                        <input class="rb-date-native" type="date" tabindex="-1" aria-hidden="true" data-rb-native-date />
                                                    </div>
                                                </div>
                                                <div>
                                                    <label>วันที่สิ้นสุด แผนงาน</label>
                                                    <div class="rb-date-input-wrap">
                                                        <input class="form-control" type="text" name="phaseItems[@i].PlanEnd" value="@ThaiDateValue(phaseItem?.PlanEnd)" data-phase-field="PlanEnd" data-rb-date placeholder="วัน/เดือน/พ.ศ." />
                                                        <button class="rb-date-button" type="button" data-rb-date-button aria-label="เลือกวันที่">📅</button>
                                                        <input class="rb-date-native" type="date" tabindex="-1" aria-hidden="true" data-rb-native-date />
                                                    </div>
                                                </div>
                                                <div>
                                                    <label>วันที่กำหนดส่งงวดงาน</label>
                                                    <div class="rb-date-input-wrap">
                                                        <input class="form-control" type="text" name="phaseItems[@i].PeriodEndDate" value="@ThaiDateValue(phaseItem?.PeriodEndDate)" data-phase-field="PeriodEndDate" data-rb-date placeholder="วัน/เดือน/พ.ศ." />
                                                        <button class="rb-date-button" type="button" data-rb-date-button aria-label="เลือกวันที่">📅</button>
                                                        <input class="rb-date-native" type="date" tabindex="-1" aria-hidden="true" data-rb-native-date />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="rb-phase-add-footer">
                                    <button class="rb-btn"
                                            type="button"
                                            data-add-phase-row
                                            aria-label="เพิ่มแถว">
                                        <span class="rb-plus-icon" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="rb-file-upload-grid">
                                <div class="rb-file-upload-card">
                                    <label class="rb-field-label mb-0">รูปพื้นหลังการ์ด</label>
                                    @if (!string.IsNullOrWhiteSpace(card.CoverImageName))
                                    {
                                        <div class="rb-file-info">รูปปัจจุบัน: @card.CoverImageName</div>
                                    }
                                    <input class="form-control" type="file" name="coverImage" accept="image/*" data-paste-image-upload data-paste-upload-scroll="x" />
                                </div>
                                <div class="rb-file-upload-card">
                                    <label class="rb-field-label mb-0">เพิ่มไฟล์แนบ</label>
                                    <div class="rb-file-info">เลือกได้หลายไฟล์</div>
                                    <input class="form-control" type="file" name="files" multiple data-paste-image-upload data-paste-upload-scroll="x" />
                                    <div class="rb-attachment-inline" data-attachment-region>
                                        <h3 class="rb-field-label mb-0" data-attachment-heading data-attachment-count="@card.Attachments.Count">ไฟล์แนบ (@card.Attachments.Count)</h3>
                                        <div data-attachment-list>
                                            @if (card.Attachments.Count == 0)
                                            {
                                                <div class="alert alert-light border" data-attachment-empty>ยังไม่มีไฟล์แนบ</div>
                                            }
                                            else
                                            {
                                                <div class="rb-file-list">
                                                    @foreach (var file in card.Attachments.OrderByDescending(x => x.UploadedAt))
                                                    {
                                                        <div class="rb-file-row">
                                                            @if (IsImage(file))
                                                            {
                                                                <a class="rb-file-thumb-link"
                                                                   asp-action="PreviewAttachment"
                                                                   asp-route-id="@file.AttachmentId"
                                                                   target="_blank"
                                                                   rel="noopener">
                                                                    <img class="rb-file-thumb" src="@file.FilePath" alt="@file.FileName" />
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <a class="rb-file-thumb-link rb-file-thumb"
                                                                   asp-action="PreviewAttachment"
                                                                   asp-route-id="@file.AttachmentId"
                                                                   target="_blank"
                                                                   rel="noopener">FILE</a>
                                                            }
                                                            <div>
                                                                <div class="rb-file-name">@file.FileName</div>
                                                                <div class="rb-file-info">@FileSize(file.FileSize) · @file.UploadedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                                            </div>
                                                            <div class="rb-file-actions">
                                                                <a class="rb-btn secondary"
                                                                   asp-action="PreviewAttachment"
                                                                   asp-route-id="@file.AttachmentId"
                                                                   target="_blank"
                                                                   rel="noopener">Preview</a>
                                                                <a class="rb-btn secondary" asp-action="DownloadAttachment" asp-route-id="@file.AttachmentId">ดาวน์โหลด</a>
                                                                @if (canDelete)
                                                                {
                                                                    <button class="rb-btn danger"
                                                                            type="submit"
                                                                            form="deleteAttachmentForm-@file.AttachmentId">
                                                                        ลบ
                                                                    </button>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 rb-modal-actions">
                            @if (canDelete)
                            {
                                <button class="rb-btn danger"
                                        type="submit"
                                        form="archiveCardForm-@card.CardId">
                                    ลบการ์ดออกจากบอร์ด
                                </button>
                            }
                            <div class="rb-modal-actions-main">
                            @if (canEdit)
                            {
                                <button class="rb-btn" type="submit">บันทึก</button>
                            }
                            <button class="rb-btn secondary" type="button" data-bs-dismiss="modal">ปิด</button>
                            <span class="rb-save-status" data-card-save-status aria-live="polite"></span>
                            </div>
                        </div>
                    </form>

                    @if (canDelete)
                    {
                        foreach (var file in card.Attachments)
                        {
                            <form id="deleteAttachmentForm-@file.AttachmentId" asp-action="DeleteAttachment" method="post" onsubmit="return confirm('ลบไฟล์แนบนี้หรือไม่?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="attachmentId" value="@file.AttachmentId" />
                            </form>
                        }
                    }

                    @if (canDelete)
                    {
                        <form id="archiveCardForm-@card.CardId" asp-action="ArchiveCard" method="post" onsubmit="return confirm('ลบการ์ดนี้ออกจากบอร์ดหรือไม่?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="cardId" value="@card.CardId" />
                        </form>
                    }

                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/paste-image-upload.js" asp-append-version="true"></script>
    <script>
        (() => {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const createLabelUrl = '@Url.Action("CreateLabel", "RequirementBoard")';
            const updateCardLabelsUrl = '@Url.Action("UpdateCardLabels", "RequirementBoard")';
            const deleteAttachmentUrl = '@Url.Action("DeleteAttachment", "RequirementBoard")';
            const canDeleteAttachments = @canDelete.ToString().ToLowerInvariant();
            const boardLabels = @Html.Raw(labelOptionsJson);
            const openCardId = Number('@(ViewBag.OpenCardId ?? 0)');
            const searchInput = document.getElementById('requirementBoardSearch');
            const searchBox = searchInput?.closest('.rb-search');
            const clearSearchButton = searchBox?.querySelector('.rb-search-clear');
            let draggedCard = null;
            let draggedColumn = null;
            let dragImage = null;
            let originalList = null;
            let originalNextCard = null;
            let originalNextColumn = null;
            let didColumnDrop = false;
            let didDrop = false;
            let wasDragging = false;
            let suppressClickUntil = 0;
            const descriptionAllowedFontSizes = new Set(['8', '9', '10', '11', '12', '14', '16', '18', '20', '22', '24', '26', '28', '36', '48', '72']);
            const descriptionThemeColors = [
                '#000000', '#404040', '#808080', '#1f4e79', '#0f6b7d', '#c55a11', '#196b24', '#0f9ed5', '#a02b93', '#4ea72e',
                '#ffffff', '#d9d9d9', '#bfbfbf', '#d9eaf7', '#c7eaf3', '#f7c7ac', '#c6efce', '#b7e3f3', '#e6b8df', '#d8f0c8',
                '#f2f2f2', '#a6a6a6', '#7f7f7f', '#9dc3e6', '#9bd7ea', '#f4b183', '#63d978', '#6dc8e8', '#d86ecc', '#a9d98f',
                '#d9d9d9', '#808080', '#595959', '#5b9bd5', '#2f9fc3', '#ed7d31', '#00b050', '#00b0f0', '#c000a0', '#70ad47',
                '#bfbfbf', '#595959', '#404040', '#1f4e79', '#164f63', '#9e480e', '#0b4016', '#0b6984', '#70305f', '#375623'
            ];
            const descriptionStandardColors = ['#c00000', '#ff0000', '#ffc000', '#ffff00', '#92d050', '#00b050', '#00b0f0', '#0070c0', '#002060', '#7030a0'];
            const descriptionAllowedColors = new Set(['#0f172a', ...descriptionThemeColors, ...descriptionStandardColors].map(color => color.toLowerCase()));

            function normalizeText(value) {
                return (value || '').toString().trim().toLowerCase();
            }

            function updateColumnCounts() {
                document.querySelectorAll('.rb-column').forEach(column => {
                    const visibleCount = [...column.querySelectorAll('.rb-card')]
                        .filter(card => card.style.display !== 'none')
                        .length;
                    const count = column.querySelector('.rb-column-count');
                    if (count) count.textContent = visibleCount;
                });
            }

            function filterCards() {
                const keyword = normalizeText(searchInput?.value);
                searchBox?.classList.toggle('has-value', Boolean(keyword));

                document.querySelectorAll('.rb-card').forEach(card => {
                    const text = normalizeText(card.dataset.searchText);
                    card.style.display = !keyword || text.includes(keyword) ? '' : 'none';
                });

                updateColumnCounts();
            }

            searchInput?.addEventListener('input', filterCards);
            clearSearchButton?.addEventListener('click', () => {
                if (!searchInput) return;
                searchInput.value = '';
                searchInput.focus();
                filterCards();
            });

            function setSaveStatus(status, message, type) {
                if (!status) return;

                status.textContent = message;
                status.classList.remove('is-success', 'is-error', 'is-visible');
                status.classList.add(type === 'error' ? 'is-error' : 'is-success', 'is-visible');

                window.clearTimeout(status.dataset.hideTimer);
                status.dataset.hideTimer = window.setTimeout(() => {
                    status.classList.remove('is-visible');
                }, 3600);
            }

            function showBoardError(message) {
                if (window.ProjectTrackingSwal) {
                    window.ProjectTrackingSwal.fire({
                        icon: 'error',
                        title: 'ทำรายการไม่สำเร็จ',
                        text: message || 'กรุณาลองใหม่อีกครั้ง',
                        confirmButtonText: 'ตกลง'
                    });
                }
            }

            function normalizeHex(value) {
                const color = (value || '#22c7b8').toString().trim();
                return color.startsWith('#') ? color : `#${color}`;
            }

            function normalizeLabel(label) {
                return {
                    labelId: label?.labelId ?? label?.LabelId,
                    labelName: label?.labelName ?? label?.LabelName ?? '',
                    colorHex: label?.colorHex ?? label?.ColorHex ?? '#22c7b8'
                };
            }

            function labelTextColor(hex) {
                const color = normalizeHex(hex).replace('#', '');
                if (color.length !== 6) return '#10213a';

                const r = parseInt(color.slice(0, 2), 16);
                const g = parseInt(color.slice(2, 4), 16);
                const b = parseInt(color.slice(4, 6), 16);
                const brightness = (r * 299 + g * 587 + b * 114) / 1000;
                return brightness < 132 ? '#fff' : '#10213a';
            }

            function findLabel(labelId) {
                return boardLabels.find(label => Number(normalizeLabel(label).labelId) === Number(labelId));
            }

            function createLabelChip(label, compact = false, boardChip = false) {
                const chip = document.createElement('span');
                chip.className = boardChip ? 'rb-card-label is-board-chip' : 'rb-card-label';
                chip.style.setProperty('--rb-label-color', normalizeHex(label.colorHex));
                chip.style.setProperty('--rb-label-text', labelTextColor(label.colorHex));
                if (boardChip) {
                    chip.style.setProperty('font-size', '.72rem', 'important');
                    chip.style.setProperty('font-weight', '500', 'important');
                    chip.style.setProperty('line-height', '1.24', 'important');
                }
                chip.title = label.labelName;
                chip.textContent = compact ? '' : label.labelName;
                return chip;
            }

            function renderLabelCollection(container, labels, compact = false, showEmpty = true) {
                if (!container) return;
                container.replaceChildren();

                if (!labels || labels.length === 0) {
                    if (!compact && showEmpty) {
                        const empty = document.createElement('span');
                        empty.className = 'rb-label-empty';
                        empty.textContent = 'ยังไม่มีป้าย';
                        container.appendChild(empty);
                    }
                    return;
                }

                const boardChip = container.matches('[data-card-labels]') && Boolean(container.closest('.rb-card'));
                labels.forEach(label => container.appendChild(createLabelChip(label, compact, boardChip)));
            }

            function selectedLabelsFor(control) {
                return [...control.querySelectorAll('[data-label-checkbox]:checked')]
                    .map(input => findLabel(input.value))
                    .filter(Boolean);
            }

            function syncLabelControl(control) {
                if (!control) return;

                const labels = selectedLabelsFor(control);
                renderLabelCollection(control.querySelector('[data-selected-labels]'), labels);

                const hiddenBox = control.querySelector('[data-label-hidden]');
                if (hiddenBox) {
                    hiddenBox.replaceChildren();
                    labels.forEach(label => {
                        const hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = 'labelIds';
                        hidden.value = label.labelId;
                        hiddenBox.appendChild(hidden);
                    });
                }
            }

            function sanitizeDescriptionHtml(value) {
                const text = (value || '').trim();
                if (!text) {
                    return '';
                }

                const looksLikeHtml = /<\/?[a-z][\s\S]*>/i.test(text);
                if (!looksLikeHtml) {
                    return text
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#39;')
                        .replace(/\r?\n/g, '<br>');
                }

                const template = document.createElement('template');
                template.innerHTML = text;
                const allowedTags = new Set(['A', 'B', 'BR', 'DIV', 'EM', 'FONT', 'H3', 'I', 'LI', 'OL', 'P', 'SPAN', 'STRONG', 'U', 'UL']);

                function normalizeFontSizeStyle(value) {
                    const match = (value || '').match(/font-size\s*:\s*(\d+(?:\.\d+)?)px/i);
                    if (!match) return '';

                    const size = String(Math.round(Number(match[1])));
                    return descriptionAllowedFontSizes.has(size) ? size : '';
                }

                function rgbToHex(red, green, blue) {
                    return [red, green, blue]
                        .map(value => Math.max(0, Math.min(255, Number(value) || 0)).toString(16).padStart(2, '0'))
                        .join('');
                }

                function normalizeDescriptionColor(value) {
                    const raw = (value || '').trim().toLowerCase();
                    const hex = raw.match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i);
                    if (hex) {
                        const normalized = hex[1].length === 3
                            ? `#${hex[1].split('').map(char => char + char).join('')}`
                            : `#${hex[1]}`;
                        return descriptionAllowedColors.has(normalized) ? normalized : '';
                    }

                    const rgb = raw.match(/^rgba?\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})/i);
                    if (rgb) {
                        const normalized = `#${rgbToHex(rgb[1], rgb[2], rgb[3])}`;
                        return descriptionAllowedColors.has(normalized) ? normalized : '';
                    }

                    return '';
                }

                function normalizeFontColorStyle(value) {
                    const match = (value || '').match(/(?:^|;)\s*color\s*:\s*([^;]+)/i);
                    return match ? normalizeDescriptionColor(match[1]) : '';
                }

                template.content.querySelectorAll('*').forEach(node => {
                    if (!allowedTags.has(node.tagName)) {
                        node.replaceWith(document.createTextNode(node.textContent || ''));
                        return;
                    }

                    [...node.attributes].forEach(attribute => {
                        const name = attribute.name.toLowerCase();
                        if (node.tagName === 'A' && name === 'href') {
                            const href = attribute.value.trim();
                            if (/^(https?:|mailto:|tel:|\/)/i.test(href)) {
                                node.setAttribute('target', '_blank');
                                node.setAttribute('rel', 'noopener noreferrer');
                                return;
                            }
                        }

                        if (node.tagName === 'FONT' && ['face', 'size'].includes(name)) {
                            if (name === 'face' && /^(Prompt|Sarabun|Tahoma|Arial)$/i.test(attribute.value.trim())) return;
                            if (name === 'size' && /^[2-5]$/.test(attribute.value.trim())) return;
                        }

                        if (node.tagName === 'FONT' && name === 'color') {
                            if (normalizeDescriptionColor(attribute.value)) return;
                        }

                        if (node.tagName === 'SPAN' && name === 'style') {
                            const size = normalizeFontSizeStyle(attribute.value);
                            const color = normalizeFontColorStyle(attribute.value);
                            const styles = [];
                            if (size) styles.push(`font-size: ${size}px;`);
                            if (color) styles.push(`color: ${color};`);
                            if (styles.length > 0) {
                                node.setAttribute('style', styles.join(' '));
                                return;
                            }
                        }

                        if (!['target', 'rel'].includes(name)) {
                            node.removeAttribute(attribute.name);
                        }
                    });
                });

                return template.innerHTML;
            }

            function renderDescriptionPreview(value) {
                const html = sanitizeDescriptionHtml(value);
                return html || '<span class="rb-description-placeholder">เพิ่มคำอธิบายของการ์ด...</span>';
            }

            function openDescriptionEditor(control) {
                if (!control) return;

                const editor = control.querySelector('[data-description-editor]');
                const preview = control.querySelector('[data-description-preview]');
                const rich = editor?.querySelector('[data-description-rich]');
                if (!editor) return;

                if (preview) preview.hidden = true;
                editor.hidden = false;
                rich?.focus();
                syncDescriptionToolbarState(rich);
            }

            function closeDescriptionEditor(control) {
                if (!control) return;

                const editor = control.querySelector('[data-description-editor]');
                const preview = control.querySelector('[data-description-preview]');

                if (editor) editor.hidden = true;
                if (preview) preview.hidden = false;
            }

            function descriptionPlainText(html) {
                const container = document.createElement('div');
                container.innerHTML = sanitizeDescriptionHtml(html);
                return (container.textContent || '').trim();
            }

            function escapeHtmlAttribute(value) {
                return (value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }

            function escapeHtmlText(value) {
                return (value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }

            function normalizeDescriptionLinkUrl(value) {
                const raw = (value || '').trim();
                if (!raw) return '';
                if (/^(https?:|mailto:|tel:|\/)/i.test(raw)) return raw;
                if (/^[a-z][a-z0-9+.-]*:/i.test(raw)) return '';
                return `https://${raw}`;
            }

            function descriptionRangeHost(range) {
                if (!range) return null;
                const node = range.commonAncestorContainer;
                const element = node.nodeType === Node.ELEMENT_NODE ? node : node.parentElement;
                return element?.closest?.('[data-description-rich]') || null;
            }

            function saveDescriptionSelection(rich) {
                if (!rich) return;
                const selection = window.getSelection();
                if (!selection || selection.rangeCount === 0) return;

                const range = selection.getRangeAt(0);
                if (descriptionRangeHost(range) !== rich) return;
                rich._descriptionSavedRange = range.cloneRange();
            }

            function restoreDescriptionSelection(rich) {
                if (!rich || !rich._descriptionSavedRange) return;
                const selection = window.getSelection();
                if (!selection) return;

                selection.removeAllRanges();
                selection.addRange(rich._descriptionSavedRange);
            }

            function descriptionQueryCommand(command) {
                if (command === 'bold') return 'bold';
                if (command === 'italic') return 'italic';
                if (command === 'underline') return 'underline';
                if (command === 'bullet') return 'insertUnorderedList';
                return '';
            }

            function syncDescriptionToolbarState(rich) {
                if (!rich) return;

                const editor = rich.closest('[data-description-editor]');
                if (!editor) return;

                const selection = window.getSelection();
                const hasSelectionInRich = Boolean(
                    selection &&
                    selection.rangeCount > 0 &&
                    descriptionRangeHost(selection.getRangeAt(0)) === rich
                );

                editor.querySelectorAll('[data-description-command]').forEach(button => {
                    const queryCommand = descriptionQueryCommand(button.dataset.descriptionCommand);
                    let isActive = false;

                    if (queryCommand && hasSelectionInRich) {
                        try {
                            isActive = document.queryCommandState(queryCommand);
                        } catch {
                            isActive = false;
                        }
                    }

                    button.classList.toggle('is-active', isActive);
                    if (queryCommand) {
                        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                    } else {
                        button.removeAttribute('aria-pressed');
                    }
                });
            }

            function syncDescriptionFromRich(control) {
                const rich = control?.querySelector('[data-description-rich]');
                const hidden = control?.querySelector('textarea[name="detail"]');
                if (!rich || !hidden) return;

                const html = sanitizeDescriptionHtml(rich.innerHTML);
                hidden.value = descriptionPlainText(html) ? html : '';
                syncDescriptionPreview(control, hidden.value);
                syncDescriptionToolbarState(rich);
            }

            function syncDescriptionEditors(root = document) {
                root.querySelectorAll('[data-description-control]').forEach(syncDescriptionFromRich);
            }

            function initDescriptionEditors(root = document) {
                root.querySelectorAll('[data-description-control]').forEach(control => {
                    const hidden = control.querySelector('textarea[name="detail"]');
                    const rich = control.querySelector('[data-description-rich]');
                    if (!hidden || !rich || rich.dataset.descriptionReady === '1') return;

                    rich.innerHTML = sanitizeDescriptionHtml(hidden.value);
                    rich.dataset.descriptionReady = '1';
                    syncDescriptionPreview(control, hidden.value);
                    syncDescriptionToolbarState(rich);
                });
            }

            function applyDescriptionFontSize(option) {
                const editor = option.closest('[data-description-editor]');
                const rich = editor?.querySelector('[data-description-rich]');
                const size = (option.dataset.descriptionFontSize || '').trim();
                if (!rich || !descriptionAllowedFontSizes.has(size)) return;

                rich.focus();
                restoreDescriptionSelection(rich);
                document.execCommand('fontSize', false, '7');

                rich.querySelectorAll('font[size="7"]').forEach(font => {
                    const span = document.createElement('span');
                    span.style.fontSize = `${size}px`;
                    span.innerHTML = font.innerHTML;
                    font.replaceWith(span);
                });

                editor.querySelector('[data-description-font-size-label]').textContent = size;
                editor.querySelectorAll('[data-description-font-size]').forEach(button => {
                    button.classList.toggle('is-selected', button.dataset.descriptionFontSize === size);
                });
                option.closest('[data-description-font-size-menu]')?.setAttribute('hidden', '');
                syncDescriptionFromRich(editor.closest('[data-description-control]'));
                saveDescriptionSelection(rich);
                syncDescriptionToolbarState(rich);
            }

            function renderDescriptionColorMenu(menu) {
                if (!menu || menu.dataset.ready === '1') return;
                menu.dataset.ready = '1';

                function addColorButton(container, color, label) {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'rb-description-color-option';
                    button.dataset.descriptionColor = color;
                    button.style.setProperty('--rb-description-swatch', color);
                    button.title = label || color;
                    button.setAttribute('aria-label', label || color);
                    container.appendChild(button);
                }

                const auto = document.createElement('button');
                auto.type = 'button';
                auto.className = 'rb-description-color-auto';
                auto.dataset.descriptionColor = '#0f172a';
                auto.textContent = 'Automatic';
                menu.appendChild(auto);

                const themeLabel = document.createElement('div');
                themeLabel.className = 'rb-description-color-label';
                themeLabel.textContent = 'Theme Colors';
                menu.appendChild(themeLabel);

                const themeGrid = document.createElement('div');
                themeGrid.className = 'rb-description-color-grid';
                descriptionThemeColors.forEach(color => addColorButton(themeGrid, color));
                menu.appendChild(themeGrid);

                const standardLabel = document.createElement('div');
                standardLabel.className = 'rb-description-color-label';
                standardLabel.textContent = 'Standard Colors';
                menu.appendChild(standardLabel);

                const standardGrid = document.createElement('div');
                standardGrid.className = 'rb-description-color-grid';
                descriptionStandardColors.forEach(color => addColorButton(standardGrid, color));
                menu.appendChild(standardGrid);
            }

            function closeDescriptionColorMenus(exceptMenu = null) {
                document.querySelectorAll('[data-description-color-menu]').forEach(menu => {
                    if (menu !== exceptMenu) menu.hidden = true;
                });
            }

            function closeDescriptionFontSizeMenus(exceptMenu = null) {
                document.querySelectorAll('[data-description-font-size-menu]').forEach(menu => {
                    if (menu !== exceptMenu) menu.hidden = true;
                });
            }

            function closeLabelPickers(exceptPicker = null) {
                document.querySelectorAll('[data-label-picker]').forEach(picker => {
                    if (picker !== exceptPicker) picker.hidden = true;
                });
            }

            function applyDescriptionFontColor(button) {
                const color = (button.dataset.descriptionColor || '').trim().toLowerCase();
                const editor = button.closest('[data-description-editor]');
                const rich = editor?.querySelector('[data-description-rich]');
                if (!rich || !descriptionAllowedColors.has(color)) return;

                rich.focus();
                restoreDescriptionSelection(rich);
                document.execCommand('foreColor', false, color);

                rich.querySelectorAll('font[color]').forEach(font => {
                    const span = document.createElement('span');
                    span.style.color = color;
                    span.innerHTML = font.innerHTML;
                    font.replaceWith(span);
                });

                const colorButton = editor.querySelector('[data-description-color-toggle]');
                colorButton?.style.setProperty('--rb-description-color', color);
                button.closest('[data-description-color-menu]')?.setAttribute('hidden', '');
                syncDescriptionFromRich(editor.closest('[data-description-control]'));
                saveDescriptionSelection(rich);
                syncDescriptionToolbarState(rich);
            }

            function runDescriptionCommand(button) {
                const editor = button.closest('[data-description-editor]');
                const rich = editor?.querySelector('[data-description-rich]');
                const command = button.dataset.descriptionCommand;
                if (!rich || !command) return;

                rich.focus();

                if (command === 'bold') {
                    document.execCommand('bold', false);
                    syncDescriptionFromRich(editor.closest('[data-description-control]'));
                    syncDescriptionToolbarState(rich);
                    return;
                }

                if (command === 'italic') {
                    document.execCommand('italic', false);
                    syncDescriptionFromRich(editor.closest('[data-description-control]'));
                    syncDescriptionToolbarState(rich);
                    return;
                }

                if (command === 'underline') {
                    document.execCommand('underline', false);
                    syncDescriptionFromRich(editor.closest('[data-description-control]'));
                    syncDescriptionToolbarState(rich);
                    return;
                }

                if (command === 'bullet') {
                    document.execCommand('insertUnorderedList', false);
                    syncDescriptionFromRich(editor.closest('[data-description-control]'));
                    syncDescriptionToolbarState(rich);
                    return;
                }

                if (command === 'link') {
                    const selection = window.getSelection();
                    const selected = (selection?.toString() || '').trim();
                    saveDescriptionSelection(rich);
                    const url = normalizeDescriptionLinkUrl(window.prompt('ใส่ URL') || '');
                    if (!url) {
                        rich.focus();
                        return;
                    }

                    const linkText = (window.prompt('ใส่ชื่อลิงก์', selected || 'ข้อความลิงก์') || '').trim();
                    if (!linkText) {
                        rich.focus();
                        return;
                    }

                    rich.focus();
                    restoreDescriptionSelection(rich);
                    document.execCommand(
                        'insertHTML',
                        false,
                        `<a href="${escapeHtmlAttribute(url)}" target="_blank" rel="noopener noreferrer">${escapeHtmlText(linkText)}</a>`
                    );
                    syncDescriptionFromRich(editor.closest('[data-description-control]'));
                    saveDescriptionSelection(rich);
                    syncDescriptionToolbarState(rich);
                    return;
                }
            }

            function syncDescriptionPreview(control, value) {
                const preview = control?.querySelector('[data-description-preview]');
                if (!preview) return;

                preview.innerHTML = renderDescriptionPreview(value);
            }

            async function saveCardLabels(control) {
                if (!control) return;

                const form = control.closest('[data-card-update-form]');
                const cardId = form?.dataset.cardId || form?.querySelector('[name="cardId"]')?.value;
                if (!cardId) return;

                if (!window.confirm('บันทึกการแก้ไขป้ายกำกับของการ์ดนี้หรือไม่?')) return;

                const labels = selectedLabelsFor(control);
                const body = new FormData();
                body.append('__RequestVerificationToken', token);
                body.append('cardId', cardId);
                labels.forEach(label => body.append('labelIds', label.labelId));

                const triggerButton = control.querySelector('[data-open-label-picker]');
                triggerButton?.classList.add('is-saving');

                try {
                    const response = await fetch(updateCardLabelsUrl, {
                        method: 'POST',
                        body,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const result = await response.json();
                    if (!response.ok || !result.success) {
                        throw new Error(result.message || 'บันทึกป้ายไม่สำเร็จ');
                    }

                    const savedLabels = Array.isArray(result.labels)
                        ? result.labels.map(normalizeLabel)
                        : labels.map(normalizeLabel);
                    const card = document.querySelector(`.rb-card[data-card-id="${cardId}"]`);
                    if (card) {
                        const title = card.querySelector('[data-card-title]')?.textContent || '';
                        const detail = form.querySelector('[name="detail"]')?.value || '';
                        card.dataset.searchText = `${title} ${detail} ${savedLabels.map(label => label.labelName).join(' ')}`;
                        renderLabelCollection(card.querySelector('[data-card-labels]'), savedLabels, false, false);
                    }
                } catch (error) {
                    showBoardError(error.message || 'บันทึกป้ายไม่สำเร็จ');
                } finally {
                    triggerButton?.classList.remove('is-saving');
                }
            }

            function createLabelOption(label, checked = false) {
                const option = document.createElement('label');
                option.className = 'rb-label-option';
                option.dataset.labelOption = '';
                option.dataset.labelText = label.labelName;

                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.value = label.labelId;
                checkbox.dataset.labelCheckbox = '';
                checkbox.checked = checked;

                const text = document.createElement('span');
                text.className = 'rb-label-option-text';
                text.style.setProperty('--rb-label-color', normalizeHex(label.colorHex));
                text.style.setProperty('--rb-label-text', labelTextColor(label.colorHex));
                text.textContent = label.labelName;

                option.append(checkbox, text);
                return option;
            }

            function appendLabelToAllPickers(label, selectedControl = null) {
                document.querySelectorAll('[data-label-list]').forEach(list => {
                    const control = list.closest('[data-label-control]');
                    const option = createLabelOption(label, control === selectedControl);
                    list.appendChild(option);
                    if (control === selectedControl) syncLabelControl(control);
                });
            }

            document.querySelectorAll('[data-label-control]').forEach(syncLabelControl);
            initDescriptionEditors();

            if (openCardId > 0 && window.bootstrap) {
                const modal = document.getElementById(`requirementCardModal-${openCardId}`);
                if (modal) {
                    window.bootstrap.Modal.getOrCreateInstance(modal).show();
                }
            }

            document.querySelectorAll('.rb-modal').forEach(modal => {
                modal.addEventListener('hidden.bs.modal', () => {
                    const descriptionControl = modal.querySelector('[data-description-control]');
                    syncDescriptionFromRich(descriptionControl);
                    const textarea = descriptionControl?.querySelector('textarea[name="detail"]');

                    syncDescriptionPreview(descriptionControl, textarea?.value || '');
                    closeDescriptionEditor(descriptionControl);
                });
            });

            document.addEventListener('mousedown', event => {
                const descriptionCommand = event.target.closest('[data-description-command]');
                if (descriptionCommand) {
                    event.preventDefault();
                }

                const descriptionFontSizeControl = event.target.closest('[data-description-font-size-control]');
                if (descriptionFontSizeControl) {
                    const editor = descriptionFontSizeControl.closest('[data-description-editor]');
                    saveDescriptionSelection(editor?.querySelector('[data-description-rich]'));
                }

                const descriptionColorControl = event.target.closest('[data-description-color-control]');
                if (descriptionColorControl) {
                    const editor = descriptionColorControl.closest('[data-description-editor]');
                    saveDescriptionSelection(editor?.querySelector('[data-description-rich]'));
                }
            });

            document.addEventListener('selectionchange', () => {
                const selection = window.getSelection();
                if (!selection || selection.rangeCount === 0) return;

                const rich = descriptionRangeHost(selection.getRangeAt(0));
                if (rich) {
                    saveDescriptionSelection(rich);
                    syncDescriptionToolbarState(rich);
                }
            });

            document.addEventListener('click', async event => {
                if (event.target.closest('[data-description-preview] a')) {
                    return;
                }

                const descriptionFontSizeToggle = event.target.closest('[data-description-font-size-toggle]');
                if (descriptionFontSizeToggle) {
                    const control = descriptionFontSizeToggle.closest('[data-description-font-size-control]');
                    const menu = control?.querySelector('[data-description-font-size-menu]');
                    if (!menu) return;

                    const willOpen = menu.hidden;
                    closeDescriptionFontSizeMenus(menu);
                    closeDescriptionColorMenus();
                    menu.hidden = !willOpen;
                    return;
                }

                const descriptionFontSizeOption = event.target.closest('[data-description-font-size]');
                if (descriptionFontSizeOption) {
                    applyDescriptionFontSize(descriptionFontSizeOption);
                    return;
                }

                const descriptionColorToggle = event.target.closest('[data-description-color-toggle]');
                if (descriptionColorToggle) {
                    const control = descriptionColorToggle.closest('[data-description-color-control]');
                    const menu = control?.querySelector('[data-description-color-menu]');
                    if (!menu) return;

                    renderDescriptionColorMenu(menu);
                    const willOpen = menu.hidden;
                    closeDescriptionColorMenus(menu);
                    closeDescriptionFontSizeMenus();
                    menu.hidden = !willOpen;
                    return;
                }

                const descriptionColorOption = event.target.closest('[data-description-color]');
                if (descriptionColorOption) {
                    applyDescriptionFontColor(descriptionColorOption);
                    return;
                }

                if (!event.target.closest('[data-description-color-control]')) {
                    closeDescriptionColorMenus();
                }

                if (!event.target.closest('[data-description-font-size-control]')) {
                    closeDescriptionFontSizeMenus();
                }

                if (!event.target.closest('[data-label-control]')) {
                    closeLabelPickers();
                }

                const descriptionCommand = event.target.closest('[data-description-command]');
                if (descriptionCommand) {
                    runDescriptionCommand(descriptionCommand);
                    return;
                }

                const descriptionTrigger = event.target.closest('[data-description-toggle]');
                if (descriptionTrigger) {
                    openDescriptionEditor(descriptionTrigger.closest('[data-description-control]'));
                    return;
                }

                const openButton = event.target.closest('[data-open-label-picker]');
                if (openButton) {
                    const control = openButton.closest('[data-label-control]');
                    const picker = control?.querySelector('[data-label-picker]');
                    if (!picker) return;

                    closeLabelPickers(picker);
                    picker.hidden = !picker.hidden;
                    picker.querySelector('[data-label-search]')?.focus();
                    return;
                }

                const closeButton = event.target.closest('[data-close-label-picker]');
                if (closeButton) {
                    const picker = closeButton.closest('[data-label-picker]');
                    if (picker) picker.hidden = true;
                    return;
                }

                const colorButton = event.target.closest('[data-label-color]');
                if (colorButton) {
                    const form = colorButton.closest('[data-label-create-form]');
                    form?.querySelectorAll('[data-label-color]').forEach(button => button.classList.remove('is-selected'));
                    colorButton.classList.add('is-selected');
                    const input = form?.querySelector('[data-label-color-value]');
                    if (input) input.value = colorButton.dataset.labelColor || '#22c7b8';
                    return;
                }

                const createButton = event.target.closest('[data-create-label]');
                if (!createButton) return;

                const control = createButton.closest('[data-label-control]');
                const form = createButton.closest('[data-label-create-form]');
                const nameInput = form?.querySelector('[data-label-name]');
                const colorInput = form?.querySelector('[data-label-color-value]');
                const labelName = (nameInput?.value || '').trim();
                if (!labelName) {
                    nameInput?.focus();
                    return;
                }

                createButton.disabled = true;
                createButton.classList.add('is-loading');

                try {
                    const body = new FormData();
                    body.append('__RequestVerificationToken', token);
                    body.append('labelName', labelName);
                    body.append('colorHex', colorInput?.value || '#22c7b8');

                    const response = await fetch(createLabelUrl, {
                        method: 'POST',
                        body,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const result = await response.json();
                    if (!response.ok || !result.success || !result.label) {
                        throw new Error(result.message || 'สร้างป้ายไม่สำเร็จ');
                    }

                    const createdLabel = normalizeLabel(result.label);
                    boardLabels.push(createdLabel);
                    appendLabelToAllPickers(createdLabel, control);
                    await saveCardLabels(control);
                    if (nameInput) nameInput.value = '';
                } catch (error) {
                    showBoardError(error.message || 'สร้างป้ายไม่สำเร็จ');
                } finally {
                    createButton.disabled = false;
                    createButton.classList.remove('is-loading');
                }
            });

            document.addEventListener('keydown', event => {
                if (event.target.closest('[data-description-preview] a')) {
                    return;
                }

                const descriptionPreview = event.target.closest('[data-description-preview]');
                if (!descriptionPreview || (event.key !== 'Enter' && event.key !== ' ')) return;

                event.preventDefault();
                openDescriptionEditor(descriptionPreview.closest('[data-description-control]'));
            });

            document.addEventListener('keyup', event => {
                const richDescription = event.target.closest('[data-description-rich]');
                if (richDescription) {
                    syncDescriptionToolbarState(richDescription);
                }
            });

            document.addEventListener('input', event => {
                const richDescription = event.target.closest('[data-description-rich]');
                if (richDescription) {
                    syncDescriptionFromRich(richDescription.closest('[data-description-control]'));
                    syncDescriptionToolbarState(richDescription);
                    return;
                }

                const search = event.target.closest('[data-label-search]');
                if (!search) return;

                const keyword = normalizeText(search.value);
                const picker = search.closest('[data-label-picker]');
                picker?.querySelectorAll('[data-label-option]').forEach(option => {
                    const text = normalizeText(option.dataset.labelText);
                    option.style.display = !keyword || text.includes(keyword) ? '' : 'none';
                });
            });

            document.addEventListener('change', async event => {
                const checkbox = event.target.closest('[data-label-checkbox]');
                if (!checkbox) return;

                const control = checkbox.closest('[data-label-control]');
                syncLabelControl(control);
                await saveCardLabels(control);
            });

            function cssImageUrl(path) {
                return `url("${String(path || '').replace(/\\/g, '\\\\').replace(/"/g, '\\"')}")`;
            }

            function ensureCardCoverFrame(card, path, title) {
                if (!card || !path) return;

                let frame = card.querySelector('.rb-card-cover-frame');
                let cover = frame?.querySelector('.rb-card-cover') || card.querySelector(':scope > .rb-card-cover');

                if (!frame) {
                    frame = document.createElement('div');
                    frame.className = 'rb-card-cover-frame';

                    if (cover) {
                        cover.replaceWith(frame);
                    } else {
                        cover = document.createElement('img');
                        cover.className = 'rb-card-cover';
                        card.insertBefore(frame, card.firstElementChild);
                    }

                    frame.appendChild(cover);
                }

                frame.style.setProperty('--rb-card-image', cssImageUrl(path));
                cover.src = path;
                cover.alt = title || '';
            }

            function formatAttachmentFileSize(bytes) {
                const size = Number(bytes || 0);
                if (!size) return '-';
                if (size >= 1048576) return `${(size / 1048576).toFixed(1)} MB`;
                return `${Math.max(1, Math.round(size / 1024)).toLocaleString()} KB`;
            }

            function attachmentExtension(fileName) {
                const name = String(fileName || '');
                const dot = name.lastIndexOf('.');
                if (dot < 0) return 'FILE';
                return name.substring(dot + 1, dot + 5).toUpperCase() || 'FILE';
            }

            function attachmentData(file) {
                return {
                    attachmentId: file.attachmentId ?? file.AttachmentId ?? 0,
                    fileName: file.fileName ?? file.FileName ?? '-',
                    fileSize: file.fileSize ?? file.FileSize ?? '-',
                    uploadedAt: file.uploadedAt ?? file.UploadedAt ?? '-',
                    isImage: Boolean(file.isImage ?? file.IsImage),
                    filePath: file.filePath ?? file.FilePath ?? '',
                    previewUrl: file.previewUrl ?? file.PreviewUrl ?? '',
                    downloadUrl: file.downloadUrl ?? file.DownloadUrl ?? ''
                };
            }

            function ensureAttachmentDeleteForm(attachmentId) {
                if (!canDeleteAttachments || !attachmentId || !deleteAttachmentUrl) return '';

                const formId = `deleteAttachmentForm-${attachmentId}`;
                let form = document.getElementById(formId);
                if (form) return formId;

                form = document.createElement('form');
                form.id = formId;
                form.method = 'post';
                form.action = deleteAttachmentUrl;
                form.addEventListener('submit', event => {
                    if (!window.confirm('ลบไฟล์แนบนี้หรือไม่?')) event.preventDefault();
                });

                if (token) {
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;
                    form.appendChild(tokenInput);
                }

                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'attachmentId';
                idInput.value = attachmentId;
                form.appendChild(idInput);
                document.body.appendChild(form);
                return formId;
            }

            function createAttachmentActionLink(label, url) {
                const link = document.createElement('a');
                link.className = 'rb-btn secondary';
                link.href = url || '#';
                link.target = '_blank';
                link.rel = 'noopener';
                link.textContent = label;
                return link;
            }

            function createAttachmentThumb(file, pendingFile = null) {
                const wrapper = pendingFile ? document.createElement('div') : document.createElement('a');
                wrapper.className = 'rb-file-thumb-link';

                if (!pendingFile) {
                    wrapper.href = file.previewUrl || '#';
                    wrapper.target = '_blank';
                    wrapper.rel = 'noopener';
                }

                const pendingIsImage = Boolean(pendingFile?.type?.startsWith('image/'));
                const imageSrc = file.isImage && file.filePath
                    ? file.filePath
                    : (pendingIsImage && pendingFile ? URL.createObjectURL(pendingFile) : '');

                if (imageSrc) {
                    const img = document.createElement('img');
                    img.className = 'rb-file-thumb';
                    img.src = imageSrc;
                    img.alt = file.fileName || '';
                    if (pendingFile) {
                        img.onload = () => URL.revokeObjectURL(imageSrc);
                    }
                    wrapper.appendChild(img);
                } else {
                    wrapper.classList.add('rb-file-thumb');
                    wrapper.textContent = attachmentExtension(file.fileName);
                }

                return wrapper;
            }

            function createAttachmentRow(rawFile, options = {}) {
                const file = attachmentData(rawFile);
                const row = document.createElement('div');
                row.className = 'rb-file-row';

                if (options.pendingFile) {
                    row.classList.add('is-pending');
                    row.dataset.pendingAttachment = 'true';
                    file.fileName = options.pendingFile.name || file.fileName;
                    file.fileSize = formatAttachmentFileSize(options.pendingFile.size);
                    file.uploadedAt = 'รอบันทึก';
                    file.isImage = Boolean(options.pendingFile.type?.startsWith('image/'));
                }

                const info = document.createElement('div');
                const name = document.createElement('div');
                name.className = 'rb-file-name';
                name.textContent = file.fileName || '-';

                const meta = document.createElement('div');
                meta.className = 'rb-file-info';
                meta.textContent = `${file.fileSize || '-'} · ${file.uploadedAt || '-'}`;

                info.append(name, meta);

                const actions = document.createElement('div');
                actions.className = 'rb-file-actions';

                if (options.pendingFile) {
                    const badge = document.createElement('span');
                    badge.className = 'rb-file-pending-badge';
                    badge.textContent = 'รอบันทึก';
                    actions.appendChild(badge);
                } else {
                    if (file.previewUrl) actions.appendChild(createAttachmentActionLink('Preview', file.previewUrl));
                    if (file.downloadUrl) actions.appendChild(createAttachmentActionLink('ดาวน์โหลด', file.downloadUrl));

                    const deleteFormId = ensureAttachmentDeleteForm(file.attachmentId);
                    if (deleteFormId) {
                        const deleteButton = document.createElement('button');
                        deleteButton.className = 'rb-btn danger';
                        deleteButton.type = 'submit';
                        deleteButton.setAttribute('form', deleteFormId);
                        deleteButton.textContent = 'ลบ';
                        actions.appendChild(deleteButton);
                    }
                }

                row.append(createAttachmentThumb(file, options.pendingFile), info, actions);
                return row;
            }

            function updateAttachmentHeading(region, pendingCount = 0) {
                const heading = region?.querySelector('[data-attachment-heading]');
                if (!heading) return;

                const savedCount = Number(heading.dataset.attachmentCount || 0);
                heading.textContent = `ไฟล์แนบ (${savedCount + pendingCount})`;
            }

            function showAttachmentEmpty(region) {
                const body = region?.querySelector('[data-attachment-list]');
                if (!body) return;

                body.innerHTML = '';
                const empty = document.createElement('div');
                empty.className = 'alert alert-light border';
                empty.dataset.attachmentEmpty = '';
                empty.textContent = 'ยังไม่มีไฟล์แนบ';
                body.appendChild(empty);
            }

            function ensureAttachmentFileList(region) {
                const body = region?.querySelector('[data-attachment-list]');
                if (!body) return null;

                body.querySelector('[data-attachment-empty]')?.remove();
                let list = body.querySelector('.rb-file-list');
                if (!list) {
                    list = document.createElement('div');
                    list.className = 'rb-file-list';
                    body.appendChild(list);
                }

                return list;
            }

            function renderSavedAttachments(modal, attachments) {
                const region = modal?.querySelector('[data-attachment-region]');
                const heading = region?.querySelector('[data-attachment-heading]');
                if (!region || !heading) return;

                const safeAttachments = Array.isArray(attachments) ? attachments : [];
                heading.dataset.attachmentCount = String(safeAttachments.length);
                updateAttachmentHeading(region, 0);

                if (safeAttachments.length === 0) {
                    showAttachmentEmpty(region);
                    return;
                }

                const body = region.querySelector('[data-attachment-list]');
                if (!body) return;

                body.innerHTML = '';
                const list = document.createElement('div');
                list.className = 'rb-file-list';
                safeAttachments.forEach(file => list.appendChild(createAttachmentRow(file)));
                body.appendChild(list);
            }

            function syncPendingAttachments(input) {
                if (!input?.matches('input[type="file"][name="files"]')) return;

                const region = input.closest('.rb-file-upload-card')?.querySelector('[data-attachment-region]');
                if (!region) return;

                const files = Array.from(input.files || []);
                const body = region.querySelector('[data-attachment-list]');
                if (!body) return;

                body.querySelectorAll('[data-pending-attachment]').forEach(row => row.remove());

                if (files.length > 0) {
                    const list = ensureAttachmentFileList(region);
                    files.forEach(file => {
                        list?.appendChild(createAttachmentRow({}, { pendingFile: file }));
                    });
                }

                const rowCount = body.querySelectorAll('.rb-file-row').length;
                if (rowCount === 0) {
                    showAttachmentEmpty(region);
                } else {
                    body.querySelector('[data-attachment-empty]')?.remove();
                }

                updateAttachmentHeading(region, files.length);
            }

            function clearUploadInput(input) {
                if (window.PasteImageUpload?.clear) {
                    window.PasteImageUpload.clear(input);
                    return;
                }

                input.value = '';
                syncPendingAttachments(input);
            }

            function updateBoardCard(data, form) {
                const cardId = data.cardId || form.dataset.cardId;
                const card = document.querySelector(`.rb-card[data-card-id="${cardId}"]`);
                const title = data.title || form.querySelector('[name="title"]')?.value || '';
                const detail = data.detail || form.querySelector('[name="detail"]')?.value || '';
                const labels = Array.isArray(data.labels)
                    ? data.labels.map(normalizeLabel)
                    : selectedLabelsFor(form).map(normalizeLabel);

                if (card) {
                    const titleNode = card.querySelector('[data-card-title]');
                    if (titleNode) titleNode.textContent = title;

                    card.dataset.searchText = `${title} ${detail} ${labels.map(label => label.labelName).join(' ')}`;
                    renderLabelCollection(card.querySelector('[data-card-labels]'), labels, false, false);

                    if (data.coverImagePath) {
                        ensureCardCoverFrame(card, data.coverImagePath, title);
                    }
                }

                const modal = form.closest('.rb-modal');
                if (!modal) return;

                const descriptionControl = modal.querySelector('[data-description-control]');
                syncDescriptionPreview(descriptionControl, detail);
                closeDescriptionEditor(descriptionControl);

                const modalMeta = modal.querySelector('[data-card-modal-meta]');
                if (modalMeta && data.updatedAt) {
                    modalMeta.textContent = modalMeta.textContent.replace(/อัปเดต .*/, `อัปเดต ${data.updatedAt}`);
                }

                const modalHeader = modal.querySelector('.modal-header');
                if (modalHeader && data.coverImagePath) {
                    modalHeader.classList.add('has-cover');
                    modalHeader.style.setProperty('--rb-modal-cover-image', `url('${data.coverImagePath}')`);
                    let modalCoverImage = modalHeader.querySelector('[data-modal-cover-image]');
                    if (!modalCoverImage) {
                        modalCoverImage = document.createElement('img');
                        modalCoverImage.className = 'rb-modal-cover-image';
                        modalCoverImage.dataset.modalCoverImage = '';
                        modalCoverImage.alt = '';
                        modalHeader.insertBefore(modalCoverImage, modalHeader.firstChild);
                    }
                    modalCoverImage.src = data.coverImagePath;
                }

                if (Array.isArray(data.attachments)) {
                    renderSavedAttachments(modal, data.attachments);
                } else {
                    const attachmentHeading = modal.querySelector('[data-attachment-heading]');
                    if (attachmentHeading && Number.isFinite(Number(data.attachmentCount))) {
                        attachmentHeading.dataset.attachmentCount = data.attachmentCount;
                        attachmentHeading.textContent = `ไฟล์แนบ (${data.attachmentCount})`;
                    }
                }
            }

            function closeCardModal(form) {
                const modal = form?.closest('.rb-modal');
                if (!modal || !window.bootstrap) return;

                window.bootstrap.Modal.getOrCreateInstance(modal).hide();
            }

            document.addEventListener('paste-image-upload:files-changed', event => {
                syncPendingAttachments(event.target);
            });

            document.addEventListener('change', event => {
                const input = event.target.closest?.('input[type="file"][name="files"]');
                if (!input) return;

                window.setTimeout(() => syncPendingAttachments(input), 0);
            });

            document.addEventListener('submit', async event => {
                const createForm = event.target.closest('.rb-create-card-form');
                if (createForm && !createForm.hasAttribute('data-card-update-form')) {
                    syncDescriptionEditors(createForm);
                    return;
                }

                const form = event.target.closest('[data-card-update-form]');
                if (!form) return;

                event.preventDefault();
                if (!window.confirm('ต้องการบันทึกการ์ดนี้หรือไม่?')) return;
                syncDescriptionEditors(form);

                const submitButton = form.querySelector('button[type="submit"]');
                const status = form.querySelector('[data-card-save-status]');

                submitButton?.classList.add('is-loading');
                if (submitButton) submitButton.disabled = true;
                setSaveStatus(status, 'กำลังบันทึก...', 'success');

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const contentType = response.headers.get('content-type') || '';
                    const result = contentType.includes('application/json')
                        ? await response.json()
                        : { success: false, message: 'บันทึกไม่สำเร็จ กรุณาลองใหม่อีกครั้ง' };

                    if (!response.ok || !result.success) {
                        throw new Error(result.message || 'บันทึกไม่สำเร็จ');
                    }

                    updateBoardCard(result, form);
                    form.querySelectorAll('input[type="file"]').forEach(input => {
                        clearUploadInput(input);
                    });
                    setSaveStatus(status, result.message || 'บันทึกแล้ว', 'success');
                    closeCardModal(form);
                } catch (error) {
                    setSaveStatus(status, error.message || 'บันทึกไม่สำเร็จ', 'error');
                } finally {
                    submitButton?.classList.remove('is-loading');
                    if (submitButton) submitButton.disabled = false;
                }
            });

            function reindexPhaseRows(list) {
                if (!list) return;

                list.querySelectorAll('[data-phase-row]').forEach((row, index) => {
                    row.querySelectorAll('[data-phase-field]').forEach(field => {
                        const fieldName = field.dataset.phaseField;
                        if (!fieldName) return;
                        field.name = `phaseItems[${index}].${fieldName}`;
                    });
                });
            }

            function resetPhaseRow(row, sourceList) {
                if (!row) return;

                const rows = sourceList
                    ? Array.from(sourceList.querySelectorAll('[data-phase-row]'))
                    : [];
                const lastRow = rows[rows.length - 1];
                const lastPhaseOrder = sourceList ? Number(lastRow?.querySelector('[data-phase-field="PhaseOrder"]')?.value || 1) : 1;
                const lastPeriodOrder = sourceList ? Number(lastRow?.querySelector('[data-phase-field="PeriodOrder"]')?.value || 0) : 0;

                row.querySelectorAll('input, select, textarea').forEach(field => {
                    const fieldName = field.dataset.phaseField;

                    if (fieldName === 'ItemId' || fieldName === 'PhaseName' || field.matches('[data-rb-date], [data-rb-native-date]')) {
                        field.value = '';
                        return;
                    }

                    if (fieldName === 'PhaseOrder') {
                        field.value = String(Number.isFinite(lastPhaseOrder) && lastPhaseOrder > 0 ? lastPhaseOrder : 1);
                        return;
                    }

                    if (fieldName === 'PeriodOrder') {
                        field.value = String(Number.isFinite(lastPeriodOrder) && lastPeriodOrder > 0 ? lastPeriodOrder + 1 : 1);
                        return;
                    }

                    if (fieldName === 'PhaseType') {
                        field.value = 'MAIN';
                        return;
                    }

                    if (fieldName === 'PhaseStatus') {
                        field.value = 'วางแผน';
                    }
                });
            }

            document.addEventListener('click', event => {
                const addButton = event.target.closest('[data-add-phase-row]');
                if (addButton) {
                    const block = addButton.closest('.rb-phase-draft');
                    const list = block?.querySelector('[data-phase-list]');
                    const firstRow = list?.querySelector('[data-phase-row]');
                    if (!list || !firstRow) return;

                    const newRow = firstRow.cloneNode(true);
                    resetPhaseRow(newRow, list);
                    list.appendChild(newRow);
                    reindexPhaseRows(list);
                    newRow.querySelector('[data-phase-field="PhaseName"]')?.focus();
                    return;
                }

                const removeButton = event.target.closest('[data-remove-phase-row]');
                if (!removeButton) return;

                const list = removeButton.closest('[data-phase-list]');
                const row = removeButton.closest('[data-phase-row]');
                if (!list || !row) return;

                const rows = list.querySelectorAll('[data-phase-row]');
                if (rows.length <= 1) {
                    resetPhaseRow(row, null);
                } else {
                    row.remove();
                }

                reindexPhaseRows(list);
            });

            document.addEventListener('input', event => {
                const input = event.target.closest('[data-rb-date]');
                if (!input) return;

                let value = input.value.replace(/\D/g, '');
                if (value.length > 8) value = value.substring(0, 8);

                if (value.length >= 5) {
                    value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
                } else if (value.length >= 3) {
                    value = `${value.substring(0, 2)}/${value.substring(2)}`;
                }

                input.value = value;
            });

            function parseThaiDateToIso(value) {
                const match = (value || '').trim().match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})$/);
                if (!match) return '';

                const day = Number(match[1]);
                const month = Number(match[2]);
                let year = Number(match[3]);
                if (year < 100) year += 2500;
                if (year > 2400) year -= 543;

                if (!day || !month || !year || month < 1 || month > 12 || day < 1 || day > 31) return '';
                return `${year.toString().padStart(4, '0')}-${month.toString().padStart(2, '0')}-${day.toString().padStart(2, '0')}`;
            }

            function formatIsoDateToThai(value) {
                const match = (value || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
                if (!match) return '';

                const year = Number(match[1]) + 543;
                return `${match[3]}/${match[2]}/${year}`;
            }

            function syncDateInputFromNative(textInput, nativeInput) {
                if (!textInput || !nativeInput?.value) return;

                textInput.value = formatIsoDateToThai(nativeInput.value);
                textInput.dispatchEvent(new Event('input', { bubbles: true }));
                textInput.dispatchEvent(new Event('change', { bubbles: true }));
                textInput.focus();
            }

            function openDatePickerFor(wrap) {
                const textInput = wrap?.querySelector('[data-rb-date]');
                const nativeInput = wrap?.querySelector('[data-rb-native-date]');
                if (!textInput || !nativeInput) return;

                nativeInput.value = parseThaiDateToIso(textInput.value);

                if (typeof nativeInput.showPicker === 'function') {
                    nativeInput.showPicker();
                } else {
                    nativeInput.click();
                }
            }

            document.addEventListener('click', event => {
                const button = event.target.closest('[data-rb-date-button]');
                if (!button) return;

                openDatePickerFor(button.closest('.rb-date-input-wrap'));
            });

            document.addEventListener('change', event => {
                const nativeInput = event.target.closest('[data-rb-native-date]');
                if (!nativeInput) return;

                const wrap = nativeInput.closest('.rb-date-input-wrap');
                syncDateInputFromNative(wrap?.querySelector('[data-rb-date]'), nativeInput);
            });

            function cleanupDragImage() {
                if (dragImage) {
                    dragImage.remove();
                    dragImage = null;
                }
            }

            function getDragAfterElement(list, y) {
                const cards = [...list.querySelectorAll('.rb-card:not(.is-dragging)')];

                return cards.reduce((closest, child) => {
                    const box = child.getBoundingClientRect();
                    const offset = y - box.top - box.height / 2;

                    if (offset < 0 && offset > closest.offset) {
                        return { offset, element: child };
                    }

                    return closest;
                }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
            }

            function clearColumnDropMarkers() {
                document.querySelectorAll('.rb-column.is-column-drop-before, .rb-column.is-column-drop-after')
                    .forEach(column => column.classList.remove('is-column-drop-before', 'is-column-drop-after'));
            }

            function getColumnAfterElement(board, x) {
                const columns = [...board.querySelectorAll('.rb-column:not(.is-column-dragging)')];

                return columns.reduce((closest, child) => {
                    const box = child.getBoundingClientRect();
                    const offset = x - box.left - box.width / 2;

                    if (offset < 0 && offset > closest.offset) {
                        return { offset, element: child };
                    }

                    return closest;
                }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
            }

            async function persistColumnOrder(board) {
                const orderedColumnIds = Array.from(board.querySelectorAll('.rb-column'))
                    .map(column => Number(column.dataset.columnId || 0))
                    .filter(Boolean);

                if (orderedColumnIds.length === 0) return;

                try {
                    const response = await fetch('@Url.Action("ReorderColumns", "RequirementBoard")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ orderedColumnIds })
                    });

                    if (!response.ok) {
                        window.location.reload();
                    }
                } catch {
                    window.location.reload();
                }
            }

            document.querySelectorAll('[data-column-drag-handle]').forEach(handle => {
                handle.addEventListener('dragstart', event => {
                    if (event.target?.closest?.('[data-column-action]')) {
                        event.preventDefault();
                        return;
                    }

                    const column = handle.closest('.rb-column');
                    if (!column) return;

                    draggedColumn = column;
                    originalNextColumn = column.nextElementSibling;
                    didColumnDrop = false;
                    wasDragging = true;
                    column.classList.add('is-column-dragging');
                    event.dataTransfer.effectAllowed = 'move';
                    event.dataTransfer.setData('text/plain', column.dataset.columnId || '');

                    dragImage = column.cloneNode(true);
                    dragImage.classList.add('rb-column-drag-image');
                    dragImage.classList.remove('is-column-dragging', 'is-column-drop-before', 'is-column-drop-after');
                    dragImage.style.width = `${column.offsetWidth}px`;
                    document.body.appendChild(dragImage);

                    const rect = column.getBoundingClientRect();
                    event.dataTransfer.setDragImage(
                        dragImage,
                        event.clientX - rect.left,
                        Math.min(event.clientY - rect.top, 80)
                    );
                });

                handle.addEventListener('dragend', () => {
                    if (!didColumnDrop && draggedColumn) {
                        const board = draggedColumn.closest('.rb-board');
                        if (board) {
                            if (originalNextColumn && originalNextColumn.parentElement === board) {
                                board.insertBefore(draggedColumn, originalNextColumn);
                            } else {
                                const addColumn = board.querySelector('.rb-add-list-column');
                                if (addColumn) {
                                    board.insertBefore(draggedColumn, addColumn);
                                } else {
                                    board.appendChild(draggedColumn);
                                }
                            }
                        }
                    }

                    draggedColumn?.classList.remove('is-column-dragging');
                    clearColumnDropMarkers();
                    cleanupDragImage();
                    suppressClickUntil = Date.now() + 250;
                    setTimeout(() => {
                        draggedColumn = null;
                        originalNextColumn = null;
                        didColumnDrop = false;
                        wasDragging = false;
                    }, 0);
                });
            });

            document.querySelectorAll('.rb-board').forEach(board => {
                board.addEventListener('dragover', event => {
                    if (!draggedColumn) return;

                    event.preventDefault();
                    clearColumnDropMarkers();

                    const afterElement = getColumnAfterElement(board, event.clientX);
                    const addColumn = board.querySelector('.rb-add-list-column');
                    if (afterElement == null) {
                        if (addColumn) {
                            board.insertBefore(draggedColumn, addColumn);
                        } else {
                            board.appendChild(draggedColumn);
                        }
                        draggedColumn.previousElementSibling?.classList.add('is-column-drop-after');
                    } else {
                        board.insertBefore(draggedColumn, afterElement);
                        afterElement.classList.add('is-column-drop-before');
                    }
                });

                board.addEventListener('dragleave', event => {
                    if (!draggedColumn || board.contains(event.relatedTarget)) return;
                    clearColumnDropMarkers();
                });

                board.addEventListener('drop', async event => {
                    if (!draggedColumn) return;

                    event.preventDefault();
                    didColumnDrop = true;
                    clearColumnDropMarkers();
                    await persistColumnOrder(board);
                });
            });

            document.querySelectorAll('.rb-card').forEach(card => {
                card.addEventListener('dragstart', event => {
                    if (draggedColumn) return;
                    draggedCard = card;
                    originalList = card.closest('.rb-card-list');
                    originalNextCard = card.nextElementSibling;
                    didDrop = false;
                    wasDragging = true;
                    card.classList.add('is-dragging');
                    event.dataTransfer.effectAllowed = 'move';
                    event.dataTransfer.setData('text/plain', card.dataset.cardId || '');

                    dragImage = card.cloneNode(true);
                    dragImage.classList.add('rb-drag-image');
                    dragImage.style.width = `${card.offsetWidth}px`;
                    document.body.appendChild(dragImage);

                    const rect = card.getBoundingClientRect();
                    event.dataTransfer.setDragImage(
                        dragImage,
                        event.clientX - rect.left,
                        event.clientY - rect.top
                    );
                });

                card.addEventListener('dragend', () => {
                    if (!didDrop && originalList && draggedCard) {
                        if (originalNextCard && originalNextCard.parentElement === originalList) {
                            originalList.insertBefore(draggedCard, originalNextCard);
                        } else {
                            originalList.appendChild(draggedCard);
                        }
                    }

                    card.classList.remove('is-dragging');
                    document.querySelectorAll('.rb-card-list.is-over').forEach(item => item.classList.remove('is-over'));
                    cleanupDragImage();
                    suppressClickUntil = Date.now() + 250;
                    setTimeout(() => {
                        draggedCard = null;
                        originalList = null;
                        originalNextCard = null;
                        didDrop = false;
                        wasDragging = false;
                    }, 0);
                });

                card.addEventListener('click', event => {
                    if (wasDragging || Date.now() < suppressClickUntil) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                });
            });

            document.querySelectorAll('.rb-card-list').forEach(list => {
                list.addEventListener('dragover', event => {
                    if (draggedColumn) return;
                    event.preventDefault();
                    list.classList.add('is-over');

                    if (!draggedCard) return;

                    const afterElement = getDragAfterElement(list, event.clientY);
                    if (afterElement == null) {
                        list.appendChild(draggedCard);
                    } else {
                        list.insertBefore(draggedCard, afterElement);
                    }
                });

                list.addEventListener('dragleave', () => {
                    list.classList.remove('is-over');
                });

                list.addEventListener('drop', async event => {
                    if (draggedColumn) return;
                    event.preventDefault();
                    list.classList.remove('is-over');
                    if (!draggedCard) return;

                    const cardId = Number(draggedCard.dataset.cardId || 0);
                    const columnId = Number(list.dataset.columnId || 0);
                    const orderedCardIds = Array.from(list.querySelectorAll('.rb-card'))
                        .map(card => Number(card.dataset.cardId || 0))
                        .filter(Boolean);

                    didDrop = true;

                    try {
                        const response = await fetch('@Url.Action("MoveCard", "RequirementBoard")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify({ cardId, columnId, orderedCardIds })
                        });

                        if (!response.ok) {
                            window.location.reload();
                        }
                    } catch {
                        window.location.reload();
                    }
                });
            });
        })();
    </script>
}

            width: 38px;
            height: 38px;
            min-width: 38px;
            padding: 0;
            border: 1px solid #d5dde7;
            border-radius: 7px;
            background: #fff;
            color: #3f4650;
            font-size: 1.18rem;
            font-weight: 900;
            line-height: 1;
            box-shadow: 0 1px 3px rgba(15, 39, 70, .1);
            transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease, color .16s ease;
        }

        .rb-label-picker-button span {
            display: block;
            line-height: 1;
        }

        .rb-label-picker-button:hover {
            transform: translateY(-1px);
            border-color: rgba(20, 184, 166, .58);
            color: #0f766e;
            box-shadow: 0 10px 20px rgba(15, 39, 70, .12);
        }

        .rb-label-picker-button.is-saving {
            opacity: .7;
            pointer-events: none;
        }

        .rb-label-popover {
            position: absolute;
            left: 0;
            top: calc(100% + 8px);
            z-index: 1200;
            width: min(390px, 94vw);
            max-height: min(330px, calc(100vh - 260px));
            padding: 12px;
            border: 1px solid #d8e3ef;
            border-radius: 18px;
            background: #fff;
            box-shadow: 0 22px 54px rgba(2, 12, 32, .24);
            overflow-y: auto;
            overscroll-behavior: contain;
        }

        .rb-label-popover[hidden] {
            display: none;
        }

        .rb-label-picker-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
            color: #10213a;
            font-weight: 900;
        }

        .rb-label-picker-close {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 999px;
            background: #eef4fb;
            color: #334155;
            font-size: 1.2rem;
            font-weight: 900;
            line-height: 1;
        }

        .rb-label-search {
            min-height: 42px;
            margin-bottom: 10px;
            border-radius: 12px;
            font-weight: 800;
        }

        .rb-label-list {
            display: grid;
            gap: 8px;
            max-height: 140px;
            overflow: auto;
            padding-right: 3px;
        }

        .rb-label-option {
            display: grid;
            grid-template-columns: 26px minmax(0, 1fr);
            gap: 9px;
            align-items: center;
            cursor: pointer;
        }

        .rb-label-option input {
            width: 18px;
            height: 18px;
            accent-color: #2563eb;
        }

        .rb-label-option-text {
            display: block;
            min-height: 34px;
            padding: 6px 12px;
            border-radius: 9px;
            background: var(--rb-label-color, #22c7b8);
            color: var(--rb-label-text, #10213a);
            font-weight: 900;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .rb-label-create {
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid #e4edf6;
        }

        .rb-label-create summary {
            display: inline-flex;
            align-items: center;
            min-height: 40px;
            padding: 0 14px;
            border: 1px solid #d8e3ef;
            border-radius: 12px;
            color: #0f766e;
            cursor: pointer;
            font-weight: 900;
            list-style: none;
        }

        .rb-label-create summary::-webkit-details-marker {
            display: none;
        }

        .rb-label-create-form {
            display: grid;
            gap: 10px;
            margin-top: 10px;
        }

        .rb-label-color-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 7px;
        }

        .rb-label-color {
            width: 100%;
            aspect-ratio: 2.15;
            border: 2px solid transparent;
            border-radius: 10px;
            background: var(--rb-label-color);
        }

        .rb-label-color.is-selected {
            border-color: #10213a;
            box-shadow: 0 0 0 3px rgba(20, 184, 166, .18);
        }

        .rb-file-list {
            display: grid;
            gap: 10px;
            margin-top: 12px;
        }

        .rb-file-row {
            display: grid;
            grid-template-columns: 58px minmax(0, 1fr) auto;
            gap: 12px;
            align-items: center;
            padding: 10px;
            border: 1px solid #d8e3ef;
            border-radius: 16px;
            background: #fff;
        }

        .rb-file-row.is-pending {
            border-style: dashed;
            background: #f8fcff;
        }

        .rb-file-thumb {
            width: 58px;
            height: 46px;
            border-radius: 12px;
            background: #e8f1fa;
            object-fit: cover;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0f766e;
            font-weight: 500;
        }

        .rb-file-thumb-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 58px;
            height: 46px;
            border-radius: 12px;
            overflow: hidden;
            text-decoration: none;
            background: #e8f1fa;
        }

        .rb-file-name {
            color: #10213a;
            font-weight: 500;
            word-break: break-word;
        }

        .rb-file-info {
            color: #0f172a;
            font-size: .85rem;
            font-weight: 400;
        }

        .rb-file-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .rb-file-pending-badge {
            display: inline-flex;
            align-items: center;
            min-height: 32px;
            padding: 0 12px;
            border-radius: 999px;
            background: #e0f2fe;
            color: #075985;
            font-size: .85rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .rb-file-upload-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 12px;
        }

        .rb-file-upload-card {
            display: grid;
            gap: 8px;
            min-width: 0;
            padding: 14px;
            border: 1px solid #d8e3ef;
            border-radius: 16px;
            background: #fff;
        }

        .rb-attachment-inline {
            display: grid;
            gap: 10px;
            padding-top: 4px;
        }

        .rb-attachment-inline .rb-file-list,
        .rb-attachment-inline .alert {
            margin-top: 0;
            margin-bottom: 0;
        }

        .rb-field-label[data-attachment-heading] {
            font-size: 1rem;
            line-height: 1.35;
        }

        .rb-file-upload-card .form-control {
            min-height: 46px;
            border-radius: 12px;
            font-weight: 400;
        }

        .rb-file-upload-card input[type="file"]::file-selector-button {
            min-height: 36px;
            margin-right: 12px;
            border: 0;
            border-radius: 10px;
            background: #dff8f5;
            color: #0f766e;
            font-weight: 500;
        }

        .rb-file-upload-card,
        .rb-file-upload-card .form-control,
        .rb-file-upload-card input[type="file"]::file-selector-button,
        .rb-file-name,
        .rb-file-info,
        .rb-file-thumb,
        .rb-file-actions .rb-btn,
        .rb-modal-actions .rb-btn,
        .rb-field-label[data-attachment-heading] {
            letter-spacing: 0;
            text-shadow: none;
            -webkit-text-stroke: 0 transparent;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            font-synthesis: none;
            font-variation-settings: normal;
        }

        .rb-modal-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            justify-content: flex-end;
            width: 100%;
            padding-top: 6px;
        }

        .rb-modal-actions-main {
            margin-left: auto;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            justify-content: flex-end;
        }

        .rb-modal-actions .rb-btn {
            min-width: 130px;
        }

        .rb-save-status {
            display: none;
            align-items: center;
            min-height: 38px;
            padding: 0 14px;
            border-radius: 999px;
            color: #64748b;
            font-weight: 900;
            order: -1;
            opacity: 0;
            transform: translateY(3px);
            transition: opacity .18s ease, transform .18s ease;
        }

        .rb-save-status.is-visible {
            display: inline-flex;
            opacity: 1;
            transform: translateY(0);
        }

        .rb-save-status.is-success {
            background: #dff8f5;
            color: #0f766e;
        }

        .rb-save-status.is-error {
            background: #ffe4e6;
            color: #be123c;
        }

        .rb-btn.is-loading {
            opacity: .72;
            pointer-events: none;
        }

        .rb-phase-draft {
            display: grid;
            gap: 10px;
            padding: 14px;
            border: 1px solid rgba(20, 184, 166, .24);
            border-radius: 18px;
            background: linear-gradient(180deg, #f8fffd, #f3f8ff);
        }

        .rb-phase-draft-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .rb-phase-draft-title {
            margin: 0;
            color: #10213a;
            font-size: 1rem;
            font-weight: 900;
        }

        .rb-phase-draft-list {
            display: grid;
            gap: 12px;
        }

        .rb-phase-row {
            position: relative;
            display: grid;
            grid-template-columns: 72px 72px minmax(0, 1fr);
            gap: 10px;
            align-items: start;
            padding: 14px 88px 14px 14px;
            border: 2px solid rgba(20, 184, 166, .48);
            border-radius: 16px;
            background:
                linear-gradient(#fff, #fff) padding-box,
                linear-gradient(135deg, rgba(33, 212, 194, .75), rgba(15, 143, 128, .42)) border-box;
            box-shadow:
                0 10px 22px rgba(15, 39, 70, .06),
                0 0 0 4px rgba(20, 184, 166, .06);
        }

        .rb-phase-row label {
            margin: 0 0 5px;
            color: #64748b;
            font-size: .78rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .rb-phase-row input,
        .rb-phase-row select,
        .rb-phase-row textarea {
            min-height: 42px;
            border-radius: 12px;
            color: #0f172a;
            font-weight: 400;
        }

        .rb-phase-row input[type="number"],
        .rb-phase-row input[data-rb-date] {
            text-align: center;
        }

        .rb-date-input-wrap {
            display: flex;
            align-items: stretch;
            min-width: 0;
            position: relative;
        }

        .rb-date-input-wrap .form-control {
            min-width: 0;
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .rb-date-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            min-width: 42px;
            min-height: 42px;
            border: 1px solid #d8e3ef;
            border-left: 0;
            border-radius: 0 12px 12px 0;
            background: linear-gradient(180deg, #ffffff, #f5f9fd);
            color: #0f766e;
            font-size: 1rem;
            line-height: 1;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .75);
        }

        .rb-date-button:hover {
            background: #e3fbf7;
            color: #0c5f59;
        }

        .rb-date-native {
            position: absolute;
            right: 0;
            top: 0;
            width: 42px;
            height: 42px;
            opacity: 0;
            pointer-events: none;
        }

        .rb-phase-name-field {
            min-width: 0;
        }

        .rb-phase-name-field textarea {
            height: 42px;
            min-height: 42px;
            resize: vertical;
            line-height: 1.25;
        }

        .rb-phase-add-footer {
            display: flex;
            justify-content: flex-end;
            padding-top: 2px;
        }

        .rb-phase-add-footer .rb-btn {
            position: relative;
            width: 64px;
            min-width: 64px;
            height: 40px;
            min-height: 40px;
            padding: 0;
            border-radius: 12px;
            border: 2px solid #16b8a8;
            background: transparent;
            color: #0f8f80;
            font-size: 0;
            line-height: 1;
            box-shadow: none;
        }

        .rb-phase-add-footer .rb-btn:hover {
            background: rgba(33, 212, 194, .08);
            color: #0f766e;
        }

        .rb-phase-add-footer .rb-plus-icon {
            position: relative;
            display: inline-block;
            width: 16px;
            height: 16px;
        }

        .rb-phase-add-footer .rb-plus-icon::before,
        .rb-phase-add-footer .rb-plus-icon::after {
            content: "";
            position: absolute;
            left: 50%;
            top: 50%;
            width: 16px;
            height: 2.5px;
            border-radius: 999px;
            background: currentColor;
            transform: translate(-50%, -50%);
        }

        .rb-phase-add-footer .rb-plus-icon::after {
            transform: translate(-50%, -50%) rotate(90deg);
        }

        .rb-phase-date-grid {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: repeat(4, minmax(140px, 1fr));
            gap: 10px;
        }

        .rb-phase-remove {
            position: absolute;
            top: 12px;
            right: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            padding: 0;
            border: 1px solid rgba(251, 113, 133, .35);
            border-radius: 50%;
            background: linear-gradient(180deg, #fff, #fff1f2);
            color: #e11d48;
            font-size: 0;
            font-weight: 900;
            line-height: 1;
            box-shadow: 0 8px 18px rgba(190, 18, 60, .12);
            transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
        }

        .rb-phase-remove::before,
        .rb-phase-remove::after {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            width: 14px;
            height: 2px;
            border-radius: 999px;
            background: currentColor;
            transform-origin: center;
        }

        .rb-phase-remove::before {
            transform: translate(-50%, -50%) rotate(45deg);
        }

        .rb-phase-remove::after {
            transform: translate(-50%, -50%) rotate(-45deg);
        }

        .rb-phase-remove:hover {
            transform: translateY(-1px);
            background: #ffe4e6;
            box-shadow: 0 12px 22px rgba(190, 18, 60, .18);
        }

        @@media (max-width: 1200px) {
            .rb-board-wrap {
                --rb-visible-columns: 4;
                --rb-column-gap-total: 42px;
                --rb-column-width: clamp(260px, calc((100% - var(--rb-column-gap-total)) / var(--rb-visible-columns)), 360px);
            }

            .rb-phase-row {
                grid-template-columns: 72px 72px minmax(0, 1fr);
            }

            .rb-phase-date-grid {
                grid-column: 1 / -1;
            }

            .rb-phase-date-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 700px) {
            .rb-phase-row,
            .rb-phase-date-grid {
                grid-template-columns: 1fr;
            }

            .rb-phase-name-field,
            .rb-phase-date-grid {
                grid-column: 1 / -1;
            }

            .rb-phase-remove {
                position: static;
                width: 100%;
            }

            .rb-file-upload-grid {
                grid-template-columns: 1fr;
            }
        }

        .rb-alert {
            margin-bottom: 14px;
            border-radius: 18px;
            border: 0;
            font-weight: 800;
        }

        @@media (max-width: 900px) {
            .rb-page {
                width: 100%;
            }

            .rb-board-wrap {
                padding-left: 8px;
                padding-right: 8px;
                --rb-visible-columns: 2.4;
                --rb-column-gap-total: 14px;
                --rb-column-width: clamp(260px, calc((100% - var(--rb-column-gap-total)) / var(--rb-visible-columns)), 340px);
            }

            .rb-hero,
            .rb-toolbar {
                grid-template-columns: 1fr;
                flex-direction: column;
                align-items: stretch;
            }

            .rb-toolbar-start {
                width: 100%;
                flex-direction: column;
                align-items: stretch;
            }

            .rb-boards-btn {
                width: fit-content;
            }

            .rb-search {
                flex-basis: auto;
                width: 100%;
                min-width: 0;
            }

            .rb-toolbar-start > .rb-online-users {
                align-self: flex-start;
            }

            .rb-toolbar-actions {
                justify-content: flex-end;
            }

            .rb-stats {
                justify-content: flex-start;
            }

        }

        @@media (min-width: 1440px) {
            .rb-board-wrap {
                --rb-visible-columns: 5.8;
                --rb-column-gap-total: 74px;
                --rb-column-width: clamp(260px, calc((100% - var(--rb-column-gap-total)) / var(--rb-visible-columns)), 370px);
            }
        }

        @@media (min-width: 1800px) {
            .rb-board-wrap {
                --rb-visible-columns: 6.3;
                --rb-column-gap-total: 86px;
                --rb-column-width: clamp(260px, calc((100% - var(--rb-column-gap-total)) / var(--rb-visible-columns)), 380px);
            }
        }

        @@media (min-height: 900px) {
            .rb-board-wrap {
                --rb-card-cover-height: auto;
            }
        }

        @@media (max-height: 760px) {
            .rb-board-strip {
                min-height: 56px;
                padding-top: 7px;
                padding-bottom: 7px;
            }

            .rb-board-wrap {
                --rb-card-gap: 6px;
                --rb-card-cover-height: auto;
                --rb-card-body-padding-y: 7px;
                --rb-card-title-size: .82rem;
                --rb-card-label-font-size: .58rem;
                --rb-card-label-height: 15px;
            }

            .rb-card-labels {
                margin-bottom: 5px;
                gap: 4px;
            }
        }
    </style>
}

<div class="rb-page" style="@boardPageStyle">
    <section class="rb-toolbar rb-board-strip">
        <div class="rb-toolbar-start">
            <a class="rb-boards-btn" asp-controller="RequirementBoard" asp-action="Index" title="กลับหน้ากระดานทั้งหมด" aria-label="กลับหน้ากระดานทั้งหมด">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3.5 10.8 12 3.8l8.5 7" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M5.6 9.8v9.4h4.5v-5.4h3.8v5.4h4.5V9.8" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
            <div class="rb-search">
                <span class="rb-search-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M10.8 18.1a7.3 7.3 0 1 1 0-14.6 7.3 7.3 0 0 1 0 14.6Z" stroke="currentColor" stroke-width="2.4" />
                        <path d="m16.2 16.2 4.1 4.1" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                    </svg>
                </span>
                <input id="requirementBoardSearch"
                       class="rb-search-input"
                       type="search"
                       placeholder="ค้นหาการ์ด..."
                       autocomplete="off" />
                <button class="rb-search-clear" type="button" aria-label="ล้างคำค้น">×</button>
            </div>
            @if (visibleOnlineUsers.Count > 0)
            {
                <div class="rb-online-users" aria-label="Online users">
                    @foreach (var user in visibleOnlineUsers)
                    {
                        <span class="rb-online-avatar @user.ColorClass"
                              title="@user.DisplayName">
                            <img src="@user.AvatarPath"
                                 alt="@user.DisplayName"
                                 onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                        </span>
                    }
                    @if (hiddenOnlineCount > 0)
                    {
                        <span class="rb-online-more">+@hiddenOnlineCount</span>
                    }
                </div>
            }
        </div>
        <div class="rb-toolbar-actions">
            @if (currentBoard != null)
            {
                <div class="rb-board-title-pill" title="@currentBoard.Group?.GroupName">
                    <span>@currentBoard.BoardName</span>
                </div>
            }
        </div>
    </section>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rb-alert">@TempData["Error"]</div>
    }

    <div class="rb-board-wrap">
        <div class="rb-board">
            @foreach (var column in Model.Columns)
            {
                <section class="rb-column" data-column-id="@column.ColumnId">
                    <header class="rb-column-head"
                            draggable="@(canEdit ? "true" : "false")"
                            data-column-drag-handle
                            title="ลากเพื่อสลับหัวข้อ">
                        <h2 class="rb-column-title">@column.ColumnName</h2>
                        <span class="rb-column-drag-hint" aria-hidden="true">⋮⋮</span>
                        <span class="rb-column-count">@column.Cards.Count</span>
                        @if (canDelete)
                        {
                            var canDeleteColumn = column.Cards.Count == 0 && Model.Columns.Count > 1;
                            <div class="rb-column-actions" data-column-action>
                                <form class="rb-column-delete-form"
                                      asp-action="DeleteColumn"
                                      method="post"
                                      onsubmit="return confirm('ลบหัวข้อนี้หรือไม่?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="columnId" value="@column.ColumnId" />
                                    <button class="rb-column-delete"
                                            type="submit"
                                            draggable="false"
                                            data-column-action
                                            disabled="@(!canDeleteColumn)"
                                            title="@(column.Cards.Count > 0 ? "ต้องย้ายหรือลบการ์ดออกก่อน" : Model.Columns.Count <= 1 ? "ต้องมีหัวข้ออย่างน้อย 1 หัวข้อ" : "ลบหัวข้อ")"
                                            aria-label="ลบหัวข้อ @column.ColumnName">
                                        <span class="rb-column-delete-mark" aria-hidden="true">-</span>
                                    </button>
                                </form>
                            </div>
                        }
                    </header>

                    <div class="rb-card-list" data-column-id="@column.ColumnId">
                        @foreach (var card in column.Cards.OrderBy(x => x.SortOrder).ThenBy(x => x.CardId))
                        {
                            var coverPath = card.CoverImagePath;
                            var cardLabels = ActiveCardLabels(card);
                            <article class="rb-card"
                                     draggable="@(canEdit ? "true" : "false")"
                                     data-card-id="@card.CardId"
                                     data-search-text="@($"{card.Title} {card.Detail} {string.Join(" ", cardLabels.Select(x => x.LabelName))}")"
                                     data-bs-toggle="modal"

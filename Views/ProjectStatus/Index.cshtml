        .project-status-donut-stage {
            position: relative;
            min-height: 360px;
            display: grid;
            place-items: center;
            margin: 6px 0 18px;
        }

        .project-status-donut {
            position: relative;
            width: min(410px, 76%);
            aspect-ratio: 1;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: var(--pie);
            box-shadow:
                inset 0 0 0 2px rgba(255, 255, 255, .78),
                0 26px 38px rgba(64, 79, 112, .12);
        }

        .project-status-donut::before {
            content: "";
            position: absolute;
            inset: 24%;
            border-radius: 50%;
            background:
                radial-gradient(circle at 45% 38%, rgba(255, 255, 255, .96), rgba(255, 255, 255, .9) 58%, rgba(245, 248, 253, .96) 100%);
            box-shadow:
                inset 0 10px 20px rgba(15, 23, 42, .06),
                0 0 0 1px rgba(255, 255, 255, .86);
        }

        .project-status-donut::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background:
                radial-gradient(circle at 34% 24%, rgba(255, 255, 255, .28), transparent 28%),
                linear-gradient(135deg, rgba(255, 255, 255, .26), transparent 42%);
            mix-blend-mode: soft-light;
            pointer-events: none;
        }

        .project-status-donut__inner {
            position: relative;
            z-index: 1;
            display: grid;
            justify-items: center;
            text-align: center;
        }

        .project-status-donut__mark {
            width: 34px;
            height: 28px;
            margin-bottom: 12px;
            opacity: .22;
            background:
                linear-gradient(#94a3b8, #94a3b8) 5px 13px / 7px 15px no-repeat,
                linear-gradient(#94a3b8, #94a3b8) 14px 7px / 7px 21px no-repeat,
                linear-gradient(#94a3b8, #94a3b8) 23px 2px / 7px 26px no-repeat;
            border: 4px solid #94a3b8;
            border-radius: 5px;
        }

        .project-status-donut__inner strong {
            color: #111b35;
            font-size: clamp(56px, 6vw, 88px);
            line-height: .9;
            font-weight: 900;
        }

        .project-status-donut__inner b {
            margin-top: 10px;
            color: #66728a;
            font-size: 18px;
            font-weight: 900;
        }

        .project-status-donut__inner i {
            width: 34px;
            height: 2px;
            margin: 12px 0 10px;
            background: #d9e0ea;
        }

        .project-status-donut__inner em {
            display: inline-flex;
            gap: 12px;
            font-style: normal;
        }

        .project-status-donut__inner em span {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--dot);
        }

        .donut-side-label {
            position: absolute;
            z-index: 2;
            display: grid;
            gap: 4px;
            color: #172033;
            font-weight: 900;
        }

        .donut-side-label strong {
            color: var(--label-color);
            font-size: clamp(30px, 3.4vw, 42px);
            line-height: 1;
        }

        .donut-side-label b {
            font-size: 17px;
        }

        .donut-side-label span {
            color: #59657b;
            font-size: 15px;
        }

        .donut-side-label::before,
        .donut-side-label::after {
            content: "";
            position: absolute;
            top: 40px;
            background: var(--label-color);
        }

        .donut-side-label::before {
            width: 62px;
            height: 2px;
            border-top: 2px dashed var(--label-color);
            background: transparent;
        }

        .donut-side-label::after {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }

        .donut-side-label--right {
            right: max(2%, 12px);
            top: 45%;
        }

        .donut-side-label--right::before {
            right: 100%;
            margin-right: 14px;
        }

        .donut-side-label--right::after {
            right: calc(100% + 72px);
            transform: translateY(-5px);
        }

        .donut-side-label--left {
            left: max(2%, 12px);
            top: 56%;
            text-align: left;
        }

        .donut-side-label--left::before {
            left: 100%;
            margin-left: 14px;
        }

        .donut-side-label--left::after {
            left: calc(100% + 72px);
            transform: translateY(-5px);
        }

        .project-status-summary-grid {

@model ProjectTracking.ViewModels.ProjectStatusDetailViewModel
@using System.Globalization

@{
    ViewData["Title"] = "รายละเอียดสถานะโครงการ";
    var statusPage = Model ?? new ProjectTracking.ViewModels.ProjectStatusDetailViewModel();
    var bdmGroups = statusPage.TeamGroups
        .Where(x => x.ClassName == "business-development-manager")
        .ToList();
    var managerGroups = statusPage.TeamGroups
        .Where(x => x.ClassName == "project-manager")
        .ToList();
    var baGroups = statusPage.TeamGroups
        .Where(x => x.ClassName == "project-manager-it" || x.ClassName == "business-analyst")
        .ToList();
    var baLevelMembers = baGroups
        .SelectMany(x => x.Members)
        .ToList();
    var researchGroups = statusPage.TeamGroups
        .Where(x => x.ClassName == "research-and-development")
        .ToList();
    var otherTeamGroups = statusPage.TeamGroups
        .Where(x => x.ClassName != "business-development-manager"
            && x.ClassName != "project-manager"
            && x.ClassName != "project-manager-it"
            && x.ClassName != "business-analyst"
            && x.ClassName != "research-and-development")
        .ToList();
    var otherTeamMembers = otherTeamGroups
        .SelectMany(x => x.Members)
        .ToList();
    var hasTeamMembers = statusPage.TeamGroups.Any(x => x.Members.Count > 0);
    string PercentText(decimal value) => value.ToString("0.#", CultureInfo.InvariantCulture);
    var completedMetric = statusPage.StatusMetrics.FirstOrDefault(x => x.Label.Contains("เสร็จ")) ?? new ProjectTracking.ViewModels.ProjectStatusMetric { Label = "เสร็จสิ้น", Color = "#18c57a" };
    var progressMetric = statusPage.StatusMetrics.FirstOrDefault(x => x.Label.Contains("กำลัง")) ?? new ProjectTracking.ViewModels.ProjectStatusMetric { Label = "กำลังดำเนินการ", Color = "#f59e0b" };
    var planMetric = statusPage.StatusMetrics.FirstOrDefault(x => x.Label.Contains("วาง")) ?? new ProjectTracking.ViewModels.ProjectStatusMetric { Label = "วางแผน", Color = "#2f8ee8" };
    var statusCardMetrics = new[]
    {
        new { Metric = completedMetric, ClassName = "completed", Icon = "✓" },
        new { Metric = progressMetric, ClassName = "progressing", Icon = "◔" },
        new { Metric = planMetric, ClassName = "planning", Icon = "□" }
    };
    var taskOverviewTotalEmployees = statusPage.TaskOverview.Count;
    var taskOverviewTotalTasks = statusPage.TaskOverview.Sum(x => x.TotalCount);
    var taskOverviewDoneTasks = statusPage.TaskOverview.Sum(x => x.DoneCount);
    var taskOverviewWorkingTasks = statusPage.TaskOverview.Sum(x => x.InProgressCount);
    var taskOverviewDelayTasks = statusPage.TaskOverview.Sum(x => x.DelayCount);
    var taskOverviewDonePercent = taskOverviewTotalTasks <= 0 ? 0 : Math.Round(taskOverviewDoneTasks * 100m / taskOverviewTotalTasks, 2);
    var taskOverviewWorkingPercent = taskOverviewTotalTasks <= 0 ? 0 : Math.Round(taskOverviewWorkingTasks * 100m / taskOverviewTotalTasks, 2);
    var taskOverviewDelayPercent = taskOverviewTotalTasks <= 0 ? 0 : Math.Round(taskOverviewDelayTasks * 100m / taskOverviewTotalTasks, 2);
    var taskOverviewAxisMax = 25;
    var taskOverviewAxisTicks = Enumerable.Range(0, 6)
        .Select(i => taskOverviewAxisMax - (i * 5))
        .ToList();
    var taskOverviewFirstChartCount = (int)Math.Ceiling(statusPage.TaskOverview.Count / 2m);
    var taskOverviewGroups = statusPage.TaskOverview
        .Select((member, index) => new { Member = member, Index = index })
        .GroupBy(x => x.Index < taskOverviewFirstChartCount ? 0 : 1)
        .Select(group => group.Select(x => x.Member).ToList())
        .Where(group => group.Count > 0)
        .ToList();
    var weeklyTotalTasks = statusPage.ThisWeekTasks.Count;
    var weeklyDoneTasks = statusPage.ThisWeekTasks.Count(x => x.StatusClass == "done");
    var weeklyDelayTasks = statusPage.ThisWeekTasks.Count(x => x.StatusClass == "stuck");
    var weeklyWorkingTasks = statusPage.ThisWeekTasks.Count(x => x.StatusClass == "working");
    var weeklyNearDueTasks = Math.Max(0, weeklyTotalTasks - weeklyDoneTasks - weeklyDelayTasks);
}

<div class="project-status-page">
    <header class="project-status-header index-hero">
        <div class="index-hero__content">
            <span class="index-eyebrow">ProjectTracking</span>
            <h1 class="index-title">ทีมงานและสถานะโครงการ</h1>
            <p class="index-subtitle">@statusPage.SelectedProjectName</p>
        </div>
        <div class="project-status-actions index-actions">
            <a asp-controller="Home" asp-action="Index" class="status-back-link">กลับ Dashboard</a>
        </div>
    </header>

    <div class="card shadow-sm border-0 rounded-4 mb-3 project-status-filter-card">
        <div class="card-body py-3">
            <div class="row g-3 align-items-end">
                <div class="col-12">
                    <label for="projectId" class="form-label fw-bold">📁 โครงการ</label>
                    <form asp-controller="ProjectStatus" asp-action="Index" method="get" class="project-filter-form">
                        <select id="projectId"
                                name="projectId"
                                class="form-select rounded-3"
                                onchange="this.form.submit()">
                            <option value="">ทุกโครงการ</option>
                            @foreach (var project in statusPage.ProjectOptions)
                            {
                                if (statusPage.SelectedProjectId == project.ProjectId)
                                {
                                    <option value="@project.ProjectId" selected>@project.ProjectName</option>
                                }
                                else
                                {
                                    <option value="@project.ProjectId">@project.ProjectName</option>
                                }
                            }
                        </select>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <section class="team-project-board" aria-label="ทีมงานและสถานะโครงการ">
        <div class="status-left-column">
            <article class="status-board-card status-pie-card">
                <div class="project-status-showcase">
                    <div class="project-status-showcase__head">
                        <div class="project-status-showcase__icon" aria-hidden="true">
                            <span></span>
                        </div>
                        <div>
                            <h2>สถานะโครงการ</h2>
                            <p>ภาพรวมสถานะของโครงการทั้งหมด</p>
                        </div>
                    </div>

                    <div class="project-status-total-card" aria-label="โครงการทั้งหมด">
                        <span>โครงการทั้งหมด</span>
                        <strong>@statusPage.TotalProjects</strong>
                        <small>โครงการ</small>
                    </div>
                </div>

                <div class="project-status-donut-stage">
                    @if (completedMetric.Count > 0)
                    {
                        <div class="donut-side-label donut-side-label--right" style="--label-color:@completedMetric.Color;">
                            <strong>@PercentText(completedMetric.Percent)%</strong>
                            <b>@completedMetric.Label</b>
                            <span>@completedMetric.Count โครงการ</span>
                        </div>
                    }

                    @if (progressMetric.Count > 0)
                    {
                        <div class="donut-side-label donut-side-label--left" style="--label-color:@progressMetric.Color;">
                            <strong>@PercentText(progressMetric.Percent)%</strong>
                            <b>@progressMetric.Label</b>
                            <span>@progressMetric.Count โครงการ</span>
                        </div>
                    }

                    @if (planMetric.Count > 0)
                    {
                        <div class="donut-side-label donut-side-label--plan" style="--label-color:@planMetric.Color;">
                            <strong>@PercentText(planMetric.Percent)%</strong>
                            <b>@planMetric.Label</b>
                            <span>@planMetric.Count โครงการ</span>
                        </div>
                    }

                    <div class="project-status-donut" style="--pie:@statusPage.ProjectStatusChart;">
                        <div class="project-status-donut__inner">
                            <span class="project-status-donut__mark" aria-hidden="true"></span>
                            <strong>@statusPage.TotalProjects</strong>
                            <b>โครงการทั้งหมด</b>
                            <i></i>
                            <em>
                                @foreach (var metric in statusPage.StatusMetrics)
                                {
                                    <span style="--dot:@metric.Color;"></span>
                                }
                            </em>
                        </div>
                    </div>
                </div>

                <div class="project-status-summary-grid">
                    @foreach (var item in statusCardMetrics)
                    {
                        <div class="project-status-summary-card project-status-summary-card--@item.ClassName" style="--status-color:@item.Metric.Color;">
                            <span class="project-status-summary-card__icon">@item.Icon</span>
                            <b>@item.Metric.Label</b>
                            <strong>@item.Metric.Count</strong>
                            <small>โครงการ</small>
                            <div class="project-status-mini-progress">
                                <span style="width:@PercentText(item.Metric.Percent)%;"></span>
                                <em>@PercentText(item.Metric.Percent)%</em>
                            </div>
                        </div>
                    }
                </div>
            </article>

            <article class="status-board-card task-overview-card">
                <div class="light-report-head">
                    <div class="light-report-title">
                        <span class="light-report-icon light-report-icon--people" aria-hidden="true"></span>
                        <div>
                            <h2>ภาพรวมงานตามผู้รับผิดชอบ</h2>
                            <p>สรุปสถานะงานทั้งหมดของแต่ละผู้รับผิดชอบ</p>
                        </div>
                    </div>
                </div>

                <div class="task-chart-legend">
                    <span><i class="done"></i>เสร็จแล้ว</span>
                    <span><i class="working"></i>กำลังทำ</span>
                    <span><i class="stuck"></i>ล่าช้า</span>
                </div>

                @if (statusPage.TaskOverview.Count == 0)
                {
                    <p class="status-empty">ยังไม่มีข้อมูลงานสำหรับแสดงผล</p>
                }
                else
                {
                    <div class="task-overview-plots">
                        @foreach (var chartMembers in taskOverviewGroups)
                        {
                            <div class="task-overview-plot" style="--task-axis-max:@taskOverviewAxisMax;">
                                <div class="task-y-axis" aria-hidden="true">
                                    <span class="task-y-title">จำนวนงาน (งาน)</span>
                                    @foreach (var tick in taskOverviewAxisTicks)
                                    {
                                        var tickPosition = Math.Round((taskOverviewAxisMax - tick) * 100m / taskOverviewAxisMax, 3);
                                        <span style="--tick:@tickPosition.ToString("0.###", CultureInfo.InvariantCulture);">@tick</span>
                                    }
                                </div>
                                <div class="task-overview-scroll">
                                    <div class="task-overview-chart" style="--task-count:@chartMembers.Count; --task-min-width:@(Math.Max(1, chartMembers.Count) * 106)px;">
                                        @foreach (var member in chartMembers)
                                        {
                                            var doneHeight = Math.Round(Math.Min(member.DoneCount, taskOverviewAxisMax) * 100m / taskOverviewAxisMax, 3);
                                            var workingHeight = Math.Round(Math.Min(member.InProgressCount, taskOverviewAxisMax) * 100m / taskOverviewAxisMax, 3);
                                            var delayHeight = Math.Round(Math.Min(member.DelayCount, taskOverviewAxisMax) * 100m / taskOverviewAxisMax, 3);
                                            <div class="task-overview-item" title="@member.Name">
                                                <div class="task-stack-frame" aria-label="@member.Name เสร็จแล้ว @member.DoneCount งาน กำลังทำ @member.InProgressCount งาน ล่าช้า @member.DelayCount งาน">
                                                    <span class="task-single-bar done @(member.DoneCount == 0 ? "is-zero" : "")"
                                                          title="เสร็จแล้ว @member.DoneCount งาน"
                                                          style="--bar-height:@doneHeight.ToString("0.###", CultureInfo.InvariantCulture)%;">
                                                        <em>@member.DoneCount</em>
                                                        <i></i>
                                                    </span>
                                                    <span class="task-single-bar working @(member.InProgressCount == 0 ? "is-zero" : "")"
                                                          title="กำลังทำ @member.InProgressCount งาน"
                                                          style="--bar-height:@workingHeight.ToString("0.###", CultureInfo.InvariantCulture)%;">
                                                        <em>@member.InProgressCount</em>
                                                        <i></i>
                                                    </span>
                                                    <span class="task-single-bar stuck @(member.DelayCount == 0 ? "is-zero" : "")"
                                                          title="ล่าช้า @member.DelayCount งาน"
                                                          style="--bar-height:@delayHeight.ToString("0.###", CultureInfo.InvariantCulture)%;">
                                                        <em>@member.DelayCount</em>
                                                        <i></i>
                                                    </span>
                                                </div>
                                                <div class="task-member-card">
                                                    <small>รวม @member.TotalCount งาน</small>
                                                    <img class="js-profile-preview"
                                                         src="@member.AvatarPath"
                                                         alt="@member.Name"
                                                         data-profile-name="@member.Name"
                                                         onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                                    <b>@member.Name</b>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        <span class="task-x-title" aria-hidden="true">ผู้รับผิดชอบ</span>
                    </div>

                    <div class="task-overview-footer">
                        <span class="footer-info">ⓘ</span>
                        <span>รวมทั้งหมด <b>@taskOverviewTotalEmployees</b> คน</span>
                        <span>รวมงานทั้งหมด <b>@taskOverviewTotalTasks</b> งาน</span>
                        <span class="footer-status footer-status--done"><i></i>เสร็จแล้ว <b>@taskOverviewDoneTasks</b> งาน (@PercentText(taskOverviewDonePercent)%)</span>
                        <span class="footer-status footer-status--working"><i></i>กำลังทำ <b>@taskOverviewWorkingTasks</b> งาน (@PercentText(taskOverviewWorkingPercent)%)</span>
                        <span class="footer-status footer-status--stuck"><i></i>ล่าช้า <b>@taskOverviewDelayTasks</b> งาน (@PercentText(taskOverviewDelayPercent)%)</span>
                    </div>
                }
            </article>
        </div>

        <div class="status-right-column">
            <article class="status-board-card org-chart-card">
                <div class="light-report-head">
                    <div class="light-report-title">
                        <span class="light-report-icon light-report-icon--team" aria-hidden="true"></span>
                        <div>
                            <h2>แผนผัง ทีมพัฒนาระบบ</h2>
                            <p>ภาพรวมทีมและบทบาทผู้รับผิดชอบในโครงการ</p>
                        </div>
                    </div>
                </div>

                <div class="role-lane-board">
                    @if (!hasTeamMembers)
                    {
                        <p class="system-team-empty">ยังไม่มีข้อมูลทีม</p>
                    }

                    @foreach (var group in bdmGroups)
                    {
                        @if (group.Members.Count > 0)
                        {
                            <section class="role-lane role-lane-@group.ClassName">
                                <div class="role-lane-head">
                                    <span>Business</span>
                                    <h3>@group.Label</h3>
                                    <b>@group.Members.Count คน</b>
                                </div>
                                <div class="role-member-grid">
                                    @foreach (var member in group.Members)
                                    {
                                        <div class="role-member-card">
                                            <img class="js-profile-preview"
                                                 src="@member.AvatarPath"
                                                 alt="@member.Name"
                                                 data-profile-name="@member.Name"
                                                 onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                            <div>
                                                <b>@member.Name</b>
                                                <small>@member.Role</small>
                                                @if (member.WorkCount > 0)
                                                {
                                                    <em>@member.WorkCount งาน</em>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    }

                    @foreach (var group in managerGroups)
                    {
                        @if (group.Members.Count > 0)
                        {
                            <section class="role-lane role-lane-@group.ClassName">
                                <div class="role-lane-head">
                                    <span>Management</span>
                                    <h3>@group.Label</h3>
                                    <b>@group.Members.Count คน</b>
                                </div>
                                <div class="role-member-grid">
                                    @foreach (var member in group.Members)
                                    {
                                        <div class="role-member-card">
                                            <img class="js-profile-preview"
                                                 src="@member.AvatarPath"
                                                 alt="@member.Name"
                                                 data-profile-name="@member.Name"
                                                 onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                            <div>
                                                <b>@member.Name</b>
                                                <small>@member.Role</small>
                                                @if (member.WorkCount > 0)
                                                {
                                                    <em>@member.WorkCount งาน</em>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    }

                    @if (baLevelMembers.Count > 0)
                    {
                        <section class="role-lane role-lane-analyst-tier">
                            <div class="role-lane-head">
                                <span>Analysis</span>
                                <h3>Project Manager IT / Business Analyst</h3>
                                <b>@baLevelMembers.Count คน</b>
                            </div>
                            <div class="role-member-grid">
                                @foreach (var member in baLevelMembers)
                                {
                                    <div class="role-member-card">
                                        <img class="js-profile-preview"
                                             src="@member.AvatarPath"
                                             alt="@member.Name"
                                             data-profile-name="@member.Name"
                                             onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                        <div>
                                            <b>@member.Name</b>
                                            <small>@member.Role</small>
                                            @if (member.WorkCount > 0)
                                            {
                                                <em>@member.WorkCount งาน</em>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @foreach (var group in researchGroups)
                    {
                        @if (group.Members.Count > 0)
                        {
                            <section class="role-lane role-lane-@group.ClassName">
                                <div class="role-lane-head">
                                    <span>Research</span>
                                    <h3>@group.Label</h3>
                                    <b>@group.Members.Count คน</b>
                                </div>
                                <div class="role-member-grid">
                                    @foreach (var member in group.Members)
                                    {
                                        <div class="role-member-card">
                                            <img class="js-profile-preview"
                                                 src="@member.AvatarPath"
                                                 alt="@member.Name"
                                                 data-profile-name="@member.Name"
                                                 onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                            <div>
                                                <b>@member.Name</b>
                                                <small>@member.Role</small>
                                                @if (member.WorkCount > 0)
                                                {
                                                    <em>@member.WorkCount งาน</em>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    }

                    @if (otherTeamMembers.Count > 0)
                    {
                        <section class="role-lane role-lane-operation">
                            <div class="role-lane-head">
                                <span>Delivery</span>
                                <h3>ทีมปฏิบัติการ</h3>
                                <b>@otherTeamMembers.Count คน</b>
                            </div>
                            <div class="role-member-grid">
                                @foreach (var member in otherTeamMembers)
                                {
                                    <div class="role-member-card">
                                        <img class="js-profile-preview"
                                             src="@member.AvatarPath"
                                             alt="@member.Name"
                                             data-profile-name="@member.Name"
                                             onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                        <div>
                                            <b>@member.Name</b>
                                            <small>@member.Role</small>
                                            @if (member.WorkCount > 0)
                                            {
                                                <em>@member.WorkCount งาน</em>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                </div>
            </article>

            <article class="status-board-card week-task-card">
                <div class="light-report-head">
                    <div class="light-report-title">
                        <span class="light-report-icon light-report-icon--tasks" aria-hidden="true"></span>
                        <div>
                            <h2>งานสัปดาห์นี้</h2>
                            <p>ติดตามความคืบหน้าและกำหนดส่งงาน</p>
                        </div>
                    </div>
                    <div class="light-date-pill">
                        <span aria-hidden="true">▣</span>
                        @statusPage.WeekRangeText
                    </div>
                </div>

                @if (statusPage.ThisWeekTasks.Count == 0)
                {
                    <p class="status-empty">สัปดาห์นี้ยังไม่มีงานตามแผน</p>
                }
                else
                {
                    <div class="week-task-table-wrap">
                        <table class="week-task-table">
                            <thead>
                                <tr>
                                    <th>งาน</th>
                                    <th>ผู้รับผิดชอบ</th>
                                    <th>กำหนดส่ง</th>
                                    <th>สถานะ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in statusPage.ThisWeekTasks)
                                {
                                    <tr class="week-row-@task.StatusClass">
                                        <td>
                                            <span class="week-task-icon @task.StatusClass" aria-hidden="true">□</span>
                                            <span class="week-task-copy">
                                                <b>@task.Title</b>
                                                <small>@task.ProjectName</small>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="task-owner">
                                                <img class="js-profile-preview"
                                                     src="@task.AvatarPath"
                                                     alt="@task.OwnerName"
                                                     data-profile-name="@task.OwnerName"
                                                     onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                                @task.OwnerName
                                            </span>
                                        </td>
                                        <td>@task.DueDateText</td>
                                        <td><span class="week-status @task.StatusClass">@task.StatusText</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="week-task-footer">
                        <span><i class="week-total-icon"></i>รวมทั้งหมด <b>@weeklyTotalTasks</b> งาน</span>
                        <span><i class="near"></i>ใกล้ถึงกำหนด <b>@weeklyNearDueTasks</b> งาน</span>
                        <span class="week-foot-status stuck"><i></i>ล่าช้า <b>@weeklyDelayTasks</b> งาน</span>
                        <span class="week-foot-status working"><i></i>กำลังทำ <b>@weeklyWorkingTasks</b> งาน</span>
                        <span class="week-foot-status done"><i></i>เสร็จสิ้น <b>@weeklyDoneTasks</b> งาน</span>
                    </div>
                }
            </article>
        </div>
    </section>
</div>

@section Styles {
    <style>
        .project-status-page {
            min-height: calc(100vh - 60px);
            padding: 8px 2px 34px;
            color: #1f2937;
        }

        .project-status-page,
        .project-status-page * {
            box-sizing: border-box;
        }

        .project-status-header:not(.index-hero) {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 18px;
            margin: 0 0 18px;
            padding: 0 2px;
        }

        .project-status-header:not(.index-hero) span {
            display: block;
            color: #64748b;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .project-status-header:not(.index-hero) h1 {
            margin: 2px 0 0;
            color: #222831;
            font-size: 34px;
            line-height: 1.05;
            font-weight: 900;
            letter-spacing: 0;
        }


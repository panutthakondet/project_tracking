        .project-status-showcase__icon span::before {
            content: "";
            position: absolute;
            right: -4px;
            top: -4px;
            width: 13px;
            height: 13px;
            border-left: 4px solid #17b978;
            border-bottom: 4px solid #17b978;
            background: #eafff5;
            border-radius: 0 8px 0 4px;

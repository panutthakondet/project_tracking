        .project-status-showcase__icon span::after {
            content: "";
            position: absolute;
            right: 2px;
            bottom: 4px;
            width: 22px;
            height: 18px;
            background:
                linear-gradient(#17b978, #17b978) 0 10px / 5px 8px no-repeat,
                linear-gradient(#17b978, #17b978) 8px 4px / 5px 14px no-repeat,
                linear-gradient(#17b978, #17b978) 16px 0 / 5px 18px no-repeat;

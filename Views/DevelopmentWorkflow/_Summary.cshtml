@model ProjectTracking.Models.DevelopmentWorkflowViewModel
<div class="workflow-summary">
 <div><span>TOR Checklist</span><strong>@Model.TorPercent%</strong><div class="workflow-progress"><i style="width:@Model.TorPercent%"></i></div></div>
 <div><span>Dev Self Test</span><strong>@Model.DevPercent%</strong><div class="workflow-progress"><i style="width:@Model.DevPercent%"></i></div></div>
 <div><span>BA Verification</span><strong>@Model.BaPercent%</strong><div class="workflow-progress"><i style="width:@Model.BaPercent%"></i></div></div>
 <div class="workflow-total"><span>ความคืบหน้ารวม</span><strong>@Model.TotalPercent%</strong><small>TOR 50% · Dev 25% · BA 25%</small></div>
</div>

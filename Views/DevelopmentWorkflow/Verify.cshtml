@model ProjectTracking.Models.DevelopmentWorkflowViewModel
@{ ViewData["Title"] = "BA Verification Test"; }
<div class="index-hero"><div class="index-hero__content"><span class="index-eyebrow">BA Verification</span><h2 class="index-title">@Model.Assignment.Role</h2><p class="index-subtitle">@Model.Project.ProjectDisplayName · Dev: @Model.Employee.EmpName</p></div><div class="index-hero__actions"><a asp-action="BaQueue" class="btn btn-outline-light">กลับคิว BA</a></div></div>
<partial name="_Summary" model="Model" />
<section class="workflow-section"><div class="workflow-section-head"><div><h3>ผล Checklist จาก Dev</h3><p>ใช้ประกอบการ Verification</p></div><strong>@Model.TorItems.Count(x => x.Status == "COMPLETED")/@Model.TorItems.Count</strong></div>
@foreach (var row in Model.TorItems) { <div class="workflow-review-row"><span>@(row.Status == "COMPLETED" ? "✓" : "○")</span><div><b>@row.Item.TorCode @row.Item.Title</b><small>@row.Remark</small></div></div> }
</section>
<section class="workflow-section"><div class="workflow-section-head"><div><h3>BA Verification Test</h3><p>ทดสอบ Scenario ชุดเดิมและบันทึกผลของ BA แยกจาก Dev</p></div><strong>@Model.Scenarios.Count(x => x.BaRun?.ResultStatus == "PASS")/@Model.Scenarios.Count</strong></div>
@foreach (var row in Model.Scenarios) {
 <form asp-action="SaveBaTest" method="post" class="workflow-test-row">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Assignment.AssignId"/><input type="hidden" name="scenarioId" value="@row.Scenario.scenario_id"/>
  <div><b>@row.Scenario.scenario_code · @row.Scenario.title</b><small>Dev: <strong>@(row.DevRun?.ResultStatus ?? "-")</strong> @row.DevRun?.Remark</small><small><strong>ผลที่คาดหวัง:</strong> @row.Scenario.expected_result</small></div>
  <select name="resultStatus" class="form-select"><option value="PASS">ผ่าน</option><option value="FAIL">ไม่ผ่าน</option><option value="BLOCKED">ติดปัญหา</option></select><input name="remark" value="@row.BaRun?.Remark" class="form-control" placeholder="ผลตรวจ/เหตุผลส่งกลับ"/><button class="btn btn-primary btn-sm">บันทึกผล</button>
  <span class="workflow-result workflow-result--@(row.BaRun?.ResultStatus?.ToLowerInvariant() ?? "ready")">@(row.BaRun?.ResultStatus ?? "ยังไม่ทดสอบ")</span>
 </form>
}
</section>
<div class="workflow-submit"><form asp-action="ReturnToDev" method="post" onsubmit="return confirm('ส่งงานกลับให้ Dev แก้ไข?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Assignment.AssignId"/><button class="btn btn-danger">ส่งกลับ Dev</button></form><form asp-action="Complete" method="post" onsubmit="return confirm('ยืนยันว่าผ่านครบและปิดงาน?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Assignment.AssignId"/><button class="btn btn-success" disabled="@(Model.BaPercent < 100)">ผ่านครบและปิดงาน</button></form></div>

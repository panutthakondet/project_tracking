@model ProjectTracking.Models.DevelopmentWorkflowViewModel
@{ ViewData["Title"] = "Dev Checklist และ Self Test"; }
<div class="index-hero"><div class="index-hero__content"><span class="index-eyebrow">Development Workflow</span><h2 class="index-title">@Model.Assignment.Role</h2><p class="index-subtitle">@Model.Project.ProjectDisplayName · @Model.Phase.PhaseDisplayName · @Model.Employee.EmpName</p></div><div class="index-hero__actions"><a asp-action="Index" class="btn btn-outline-light">กลับ</a></div></div>
<partial name="_Summary" model="Model" />
<section class="workflow-section"><div class="workflow-section-head"><div><h3>1. Checklist ตาม TOR</h3><p>ตรวจสอบสิ่งที่พัฒนาเทียบกับ TOR</p></div><strong>@Model.TorItems.Count(x => x.Status == "COMPLETED")/@Model.TorItems.Count</strong></div>
@if (!Model.TorItems.Any()) { <div class="workflow-empty">งานนี้ยังไม่ได้ผูกรายการ TOR</div> }
@foreach (var row in Model.TorItems) {
 <form asp-action="SaveTor" method="post" class="workflow-item">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Assignment.AssignId"/><input type="hidden" name="torItemId" value="@row.Item.TorItemId"/>
  <label><input type="checkbox" name="completed" value="true" checked="@(row.Status == "COMPLETED")"/><span><b>@row.Item.TorCode @row.Item.Title</b><small>@row.Item.AcceptanceCriteria</small></span></label>
  <input name="remark" value="@row.Remark" class="form-control" placeholder="หมายเหตุการตรวจ"/><button class="btn btn-outline-primary btn-sm">บันทึก</button>
 </form>
}
</section>
<section class="workflow-section"><div class="workflow-section-head"><div><h3>2. Dev Self Test</h3><p>ทดสอบตาม Scenario ก่อนส่งให้ BA</p></div><strong>@Model.Scenarios.Count(x => x.DevRun?.ResultStatus == "PASS")/@Model.Scenarios.Count</strong></div>
@if (!Model.Scenarios.Any()) { <div class="workflow-empty">งานนี้ยังไม่ได้ผูก Test Scenario</div> }
@foreach (var row in Model.Scenarios) {
 <form asp-action="SaveDevTest" method="post" class="workflow-test-row">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Assignment.AssignId"/><input type="hidden" name="scenarioId" value="@row.Scenario.scenario_id"/>
  <div><b>@row.Scenario.scenario_code · @row.Scenario.title</b><small><strong>ขั้นตอน:</strong> @row.Scenario.steps</small><small><strong>ผลที่คาดหวัง:</strong> @row.Scenario.expected_result</small></div>
  <select name="resultStatus" class="form-select"><option value="PASS">ผ่าน</option><option value="FAIL">ไม่ผ่าน</option><option value="BLOCKED">ติดปัญหา</option></select><input name="remark" value="@row.DevRun?.Remark" class="form-control" placeholder="ผลทดสอบ/หมายเหตุ"/><button class="btn btn-primary btn-sm">บันทึกผล</button>
  <span class="workflow-result workflow-result--@(row.DevRun?.ResultStatus?.ToLowerInvariant() ?? "ready")">@(row.DevRun?.ResultStatus ?? "ยังไม่ทดสอบ")</span>
 </form>
}
</section>
<div class="workflow-submit"><div><strong>ส่งให้ BA ทดสอบ</strong><span>เปิดได้เมื่อ TOR และ Dev Test ผ่านครบ 100%</span></div><form asp-action="SubmitToBa" method="post" onsubmit="return confirm('ยืนยันส่งงานให้ BA ทดสอบ?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Assignment.AssignId"/><button class="btn btn-success" disabled="@(Model.TorPercent < 100 || Model.DevPercent < 100)">ส่งให้ BA</button></form></div>

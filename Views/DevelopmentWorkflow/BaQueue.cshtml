@model IEnumerable<ProjectTracking.Models.DevelopmentQueueRow>
@{ ViewData["Title"] = "งานรอ BA ทดสอบ"; }
<div class="index-hero"><div class="index-hero__content"><span class="index-eyebrow">Quality</span><h2 class="index-title">งานรอ BA ทดสอบ</h2><p class="index-subtitle">ตรวจยืนยันด้วย Test Scenario ชุดเดียวกับ Dev</p></div></div>
<div class="workflow-list">
@if (!Model.Any()) { <div class="workflow-empty">ไม่มีงานรอ BA ทดสอบ</div> }
@foreach (var row in Model) {
 <a asp-action="Verify" asp-route-id="@row.AssignId" class="workflow-list-row">
   <div><div class="workflow-project">@row.ProjectName</div><div class="workflow-muted">@row.PhaseName · @row.WorkName · Dev: @row.EmployeeName</div></div>
   <span class="workflow-status">@(row.WorkflowStatus == "READY_FOR_BA" ? "รอทดสอบ" : "กำลังทดสอบ")</span>
 </a>
}
</div>

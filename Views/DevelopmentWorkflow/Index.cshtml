@model IEnumerable<ProjectTracking.Models.DevelopmentQueueRow>
@{ ViewData["Title"] = "งาน Dev ตาม TOR"; }
<div class="index-hero"><div class="index-hero__content"><span class="index-eyebrow">Development</span><h2 class="index-title">งาน Dev ตาม TOR</h2><p class="index-subtitle">Checklist TOR และ Self Test ก่อนส่ง BA</p></div></div>
<div class="workflow-list">
@if (!Model.Any()) { <div class="workflow-empty">ยังไม่มีงานที่มอบหมาย</div> }
@foreach (var row in Model) {
 <a asp-action="Dev" asp-route-id="@row.AssignId" class="workflow-list-row">
   <div><div class="workflow-project">@row.ProjectName</div><div class="workflow-muted">@row.PhaseName · @row.WorkName</div></div>
   <span class="workflow-status workflow-status--@row.WorkflowStatus.ToLowerInvariant()">@WorkflowLabel(row.WorkflowStatus)</span>
 </a>
}
</div>
@functions { string WorkflowLabel(string s) => s switch { "IN_DEVELOPMENT" => "กำลังพัฒนา", "DEV_TESTING" => "Dev กำลังทดสอบ", "READY_FOR_BA" => "รอ BA ทดสอบ", "BA_TESTING" => "BA กำลังทดสอบ", "REWORK" => "ส่งกลับแก้ไข", "COMPLETED" => "เสร็จสิ้น", _ => s }; }

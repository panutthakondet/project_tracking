@model ProjectTracking.ViewModels.AppearanceViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Theme & Appearance";
    var fontScale = Model.FontScale.ToString("0.00", CultureInfo.InvariantCulture);
}

@section Styles {
<style>
    .appearance-page {
        display: grid;
        gap: 22px;
        padding: 8px 0 28px;
        color: #0f172a;
    }

    .appearance-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        min-height: 148px;
        padding: 26px clamp(18px, 3vw, 34px);
        border-radius: 0;
        background: var(--pt-sidebar-bg);
        background:
            linear-gradient(135deg, color-mix(in srgb, var(--pt-sidebar-bg) 92%, #ffffff 8%), var(--pt-sidebar-deep)),
            var(--pt-sidebar-bg);
        color: var(--pt-sidebar-contrast);
        box-shadow: 0 18px 42px rgba(15, 23, 42, .16);
    }

    .appearance-hero__content {
        min-width: 0;
    }

    .appearance-eyebrow {
        margin: 0 0 6px;
        color: var(--pt-sidebar-contrast-muted);
        font-size: .78rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .appearance-title {
        margin: 0;
        color: var(--pt-sidebar-contrast);
        font-size: clamp(1.8rem, 3vw, 2.45rem);
        font-weight: 900;
        line-height: 1.15;
    }

    .appearance-subtitle {
        max-width: 720px;
        margin: 9px 0 0;
        color: var(--pt-sidebar-contrast-muted);
        font-size: .98rem;
        font-weight: 500;
        line-height: 1.55;
    }

    .appearance-reset-form {
        flex: 0 0 auto;
    }

    .appearance-reset {
        min-height: 42px;
        padding: 0 16px;
        border: 1px solid var(--pt-accent-dark);
        border-radius: 12px;
        color: var(--pt-accent-contrast);
        -webkit-text-fill-color: var(--pt-accent-contrast);
        background: linear-gradient(135deg, var(--pt-accent), var(--pt-accent-dark));
        box-shadow: 0 12px 24px var(--pt-accent-glow);
        font-weight: 800;
        transition: transform .16s ease, box-shadow .16s ease, filter .16s ease;
    }

    .appearance-reset:hover,
    .appearance-reset:focus {
        color: var(--pt-accent-contrast);
        -webkit-text-fill-color: var(--pt-accent-contrast);
        filter: brightness(1.04);
        transform: translateY(-1px);
        box-shadow: 0 16px 28px var(--pt-accent-glow);
    }

    .appearance-alert {
        padding: 14px 16px;
        border-radius: 12px;
        border: 1px solid rgba(31, 72, 137, .28);
        background: rgba(31, 72, 137, .12);
        color: #1F4889;
        font-weight: 800;
    }

    .appearance-alert.is-error {
        border-color: rgba(225, 29, 72, .25);
        background: rgba(225, 29, 72, .1);
        color: #be123c;
    }

    .appearance-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(320px, .7fr);
        gap: 22px;
        align-items: start;
    }

    .appearance-section,
    .appearance-preview {
        background: #fff;
        border: 1px solid rgba(148, 163, 184, .22);
        border-radius: 8px;
        box-shadow: 0 14px 34px rgba(15, 35, 64, .08);
    }

    .appearance-section {
        padding: 22px;
    }

    .appearance-section + .appearance-section {
        margin-top: 18px;
    }

    .appearance-section__head {
        margin-bottom: 16px;
    }

    .appearance-section__head h2,
    .appearance-preview h2 {
        margin: 0;
        color: #10233f;
        font-size: 1.12rem;
        font-weight: 900;
        line-height: 1.25;
    }

    .appearance-section__head p {
        margin: 6px 0 0;
        color: #64748b;
        font-weight: 500;
        line-height: 1.45;
    }

    .theme-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .theme-card {
        position: relative;
        min-height: 128px;
        display: grid;
        gap: 12px;
        padding: 14px;
        border: 1px solid #dbe4ef;
        border-radius: 8px;
        background: #fff;
        cursor: pointer;
        transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
    }

    .theme-card:hover,
    .theme-card.is-selected {
        transform: translateY(-1px);
        border-color: var(--pt-accent);
        box-shadow: 0 14px 28px rgba(15, 35, 64, .12);
    }

    .theme-card input {
        position: absolute;
        inset: 12px 12px auto auto;
        width: 18px;
        height: 18px;
        accent-color: var(--pt-accent);
    }

    .theme-swatch {
        display: grid;
        grid-template-columns: 1.1fr .85fr .85fr .85fr .85fr .85fr;
        gap: 6px;
        height: 54px;
    }

    .theme-swatch span {
        border-radius: 8px;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,.28);
    }

    .theme-name {
        margin: 0;
        color: #10233f;
        font-size: .96rem;
        font-weight: 900;
        line-height: 1.25;
    }

    .theme-default {
        width: max-content;
        padding: 3px 9px;
        border-radius: 999px;
        color: #1F4889;
        background: rgba(31, 72, 137, .13);
        font-size: .74rem;
        font-weight: 900;
    }

    .custom-toggle {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        color: #10233f;
        font-weight: 900;
    }

    .custom-toggle input {
        width: 18px;
        height: 18px;
        accent-color: var(--pt-accent);
    }

    .appearance-controls {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 14px;
    }

    .appearance-field {
        display: grid;
        gap: 7px;
    }

    .appearance-field label {
        color: #334155;
        font-size: .86rem;
        font-weight: 800;
    }

    .color-input {
        display: grid;
        grid-template-columns: 54px minmax(0, 1fr);
        align-items: center;
        gap: 10px;
        min-height: 52px;
        padding: 8px 10px;
        border: 1px solid #dbe4ef;
        border-radius: 8px;
        background: #f8fbff;
    }

    .color-input input[type="color"] {
        width: 42px;
        height: 34px;
        padding: 0;
        border: 0;
        border-radius: 8px;
        background: transparent;
    }

    .color-input input[type="text"] {
        width: 100%;
        min-height: 34px;
        border: 0;
        background: transparent;
        color: #10233f;
        font-weight: 800;
        outline: none;
        text-transform: uppercase;
    }

    .color-input.is-disabled {
        opacity: .58;
    }

    .dino-color-controls {
        margin-top: 14px;
    }

    .dino-name-input {
        min-height: 52px;
        padding: 8px 12px;
        border: 1px solid #dbe4ef;
        border-radius: 8px;
        color: #10233f;
        background: #f8fbff;
        font-weight: 800;
        outline: none;
    }

    .dino-name-input:focus {
        border-color: var(--pt-accent);
        box-shadow: 0 0 0 4px var(--pt-accent-soft);
    }

    .font-scale-row {
        display: grid;
        grid-template-columns: 1fr 60px;
        gap: 12px;
        align-items: center;
        min-height: 52px;
        padding: 0 2px;
    }

    .font-scale-row input {
        accent-color: var(--pt-accent);
    }

    .font-scale-value {
        color: #10233f;
        font-weight: 900;
        text-align: right;
    }

    .motion-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 66px;
        padding: 14px 16px;
        border: 1px solid #dbe4ef;
        border-radius: 8px;
        background: #f8fbff;
    }

    .motion-option strong {
        display: block;
        color: #10233f;
        font-size: .96rem;
        font-weight: 900;
        line-height: 1.25;
    }

    .motion-option small {
        display: block;
        margin-top: 4px;
        color: #64748b;
        font-weight: 500;
        line-height: 1.35;
    }

    .motion-switch {
        position: relative;
        flex: 0 0 58px;
        width: 58px;
        height: 32px;
    }

    .motion-switch input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .motion-switch span {
        position: absolute;
        inset: 0;
        border-radius: 999px;
        background: #cbd5e1;
        box-shadow: inset 0 1px 2px rgba(15, 23, 42, .18);
        cursor: pointer;
        transition: background .18s ease;
    }

    .motion-switch span::after {
        content: "";
        position: absolute;
        left: 4px;
        top: 4px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 5px 12px rgba(15, 23, 42, .18);
        transition: transform .18s ease;
    }

    .motion-switch input:checked + span {
        background: linear-gradient(135deg, var(--pt-accent), var(--pt-accent-dark));
    }

    .motion-switch input:checked + span::after {
        transform: translateX(26px);
    }

    .appearance-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 18px;
    }

    .appearance-save {
        min-height: 46px;
        min-width: 132px;
        border-radius: 12px !important;
        font-weight: 900 !important;
    }

    .appearance-preview {
        position: sticky;
        top: 16px;
        overflow: hidden;
    }

    .appearance-preview__head {
        padding: 18px 18px 0;
    }

    .preview-shell {
        margin: 16px 18px 18px;
        overflow: hidden;
        border: 1px solid rgba(148, 163, 184, .28);
        border-radius: 8px;
        background: var(--preview-body, #eef3f9);
    }

    .preview-nav {
        height: 58px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 14px;
        background: var(--preview-sidebar, #081c42);
        color: #fff;
    }

    .preview-logo {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--preview-accent, #1F4889), var(--preview-accent-dark, #193B70));
    }

    .preview-nav span {
        display: block;
        min-width: 0;
        color: #fff;
        font-weight: 900;
    }

    .preview-body {
        display: grid;
        grid-template-columns: 86px 1fr;
        min-height: 230px;
    }

    .preview-side {
        padding: 12px 10px;
        background: var(--preview-sidebar, #081c42);
    }

    .preview-profile-zone {
        height: 38px;
        margin-bottom: 10px;
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 8px;
        background: var(--preview-profile-panel, #081c42);
    }

    .preview-pill {
        height: 12px;
        margin-bottom: 9px;
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 8px;
        background: linear-gradient(180deg, var(--preview-menu-panel, #041F4E), var(--preview-menu-panel-deep, #031940));
    }

    .preview-pill.is-active {
        height: 28px;
        background: linear-gradient(135deg, var(--preview-accent, #1F4889), var(--preview-accent-dark, #193B70));
    }

    .preview-content {
        padding: 16px;
    }

    .preview-panel {
        display: grid;
        gap: 13px;
        padding: 16px;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 12px 24px rgba(15, 35, 64, .08);
    }

    .preview-line {
        height: 12px;
        border-radius: 999px;
        background: #e2e8f0;
    }

    .preview-line.is-title {
        width: 62%;
        height: 17px;
        background: #10233f;
    }

    .preview-line.is-short {
        width: 42%;
    }

    .preview-actions {
        display: flex;
        gap: 8px;
        margin-top: 2px;
    }

    .preview-dino-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        min-height: 32px;
        padding: 7px 10px;
        border: 1px solid rgba(15, 35, 64, .10);
        border-radius: 8px;
        background: color-mix(in srgb, var(--preview-chart-panel, #041F4E) 8%, #fff);
    }

    .preview-dino-name {
        max-width: 82px;
        padding: 2px 7px;
        border: 1px solid rgba(15, 35, 64, .16);
        border-radius: 999px;
        color: #10233f;
        background: #fff;
        font-size: .7rem;
        font-weight: 900;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .preview-dino {
        position: relative;
        width: 42px;
        height: 22px;
        color: var(--preview-dino-color, #fff);
        image-rendering: pixelated;
    }

    .preview-dino::before,
    .preview-dino::after {
        content: "";
        position: absolute;
        display: block;
        background: currentColor;
    }

    .preview-dino::before {
        left: 7px;
        bottom: 4px;
        width: 24px;
        height: 12px;
        box-shadow:
            16px -8px 0 -2px currentColor,
            23px -7px 0 -4px currentColor,
            -8px 3px 0 -2px currentColor,
            6px 10px 0 -4px currentColor,
            17px 10px 0 -4px currentColor;
    }

    .preview-dino::after {
        left: 30px;
        top: 4px;
        width: 3px;
        height: 3px;
        background: var(--preview-chart-panel-deep, #031940);
    }

    .preview-food {
        width: 38px;
        height: 10px;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--preview-dino-food-color, #45D6C6), color-mix(in srgb, var(--preview-dino-food-color, #45D6C6) 55%, #fff));
    }

    .preview-chart-panel {
        display: grid;
        grid-template-columns: 54px minmax(0, 1fr);
        align-items: center;
        gap: 11px;
        min-height: 74px;
        padding: 12px;
        border-radius: 8px;
        background: linear-gradient(180deg, var(--preview-chart-panel, #041F4E), var(--preview-chart-panel-deep, #031940));
        box-shadow: inset 0 1px 0 rgba(255,255,255,.12);
    }

    .preview-chart-ring {
        width: 48px;
        aspect-ratio: 1;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: conic-gradient(#7bdc49 0 46%, #2693f4 46% 82%, #ff9f1c 82% 100%);
    }

    .preview-chart-ring::before {
        content: "";
        width: 25px;
        aspect-ratio: 1;
        border-radius: 50%;
        background: var(--preview-chart-panel-deep, #031940);
    }

    .preview-chart-lines {
        display: grid;
        gap: 8px;
    }

    .preview-chart-lines span {
        height: 9px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--preview-chart-ink, #fff) 28%, transparent);
    }

    .preview-chart-lines span:nth-child(2) {
        width: 72%;
    }

    .preview-chart-lines span:nth-child(3) {
        width: 52%;
    }

    .preview-button {
        width: 86px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--preview-accent, #1F4889), var(--preview-accent-dark, #193B70));
    }

    .preview-button.is-muted {
        width: 62px;
        background: #e2e8f0;
    }

    /* Appearance is an editor surface: its labels stay readable while preview colors change. */
    #appearancePage .appearance-hero .appearance-eyebrow {
        color: var(--pt-sidebar-contrast-muted) !important;
        -webkit-text-fill-color: var(--pt-sidebar-contrast-muted) !important;
    }

    #appearancePage .appearance-hero .appearance-title {
        color: var(--pt-sidebar-contrast) !important;
        -webkit-text-fill-color: var(--pt-sidebar-contrast) !important;
    }

    #appearancePage .appearance-hero .appearance-subtitle {
        color: var(--pt-sidebar-contrast-muted) !important;
        -webkit-text-fill-color: var(--pt-sidebar-contrast-muted) !important;
    }

    #appearancePage .appearance-reset,
    #appearancePage .appearance-reset:hover,
    #appearancePage .appearance-reset:focus,
    #appearancePage .appearance-save,
    #appearancePage .appearance-save:hover,
    #appearancePage .appearance-save:focus {
        border-color: var(--pt-accent-dark) !important;
        color: var(--pt-accent-contrast) !important;
        -webkit-text-fill-color: var(--pt-accent-contrast) !important;
        background: linear-gradient(135deg, var(--pt-accent), var(--pt-accent-dark)) !important;
    }

    #appearancePage .appearance-alert {
        color: #1F4889 !important;
        -webkit-text-fill-color: #1F4889 !important;
    }

    #appearancePage .appearance-alert.is-error {
        color: #be123c !important;
        -webkit-text-fill-color: #be123c !important;
    }

    #appearancePage .appearance-section,
    #appearancePage .appearance-preview {
        --pt-local-text: #10233f !important;
        --pt-local-muted: #64748b !important;
        color: #10233f !important;
    }

    #appearancePage .appearance-section__head h2,
    #appearancePage .appearance-preview__head h2,
    #appearancePage .theme-name,
    #appearancePage .custom-toggle,
    #appearancePage .font-scale-value,
    #appearancePage .motion-option strong {
        color: #10233f !important;
        -webkit-text-fill-color: #10233f !important;
    }

    #appearancePage .appearance-section__head p,
    #appearancePage .motion-option small {
        color: #64748b !important;
        -webkit-text-fill-color: #64748b !important;
    }

    #appearancePage .theme-default {
        color: #1F4889 !important;
        -webkit-text-fill-color: #1F4889 !important;
    }

    #appearancePage .appearance-field label {
        color: #334155 !important;
        -webkit-text-fill-color: #334155 !important;
    }

    #appearancePage .color-input input[type="text"],
    #appearancePage .dino-name-input,
    #appearancePage .preview-dino-name {
        color: #10233f !important;
        -webkit-text-fill-color: #10233f !important;
    }

    #appearancePage .preview-nav span {
        color: #fff !important;
        -webkit-text-fill-color: #fff !important;
    }

    @@media (max-width: 1080px) {
        .appearance-layout {
            grid-template-columns: 1fr;
        }

        .appearance-preview {
            position: static;
        }
    }

    @@media (max-width: 760px) {
        .appearance-hero {
            align-items: stretch;
            flex-direction: column;
        }

        .theme-grid,
        .appearance-controls {
            grid-template-columns: 1fr;
        }

        .appearance-actions {
            justify-content: stretch;
        }

        .appearance-save,
        .appearance-actions .btn {
            width: 100%;
        }
    }
</style>
}

<div class="appearance-page" id="appearancePage">
    <div class="appearance-hero">
        <div class="appearance-hero__content">
            <p class="appearance-eyebrow">Settings</p>
            <h1 class="appearance-title">ธีมและการแสดงผล</h1>
            <p class="appearance-subtitle">เลือกโทนสีสำหรับพื้นที่ทำงานของคุณ สีนี้มีผลกับเมนู ปุ่มหลัก สถานะ และจุดเน้นของระบบ</p>
        </div>
        <form class="appearance-reset-form" asp-action="ResetAppearance" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="appearance-reset">Reset Default</button>
        </form>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="appearance-alert">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="appearance-alert is-error">@TempData["Error"]</div>
    }

    <form asp-action="Appearance" method="post" id="appearanceForm">
        @Html.AntiForgeryToken()
        <div class="appearance-layout">
            <div>
                <section class="appearance-section">
                    <div class="appearance-section__head">
                        <h2>Theme Presets</h2>
                        <p>ธีมระบบถูกเก็บไว้ในฐานข้อมูล โดยสีช่องที่ 3 ใช้กับพื้นโปรไฟล์ด้านบน สีช่องที่ 5 ใช้กับพื้นกล่องกราฟ/รายการ และสีช่องที่ 6 ใช้กับพื้นเมนู</p>
                    </div>

                    <div class="theme-grid" id="themePresetGrid">
                        @foreach (var preset in Model.Presets)
                        {
                            var selected = preset.ThemeId == Model.ThemeId;
                            <label class="theme-card @(selected ? "is-selected" : "")"
                                   data-accent="@preset.AccentHex"
                                   data-accent-dark="@preset.AccentDarkHex"
                                   data-sidebar="@preset.SidebarHex"
                                   data-profile-panel="@preset.ProfilePanelHex"
                                   data-body="@preset.BodyBgHex"
                                   data-chart-panel="@preset.ChartPanelHex"
                                   data-menu-panel="@preset.MenuPanelHex"
                                   data-text="@preset.TextHex"
                                   data-contrast="@preset.ContrastHex">
                                <input type="radio"
                                       name="ThemeId"
                                       value="@preset.ThemeId"
                                       @(selected ? "checked" : "") />
                                <span class="theme-swatch" aria-hidden="true">
                                    <span style="background:@preset.AccentHex"></span>
                                    <span style="background:@preset.SidebarHex"></span>
                                    <span style="background:@preset.ProfilePanelHex"></span>
                                    <span style="background:@preset.BodyBgHex"></span>
                                    <span style="background:@preset.ChartPanelHex"></span>
                                    <span style="background:@preset.MenuPanelHex"></span>
                                </span>
                                <span class="theme-name">@preset.ThemeName</span>
                                @if (preset.IsDefault)
                                {
                                    <span class="theme-default">Default</span>
                                }
                            </label>
                        }
                    </div>
                </section>

                <section class="appearance-section">
                    <div class="appearance-section__head">
                        <h2>Custom</h2>
                        <p>ปรับสีหลักของบัญชีนี้โดยไม่กระทบผู้ใช้อื่น</p>
                    </div>

                    <label class="custom-toggle">
                        <input type="checkbox" id="UseCustom" name="UseCustom" value="true" @(Model.UseCustom ? "checked" : "") />
                        <span>ใช้สีที่กำหนดเอง</span>
                    </label>
                    <input type="hidden" name="UseCustom" value="false" />

                    <div class="appearance-controls">
                        <div class="appearance-field">
                            <label for="CustomAccentHex">Accent</label>
                            <div class="color-input" data-color-wrap>
                                <input type="color" id="CustomAccentColor" value="@Model.CustomAccentHex" />
                                <input type="text" id="CustomAccentHex" name="CustomAccentHex" value="@Model.CustomAccentHex" maxlength="7" />
                            </div>
                        </div>
                        <div class="appearance-field">
                            <label for="CustomSidebarHex">Sidebar</label>
                            <div class="color-input" data-color-wrap>
                                <input type="color" id="CustomSidebarColor" value="@Model.CustomSidebarHex" />
                                <input type="text" id="CustomSidebarHex" name="CustomSidebarHex" value="@Model.CustomSidebarHex" maxlength="7" />
                            </div>
                        </div>
                        <div class="appearance-field">
                            <label for="CustomProfilePanelHex">Profile Background</label>
                            <div class="color-input" data-color-wrap>
                                <input type="color" id="CustomProfilePanelColor" value="@Model.CustomProfilePanelHex" />
                                <input type="text" id="CustomProfilePanelHex" name="CustomProfilePanelHex" value="@Model.CustomProfilePanelHex" maxlength="7" />
                            </div>
                        </div>
                        <div class="appearance-field">
                            <label for="CustomBodyBgHex">Background</label>
                            <div class="color-input" data-color-wrap>
                                <input type="color" id="CustomBodyBgColor" value="@Model.CustomBodyBgHex" />
                                <input type="text" id="CustomBodyBgHex" name="CustomBodyBgHex" value="@Model.CustomBodyBgHex" maxlength="7" />
                            </div>
                        </div>
                        <div class="appearance-field">
                            <label for="CustomChartPanelHex">Chart/List Background</label>
                            <div class="color-input" data-color-wrap>
                                <input type="color" id="CustomChartPanelColor" value="@Model.CustomChartPanelHex" />
                                <input type="text" id="CustomChartPanelHex" name="CustomChartPanelHex" value="@Model.CustomChartPanelHex" maxlength="7" />
                            </div>
                        </div>
                        <div class="appearance-field">
                            <label for="CustomMenuPanelHex">Menu Background</label>
                            <div class="color-input" data-color-wrap>
                                <input type="color" id="CustomMenuPanelColor" value="@Model.CustomMenuPanelHex" />
                                <input type="text" id="CustomMenuPanelHex" name="CustomMenuPanelHex" value="@Model.CustomMenuPanelHex" maxlength="7" />
                            </div>
                        </div>
                    </div>

                    <div class="appearance-section__head" style="margin-top:18px;">
                        <h2>Text Scale</h2>
                    </div>
                    <div class="font-scale-row">
                        <input type="range" id="FontScale" name="FontScale" min="0.90" max="1.15" step="0.01" value="@fontScale" />
                        <span class="font-scale-value" id="FontScaleValue">@fontScale</span>
                    </div>

                    <div class="appearance-section__head" style="margin-top:18px;">
                        <h2>Motion</h2>
                    </div>
                    <label class="motion-option" for="ProfileBallEnabled">
                        <span>
                            <strong>Dashboard Dino</strong>
                            <small>ให้ไดโนเสาร์ pixel ตัวเดียวเดินบนขอบการ์ด ดับเบิลคลิกบนขอบการ์ดเพื่อวางขาไก่ แล้วไดโนเสาร์จะเดินไปกินเอง</small>
                        </span>
                        <span class="motion-switch">
                            <input type="checkbox" id="ProfileBallEnabled" name="ProfileBallEnabled" value="true" @(Model.ProfileBallEnabled ? "checked" : "") />
                            <span></span>
                        </span>
                    </label>
                    <input type="hidden" name="ProfileBallEnabled" value="false" />

                    <div class="appearance-controls dino-color-controls">
                        <div class="appearance-field">
                            <label for="DinoName">Dino Name</label>
                            <input class="dino-name-input" type="text" id="DinoName" name="DinoName" value="@Model.DinoName" maxlength="24" autocomplete="off" />
                        </div>
                        <div class="appearance-field">
                            <label for="DinoColorHex">Dino Color</label>
                            <div class="color-input" data-color-wrap>
                                <input type="color" id="DinoColor" value="@Model.DinoColorHex" />
                                <input type="text" id="DinoColorHex" name="DinoColorHex" value="@Model.DinoColorHex" maxlength="7" />
                            </div>
                        </div>
                        <div class="appearance-field">
                            <label for="DinoFoodColorHex">Food Color</label>
                            <div class="color-input" data-color-wrap>
                                <input type="color" id="DinoFoodColor" value="@Model.DinoFoodColorHex" />
                                <input type="text" id="DinoFoodColorHex" name="DinoFoodColorHex" value="@Model.DinoFoodColorHex" maxlength="7" />
                            </div>
                        </div>
                    </div>

                    <div class="appearance-actions">
                        <button type="submit" class="btn btn-primary appearance-save">Save Theme</button>
                    </div>
                </section>
            </div>

            <aside class="appearance-preview" id="appearancePreview"
                   style="--preview-accent:@Model.EffectiveTheme.AccentHex; --preview-accent-dark:@Model.EffectiveTheme.AccentDarkHex; --preview-sidebar:@Model.EffectiveTheme.SidebarHex; --preview-sidebar-deep:@Model.EffectiveTheme.SidebarDeepHex; --preview-profile-panel:@Model.EffectiveTheme.ProfilePanelHex; --preview-profile-panel-deep:@Model.EffectiveTheme.ProfilePanelDeepHex; --preview-body:@Model.EffectiveTheme.BodyBgHex; --preview-chart-panel:@Model.EffectiveTheme.ChartPanelHex; --preview-chart-panel-deep:@Model.EffectiveTheme.ChartPanelDeepHex; --preview-chart-ink:@Model.EffectiveTheme.ChartPanelContrastHex; --preview-menu-panel:@Model.EffectiveTheme.MenuPanelHex; --preview-menu-panel-deep:@Model.EffectiveTheme.MenuPanelDeepHex; --preview-dino-color:@Model.EffectiveTheme.DinoColorHex; --preview-dino-food-color:@Model.EffectiveTheme.DinoFoodColorHex;">
                <div class="appearance-preview__head">
                    <h2>Preview</h2>
                </div>
                <div class="preview-shell">
                    <div class="preview-nav">
                        <div class="preview-logo"></div>
                        <span>ProjectTracking</span>
                    </div>
                    <div class="preview-body">
                        <div class="preview-side">
                            <div class="preview-profile-zone"></div>
                            <div class="preview-pill is-active"></div>
                            <div class="preview-pill"></div>
                            <div class="preview-pill"></div>
                            <div class="preview-pill"></div>
                        </div>
                        <div class="preview-content">
                            <div class="preview-panel">
                                <div class="preview-line is-title"></div>
                                <div class="preview-line"></div>
                                <div class="preview-line is-short"></div>
                                <div class="preview-chart-panel" aria-hidden="true">
                                    <div class="preview-chart-ring"></div>
                                    <div class="preview-chart-lines">
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                    </div>
                                </div>
                                <div class="preview-actions">
                                    <div class="preview-button"></div>
                                    <div class="preview-button is-muted"></div>
                                </div>
                                <div class="preview-dino-row" aria-hidden="true">
                                    <span class="preview-dino-name" id="previewDinoName">@Model.DinoName</span>
                                    <span class="preview-dino"></span>
                                    <span class="preview-food"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </form>
</div>

@section Scripts {
<script>
(function () {
    const form = document.getElementById('appearanceForm');
    if (!form) return;

    const customToggle = document.getElementById('UseCustom');
    const fontScale = document.getElementById('FontScale');
    const fontScaleValue = document.getElementById('FontScaleValue');
    const preview = document.getElementById('appearancePreview');
    const dinoNameInput = document.getElementById('DinoName');
    const previewDinoName = document.getElementById('previewDinoName');
    const colorPairs = [
        ['CustomAccentColor', 'CustomAccentHex', true],
        ['CustomSidebarColor', 'CustomSidebarHex', true],
        ['CustomProfilePanelColor', 'CustomProfilePanelHex', true],
        ['CustomBodyBgColor', 'CustomBodyBgHex', true],
        ['CustomChartPanelColor', 'CustomChartPanelHex', true],
        ['CustomMenuPanelColor', 'CustomMenuPanelHex', true],
        ['DinoColor', 'DinoColorHex', false],
        ['DinoFoodColor', 'DinoFoodColorHex', false]
    ].map(([colorId, textId, customOnly]) => ({
        color: document.getElementById(colorId),
        text: document.getElementById(textId),
        customOnly
    })).filter(pair => pair.color && pair.text);

    function isHex(value) {
        return /^#[0-9a-f]{6}$/i.test((value || '').trim());
    }

    function normalizeHex(value, fallback) {
        value = (value || '').trim();
        if (/^[0-9a-f]{6}$/i.test(value)) value = '#' + value;
        return isHex(value) ? value.toUpperCase() : fallback;
    }

    function parseHex(hex) {
        hex = normalizeHex(hex, '#1F4889').slice(1);
        return [
            parseInt(hex.slice(0, 2), 16),
            parseInt(hex.slice(2, 4), 16),
            parseInt(hex.slice(4, 6), 16)
        ];
    }

    function toHex(channel) {
        return Math.max(0, Math.min(255, Math.round(channel))).toString(16).padStart(2, '0').toUpperCase();
    }

    function shiftHex(hex, amount) {
        const rgb = parseHex(hex);
        const target = amount >= 0 ? 255 : 0;
        const factor = Math.abs(amount);
        return '#' + rgb.map(channel => toHex(channel + (target - channel) * factor)).join('');
    }

    function rgba(hex, alpha) {
        const [r, g, b] = parseHex(hex);
        return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }

    function contrast(hex) {
        const [r, g, b] = parseHex(hex).map(channel => {
            const c = channel / 255;
            return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
        });
        return (0.2126 * r + 0.7152 * g + 0.0722 * b) > 0.55 ? '#062B2F' : '#FFFFFF';
    }

    function selectedPresetCard() {
        const checked = form.querySelector('input[name="ThemeId"]:checked');
        return checked ? checked.closest('.theme-card') : form.querySelector('.theme-card');
    }

    function selectedPresetTheme() {
        const card = selectedPresetCard();
        return {
            accent: normalizeHex(card?.dataset.accent, '#1F4889'),
            accentDark: normalizeHex(card?.dataset.accentDark, '#193B70'),
            sidebar: normalizeHex(card?.dataset.sidebar, '#081C42'),
            sidebarDeep: shiftHex(normalizeHex(card?.dataset.sidebar, '#081C42'), -0.20),
            profilePanel: normalizeHex(card?.dataset.profilePanel, normalizeHex(card?.dataset.sidebar, '#081C42')),
            profilePanelDeep: shiftHex(normalizeHex(card?.dataset.profilePanel, normalizeHex(card?.dataset.sidebar, '#081C42')), -0.18),
            profilePanelContrast: contrast(normalizeHex(card?.dataset.profilePanel, normalizeHex(card?.dataset.sidebar, '#081C42'))),
            body: normalizeHex(card?.dataset.body, '#EEF3F9'),
            text: normalizeHex(card?.dataset.text, '#0F172A'),
            chartPanel: normalizeHex(card?.dataset.chartPanel, normalizeHex(card?.dataset.sidebar, '#081C42')),
            chartPanelDeep: shiftHex(normalizeHex(card?.dataset.chartPanel, normalizeHex(card?.dataset.sidebar, '#081C42')), -0.18),
            chartPanelContrast: contrast(normalizeHex(card?.dataset.chartPanel, normalizeHex(card?.dataset.sidebar, '#081C42'))),
            menuPanel: normalizeHex(card?.dataset.menuPanel, normalizeHex(card?.dataset.chartPanel, normalizeHex(card?.dataset.sidebar, '#081C42'))),
            menuPanelDeep: shiftHex(normalizeHex(card?.dataset.menuPanel, normalizeHex(card?.dataset.chartPanel, normalizeHex(card?.dataset.sidebar, '#081C42'))), -0.18),
            menuPanelContrast: contrast(normalizeHex(card?.dataset.menuPanel, normalizeHex(card?.dataset.chartPanel, normalizeHex(card?.dataset.sidebar, '#081C42')))),
            contrast: normalizeHex(card?.dataset.contrast, '#FFFFFF')
        };
    }

    function currentDinoTheme() {
        const dinoName = (dinoNameInput?.value || '').trim() || 'Dino';
        return {
            dinoName: dinoName.length <= 24 ? dinoName : dinoName.slice(0, 24),
            dinoColor: normalizeHex(document.getElementById('DinoColorHex')?.value, '#FFFFFF'),
            dinoFoodColor: normalizeHex(document.getElementById('DinoFoodColorHex')?.value, '#45D6C6')
        };
    }

    function currentTheme() {
        const preset = selectedPresetTheme();
        const dinoTheme = currentDinoTheme();
        if (!customToggle.checked) return { ...preset, ...dinoTheme };

        const accent = normalizeHex(document.getElementById('CustomAccentHex').value, preset.accent);
        const sidebar = normalizeHex(document.getElementById('CustomSidebarHex').value, preset.sidebar);
        const profilePanel = normalizeHex(document.getElementById('CustomProfilePanelHex').value, preset.profilePanel);
        const body = normalizeHex(document.getElementById('CustomBodyBgHex').value, preset.body);
        const chartPanel = normalizeHex(document.getElementById('CustomChartPanelHex').value, preset.chartPanel);
        const menuPanel = normalizeHex(document.getElementById('CustomMenuPanelHex').value, preset.menuPanel);
        return {
            accent,
            accentDark: shiftHex(accent, -0.18),
            sidebar,
            sidebarDeep: shiftHex(sidebar, -0.20),
            profilePanel,
            profilePanelDeep: shiftHex(profilePanel, -0.18),
            profilePanelContrast: contrast(profilePanel),
            body,
            text: preset.text,
            chartPanel,
            chartPanelDeep: shiftHex(chartPanel, -0.18),
            chartPanelContrast: contrast(chartPanel),
            menuPanel,
            menuPanelDeep: shiftHex(menuPanel, -0.18),
            menuPanelContrast: contrast(menuPanel),
            contrast: contrast(accent),
            ...dinoTheme
        };
    }

    function applyTheme() {
        const theme = currentTheme();
        const root = document.documentElement.style;
        root.setProperty('--pt-accent', theme.accent);
        root.setProperty('--pt-accent-dark', theme.accentDark);
        root.setProperty('--pt-accent-deep', shiftHex(theme.accent, -0.30));
        root.setProperty('--pt-accent-soft', rgba(theme.accent, .18));
        root.setProperty('--pt-accent-glow', rgba(theme.accent, .30));
        root.setProperty('--pt-accent-contrast', theme.contrast);
        root.setProperty('--pt-sidebar-bg', theme.sidebar);
        root.setProperty('--pt-sidebar-deep', theme.sidebarDeep);
        root.setProperty('--pt-sidebar-soft', rgba(theme.sidebar, .88));
        root.setProperty('--pt-sidebar-panel', rgba(theme.sidebar, .96));
        root.setProperty('--pt-sidebar-contrast', contrast(theme.sidebar));
        root.setProperty('--pt-sidebar-contrast-muted', rgba(contrast(theme.sidebar), .76));
        root.setProperty('--pt-profile-panel-bg', theme.profilePanel);
        root.setProperty('--pt-profile-panel-deep', theme.profilePanelDeep);
        root.setProperty('--pt-profile-panel-soft', rgba(theme.profilePanel, .90));
        root.setProperty('--pt-profile-panel-contrast', theme.profilePanelContrast);
        root.setProperty('--pt-profile-panel-contrast-muted', rgba(theme.profilePanelContrast, .76));
        root.setProperty('--pt-body-bg', theme.body);
        root.setProperty('--pt-body-bg-soft', shiftHex(theme.body, -0.04));
        root.setProperty('--pt-text', theme.text);
        root.setProperty('--pt-text-soft', rgba(theme.text, .70));
        root.setProperty('--pt-border', rgba(theme.accent, .28));
        root.setProperty('--pt-border-strong', rgba(theme.accent, .48));
        root.setProperty('--pt-panel-field-bg', rgba(theme.sidebarDeep, .72));
        root.setProperty('--pt-panel-row-bg', shiftHex(theme.sidebar, -0.08));
        root.setProperty('--pt-panel-row-bg-deep', shiftHex(theme.sidebarDeep, -0.02));
        root.setProperty('--pt-panel-row-hover-bg', shiftHex(theme.sidebar, 0.04));
        root.setProperty('--pt-shadow', rgba(theme.sidebar, .18));
        root.setProperty('--pt-menu-accent', theme.accent);
        root.setProperty('--pt-menu-accent-dark', theme.accentDark);
        root.setProperty('--pt-chart-panel-bg', theme.chartPanel);
        root.setProperty('--pt-chart-panel-deep', theme.chartPanelDeep);
        root.setProperty('--pt-chart-panel-soft', rgba(theme.chartPanel, .88));
        root.setProperty('--pt-chart-panel-field-bg', rgba(theme.chartPanelDeep, .72));
        root.setProperty('--pt-chart-panel-row-bg', shiftHex(theme.chartPanel, -0.08));
        root.setProperty('--pt-chart-panel-row-hover-bg', shiftHex(theme.chartPanel, 0.04));
        root.setProperty('--pt-chart-panel-glow', rgba(theme.accent, .14));
        root.setProperty('--pt-chart-panel-contrast', theme.chartPanelContrast);
        root.setProperty('--pt-chart-panel-contrast-muted', rgba(theme.chartPanelContrast, .76));
        root.setProperty('--pt-menu-panel-bg', theme.menuPanel);
        root.setProperty('--pt-menu-panel-deep', theme.menuPanelDeep);
        root.setProperty('--pt-menu-panel-soft', rgba(theme.menuPanel, .88));
        root.setProperty('--pt-menu-panel-field-bg', rgba(theme.menuPanelDeep, .72));
        root.setProperty('--pt-menu-panel-row-bg', shiftHex(theme.menuPanel, -0.08));
        root.setProperty('--pt-menu-panel-row-hover-bg', shiftHex(theme.menuPanel, 0.04));
        root.setProperty('--pt-menu-panel-contrast', theme.menuPanelContrast);
        root.setProperty('--pt-menu-panel-contrast-muted', rgba(theme.menuPanelContrast, .76));
        root.setProperty('--pt-dino-color', theme.dinoColor);
        root.setProperty('--pt-dino-food-color', theme.dinoFoodColor);
        root.setProperty('--pt-dino-food-soft', rgba(theme.dinoFoodColor, .24));
        root.setProperty('--pt-user-font-scale', fontScale.value);

        if (preview) {
            preview.style.setProperty('--preview-accent', theme.accent);
            preview.style.setProperty('--preview-accent-dark', theme.accentDark);
            preview.style.setProperty('--preview-sidebar', theme.sidebar);
            preview.style.setProperty('--preview-sidebar-deep', theme.sidebarDeep);
            preview.style.setProperty('--preview-profile-panel', theme.profilePanel);
            preview.style.setProperty('--preview-profile-panel-deep', theme.profilePanelDeep);
            preview.style.setProperty('--preview-body', theme.body);
            preview.style.setProperty('--preview-chart-panel', theme.chartPanel);
            preview.style.setProperty('--preview-chart-panel-deep', theme.chartPanelDeep);
            preview.style.setProperty('--preview-chart-ink', theme.chartPanelContrast);
            preview.style.setProperty('--preview-menu-panel', theme.menuPanel);
            preview.style.setProperty('--preview-menu-panel-deep', theme.menuPanelDeep);
            preview.style.setProperty('--preview-dino-color', theme.dinoColor);
            preview.style.setProperty('--preview-dino-food-color', theme.dinoFoodColor);
            if (previewDinoName) previewDinoName.textContent = theme.dinoName;
        }

        if (fontScaleValue) fontScaleValue.textContent = Number(fontScale.value).toFixed(2);
        document.querySelectorAll('.theme-card').forEach(card => {
            const input = card.querySelector('input[type="radio"]');
            card.classList.toggle('is-selected', !!input && input.checked);
        });
    }

    function syncCustomState() {
        const preset = selectedPresetTheme();
        const disabled = !customToggle.checked;
        colorPairs.forEach(pair => {
            const pairDisabled = disabled && pair.customOnly;
            pair.color.disabled = pairDisabled;
            pair.text.disabled = pairDisabled;
            pair.color.closest('[data-color-wrap]')?.classList.toggle('is-disabled', pairDisabled);
        });

        if (disabled) {
            document.getElementById('CustomAccentHex').value = preset.accent;
            document.getElementById('CustomAccentColor').value = preset.accent;
            document.getElementById('CustomSidebarHex').value = preset.sidebar;
            document.getElementById('CustomSidebarColor').value = preset.sidebar;
            document.getElementById('CustomProfilePanelHex').value = preset.profilePanel;
            document.getElementById('CustomProfilePanelColor').value = preset.profilePanel;
            document.getElementById('CustomBodyBgHex').value = preset.body;
            document.getElementById('CustomBodyBgColor').value = preset.body;
            document.getElementById('CustomChartPanelHex').value = preset.chartPanel;
            document.getElementById('CustomChartPanelColor').value = preset.chartPanel;
            document.getElementById('CustomMenuPanelHex').value = preset.menuPanel;
            document.getElementById('CustomMenuPanelColor').value = preset.menuPanel;
        }

        applyTheme();
    }

    colorPairs.forEach(pair => {
        pair.color.addEventListener('input', function () {
            pair.text.value = normalizeHex(pair.color.value, pair.text.value);
            applyTheme();
        });
        pair.text.addEventListener('input', function () {
            const value = normalizeHex(pair.text.value, pair.color.value);
            if (isHex(value)) pair.color.value = value;
            applyTheme();
        });
        pair.text.addEventListener('blur', function () {
            pair.text.value = normalizeHex(pair.text.value, pair.color.value);
            pair.color.value = pair.text.value;
            applyTheme();
        });
    });

    function applyPresetCard(card) {
        const input = card?.querySelector('input[name="ThemeId"]');
        if (!input) return;

        input.checked = true;
        customToggle.checked = false;
        syncCustomState();
    }

    form.querySelectorAll('.theme-card').forEach(card => {
        card.addEventListener('click', function () {
            window.setTimeout(() => applyPresetCard(card), 0);
        });
    });

    form.querySelectorAll('input[name="ThemeId"]').forEach(input => {
        input.addEventListener('change', function () {
            applyPresetCard(input.closest('.theme-card'));
        });
    });

    customToggle.addEventListener('change', syncCustomState);
    fontScale.addEventListener('input', applyTheme);
    dinoNameInput?.addEventListener('input', applyTheme);
    syncCustomState();
})();
</script>
}

@model ProjectTracking.Models.Project

<h2>Delete Project</h2>

<h4>Are you sure you want to delete this project?</h4>

<hr />

<dl>
    <dt>Project Name</dt>
    <dd>@Model.ProjectName</dd>

    <dt>ฝ่าย</dt>
    <dd>@Model.DepartmentNames</dd>

    <dt>Start Date</dt>
    <dd>@Model.StartDate?.ToString("yyyy-MM-dd")</dd>

    <dt>End Date</dt>
    <dd>@Model.EndDate?.ToString("yyyy-MM-dd")</dd>

    <dt>วันที่เริ่มรับประกัน</dt>
    <dd>@Model.WarrantyStartDate?.ToString("yyyy-MM-dd")</dd>

    <dt>วันที่สิ้นสุดรับประกัน</dt>
    <dd>@Model.WarrantyEndDate?.ToString("yyyy-MM-dd")</dd>

    <dt>สถานะรับประกัน</dt>
    <dd>
        @if (Model.WarrantyEndDate.HasValue)
        {
            <span class="pt-status-text @(Model.IsWarrantyActive ? "is-success" : "is-danger")">@Model.WarrantyStatusDescription</span>
        }
        else
        {
            <span>-</span>
        }
    </dd>

    <dt>Status</dt>
    <dd>@Model.Status</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ProjectId" />
    <button type="submit">🗑 ลบ</button>
    |
    <a asp-action="Index">ยกเลิก</a>
</form>

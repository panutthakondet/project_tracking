@model ProjectTracking.ViewModels.ProjectProductionMemoViewModel
@using System.Globalization

@{
    Layout = null;
    var th = new CultureInfo("th-TH");
    var projectName = string.IsNullOrWhiteSpace(Model.ProjectName) ? "-" : Model.ProjectName.Trim();
    var coopName = string.IsNullOrWhiteSpace(Model.CoopName) ? "-" : Model.CoopName.Trim();
    var departmentName = string.IsNullOrWhiteSpace(Model.DepartmentName) ? "ยังไม่กำหนดฝ่าย" : Model.DepartmentName.Trim();
    var extraTorDetail = Model.ExtraTorDetail?.Trim();
    var hasExtraTorDetail = !string.IsNullOrWhiteSpace(ProjectTracking.Services.ProjectRichText.PlainText(extraTorDetail).Replace("\u200B", "").Replace("\uFEFF", ""));

    string ReportDetail(string? value) => System.Text.RegularExpressions.Regex.Replace(
        ProjectTracking.Services.ProjectRichText.ToHtml(string.IsNullOrWhiteSpace(value) ? "-" : value),
        @"font-size:\d+px !important;", "font-size:inherit !important;");

    string DateText(DateTime? value)
    {
        if (!value.HasValue) return "-";

        var date = value.Value;
        return $"{date.Day} {date.ToString("MMMM", th)} {date.Year + 543}";
    }

    void RenderAttachmentDetails()
    {
        <section class="detail-block">
            <div class="memo-stack"><div class="memo-stack-value">@coopName @projectName</div></div>
            <div class="memo-stack"><div class="memo-stack-label">รายละเอียดตาม TOR</div><div class="memo-stack-value">@Html.Raw(ReportDetail(Model.TorDetail))</div></div>
            @if (hasExtraTorDetail)
            {
            <div class="memo-stack"><div class="memo-stack-label">รายละเอียดงานนอกเหนือ TOR</div><div class="memo-stack-value">@Html.Raw(ReportDetail(Model.ExtraTorDetail))</div></div>
            }
        </section>
    }
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>@(Model.IsDepartmentTransfer ? $"หนังสือโอนย้ายงาน {coopName} - {projectName}" : $"หนังสือขอขึ้นระบบงานจริง {coopName} - {projectName}")</title>
    <link rel="stylesheet" href="~/css/report-font.css" asp-append-version="true" />
    <style>
        @@page {
            size: A4 portrait;
            margin-top: 14mm;
            margin-right: 16mm;
            margin-bottom: 12mm;
            margin-left: 18mm;
        }

        * { box-sizing: border-box; }

        body {
            --memo-font: "Report Sarabun", "TH Sarabun New", Tahoma, sans-serif;
            margin: 0;
            color: #111;
            background: #fff;
            font-family: var(--memo-font);
            font-size: 14pt;
            font-weight: 400;
            line-height: 1.36;
            text-rendering: auto;
            -webkit-font-smoothing: auto;
        }

        body :where(*):not(svg):not(svg *) {
            font-family: var(--memo-font) !important;
            letter-spacing: 0 !important;
            text-shadow: none !important;
            -webkit-text-stroke: 0 transparent !important;
        }

        .no-print {
            position: sticky;
            top: 0;
            z-index: 5;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            padding: 10px;
            background: #eef4fb;
            border-bottom: 1px solid #cbd8e8;
        }

        .report-btn {
            min-height: 34px;
            padding: 7px 14px;
            border: 1px solid #102443;
            border-radius: 999px;
            color: #102443;
            background: #fff;
            font-size: 12px;
            font-weight: 600;
            line-height: 1.1;
            text-decoration: none;
            cursor: pointer;
        }

        .report-btn.primary {
            color: #fff;
            background: #102443;
        }

        .page {
            width: 100%;
            max-width: 760px;
            margin: 0 auto;
            padding: 10px 0 0;
        }

        @@media screen {
            .page { max-width: 176mm; }
        }

        .header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 2px;
        }

        .logo {
            width: 70px;
            flex: 0 0 auto;
        }

        .company {
            font-size: 9.5pt;
            line-height: 1.25;
        }

        .company b {
            font-size: 10.5pt;
            font-weight: 700;
        }

        hr {
            margin: 2px 0 8px;
            border: 0;
            border-top: 1px solid #111;
        }

        .title {
            margin: 0 0 10px;
            text-align: center;
            font-size: 18pt;
            font-weight: 500;
        }

        .date {
            margin-bottom: 8px;
            text-align: center;
        }

        .memo-row {
            display: flex;
            align-items: flex-start;
            gap: 6px;
            margin-bottom: 3px;
        }

        .memo-label {
            flex: 0 0 120px;
            font-weight: 600;
            white-space: nowrap;
        }

        .memo-label.short {
            font-weight: 400;
            flex-basis: 48px;
        }

        .memo-value {
            flex: 1 1 auto;
            min-width: 0;
        }

        .intro {
            margin: 14px 0 10px;
            padding-left: 0;
            text-indent: 54px;
        }

        .detail-block {
            margin: 0 0 8px;
        }

        .memo-stack {
            margin-bottom: 5px;
        }

        .memo-stack-label {
            font-weight: 600;
            line-height: 1.28;
        }

        .memo-stack-value {
            margin-left: 32px;
            line-height: 1.28;
        }

        .memo-project-detail {
            white-space: pre-line;
        }

        .phase-list {
            margin: 1px 0 6px 32px;
            font-size: inherit;
            line-height: 1.3;
        }

        .phase-line {
            margin-bottom: 7px;
        }

        .phase-title {
            line-height: 1.28;
        }

        .phase-meta {
            margin-left: 24px;
            line-height: 1.24;
        }

        .owner-list {
            margin: 1px 0 10px 32px;
            font-size: inherit;
            line-height: 1.3;
        }

        .owner-table { width: 100%; border-collapse: collapse; table-layout: fixed; margin: 4px 0 12px; font-size: inherit; line-height: 1.42; }
        .owner-table th, .owner-table td { border: 1px solid #aaa; padding: 5px 10px; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
        .owner-table th { font-weight: 600; background: #f5f5f5; }
        .owner-table td { width: 50%; }
        .owner-table tr { break-inside: avoid; page-break-inside: avoid; }
        .owner-table thead { display: table-header-group; }
        .owner-line {
            margin-bottom: 3px;
        }

        .memo-tail {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .comment-lines {
            margin: 18px 0 20px;
        }

        .comment-line {
            position: relative;
            height: 24px;
            border-bottom: 1px dotted #000;
        }

        .comment-label {
            position: absolute;
            left: 0;
            top: -1px;
            padding-right: 8px;
            background: #fff;
            font-weight: 600;
            line-height: 1;
        }

        .signature {
            width: 58%;
            margin: 18pt 0 0 auto;
            text-align: center;
            line-height: 1.7;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .sign-space {
            height: 34px;
        }

        @@media print {
            .no-print { display: none !important; }
            .page {
                max-width: none;
                padding: 0;
            }
            .memo-tail {
                break-inside: avoid-page;
                page-break-inside: avoid;
            }
        }
        .transfer-letter, .transfer-attachment { font-size: 14pt; line-height: 1.42; }
        .transfer-attachment :is(.memo-stack-label, .memo-stack-value, .owner-line, .owner-list) { font-size: inherit; line-height: 1.42; }
        .transfer-letter p { margin: 10pt 0; text-indent: 2em; text-align: justify; }
        .transfer-letter .letter-meta { display: grid; grid-template-columns: max-content minmax(0, 1fr); column-gap: 12px; margin-bottom: 8pt; }
        .transfer-letter .letter-meta > strong { min-width: 48px; white-space: nowrap; font-weight: 400; }
        .transfer-signature { text-align: center; width: 58%; margin: 18pt 0 0 auto; line-height: 1.7; break-inside: avoid; }
        .transfer-attachment { margin-top: 40px; border-top: 1px solid #bbb; padding-top: 24px; }
        .transfer-report .memo-tail { break-inside: auto; page-break-inside: auto; }
        @@media print {
            .transfer-attachment { break-before: page; page-break-before: always; margin-top: 0; border: 0; padding-top: 0; }
        }
    </style>
@await Html.PartialAsync("_GlobalLoading")
</head>
<body class="@(Model.IsDepartmentTransfer ? "transfer-report" : "production-report")">
    <div class="no-print">
        <button type="button" class="report-btn primary" onclick="window.print()">พิมพ์</button>
        <a asp-action="Index" class="report-btn">กลับหน้าโครงการ</a>
    </div>

    <main class="page">
        <div class="header">
            <img src="@Url.Content("~/images/auth/logosoat.png")" class="logo" alt="SO-AT" />
            <div class="company">
                <b>SO-AT SOLUTION COMPANY LIMITED</b><br />
                165/57 Ramindra Road, Monument Sub-District, Bangkhen District, Bangkok 10220<br />
                Tel. 0-2059-0511
            </div>
        </div>
        <hr />

        <h1 class="title">บันทึกภายใน</h1>
        <div class="date">@DateText(Model.GeneratedAt)</div>

        @if (Model.IsDepartmentTransfer)
        {
            <section class="transfer-letter">
                <div class="letter-meta"><strong>เรื่อง</strong><span>ขอส่งมอบและโอนย้ายความรับผิดชอบในการดูแลระบบภายหลังสิ้นสุดระยะเวลารับประกัน</span></div>
                <div class="letter-meta"><strong>เรียน</strong><span>ผู้จัดการฝ่ายพัฒนาธุรกิจ</span></div>
                <div class="letter-meta"><strong>อ้างถึง</strong><span>@projectName @coopName</span></div>
                <p>เนื่องด้วย@(projectName) ของ@(coopName) ซึ่งทีมพัฒนาระบบได้รับมอบหมายให้ดำเนินการพัฒนาระบบ ติดตั้งระบบเพื่อใช้งานจริง ตลอดจนให้บริการดูแล บำรุงรักษา และแก้ไขปัญหาที่เกิดขึ้นในระหว่างระยะเวลารับประกันนั้น</p>
                <p>บัดนี้ ทีมพัฒนาระบบได้ดำเนินงานตามขอบเขตความรับผิดชอบดังกล่าวเสร็จสิ้นเรียบร้อยแล้ว และโครงการได้สิ้นสุดระยะเวลารับประกันตามเงื่อนไขที่กำหนด จึงเห็นควรให้มีการส่งมอบและโอนย้ายความรับผิดชอบในการดูแลระบบจากทีมพัฒนาระบบไปยังฝ่ายบริการลูกค้า เพื่อให้การให้บริการ การรับแจ้งปัญหา การประสานงาน และการดูแลลูกค้าภายหลังสิ้นสุดระยะเวลารับประกันเป็นไปอย่างต่อเนื่องและมีประสิทธิภาพ</p>
                <p>ในการนี้ ทีมพัฒนาระบบจึงขอส่งมอบงานโครงการดังกล่าวให้ฝ่ายบริการลูกค้าเป็นผู้รับผิดชอบหลักในการดูแลและประสานงานกับลูกค้านับตั้งแต่วันที่ได้รับการอนุมัติส่งมอบงานเป็นต้นไป ทั้งนี้ หากมีประเด็นปัญหาทางเทคนิคที่จำเป็นต้องได้รับการสนับสนุนจากทีมพัฒนาระบบ สามารถประสานงานตามขั้นตอนการดำเนินงานภายในบริษัทต่อไป</p>
                <p>จึงเรียนมาเพื่อโปรดพิจารณาอนุมัติการส่งมอบและโอนย้ายความรับผิดชอบในการดูแลระบบดังกล่าวให้ฝ่ายบริการลูกค้าดำเนินการต่อไป</p>
                <div class="transfer-signature">
                    <div>ขอแสดงความนับถือ</div><br />
                    <div>………………………………………………….</div>
                    <div>(คุณสอง ยาสมุทร)</div>
                    <div>ผู้จัดการฝ่ายพัฒนาธุรกิจ</div>
                </div>
            </section>
            @:<section class="transfer-attachment">
            <h2 class="title">รายละเอียดประกอบการส่งมอบและโอนย้ายฝ่าย</h2>
            RenderAttachmentDetails();
        }
        else
        {
        <div class="memo-row"><span class="memo-label short">เรื่อง</span><span class="memo-value">ขอนำเสนองาน@(projectName)</span></div>
        <div class="memo-row"><span class="memo-label short">เรียน</span><span class="memo-value">ผู้จัดการฝ่ายพัฒนาธุรกิจ</span></div>

        <p class="intro">
            ตามที่ฝ่ายพัฒนาธุรกิจได้รับมอบหมายให้ดำเนิน@(projectName) ให้แก่@(coopName) โดยทีมผู้พัฒนาได้ดำเนินการพัฒนาระบบตามขอบเขตงานที่กำหนด และปัจจุบันอยู่ระหว่างการเตรียมความพร้อมเพื่อติดตั้งและนำระบบขึ้นใช้งานจริง (Production) นั้น
        </p>
        <p class="intro">
            เพื่อให้การดำเนินโครงการเป็นไปอย่างมีประสิทธิภาพ และเป็นไปตามแผนงานที่กำหนด จึงขอสรุปข้อมูลการดำเนินโครงการ ขอบเขตงานเพิ่มเติม กำหนดการส่งมอบงานตามสัญญา ตลอดจนรายชื่อผู้รับผิดชอบโครงการ เพื่อเสนอให้พิจารณาและรับทราบ โดยมีรายละเอียดดังต่อไปนี้
        </p>

        <section class="detail-block">
            @if (hasExtraTorDetail)
            {
                <div class="memo-stack">
                    <div class="memo-stack-label">รายละเอียดงานนอกเหนือ TOR</div>
                    <div class="memo-stack-value memo-project-detail">@Html.Raw(ReportDetail(extraTorDetail))</div>
                </div>
            }

            <div class="memo-stack">
                <div class="memo-stack-label">วันที่พัฒนาโครงการตามสัญญา</div>
                <div class="memo-stack-value">วันที่ @DateText(Model.StartDate) ถึงวันที่ @DateText(Model.EndDate)</div>
            </div>

            <div class="memo-stack">
                <div class="memo-stack-label">รายละเอียดสัญญา</div>
            </div>

            <div class="phase-list">
                @if (Model.Phases.Any())
                {
                    foreach (var phase in Model.Phases)
                    {
                        var due = phase.PeriodEndDate ?? phase.PlanEnd;
                        <div class="phase-line">
                            <div class="phase-title"><strong>ส่วนที่ @phase.PhaseOrder งวดที่ @phase.PeriodOrder</strong> @phase.PhaseName</div>
                            <div class="phase-meta">กำหนดส่งมอบงานวันที่ @DateText(due) ระยะเวลาดำเนินงาน @(phase.DurationDays?.ToString("N0") ?? "-") วัน</div>
                        </div>
                    }
                }
                else
                {
                    <div class="phase-line">-</div>
                }
            </div>
        </section>

        }
        <section class="memo-tail">
            <section>
                <div class="memo-stack">
                    <div class="memo-stack-label">@(Model.IsDepartmentTransfer ? "ทีมงานพัฒนา / ตำแหน่ง" : "ผู้รับผิดชอบส่วนงาน")</div>
                </div>
                <table class="owner-table" aria-label="รายชื่อผู้รับผิดชอบและตำแหน่ง">
                    <tbody>
                    @if (Model.Owners.Any())
                    {
                        for (var ownerIndex = 0; ownerIndex < Model.Owners.Count; ownerIndex += 2)
                        {
                            <tr>
                            @for (var column = 0; column < 2; column++)
                            {
                                var index = ownerIndex + column;
                                <td>
                                @if (index < Model.Owners.Count)
                                {
                                    var owner = Model.Owners[index];
                                    <div>@(index + 1). @owner.Name</div>
                                    <div>ตำแหน่ง @(string.IsNullOrWhiteSpace(owner.Role) ? "-" : owner.Role)</div>
                                }
                                </td>
                            }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="2">-</td></tr>
                    }
                    </tbody>
                </table>
            </section>

            @if (!Model.IsDepartmentTransfer)
            {
            <p class="intro">ทั้งนี้ ทีมผู้พัฒนาจะดำเนินการประสานงานและเตรียมความพร้อมในส่วนที่เกี่ยวข้อง เพื่อให้การติดตั้งและนำระบบขึ้นใช้งานจริงเป็นไปอย่างเรียบร้อย มีประสิทธิภาพ และสอดคล้องกับข้อกำหนดของโครงการ</p>
            <p class="intro">จึงเรียนมาเพื่อโปรดทราบและพิจารณาให้ข้อเสนอแนะในการดำเนินงานต่อไป</p>

            <div class="signature">
                <div>ขอแสดงความนับถือ</div><br />
                <div>………………………………………………….</div>
                <div>(คุณสอง ยาสมุทร)</div>
                <div>ผู้จัดการฝ่ายพัฒนาธุรกิจ</div>
            </div>
            }
        </section>
        @if (Model.IsDepartmentTransfer)
        {
            @:</section>
        }
        else
        {
            <section class="transfer-attachment">
                <h2 class="title">รายละเอียดประกอบการนำระบบขึ้นใช้งานจริง</h2>
                @{ RenderAttachmentDetails(); }
            </section>
        }
    </main>
</body>
</html>

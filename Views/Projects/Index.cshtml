    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
}

.project-card-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 260px);
    align-items: center;
    gap: 24px;
    min-width: 0;
}

.project-phase-action {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.project-phase-action .btn {
    width: 100%;
    max-width: 220px;
    min-height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: .65rem 1rem;
    border-radius: 999px;
    font-size: .88rem;
    font-weight: 800;
    line-height: 1.2;
}

@@media (max-width: 767.98px) {
    .project-card-main {
        grid-template-columns: minmax(0, 1fr);
        gap: 14px;
    }

    .project-phase-action {
        justify-content: stretch;
    }

    .project-phase-action .btn {
        max-width: none;
        min-height: 42px;
    }
}

.project-info-row {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    word-break: normal;
    overflow-wrap: anywhere;
}

.project-detail-row {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: start;
    column-gap: 8px;
}

.project-detail-row .project-label {
    white-space: nowrap;
}

.project-system-row {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: start;
    column-gap: 8px;
}

.project-system-row .project-label {
    white-space: nowrap;
}

.project-system-value,
.project-value {
    min-width: 0;
    color: #0f172a;
    font-size: .88rem;
    font-weight: 400;
    line-height: 1.38;
    text-align: left !important;
    overflow-wrap: anywhere;
}

.project-system-value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
}

.project-system-value.is-table {
    gap: 4px 10px;
}

.project-system-chip {
    min-width: 0;
    max-width: 100%;
    display: inline-grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: baseline;
    column-gap: 4px;
}

.project-system-key {
    color: #0f172a;
    font-weight: 400;
    white-space: nowrap;
}

.project-system-key::after {
    content: ":";
}

.project-system-text {
    min-width: 0;
    overflow-wrap: anywhere;
}

.project-detail-value {
    white-space: pre-line;
}

.project-system-value a {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
}

.project-label {
    display: inline-flex;
    min-width: 0;
    color: var(--pt-surface-contrast, #0f172a);
    font-size: .92rem;
    font-weight: 700;
    line-height: 1.42;
    text-transform: none;
}

.project-title-label,
.project-label,
.project-date-label {
    color: var(--pt-surface-contrast, #0f172a) !important;
    font-size: .92rem;
    font-weight: 700 !important;
    line-height: 1.42;
}

.project-label::after,
.project-date-label::after {
    content: ":";
}

.project-date-row {
    padding: 0;
    border: 0;
    background: transparent;
}

.thai-calendar-note {
    --requirement-card-note-width: min(760px, calc(100vw - 44px));
}

.thai-calendar-note .requirement-card-popup__title {
    display: block;
}

.thai-calendar-note .requirement-card-popup__body {
    gap: 14px;
}

.thai-calendar-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.thai-calendar-month {
    min-width: 0;
    border: 1px solid #cfe0ef;
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(255, 255, 255, .98), rgba(248, 252, 255, .94));
    box-shadow: 0 10px 24px rgba(15, 35, 64, .06);
    overflow: hidden;
}

.thai-calendar-month__title {
    padding: 10px 12px;
    color: #0f766e;
    background: #d8faf4;
    font-weight: 900;
    text-align: center;
}

.thai-calendar-days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 1px;
    padding: 8px;
    background: #e2edf7;
}

.thai-calendar-day-head,
.thai-calendar-day {
    min-height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #10213a;
    background: #fff;
    font-size: .82rem;
    font-weight: 800;
}

.thai-calendar-day-head {
    min-height: 24px;
    color: #64748b;
    background: #f8fafc;
    font-size: .74rem;
    font-weight: 900;
}

.thai-calendar-day.is-empty {
    color: transparent;
    background: rgba(255, 255, 255, .52);
}

.thai-calendar-day.is-weekend {
    color: #be123c;
    background: #fff7f8;
}

.thai-calendar-day.is-today {
    color: #fff;
    background: linear-gradient(135deg, #21d4c2, #0f8f80);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .72);
}

.thai-calendar-note-actions {
    display: flex;
    justify-content: flex-end;
}

@@media (max-width: 575.98px) {
    .thai-calendar-grid {
        grid-template-columns: 1fr;
    }
}

/* Project card layout: team, project summary, phase tile and technical details. */
.project-card {
    --project-card-text: var(--pt-surface-contrast, #10233f);
    --project-card-muted: var(--pt-surface-contrast-muted, #64748b);
    --project-card-border: var(--pt-border, #cfe2f3);
    --project-card-surface: var(--pt-surface, #ffffff);
    --project-card-soft: var(--pt-surface-soft, #f5f9fd);
    padding: 24px 26px 20px;
    color: var(--project-card-text);
    background: var(--project-card-surface);
    border: 1px solid var(--project-card-border);
    border-radius: 20px;
    box-shadow: 0 12px 30px rgba(15, 35, 64, .08);
}

.project-team-header {
    min-width: 0;
    margin-bottom: 18px;
}

.project-team-leads {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
}

.project-card .project-row-number {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    color: var(--project-card-text);
    background: var(--project-card-soft);
    border-color: var(--project-card-border);
    border-radius: 12px;
}

.project-card .project-top-people {
    gap: 10px 30px;
}

.project-card .project-top-people .project-person.is-profile {
    max-width: min(100%, 520px);
    color: var(--project-card-text);
    font-size: .96rem;
    font-weight: 400;
}

.project-card .project-top-people .project-person.is-profile img {
    width: 38px;
    height: 38px;
    flex-basis: 38px;
    border: 2px solid var(--project-card-border);
    background: var(--project-card-surface);
}

.project-card .project-person strong {
    color: var(--project-card-text);
    font-weight: 700;
}

.project-card .project-related-people {
    margin: 12px 0 0 58px;
    color: var(--project-card-text);
}

.project-card .project-related-list {
    gap: 12px 28px;
}

.project-card .project-related-member {
    max-width: 320px;
    color: var(--project-card-text);
}

.project-card .project-related-member > img {
    width: 34px;
    height: 34px;
    flex-basis: 34px;
    border-color: var(--project-card-border);
    background: var(--project-card-surface);
}

.project-card .project-related-member-name {
    color: var(--project-card-text);
    font-size: .86rem;
    font-weight: 500;
}

.project-card .project-related-member-role {
    color: var(--project-card-muted);
    font-size: .74rem;
    font-weight: 400;
}

.project-card-tabs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    padding-bottom: 10px;
    overflow-x: auto;
    border-bottom: 1px solid var(--project-card-border);
    scrollbar-width: thin;
}

.project-card-tab {
    flex: 0 0 auto;
    min-height: 38px;
    padding: 7px 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    color: var(--project-card-text);
    background: var(--project-card-soft);
    border: 1px solid var(--project-card-border);
    border-radius: 9px;
    font-size: .84rem;
    font-weight: 650;
    line-height: 1.2;
    cursor: pointer;
    transition: color .16s ease, background-color .16s ease, border-color .16s ease, box-shadow .16s ease;
}

.project-card-tab:hover {
    color: var(--pt-accent-dark, #145edf);
    border-color: var(--pt-accent, #3195ff);
}

.project-card-tab.is-active {
    color: var(--pt-accent-contrast, #ffffff);
    background: linear-gradient(135deg, var(--pt-accent, #3195ff), var(--pt-accent-dark, #145edf));
    border-color: transparent;
    box-shadow: 0 5px 14px var(--pt-accent-soft, rgba(37, 138, 244, .2));
}

.project-card-tab .project-local-icon {
    width: 17px;
    height: 17px;
}

.project-card-tab-count {
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    display: none;
    align-items: center;
    justify-content: center;
    color: currentColor;
    background: color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 999px;
    font-size: .7rem;
    font-weight: 700;
}

.project-card-tab-count:not(:empty) {
    display: inline-flex;
}

.project-card-tab-panel[hidden] {
    display: none !important;
}

.project-overview-grid--summary {
    grid-template-columns: minmax(0, 1fr);
}

.project-inline-panel {
    max-height: 480px;
    padding: 14px;
    overflow: auto;
    color: var(--project-card-text);
    background: var(--project-card-soft);
    border: 1px solid var(--project-card-border);
    border-radius: 14px;
}

.project-inline-state,
.project-inline-empty {
    padding: 24px 14px;
    color: var(--project-card-muted);
    font-size: .86rem;
    font-weight: 400;
    text-align: center;
}

.project-inline-list {
    display: grid;
    gap: 8px;
}

.project-inline-item {
    min-width: 0;
    display: grid;
    align-items: center;
    gap: 10px 14px;
    padding: 11px 13px;
    color: var(--project-card-text);
    background: var(--project-card-surface);
    border: 1px solid var(--project-card-border);
    border-radius: 9px;
}

.project-inline-item--phase {
    grid-template-columns: minmax(135px, .55fr) minmax(220px, 1.5fr) minmax(190px, .8fr) auto;
}

.project-inline-item--assignment {
    grid-template-columns: minmax(210px, .8fr) minmax(240px, 1.4fr) minmax(190px, .7fr) auto;
}

.project-inline-sequence,
.project-inline-phase-name,
.project-inline-work,
.project-inline-dates,
.project-inline-person {
    min-width: 0;
    font-size: .82rem;
    font-weight: 400;
    line-height: 1.4;
    overflow-wrap: anywhere;
}

.project-inline-sequence strong,
.project-inline-phase-name strong,
.project-inline-work strong,
.project-inline-dates strong,
.project-inline-person strong {
    display: block;
    color: var(--project-card-text);
    font-weight: 650;
}

.project-inline-sequence small,
.project-inline-phase-name small,
.project-inline-work small,
.project-inline-dates small,
.project-inline-person small {
    display: block;
    color: var(--project-card-muted);
    font-size: .74rem;
    font-weight: 400;
}

.project-inline-person {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    align-items: center;
    gap: 9px;
}

.project-inline-person img {
    width: 36px;
    height: 36px;
    object-fit: cover;
    background: var(--project-card-surface);
    border: 1px solid var(--project-card-border);
    border-radius: 50%;
}

.project-inline-status {
    justify-self: end;
    white-space: nowrap;
    font-size: .78rem;
    font-weight: 650;
}

.project-inline-status.is-done { color: #138a55; }
.project-inline-status.is-progress { color: #1769d2; }
.project-inline-status.is-delay { color: #dc3545; }
.project-inline-status.is-other { color: var(--project-card-muted); }

@@media (max-width: 991.98px) {
    .project-inline-item--phase,
    .project-inline-item--assignment {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    }

    .project-inline-status {
        justify-self: start;
    }
}

@@media (max-width: 575.98px) {
    .project-card-tabs {
        gap: 6px;
    }

    .project-card-tab {
        padding: 7px 10px;
        font-size: .78rem;
    }

    .project-inline-panel {
        padding: 9px;
    }

    .project-inline-item--phase,
    .project-inline-item--assignment {
        grid-template-columns: minmax(0, 1fr);
    }
}

.project-overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 310px);
    align-items: stretch;
    gap: 18px;
    min-width: 0;
}

.project-summary-panel,
.project-tech-panel {
    min-width: 0;
    background: var(--project-card-soft);
    border: 1px solid color-mix(in srgb, var(--project-card-border) 72%, transparent);
    border-radius: 14px;
}

.project-summary-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    padding: 18px 20px;
}

.project-summary-row {
    display: grid;
    grid-template-columns: 28px 108px minmax(0, 1fr);
    align-items: start;
    gap: 8px;
    min-width: 0;
}

.project-summary-icon,
.project-tech-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    min-height: 24px;
    color: var(--pt-accent, #258af4);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1;
}

.project-local-icon {
    --project-local-icon-source: none;
    display: inline-block;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    background-color: currentColor;
    -webkit-mask-image: var(--project-local-icon-source);
    mask-image: var(--project-local-icon-source);
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
}

.project-local-icon--building { --project-local-icon-source: url('/images/icons/projects/building.svg'); }
.project-local-icon--project { --project-local-icon-source: url('/images/icons/projects/folder2-open.svg'); }
.project-local-icon--department { --project-local-icon-source: url('/images/icons/projects/briefcase.svg'); }
.project-local-icon--status { --project-local-icon-source: url('/images/icons/projects/bar-chart-line.svg'); }
.project-local-icon--detail { --project-local-icon-source: url('/images/icons/projects/card-text.svg'); }
.project-local-icon--phase { --project-local-icon-source: url('/images/icons/projects/puzzle-fill.svg'); }
.project-local-icon--system { --project-local-icon-source: url('/images/icons/projects/display.svg'); }
.project-local-icon--database { --project-local-icon-source: url('/images/icons/projects/database.svg'); }
.project-local-icon--account { --project-local-icon-source: url('/images/icons/projects/people.svg'); }
.project-local-icon--remote { --project-local-icon-source: url('/images/icons/projects/pc-display-horizontal.svg'); }
.project-local-icon--calendar { --project-local-icon-source: url('/images/icons/projects/calendar3.svg'); }
.project-local-icon--list { --project-local-icon-source: url('/images/icons/projects/list-ul.svg'); }

.project-card .project-summary-label,
.project-card .project-tech-label {
    color: var(--project-card-text) !important;
    -webkit-text-fill-color: var(--project-card-text) !important;
    font-size: .88rem !important;
    font-weight: 700 !important;
    line-height: 1.45 !important;
}

.project-card .project-summary-value,
.project-card .project-tech-value,
.project-card .project-system-value,
.project-card .project-system-key,
.project-card .project-system-text {
    min-width: 0;
    color: var(--project-card-text) !important;
    -webkit-text-fill-color: var(--project-card-text) !important;
    font-size: .88rem;
    font-weight: 400;
    line-height: 1.45;
    overflow-wrap: anywhere;
}

.project-summary-detail {
    padding-top: 8px;
    border-top: 1px solid var(--project-card-border);
}

.project-card .project-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
}

.project-summary-status,
.project-card .project-approval-pending-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    padding: .25rem .78rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: .82rem;
    font-weight: 650;
    line-height: 1.2;
}

.project-summary-status.is-done {
    color: #087f4f;
    background: #d9fbe9;
    border-color: #a7efca;
}

.project-summary-status.is-progress {
    color: #0b6f54;
    background: #d9f7e8;
    border-color: #a8ebca;
}

.project-summary-status.is-other,
.project-card .project-approval-pending-badge {
    color: #a65d00;
    background: #fff3d1;
    border-color: #f7d990;
}

.project-phase-action {
    display: flex;
    min-width: 0;
}

.project-phase-tile {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    min-height: 194px;
    overflow: hidden;
    color: var(--pt-accent-contrast, #ffffff) !important;
    text-decoration: none !important;
    background: linear-gradient(145deg, var(--pt-accent, #3195ff), var(--pt-accent-dark, #145edf));
    border: 1px solid color-mix(in srgb, var(--pt-accent, #3195ff) 78%, #ffffff 22%);
    border-radius: 16px;
    box-shadow: 0 12px 24px var(--pt-accent-soft, rgba(37, 138, 244, .22));
    transition: transform .18s ease, box-shadow .18s ease;
}

.project-phase-tile:hover {
    color: var(--pt-accent-contrast, #ffffff) !important;
    transform: translateY(-2px);
    box-shadow: 0 16px 30px var(--pt-accent-glow, rgba(37, 138, 244, .3));
}

.project-phase-tile__body {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 20px 48px;
}

.project-phase-tile__icon {
    width: 50px;
    height: 50px;
    color: var(--pt-accent-contrast, #ffffff);
}

.project-phase-tile__title {
    color: inherit;
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.2;
}

.project-phase-tile__arrow {
    position: absolute;
    right: 18px;
    top: 50%;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--pt-accent-dark, #145edf);
    background: rgba(255, 255, 255, .72);
    border-radius: 50%;
    font-size: 2rem;
    font-weight: 400;
    transform: translateY(-50%);
}

.project-phase-tile__footer {
    display: flex;
    align-items: center;
    min-height: 46px;
    padding: 10px 16px;
    gap: 8px;
    color: inherit;
    background: rgba(0, 38, 130, .16);
    font-size: .82rem;
    font-weight: 650;
}

.project-phase-tile__footer-icon {
    width: 17px;
    height: 17px;
}

.project-tech-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
    gap: 0;
    margin-top: 14px;
    padding: 16px 20px;
}

.project-tech-column {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    overflow: hidden;
}

.project-tech-column + .project-tech-column {
    margin-left: 22px;
    padding-left: 22px;
    border-left: 1px solid var(--project-card-border);
}

.project-tech-row {
    display: grid;
    grid-template-columns: 28px 116px minmax(0, 1fr);
    align-items: start;
    gap: 8px;
    min-width: 0;
}

.project-tech-system-row {
    align-items: baseline;
}

.project-card .project-system-value {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    width: 100%;
    overflow: hidden;
}

.project-card .project-system-chip {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 4px;
    width: 100%;
    min-width: 0;
    max-width: 100%;
}

.project-card .project-system-chip.is-text-only {
    display: block;
    white-space: normal;
}

.project-card .project-system-chip.is-text-only .project-system-text {
    display: block;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
}

.project-card .project-system-value a {
    min-width: 0;
    color: #0d6efd !important;
    -webkit-text-fill-color: #0d6efd !important;
    overflow-wrap: anywhere;
}

.project-preserve-lines {
    white-space: pre-line;
}

.project-tech-date-row {
    grid-template-columns: 28px 116px minmax(90px, 1fr);
}

.project-tech-end-label {
    grid-column: 2;
}

.project-mobile-cards .project-actions {
    grid-template-columns: repeat(8, minmax(0, 1fr));
    overflow: visible;
}

@@media (max-width: 1199.98px) {
    .project-mobile-cards .project-actions {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }
}

@@media (max-width: 767.98px) {
    .project-card {
        padding: 18px;
    }

    .project-team-leads {
        align-items: flex-start;
    }

    .project-card .project-top-people {
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
    }

    .project-card .project-top-people .project-person.is-profile {
        max-width: 100%;
    }

    .project-card .project-related-people {
        margin-left: 0;
    }

    .project-overview-grid,
    .project-tech-panel {
        grid-template-columns: minmax(0, 1fr);
    }

    .project-phase-tile {
        min-height: 150px;
    }

    .project-tech-column + .project-tech-column {
        margin: 12px 0 0;
        padding: 12px 0 0;
        border-top: 1px solid var(--project-card-border);
        border-left: 0;
    }

    .project-mobile-cards .project-actions {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@@media (max-width: 479.98px) {
    .project-summary-row,
    .project-tech-row,
    .project-tech-date-row {
        grid-template-columns: 24px minmax(0, 1fr);
    }

    .project-summary-value,
    .project-tech-value,
    .project-system-value {
        grid-column: 2;
    }

    .project-tech-end-label {
        grid-column: 2;
    }
}

.project-card:hover {
    transform: translateY(-2px);
    border-color: #3b82f6;
    box-shadow: 0 12px 24px rgba(15,23,42,.12);
}

</style>

@section Scripts{
<script>
document.addEventListener("DOMContentLoaded", function () {

const calendarButton = document.getElementById("ThaiCalendarNoteButton");
const calendarNote = document.getElementById("ThaiCalendarNoteModal");
const calendarHeader = document.getElementById("ThaiCalendarNoteHeader");
const calendarPositionKey = "ProjectTracking.Projects.ThaiCalendarNotePosition";

function calendarBounds() {
    const rect = calendarNote?.getBoundingClientRect();
    const margin = 8;
    return {
        margin,
        maxLeft: Math.max(margin, window.innerWidth - (rect?.width || 0) - margin),
        maxTop: Math.max(margin, window.innerHeight - (rect?.height || 0) - margin)
    };
}

function clampCalendarPosition(left, top) {
    if (!calendarNote) return;
    const bounds = calendarBounds();
    const nextLeft = Math.min(Math.max(left, bounds.margin), bounds.maxLeft);
    const nextTop = Math.min(Math.max(top, bounds.margin), bounds.maxTop);
    calendarNote.style.setProperty("--requirement-card-note-left", `${nextLeft}px`);
    calendarNote.style.setProperty("--requirement-card-note-top", `${nextTop}px`);
}

function applySavedCalendarPosition() {
    if (!calendarNote) return;
    if (window.matchMedia?.("(max-width: 575.98px)").matches) {
        calendarNote.style.removeProperty("--requirement-card-note-left");
        calendarNote.style.removeProperty("--requirement-card-note-top");
        return;
    }

    let saved = null;
    try {
        saved = JSON.parse(window.localStorage?.getItem(calendarPositionKey) || "null");
    } catch {
        saved = null;
    }

    if (!saved || !Number.isFinite(saved.left) || !Number.isFinite(saved.top)) return;
    clampCalendarPosition(saved.left, saved.top);
}

function openCalendarNote() {
    if (!calendarNote) return;
    if (calendarNote.parentElement !== document.body) {
        document.body.appendChild(calendarNote);
    }

    applySavedCalendarPosition();
    calendarNote.classList.add("is-open");
    calendarNote.setAttribute("aria-hidden", "false");
}

function closeCalendarNote() {
    if (!calendarNote) return;
    calendarNote.classList.remove("is-open");
    calendarNote.setAttribute("aria-hidden", "true");
}

calendarButton?.addEventListener("click", openCalendarNote);
document.querySelectorAll("[data-thai-calendar-close]").forEach(button => {
    button.addEventListener("click", closeCalendarNote);
});

if (calendarNote && calendarHeader) {
    let startX = 0;
    let startY = 0;
    let startLeft = 0;
    let startTop = 0;

    function stopCalendarDrag() {
        calendarNote.classList.remove("is-dragging");
        document.removeEventListener("pointermove", dragCalendarNote);
        document.removeEventListener("pointerup", stopCalendarDrag);
        document.removeEventListener("pointercancel", stopCalendarDrag);

        const rect = calendarNote.getBoundingClientRect();
        window.localStorage?.setItem(calendarPositionKey, JSON.stringify({
            left: Math.round(rect.left),
            top: Math.round(rect.top)
        }));
    }

    function dragCalendarNote(event) {
        clampCalendarPosition(
            startLeft + event.clientX - startX,
            startTop + event.clientY - startY
        );
    }

    calendarHeader.addEventListener("pointerdown", function (event) {
        if (window.matchMedia?.("(max-width: 575.98px)").matches) return;
        if (event.target.closest("button, a, input, textarea, select")) return;

        event.preventDefault();
        startX = event.clientX;
        startY = event.clientY;
        const rect = calendarNote.getBoundingClientRect();
        startLeft = rect.left;
        startTop = rect.top;
        calendarNote.classList.add("is-dragging");
        calendarHeader.setPointerCapture?.(event.pointerId);
        document.addEventListener("pointermove", dragCalendarNote);
        document.addEventListener("pointerup", stopCalendarDrag);
        document.addEventListener("pointercancel", stopCalendarDrag);
    });

    window.addEventListener("resize", function () {
        if (!calendarNote.classList.contains("is-open")) return;
        applySavedCalendarPosition();
    });
}

function escapeProjectInlineText(value) {
    return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}

function projectInlineStatusClass(tone) {
    return ["done", "progress", "delay"].includes(tone) ? `is-${tone}` : "is-other";
}

function renderProjectPhases(panel, items) {
    if (!items.length) {
        panel.innerHTML = '<div class="project-inline-empty">ยังไม่มีงวดงานในโครงการนี้</div>';
        return;
    }

    panel.innerHTML = `<div class="project-inline-list">${items.map(item => `
        <article class="project-inline-item project-inline-item--phase">
            <div class="project-inline-sequence">
                <strong>ส่วนที่ ${escapeProjectInlineText(item.phaseOrder)} งวดที่ ${escapeProjectInlineText(item.periodOrder)}</strong>
                ${item.assignmentCount == null
                    ? ""
                    : `<small>${escapeProjectInlineText(item.assignmentCount)} งานที่มอบหมาย</small>`}
            </div>
            <div class="project-inline-phase-name">
                <strong>${escapeProjectInlineText(item.name || "-")}</strong>
                <small>กำหนดส่ง ${escapeProjectInlineText(item.dueDate)}</small>
            </div>
            <div class="project-inline-dates">
                <strong>วันที่ตามแผน</strong>
                <small>${escapeProjectInlineText(item.dateRange)}</small>
            </div>
            <span class="project-inline-status ${projectInlineStatusClass(item.statusTone)}">${escapeProjectInlineText(item.status)}</span>
        </article>
    `).join("")}</div>`;
}

function renderProjectAssignments(panel, items) {
    if (!items.length) {
        panel.innerHTML = '<div class="project-inline-empty">ยังไม่มีงานที่มอบหมายในโครงการนี้</div>';
        return;
    }

    panel.innerHTML = `<div class="project-inline-list">${items.map(item => `
        <article class="project-inline-item project-inline-item--assignment">
            <div class="project-inline-person">
                <img src="${escapeProjectInlineText(item.profileImage || "/images/Profile/profile.png")}" alt="${escapeProjectInlineText(item.employeeName)}" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                <span>
                    <strong>${escapeProjectInlineText(item.employeeName)}</strong>
                    <small>${escapeProjectInlineText(item.position)}</small>
                </span>
            </div>
            <div class="project-inline-work">
                <strong>${escapeProjectInlineText(item.work)}</strong>
                <small>ส่วนที่ ${escapeProjectInlineText(item.phaseOrder)} งวดที่ ${escapeProjectInlineText(item.periodOrder)} · ${escapeProjectInlineText(item.phaseName)}</small>
            </div>
            <div class="project-inline-dates">
                <strong>วันที่ตามแผน</strong>
                <small>${escapeProjectInlineText(item.dateRange)}</small>
            </div>
            <span class="project-inline-status ${projectInlineStatusClass(item.statusTone)}">${escapeProjectInlineText(item.status)}</span>
        </article>
    `).join("")}</div>`;
}

async function loadProjectInlinePanel(card, panel) {
    if (panel.dataset.loaded === "true" || panel.dataset.loading === "true") return;

    const endpoint = panel.dataset.projectInlineEndpoint || "";
    const section = panel.dataset.projectInlineSection || "";
    if (!endpoint || !section) return;

    panel.dataset.loading = "true";
    panel.innerHTML = `<div class="project-inline-state">กำลังโหลด${section === "phases" ? "ข้อมูลงวดงาน" : "ข้อมูลงานที่มอบหมาย"}...</div>`;

    try {
        const separator = endpoint.includes("?") ? "&" : "?";
        const response = await fetch(`${endpoint}${separator}section=${encodeURIComponent(section)}`, {
            headers: { "X-Requested-With": "XMLHttpRequest" }
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        const data = await response.json();
        const items = Array.isArray(data.items) ? data.items : [];
        if (section === "phases") {
            renderProjectPhases(panel, items);
        } else {
            renderProjectAssignments(panel, items);
        }

        const count = card.querySelector(`[data-project-tab-count="${section}"]`);
        if (count) count.textContent = String(items.length);
        panel.dataset.loaded = "true";
    } catch (error) {
        panel.innerHTML = '<div class="project-inline-state">โหลดข้อมูลไม่สำเร็จ กรุณากด Tab นี้อีกครั้ง</div>';
    } finally {
        panel.dataset.loading = "false";
    }
}

document.querySelectorAll(".project-card-tabs").forEach(tabList => {
    const card = tabList.closest(".project-card");
    if (!card) return;

    const tabs = Array.from(tabList.querySelectorAll("[data-project-card-tab]"));
    const panels = Array.from(card.querySelectorAll(".project-card-tab-panel"));

    tabs.forEach(tab => {
        tab.addEventListener("click", function () {
            const panelId = tab.dataset.projectCardTab;
            const panel = panelId ? document.getElementById(panelId) : null;
            if (!panel) return;

            tabs.forEach(item => {
                const selected = item === tab;
                item.classList.toggle("is-active", selected);
                item.setAttribute("aria-selected", selected ? "true" : "false");
                item.tabIndex = selected ? 0 : -1;
            });

            panels.forEach(item => {
                const selected = item === panel;
                item.hidden = !selected;
                item.classList.toggle("is-active", selected);
            });

            if (panel.dataset.projectInlineSection) {
                loadProjectInlinePanel(card, panel);
            }
        });
    });
});

window.applyProjectFilter = function () {

    const selectedCoop = (
        document.getElementById("coopFilter")?.value || ""
    ).trim().toLowerCase();
    localStorage.setItem("projects.selectedCoop", selectedCoop);

    const selectedProject = (
        document.getElementById("projectFilter")?.value || ""
    ).trim().toLowerCase();
    localStorage.setItem("projects.selectedProject", selectedProject);

    const selectedBa = (
        document.getElementById("baFilter")?.value || ""
    ).trim().toLowerCase();

    localStorage.setItem("projects.selectedBa", selectedBa);

    const selectedDepartment = (
        document.getElementById("departmentFilter")?.value || ""
    ).trim().toLowerCase();
    localStorage.setItem("projects.selectedDepartment", selectedDepartment);

    const selectedPm = (
        document.getElementById("pmFilter")?.value || ""
    ).trim().toLowerCase();

    localStorage.setItem("projects.selectedPm", selectedPm);

    const selectedStatus = (
        document.getElementById("statusFilter")?.value || ""
    ).trim().toLowerCase();

    localStorage.setItem("projects.selectedStatus", selectedStatus);

    // mobile cards (หน้าที่ใช้งานจริง)
    let visibleCardNo = 1;
    document.querySelectorAll(".project-card").forEach(card => {

        const projectId = (
            card.dataset.projectId || ""
        ).trim().toLowerCase();

        const coopId = (
            card.dataset.coopId || "unassigned"
        ).trim().toLowerCase();

        const baName = (
            card.dataset.ba || ""
        ).trim().toLowerCase();

        const department = (card.dataset.department || "unassigned").trim().toLowerCase();

        const pmName = (
            card.dataset.pm || ""
        ).trim().toLowerCase();

        const statusName = (
            card.dataset.status || ""
        ).trim().toLowerCase();

        const matchProject = !selectedProject ||
                             projectId === selectedProject;

        const matchCoop = !selectedCoop ||
                          coopId === selectedCoop;

        const matchBa = !selectedBa ||
                        baName.includes(selectedBa);

        const matchDepartment = !selectedDepartment || department === selectedDepartment;

        const matchPm = !selectedPm ||
                        pmName.includes(selectedPm);

        const matchStatus = !selectedStatus ||
                            statusName.includes(selectedStatus);

        const visible = matchCoop && matchProject && matchDepartment && matchBa && matchPm && matchStatus;

        card.style.display = visible ? "block" : "none";

        if (visible) {
            const numberEl = card.querySelector(".project-row-number");
            if (numberEl) numberEl.textContent = String(visibleCardNo++);
        }
    });

    // desktop table (กันไว้)
    let visibleRowNo = 1;
    document.querySelectorAll("#projectTable tbody tr").forEach(row => {

        const projectId = (
            row.dataset.projectId || ""
        ).trim().toLowerCase();

        const coopId = (
            row.dataset.coopId || "unassigned"
        ).trim().toLowerCase();

        const baName = (
            row.dataset.ba || ""
        ).trim().toLowerCase();

        const department = (row.dataset.department || "unassigned").trim().toLowerCase();

        const pmName = (
            row.dataset.pm || ""
        ).trim().toLowerCase();

        const statusName = (
            row.dataset.status || ""
        ).trim().toLowerCase();

        const matchProject = !selectedProject ||
                             projectId === selectedProject;

        const matchCoop = !selectedCoop ||
                          coopId === selectedCoop;

        const matchBa = !selectedBa ||
                        baName.includes(selectedBa);

        const matchDepartment = !selectedDepartment || department === selectedDepartment;

        const matchPm = !selectedPm ||
                        pmName.includes(selectedPm);

        const matchStatus = !selectedStatus ||
                            statusName.includes(selectedStatus);

        const visible = matchCoop && matchProject && matchDepartment && matchBa && matchPm && matchStatus;

        row.style.display = visible ? "table-row" : "none";

        if (visible) {
            const numberCell = row.querySelector(".col-id");
            if (numberCell) numberCell.textContent = String(visibleRowNo++);
        }
    });
};

function restoreFilter(selectId, storageKey) {
    const savedValue = localStorage.getItem(storageKey) || "";
    const select = document.getElementById(selectId);
    if (!savedValue || !select) return;

    const match = Array.from(select.options)
        .find(opt => opt.value.trim().toLowerCase() === savedValue);

    if (match) {
        select.value = match.value;
    }
}

const hasLinkedProjectFilter = document.querySelector(".project-filter-form")
    ?.dataset.hasLinkedProjectFilter === "true";

if (hasLinkedProjectFilter) {
    localStorage.setItem("projects.selectedCoop", document.getElementById("coopFilter")?.value || "");
    localStorage.setItem("projects.selectedProject", document.getElementById("projectFilter")?.value || "");
    localStorage.removeItem("projects.selectedDepartment");
    localStorage.removeItem("projects.selectedBa");
    localStorage.removeItem("projects.selectedPm");
    localStorage.removeItem("projects.selectedStatus");
} else {
    restoreFilter("coopFilter", "projects.selectedCoop");
    restoreFilter("projectFilter", "projects.selectedProject");
    restoreFilter("departmentFilter", "projects.selectedDepartment");
    restoreFilter("baFilter", "projects.selectedBa");
    restoreFilter("pmFilter", "projects.selectedPm");
    restoreFilter("statusFilter", "projects.selectedStatus");
}

function syncProjectFilterOptions() {
    const coopFilter = document.getElementById("coopFilter");
    const departmentFilter = document.getElementById("departmentFilter");
    const projectSelect = document.getElementById("projectFilter");
    if (!projectSelect) return;

    const selectedCoop = (coopFilter?.value || "").trim().toLowerCase();
    const selectedDepartment = (departmentFilter?.value || "").trim().toLowerCase();
    Array.from(projectSelect.options).forEach(option => {
        const visible = option.value === "" ||
            ((!selectedCoop || (option.dataset.coopId || "unassigned").trim().toLowerCase() === selectedCoop) &&
             (!selectedDepartment || (option.dataset.department || "unassigned").trim().toLowerCase() === selectedDepartment));
        option.hidden = !visible;
        option.disabled = !visible;
    });

    const selected = projectSelect.selectedOptions[0];
    if (selected && selected.disabled) projectSelect.value = "";
}

document.getElementById("coopFilter")?.addEventListener("change", function () {
    const projectSelect = document.getElementById("projectFilter");
    if (projectSelect) projectSelect.value = "";
    syncProjectFilterOptions();
    window.applyProjectFilter();
});

document.getElementById("departmentFilter")?.addEventListener("change", function () {
    const projectSelect = document.getElementById("projectFilter");
    if (projectSelect) projectSelect.value = "";
    syncProjectFilterOptions();
    window.applyProjectFilter();
});

["projectFilter", "baFilter", "pmFilter", "statusFilter"].forEach(selectId => {
    document.getElementById(selectId)?.addEventListener("change", window.applyProjectFilter);
});

syncProjectFilterOptions();
setTimeout(() => {
    window.applyProjectFilter();
}, 50);
});
</script>
}

@using System.Globalization
@using System.Text.RegularExpressions
@model IEnumerable<ProjectTracking.Models.Project>
@using Microsoft.AspNetCore.Http
@using ProjectTracking.ViewModels

@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

@{
    ViewData["Title"] = "Project List";
    var th = new CultureInfo("th-TH");
    var projects = (Model ?? Enumerable.Empty<ProjectTracking.Models.Project>()).ToList();
    var departments = ViewBag.ProjectDepartments as IEnumerable<ProjectTracking.Models.ProjectDepartment> ?? Enumerable.Empty<ProjectTracking.Models.ProjectDepartment>();
    var selectedDepartmentId = ViewBag.SelectedDepartmentId is int departmentId ? departmentId : (int?)null;
    var selectedCoopId = ViewBag.SelectedCoopId is int coopId ? coopId : (int?)null;
    var selectedProjectId = ViewBag.SelectedProjectId is int projectId ? projectId : (int?)null;
    var hasLinkedProjectFilter = selectedCoopId.HasValue || selectedProjectId.HasValue;
    var pendingProjectApprovalIds = ViewBag.PendingProjectApprovalIds as ISet<int> ?? new HashSet<int>();
    var relatedMembersByProject = ViewBag.ProjectRelatedMembers as IReadOnlyDictionary<int, List<ProjectOrgMember>>
        ?? new Dictionary<int, List<ProjectOrgMember>>();
    string ProfileImage(ProjectTracking.Models.Employee? employee)
        => ProjectTracking.Services.ProfileImagePathResolver.Normalize(employee?.LoginUser?.ProfileImagePath);
    IReadOnlyList<(string Label, string? Url)> ProjectSystemItems(string? linkName)
    {
        if (string.IsNullOrWhiteSpace(linkName))
        {
            return Array.Empty<(string Label, string? Url)>();
        }

        var raw = linkName.Trim();
        var matches = Regex.Matches(raw, @"https?://\S+", RegexOptions.IgnoreCase);
        if (matches.Count == 0)
        {
            return new[] { (raw, (string?)null) };
        }

        var items = new List<(string Label, string? Url)>();
        var lastIndex = 0;
        foreach (Match match in matches)
        {
            var label = raw[lastIndex..match.Index].Trim().TrimEnd(':', '：').Trim();
            if (string.IsNullOrWhiteSpace(label))
            {
                label = "Link";
            }

            items.Add((label, match.Value.Trim()));
            lastIndex = match.Index + match.Length;
        }

        var trailing = raw[lastIndex..].Trim();
        if (!string.IsNullOrWhiteSpace(trailing))
        {
            items.Add((trailing.TrimEnd(':', '：').Trim(), null));
        }

        return items;
    }
    var orderedProjects = projects
        .OrderBy(x => x.StatusDefinition?.SortOrder ?? int.MaxValue)
        .ThenBy(x => x.EndDate ?? DateTime.MaxValue)
        .ThenBy(x => x.ProjectDisplayName)
        .ToList();

    var calendarToday = DateTime.Today;
    var calendarYear = calendarToday.Year;
    var calendarThaiYear = calendarYear + 543;
    var thaiMonthNames = th.DateTimeFormat.MonthNames.Take(12).ToArray();
    var thaiDayHeaders = new[] { "อา", "จ", "อ", "พ", "พฤ", "ศ", "ส" };
}

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">บันทึกข้อมูลโครงการ</h2>
        <p class="index-subtitle">รายการโครงการทั้งหมดในระบบ</p>
    </div>

    <div class="index-actions">
        <button id="ThaiCalendarNoteButton"
                type="button"
                class="btn btn-outline-warning"
                title="เปิดปฏิทินไทยปี @calendarThaiYear">
            ปฏิทิน
        </button>

        @if (CanMenu("Projects.Create"))
        {
            <a asp-action="Create" class="btn btn-primary" title="เพิ่มโครงการ">
                เพิ่มโครงการ
            </a>
        }
        else
        {
            <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์เพิ่มโครงการ">
                เพิ่มโครงการ
            </button>
        }
    </div>
</div>

<aside class="requirement-card-popup requirement-card-note thai-calendar-note" id="ThaiCalendarNoteModal" aria-hidden="true">
    <div class="requirement-card-note__panel">
        <div class="requirement-card-popup__header" id="ThaiCalendarNoteHeader">
            <div class="requirement-card-popup__heading">
                <div class="requirement-card-popup__eyebrow">ProjectTracking</div>
                <h5 class="requirement-card-popup__title">ปฏิทินไทย @calendarThaiYear</h5>
                <div class="requirement-card-popup__meta">
                    วันนี้ @calendarToday.ToString("dd MMMM yyyy", th)
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-thai-calendar-close aria-label="ปิด"></button>
        </div>
        <div class="requirement-card-popup__body requirement-card-note__body">
            <section class="requirement-card-popup__section">
                <div class="requirement-card-popup__section-head">
                    <h6 class="requirement-card-popup__label mb-0">ปี @calendarThaiYear</h6>
                    <span class="requirement-card-popup__count">12 เดือน</span>
                </div>

                <div class="thai-calendar-grid">
                    @for (var month = 1; month <= 12; month++)
                    {
                        var firstDay = new DateTime(calendarYear, month, 1);
                        var leadingBlanks = (int)firstDay.DayOfWeek;
                        var daysInMonth = DateTime.DaysInMonth(calendarYear, month);

                        <article class="thai-calendar-month">
                            <div class="thai-calendar-month__title">@thaiMonthNames[month - 1]</div>
                            <div class="thai-calendar-days">
                                @foreach (var dayHeader in thaiDayHeaders)
                                {
                                    <div class="thai-calendar-day-head">@dayHeader</div>
                                }

                                @for (var blank = 0; blank < leadingBlanks; blank++)
                                {
                                    <div class="thai-calendar-day is-empty" aria-hidden="true">0</div>
                                }

                                @for (var day = 1; day <= daysInMonth; day++)
                                {
                                    var date = new DateTime(calendarYear, month, day);
                                    var isWeekend = date.DayOfWeek == DayOfWeek.Sunday || date.DayOfWeek == DayOfWeek.Saturday;
                                    var isToday = date.Date == calendarToday.Date;
                                    var dayClass = isToday
                                        ? "thai-calendar-day is-today"
                                        : isWeekend
                                            ? "thai-calendar-day is-weekend"
                                            : "thai-calendar-day";

                                    <div class="@dayClass">@day</div>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>

            <div class="thai-calendar-note-actions">
                <button type="button" class="btn btn-outline-secondary" data-thai-calendar-close>ปิด</button>
            </div>
        </div>
    </div>
</aside>

<div class="card shadow-sm border-0 rounded-4 mb-3">
    <div class="card-body py-3">
        <div class="project-filter-form" data-has-linked-project-filter="@(hasLinkedProjectFilter ? "true" : "false")">

            <div class="project-filter-row">
                <label class="form-label fw-bold">🏢 สหกรณ์</label>
                <select id="coopFilter" class="form-select form-select-lg" data-show-empty-option-text="true">
                    <option value="">ทั้งหมด</option>
                    @foreach (var coop in projects
                        .Where(x => x.CoopId.HasValue && x.Coop != null && !string.IsNullOrWhiteSpace(x.Coop.CoopName))
                        .GroupBy(x => new { CoopId = x.CoopId!.Value, x.Coop!.CoopName })
                        .Select(group => group.Key)
                        .OrderBy(x => x.CoopName))
                    {
                        <option value="@coop.CoopId" selected="@(selectedCoopId == coop.CoopId ? "selected" : null)">@coop.CoopName</option>
                    }
                </select>
            </div>

            <div class="project-filter-row">
                <label class="form-label fw-bold">📁 โครงการ</label>
                <select id="projectFilter" class="form-select form-select-lg">
                    <option value="">ทั้งหมด</option>
                    @foreach (var p in projects.OrderBy(x => x.ProjectDisplayName))
                    {
                        <option value="@p.ProjectId"
                                data-coop-id="@(p.CoopId?.ToString() ?? "unassigned")"
                                data-department="@(p.DepartmentId?.ToString() ?? "unassigned")"
                                data-project-name="@p.ProjectName"
                                selected="@(selectedProjectId == p.ProjectId ? "selected" : null)">
                            @p.ProjectName
                        </option>
                    }
                </select>
            </div>

            <div class="project-filter-pair">
                <div class="project-filter-row">
                    <label class="form-label fw-bold">ฝ่าย</label>
                    <select id="departmentFilter" class="form-select form-select-lg">
                        <option value="">ทุกฝ่าย</option>
                        @foreach (var department in departments)
                        {
                            <option value="@department.DepartmentId" selected="@(selectedDepartmentId == department.DepartmentId ? "selected" : null)">@department.DepartmentName</option>
                        }
                        <option value="unassigned">ยังไม่กำหนดฝ่าย</option>
                    </select>
                </div>

                <div class="project-filter-row">
                    <label class="form-label fw-bold">PM</label>
                    <select id="pmFilter" class="form-select form-select-lg">
                        <option value="">ทั้งหมด</option>
                        @foreach (var pm in projects
                            .SelectMany(x => x.ProjectManagers)
                            .Select(x => x.EmpName)
                            .Where(x => !string.IsNullOrWhiteSpace(x))
                            .Distinct()
                            .OrderBy(x => x))
                        {
                            <option value="@pm">@pm</option>
                        }
                    </select>
                </div>

                <div class="project-filter-row">
                    <label class="form-label fw-bold">👤 BA</label>
                    <select id="baFilter" class="form-select form-select-lg">
                        <option value="">ทั้งหมด</option>
                        @foreach (var ba in projects
                            .SelectMany(x => x.BusinessAnalysts)
                            .Select(x => x.EmpName)
                            .Where(x => !string.IsNullOrWhiteSpace(x))
                            .Distinct()
                            .OrderBy(x => x))
                        {
                            <option value="@ba">@ba</option>
                        }
                    </select>
                </div>

                <div class="project-filter-row">
                    <label class="form-label fw-bold">🔄 สถานะ</label>
                    <select id="statusFilter" class="form-select form-select-lg">
                        <option value="">ทั้งหมด</option>
                        @foreach (var status in (ViewBag.ProjectStatuses as IEnumerable<ProjectTracking.Models.StatusDefinitionOption>
                            ?? Enumerable.Empty<ProjectTracking.Models.StatusDefinitionOption>()))
                        {
                            <option value="@status.StatusCode">@status.StatusDesc</option>
                        }
                    </select>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="table-responsive project-table-wrapper" style="display:none;">
    <table id="projectTable" class="table table-bordered table-hover align-middle project-table">
        <thead class="table-dark text-center">
            <tr>
                <th class="sticky-col-1 col-id">#</th>
                <th class="sticky-col-2 col-name">ชื่อโครงการ</th>
                <th class="col-department">ฝ่าย</th>
                <th class="col-detail">รายละเอียดเพิ่มเติม</th>
                <th class="col-pm">PM</th>
                <th class="col-ba">BA</th>
                <th class="col-system">ระบบ</th>
                <th class="col-db">ฐานข้อมูล</th>
                <th class="col-test">ทะเบียนทดสอบ</th>
                <th class="col-url">รีโมท / URL</th>
                <th class="col-date">วันที่เริ่ม</th>
                <th class="col-date">วันที่สิ้นสุด</th>
                <th class="col-status">สถานะ</th>
                <th class="col-mini">Figma</th>
                <th class="col-action">จัดการ</th>
            </tr>
        </thead>

        <tbody>
        @if (!orderedProjects.Any())
        {
            <tr>
                <td colspan="15" class="text-center text-muted">— ไม่มีข้อมูลโครงการ —</td>
            </tr>
        }
        else
        {
            var rowNo = 1;
            foreach (var p in orderedProjects)
            {
                var projectDisplayName = p.ProjectDisplayName;
                var coopName = p.Coop?.CoopName ?? "";
                var departmentValue = p.DepartmentId?.ToString() ?? "unassigned";
                var projectManagers = p.ProjectManagers;
                var businessAnalysts = p.BusinessAnalysts;
                <tr data-ba-id="@string.Join(",", businessAnalysts.Select(e => e.EmpId))"
                    data-project-id="@p.ProjectId"
                    data-coop-id="@(p.CoopId?.ToString() ?? "unassigned")"
                    data-project="@projectDisplayName.ToLower()"
                    data-project-name="@p.ProjectName.ToLower()"
                    data-coop="@coopName.ToLower()"
                    data-department="@departmentValue"
                    data-ba="@(p.BusinessAnalystNames.ToLower())"
                    data-pm="@(p.ProjectManagerNames.ToLower())"
                    data-status="@((p.StatusDefinition?.StatusCode ?? ProjectTracking.Services.WorkflowStatusPresentation.Code(p.Status)).ToLowerInvariant())">
                    <td class="sticky-col-1 col-id text-center">@rowNo</td>

                    <td class="sticky-col-2 col-name">
                        <div class="project-name-stack">
                            <div class="project-coop-name">@(string.IsNullOrWhiteSpace(coopName) ? "-" : coopName)</div>
                            <div class="project-project-name">@(string.IsNullOrWhiteSpace(p.ProjectName) ? "-" : p.ProjectName)</div>
                        </div>
                    </td>

                    <td class="col-department">@(p.Department?.DepartmentName ?? "ยังไม่กำหนดฝ่าย")</td>

                    <td class="col-detail project-detail-value">@(string.IsNullOrWhiteSpace(p.ProjectDetail) ? "-" : p.ProjectDetail.Trim())</td>

                    <td class="col-pm text-center">
                        @if (projectManagers.Count > 0)
                        {
                            foreach (var member in projectManagers)
                            {
                                <span class="project-person is-table is-profile">
                                    <img class="pt-owner-avatar" src="@ProfileImage(member)" alt="@member.EmpName" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                    <span class="project-person-text">@member.EmpName</span>
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>

                    <td class="col-ba text-center">
                        @if (businessAnalysts.Count > 0)
                        {
                            foreach (var member in businessAnalysts)
                            {
                                <span class="project-person is-table is-profile">
                                    <img class="pt-owner-avatar" src="@ProfileImage(member)" alt="@member.EmpName" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                    <span class="project-person-text">@member.EmpName</span>
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>

                    <td class="col-system">
                        @{
                            var tableSystemItems = ProjectSystemItems(p.LinkName);
                        }
                        @if (tableSystemItems.Count > 0)
                        {
                            <span class="project-system-value is-table">
                                @foreach (var item in tableSystemItems)
                                {
                                    <span class="project-system-chip">
                                        @if (!string.IsNullOrWhiteSpace(item.Url))
                                        {
                                            <span class="project-system-key">@item.Label</span>
                                            <a href="@item.Url" target="_blank" rel="noopener noreferrer">@item.Url</a>
                                        }
                                        else
                                        {
                                            <span class="project-system-text">@item.Label</span>
                                        }
                                    </span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td class="col-db">@p.DatabaseName</td>
                    <td class="col-test">@p.TestAccount</td>
                    <td class="col-url small">@p.RemoteUrl</td>

                    <td class="text-center col-date">
                        @(p.StartDate?.ToString("dd MMM yyyy", th) ?? "-")
                    </td>

                    <td class="text-center col-date">
                        @(p.EndDate?.ToString("dd MMM yyyy", th) ?? "-")
                    </td>

                    <td class="text-center col-status">
                        <span class="badge
                            @((p.StatusDefinition?.StatusCode ?? ProjectTracking.Services.WorkflowStatusPresentation.Code(p.Status)) == "DONE"
                                ? "bg-success"
                                : (p.StatusDefinition?.StatusCode ?? ProjectTracking.Services.WorkflowStatusPresentation.Code(p.Status)) == "IN_PROGRESS"
                                    ? "bg-info"
                                    : "bg-warning text-dark")">
                            @p.StatusDescription
                        </span>
                    </td>

                    <td class="text-center col-mini">
                        @if (!string.IsNullOrEmpty(p.FigmaLink))
                        { <a href="@p.FigmaLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">🎨</a> }
                        else { <span class="text-muted">-</span> }
                    </td>


                    <td class="text-center col-action">
                        <div class="d-flex justify-content-center gap-1 flex-wrap">
                            <a asp-action="ProductionMemo"
                               asp-route-id="@p.ProjectId"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-sm btn-outline-dark"
                               title="บันทึกภายใน Production">📄</a>
                            @if (CanMenu("Projects.Edit"))
                            {
                                <a asp-action="Edit" asp-route-id="@p.ProjectId" class="btn btn-sm btn-outline-primary" title="แก้ไขโครงการ">✏️</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                    ✏️
                                </button>
                            }
                            <a asp-controller="ProjectPhases" asp-action="Index" asp-route-projectId="@p.ProjectId" class="btn btn-sm btn-outline-info">🧩</a>
                            <a asp-controller="ProjectDocuments" 
                               asp-action="Index" 
                               asp-route-projectId="@p.ProjectId" 
                               class="btn btn-sm btn-outline-secondary">📂</a>
                            <a asp-controller="ProjectStatus"
                               asp-action="Index"
                               asp-route-projectId="@p.ProjectId"
                               class="btn btn-sm btn-outline-success"
                               title="ดูสถานะโครงการ">📊</a>
                            @if (CanMenu("ProjectIssues.Index"))
                            {
                                <a asp-controller="ProjectIssues"
                                   asp-action="Index"
                                   asp-route-projectId="@p.ProjectId"
                                   class="btn btn-sm btn-outline-danger"
                                   title="ดูปัญหาโครงการ">🐞</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดูปัญหาโครงการ">🐞</button>
                            }
                            @if (CanMenu("SupportOrders.Index"))
                            {
                                <a asp-controller="SupportOrders"
                                   asp-action="Index"
                                   asp-route-projectId="@p.ProjectId"
                                   class="btn btn-sm btn-outline-warning"
                                   title="ดูงาน Support">🛠</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดูงาน Support">🛠</button>
                            }
                            @if (CanMenu("TestScenarios.Index"))
                            {
                                <a asp-controller="TestScenarios"
                                   asp-action="Index"
                                   asp-route-projectId="@p.ProjectId"
                                   class="btn btn-sm btn-outline-primary"
                                   title="ดูข้อมูลทดสอบ">🧪</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดูข้อมูลทดสอบ">🧪</button>
                            }
                            @if (CanMenu("Projects.Delete"))
                            {
                                <form asp-action="Delete"
                                      asp-route-id="@p.ProjectId"
                                      method="post"
                                      class="project-delete-form"
                                      onsubmit="return confirm('ต้องการลบโครงการนี้หรือไม่?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="ลบโครงการ">🗑</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                    🗑
                                </button>
                            }
                        </div>
                    </td>
                </tr>
                rowNo++;
            }
        }
        </tbody>
    </table>
</div>

<!-- Mobile Card View -->
<div class="project-mobile-cards">
    @if (orderedProjects.Any())
    {
        var mobileRow = 1;

        foreach (var p in orderedProjects)
        {
            var projectDisplayName = p.ProjectDisplayName;
            var coopName = p.Coop?.CoopName ?? "";
            var departmentValue = p.DepartmentId?.ToString() ?? "unassigned";
            var hasPendingApproval = pendingProjectApprovalIds.Contains(p.ProjectId);
            var projectManagers = p.ProjectManagers;
            var businessAnalysts = p.BusinessAnalysts;
            var relatedMembers = relatedMembersByProject.TryGetValue(p.ProjectId, out var projectRelatedMembers)
                ? projectRelatedMembers
                : new List<ProjectOrgMember>();
            var relatedMemberSearch = string.Join(" ", relatedMembers.Select(member => $"{member.Name} {member.Role}"));
            var projectStatusCode = p.StatusDefinition?.StatusCode ?? ProjectTracking.Services.WorkflowStatusPresentation.Code(p.Status);
            var cardSystemItems = ProjectSystemItems(p.LinkName);
            var projectPanelId = $"projectCardSummary-{p.ProjectId}";
            var phasesPanelId = $"projectCardPhases-{p.ProjectId}";
            var assignmentsPanelId = $"projectCardAssignments-{p.ProjectId}";
            var inlineDetailsUrl = Url.Action("InlineDetails", "Projects", new { id = p.ProjectId }) ?? "";
            <div class="project-card"
                 data-project-id="@p.ProjectId"
                 data-coop-id="@(p.CoopId?.ToString() ?? "unassigned")"
                 data-project="@projectDisplayName.ToLower()"
                 data-project-name="@p.ProjectName.ToLower()"
                 data-coop="@coopName.ToLower()"
                 data-department="@departmentValue"
                 data-ba="@(p.BusinessAnalystNames.ToLower())"
                 data-pm="@(p.ProjectManagerNames.ToLower())"
                 data-status="@(projectStatusCode.ToLowerInvariant())"
                data-search="@($"{projectDisplayName} {coopName} {p.Department?.DepartmentName} {p.ProjectName} {p.ProjectDetail} {p.LinkName} {p.DatabaseName} {p.TestAccount} {p.RemoteUrl} {p.BusinessAnalystNames} {p.ProjectManagerNames} {relatedMemberSearch}".ToLower())">

                <div class="project-team-header">
                    <div class="project-team-leads">
                        <span class="project-row-number">@mobileRow</span>
                        <span class="project-top-people">
                            @foreach (var member in projectManagers)
                            {
                                <span class="project-person is-profile">
                                    <img class="pt-owner-avatar" src="@ProfileImage(member)" alt="@member.EmpName" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                    <span class="project-person-text"><strong>PM:</strong> @member.EmpName</span>
                                </span>
                            }
                            @foreach (var member in businessAnalysts)
                            {
                                <span class="project-person is-profile">
                                    <img class="pt-owner-avatar" src="@ProfileImage(member)" alt="@member.EmpName" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                    <span class="project-person-text"><strong>BA:</strong> @member.EmpName</span>
                                </span>
                            }
                        </span>
                    </div>

                    @if (relatedMembers.Count > 0)
                    {
                        <div class="project-related-people">
                            <span class="project-related-list">
                                @foreach (var member in relatedMembers)
                                {
                                    <span class="project-related-member" title="@($"{member.Name} · {member.Role}")">
                                        <img class="pt-owner-avatar" src="@member.AvatarPath" alt="@member.Name" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                        <span class="project-related-member-text">
                                            <span class="project-related-member-name">@member.Name</span>
                                            <span class="project-related-member-role">@member.Role</span>
                                        </span>
                                    </span>
                                }
                            </span>
                        </div>
                    }
                </div>

                <div class="project-card-tabs" role="tablist" aria-label="ข้อมูลของ @projectDisplayName">
                    <button type="button"
                            class="project-card-tab is-active"
                            role="tab"
                            aria-selected="true"
                            aria-controls="@projectPanelId"
                            data-project-card-tab="@projectPanelId">
                        <span class="project-local-icon project-local-icon--project" aria-hidden="true"></span>
                        <span>ข้อมูลโครงการ</span>
                    </button>
                    @if (CanMenu("ProjectPhases.Index"))
                    {
                        <button type="button"
                                class="project-card-tab"
                                role="tab"
                                aria-selected="false"
                                aria-controls="@phasesPanelId"
                                tabindex="-1"
                                data-project-card-tab="@phasesPanelId">
                            <span class="project-local-icon project-local-icon--phase" aria-hidden="true"></span>
                            <span>งวดงาน</span>
                            <span class="project-card-tab-count" data-project-tab-count="phases" aria-hidden="true"></span>
                        </button>
                    }
                    @if (CanMenu("PhaseAssigns.Index"))
                    {
                        <button type="button"
                                class="project-card-tab"
                                role="tab"
                                aria-selected="false"
                                aria-controls="@assignmentsPanelId"
                                tabindex="-1"
                                data-project-card-tab="@assignmentsPanelId">
                            <span class="project-local-icon project-local-icon--account" aria-hidden="true"></span>
                            <span>งานที่มอบหมาย</span>
                            <span class="project-card-tab-count" data-project-tab-count="assignments" aria-hidden="true"></span>
                        </button>
                    }
                </div>

                <section class="project-card-tab-panel is-active"
                         id="@projectPanelId"
                         role="tabpanel">
                <div class="project-overview-grid project-overview-grid--summary">
                    <section class="project-summary-panel" aria-label="ข้อมูลโครงการ">
                        <div class="project-summary-row">
                            <span class="project-summary-icon project-local-icon project-local-icon--building" aria-hidden="true"></span>
                            <span class="project-summary-label">สหกรณ์:</span>
                            <span class="project-summary-value">@(string.IsNullOrWhiteSpace(coopName) ? "-" : coopName)</span>
                        </div>
                        <div class="project-summary-row">
                            <span class="project-summary-icon project-local-icon project-local-icon--project" aria-hidden="true"></span>
                            <span class="project-summary-label">โครงการ:</span>
                            <span class="project-summary-value">@(string.IsNullOrWhiteSpace(p.ProjectName) ? "-" : p.ProjectName)</span>
                        </div>
                        <div class="project-summary-row">
                            <span class="project-summary-icon project-local-icon project-local-icon--department" aria-hidden="true"></span>
                            <span class="project-summary-label">ฝ่าย:</span>
                            <span class="project-summary-value">@(p.Department?.DepartmentName ?? "ยังไม่กำหนดฝ่าย")</span>
                        </div>
                        <div class="project-summary-row">
                            <span class="project-summary-icon project-local-icon project-local-icon--status" aria-hidden="true"></span>
                            <span class="project-summary-label">สถานะ:</span>
                            <span class="project-summary-value project-status">
                                <span class="project-summary-status @(projectStatusCode == "DONE" ? "is-done" : projectStatusCode == "IN_PROGRESS" ? "is-progress" : "is-other")">
                                    @p.StatusDescription
                                </span>
                                @if (hasPendingApproval)
                                {
                                    <span class="project-approval-pending-badge">รออนุมัติ</span>
                                }
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(p.ProjectDetail) && p.ProjectDetail.Trim() != "-")
                        {
                            <div class="project-summary-row project-summary-detail">
                                <span class="project-summary-icon project-local-icon project-local-icon--detail" aria-hidden="true"></span>
                                <span class="project-summary-label">รายละเอียด:</span>
                                <span class="project-summary-value">@p.ProjectDetail.Trim()</span>
                            </div>
                        }
                    </section>
                </div>

                <section class="project-tech-panel" aria-label="ข้อมูลระบบและระยะเวลาโครงการ">
                    <div class="project-tech-column">
                        <div class="project-tech-row project-tech-system-row">
                            <span class="project-tech-icon project-local-icon project-local-icon--system" aria-hidden="true"></span>
                            <span class="project-tech-label">ระบบ:</span>
                            <span class="project-tech-value project-system-value">
                                @if (cardSystemItems.Count > 0)
                                {
                                    foreach (var item in cardSystemItems)
                                    {
                                        <span class="project-system-chip @(!string.IsNullOrWhiteSpace(item.Url) ? "" : "is-text-only")">
                                            @if (!string.IsNullOrWhiteSpace(item.Url))
                                            {
                                                <span class="project-system-key">@item.Label</span>
                                                <a href="@item.Url" target="_blank" rel="noopener noreferrer">@item.Url</a>
                                            }
                                            else
                                            {
                                                <span class="project-system-text">@item.Label</span>
                                            }
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </span>
                        </div>
                        <div class="project-tech-row">
                            <span class="project-tech-icon project-local-icon project-local-icon--database" aria-hidden="true"></span>
                            <span class="project-tech-label">ฐานข้อมูล:</span>
                            <span class="project-tech-value">@(string.IsNullOrWhiteSpace(p.DatabaseName) ? "-" : p.DatabaseName)</span>
                        </div>
                        <div class="project-tech-row">
                            <span class="project-tech-icon project-local-icon project-local-icon--account" aria-hidden="true"></span>
                            <span class="project-tech-label">ทะเบียนทดสอบ:</span>
                            <span class="project-tech-value">@(string.IsNullOrWhiteSpace(p.TestAccount) ? "-" : p.TestAccount)</span>
                        </div>
                    </div>
                    <div class="project-tech-column">
                        <div class="project-tech-row">
                            <span class="project-tech-icon project-local-icon project-local-icon--remote" aria-hidden="true"></span>
                            <span class="project-tech-label">รีโมท:</span>
                            <span class="project-tech-value project-preserve-lines">@(string.IsNullOrWhiteSpace(p.RemoteUrl) ? "-" : p.RemoteUrl)</span>
                        </div>
                        <div class="project-tech-row project-tech-date-row">
                            <span class="project-tech-icon project-local-icon project-local-icon--calendar" aria-hidden="true"></span>
                            <span class="project-tech-label">วันที่เริ่ม:</span>
                            <span class="project-tech-value">@(p.StartDate?.ToString("dd MMM yyyy", th) ?? "-")</span>
                            <span class="project-tech-label project-tech-end-label">วันที่สิ้นสุด:</span>
                            <span class="project-tech-value">@(p.EndDate?.ToString("dd MMM yyyy", th) ?? "-")</span>
                        </div>
                    </div>
                </section>
                </section>

                @if (CanMenu("ProjectPhases.Index"))
                {
                    <section class="project-card-tab-panel project-inline-panel"
                             id="@phasesPanelId"
                             role="tabpanel"
                             hidden
                             data-project-inline-section="phases"
                             data-project-inline-endpoint="@inlineDetailsUrl">
                        <div class="project-inline-state">กำลังโหลดข้อมูลงวดงาน...</div>
                    </section>
                }

                @if (CanMenu("PhaseAssigns.Index"))
                {
                    <section class="project-card-tab-panel project-inline-panel"
                             id="@assignmentsPanelId"
                             role="tabpanel"
                             hidden
                             data-project-inline-section="assignments"
                             data-project-inline-endpoint="@inlineDetailsUrl">
                        <div class="project-inline-state">กำลังโหลดข้อมูลงานที่มอบหมาย...</div>
                    </section>
                }

                <div class="project-actions">
                    <a asp-action="ProductionMemo"
                       asp-route-id="@p.ProjectId"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-outline-dark btn-sm">
                        📄 บันทึกภายใน
                    </a>

                    @if (CanMenu("Projects.Edit"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@p.ProjectId"
                           class="btn btn-outline-primary btn-sm">
                            ✏️ แก้ไข
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            ✏️ แก้ไข
                        </button>
                    }

                    @if (CanMenu("Projects.Delete"))
                    {
                        <form asp-action="Delete"
                              asp-route-id="@p.ProjectId"
                              method="post"
                              class="project-delete-form"
                              onsubmit="return confirm('ต้องการลบโครงการนี้หรือไม่?');">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm">
                                🗑 ลบ
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🗑 ลบ
                        </button>
                    }

                    <a asp-controller="ProjectDocuments"
                       asp-action="Index"
                       asp-route-projectId="@p.ProjectId"
                       class="btn btn-outline-secondary btn-sm">
                        📂 เอกสาร
                    </a>

                    <a asp-controller="ProjectStatus"
                       asp-action="Index"
                       asp-route-projectId="@p.ProjectId"
                       class="btn btn-outline-success btn-sm">
                        📊 สถานะ
                    </a>

                    @if (CanMenu("ProjectIssues.Index"))
                    {
                        <a asp-controller="ProjectIssues"
                           asp-action="Index"
                           asp-route-projectId="@p.ProjectId"
                           class="btn btn-outline-danger btn-sm">
                            🐞 ปัญหา
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🐞 ปัญหา
                        </button>
                    }

                    @if (CanMenu("SupportOrders.Index"))
                    {
                        <a asp-controller="SupportOrders"
                           asp-action="Index"
                           asp-route-projectId="@p.ProjectId"
                           class="btn btn-outline-warning btn-sm">
                            🛠 สนับสนุน
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🛠 สนับสนุน
                        </button>
                    }

                    @if (CanMenu("TestScenarios.Index"))
                    {
                        <a asp-controller="TestScenarios"
                           asp-action="Index"
                           asp-route-projectId="@p.ProjectId"
                           class="btn btn-outline-primary btn-sm">
                            🧪 ทดสอบ
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🧪 ทดสอบ
                        </button>
                    }

                    @if (!string.IsNullOrEmpty(p.FigmaLink))
                    {
                        <a href="@p.FigmaLink"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-primary btn-sm">
                            🎨 แบบหน้าจอ
                        </a>
                    }
                </div>
            </div>

            mobileRow++;
        }
    }
</div>

<style>
.project-filter-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
}

.project-filter-row {
    width: 100%;
    min-width: 0;
}

.project-delete-form {
    display: contents;
}

.project-filter-pair {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
}

@@media (max-width: 767.98px) {
    .project-filter-pair {
        grid-template-columns: 1fr;
    }
}

.project-filter-form .form-control {
    min-height: 48px;
    border-radius: 14px;
    font-weight: 700;
}

.project-people {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 10px 28px;
    margin: 8px 0 12px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #0f172a;
    font-size: .88rem;
    font-weight: 400;
}

.project-person {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    color: #0f172a;
    font-weight: 400;
    line-height: 1.25;
}

.project-person img {
    width: 36px;
    height: 36px;
    flex: 0 0 auto;
    border: 1px solid #dbe6f3;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
}

.project-person span {
    overflow-wrap: anywhere;
}

.project-person strong {
    color: #0f172a;
    font-weight: 600;
}

.project-person.is-table {
    justify-content: flex-start;
    max-width: 100%;
    text-align: left;
}

.project-person.is-table img {
    width: 36px;
    height: 36px;
}

.project-person.is-profile {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    width: 100%;
    text-align: left;
}

.project-person.is-profile img {
    width: 36px;
    height: 36px;
    flex-basis: 36px;
    border: 1px solid #dbe6f3;
    box-shadow: none;
}

.project-person.is-profile .project-person-text {
    display: block;
    max-width: 100%;
    line-height: 1.25;
    min-width: 0;
}

.project-people .project-person.is-profile {
    width: auto;
    max-width: calc(50% - 14px);
}

.project-top-people {
    min-width: 0;
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
}

.project-top-people .project-person.is-profile {
    width: auto;
    max-width: calc(50% - 9px);
}

.project-top-people .project-person.is-profile img {
    width: 34px;
    height: 34px;
    flex-basis: 34px;
}

.project-related-people {
    display: block;
    min-width: 0;
    margin: -2px 0 14px 50px;
    color: var(--pt-surface-contrast, #0f172a);
}

.project-related-list {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 10px 22px;
    min-width: 0;
}

.project-related-member {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    max-width: 260px;
    color: var(--pt-surface-contrast, #0f172a);
}

.project-related-member > img {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    border: 1px solid var(--pt-border, #dbe6f3);
    border-radius: 50%;
    object-fit: cover;
    background: var(--pt-surface, #fff);
}

.project-related-member-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.25;
}

.project-related-member-name {
    color: var(--pt-surface-contrast, #0f172a);
    font-size: .82rem;
    font-weight: 500;
    overflow-wrap: anywhere;
}

.project-related-member-role {
    color: var(--pt-surface-contrast-muted, #64748b);
    font-size: .72rem;
    font-weight: 400;
    overflow-wrap: anywhere;
}

#coopFilterDropdown,
#projectFilterDropdown,
#baFilterDropdown,
#pmFilterDropdown,
#statusFilterDropdown {
    width: 100%;
    border-radius: 14px;
    box-shadow: 0 14px 28px rgba(15, 35, 64, .12);
}

.project-table-wrapper{
    overflow-x:auto;
    border:1px solid #ddd;
    border-radius:10px;
}

/* ===== ปรับสัดส่วนใหม่ ===== */
.col-id{ width:60px; min-width:60px; }

/* Project name slightly smaller so other fields fit */
/* Project name column wider */
.col-name{ width:320px; min-width:320px; }

.col-detail{ width:260px; min-width:260px; }

.col-ba{ width:190px; min-width:190px; }
.col-pm{ width:190px; min-width:190px; }

.col-system{ width:120px; min-width:120px; }
.col-db{ width:120px; min-width:120px; }
.col-test{ width:120px; min-width:120px; }

/* URL a bit wider for readability */
/* URL column wider */
.col-url{ width:300px; min-width:300px; }

.col-date{ width:105px; min-width:105px; }
.col-status{ width:100px; min-width:100px; }
.col-mini{ width:60px; min-width:60px; }

/* Action buttons compact but not cramped */
.col-action{ width:330px; min-width:330px; }

.project-table{
    table-layout: auto;
}

/* sticky */
.sticky-col-1{
    position:sticky;
    left:0;
    background:#fff;
    z-index:3;
}

.sticky-col-2{
    position:sticky;
    left:60px;
    background:#fff;
    z-index:3;
}

thead .sticky-col-1,
thead .sticky-col-2{
    background:#212529 !important;
    color:#fff;
    z-index:4;
}

.project-table th,
.project-table td{
    vertical-align:middle;
}

/* allow text to expand horizontally instead of forcing 2 lines */
.col-name,
.col-url,
.col-detail{
    white-space: pre-line;
    word-break: break-word;
}
/* Mobile Project Cards */
.project-mobile-cards {

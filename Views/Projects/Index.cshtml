.project-title-label {
    color: #0f172a;
    font-weight: 900;
}

.project-name-stack {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.project-coop-name {
    color:#0f172a;
    font-size:.92rem;
    font-weight:400;
    line-height:inherit;
    overflow-wrap:anywhere;
}

.project-project-name {
    color:#0f172a;
    font-size:.92rem;
    font-weight:400;
    line-height:inherit;
    overflow-wrap:anywhere;
}

.project-status {
    display:inline;
    align-items:center;
    margin-top:0;
    vertical-align:middle;
    font-size:inherit;
    line-height:inherit;
}

.project-status .badge {
    font-size: inherit !important;
    font-weight: 400 !important;
    line-height: inherit !important;
    padding: 0 !important;
    vertical-align: baseline !important;
}

main.route-controller-projects .project-card .project-status .badge {
    display: inline !important;
    font-size: inherit !important;
    font-weight: 400 !important;
    line-height: inherit !important;
    padding: 0 !important;
    background: transparent !important;
    border: 0 !important;

    transform: translateY(-2px);
    border-color: #3b82f6;
    box-shadow: 0 12px 24px rgba(15,23,42,.12);
}


</style>

@section Scripts{
<script>
document.addEventListener("DOMContentLoaded", function () {

window.applyProjectFilter = function () {

    const selectedCoop = (
        document.getElementById("coopFilter")?.value || ""
    ).trim().toLowerCase();
    localStorage.setItem("projects.selectedCoop", selectedCoop);

    const selectedProject = (
        document.getElementById("projectFilter")?.value || ""
    ).trim().toLowerCase();
    localStorage.setItem("projects.selectedProject", selectedProject);

    const selectedBa = (
        document.getElementById("baFilter")?.value || ""
    ).trim().toLowerCase();

    localStorage.setItem("projects.selectedBa", selectedBa);

    const selectedStatus = (
        document.getElementById("statusFilter")?.value || ""
    ).trim().toLowerCase();

    localStorage.setItem("projects.selectedStatus", selectedStatus);

    // mobile cards (หน้าที่ใช้งานจริง)
    document.querySelectorAll(".project-card").forEach(card => {

        const projectName = (
            card.dataset.project || ""
        ).trim().toLowerCase();

        const coopName = (
            card.dataset.coop || ""
        ).trim().toLowerCase();

        const baName = (
            card.dataset.ba || ""
        ).trim().toLowerCase();

        const statusName = (
            card.dataset.status || ""
        ).trim().toLowerCase();

        const matchProject = !selectedProject ||
                             projectName === selectedProject;

        const matchCoop = !selectedCoop ||
                          coopName === selectedCoop;

        const matchBa = !selectedBa ||
                        baName.includes(selectedBa);

        const matchStatus = !selectedStatus ||
                            statusName.includes(selectedStatus);

        const visible = matchCoop && matchProject && matchBa && matchStatus;

        card.style.display = visible ? "block" : "none";
    });

    // desktop table (กันไว้)
    document.querySelectorAll("#projectTable tbody tr").forEach(row => {

        const projectName = (
            row.dataset.project || ""
        ).trim().toLowerCase();

        const coopName = (
            row.dataset.coop || ""
        ).trim().toLowerCase();

        const baName = (
            row.dataset.ba || ""
        ).trim().toLowerCase();

        const statusName = (
            row.dataset.status || ""
        ).trim().toLowerCase();

        const matchProject = !selectedProject ||
                             projectName === selectedProject;

        const matchCoop = !selectedCoop ||
                          coopName === selectedCoop;

        const matchBa = !selectedBa ||
                        baName.includes(selectedBa);

        const matchStatus = !selectedStatus ||
                            statusName.includes(selectedStatus);

        const visible = matchCoop && matchProject && matchBa && matchStatus;

        row.style.display = visible ? "table-row" : "none";
    });
};

function restoreFilter(selectId, storageKey) {
    const savedValue = localStorage.getItem(storageKey) || "";
    const select = document.getElementById(selectId);
    if (!savedValue || !select) return;

    const match = Array.from(select.options)
        .find(opt => opt.value.trim().toLowerCase() === savedValue);

    if (match) {
        select.value = match.value;
    }
}

function bindFilterDropdown(config) {
    const searchInput = document.getElementById(config.searchId);
    const dropdown = document.getElementById(config.dropdownId);
    const hiddenSelect = document.getElementById(config.selectId);
    const clearButton = document.getElementById(config.clearId);
    const coopFilter = config.coopFilterId
        ? document.getElementById(config.coopFilterId)
        : null;

    if (!searchInput || !dropdown || !hiddenSelect) return;

    const options = Array.from(hiddenSelect.options);

    function updateClearButton() {
        if (!clearButton) return;
        clearButton.classList.toggle("is-visible", Boolean(searchInput.value || hiddenSelect.value));
    }

    function renderList(filter = "") {
        dropdown.innerHTML = "";

        const keyword = filter.trim().toLowerCase();
        const selectedCoop = (coopFilter?.value || "").trim().toLowerCase();
        const filtered = options.filter(option => {
            if (option.value === "") return false;
            if (selectedCoop && (option.dataset.coopName || "").trim().toLowerCase() !== selectedCoop) return false;

            const text = `${option.text} ${option.value}`.trim().toLowerCase();
            return !keyword || text.includes(keyword);
        });

        if (filtered.length === 0) {
            dropdown.style.display = "none";
            return;
        }

        filtered.forEach(option => {
            const item = document.createElement("a");
            item.className = "list-group-item list-group-item-action";
            item.textContent = option.text;

            item.addEventListener("click", function () {
                searchInput.value = option.text;
                hiddenSelect.value = option.value;
                dropdown.style.display = "none";
                updateClearButton();
                config.onSelect?.(option);
                window.applyProjectFilter();
            });

            dropdown.appendChild(item);
        });

        dropdown.style.display = "block";
    }

    const selectedOption = options.find(option => option.selected && option.value !== "");
    if (selectedOption) {
        searchInput.value = selectedOption.text;
    }
    updateClearButton();

    searchInput.addEventListener("input", function () {
        renderList(this.value);
        updateClearButton();
    });

    searchInput.addEventListener("focus", function () {
        renderList(this.value);
    });

    clearButton?.addEventListener("click", function () {
        searchInput.value = "";
        hiddenSelect.value = "";
        dropdown.style.display = "none";
        updateClearButton();
        config.onClear?.();
        window.applyProjectFilter();
    });

    document.addEventListener("click", function (e) {
        if (!searchInput.contains(e.target) && !dropdown.contains(e.target) && !clearButton?.contains(e.target)) {
            dropdown.style.display = "none";
        }
    });
}

restoreFilter("coopFilter", "projects.selectedCoop");
restoreFilter("projectFilter", "projects.selectedProject");
restoreFilter("baFilter", "projects.selectedBa");
restoreFilter("statusFilter", "projects.selectedStatus");

function clearProjectFilterValue() {
    const projectSearch = document.getElementById("projectFilterSearch");
    const projectSelect = document.getElementById("projectFilter");
    const projectClear = document.getElementById("clearProjectFilter");
    if (projectSearch) projectSearch.value = "";
    if (projectSelect) projectSelect.value = "";
    projectClear?.classList.remove("is-visible");
}

bindFilterDropdown({
    searchId: "coopFilterSearch",
    dropdownId: "coopFilterDropdown",
    selectId: "coopFilter",
    clearId: "clearCoopFilter",
    onSelect: clearProjectFilterValue,
    onClear: clearProjectFilterValue
});

bindFilterDropdown({
    searchId: "projectFilterSearch",
    dropdownId: "projectFilterDropdown",
    selectId: "projectFilter",
    clearId: "clearProjectFilter",
    coopFilterId: "coopFilter"
});

bindFilterDropdown({
    searchId: "baFilterSearch",
    dropdownId: "baFilterDropdown",
    selectId: "baFilter",
    clearId: "clearBaFilter"
});

bindFilterDropdown({
    searchId: "statusFilterSearch",
    dropdownId: "statusFilterDropdown",
    selectId: "statusFilter",
    clearId: "clearStatusFilter"
});

setTimeout(() => {
    window.applyProjectFilter();
}, 50);
});
</script>
}

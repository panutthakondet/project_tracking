@using System.Globalization
@model IEnumerable<ProjectTracking.Models.Project>
@using Microsoft.AspNetCore.Http

@{
    bool CanMenu(string key)
    {
        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Contains(key);
    }
}

@{
    ViewData["Title"] = "Project List";
    var th = new CultureInfo("th-TH");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">📁 บันทึกข้อมูลโครงการ</h2>

    @if (CanMenu("Projects.Create"))
    {
        <a asp-action="Create" class="btn btn-primary" title="เพิ่มโครงการ">
            ➕ Add Project
        </a>
    }
    else
    {
        <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์เพิ่มโครงการ">
            ➕ Add Project
        </button>
    }
</div>

<p class="text-muted">รายการโครงการทั้งหมดในระบบ</p>

<div class="row mb-3">
    <div class="col-md-5">
        <label class="form-label fw-bold">🔍 ค้นหา Project</label>
        <input type="text" id="projectSearchBox"
               class="form-control"
               placeholder="พิมพ์ชื่อโครงการ / system / database / url ..."
               autocomplete="off" />
    </div>
</div>

<div class="table-responsive project-table-wrapper" style="display:none;">
    <table id="projectTable" class="table table-bordered table-hover align-middle project-table">
        <thead class="table-dark text-center">
            <tr>
                <th class="sticky-col-1 col-id">#</th>
                <th class="sticky-col-2 col-name">Project Name</th>
                <th class="col-ba">Business Analyst</th>
                <th class="col-system">System</th>
                <th class="col-db">Database</th>
                <th class="col-test">Test Account</th>
                <th class="col-url">Remote / URL</th>
                <th class="col-date">Start</th>
                <th class="col-date">End</th>
                <th class="col-status">Status</th>
                <th class="col-mini">Figma</th>
                <th class="col-action">Action</th>
            </tr>
        </thead>

        <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="12" class="text-center text-muted">— No project data —</td>
            </tr>
        }
        else
        {
            var rowNo = 1;
            foreach (var p in Model
                .OrderBy(x => x.Status == "IN_PROGRESS" ? 1 :
                              x.Status == "PLAN" ? 2 : 3)
                .ThenBy(x => x.EndDate ?? DateTime.MaxValue))
            {
                <tr data-ba-id="@(p.BA != null ? p.BA.EmpId.ToString() : "")">
                    <td class="sticky-col-1 col-id text-center">@rowNo</td>

                    <td class="sticky-col-2 col-name fw-semibold">
                        @p.ProjectName
                    </td>

                    <td class="col-ba text-center">
                        @(p.BA != null ? p.BA.EmpName : "-")
                    </td>

                    <td class="col-system">
                        @if (!string.IsNullOrEmpty(p.LinkName))
                        {
                            var parts = p.LinkName.Split(' ');

                            foreach (var part in parts)
                            {
                                if (part.StartsWith("https", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a href="@part" target="_blank" rel="noopener noreferrer">@part</a>
                                    <text> </text>
                                }
                                else
                                {
                                    <span>@part</span>
                                    <text> </text>
                                }
                            }
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td class="col-db">@p.DatabaseName</td>
                    <td class="col-test">@p.TestAccount</td>
                    <td class="col-url small">@p.RemoteUrl</td>

                    <td class="text-center col-date">
                        @(p.StartDate?.ToString("dd MMM yyyy", th) ?? "-")
                    </td>

                    <td class="text-center col-date">
                        @(p.EndDate?.ToString("dd MMM yyyy", th) ?? "-")
                    </td>

                    <td class="text-center col-status">
                        <span class="badge
                            @(p.Status == "DONE"
                                ? "bg-success"
                                : p.Status == "IN_PROGRESS"
                                    ? "bg-info"
                                    : "bg-warning text-dark")">
                            @p.Status
                        </span>
                    </td>

                    <td class="text-center col-mini">
                        @if (!string.IsNullOrEmpty(p.FigmaLink))
                        { <a href="@p.FigmaLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">🎨</a> }
                        else { <span class="text-muted">-</span> }
                    </td>


                    <td class="text-center col-action">
                        <div class="d-flex justify-content-center gap-1 flex-wrap">
                            @if (CanMenu("Projects.Edit"))
                            {
                                <a asp-action="Edit" asp-route-id="@p.ProjectId" class="btn btn-sm btn-outline-primary" title="แก้ไขโครงการ">✏️</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                    ✏️
                                </button>
                            }
                            <a asp-controller="ProjectPhases" asp-action="Index" asp-route-projectId="@p.ProjectId" class="btn btn-sm btn-outline-info">🧩</a>
                            <a asp-controller="ProjectDocuments" 
                               asp-action="Index" 
                               asp-route-projectId="@p.ProjectId" 
                               class="btn btn-sm btn-outline-secondary">📂</a>
                            @if (CanMenu("Projects.Delete"))
                            {
                                <a asp-action="Delete" asp-route-id="@p.ProjectId" class="btn btn-sm btn-outline-danger"
                                   title="ลบโครงการ"
                                   onclick="return confirm('Delete project นี้?');">🗑</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                    🗑
                                </button>
                            }
                        </div>
                    </td>
                </tr>
                rowNo++;
            }
        }
        </tbody>
    </table>
</div>

<!-- Mobile Card View -->
<div class="project-mobile-cards">
    @if (Model != null && Model.Any())
    {
        var mobileRow = 1;

        foreach (var p in Model
            .OrderBy(x => x.Status == "IN_PROGRESS" ? 1 :
                          x.Status == "PLAN" ? 2 : 3)
            .ThenBy(x => x.EndDate ?? DateTime.MaxValue))
        {
            <div class="project-card"
                 data-search="@($"{p.ProjectName} {p.LinkName} {p.DatabaseName} {p.TestAccount} {p.RemoteUrl} {p.BA?.EmpName}".ToLower())">

                <div class="project-card-header">
                    <div class="project-avatar">📁</div>

                    <div class="project-header-content">
                        <div class="project-name">
                            @mobileRow. @p.ProjectName
                        </div>

                        <div class="project-status">
                            <span class="badge rounded-pill px-3 py-2
                                @(p.Status == "DONE"
                                    ? "bg-success"
                                    : p.Status == "IN_PROGRESS"
                                        ? "bg-info"
                                        : "bg-warning text-dark")">
                                @p.Status
                            </span>
                        </div>
                    </div>
                </div>

                <div class="project-info">
                    <div class="project-info-row">
                        <span class="project-label">BA</span>
                        <span>@(p.BA?.EmpName ?? "-")</span>
                    </div>

                    <div class="project-info-row">
                        <span class="project-label">System</span>
                        <span>@(p.LinkName ?? "-")</span>
                    </div>

                    <div class="project-info-row">
                        <span class="project-label">Database</span>
                        <span>@(p.DatabaseName ?? "-")</span>
                    </div>

                    <div class="project-info-row">
                        <span class="project-label">Start</span>
                        <span>@(p.StartDate?.ToString("dd MMM yyyy", th) ?? "-")</span>
                    </div>

                    <div class="project-info-row">
                        <span class="project-label">End</span>
                        <span>@(p.EndDate?.ToString("dd MMM yyyy", th) ?? "-")</span>
                    </div>
                </div>

                <div class="project-actions">
                    @if (CanMenu("Projects.Edit"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@p.ProjectId"
                           class="btn btn-outline-primary btn-sm">
                            ✏️ Edit
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            ✏️ Edit
                        </button>
                    }

                    <a asp-controller="ProjectPhases"
                       asp-action="Index"
                       asp-route-projectId="@p.ProjectId"
                       class="btn btn-outline-info btn-sm">
                        🧩 Phase
                    </a>

                    <a asp-controller="ProjectDocuments"
                       asp-action="Index"
                       asp-route-projectId="@p.ProjectId"
                       class="btn btn-outline-secondary btn-sm">
                        📂 Docs
                    </a>
                </div>
            </div>

            mobileRow++;
        }
    }
</div>

<style>
.project-table-wrapper{
    overflow-x:auto;
    border:1px solid #ddd;
    border-radius:10px;
}

/* ===== ปรับสัดส่วนใหม่ ===== */
.col-id{ width:60px; min-width:60px; }

/* Project name slightly smaller so other fields fit */
/* Project name column wider */
.col-name{ width:320px; min-width:320px; }

.col-ba{ width:140px; min-width:140px; }

.col-system{ width:120px; min-width:120px; }
.col-db{ width:120px; min-width:120px; }
.col-test{ width:120px; min-width:120px; }

/* URL a bit wider for readability */
/* URL column wider */
.col-url{ width:300px; min-width:300px; }

.col-date{ width:105px; min-width:105px; }
.col-status{ width:100px; min-width:100px; }
.col-mini{ width:60px; min-width:60px; }

/* Action buttons compact but not cramped */
.col-action{ width:180px; min-width:180px; }

.project-table{
    table-layout: auto;
}

/* sticky */
.sticky-col-1{
    position:sticky;
    left:0;
    background:#fff;
    z-index:3;
}

.sticky-col-2{
    position:sticky;
    left:60px;
    background:#fff;
    z-index:3;
}

thead .sticky-col-1,
thead .sticky-col-2{
    background:#212529 !important;
    color:#fff;
    z-index:4;
}

.project-table th,
.project-table td{
    vertical-align:middle;
}

/* allow text to expand horizontally instead of forcing 2 lines */
.col-name,
.col-url{
    white-space: pre-line;
    word-break: break-word;
}
/* Mobile Project Cards */
.project-mobile-cards {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
}

@@media (max-width: 768px) {

    .project-card-header {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 16px;
    }

    .project-avatar {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        background: linear-gradient(135deg,#2563eb,#3b82f6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #fff;
        flex-shrink: 0;
        box-shadow: 0 6px 18px rgba(37,99,235,.20);
    }

    .project-header-content {
        flex: 1;
    }

    .project-name {
        font-size: 1.08rem;
        font-weight: 700;
        line-height: 1.45;
        color: #0f172a;
    }

    .project-status {
        margin-top: 4px;
    }

    .project-info {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 10px;
    }

    .project-info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        font-size: .94rem;
        padding: 10px 14px;
        background: #f8fafc;
        border-radius: 14px;
        border: 1px solid #e5e7eb;
    }

    .project-label {
        color: #64748b;
        min-width: 80px;
        font-weight: 700;
        font-size: .82rem;
    }

    .project-actions {
        display: flex;
        gap: 10px;
        margin-top: 18px;
    }

    .project-actions .btn {
        flex: 1;
        border-radius: 14px;
        min-height: 44px;
        font-weight: 600;
    }
}

.project-card {
    transition: .2s ease;
    width: 100%;

    background: #fff;
    border: 2px solid #cbd5e1;
    border-radius: 20px;
    padding: 22px;
    margin-bottom: 8px;

    box-shadow: 0 4px 12px rgba(15,23,42,.06);
}

.project-card:hover {
    transform: translateY(-2px);
    border-color: #3b82f6;
    box-shadow: 0 12px 24px rgba(15,23,42,.12);
}


</style>

@section Scripts{
<script>
document.addEventListener("DOMContentLoaded", function () {

    const searchBox = document.getElementById("projectSearchBox");

    function applyFilters(){

        const keyword = (searchBox.value || "").toLowerCase().trim();

        // desktop table
        const rows = document.querySelectorAll("#projectTable tbody tr");

        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            const matchSearch = !keyword || text.includes(keyword);
            row.style.display = matchSearch ? "" : "none";
        });

        // mobile cards
        const cards = document.querySelectorAll(".project-card");

        cards.forEach(card => {
            const text = (card.dataset.search || "").toLowerCase();
            const matchSearch = !keyword || text.includes(keyword);
            card.style.display = matchSearch ? "" : "none";
        });

        // re-number visible rows after filtering
        let index = 1;
        document.querySelectorAll("#projectTable tbody tr").forEach(r => {
            if (r.style.display !== "none" && r.cells.length > 0) {
                const cell = r.querySelector('.col-id');
                if (cell) {
                    cell.innerText = index;
                    index++;
                }
            }
        });
    }

    searchBox.addEventListener("keyup", applyFilters);

});
</script>
}
</div>



@section Scripts{
<script>
document.addEventListener("DOMContentLoaded", function () {

const calendarButton = document.getElementById("ThaiCalendarNoteButton");
const calendarNote = document.getElementById("ThaiCalendarNoteModal");
const calendarHeader = document.getElementById("ThaiCalendarNoteHeader");
const calendarPositionKey = "ProjectTracking.Projects.ThaiCalendarNotePosition";

function calendarBounds() {
    const rect = calendarNote?.getBoundingClientRect();
    const margin = 8;
    return {
        margin,
        maxLeft: Math.max(margin, window.innerWidth - (rect?.width || 0) - margin),
        maxTop: Math.max(margin, window.innerHeight - (rect?.height || 0) - margin)
    };
}

function clampCalendarPosition(left, top) {
    if (!calendarNote) return;
    const bounds = calendarBounds();
    const nextLeft = Math.min(Math.max(left, bounds.margin), bounds.maxLeft);
    const nextTop = Math.min(Math.max(top, bounds.margin), bounds.maxTop);
    calendarNote.style.setProperty("--requirement-card-note-left", `${nextLeft}px`);
    calendarNote.style.setProperty("--requirement-card-note-top", `${nextTop}px`);
}

function applySavedCalendarPosition() {
    if (!calendarNote) return;
    if (window.matchMedia?.("(max-width: 575.98px)").matches) {
        calendarNote.style.removeProperty("--requirement-card-note-left");
        calendarNote.style.removeProperty("--requirement-card-note-top");
        return;
    }

    let saved = null;
    try {
        saved = JSON.parse(window.localStorage?.getItem(calendarPositionKey) || "null");
    } catch {
        saved = null;
    }

    if (!saved || !Number.isFinite(saved.left) || !Number.isFinite(saved.top)) return;
    clampCalendarPosition(saved.left, saved.top);
}

function openCalendarNote() {
    if (!calendarNote) return;
    if (calendarNote.parentElement !== document.body) {
        document.body.appendChild(calendarNote);
    }

    applySavedCalendarPosition();
    calendarNote.classList.add("is-open");
    calendarNote.setAttribute("aria-hidden", "false");
}

function closeCalendarNote() {
    if (!calendarNote) return;
    calendarNote.classList.remove("is-open");
    calendarNote.setAttribute("aria-hidden", "true");
}

calendarButton?.addEventListener("click", openCalendarNote);
document.querySelectorAll("[data-thai-calendar-close]").forEach(button => {
    button.addEventListener("click", closeCalendarNote);
});

if (calendarNote && calendarHeader) {
    let startX = 0;
    let startY = 0;
    let startLeft = 0;
    let startTop = 0;

    function stopCalendarDrag() {
        calendarNote.classList.remove("is-dragging");
        document.removeEventListener("pointermove", dragCalendarNote);
        document.removeEventListener("pointerup", stopCalendarDrag);
        document.removeEventListener("pointercancel", stopCalendarDrag);

        const rect = calendarNote.getBoundingClientRect();
        window.localStorage?.setItem(calendarPositionKey, JSON.stringify({
            left: Math.round(rect.left),
            top: Math.round(rect.top)
        }));
    }

    function dragCalendarNote(event) {
        clampCalendarPosition(
            startLeft + event.clientX - startX,
            startTop + event.clientY - startY
        );
    }

    calendarHeader.addEventListener("pointerdown", function (event) {
        if (window.matchMedia?.("(max-width: 575.98px)").matches) return;
        if (event.target.closest("button, a, input, textarea, select")) return;

        event.preventDefault();
        startX = event.clientX;
        startY = event.clientY;
        const rect = calendarNote.getBoundingClientRect();
        startLeft = rect.left;
        startTop = rect.top;
        calendarNote.classList.add("is-dragging");
        calendarHeader.setPointerCapture?.(event.pointerId);
        document.addEventListener("pointermove", dragCalendarNote);
        document.addEventListener("pointerup", stopCalendarDrag);
        document.addEventListener("pointercancel", stopCalendarDrag);
    });

    window.addEventListener("resize", function () {
        if (!calendarNote.classList.contains("is-open")) return;
        applySavedCalendarPosition();
    });
}

function escapeProjectInlineText(value) {
    return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}

function projectInlineStatusClass(tone) {
    return ["done", "progress", "delay"].includes(tone) ? `is-${tone}` : "is-other";
}

function renderProjectPhases(panel, items) {
    if (!items.length) {
        panel.innerHTML = '<div class="project-inline-empty">ยังไม่มีงวดงานในโครงการนี้</div>';
        return;
    }

    panel.innerHTML = `<div class="project-inline-list">${items.map(item => `
        <article class="project-inline-item project-inline-item--phase">
            <div class="project-inline-sequence">
                <strong>ส่วนที่ ${escapeProjectInlineText(item.phaseOrder)} งวดที่ ${escapeProjectInlineText(item.periodOrder)}</strong>
            </div>
            <div class="project-inline-phase-name">
                <strong>${escapeProjectInlineText(item.name || "-")}</strong>
                <small>กำหนดส่ง ${escapeProjectInlineText(item.dueDate)}</small>
            </div>
            <div class="project-inline-dates">
                <strong>วันที่ตามแผน</strong>
                <small>${escapeProjectInlineText(item.dateRange)}</small>
            </div>
            <span class="project-inline-status ${projectInlineStatusClass(item.statusTone)}">${escapeProjectInlineText(item.status)}</span>
        </article>
    `).join("")}</div>`;
}

function renderProjectAssignments(panel, items) {
    if (!items.length) {
        panel.innerHTML = '<div class="project-inline-empty">ยังไม่มีงานที่มอบหมายในโครงการนี้</div>';
        return;
    }

    panel.innerHTML = `<div class="project-inline-list">${items.map(item => `
        <article class="project-inline-item project-inline-item--assignment">
            <div class="project-inline-person">
                <img src="${escapeProjectInlineText(item.profileImage || "/images/Profile/profile.png")}" alt="${escapeProjectInlineText(item.employeeName)}" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                <span>
                    <strong>${escapeProjectInlineText(item.employeeName)}</strong>
                    <small>${escapeProjectInlineText(item.position)}</small>
                </span>
            </div>
            <div class="project-inline-work">
                <strong>${escapeProjectInlineText(item.work)}</strong>
                <small>ส่วนที่ ${escapeProjectInlineText(item.phaseOrder)} งวดที่ ${escapeProjectInlineText(item.periodOrder)} · ${escapeProjectInlineText(item.phaseName)}</small>
            </div>
            <div class="project-inline-dates">
                <strong>วันที่ตามแผน</strong>
                <small>${escapeProjectInlineText(item.dateRange)}</small>
            </div>
            <span class="project-inline-status ${projectInlineStatusClass(item.statusTone)}">${escapeProjectInlineText(item.status)}</span>
        </article>
    `).join("")}</div>`;
}

async function loadProjectInlinePanel(card, panel) {
    if (panel.dataset.loaded === "true" || panel.dataset.loading === "true") return;

    const endpoint = panel.dataset.projectInlineEndpoint || "";
    const section = panel.dataset.projectInlineSection || "";
    if (!endpoint || !section) return;

    panel.dataset.loading = "true";
    panel.innerHTML = `<div class="project-inline-state">กำลังโหลด${section === "phases" ? "ข้อมูลงวดงาน" : "ข้อมูลงานที่มอบหมาย"}...</div>`;

    try {
        const separator = endpoint.includes("?") ? "&" : "?";
        const response = await fetch(`${endpoint}${separator}section=${encodeURIComponent(section)}`, {
            headers: { "X-Requested-With": "XMLHttpRequest" }
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        const data = await response.json();
        const items = Array.isArray(data.items) ? data.items : [];
        if (section === "phases") {
            renderProjectPhases(panel, items);
        } else {
            renderProjectAssignments(panel, items);
        }

        const count = card.querySelector(`[data-project-tab-count="${section}"]`);
        if (count) count.textContent = String(items.length);
        panel.dataset.loaded = "true";
    } catch (error) {
        panel.innerHTML = '<div class="project-inline-state">โหลดข้อมูลไม่สำเร็จ กรุณากด Tab นี้อีกครั้ง</div>';
    } finally {
        panel.dataset.loading = "false";
    }
}

document.querySelectorAll(".project-card-tabs").forEach(tabList => {
    const card = tabList.closest(".project-card");
    if (!card) return;

    const tabs = Array.from(tabList.querySelectorAll("[data-project-card-tab]"));
    const panels = Array.from(card.querySelectorAll(".project-card-tab-panel"));

    tabs.forEach(tab => {
        tab.addEventListener("click", function () {
            const panelId = tab.dataset.projectCardTab;
            const panel = panelId ? document.getElementById(panelId) : null;
            if (!panel) return;

            tabs.forEach(item => {
                const selected = item === tab;
                item.classList.toggle("is-active", selected);
                item.setAttribute("aria-selected", selected ? "true" : "false");
                item.tabIndex = selected ? 0 : -1;
            });

            panels.forEach(item => {
                const selected = item === panel;
                item.hidden = !selected;
                item.classList.toggle("is-active", selected);
            });

            if (panel.dataset.projectInlineSection) {
                loadProjectInlinePanel(card, panel);
            }
        });
    });
});

window.applyProjectFilter = function () {

    const selectedCoop = (
        document.getElementById("coopFilter")?.value || ""
    ).trim().toLowerCase();
    localStorage.setItem("projects.selectedCoop", selectedCoop);

    const selectedProject = (
        document.getElementById("projectFilter")?.value || ""
    ).trim().toLowerCase();
    localStorage.setItem("projects.selectedProject", selectedProject);

    const selectedBa = (
        document.getElementById("baFilter")?.value || ""
    ).trim().toLowerCase();

    localStorage.setItem("projects.selectedBa", selectedBa);

    const selectedDepartment = (
        document.getElementById("departmentFilter")?.value || ""
    ).trim().toLowerCase();
    localStorage.setItem("projects.selectedDepartment", selectedDepartment);

    const selectedPm = (
        document.getElementById("pmFilter")?.value || ""
    ).trim().toLowerCase();

    localStorage.setItem("projects.selectedPm", selectedPm);

    const selectedStatus = (
        document.getElementById("statusFilter")?.value || ""
    ).trim().toLowerCase();

    localStorage.setItem("projects.selectedStatus", selectedStatus);

    // mobile cards (หน้าที่ใช้งานจริง)
    let visibleCardNo = 1;
    document.querySelectorAll(".project-card").forEach(card => {

        const projectId = (
            card.dataset.projectId || ""
        ).trim().toLowerCase();

        const coopId = (
            card.dataset.coopId || "unassigned"
        ).trim().toLowerCase();

        const baName = (
            card.dataset.ba || ""
        ).trim().toLowerCase();

        const department = (card.dataset.department || "unassigned").trim().toLowerCase();

        const pmName = (
            card.dataset.pm || ""
        ).trim().toLowerCase();

        const statusName = (
            card.dataset.status || ""
        ).trim().toLowerCase();

        const matchProject = !selectedProject ||
                             projectId === selectedProject;

        const matchCoop = !selectedCoop ||
                          coopId === selectedCoop;

        const matchBa = !selectedBa ||
                        baName.includes(selectedBa);

        const matchDepartment = !selectedDepartment || department.split(",").includes(selectedDepartment);

        const matchPm = !selectedPm ||
                        pmName.includes(selectedPm);

        const matchStatus = !selectedStatus ||
                            statusName.includes(selectedStatus);

        const visible = matchCoop && matchProject && matchDepartment && matchBa && matchPm && matchStatus;

        const display = visible ? "block" : "none";
        if (card.style.display !== display) card.style.display = display;

        if (visible) {
            const numberEl = card.querySelector(".project-row-number");
            const number = String(visibleCardNo++);
            if (numberEl && numberEl.textContent !== number) numberEl.textContent = number;
        }
    });


};

function restoreFilter(selectId, storageKey) {
    const savedValue = localStorage.getItem(storageKey) || "";
    const select = document.getElementById(selectId);
    if (!savedValue || !select) return;

    const match = Array.from(select.options)
        .find(opt => opt.value.trim().toLowerCase() === savedValue);

    if (match) {
        select.value = match.value;
    }
}

const hasLinkedProjectFilter = document.querySelector(".project-filter-form")
    ?.dataset.hasLinkedProjectFilter === "true";

if (hasLinkedProjectFilter) {
    localStorage.setItem("projects.selectedCoop", document.getElementById("coopFilter")?.value || "");
    localStorage.setItem("projects.selectedProject", document.getElementById("projectFilter")?.value || "");
    localStorage.removeItem("projects.selectedDepartment");
    localStorage.removeItem("projects.selectedBa");
    localStorage.removeItem("projects.selectedPm");
    localStorage.removeItem("projects.selectedStatus");
} else {
    restoreFilter("coopFilter", "projects.selectedCoop");
    restoreFilter("projectFilter", "projects.selectedProject");
    restoreFilter("departmentFilter", "projects.selectedDepartment");
    restoreFilter("baFilter", "projects.selectedBa");
    restoreFilter("pmFilter", "projects.selectedPm");
    restoreFilter("statusFilter", "projects.selectedStatus");
}

function syncProjectFilterOptions() {
    const coopFilter = document.getElementById("coopFilter");
    const departmentFilter = document.getElementById("departmentFilter");
    const projectSelect = document.getElementById("projectFilter");
    if (!projectSelect) return;

    const selectedCoop = (coopFilter?.value || "").trim().toLowerCase();
    const selectedDepartment = (departmentFilter?.value || "").trim().toLowerCase();
    Array.from(projectSelect.options).forEach(option => {
        const visible = option.value === "" ||
            ((!selectedCoop || (option.dataset.coopId || "unassigned").trim().toLowerCase() === selectedCoop) &&
             (!selectedDepartment || (option.dataset.department || "unassigned").trim().toLowerCase().split(",").includes(selectedDepartment)));
        option.hidden = !visible;
        option.disabled = !visible;
    });

    const selected = projectSelect.selectedOptions[0];
    if (selected && selected.disabled) projectSelect.value = "";
}

function openRequestedProjectCardTab() {
    const params = new URLSearchParams(window.location.search);
    const projectId = (params.get("projectId") || "").trim();
    const requestedTab = (params.get("projectTab") || "").trim().toLowerCase();
    if (!projectId || !["phases", "assignments"].includes(requestedTab)) return;

    const card = Array.from(document.querySelectorAll(".project-card[data-project-id]"))
        .find(item => (item.dataset.projectId || "").trim() === projectId);
    if (!card) return;

    card.style.display = "block";
    const panel = card.querySelector(`[data-project-inline-section="${requestedTab}"]`);
    if (!panel?.id) return;

    const tab = Array.from(card.querySelectorAll("[data-project-card-tab]"))
        .find(item => item.dataset.projectCardTab === panel.id);
    if (!tab) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    card.classList.add("is-deep-link-target");
    tab.click();
    window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
            card.scrollIntoView({
                behavior: reduceMotion ? "auto" : "smooth",
                block: "start"
            });
        });
    });

    window.setTimeout(() => card.classList.remove("is-deep-link-target"), reduceMotion ? 0 : 900);
}

document.getElementById("coopFilter")?.addEventListener("change", function () {
    const projectSelect = document.getElementById("projectFilter");
    if (projectSelect) projectSelect.value = "";
    syncProjectFilterOptions();
    window.applyProjectFilter();
});

document.getElementById("departmentFilter")?.addEventListener("change", function () {
    const projectSelect = document.getElementById("projectFilter");
    if (projectSelect) projectSelect.value = "";
    syncProjectFilterOptions();
    window.applyProjectFilter();
});

["projectFilter", "baFilter", "pmFilter", "statusFilter"].forEach(selectId => {
    document.getElementById(selectId)?.addEventListener("change", window.applyProjectFilter);
});

syncProjectFilterOptions();
window.applyProjectFilter();
openRequestedProjectCardTab();
});
</script>
}

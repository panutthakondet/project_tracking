    .project-header-content {
        flex: 1;
        min-width: 0;
    }

    .project-card-topline {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 12px;
        min-width: 0;
        margin-bottom: 10px;
    }

    .project-card-topline .pt-owner-chip {
        min-width: 0;
        flex: 1 1 auto;
    }

    .project-related-people {
        margin-left: 0;
    }

    .project-related-member {
        max-width: 100%;
    }

    .project-coop-name {
        font-size: .9rem;
        font-weight: 400;
        line-height: 1.45;
        color: #0f172a;
    }

    .project-project-name {
        font-size: .9rem;
        line-height: 1.45;
        color: #0f172a;
    }


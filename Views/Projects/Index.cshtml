@using System.Globalization
@using System.Text.RegularExpressions
@model IEnumerable<ProjectTracking.Models.Project>
@using Microsoft.AspNetCore.Http

@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

@{
    ViewData["Title"] = "Project List";
    var th = new CultureInfo("th-TH");
    var projects = (Model ?? Enumerable.Empty<ProjectTracking.Models.Project>()).ToList();
    var departments = ViewBag.ProjectDepartments as IEnumerable<ProjectTracking.Models.ProjectDepartment> ?? Enumerable.Empty<ProjectTracking.Models.ProjectDepartment>();
    var selectedDepartmentId = ViewBag.SelectedDepartmentId is int departmentId ? departmentId : (int?)null;
    var pendingProjectApprovalIds = ViewBag.PendingProjectApprovalIds as ISet<int> ?? new HashSet<int>();
    string NormalizeProjectStatus(string? status) => (status ?? "")
        .Trim()
        .ToUpperInvariant()
        .Replace(" ", "_")
        .Replace("-", "_");
    string ProfileImage(ProjectTracking.Models.Employee? employee)
        => ProjectTracking.Services.ProfileImagePathResolver.Normalize(employee?.LoginUser?.ProfileImagePath);
    int ProjectSortOrder(string? status) => NormalizeProjectStatus(status) switch
    {
        "IN_PROGRESS" => 1,
        "PLAN" => 2,
        "DONE" => 3,
        _ => 4
    };
    IReadOnlyList<(string Label, string? Url)> ProjectSystemItems(string? linkName)
    {
        if (string.IsNullOrWhiteSpace(linkName))
        {
            return Array.Empty<(string Label, string? Url)>();
        }

        var raw = linkName.Trim();
        var matches = Regex.Matches(raw, @"https?://\S+", RegexOptions.IgnoreCase);
        if (matches.Count == 0)
        {
            return new[] { (raw, (string?)null) };
        }

        var items = new List<(string Label, string? Url)>();
        var lastIndex = 0;
        foreach (Match match in matches)
        {
            var label = raw[lastIndex..match.Index].Trim().TrimEnd(':', '：').Trim();
            if (string.IsNullOrWhiteSpace(label))
            {
                label = "Link";
            }

            items.Add((label, match.Value.Trim()));
            lastIndex = match.Index + match.Length;
        }

        var trailing = raw[lastIndex..].Trim();
        if (!string.IsNullOrWhiteSpace(trailing))
        {
            items.Add((trailing.TrimEnd(':', '：').Trim(), null));
        }

        return items;
    }
    var orderedProjects = projects
        .OrderBy(x => ProjectSortOrder(x.Status))
        .ThenBy(x => x.EndDate ?? DateTime.MaxValue)
        .ThenBy(x => x.ProjectDisplayName)
        .ToList();

    var calendarToday = DateTime.Today;
    var calendarYear = calendarToday.Year;
    var calendarThaiYear = calendarYear + 543;
    var thaiMonthNames = th.DateTimeFormat.MonthNames.Take(12).ToArray();
    var thaiDayHeaders = new[] { "อา", "จ", "อ", "พ", "พฤ", "ศ", "ส" };
}

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">บันทึกข้อมูลโครงการ</h2>
        <p class="index-subtitle">รายการโครงการทั้งหมดในระบบ</p>
    </div>

    <div class="index-actions">
        <a asp-controller="ProjectStatus"
           asp-action="Index"
           class="btn btn-outline-info"
           title="ดูสถานะโครงการ">
            สถานะโครงการ
        </a>

        @if (CanMenu("ProjectIssues.Index"))
        {
            <a asp-controller="ProjectIssues"
               asp-action="Index"
               class="btn btn-outline-danger"
               title="ดูปัญหาโครงการ">
                ปัญหาโครงการ
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดูปัญหาโครงการ">
                ปัญหาโครงการ
            </button>
        }

        @if (CanMenu("SupportOrders.Index"))
        {
            <a asp-controller="SupportOrders"
           asp-action="Index"
           class="btn btn-outline-warning"
               title="ดูงาน Support">
                งาน Support
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดูงาน Support">
                งาน Support
            </button>
        }

        @if (CanMenu("TestScenarios.Index"))
        {
            <a asp-controller="TestScenarios"
           asp-action="Index"
           class="btn btn-outline-primary"
               title="ดูข้อมูลทดสอบ">
                ข้อมูลทดสอบ
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดูข้อมูลทดสอบ">
                ข้อมูลทดสอบ
            </button>
        }

        <button id="ThaiCalendarNoteButton"
                type="button"
                class="btn btn-outline-warning"
                title="เปิดปฏิทินไทยปี @calendarThaiYear">
            ปฏิทิน
        </button>

        @if (CanMenu("Projects.Create"))
        {
            <a asp-action="Create" class="btn btn-primary" title="เพิ่มโครงการ">
                เพิ่มโครงการ
            </a>
        }
        else
        {
            <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์เพิ่มโครงการ">
                เพิ่มโครงการ
            </button>
        }
    </div>
</div>

<aside class="requirement-card-popup requirement-card-note thai-calendar-note" id="ThaiCalendarNoteModal" aria-hidden="true">
    <div class="requirement-card-note__panel">
        <div class="requirement-card-popup__header" id="ThaiCalendarNoteHeader">
            <div class="requirement-card-popup__heading">
                <div class="requirement-card-popup__eyebrow">ProjectTracking</div>
                <h5 class="requirement-card-popup__title">ปฏิทินไทย @calendarThaiYear</h5>
                <div class="requirement-card-popup__meta">
                    วันนี้ @calendarToday.ToString("dd MMMM yyyy", th)
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-thai-calendar-close aria-label="Close"></button>
        </div>
        <div class="requirement-card-popup__body requirement-card-note__body">
            <section class="requirement-card-popup__section">
                <div class="requirement-card-popup__section-head">
                    <h6 class="requirement-card-popup__label mb-0">ปี @calendarThaiYear</h6>
                    <span class="requirement-card-popup__count">12 เดือน</span>
                </div>

                <div class="thai-calendar-grid">
                    @for (var month = 1; month <= 12; month++)
                    {
                        var firstDay = new DateTime(calendarYear, month, 1);
                        var leadingBlanks = (int)firstDay.DayOfWeek;
                        var daysInMonth = DateTime.DaysInMonth(calendarYear, month);

                        <article class="thai-calendar-month">
                            <div class="thai-calendar-month__title">@thaiMonthNames[month - 1]</div>
                            <div class="thai-calendar-days">
                                @foreach (var dayHeader in thaiDayHeaders)
                                {
                                    <div class="thai-calendar-day-head">@dayHeader</div>
                                }

                                @for (var blank = 0; blank < leadingBlanks; blank++)
                                {
                                    <div class="thai-calendar-day is-empty" aria-hidden="true">0</div>
                                }

                                @for (var day = 1; day <= daysInMonth; day++)
                                {
                                    var date = new DateTime(calendarYear, month, day);
                                    var isWeekend = date.DayOfWeek == DayOfWeek.Sunday || date.DayOfWeek == DayOfWeek.Saturday;
                                    var isToday = date.Date == calendarToday.Date;
                                    var dayClass = isToday
                                        ? "thai-calendar-day is-today"
                                        : isWeekend
                                            ? "thai-calendar-day is-weekend"
                                            : "thai-calendar-day";

                                    <div class="@dayClass">@day</div>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>

            <div class="thai-calendar-note-actions">
                <button type="button" class="btn btn-outline-secondary" data-thai-calendar-close>ปิด</button>
            </div>
        </div>
    </div>
</aside>

<div class="card shadow-sm border-0 rounded-4 mb-3">
    <div class="card-body py-3">
        <div class="project-filter-form">

            <div class="project-filter-row">
                <label class="form-label fw-bold">🏢 สหกรณ์</label>
                <select id="coopFilter" class="form-select form-select-lg" data-show-empty-option-text="true">
                    <option value="">ทั้งหมด</option>
                    @foreach (var coopName in projects
                        .Select(x => x.Coop?.CoopName)
                        .Where(x => !string.IsNullOrWhiteSpace(x))
                        .Distinct()
                        .OrderBy(x => x))
                    {
                        <option value="@coopName">@coopName</option>
                    }
                </select>
            </div>

            <div class="project-filter-row">
                <label class="form-label fw-bold">📁 โครงการ</label>
                <select id="projectFilter" class="form-select form-select-lg">
                    <option value="">ทั้งหมด</option>
                    @foreach (var p in projects.OrderBy(x => x.ProjectDisplayName))
                    {
                        <option value="@p.ProjectDisplayName"
                                data-coop-name="@(p.Coop?.CoopName ?? "")"
                                data-department="@(p.DepartmentId?.ToString() ?? "unassigned")"
                                data-project-name="@p.ProjectName">
                            @p.ProjectName
                        </option>
                    }
                </select>
            </div>

            <div class="project-filter-pair">
                <div class="project-filter-row">
                    <label class="form-label fw-bold">ฝ่าย</label>
                    <select id="departmentFilter" class="form-select form-select-lg">
                        <option value="">ทุกฝ่าย</option>
                        @foreach (var department in departments)
                        {
                            <option value="@department.DepartmentId" selected="@(selectedDepartmentId == department.DepartmentId ? "selected" : null)">@department.DepartmentName</option>
                        }
                        <option value="unassigned">ยังไม่กำหนดฝ่าย</option>
                    </select>
                </div>

                <div class="project-filter-row">
                    <label class="form-label fw-bold">PM</label>
                    <select id="pmFilter" class="form-select form-select-lg">
                        <option value="">ทั้งหมด</option>
                        @foreach (var pm in projects
                            .SelectMany(x => x.ProjectManagers)
                            .Select(x => x.EmpName)
                            .Where(x => !string.IsNullOrWhiteSpace(x))
                            .Distinct()
                            .OrderBy(x => x))
                        {
                            <option value="@pm">@pm</option>
                        }
                    </select>
                </div>

                <div class="project-filter-row">
                    <label class="form-label fw-bold">👤 BA</label>
                    <select id="baFilter" class="form-select form-select-lg">
                        <option value="">ทั้งหมด</option>
                        @foreach (var ba in projects
                            .SelectMany(x => x.BusinessAnalysts)
                            .Select(x => x.EmpName)
                            .Where(x => !string.IsNullOrWhiteSpace(x))
                            .Distinct()
                            .OrderBy(x => x))
                        {
                            <option value="@ba">@ba</option>
                        }
                    </select>
                </div>

                <div class="project-filter-row">
                    <label class="form-label fw-bold">🔄 สถานะ</label>
                    <select id="statusFilter" class="form-select form-select-lg">
                        <option value="">ทั้งหมด</option>
                        @foreach (var status in (ViewBag.ProjectStatuses as IEnumerable<ProjectTracking.Models.StatusDefinitionOption>
                            ?? Enumerable.Empty<ProjectTracking.Models.StatusDefinitionOption>()))
                        {
                            <option value="@status.StatusCode">@status.StatusDesc</option>
                        }
                    </select>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="table-responsive project-table-wrapper" style="display:none;">
    <table id="projectTable" class="table table-bordered table-hover align-middle project-table">
        <thead class="table-dark text-center">
            <tr>
                <th class="sticky-col-1 col-id">#</th>
                <th class="sticky-col-2 col-name">ชื่อโครงการ</th>
                <th class="col-department">ฝ่าย</th>
                <th class="col-detail">รายละเอียดเพิ่มเติม</th>
                <th class="col-pm">PM</th>
                <th class="col-ba">BA</th>
                <th class="col-system">ระบบ</th>
                <th class="col-db">ฐานข้อมูล</th>
                <th class="col-test">ทะเบียนทดสอบ</th>
                <th class="col-url">รีโมท / URL</th>
                <th class="col-date">วันที่เริ่ม</th>
                <th class="col-date">วันที่สิ้นสุด</th>
                <th class="col-status">สถานะ</th>
                <th class="col-mini">Figma</th>
                <th class="col-action">จัดการ</th>
            </tr>
        </thead>

        <tbody>
        @if (!orderedProjects.Any())
        {
            <tr>
                <td colspan="15" class="text-center text-muted">— ไม่มีข้อมูลโครงการ —</td>
            </tr>
        }
        else
        {
            var rowNo = 1;
            foreach (var p in orderedProjects)
            {
                var projectDisplayName = p.ProjectDisplayName;
                var coopName = p.Coop?.CoopName ?? "";
                var departmentValue = p.DepartmentId?.ToString() ?? "unassigned";
                var projectManagers = p.ProjectManagers;
                var businessAnalysts = p.BusinessAnalysts;
                <tr data-ba-id="@string.Join(",", businessAnalysts.Select(e => e.EmpId))"
                    data-project="@projectDisplayName.ToLower()"
                    data-project-name="@p.ProjectName.ToLower()"
                    data-coop="@coopName.ToLower()"
                    data-department="@departmentValue"
                    data-ba="@(p.BusinessAnalystNames.ToLower())"
                    data-pm="@(p.ProjectManagerNames.ToLower())"
                    data-status="@((p.Status ?? "").ToLower())">
                    <td class="sticky-col-1 col-id text-center">@rowNo</td>

                    <td class="sticky-col-2 col-name">
                        <div class="project-name-stack">
                            <div class="project-coop-name">@(string.IsNullOrWhiteSpace(coopName) ? "-" : coopName)</div>
                            <div class="project-project-name">@(string.IsNullOrWhiteSpace(p.ProjectName) ? "-" : p.ProjectName)</div>
                        </div>
                    </td>

                    <td class="col-department">@(p.Department?.DepartmentName ?? "ยังไม่กำหนดฝ่าย")</td>

                    <td class="col-detail project-detail-value">@(string.IsNullOrWhiteSpace(p.ProjectDetail) ? "-" : p.ProjectDetail.Trim())</td>

                    <td class="col-pm text-center">
                        @if (projectManagers.Count > 0)
                        {
                            foreach (var member in projectManagers)
                            {
                                <span class="project-person is-table is-profile">
                                    <img class="pt-owner-avatar" src="@ProfileImage(member)" alt="@member.EmpName" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                    <span class="project-person-text">@member.EmpName</span>
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>

                    <td class="col-ba text-center">
                        @if (businessAnalysts.Count > 0)
                        {
                            foreach (var member in businessAnalysts)
                            {
                                <span class="project-person is-table is-profile">
                                    <img class="pt-owner-avatar" src="@ProfileImage(member)" alt="@member.EmpName" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                    <span class="project-person-text">@member.EmpName</span>
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>

                    <td class="col-system">
                        @{
                            var tableSystemItems = ProjectSystemItems(p.LinkName);
                        }
                        @if (tableSystemItems.Count > 0)
                        {
                            <span class="project-system-value is-table">
                                @foreach (var item in tableSystemItems)
                                {
                                    <span class="project-system-chip">
                                        @if (!string.IsNullOrWhiteSpace(item.Url))
                                        {
                                            <span class="project-system-key">@item.Label</span>
                                            <a href="@item.Url" target="_blank" rel="noopener noreferrer">@item.Url</a>
                                        }
                                        else
                                        {
                                            <span class="project-system-text">@item.Label</span>
                                        }
                                    </span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td class="col-db">@p.DatabaseName</td>
                    <td class="col-test">@p.TestAccount</td>
                    <td class="col-url small">@p.RemoteUrl</td>

                    <td class="text-center col-date">
                        @(p.StartDate?.ToString("dd MMM yyyy", th) ?? "-")
                    </td>

                    <td class="text-center col-date">
                        @(p.EndDate?.ToString("dd MMM yyyy", th) ?? "-")
                    </td>

                    <td class="text-center col-status">
                        <span class="badge
                            @(p.Status == "DONE"
                                ? "bg-success"
                                : p.Status == "IN_PROGRESS"
                                    ? "bg-info"
                                    : "bg-warning text-dark")">
                            @p.StatusDescription
                        </span>
                    </td>

                    <td class="text-center col-mini">
                        @if (!string.IsNullOrEmpty(p.FigmaLink))
                        { <a href="@p.FigmaLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">🎨</a> }
                        else { <span class="text-muted">-</span> }
                    </td>


                    <td class="text-center col-action">
                        <div class="d-flex justify-content-center gap-1 flex-wrap">
                            <a asp-action="ProductionMemo"
                               asp-route-id="@p.ProjectId"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-sm btn-outline-dark"
                               title="บันทึกภายใน Production">📄</a>
                            @if (CanMenu("Projects.Edit"))
                            {
                                <a asp-action="Edit" asp-route-id="@p.ProjectId" class="btn btn-sm btn-outline-primary" title="แก้ไขโครงการ">✏️</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                    ✏️
                                </button>
                            }
                            <a asp-controller="ProjectPhases" asp-action="Index" asp-route-projectId="@p.ProjectId" class="btn btn-sm btn-outline-info">🧩</a>
                            <a asp-controller="ProjectDocuments" 
                               asp-action="Index" 
                               asp-route-projectId="@p.ProjectId" 
                               class="btn btn-sm btn-outline-secondary">📂</a>
                            <a asp-controller="ProjectStatus"
                               asp-action="Index"
                               asp-route-projectId="@p.ProjectId"
                               class="btn btn-sm btn-outline-success"
                               title="ดูสถานะโครงการ">📊</a>
                            @if (CanMenu("ProjectIssues.Index"))
                            {
                                <a asp-controller="ProjectIssues"
                                   asp-action="Index"
                                   asp-route-projectId="@p.ProjectId"
                                   class="btn btn-sm btn-outline-danger"
                                   title="ดูปัญหาโครงการ">🐞</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดูปัญหาโครงการ">🐞</button>
                            }
                            @if (CanMenu("SupportOrders.Index"))
                            {
                                <a asp-controller="SupportOrders"
                                   asp-action="Index"
                                   asp-route-projectId="@p.ProjectId"
                                   class="btn btn-sm btn-outline-warning"
                                   title="ดูงาน Support">🛠</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดูงาน Support">🛠</button>
                            }
                            @if (CanMenu("TestScenarios.Index"))
                            {
                                <a asp-controller="TestScenarios"
                                   asp-action="Index"
                                   asp-route-projectId="@p.ProjectId"
                                   class="btn btn-sm btn-outline-primary"
                                   title="ดูข้อมูลทดสอบ">🧪</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดูข้อมูลทดสอบ">🧪</button>
                            }
                            @if (CanMenu("Projects.Delete"))
                            {
                                <form asp-action="Delete"
                                      asp-route-id="@p.ProjectId"
                                      method="post"
                                      class="project-delete-form"
                                      onsubmit="return confirm('ต้องการลบโครงการนี้หรือไม่?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="ลบโครงการ">🗑</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                    🗑
                                </button>
                            }
                        </div>
                    </td>
                </tr>
                rowNo++;
            }
        }
        </tbody>
    </table>
</div>

<!-- Mobile Card View -->
<div class="project-mobile-cards">
    @if (orderedProjects.Any())
    {
        var mobileRow = 1;

        foreach (var p in orderedProjects)
        {
            var projectDisplayName = p.ProjectDisplayName;
            var coopName = p.Coop?.CoopName ?? "";
            var departmentValue = p.DepartmentId?.ToString() ?? "unassigned";
            var hasPendingApproval = pendingProjectApprovalIds.Contains(p.ProjectId);
            var projectManagers = p.ProjectManagers;
            var businessAnalysts = p.BusinessAnalysts;
            <div class="project-card"
                 data-project="@projectDisplayName.ToLower()"
                 data-project-name="@p.ProjectName.ToLower()"
                 data-coop="@coopName.ToLower()"
                 data-department="@departmentValue"
                 data-ba="@(p.BusinessAnalystNames.ToLower())"
                 data-pm="@(p.ProjectManagerNames.ToLower())"
                 data-status="@((p.Status ?? "").ToLower())"
                data-search="@($"{projectDisplayName} {coopName} {p.Department?.DepartmentName} {p.ProjectName} {p.ProjectDetail} {p.LinkName} {p.DatabaseName} {p.TestAccount} {p.RemoteUrl} {p.BusinessAnalystNames} {p.ProjectManagerNames}".ToLower())">

                <div class="project-card-header">
                    <div class="project-header-content">
                        <div class="project-card-topline">
                            <span class="project-row-number">@mobileRow</span>
                            <span class="project-top-people">
                                @foreach (var member in projectManagers)
                                {
                                    <span class="project-person is-profile">
                                        <img class="pt-owner-avatar" src="@ProfileImage(member)" alt="@member.EmpName" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                        <span class="project-person-text"><strong>PM:</strong> @member.EmpName</span>
                                    </span>
                                }
                                @foreach (var member in businessAnalysts)
                                {
                                    <span class="project-person is-profile">
                                        <img class="pt-owner-avatar" src="@ProfileImage(member)" alt="@member.EmpName" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                        <span class="project-person-text"><strong>BA:</strong> @member.EmpName</span>
                                    </span>
                                }
                            </span>
                        </div>

                        <div class="project-title-row">
                            <div class="project-title-stack">
                                <div class="project-title-line">
                                    <span class="project-title-label">สหกรณ์:</span>
                                    <span class="project-coop-name">@(string.IsNullOrWhiteSpace(coopName) ? "-" : coopName)</span>
                                </div>
                                <div class="project-title-line">
                                    <span class="project-title-label">โครงการ:</span>
                                    <span class="project-project-name">@(string.IsNullOrWhiteSpace(p.ProjectName) ? "-" : p.ProjectName)</span>
                                </div>
                                <div class="project-title-line">
                                    <span class="project-title-label">ฝ่าย:</span>
                                    <span>@(p.Department?.DepartmentName ?? "ยังไม่กำหนดฝ่าย")</span>
                                </div>
                                <div class="project-title-line project-status-line">
                                    <span class="project-title-label">สถานะ:</span>
                                    <span class="project-status">
                                        <span class="badge rounded-pill px-3 py-2
                                            @(p.Status == "DONE"
                                                ? "bg-success"
                                                : p.Status == "IN_PROGRESS"
                                                    ? "bg-info"
                                                    : "bg-warning text-dark")">
                                            @p.StatusDescription
                                        </span>
                                        @if (hasPendingApproval)
                                        {
                                            <span class="badge rounded-pill px-3 py-2 bg-warning text-dark project-approval-pending-badge">
                                                รออนุมัติ
                                            </span>
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="project-info">
                    <div class="project-info-row project-detail-row">
                        <span class="project-label">รายละเอียดเพิ่มเติม</span>
                        <span class="project-value project-detail-value">@(string.IsNullOrWhiteSpace(p.ProjectDetail) ? "-" : p.ProjectDetail.Trim())</span>
                    </div>

                    <div class="project-info-row project-system-row">
                        <span class="project-label">ระบบ</span>

                        <span class="project-system-value">
                            @{
                                var cardSystemItems = ProjectSystemItems(p.LinkName);
                            }
                            @if (cardSystemItems.Count > 0)
                            {
                                foreach (var item in cardSystemItems)
                                {
                                    <span class="project-system-chip">
                                        @if (!string.IsNullOrWhiteSpace(item.Url))
                                        {
                                            <span class="project-system-key">@item.Label</span>
                                            <a href="@item.Url"
                                               target="_blank"
                                               rel="noopener noreferrer">
                                                @item.Url
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="project-system-text">@item.Label</span>
                                        }
                                    </span>
                                }
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </span>
                    </div>

                    <div class="project-info-row project-db-row">
                        <span class="project-label">ฐานข้อมูล</span>
                        <span class="project-value">@(p.DatabaseName ?? "-")</span>
                    </div>

                    <div class="project-info-row project-test-row">
                        <span class="project-label">ทะเบียนทดสอบ</span>
                        <span class="project-value text-break">
                            @(string.IsNullOrWhiteSpace(p.TestAccount)
                                ? "-"
                                : p.TestAccount)
                        </span>
                    </div>

                    <div class="project-info-row project-remote-row">
                        <span class="project-label">รีโมท</span>
                        <span class="project-value text-break">
                            @(string.IsNullOrWhiteSpace(p.RemoteUrl)
                                ? "-"
                                : p.RemoteUrl)
                        </span>
                    </div>

                    <div class="project-info-row project-date-row">
                        <div class="project-date-item">
                            <span class="project-date-label">วันที่เริ่ม</span>
                            <span class="project-date-value">@(p.StartDate?.ToString("dd MMM yyyy", th) ?? "-")</span>
                        </div>
                        <div class="project-date-item">
                            <span class="project-date-label">วันที่สิ้นสุด</span>
                            <span class="project-date-value">@(p.EndDate?.ToString("dd MMM yyyy", th) ?? "-")</span>
                        </div>
                    </div>
                </div>

                <div class="project-actions">
                    <a asp-action="ProductionMemo"
                       asp-route-id="@p.ProjectId"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-outline-dark btn-sm">
                        📄 Memo
                    </a>

                    @if (CanMenu("Projects.Edit"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@p.ProjectId"
                           class="btn btn-outline-primary btn-sm">
                            ✏️ Edit
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            ✏️ Edit
                        </button>
                    }

                    @if (CanMenu("Projects.Delete"))
                    {
                        <form asp-action="Delete"
                              asp-route-id="@p.ProjectId"
                              method="post"
                              class="project-delete-form"
                              onsubmit="return confirm('ต้องการลบโครงการนี้หรือไม่?');">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm">
                                🗑 Delete
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🗑 Delete
                        </button>
                    }

                    <a asp-controller="ProjectPhases"
                       asp-action="Index"
                       asp-route-projectId="@p.ProjectId"
                       class="btn btn-outline-info btn-sm">
                        🧩 Phase
                    </a>

                    <a asp-controller="ProjectDocuments"
                       asp-action="Index"
                       asp-route-projectId="@p.ProjectId"
                       class="btn btn-outline-secondary btn-sm">
                        📂 Docs
                    </a>

                    <a asp-controller="ProjectStatus"
                       asp-action="Index"
                       asp-route-projectId="@p.ProjectId"
                       class="btn btn-outline-success btn-sm">
                        📊 Status
                    </a>

                    @if (CanMenu("ProjectIssues.Index"))
                    {
                        <a asp-controller="ProjectIssues"
                           asp-action="Index"
                           asp-route-projectId="@p.ProjectId"
                           class="btn btn-outline-danger btn-sm">
                            🐞 Issues
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🐞 Issues
                        </button>
                    }

                    @if (CanMenu("SupportOrders.Index"))
                    {
                        <a asp-controller="SupportOrders"
                           asp-action="Index"
                           asp-route-projectId="@p.ProjectId"
                           class="btn btn-outline-warning btn-sm">
                            🛠 Support
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🛠 Support
                        </button>
                    }

                    @if (CanMenu("TestScenarios.Index"))
                    {
                        <a asp-controller="TestScenarios"
                           asp-action="Index"
                           asp-route-projectId="@p.ProjectId"
                           class="btn btn-outline-primary btn-sm">
                            🧪 Test
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🧪 Test
                        </button>
                    }

                    @if (!string.IsNullOrEmpty(p.FigmaLink))
                    {
                        <a href="@p.FigmaLink"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-primary btn-sm">
                            🎨 Figma
                        </a>
                    }
                </div>
            </div>

            mobileRow++;
        }
    }
</div>


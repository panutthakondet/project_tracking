    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
}

.pt-owner-name {
    max-width: 100%;
    overflow-wrap: anywhere;
}

@@media (max-width: 768px) {

    .project-card-header {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 16px;

.thai-calendar-day {
    min-height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #10213a;
    background: #fff;
    font-size: .82rem;
    font-weight: 800;
}

.thai-calendar-day-head {
    min-height: 24px;
    color: #64748b;
    background: #f8fafc;
    font-size: .74rem;
    font-weight: 900;
}

.thai-calendar-day.is-empty {
    color: transparent;
    background: rgba(255, 255, 255, .52);
}

.thai-calendar-day.is-weekend {
    color: #be123c;
    background: #fff7f8;
}

.thai-calendar-day.is-today {
    color: #fff;
    background: linear-gradient(135deg, #21d4c2, #0f8f80);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .72);
}

.thai-calendar-note-actions {
    display: flex;
    justify-content: flex-end;
}

@@media (max-width: 575.98px) {
    .thai-calendar-grid {
        grid-template-columns: 1fr;
    }
}

.project-card:hover {
    transform: translateY(-2px);
    border-color: #3b82f6;
    box-shadow: 0 12px 24px rgba(15,23,42,.12);
}

</style>

@section Scripts{
<script>
document.addEventListener("DOMContentLoaded", function () {

const calendarButton = document.getElementById("ThaiCalendarNoteButton");
const calendarNote = document.getElementById("ThaiCalendarNoteModal");
const calendarHeader = document.getElementById("ThaiCalendarNoteHeader");
const calendarPositionKey = "ProjectTracking.Projects.ThaiCalendarNotePosition";

function calendarBounds() {
    const rect = calendarNote?.getBoundingClientRect();
    const margin = 8;
    return {
        margin,
        maxLeft: Math.max(margin, window.innerWidth - (rect?.width || 0) - margin),
        maxTop: Math.max(margin, window.innerHeight - (rect?.height || 0) - margin)
    };
}

function clampCalendarPosition(left, top) {
    if (!calendarNote) return;
    const bounds = calendarBounds();
    const nextLeft = Math.min(Math.max(left, bounds.margin), bounds.maxLeft);
    const nextTop = Math.min(Math.max(top, bounds.margin), bounds.maxTop);
    calendarNote.style.setProperty("--requirement-card-note-left", `${nextLeft}px`);
    calendarNote.style.setProperty("--requirement-card-note-top", `${nextTop}px`);
}

function applySavedCalendarPosition() {
    if (!calendarNote) return;
    if (window.matchMedia?.("(max-width: 575.98px)").matches) {
        calendarNote.style.removeProperty("--requirement-card-note-left");
        calendarNote.style.removeProperty("--requirement-card-note-top");
        return;
    }

    let saved = null;
    try {
        saved = JSON.parse(window.localStorage?.getItem(calendarPositionKey) || "null");
    } catch {
        saved = null;
    }

    if (!saved || !Number.isFinite(saved.left) || !Number.isFinite(saved.top)) return;
    clampCalendarPosition(saved.left, saved.top);
}

function openCalendarNote() {
    if (!calendarNote) return;
    if (calendarNote.parentElement !== document.body) {
        document.body.appendChild(calendarNote);
    }

    applySavedCalendarPosition();
    calendarNote.classList.add("is-open");
    calendarNote.setAttribute("aria-hidden", "false");
}

function closeCalendarNote() {
    if (!calendarNote) return;
    calendarNote.classList.remove("is-open");
    calendarNote.setAttribute("aria-hidden", "true");
}

calendarButton?.addEventListener("click", openCalendarNote);
document.querySelectorAll("[data-thai-calendar-close]").forEach(button => {
    button.addEventListener("click", closeCalendarNote);
});

if (calendarNote && calendarHeader) {
    let startX = 0;
    let startY = 0;
    let startLeft = 0;
    let startTop = 0;

    function stopCalendarDrag() {
        calendarNote.classList.remove("is-dragging");
        document.removeEventListener("pointermove", dragCalendarNote);
        document.removeEventListener("pointerup", stopCalendarDrag);
        document.removeEventListener("pointercancel", stopCalendarDrag);

        const rect = calendarNote.getBoundingClientRect();
        window.localStorage?.setItem(calendarPositionKey, JSON.stringify({
            left: Math.round(rect.left),
            top: Math.round(rect.top)
        }));
    }

    function dragCalendarNote(event) {
        clampCalendarPosition(
            startLeft + event.clientX - startX,
            startTop + event.clientY - startY
        );
    }

    calendarHeader.addEventListener("pointerdown", function (event) {
        if (window.matchMedia?.("(max-width: 575.98px)").matches) return;
        if (event.target.closest("button, a, input, textarea, select")) return;

        event.preventDefault();
        startX = event.clientX;
        startY = event.clientY;
        const rect = calendarNote.getBoundingClientRect();
        startLeft = rect.left;
        startTop = rect.top;
        calendarNote.classList.add("is-dragging");
        calendarHeader.setPointerCapture?.(event.pointerId);
        document.addEventListener("pointermove", dragCalendarNote);
        document.addEventListener("pointerup", stopCalendarDrag);
        document.addEventListener("pointercancel", stopCalendarDrag);
    });

    window.addEventListener("resize", function () {
        if (!calendarNote.classList.contains("is-open")) return;
        applySavedCalendarPosition();
    });
}

window.applyProjectFilter = function () {

    const selectedCoop = (
        document.getElementById("coopFilter")?.value || ""
    ).trim().toLowerCase();
    localStorage.setItem("projects.selectedCoop", selectedCoop);

    const selectedProject = (
        document.getElementById("projectFilter")?.value || ""
    ).trim().toLowerCase();
    localStorage.setItem("projects.selectedProject", selectedProject);

    const selectedBa = (
        document.getElementById("baFilter")?.value || ""
    ).trim().toLowerCase();

    localStorage.setItem("projects.selectedBa", selectedBa);

    const selectedDepartment = (
        document.getElementById("departmentFilter")?.value || ""
    ).trim().toLowerCase();
    localStorage.setItem("projects.selectedDepartment", selectedDepartment);

    const selectedPm = (
        document.getElementById("pmFilter")?.value || ""
    ).trim().toLowerCase();

    localStorage.setItem("projects.selectedPm", selectedPm);

    const selectedStatus = (
        document.getElementById("statusFilter")?.value || ""
    ).trim().toLowerCase();

    localStorage.setItem("projects.selectedStatus", selectedStatus);

    // mobile cards (หน้าที่ใช้งานจริง)
    let visibleCardNo = 1;
    document.querySelectorAll(".project-card").forEach(card => {

        const projectName = (
            card.dataset.project || ""
        ).trim().toLowerCase();

        const coopName = (
            card.dataset.coop || ""
        ).trim().toLowerCase();

        const baName = (
            card.dataset.ba || ""
        ).trim().toLowerCase();

        const department = (card.dataset.department || "unassigned").trim().toLowerCase();

        const pmName = (
            card.dataset.pm || ""
        ).trim().toLowerCase();

        const statusName = (
            card.dataset.status || ""
        ).trim().toLowerCase();

        const matchProject = !selectedProject ||
                             projectName === selectedProject;

        const matchCoop = !selectedCoop ||
                          coopName === selectedCoop;

        const matchBa = !selectedBa ||
                        baName.includes(selectedBa);

        const matchDepartment = !selectedDepartment || department === selectedDepartment;

        const matchPm = !selectedPm ||
                        pmName.includes(selectedPm);

        const matchStatus = !selectedStatus ||
                            statusName.includes(selectedStatus);

        const visible = matchCoop && matchProject && matchDepartment && matchBa && matchPm && matchStatus;

        card.style.display = visible ? "block" : "none";

        if (visible) {
            const numberEl = card.querySelector(".project-row-number");
            if (numberEl) numberEl.textContent = String(visibleCardNo++);
        }
    });

    // desktop table (กันไว้)
    let visibleRowNo = 1;
    document.querySelectorAll("#projectTable tbody tr").forEach(row => {

        const projectName = (
            row.dataset.project || ""
        ).trim().toLowerCase();

        const coopName = (
            row.dataset.coop || ""
        ).trim().toLowerCase();

        const baName = (
            row.dataset.ba || ""
        ).trim().toLowerCase();

        const department = (row.dataset.department || "unassigned").trim().toLowerCase();

        const pmName = (
            row.dataset.pm || ""
        ).trim().toLowerCase();

        const statusName = (
            row.dataset.status || ""
        ).trim().toLowerCase();

        const matchProject = !selectedProject ||
                             projectName === selectedProject;

        const matchCoop = !selectedCoop ||
                          coopName === selectedCoop;

        const matchBa = !selectedBa ||
                        baName.includes(selectedBa);

        const matchDepartment = !selectedDepartment || department === selectedDepartment;

        const matchPm = !selectedPm ||
                        pmName.includes(selectedPm);

        const matchStatus = !selectedStatus ||
                            statusName.includes(selectedStatus);

        const visible = matchCoop && matchProject && matchDepartment && matchBa && matchPm && matchStatus;

        row.style.display = visible ? "table-row" : "none";

        if (visible) {
            const numberCell = row.querySelector(".col-id");
            if (numberCell) numberCell.textContent = String(visibleRowNo++);
        }
    });
};

function restoreFilter(selectId, storageKey) {
    const savedValue = localStorage.getItem(storageKey) || "";
    const select = document.getElementById(selectId);
    if (!savedValue || !select) return;

    const match = Array.from(select.options)
        .find(opt => opt.value.trim().toLowerCase() === savedValue);

    if (match) {
        select.value = match.value;
    }
}

restoreFilter("coopFilter", "projects.selectedCoop");
restoreFilter("projectFilter", "projects.selectedProject");
restoreFilter("departmentFilter", "projects.selectedDepartment");
restoreFilter("baFilter", "projects.selectedBa");
restoreFilter("pmFilter", "projects.selectedPm");
restoreFilter("statusFilter", "projects.selectedStatus");

function syncProjectFilterOptions() {
    const coopFilter = document.getElementById("coopFilter");
    const departmentFilter = document.getElementById("departmentFilter");
    const projectSelect = document.getElementById("projectFilter");
    if (!projectSelect) return;

    const selectedCoop = (coopFilter?.value || "").trim().toLowerCase();
    const selectedDepartment = (departmentFilter?.value || "").trim().toLowerCase();
    Array.from(projectSelect.options).forEach(option => {
        const visible = option.value === "" ||
            ((!selectedCoop || (option.dataset.coopName || "").trim().toLowerCase() === selectedCoop) &&
             (!selectedDepartment || (option.dataset.department || "unassigned").trim().toLowerCase() === selectedDepartment));
        option.hidden = !visible;
        option.disabled = !visible;
    });

    const selected = projectSelect.selectedOptions[0];
    if (selected && selected.disabled) projectSelect.value = "";
}

document.getElementById("coopFilter")?.addEventListener("change", function () {
    const projectSelect = document.getElementById("projectFilter");
    if (projectSelect) projectSelect.value = "";
    syncProjectFilterOptions();
    window.applyProjectFilter();
});

document.getElementById("departmentFilter")?.addEventListener("change", function () {
    const projectSelect = document.getElementById("projectFilter");
    if (projectSelect) projectSelect.value = "";
    syncProjectFilterOptions();
    window.applyProjectFilter();
});

["projectFilter", "baFilter", "pmFilter", "statusFilter"].forEach(selectId => {
    document.getElementById(selectId)?.addEventListener("change", window.applyProjectFilter);
});

syncProjectFilterOptions();
setTimeout(() => {
    window.applyProjectFilter();
}, 50);
});
</script>
}

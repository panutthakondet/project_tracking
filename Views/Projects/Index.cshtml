    }
}

.project-card {
    transition: .2s ease;
    width: 100%;
    min-width: 0;
    overflow: hidden;

    background: #fff;
    border: 2px solid #94a3b8;
    border-radius: 20px;
    padding: 22px;
    margin-bottom: 8px;

    box-shadow: 0 4px 12px rgba(15,23,42,.06);
}

.project-card-header {
    margin-bottom: 8px;
}

.project-card-topline {
    display: flex;
    align-items: center;
    gap: 12px;

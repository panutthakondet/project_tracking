@using System.Globalization
@model IEnumerable<ProjectTracking.Models.Project>
@using Microsoft.AspNetCore.Http

@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

@{
    ViewData["Title"] = "Project List";
    var th = new CultureInfo("th-TH");
    var projects = (Model ?? Enumerable.Empty<ProjectTracking.Models.Project>()).ToList();
    string NormalizeProjectStatus(string? status) => (status ?? "")
        .Trim()
        .ToUpperInvariant()
        .Replace(" ", "_")
        .Replace("-", "_");
    int ProjectSortOrder(string? status) => NormalizeProjectStatus(status) switch
    {
        "IN_PROGRESS" => 1,
        "PLAN" => 2,
        "DONE" => 3,
        "CANCELLED" => 4,
        _ => 5
    };
    var orderedProjects = projects
        .OrderBy(x => ProjectSortOrder(x.Status))
        .ThenBy(x => x.EndDate ?? DateTime.MaxValue)
        .ThenBy(x => x.ProjectDisplayName)
        .ToList();
}

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">บันทึกข้อมูลโครงการ</h2>
        <p class="index-subtitle">รายการโครงการทั้งหมดในระบบ</p>
    </div>

    <div class="index-actions">
        <a asp-controller="ProjectStatus"
           asp-action="Index"
           class="btn btn-outline-info"
           title="ดูสถานะโครงการ">
            Project Status
        </a>

        @if (CanMenu("ProjectIssues.Index"))
        {
            <a asp-controller="ProjectIssues"
               asp-action="Index"
               class="btn btn-outline-danger"
               title="ดูปัญหาโครงการ">
                Project Issues
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดู Project Issues">
                Project Issues
            </button>
        }

        @if (CanMenu("SupportOrders.Index"))
        {
            <a asp-controller="SupportOrders"
               asp-action="Index"
               class="btn btn-outline-warning"
               title="ดูงาน Support Orders">
                Support Orders
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดู Support Orders">
                Support Orders
            </button>
        }

        @if (CanMenu("TestScenarios.Index"))
        {
            <a asp-controller="TestScenarios"
               asp-action="Index"
               class="btn btn-outline-primary"
               title="ดู Test Scenarios">
                Test Scenarios
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดู Test Scenarios">
                Test Scenarios
            </button>
        }

        @if (CanMenu("Projects.Create"))
        {
            <a asp-action="Create" class="btn btn-primary" title="เพิ่มโครงการ">
                Add Project
            </a>
        }
        else
        {
            <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์เพิ่มโครงการ">
                Add Project
            </button>
        }
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-3">
    <div class="card-body py-3">
        <div class="project-filter-form">

            <div class="project-filter-row">
                <label class="form-label fw-bold">🏢 สหกรณ์</label>
                <div class="search-dropdown-field">
                    <input type="text"
                           id="coopFilterSearch"
                           class="form-control form-control-lg"
                           placeholder="🔍 พิมพ์ค้นหาสหกรณ์..."
                           autocomplete="off" />
                    <button type="button"
                            id="clearCoopFilter"
                            class="search-dropdown-clear"
                            title="เลือกสหกรณ์ใหม่"
                            aria-label="เลือกสหกรณ์ใหม่">
                        ×
                    </button>
                </div>
                <div id="coopFilterDropdown"
                     class="list-group mt-1"
                     style="max-height:250px; overflow-y:auto; display:none; border:1px solid #ddd;">
                </div>
                <select id="coopFilter" style="display:none;">
                    <option value="">ทั้งหมด</option>
                    @foreach (var coopName in projects
                        .Select(x => x.Coop?.CoopName)
                        .Where(x => !string.IsNullOrWhiteSpace(x))
                        .Distinct()
                        .OrderBy(x => x))
                    {
                        <option value="@coopName">@coopName</option>
                    }
                </select>
            </div>

            <div class="project-filter-row">
                <label class="form-label fw-bold">📁 โครงการ</label>
                <div class="search-dropdown-field">
                    <input type="text"
                           id="projectFilterSearch"
                           class="form-control form-control-lg"
                           placeholder="🔍 พิมพ์ค้นหาโครงการ..."
                           autocomplete="off" />
                    <button type="button"
                            id="clearProjectFilter"
                            class="search-dropdown-clear"
                            title="เลือกโครงการใหม่"
                            aria-label="เลือกโครงการใหม่">
                        ×
                    </button>
                </div>
                <div id="projectFilterDropdown"
                     class="list-group mt-1"
                     style="max-height:250px; overflow-y:auto; display:none; border:1px solid #ddd;">
                </div>
                <select id="projectFilter" style="display:none;">
                    <option value="">ทั้งหมด</option>
                    @foreach (var p in projects.OrderBy(x => x.ProjectDisplayName))
                    {
                        <option value="@p.ProjectDisplayName"
                                data-coop-name="@(p.Coop?.CoopName ?? "")"
                                data-project-name="@p.ProjectName">
                            @p.ProjectName
                        </option>
                    }
                </select>
            </div>

            <div class="project-filter-pair">
                <div class="project-filter-row">
                    <label class="form-label fw-bold">👤 BA</label>
                    <div class="search-dropdown-field">
                        <input type="text"
                               id="baFilterSearch"
                               class="form-control form-control-lg"
                               placeholder="🔍 พิมพ์ค้นหา BA..."
                               autocomplete="off" />
                        <button type="button"
                                id="clearBaFilter"
                                class="search-dropdown-clear"
                                title="เลือก BA ใหม่"
                                aria-label="เลือก BA ใหม่">
                            ×
                        </button>
                    </div>
                    <div id="baFilterDropdown"
                         class="list-group mt-1"
                         style="max-height:250px; overflow-y:auto; display:none; border:1px solid #ddd;">
                    </div>
                    <select id="baFilter" style="display:none;">
                        <option value="">ทั้งหมด</option>
                        @foreach (var ba in projects
                            .Select(x => x.BA?.EmpName)
                            .Where(x => !string.IsNullOrWhiteSpace(x))
                            .Distinct()
                            .OrderBy(x => x))
                        {
                            <option value="@ba">@ba</option>
                        }
                    </select>
                </div>

                <div class="project-filter-row">
                    <label class="form-label fw-bold">📌 Status</label>
                    <div class="search-dropdown-field">
                        <input type="text"
                               id="statusFilterSearch"
                               class="form-control form-control-lg"
                               placeholder="🔍 พิมพ์ค้นหา Status..."
                               autocomplete="off" />
                        <button type="button"
                                id="clearStatusFilter"
                                class="search-dropdown-clear"
                                title="เลือก Status ใหม่"
                                aria-label="เลือก Status ใหม่">
                            ×
                        </button>
                    </div>
                    <div id="statusFilterDropdown"
                         class="list-group mt-1"
                         style="max-height:250px; overflow-y:auto; display:none; border:1px solid #ddd;">
                    </div>
                    <select id="statusFilter" style="display:none;">
                        <option value="">ทั้งหมด</option>
                        <option value="PLAN">PLAN</option>
                        <option value="IN_PROGRESS">IN_PROGRESS</option>
                        <option value="DONE">DONE</option>
                    </select>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="table-responsive project-table-wrapper" style="display:none;">
    <table id="projectTable" class="table table-bordered table-hover align-middle project-table">
        <thead class="table-dark text-center">
            <tr>
                <th class="sticky-col-1 col-id">#</th>
                <th class="sticky-col-2 col-name">Project Name</th>
                <th class="col-ba">Business Analyst</th>
                <th class="col-system">System</th>
                <th class="col-db">Database</th>
                <th class="col-test">Test Account</th>
                <th class="col-url">Remote / URL</th>
                <th class="col-date">Start</th>
                <th class="col-date">End</th>
                <th class="col-status">Status</th>
                <th class="col-mini">Figma</th>
                <th class="col-action">Action</th>
            </tr>
        </thead>

        <tbody>
        @if (!orderedProjects.Any())
        {
            <tr>
                <td colspan="12" class="text-center text-muted">— No project data —</td>
            </tr>
        }
        else
        {
            var rowNo = 1;
            foreach (var p in orderedProjects)
            {
                var projectDisplayName = p.ProjectDisplayName;
                var coopName = p.Coop?.CoopName ?? "";
                <tr data-ba-id="@(p.BA != null ? p.BA.EmpId.ToString() : "")"
                    data-project="@projectDisplayName.ToLower()"
                    data-project-name="@p.ProjectName.ToLower()"
                    data-coop="@coopName.ToLower()"
                    data-ba="@((p.BA?.EmpName ?? "").ToLower())"
                    data-status="@((p.Status ?? "").ToLower())">
                    <td class="sticky-col-1 col-id text-center">@rowNo</td>

                    <td class="sticky-col-2 col-name fw-semibold">
                        @projectDisplayName
                    </td>

                    <td class="col-ba text-center">
                        @(p.BA != null ? p.BA.EmpName : "-")
                    </td>

                    <td class="col-system">
                        @if (!string.IsNullOrEmpty(p.LinkName))
                        {
                            var parts = p.LinkName.Split(' ');

                            foreach (var part in parts)
                            {
                                if (part.StartsWith("https", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a href="@part" target="_blank" rel="noopener noreferrer">@part</a>
                                    <text> </text>
                                }
                                else
                                {
                                    <span>@part</span>
                                    <text> </text>
                                }
                            }
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td class="col-db">@p.DatabaseName</td>
                    <td class="col-test">@p.TestAccount</td>
                    <td class="col-url small">@p.RemoteUrl</td>

                    <td class="text-center col-date">
                        @(p.StartDate?.ToString("dd MMM yyyy", th) ?? "-")
                    </td>

                    <td class="text-center col-date">
                        @(p.EndDate?.ToString("dd MMM yyyy", th) ?? "-")
                    </td>

                    <td class="text-center col-status">
                        <span class="badge
                            @(p.Status == "DONE"
                                ? "bg-success"
                                : p.Status == "IN_PROGRESS"
                                    ? "bg-info"
                                    : "bg-warning text-dark")">
                            @p.Status
                        </span>
                    </td>

                    <td class="text-center col-mini">
                        @if (!string.IsNullOrEmpty(p.FigmaLink))
                        { <a href="@p.FigmaLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">🎨</a> }
                        else { <span class="text-muted">-</span> }
                    </td>


                    <td class="text-center col-action">
                        <div class="d-flex justify-content-center gap-1 flex-wrap">
                            @if (CanMenu("Projects.Edit"))
                            {
                                <a asp-action="Edit" asp-route-id="@p.ProjectId" class="btn btn-sm btn-outline-primary" title="แก้ไขโครงการ">✏️</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                    ✏️
                                </button>
                            }
                            <a asp-controller="ProjectPhases" asp-action="Index" asp-route-projectId="@p.ProjectId" class="btn btn-sm btn-outline-info">🧩</a>
                            <a asp-controller="ProjectDocuments" 
                               asp-action="Index" 
                               asp-route-projectId="@p.ProjectId" 
                               class="btn btn-sm btn-outline-secondary">📂</a>
                            <a asp-controller="ProjectStatus"
                               asp-action="Index"
                               asp-route-projectId="@p.ProjectId"
                               class="btn btn-sm btn-outline-success"
                               title="ดูสถานะโครงการ">📊</a>
                            @if (CanMenu("ProjectIssues.Index"))
                            {
                                <a asp-controller="ProjectIssues"
                                   asp-action="Index"
                                   asp-route-projectId="@p.ProjectId"
                                   class="btn btn-sm btn-outline-danger"
                                   title="ดูปัญหาโครงการ">🐞</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดู Project Issues">🐞</button>
                            }
                            @if (CanMenu("SupportOrders.Index"))
                            {
                                <a asp-controller="SupportOrders"
                                   asp-action="Index"
                                   asp-route-projectId="@p.ProjectId"
                                   class="btn btn-sm btn-outline-warning"
                                   title="ดู Support Orders">🛠</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดู Support Orders">🛠</button>
                            }
                            @if (CanMenu("TestScenarios.Index"))
                            {
                                <a asp-controller="TestScenarios"
                                   asp-action="Index"
                                   asp-route-projectId="@p.ProjectId"
                                   class="btn btn-sm btn-outline-primary"
                                   title="ดู Test Scenarios">🧪</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดู Test Scenarios">🧪</button>
                            }
                            @if (CanMenu("Projects.Delete"))
                            {
                                <form asp-action="Delete"
                                      asp-route-id="@p.ProjectId"
                                      method="post"
                                      class="project-delete-form"
                                      onsubmit="return confirm('ต้องการลบโครงการนี้หรือไม่?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="ลบโครงการ">🗑</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                    🗑
                                </button>
                            }
                        </div>
                    </td>
                </tr>
                rowNo++;
            }
        }
        </tbody>
    </table>
</div>

<!-- Mobile Card View -->
<div class="project-mobile-cards">
    @if (orderedProjects.Any())
    {
        var mobileRow = 1;

        foreach (var p in orderedProjects)
        {
            var projectDisplayName = p.ProjectDisplayName;
            var coopName = p.Coop?.CoopName ?? "";
            <div class="project-card"
                 data-project="@projectDisplayName.ToLower()"
                 data-project-name="@p.ProjectName.ToLower()"
                 data-coop="@coopName.ToLower()"
                 data-ba="@((p.BA?.EmpName ?? "").ToLower())"
                 data-status="@((p.Status ?? "").ToLower())"
                 data-search="@($"{projectDisplayName} {coopName} {p.ProjectName} {p.LinkName} {p.DatabaseName} {p.TestAccount} {p.RemoteUrl} {p.BA?.EmpName}".ToLower())">

                <div class="project-card-header">
                    <div class="project-avatar">📁</div>

                    <div class="project-header-content">
                        <div class="project-name">
                            @mobileRow. @projectDisplayName
                        </div>

                        <div class="project-status">
                            <span class="badge rounded-pill px-3 py-2
                                @(p.Status == "DONE"
                                    ? "bg-success"
                                    : p.Status == "IN_PROGRESS"
                                        ? "bg-info"
                                        : "bg-warning text-dark")">
                                @p.Status
                            </span>
                        </div>
                    </div>
                </div>

                <div class="project-info">
                    <div class="project-info-row">
                        <span class="project-label">BA</span>
                        <span>@(p.BA?.EmpName ?? "-")</span>
                    </div>

                    <div class="project-info-row project-system-row">
                        <span class="project-label">System</span>

                        <span class="project-system-value">
                            @if (!string.IsNullOrEmpty(p.LinkName))
                            {
                                var parts = p.LinkName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                foreach (var part in parts)
                                {
                                    if (part.StartsWith("https", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a href="@part"
                                           target="_blank"
                                           rel="noopener noreferrer">
                                            @part
                                        </a>
                                        <text> </text>
                                    }
                                    else
                                    {
                                        <span>@part </span>
                                    }
                                }
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </span>
                    </div>

                    <div class="project-info-row">
                        <span class="project-label">Database</span>
                        <span>@(p.DatabaseName ?? "-")</span>
                    </div>

                    <div class="project-info-row">
                        <span class="project-label">Test</span>
                        <span class="text-break text-end">
                            @(string.IsNullOrWhiteSpace(p.TestAccount)
                                ? "-"
                                : p.TestAccount)
                        </span>
                    </div>

                    <div class="project-info-row">
                        <span class="project-label">Remote</span>
                        <span class="text-break text-end">
                            @(string.IsNullOrWhiteSpace(p.RemoteUrl)
                                ? "-"
                                : p.RemoteUrl)
                        </span>
                    </div>

                    <div class="project-info-row project-date-row">
                        <div class="project-date-item">
                            <span class="project-date-label">Start</span>
                            <span class="project-date-value">@(p.StartDate?.ToString("dd MMM yyyy", th) ?? "-")</span>
                        </div>
                        <div class="project-date-item">
                            <span class="project-date-label">End</span>
                            <span class="project-date-value">@(p.EndDate?.ToString("dd MMM yyyy", th) ?? "-")</span>
                        </div>
                    </div>
                </div>

                <div class="project-actions">
                    @if (CanMenu("Projects.Edit"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@p.ProjectId"
                           class="btn btn-outline-primary btn-sm">
                            ✏️ Edit
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            ✏️ Edit
                        </button>
                    }

                    @if (CanMenu("Projects.Delete"))
                    {
                        <form asp-action="Delete"
                              asp-route-id="@p.ProjectId"
                              method="post"
                              class="project-delete-form"
                              onsubmit="return confirm('ต้องการลบโครงการนี้หรือไม่?');">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm">
                                🗑 Delete
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🗑 Delete
                        </button>
                    }

                    <a asp-controller="ProjectPhases"
                       asp-action="Index"
                       asp-route-projectId="@p.ProjectId"
                       class="btn btn-outline-info btn-sm">
                        🧩 Phase
                    </a>

                    <a asp-controller="ProjectDocuments"
                       asp-action="Index"
                       asp-route-projectId="@p.ProjectId"
                       class="btn btn-outline-secondary btn-sm">
                        📂 Docs
                    </a>

                    <a asp-controller="ProjectStatus"
                       asp-action="Index"
                       asp-route-projectId="@p.ProjectId"
                       class="btn btn-outline-success btn-sm">
                        📊 Status
                    </a>

                    @if (CanMenu("ProjectIssues.Index"))
                    {
                        <a asp-controller="ProjectIssues"
                           asp-action="Index"
                           asp-route-projectId="@p.ProjectId"
                           class="btn btn-outline-danger btn-sm">
                            🐞 Issues
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🐞 Issues
                        </button>
                    }

                    @if (CanMenu("SupportOrders.Index"))
                    {
                        <a asp-controller="SupportOrders"
                           asp-action="Index"
                           asp-route-projectId="@p.ProjectId"
                           class="btn btn-outline-warning btn-sm">
                            🛠 Support
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🛠 Support
                        </button>
                    }

                    @if (CanMenu("TestScenarios.Index"))
                    {
                        <a asp-controller="TestScenarios"
                           asp-action="Index"
                           asp-route-projectId="@p.ProjectId"
                           class="btn btn-outline-primary btn-sm">
                            🧪 Test
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>
                            🧪 Test
                        </button>
                    }

                    @if (!string.IsNullOrEmpty(p.FigmaLink))
                    {
                        <a href="@p.FigmaLink"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-primary btn-sm">
                            🎨 Figma
                        </a>
                    }
                </div>
            </div>

            mobileRow++;
        }
    }
</div>

<style>
.project-filter-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
}

.project-filter-row {
    width: 100%;
    min-width: 0;
}

.project-delete-form {
    display: contents;
}

.project-filter-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 14px;
}

@@media (max-width: 767.98px) {
    .project-filter-pair {
        grid-template-columns: 1fr;
    }
}

.project-filter-form .form-control {
    min-height: 48px;
    border-radius: 14px;
    font-weight: 700;
}

.search-dropdown-field {
    position: relative;
}

.search-dropdown-field .form-control {
    padding-right: 48px;
}

.search-dropdown-clear {
    position: absolute;
    top: 50%;
    right: 12px;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 999px;
    display: none;
    align-items: center;
    justify-content: center;
    color: #334155;
    background: #e2e8f0;
    font-size: 1.15rem;
    font-weight: 900;
    line-height: 1;
    transition: .15s ease;
}

.search-dropdown-clear.is-visible {
    display: inline-flex;
}

.search-dropdown-clear:hover {
    color: #fff;
    background: #0f766e;
}

#coopFilterDropdown,
#projectFilterDropdown,
#baFilterDropdown,
#statusFilterDropdown {
    width: 100%;
    border-radius: 14px;

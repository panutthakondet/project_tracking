@using System.Globalization
@using System.Text.RegularExpressions
@model IEnumerable<ProjectTracking.Models.Project>
@using Microsoft.AspNetCore.Http
@using ProjectTracking.ViewModels

@section Styles {
<link rel="stylesheet" href="~/css/projects-index.css" asp-append-version="true" />
<script>
    document.documentElement.classList.add('projects-initializing');
    document.addEventListener('projecttracking:dropdowns-ready', () => document.documentElement.classList.remove('projects-initializing'), { once:true });
    // รอให้ HTML โหลดครบก่อนเสมอ เพื่อไม่เปิดการ์ดทั้งหมดกลางทางเมื่อเครือข่ายช้า
    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => document.documentElement.classList.remove('projects-initializing'), 0);
    }, { once:true });
</script>
}

@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

@{
    ViewData["Title"] = "Project List";
    var th = new CultureInfo("th-TH");
    var projects = (Model ?? Enumerable.Empty<ProjectTracking.Models.Project>()).ToList();
    var departments = ViewBag.ProjectDepartments as IEnumerable<ProjectTracking.Models.ProjectDepartment> ?? Enumerable.Empty<ProjectTracking.Models.ProjectDepartment>();
    var selectedDepartmentId = ViewBag.SelectedDepartmentId is int departmentId ? departmentId : (int?)null;
    var selectedCoopId = ViewBag.SelectedCoopId is int coopId ? coopId : (int?)null;
    var selectedProjectId = ViewBag.SelectedProjectId is int projectId ? projectId : (int?)null;
    var hasLinkedProjectFilter = selectedCoopId.HasValue || selectedProjectId.HasValue;
    var pendingProjectApprovalIds = ViewBag.PendingProjectApprovalIds as ISet<int> ?? new HashSet<int>();
    var relatedMembersByProject = ViewBag.ProjectRelatedMembers as IReadOnlyDictionary<int, List<ProjectOrgMember>>
        ?? new Dictionary<int, List<ProjectOrgMember>>();
    string ProfileImage(ProjectTracking.Models.Employee? employee)
        => ProjectTracking.Services.ProfileImagePathResolver.Normalize(employee?.LoginUser?.ProfileImagePath);
    IReadOnlyList<(string Label, string? Url)> ProjectSystemItems(string? linkName)
    {
        if (string.IsNullOrWhiteSpace(linkName))
        {
            return Array.Empty<(string Label, string? Url)>();
        }

        var raw = linkName.Trim();
        var matches = Regex.Matches(raw, @"https?://\S+", RegexOptions.IgnoreCase);
        if (matches.Count == 0)
        {
            return new[] { (raw, (string?)null) };
        }

        var items = new List<(string Label, string? Url)>();
        var lastIndex = 0;
        foreach (Match match in matches)
        {
            var label = raw[lastIndex..match.Index].Trim().TrimEnd(':', '：').Trim();
            if (string.IsNullOrWhiteSpace(label))
            {
                label = "Link";
            }

            items.Add((label, match.Value.Trim()));
            lastIndex = match.Index + match.Length;
        }

        var trailing = raw[lastIndex..].Trim();
        if (!string.IsNullOrWhiteSpace(trailing))
        {
            items.Add((trailing.TrimEnd(':', '：').Trim(), null));
        }

        return items;
    }
    var orderedProjects = projects
        .OrderBy(x => x.StatusDefinition?.SortOrder ?? int.MaxValue)
        .ThenBy(x => x.EndDate ?? DateTime.MaxValue)
        .ThenBy(x => x.ProjectDisplayName)
        .ToList();

    var calendarToday = DateTime.Today;
    var calendarYear = calendarToday.Year;
    var calendarThaiYear = calendarYear + 543;
    var thaiMonthNames = th.DateTimeFormat.MonthNames.Take(12).ToArray();
    var thaiDayHeaders = new[] { "อา", "จ", "อ", "พ", "พฤ", "ศ", "ส" };
}

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">บันทึกข้อมูลโครงการ</h2>
        <p class="index-subtitle">รายการโครงการทั้งหมดในระบบ</p>
    </div>

    <div class="index-actions">
        <button id="ThaiCalendarNoteButton"
                type="button"
                class="btn btn-outline-warning"
                title="เปิดปฏิทินไทยปี @calendarThaiYear">
            ปฏิทิน
        </button>

        @if (CanMenu("Projects.Create"))
        {
            <a asp-action="Create" class="btn btn-primary" title="เพิ่มโครงการ">
                เพิ่มโครงการ
            </a>
        }
        else
        {
            <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์เพิ่มโครงการ">
                เพิ่มโครงการ
            </button>
        }
    </div>
</div>

<aside class="requirement-card-popup requirement-card-note thai-calendar-note" id="ThaiCalendarNoteModal" aria-hidden="true">
    <div class="requirement-card-note__panel">
        <div class="requirement-card-popup__header" id="ThaiCalendarNoteHeader">
            <div class="requirement-card-popup__heading">
                <div class="requirement-card-popup__eyebrow">ProjectTracking</div>
                <h5 class="requirement-card-popup__title">ปฏิทินไทย @calendarThaiYear</h5>
                <div class="requirement-card-popup__meta">
                    วันนี้ @calendarToday.ToString("dd MMMM yyyy", th)
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-thai-calendar-close aria-label="ปิด"></button>
        </div>
        <div class="requirement-card-popup__body requirement-card-note__body">
            <section class="requirement-card-popup__section">
                <div class="requirement-card-popup__section-head">
                    <h6 class="requirement-card-popup__label mb-0">ปี @calendarThaiYear</h6>
                    <span class="requirement-card-popup__count">12 เดือน</span>
                </div>

                <div class="thai-calendar-grid">
                    @for (var month = 1; month <= 12; month++)
                    {
                        var firstDay = new DateTime(calendarYear, month, 1);
                        var leadingBlanks = (int)firstDay.DayOfWeek;
                        var daysInMonth = DateTime.DaysInMonth(calendarYear, month);

                        <article class="thai-calendar-month">
                            <div class="thai-calendar-month__title">@thaiMonthNames[month - 1]</div>
                            <div class="thai-calendar-days">
                                @foreach (var dayHeader in thaiDayHeaders)
                                {
                                    <div class="thai-calendar-day-head">@dayHeader</div>
                                }

                                @for (var blank = 0; blank < leadingBlanks; blank++)
                                {
                                    <div class="thai-calendar-day is-empty" aria-hidden="true">0</div>
                                }

                                @for (var day = 1; day <= daysInMonth; day++)
                                {
                                    var date = new DateTime(calendarYear, month, day);
                                    var isWeekend = date.DayOfWeek == DayOfWeek.Sunday || date.DayOfWeek == DayOfWeek.Saturday;
                                    var isToday = date.Date == calendarToday.Date;
                                    var dayClass = isToday
                                        ? "thai-calendar-day is-today"
                                        : isWeekend
                                            ? "thai-calendar-day is-weekend"
                                            : "thai-calendar-day";

                                    <div class="@dayClass">@day</div>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>

            <div class="thai-calendar-note-actions">
                <button type="button" class="btn btn-outline-secondary" data-thai-calendar-close>ปิด</button>
            </div>
        </div>
    </div>
</aside>

<div class="card shadow-sm border-0 rounded-4 mb-3">
    <div class="card-body py-3">
        <div class="project-filter-form" data-has-linked-project-filter="@(hasLinkedProjectFilter ? "true" : "false")">

            <div class="project-filter-row">
                <label class="form-label fw-bold">🏢 สหกรณ์</label>
                <select id="coopFilter" class="form-select form-select-lg" data-show-empty-option-text="true">
                    <option value="">ทั้งหมด</option>
                    @foreach (var coop in projects
                        .Where(x => x.CoopId.HasValue && x.Coop != null && !string.IsNullOrWhiteSpace(x.Coop.CoopName))
                        .GroupBy(x => new { CoopId = x.CoopId!.Value, x.Coop!.CoopName })
                        .Select(group => group.Key)
                        .OrderBy(x => x.CoopName))
                    {
                        <option value="@coop.CoopId" selected="@(selectedCoopId == coop.CoopId ? "selected" : null)">@coop.CoopName</option>
                    }
                </select>
            </div>

            <div class="project-filter-row">
                <label class="form-label fw-bold">📁 โครงการ</label>
                <select id="projectFilter" class="form-select form-select-lg">
                    <option value="">ทั้งหมด</option>
                    @foreach (var p in projects.OrderBy(x => x.ProjectDisplayName))
                    {
                        <option value="@p.ProjectId"
                                data-coop-id="@(p.CoopId?.ToString() ?? "unassigned")"
                                data-department="@(p.EffectiveDepartmentIds.Count > 0 ? string.Join(",", p.EffectiveDepartmentIds) : "unassigned")"
                                data-project-name="@p.ProjectName"
                                selected="@(selectedProjectId == p.ProjectId ? "selected" : null)">
                            @p.ProjectName
                        </option>
                    }
                </select>
            </div>

            <div class="project-filter-pair">
                <div class="project-filter-row">
                    <label class="form-label fw-bold">ฝ่าย</label>
                    <select id="departmentFilter" class="form-select form-select-lg">
                        <option value="">ทุกฝ่าย</option>
                        @foreach (var department in departments)
                        {
                            <option value="@department.DepartmentId" selected="@(selectedDepartmentId == department.DepartmentId ? "selected" : null)">@department.DepartmentName</option>
                        }
                        <option value="unassigned">ยังไม่กำหนดฝ่าย</option>
                    </select>
                </div>

                <div class="project-filter-row">
                    <label class="form-label fw-bold">PM</label>
                    <select id="pmFilter" class="form-select form-select-lg">
                        <option value="">ทั้งหมด</option>
                        @foreach (var pm in projects
                            .SelectMany(x => x.ProjectManagers)
                            .Select(x => x.EmpName)
                            .Where(x => !string.IsNullOrWhiteSpace(x))
                            .Distinct()
                            .OrderBy(x => x))
                        {
                            <option value="@pm">@pm</option>
                        }
                    </select>
                </div>

                <div class="project-filter-row">
                    <label class="form-label fw-bold">👤 BA</label>
                    <select id="baFilter" class="form-select form-select-lg">
                        <option value="">ทั้งหมด</option>
                        @foreach (var ba in projects
                            .SelectMany(x => x.BusinessAnalysts)
                            .Select(x => x.EmpName)
                            .Where(x => !string.IsNullOrWhiteSpace(x))
                            .Distinct()
                            .OrderBy(x => x))
                        {
                            <option value="@ba">@ba</option>
                        }
                    </select>
                </div>

                <div class="project-filter-row">
                    <label class="form-label fw-bold">🔄 สถานะ</label>
                    <select id="statusFilter" class="form-select form-select-lg">
                        <option value="">ทั้งหมด</option>
                        @foreach (var status in (ViewBag.ProjectStatuses as IEnumerable<ProjectTracking.Models.StatusDefinitionOption>
                            ?? Enumerable.Empty<ProjectTracking.Models.StatusDefinitionOption>()))
                        {
                            <option value="@status.StatusCode">@status.StatusDesc</option>
                        }
                    </select>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Mobile Card View -->
<div class="project-mobile-cards">
    @if (orderedProjects.Any())
    {
        var mobileRow = 1;

        foreach (var p in orderedProjects)
        {
            var projectDisplayName = p.ProjectDisplayName;
            var coopName = p.Coop?.CoopName ?? "";
            var departmentValue = p.EffectiveDepartmentIds.Count > 0 ? string.Join(",", p.EffectiveDepartmentIds) : "unassigned";
            var hasPendingApproval = pendingProjectApprovalIds.Contains(p.ProjectId);
            var projectManagers = p.ProjectManagers;
            var businessAnalysts = p.BusinessAnalysts;
            var relatedMembers = relatedMembersByProject.TryGetValue(p.ProjectId, out var projectRelatedMembers)
                ? projectRelatedMembers
                : new List<ProjectOrgMember>();
            var relatedMemberSearch = string.Join(" ", relatedMembers.Select(member => $"{member.Name} {member.Role}"));
            var projectStatusCode = p.StatusDefinition?.StatusCode ?? ProjectTracking.Services.WorkflowStatusPresentation.Code(p.Status);
            var cardSystemItems = ProjectSystemItems(p.LinkName);
            var projectPanelId = $"projectCardSummary-{p.ProjectId}";
            var phasesPanelId = $"projectCardPhases-{p.ProjectId}";
            var assignmentsPanelId = $"projectCardAssignments-{p.ProjectId}";
            var inlineDetailsUrl = Url.Action("InlineDetails", "Projects", new { id = p.ProjectId }) ?? "";
            var canViewProjectPhases = CanMenu("ProjectPhases.Index");
            var canViewPhaseAssigns = CanMenu("PhaseAssigns.Index");
            var canViewPhaseWorkload = CanMenu("PhaseWorkload.Index");
            var hasProjectOverviewActions = canViewProjectPhases || canViewPhaseWorkload;
            <div class="project-card"
                style="@((selectedProjectId.HasValue && p.ProjectId != selectedProjectId.Value) || (!selectedProjectId.HasValue && selectedCoopId.HasValue && p.CoopId != selectedCoopId.Value) ? "display:none" : null)"
                 data-project-id="@p.ProjectId"
                 data-coop-id="@(p.CoopId?.ToString() ?? "unassigned")"
                 data-project="@projectDisplayName.ToLower()"
                 data-project-name="@p.ProjectName.ToLower()"
                 data-coop="@coopName.ToLower()"
                 data-department="@departmentValue"
                 data-ba="@(p.BusinessAnalystNames.ToLower())"
                 data-pm="@(p.ProjectManagerNames.ToLower())"
                 data-status="@(projectStatusCode.ToLowerInvariant())"
                data-search="@($"{projectDisplayName} {coopName} {p.DepartmentNames} {p.ProjectName} {p.ProjectDetail} {p.LinkName} {p.DatabaseName} {p.TestAccount} {p.RemoteUrl} {p.BusinessAnalystNames} {p.ProjectManagerNames} {relatedMemberSearch}".ToLower())">

                <div class="project-team-header">
                    <span class="project-row-number" aria-label="ลำดับที่ @mobileRow">@mobileRow</span>
                    <div class="project-team-members">
                        <div class="project-team-leads">
                            <span class="project-top-people">
                                @foreach (var member in projectManagers)
                                {
                                    <span class="project-person is-profile">
                                        <img class="pt-owner-avatar" src="@ProfileImage(member)" alt="@member.EmpName" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                        <span class="project-person-text"><strong>PM:</strong> @member.EmpName</span>
                                    </span>
                                }
                            </span>
                        </div>

                        @if (businessAnalysts.Count > 0 || relatedMembers.Count > 0)
                        {
                            <div class="project-related-people">
                                <span class="project-related-list">
                                    @foreach (var member in businessAnalysts)
                                    {
                                        var memberRole = string.IsNullOrWhiteSpace(member.DisplayPosition)
                                            ? "Business Analyst"
                                            : member.DisplayPosition.Trim();
                                        <span class="project-related-member" title="@($"{member.EmpName} · {memberRole}")">
                                            <img class="pt-owner-avatar" src="@ProfileImage(member)" alt="@member.EmpName" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                            <span class="project-related-member-text">
                                                <span class="project-related-member-name">@member.EmpName</span>
                                                <span class="project-related-member-role">@memberRole</span>
                                            </span>
                                        </span>
                                    }
                                    @foreach (var member in relatedMembers)
                                    {
                                        <span class="project-related-member" title="@($"{member.Name} · {member.Role}")">
                                            <img class="pt-owner-avatar" src="@member.AvatarPath" alt="@member.Name" loading="lazy" onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                            <span class="project-related-member-text">
                                                <span class="project-related-member-name">@member.Name</span>
                                                <span class="project-related-member-role">@member.Role</span>
                                            </span>
                                        </span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <div class="project-card-tabs" role="tablist" aria-label="ข้อมูลของ @projectDisplayName">
                    <button type="button"
                            class="project-card-tab is-active"
                            role="tab"
                            aria-selected="true"
                            aria-controls="@projectPanelId"
                            data-project-card-tab="@projectPanelId">
                        <span class="project-local-icon project-local-icon--project" aria-hidden="true"></span>
                        <span>ข้อมูลโครงการ</span>
                    </button>
                    @if (canViewProjectPhases)
                    {
                        <button type="button"
                                class="project-card-tab"
                                role="tab"
                                aria-selected="false"
                                aria-controls="@phasesPanelId"
                                tabindex="-1"
                                data-project-card-tab="@phasesPanelId">
                            <span class="project-local-icon project-local-icon--phase" aria-hidden="true"></span>
                            <span>งวดงาน</span>
                            <span class="project-card-tab-count" data-project-tab-count="phases" aria-hidden="true"></span>
                        </button>
                    }
                    @if (canViewPhaseAssigns)
                    {
                        <button type="button"
                                class="project-card-tab"
                                role="tab"
                                aria-selected="false"
                                aria-controls="@assignmentsPanelId"
                                tabindex="-1"
                                data-project-card-tab="@assignmentsPanelId">
                            <span class="project-local-icon project-local-icon--account" aria-hidden="true"></span>
                            <span>งานที่มอบหมาย</span>
                            <span class="project-card-tab-count" data-project-tab-count="assignments" aria-hidden="true"></span>
                        </button>
                    }
                </div>

                <section class="project-card-tab-panel is-active"
                         id="@projectPanelId"
                         role="tabpanel">
                <div class="project-overview-grid @(!hasProjectOverviewActions ? "project-overview-grid--summary" : "")">
                    <section class="project-summary-panel" aria-label="ข้อมูลโครงการ">
                        <div class="project-summary-row">
                            <span class="project-summary-icon project-local-icon project-local-icon--building" aria-hidden="true"></span>
                            <span class="project-summary-label">สหกรณ์:</span>
                            <span class="project-summary-value">@(string.IsNullOrWhiteSpace(coopName) ? "-" : coopName)</span>
                        </div>
                        <div class="project-summary-row">
                            <span class="project-summary-icon project-local-icon project-local-icon--project" aria-hidden="true"></span>
                            <span class="project-summary-label">โครงการ:</span>
                            <span class="project-summary-value">@(string.IsNullOrWhiteSpace(p.ProjectName) ? "-" : p.ProjectName)</span>
                        </div>
                        <div class="project-summary-row">
                            <span class="project-summary-icon project-local-icon project-local-icon--department" aria-hidden="true"></span>
                            <span class="project-summary-label">ฝ่าย:</span>
                            <span class="project-summary-value">@p.DepartmentNames</span>
                        </div>
                        <div class="project-summary-row">
                            <span class="project-summary-icon project-local-icon project-local-icon--status" aria-hidden="true"></span>
                            <span class="project-summary-label">สถานะ:</span>
                            <span class="project-summary-value project-status">
                                <span class="project-summary-status @(projectStatusCode == "DONE" ? "is-done" : projectStatusCode == "IN_PROGRESS" ? "is-progress" : "is-other")">
                                    @p.StatusDescription
                                </span>
                                @if (hasPendingApproval)
                                {
                                    <span class="project-approval-pending-badge">รออนุมัติ</span>
                                }
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(p.ProjectDetail) && p.ProjectDetail.Trim() != "-")
                        {
                            <div class="project-summary-row project-summary-detail">
                                <span class="project-summary-icon project-local-icon project-local-icon--detail" aria-hidden="true"></span>
                                <span class="project-summary-label">รายละเอียด:</span>
                                <span class="project-summary-value">@p.ProjectDetail.Trim()</span>
                            </div>
                        }
                    </section>

                    @if (hasProjectOverviewActions)
                    {
                        <div class="project-phase-actions @(!(canViewProjectPhases && canViewPhaseWorkload) ? "is-single" : "")">
                            @if (canViewPhaseWorkload)
                            {
                                <div class="project-phase-action">
                                    <a asp-controller="PhaseWorkload"
                                       asp-action="Index"
                                       asp-route-coopId="@p.CoopId"
                                       asp-route-projectId="@p.ProjectId"
                                       asp-route-periodStart="@p.StartDate?.ToString("yyyy-MM", CultureInfo.InvariantCulture)"
                                       asp-route-periodEnd="@p.EndDate?.ToString("yyyy-MM", CultureInfo.InvariantCulture)"
                                       asp-route-syncProjectPeriod="true"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="project-phase-tile project-phase-tile--workload"
                                       title="ดูแผนงานทีมของโครงการ">
                                        <span class="project-phase-tile__body">
                                            <span class="project-phase-tile__icon project-local-icon project-local-icon--account" aria-hidden="true"></span>
                                            <span class="project-phase-tile__title">แผนงานทีม</span>
                                            <span class="project-phase-tile__arrow" aria-hidden="true">›</span>
                                        </span>
                                        <span class="project-phase-tile__footer">
                                            <span class="project-phase-tile__footer-icon project-local-icon project-local-icon--calendar" aria-hidden="true"></span>
                                            <span>ดูแผนงานรายสัปดาห์</span>
                                        </span>
                                    </a>
                                </div>
                            }

                            @if (canViewProjectPhases)
                            {
                                <div class="project-phase-action">
                                    <a asp-controller="ProjectPhases"
                                       asp-action="Index"
                                       asp-route-projectId="@p.ProjectId"
                                       class="project-phase-tile"
                                       title="เพิ่มหรือจัดการงวดงานของโครงการ">
                                        <span class="project-phase-tile__body">
                                            <span class="project-phase-tile__icon project-local-icon project-local-icon--phase" aria-hidden="true"></span>
                                            <span class="project-phase-tile__title">เพิ่มงวดงาน</span>
                                            <span class="project-phase-tile__arrow" aria-hidden="true">›</span>
                                        </span>
                                        <span class="project-phase-tile__footer">
                                            <span class="project-phase-tile__footer-icon project-local-icon project-local-icon--list" aria-hidden="true"></span>
                                            <span>ไปหน้าจัดการงวดงาน</span>
                                        </span>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>

                <section class="project-tech-panel" aria-label="ข้อมูลระบบและระยะเวลาโครงการ">
                    <div class="project-tech-column">
                        <div class="project-tech-row project-tech-system-row">
                            <span class="project-tech-icon project-local-icon project-local-icon--system" aria-hidden="true"></span>
                            <span class="project-tech-label">ระบบ:</span>
                            <span class="project-tech-value project-system-value">
                                @if (cardSystemItems.Count > 0)
                                {
                                    foreach (var item in cardSystemItems)
                                    {
                                        <span class="project-system-chip @(!string.IsNullOrWhiteSpace(item.Url) ? "" : "is-text-only")">
                                            @if (!string.IsNullOrWhiteSpace(item.Url))
                                            {
                                                <span class="project-system-key">@item.Label</span>
                                                <a href="@item.Url" target="_blank" rel="noopener noreferrer">@item.Url</a>
                                            }
                                            else
                                            {
                                                <span class="project-system-text">@item.Label</span>
                                            }
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </span>
                        </div>
                        <div class="project-tech-row">
                            <span class="project-tech-icon project-local-icon project-local-icon--database" aria-hidden="true"></span>
                            <span class="project-tech-label">ฐานข้อมูล:</span>

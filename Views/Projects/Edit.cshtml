@model ProjectTracking.Models.Project

@{
    ViewData["Title"] = "Edit Project";

    DateTime? startDate = Model?.StartDate;
    DateTime? endDate = Model?.EndDate;

    var sd = startDate.GetValueOrDefault();
    var ed = endDate.GetValueOrDefault();

    string startDateText = startDate.HasValue
        ? $"{sd:dd/MM/}{sd.Year + 543}"
        : "";

    string endDateText = endDate.HasValue
        ? $"{ed:dd/MM/}{ed.Year + 543}"
        : "";

    var requirementCardDetailUrlTemplate = Url.Action("CardDetails", "RequirementBoard", new { id = "__CARD_ID__" }) ?? "";
}

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">Edit Project</h2>
        <p class="index-subtitle">แก้ไขข้อมูลโครงการ</p>
    </div>
</div>

<div class="card shadow-sm pt-form-card">
    <div class="card-body">

        <form asp-action="Edit"
              asp-route-id="@(Model?.ProjectId ?? 0)"
              method="post"
              enctype="multipart/form-data"
              onsubmit="return confirm('คุณต้องการบันทึกการแก้ไข Project นี้หรือไม่?');">

            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProjectId" />

            <div class="row g-3">

                <!-- ================= BASIC INFO ================= -->

                <!-- Project Name -->
                <div class="col-md-8">
                    <label class="form-label fw-semibold">
                        📁 Project Name
                    </label>
                    <input asp-for="ProjectName"
                           class="form-control"
                           placeholder="Enter project name" />
                    <span asp-validation-for="ProjectName"
                          class="text-danger"></span>
                </div>

                <!-- Status -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        🔄 Status
                    </label>
                    <select asp-for="Status"
                            class="form-select">
                        <option value="PLAN">PLAN</option>
                        <option value="IN_PROGRESS">IN PROGRESS</option>
                        <option value="DONE">DONE</option>
                    </select>
                </div>

                <!-- Project Board Card -->
                <div class="col-12">
                    <label class="form-label fw-semibold">
                        🧾 Project Board Card
                    </label>
                    <div class="project-board-card-picker">
                        <select asp-for="RequirementCardId"
                                asp-items="ViewBag.RequirementCards"
                                class="form-select"
                                data-placeholder="🔍 ค้นหาการ์ดจาก Project Board">
                            <option value="">-- ไม่ได้เลือกการ์ดต้นทาง --</option>
                        </select>
                        <button id="RequirementCardDetailButton"
                                type="button"
                                class="btn btn-outline-primary project-board-card-detail @(Model?.RequirementCardId.HasValue == true ? "" : "is-hidden")"
                                data-detail-url-template="@requirementCardDetailUrlTemplate">
                            🔎 ดูรายละเอียด
                        </button>
                    </div>
                    <div class="form-text">
                        เลือกหรือเปลี่ยนการ์ดต้นทางจาก Project Board
                    </div>
                </div>

                <!-- Business Analyst -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        👤 Business Analyst
                    </label>
                    <select asp-for="BaEmpId" class="form-select">
                        <option value="">-- Select Business Analyst --</option>
                        @foreach (var emp in ViewBag.Employees)
                        {
                            <option value="@emp.EmpId">@emp.EmpName</option>
                        }
                    </select>
                </div>

                <!-- Start Date -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        📅 Start Date
                    </label>
                    <input name="StartDate"
                           type="text"
                           class="form-control thai-date"
                           id="StartDate"
                           value="@startDateText"
                           placeholder="วว/ดด/ปปปป" />
                </div>

                <!-- End Date -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        📅 End Date
                    </label>
                    <input name="EndDate"
                           type="text"
                           class="form-control thai-date"
                           id="EndDate"
                           value="@endDateText"
                           placeholder="วว/ดด/ปปปป" />
                </div>

                <!-- ================= SYSTEM / DATABASE INFO ================= -->

                <!-- Link Name -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        🔗 ลิงค์ที่กำลังพัฒนา
                    </label>
                    <input asp-for="LinkName"
                           class="form-control"
                           placeholder="เช่น URL Website หรือ ชื่อ App" />
                </div>

                <!-- Database Name -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        🗄 ฐานข้อมูลที่ใช้
                    </label>
                    <input asp-for="DatabaseName"
                           class="form-control"
                           placeholder="เช่น implement_db" />
                </div>

                <!-- Test Account -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        🧪 ทะเบียนที่ใช้ทดสอบ
                    </label>
                    <input asp-for="TestAccount"
                           class="form-control"
                           placeholder="เช่น หน่วยงาน/ชื่อ/ทะเบียน/รหัสผ่าน" />
                </div>

                <!-- ✅ Remote (ไม่บังคับ URL) -->
                <div class="col-md-8">
                    <label class="form-label fw-semibold">
                        🌐 Remote / URL / AnyDesk / IP
                    </label>
                    <input asp-for="RemoteUrl"
                           type="text"
                           class="form-control"
                           placeholder="เช่น https://xxx | 10.10.1.20 | AnyDesk: 123 456 789" />
                    <div class="form-text">
                        ใส่เป็น URL, IP, AnyDesk, RDP หรือข้อความได้
                    </div>
                </div>

                <!-- ================= DESIGN & DOCUMENT ================= -->

                <!-- Figma Link -->
                <div class="col-md-8">
                    <label class="form-label fw-semibold">
                        🎨 Figma Link
                    </label>
                    <input asp-for="FigmaLink"
                           type="url"
                           class="form-control"
                           placeholder="https://www.figma.com/..." />
                </div>

            </div>

            <div class="pt-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    💾 Save Changes
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    ↩ Back
                </a>
            </div>

        </form>

    </div>
</div>

<partial name="_RequirementCardDetailModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function convertThaiDateToIso(value) {
            if (!value || !value.trim()) return '';

            const parts = value.trim().split('/');
            if (parts.length !== 3) return value;

            let [d, m, y] = parts;

            d = d.padStart(2, '0');
            m = m.padStart(2, '0');
            y = parseInt(y, 10);

            if (y > 2400) {
                y -= 543;
            }

            return `${y}-${m}-${d}`;
        }

        function formatThaiDateInput(input) {
            if (!input) return;

            input.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');

                if (value.length > 8) {
                    value = value.substring(0, 8);
                }

                if (value.length >= 5) {
                    value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
                } else if (value.length >= 3) {
                    value = `${value.substring(0, 2)}/${value.substring(2)}`;
                }

                e.target.value = value;
            });
        }

        formatThaiDateInput(document.getElementById('StartDate'));
        formatThaiDateInput(document.getElementById('EndDate'));

        document.querySelector('form').addEventListener('submit', function () {
            document.querySelectorAll('.thai-date').forEach(input => {
                input.value = convertThaiDateToIso(input.value);
            });
        });
    </script>
}

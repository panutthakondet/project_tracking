@model ProjectTracking.Models.Project

@{
    ViewData["Title"] = "เพิ่มข้อมูลโครงการ";

    DateTime? startDate = Model?.StartDate;
    DateTime? endDate = Model?.EndDate;

    var sd = startDate.GetValueOrDefault();
    var ed = endDate.GetValueOrDefault();

    string startDateText = startDate.HasValue
        ? $"{sd:dd/MM/}{sd.Year + 543}"
        : "";

    string endDateText = endDate.HasValue
        ? $"{ed:dd/MM/}{ed.Year + 543}"
        : "";

    var requirementCardDetailUrlTemplate = Url.Action("CardDetails", "RequirementBoard", new { id = "__CARD_ID__" }) ?? "";
    var coops = ViewBag.Coops as IEnumerable<ProjectTracking.Models.CntMCoop> ?? Enumerable.Empty<ProjectTracking.Models.CntMCoop>();
    var departments = ViewBag.ProjectDepartments as IEnumerable<ProjectTracking.Models.ProjectDepartment> ?? Enumerable.Empty<ProjectTracking.Models.ProjectDepartment>();
    var selectedBaEmpIds = ViewBag.SelectedBaEmpIds as HashSet<int> ?? new HashSet<int>();
    var selectedPmEmpIds = ViewBag.SelectedPmEmpIds as HashSet<int> ?? new HashSet<int>();
}

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">เพิ่มข้อมูลโครงการ</h2>
        <p class="index-subtitle">เพิ่มโครงการใหม่เข้าสู่ระบบ</p>
    </div>
</div>

<div class="card shadow-sm pt-form-card">
    <div class="card-body">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data"
              onsubmit="return confirm('คุณต้องการบันทึก Project นี้หรือไม่?');">

            @Html.AntiForgeryToken()

            <div class="row g-3">

                <!-- ================= BASIC INFO ================= -->

                <!-- Cooperative -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        สหกรณ์
                    </label>
                    <select asp-for="CoopId" class="form-select">
                        <option value="">-- Select Cooperative --</option>
                        @foreach (var coop in coops)
                        {
                            <option value="@coop.CoopId">@coop.CoopName</option>
                        }
                    </select>
                    <span asp-validation-for="CoopId" class="text-danger"></span>
                </div>

                <!-- Department -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">ฝ่าย <span class="text-danger">*</span></label>
                    <select asp-for="DepartmentId" class="form-select">
                        <option value="">-- เลือกฝ่าย --</option>
                        @foreach (var department in departments)
                        {
                            <option value="@department.DepartmentId">@department.DepartmentName</option>
                        }
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>

                <!-- Project Name -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        ชื่อโครงการ
                    </label>
                    <input asp-for="ProjectName"
                           class="form-control"
                           placeholder="Enter project name" />
                    <span asp-validation-for="ProjectName"
                          class="text-danger"></span>
                </div>

                <!-- Project Detail -->
                <div class="col-12">
                    <label class="form-label fw-semibold">
                        รายละเอียดเพิ่มเติม
                    </label>
                    <textarea asp-for="ProjectDetail"
                              class="form-control"
                              rows="4"
                              placeholder="ระบุรายละเอียดเพิ่มเติมของโครงการ"></textarea>
                    <span asp-validation-for="ProjectDetail" class="text-danger"></span>
                </div>

                <!-- Status -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        สถานะ
                    </label>
                    <select asp-for="Status"
                            class="form-select">
                        <option value="PLAN">PLAN</option>
                        <option value="IN_PROGRESS">IN PROGRESS</option>
                        <option value="DONE">DONE</option>
                    </select>
                </div>

                <!-- Project Board Card -->
                <div class="col-12">
                    <label class="form-label fw-semibold">
                        การ์ด Project Board
                    </label>
                    <div class="project-board-card-picker">
                        <select asp-for="RequirementCardId"
                                asp-items="ViewBag.RequirementCards"
                                class="form-select"
                                data-placeholder="🔍 ค้นหาการ์ดจาก Project Board">
                            <option value="">-- ไม่ได้เลือกการ์ดต้นทาง --</option>
                        </select>
                        <button id="RequirementCardDetailButton"
                                type="button"
                                class="btn btn-outline-primary project-board-card-detail is-hidden"
                                data-detail-url-template="@requirementCardDetailUrlTemplate">
                            🔎 ดูรายละเอียด
                        </button>
                    </div>
                    <div class="form-text">
                        เลือกการ์ดต้นทางจาก Project Board ถ้าโครงการนี้ถูกสร้างต่อจากการ์ด
                    </div>
                </div>

                <!-- Business Analysts -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        BA (เลือกได้มากกว่า 1 คน)
                    </label>
                    <select name="baEmpIds" class="form-select project-team-multi" multiple size="5">
                        @foreach (var emp in ViewBag.Employees)
                        {
                            <option value="@emp.EmpId" selected="@(selectedBaEmpIds.Contains(emp.EmpId) ? "selected" : null)">@emp.EmpName</option>
                        }
                    </select>
                    <div class="form-text">เลือกได้หลายคนด้วย Ctrl หรือ Command + คลิก</div>
                </div>

                <!-- Project Managers -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        PM (เลือกได้มากกว่า 1 คน)
                    </label>
                    <select name="pmEmpIds" class="form-select project-team-multi" multiple size="5">
                        @foreach (var emp in ViewBag.ProjectManagers)
                        {
                            <option value="@emp.EmpId" selected="@(selectedPmEmpIds.Contains(emp.EmpId) ? "selected" : null)">@emp.EmpName</option>
                        }
                    </select>
                    <div class="form-text">เลือกได้หลายคนด้วย Ctrl หรือ Command + คลิก</div>
                </div>

                <!-- Start Date -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        วันที่เริ่ม
                    </label>
                    <input asp-for="StartDate"
                           type="text"
                           class="form-control thai-date"
                           value="@startDateText"
                           placeholder="วัน/เดือน/พ.ศ." />
                </div>

                <!-- End Date -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        วันที่สิ้นสุด
                    </label>
                    <input asp-for="EndDate"
                           type="text"
                           class="form-control thai-date"
                           value="@endDateText"
                           placeholder="วัน/เดือน/พ.ศ." />
                </div>

                <!-- ================= SYSTEM / DATABASE INFO ================= -->

                <!-- Link Name -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        ลิงค์ที่กำลังพัฒนา
                    </label>
                    <input asp-for="LinkName"
                           class="form-control"
                           placeholder="เช่น URL Website หรือ ชื่อ App" />
                </div>

                <!-- Database Name -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        ฐานข้อมูลที่ใช้
                    </label>
                    <input asp-for="DatabaseName"
                           class="form-control"
                           placeholder="เช่น implement_db" />
                </div>

                <!-- Test Account -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        ทะเบียนที่ใช้ทดสอบ
                    </label>
                    <input asp-for="TestAccount"
                           class="form-control"
                           placeholder="เช่น หน่วยงาน/ชื่อ/ทะเบียน/รหัสผ่าน" />
                </div>

                <!-- ✅ Remote (ไม่บังคับ URL) -->
                <div class="col-md-8">
                    <label class="form-label fw-semibold">
                        รีโมท / URL / AnyDesk / IP
                    </label>
                    <input asp-for="RemoteUrl"
                           type="text"
                           class="form-control"
                           placeholder="เช่น https://xxx | 10.10.1.20 | AnyDesk: 123 456 789" />
                    <div class="form-text">
                        ใส่เป็น URL, IP, AnyDesk, RDP หรือข้อความได้
                    </div>
                </div>

                <!-- ================= DESIGN & DOCUMENT ================= -->

                <!-- Figma Link -->
                <div class="col-md-8">
                    <label class="form-label fw-semibold">
                        ลิงค์ Figma
                    </label>
                    <input asp-for="FigmaLink"
                           type="url"
                           class="form-control"
                           placeholder="https://www.figma.com/..." />
                </div>


            </div>

            <div class="pt-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    💾 Save Project
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    ↩ Back
                </a>
            </div>

        </form>
    </div>
</div>

<partial name="_RequirementCardDetailModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function convertThaiDateToIso(value) {
            if (!value || !value.trim()) return '';

            const parts = value.trim().split('/');
            if (parts.length !== 3) return value;

            let [d, m, y] = parts;

            d = d.padStart(2, '0');
            m = m.padStart(2, '0');
            y = parseInt(y, 10);

            if (y > 2400) {
                y -= 543;
            }

            return `${y}-${m}-${d}`;
        }

        function formatThaiDateInput(input) {
            if (!input) return;

            input.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');

                if (value.length > 8) {
                    value = value.substring(0, 8);
                }

                if (value.length >= 5) {
                    value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
                } else if (value.length >= 3) {
                    value = `${value.substring(0, 2)}/${value.substring(2)}`;
                }

                e.target.value = value;
            });
        }

        formatThaiDateInput(document.getElementById('StartDate'));
        formatThaiDateInput(document.getElementById('EndDate'));

        document.querySelector('form').addEventListener('submit', function () {
            document.querySelectorAll('.thai-date').forEach(input => {
                input.value = convertThaiDateToIso(input.value);
            });
        }, true);
    </script>
}

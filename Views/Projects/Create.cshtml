@model ProjectTracking.Models.Project

@{
    ViewData["Title"] = "Create Project";

    DateTime? startDate = Model?.StartDate;
    DateTime? endDate = Model?.EndDate;

    var sd = startDate.GetValueOrDefault();
    var ed = endDate.GetValueOrDefault();

    string startDateText = startDate.HasValue
        ? $"{sd:dd/MM/}{sd.Year + 543}"
        : "";

    string endDateText = endDate.HasValue
        ? $"{ed:dd/MM/}{ed.Year + 543}"
        : "";
}

<!-- ================= HEADER ================= -->
<div class="mb-4">
    <h2 class="fw-bold">📁 Create Project</h2>
    <p class="text-muted mb-0">
        เพิ่มโครงการใหม่เข้าสู่ระบบ
    </p>
</div>

<!-- ================= FORM CARD ================= -->
<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data"
              onsubmit="return confirm('คุณต้องการบันทึก Project นี้หรือไม่?');">

            @Html.AntiForgeryToken()

            <div class="row g-3">

                <!-- ================= BASIC INFO ================= -->

                <!-- Project Name -->
                <div class="col-md-8">
                    <label class="form-label fw-semibold">
                        📌 Project Name
                    </label>
                    <input asp-for="ProjectName"
                           class="form-control"
                           placeholder="Enter project name" />
                    <span asp-validation-for="ProjectName"
                          class="text-danger"></span>
                </div>

                <!-- Status -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        📊 Status
                    </label>
                    <select asp-for="Status"
                            class="form-select">
                        <option value="PLAN">PLAN</option>
                        <option value="IN_PROGRESS">IN PROGRESS</option>
                        <option value="DONE">DONE</option>
                    </select>
                </div>

                <!-- Business Analyst -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        👤 Business Analyst
                    </label>
                    <select asp-for="BaEmpId" class="form-select">
                        <option value="">-- Select Business Analyst --</option>
                        @foreach (var emp in ViewBag.Employees)
                        {
                            <option value="@emp.EmpId">@emp.EmpName</option>
                        }
                    </select>
                </div>

                <!-- Start Date -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        ▶ Start Date
                    </label>
                    <input asp-for="StartDate"
                           type="text"
                           class="form-control thai-date"
                           value="@startDateText"
                           placeholder="วัน/เดือน/พ.ศ." />
                </div>

                <!-- End Date -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        ⏹ End Date
                    </label>
                    <input asp-for="EndDate"
                           type="text"
                           class="form-control thai-date"
                           value="@endDateText"
                           placeholder="วัน/เดือน/พ.ศ." />
                </div>

                <!-- ================= SYSTEM / DATABASE INFO ================= -->

                <!-- Link Name -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        🔗 ลิงค์ที่กำลังพัฒนา
                    </label>
                    <input asp-for="LinkName"
                           class="form-control"
                           placeholder="เช่น URL Website หรือ ชื่อ App" />
                </div>

                <!-- Database Name -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        🗄 ฐานข้อมูลที่ใช้
                    </label>
                    <input asp-for="DatabaseName"
                           class="form-control"
                           placeholder="เช่น implement_db" />
                </div>

                <!-- Test Account -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        🧪 ทะเบียนที่ใช้ทดสอบ
                    </label>
                    <input asp-for="TestAccount"
                           class="form-control"
                           placeholder="เช่น หน่วยงาน/ชื่อ/ทะเบียน/รหัสผ่าน" />
                </div>

                <!-- ✅ Remote (ไม่บังคับ URL) -->
                <div class="col-md-8">
                    <label class="form-label fw-semibold">
                        🌐 Remote / URL / AnyDesk / IP
                    </label>
                    <input asp-for="RemoteUrl"
                           type="text"
                           class="form-control"
                           placeholder="เช่น https://xxx | 10.10.1.20 | AnyDesk: 123 456 789" />
                    <div class="form-text">
                        ใส่เป็น URL, IP, AnyDesk, RDP หรือข้อความได้
                    </div>
                </div>

                <!-- ================= DESIGN & DOCUMENT ================= -->

                <!-- Figma Link -->
                <div class="col-md-8">
                    <label class="form-label fw-semibold">
                        🎨 Figma Link
                    </label>
                    <input asp-for="FigmaLink"
                           type="url"
                           class="form-control"
                           placeholder="https://www.figma.com/..." />
                </div>


            </div>

            <!-- ================= BUTTONS ================= -->
            <div class="mt-4 d-flex gap-2">
                <button type="submit"
                        class="btn btn-primary">
                    💾 Save Project
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    ↩ Back
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function convertThaiDateToIso(value) {
            if (!value || !value.trim()) return '';

            const parts = value.trim().split('/');
            if (parts.length !== 3) return value;

            let [d, m, y] = parts;

            d = d.padStart(2, '0');
            m = m.padStart(2, '0');
            y = parseInt(y, 10);

            if (y > 2400) {
                y -= 543;
            }

            return `${y}-${m}-${d}`;
        }

        function formatThaiDateInput(input) {
            if (!input) return;

            input.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');

                if (value.length > 8) {
                    value = value.substring(0, 8);
                }

                if (value.length >= 5) {
                    value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
                } else if (value.length >= 3) {
                    value = `${value.substring(0, 2)}/${value.substring(2)}`;
                }

                e.target.value = value;
            });
        }

        formatThaiDateInput(document.getElementById('StartDate'));
        formatThaiDateInput(document.getElementById('EndDate'));

        document.querySelector('form').addEventListener('submit', function () {
            document.querySelectorAll('.thai-date').forEach(input => {
                input.value = convertThaiDateToIso(input.value);
            });
        });
    </script>
}
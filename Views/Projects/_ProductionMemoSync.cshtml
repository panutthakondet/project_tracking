@using System.Globalization
@using System.Text.Json
@using ProjectTracking.Services
@model ProjectTracking.Models.ProjectSyncRun
@functions {
    private static string NumberText(decimal? value, bool isSum) =>
        value?.ToString(isSum ? "#,0.00##########################" : "#,0.############################", CultureInfo.InvariantCulture) ?? "—";
}
@{
    var result = JsonSerializer.Deserialize<SyncResult>(Model.ResultJson!);
    var metrics = result?.Metrics.Where(metric => !metric.Metric.StartsWith("NON_NULL:", StringComparison.OrdinalIgnoreCase)).ToArray() ?? [];
    var summary = SyncComparison.SummarizeTables(metrics);
}
<section class="transfer-attachment">
    @if (ViewData["HideSyncTitle"] is not true)
    {
        <h2 class="title">ผลการเทียบข้อมูลระหว่าง MariaDB กับ Oracle</h2>
    }
    @if (Model.ComparedAtUtc is DateTime comparedAtUtc)
    {
        <p class="memo-sync-date">ข้อมูล ณ วันที่ @comparedAtUtc.AddHours(7).ToString("d MMM yyyy HH:mm", CultureInfo.GetCultureInfo("th-TH")) น.</p>
    }
    <p class="memo-sync-summary">ทั้งหมด @summary.Total ตาราง · ตรงกัน @summary.Matching ตาราง · ไม่ตรงกัน @summary.Different ตาราง</p>
    <table class="memo-sync-table">
        <thead>
            <tr>
                <th scope="col">ตาราง</th><th scope="col">ตัวชี้วัด</th>
                <th scope="col" class="numeric">MariaDB</th><th scope="col" class="numeric">Oracle</th>
                <th scope="col" class="numeric" title="MariaDB − Oracle">ผลต่าง</th>
                <th scope="col" class="memo-sync-status">สถานะ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var table in metrics.GroupBy(metric => metric.Table))
            {
                var tableMetrics = table.OrderBy(metric => metric.Metric == "ROW_COUNT" ? 0 : 1).ToArray();
                for (var index = 0; index < tableMetrics.Length; index++)
                {
                    var metric = tableMetrics[index];
                    var isSum = metric.Metric.StartsWith("SUM:", StringComparison.OrdinalIgnoreCase);
                    <tr>
                        @if (index == 0)
                        {
                            <td rowspan="@tableMetrics.Length" class="memo-sync-table-name">@table.Key</td>
                        }
                        <td>@(metric.Metric == "ROW_COUNT" ? "จำนวนแถว" : metric.Metric)</td>
                        <td class="numeric">@NumberText(metric.Maria, isSum)</td>
                        <td class="numeric">@NumberText(metric.Oracle, isSum)</td>
                        <td class="numeric">@NumberText(metric.Maria - metric.Oracle, isSum)</td>
                        <td class="memo-sync-status">@metric.Status</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</section>

@model IEnumerable<ProjectTracking.Models.Project>
@using System.Globalization

@{
    Layout = null;
    var th = new CultureInfo("th-TH");
    var rows = (Model ?? Enumerable.Empty<ProjectTracking.Models.Project>()).ToList();
    var projectList = ViewBag.Projects as IEnumerable<ProjectTracking.Models.Project> ?? Enumerable.Empty<ProjectTracking.Models.Project>();
    var baList = ViewBag.BaList as IEnumerable<ProjectTracking.Models.Employee> ?? Enumerable.Empty<ProjectTracking.Models.Employee>();
    var statusList = ViewBag.StatusList as IEnumerable<string> ?? Enumerable.Empty<string>();
    var departments = ViewBag.ProjectDepartments as IEnumerable<ProjectTracking.Models.ProjectDepartment> ?? Enumerable.Empty<ProjectTracking.Models.ProjectDepartment>();
    var selectedProjectId = ViewBag.SelectedProjectId is int projectId ? projectId : (int?)null;
    var selectedBaEmpId = ViewBag.SelectedBaEmpId is int baEmpId ? baEmpId : (int?)null;
    var selectedStatus = ViewBag.SelectedStatus as string ?? "";
    var selectedDepartmentId = ViewBag.SelectedDepartmentId is int departmentId ? departmentId : (int?)null;
    var coopList = projectList
        .Select(x => x.Coop?.CoopName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string DateText(DateTime? value) => value?.ToString("dd MMM yyyy", th) ?? "-";
    string SelectedProjectName() => selectedProjectId.HasValue
        ? projectList.FirstOrDefault(x => x.ProjectId == selectedProjectId.Value)?.ProjectDisplayName ?? "-"
        : "All Projects";
    string SelectedBaName() => selectedBaEmpId.HasValue
        ? baList.FirstOrDefault(x => x.EmpId == selectedBaEmpId.Value)?.EmpName ?? "-"
        : "All BA";
    string SelectedDepartmentName() => selectedDepartmentId.HasValue
        ? departments.FirstOrDefault(x => x.DepartmentId == selectedDepartmentId.Value)?.DepartmentName ?? "-"
        : "ทุกฝ่าย";
    string StatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "DONE" => "success",
        "IN_PROGRESS" => "info",
        "PLAN" => "warning",
        _ => "muted"
    };
    IEnumerable<string> SplitParts(string? value) => (value ?? "")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim())
        .Where(x => !string.IsNullOrWhiteSpace(x));

    var total = rows.Count;
    var planCount = rows.Count(x => string.Equals(x.Status, "PLAN", StringComparison.OrdinalIgnoreCase));
    var progressCount = rows.Count(x => string.Equals(x.Status, "IN_PROGRESS", StringComparison.OrdinalIgnoreCase));
    var doneCount = rows.Count(x => string.Equals(x.Status, "DONE", StringComparison.OrdinalIgnoreCase));
    var figmaCount = rows.Count(x => !string.IsNullOrWhiteSpace(x.FigmaLink));
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>Projects Report</title>
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&display=swap");
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 16px;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 11px;
        }
        .report-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }
        .report-btn {
            min-height: 34px;
            padding: 7px 13px;
            border: 1px solid #102443;
            border-radius: 999px;
            color: #102443;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 900;
            line-height: 1.1;
            text-decoration: none;
            cursor: pointer;
        }
        .report-btn.primary {
            color: #fff;
            background: #102443;
        }
        .print-header {
            margin-bottom: 12px;
            padding: 14px 16px;
            color: #fff;
            background: #102443;
        }
        .print-header h1 {
            margin: 0 0 6px;
            font-size: 22px;
        }
        .print-header div {
            color: rgba(255,255,255,.82);
            font-weight: 700;
            line-height: 1.55;
        }
        .filter-panel {
            display: grid;
            grid-template-columns: repeat(5, minmax(150px, 1fr)) auto;
            align-items: end;
            gap: 10px;
            margin-bottom: 12px;
            padding: 12px;
            border: 1px solid #d8e3ef;
            background: #f8fbff;
        }
        .field label {
            display: block;
            margin-bottom: 5px;
            color: #64748b;
            font-weight: 900;
        }
        .field select {
            width: 100%;
            min-height: 34px;
            padding: 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
        }
        .pt-native-select-hidden {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            min-height: 1px !important;
            opacity: 0 !important;
            pointer-events: none !important;
            clip-path: inset(50%) !important;
        }
        .pt-search-select { position: relative; width: 100%; }
        .pt-search-select__field { position: relative; }
        .pt-search-select__input {
            width: 100%;
            min-height: 34px;
            padding: 7px 38px 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            outline: none;
        }
        .pt-search-select__input:focus {
            border-color: #14b8a6;
            box-shadow: 0 0 0 3px rgba(20, 184, 166, .12);
        }        .pt-search-select__dropdown {
            position: absolute;
            left: 0;
            right: 0;
            top: calc(100% + 4px);
            z-index: 20;
            width: 100%;
            max-height: 240px;
            overflow-y: auto;
            display: none;
            border: 1px solid #d8e2ef;
            background: #fff;
            box-shadow: 0 12px 26px rgba(15, 35, 64, .14);
        }
        .pt-search-select.is-open .pt-search-select__dropdown { display: block; }
        .pt-search-select__option {
            width: 100%;
            padding: 8px 10px;
            border: 0;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.35;
            text-align: left;
            cursor: pointer;
        }
        .pt-search-select__option:hover,
        .pt-search-select__option.is-selected {
            color: #062b2f;
            background: rgba(20, 184, 166, .14);
        }
        .pt-search-select__empty {
            padding: 10px;
            color: #64748b;
            font-weight: 800;
            text-align: center;
        }
        .filter-submit {
            min-width: 88px;
            justify-self: start;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin-bottom: 12px;
        }
        .kpi {
            padding: 10px;
            border: 1px solid #d8e3ef;
            border-left: 4px solid #14b8a6;
        }
        .kpi.info { border-left-color: #258cfb; }
        .kpi.warning { border-left-color: #f59e0b; }
        .kpi.success { border-left-color: #22c55e; }
        .kpi span,
        .kpi small {
            display: block;
            color: #64748b;
            font-weight: 800;
        }
        .kpi strong {
            display: block;
            margin: 5px 0;
            color: #10233f;
            font-size: 20px;
            font-weight: 900;
        }
        h2 {
            margin: 14px 0 8px;
            color: #10233f;
            font-size: 16px;
            font-weight: 900;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin-bottom: 12px;
        }
        .projects-report-table col.col-seq { width: 5%; }
        .projects-report-table col.col-system { width: 30%; }
        .projects-report-table col.col-ba { width: 15%; }
        .projects-report-table col.col-env { width: 21%; }
        .projects-report-table col.col-url { width: 17%; }
        .projects-report-table col.col-period { width: 12%; }
        th {
            padding: 7px 6px;
            color: #fff;
            background: #102443;
            border: 1px solid rgba(255,255,255,.18);
            font-weight: 900;
            text-align: center;
        }
        td {
            padding: 7px 6px;
            border: 1px solid #d8e3ef;
            line-height: 1.45;
            vertical-align: top;
            overflow-wrap: break-word;
            word-break: normal;
        }
        tr:nth-child(even) td { background: #f8fbff; }
        .project-group-row td {
            padding: 8px 10px;
            color: #10233f;
            background: transparent !important;
            border-color: #d8e3ef;
            border-top: 2px solid #102443;
            font-size: 12px;
            font-weight: 900;
        }
        .project-group-name {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }
        .project-group-label {
            color: #0f766e;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: .05em;
            text-transform: uppercase;
        }
        .project-group-count {
            flex: 0 0 auto;
            color: #64748b;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }
        .text-center { text-align: center; }
        .cell-title {
            color: #10233f;
            font-weight: 900;
        }
        .cell-sub {
            margin-top: 4px;
            color: #465a73;
            font-weight: 700;
        }
        .label {
            color: #64748b;
            font-weight: 900;
        }
        .link-list {
            display: grid;
            gap: 2px;
        }
        .link-list a {
            color: #0f6fa8;
            font-weight: 800;
            text-decoration: underline;
        }
        .status-text {
            font-weight: 900;
            white-space: nowrap;
        }
        .status-text.success { color: #0f8f5f; }
        .status-text.warning { color: #b7790b; }
        .status-text.info { color: #0f6fa8; }
        .status-text.muted { color: #64748b; }
        .empty {
            padding: 18px;
            border: 1px dashed #cbd5e1;
            color: #64748b;
            text-align: center;
            font-weight: 800;
        }
        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
        @@media print {
            body {
                padding: 0;
                font-size: 10px;
            }
            .report-actions,
            .filter-panel { display: none !important; }
            .print-header { padding: 10px 12px; }
            .print-header h1 { font-size: 18px; }
            .kpi-grid { gap: 6px; }
            .kpi { padding: 7px; }
            .kpi strong { font-size: 16px; }
            th,
            td { padding: 5px 5px; }
            h2, h3,
            .project-group-row,
            .scenario-project__header,
            .scenario-group__header,
            .phase-project-group {
                break-after: avoid;
                page-break-after: avoid;
            }
            h2 + table,
            h2 + .empty,
            h2 + .report-table-scroll,
            h3 + table,
            h3 + .empty,
            .project-group-row + tr {
                break-before: avoid;
                page-break-before: avoid;
            }
            .report-section,
            .scenario-project,
            .scenario-group,
            .project-group-row,
            .phase-project-group {
                break-inside: avoid-page;
                page-break-inside: avoid;
            }
            thead { display: table-header-group; }
            tr { page-break-inside: avoid; }
        }
        @@media (max-width: 1100px) {
            .filter-panel,
            .kpi-grid {
                grid-template-columns: 1fr;
            }
        }
    
        /* Crisp typography normalization for standalone pages. */
        :root { --pt-readable-thai-font: "Noto Sans Thai", "Leelawadee UI", Tahoma, "Segoe UI", Arial, sans-serif; }
        html, body {
            font-family: var(--pt-readable-thai-font) !important;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }
        body :where(*):not(svg):not(svg *) {
            font-family: var(--pt-readable-thai-font) !important;
            font-stretch: normal !important;
            letter-spacing: 0 !important;
            text-shadow: none !important;
        }
        body :is(h1, h2, h3, h4, h5, h6, th, label, strong, b, .report-btn, .btn, .badge, .status-text, .cell-title, .project-group-name, [class*="title"], [class*="heading"], [class*="eyebrow"], [class*="status"], [class*="badge"], [class*="count"], [class*="total"], [class*="value"]) {
            font-weight: 700 !important;
        }
        body :is(p, li, td, small, em, time, .cell-sub, .detail-block div, .meta-label, .meta-value, .empty, [class*="detail"], [class*="meta"], [class*="subtitle"], [class*="description"], [class*="desc"], [class*="remark"], [class*="note"], [class*="empty"]):not(.btn):not(.badge):not(.status-text):not([class*="status-"]):not([class*="Status"]) {
            font-weight: 400 !important;
        }
</style>
@await Html.PartialAsync("_StandaloneTheme")
</head>
<body class="pt-standalone-report">
    <div class="report-actions">
        <button type="button" class="report-btn primary" onclick="window.print()">Print</button>
        <a asp-controller="Reports" asp-action="Index" class="report-btn">Report Center</a>
        <a asp-controller="Home" asp-action="Index" class="report-btn">Dashboard</a>
    </div>

    <header class="print-header">
        <h1>Projects Report</h1>
        <div>
            Project: @SelectedProjectName()<br />
            ฝ่าย: @SelectedDepartmentName()<br />
            BA: @SelectedBaName()<br />
            Status: @(string.IsNullOrWhiteSpace(selectedStatus) ? "All Statuses" : selectedStatus)<br />
            ข้อมูล ณ @DateTime.Now.ToString("dd MMM yyyy HH:mm", th)
        </div>
    </header>

    <form method="get" class="filter-panel">
        <div class="field">
            <label for="coopFilter">Cooperative</label>
            <select id="coopFilter" data-placeholder="🔍 พิมพ์ค้นหาสหกรณ์...">
                <option value="">-- All Cooperatives --</option>
                @foreach (var coop in coopList)
                {
                    <option value="@coop">@coop</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="departmentId">ฝ่าย</label>
            <select id="departmentId" name="departmentId" data-placeholder="เลือกฝ่าย..." onchange="this.form.submit()">
                <option value="">-- ทุกฝ่าย --</option>
                @foreach (var department in departments)
                {
                    <option value="@department.DepartmentId" selected="@(selectedDepartmentId == department.DepartmentId ? "selected" : null)">
                        @department.DepartmentName
                    </option>
                }
            </select>
        </div>
        <div class="field">
            <label for="projectId">Project</label>
            <select id="projectId" name="projectId" data-placeholder="🔍 พิมพ์ค้นหา Project..." onchange="this.form.submit()">
                <option value="">-- All Projects --</option>
                @foreach (var project in projectList)
                {
                    <option value="@project.ProjectId"
                            data-coop-name="@(project.Coop?.CoopName ?? "")"
                            data-department-id="@project.DepartmentId"
                            selected="@(selectedProjectId == project.ProjectId ? "selected" : null)">
                        @project.ProjectDisplayName
                    </option>
                }
            </select>
        </div>
        <div class="field">
            <label for="baEmpId">BA</label>
            <select id="baEmpId" name="baEmpId" data-placeholder="🔍 พิมพ์ค้นหา BA..." onchange="this.form.submit()">
                <option value="">-- All BA --</option>
                @foreach (var ba in baList)
                {
                    <option value="@ba.EmpId" selected="@(selectedBaEmpId == ba.EmpId ? "selected" : null)">
                        @ba.EmpName
                    </option>
                }
            </select>
        </div>
        <div class="field">
            <label for="status">Status</label>
            <select id="status" name="status" data-placeholder="🔍 พิมพ์ค้นหา Status..." onchange="this.form.submit()">
                <option value="">-- All Statuses --</option>
                @foreach (var item in statusList)
                {
                    <option value="@item" selected="@(selectedStatus == item ? "selected" : null)">@item</option>
                }
            </select>
        </div>
        <button type="submit" class="report-btn primary filter-submit">ค้นหา</button>
    </form>

    <section class="kpi-grid">
        <article class="kpi info">
            <span>Total Projects</span>
            <strong>@total</strong>
            <small>โครงการทั้งหมด</small>
        </article>
        <article class="kpi warning">
            <span>Plan</span>
            <strong>@planCount</strong>
            <small>วางแผน</small>
        </article>
        <article class="kpi info">
            <span>In Progress</span>
            <strong>@progressCount</strong>
            <small>กำลังดำเนินการ</small>
        </article>
        <article class="kpi success">
            <span>Done</span>
            <strong>@doneCount</strong>
            <small>เสร็จสิ้น</small>
        </article>
        <article class="kpi">
            <span>Figma</span>
            <strong>@figmaCount</strong>
            <small>มีลิงก์ออกแบบ</small>
        </article>
    </section>

    <h2>Project List By Project</h2>
    @if (!rows.Any())
    {
        <div class="empty">ไม่พบข้อมูลโครงการตามเงื่อนไขที่เลือก</div>
    }
    else
    {
        <table class="projects-report-table">
            <colgroup>
                <col class="col-seq" />
                <col class="col-system" />
                <col class="col-ba" />
                <col class="col-env" />
                <col class="col-url" />
                <col class="col-period" />
            </colgroup>
            <thead>
                <tr>
                    <th>Seq</th>
                    <th>System</th>
                    <th>BA</th>
                    <th>Database / Test</th>
                    <th>Remote / Figma</th>
                    <th>Period / Status</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var projectGroups = rows
                        .GroupBy(project => new
                        {
                            project.ProjectId,
                            ProjectName = TextOrDash(project.ProjectDisplayName)
                        })
                        .OrderBy(group => group.Key.ProjectName)
                        .ToList();
                }
                @foreach (var projectGroup in projectGroups)
                {
                    var seq = 1;
                    <tr class="project-group-row">
                        <td colspan="6">
                            <div class="project-group-name">
                                <div>
                                    <span class="project-group-label">Project</span>
                                    @projectGroup.Key.ProjectName
                                    <span class="cell-sub">· ฝ่าย @(projectGroup.First().Department?.DepartmentName ?? "ยังไม่กำหนดฝ่าย")</span>
                                </div>
                                <span class="project-group-count">@projectGroup.Count() รายการ</span>
                            </div>
                        </td>
                    </tr>

                    @foreach (var project in projectGroup)
                    {
                        <tr>
                            <td class="text-center">@seq</td>
                            <td>
                                @if (SplitParts(project.LinkName).Any())
                                {
                                    <div class="link-list">
                                        @foreach (var part in SplitParts(project.LinkName))
                                        {
                                            if (part.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <a href="@part" target="_blank" rel="noopener noreferrer">@part</a>
                                            }
                                            else
                                            {
                                                <span>@part</span>
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>@TextOrDash(project.BA?.EmpName)</td>
                            <td>
                                <div><span class="label">Database:</span> @TextOrDash(project.DatabaseName)</div>
                                <div class="cell-sub"><span class="label">Test:</span> @TextOrDash(project.TestAccount)</div>
                            </td>
                            <td>
                                <div><span class="label">Remote:</span> @TextOrDash(project.RemoteUrl)</div>
                                <div class="cell-sub">
                                    <span class="label">Figma:</span>
                                    @if (!string.IsNullOrWhiteSpace(project.FigmaLink))
                                    {
                                        <a href="@project.FigmaLink" target="_blank" rel="noopener noreferrer">Open Figma</a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div><span class="label">Start:</span> @DateText(project.StartDate)</div>
                                <div><span class="label">End:</span> @DateText(project.EndDate)</div>
                                <div class="cell-sub">
                                    <span class="status-text @StatusClass(project.Status)">@TextOrDash(project.Status)</span>
                                </div>
                            </td>
                        </tr>
                        seq++;
                    }
                }
            </tbody>
        </table>
    }

    <script>
        (function () {
            function normalize(value) {
                return (value || "").toString().trim().toLowerCase();
            }

            function getSelectedOption(select) {
                return select.options[select.selectedIndex] || null;
            }

            function dispatchSelectChange(select) {
                select.dispatchEvent(new Event("input", { bubbles: true }));
                select.dispatchEvent(new Event("change", { bubbles: true }));
            }

            function enhanceSelect(select) {
                if (!select || select.classList.contains("pt-dropdown-enhanced")) return;

                const wrapper = document.createElement("div");
                wrapper.className = "pt-search-select";

                const field = document.createElement("div");
                field.className = "pt-search-select__field";

                const input = document.createElement("input");
                input.type = "text";
                input.className = "pt-search-select__input";
                input.autocomplete = "off";
                input.placeholder = select.dataset.placeholder || getSelectedOption(select)?.text || "🔍 พิมพ์ค้นหา...";
                const dropdown = document.createElement("div");
                dropdown.className = "pt-search-select__dropdown";

                field.appendChild(input);
                wrapper.appendChild(field);
                wrapper.appendChild(dropdown);
                select.parentNode.insertBefore(wrapper, select);
                wrapper.appendChild(select);
                select.classList.add("pt-native-select-hidden", "pt-dropdown-enhanced");

                const options = Array.from(select.options).map(option => ({
                    value: option.value,
                    text: option.text.trim(),
                    option
                }));

                function syncInput() {
                    const selected = getSelectedOption(select);
                    input.value = selected ? selected.text.trim() : "";                }

                function renderOptions() {
                    const term = normalize(input.value);
                    dropdown.innerHTML = "";

                    const matches = options.filter(item => !item.option.disabled && (!term || normalize(item.text).includes(term)));
                    if (!matches.length) {
                        const empty = document.createElement("div");
                        empty.className = "pt-search-select__empty";
                        empty.textContent = "ไม่พบข้อมูล";
                        dropdown.appendChild(empty);
                        return;
                    }

                    matches.forEach(item => {
                        const button = document.createElement("button");
                        button.type = "button";
                        button.className = "pt-search-select__option";
                        if (item.option.selected) button.classList.add("is-selected");
                        button.textContent = item.text || "--";
                        button.addEventListener("click", () => {
                            select.value = item.value;
                            syncInput();
                            wrapper.classList.remove("is-open");
                            dispatchSelectChange(select);
                        });
                        dropdown.appendChild(button);
                    });
                }

                input.addEventListener("focus", () => {
                    input.value = "";
                    renderOptions();
                    wrapper.classList.add("is-open");
                });

                input.addEventListener("input", () => {
                    renderOptions();
                    wrapper.classList.add("is-open");
                });
                document.addEventListener("click", event => {
                    if (!wrapper.contains(event.target)) wrapper.classList.remove("is-open");
                });

                syncInput();
                renderOptions();
            }

            document.querySelectorAll("select[data-placeholder]").forEach(enhanceSelect);

            const coopFilter = document.getElementById("coopFilter");
            const departmentFilter = document.getElementById("departmentId");
            const projectFilter = document.getElementById("projectId");

            function syncProjectFilterOptions() {
                if (!projectFilter) return;

                const selectedCoop = normalize(coopFilter?.value || "");
                const selectedDepartment = normalize(departmentFilter?.value || "");
                Array.from(projectFilter.options).forEach(option => {
                    const visible = option.value === "" ||
                        ((!selectedCoop || normalize(option.dataset.coopName || "") === selectedCoop) &&
                         (!selectedDepartment || normalize(option.dataset.departmentId || "") === selectedDepartment));
                    option.hidden = !visible;
                    option.disabled = !visible;
                });

                const selected = projectFilter.selectedOptions[0];
                if (selected && selected.disabled) projectFilter.value = "";
            }

            coopFilter?.addEventListener("change", function () {
                localStorage.setItem("reports.projects.selectedCoop", normalize(coopFilter.value));
                if (projectFilter) projectFilter.value = "";
                syncProjectFilterOptions();
            });

            departmentFilter?.addEventListener("change", function () {
                if (projectFilter) projectFilter.value = "";
                syncProjectFilterOptions();
            });

            const savedCoop = localStorage.getItem("reports.projects.selectedCoop") || "";
            if (savedCoop && coopFilter) {
                const match = Array.from(coopFilter.options).find(option => normalize(option.value) === savedCoop);
                if (match) coopFilter.value = match.value;
            }

            syncProjectFilterOptions();
        })();
    </script>
</body>
</html>

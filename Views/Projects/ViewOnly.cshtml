@using System.Globalization
@model IEnumerable<ProjectTracking.Models.Project>

@{
    ViewData["Title"] = "รายงานข้อมูลโครงการ";
    Layout = "_Layout"; // ✅ ใช้เมนูบาร์ด้านบนแบบเดียวกับระบบหลัก
    var th = new CultureInfo("th-TH");
}

@section Styles {
<style>
    /* ซ่อนบางส่วนเฉพาะตอนสั่งพิมพ์ */
    @@media print {
        header, .navbar, footer, .no-print { display: none !important; }
        body { background: #fff !important; }
        .container, .container-fluid { padding: 0 !important; margin: 0 !important; }
    }

    .report-toolbar{
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:12px;
        flex-wrap:wrap;
        margin-bottom:12px;
    }

    .project-table-wrapper{ overflow-x:auto; border:1px solid #ddd; border-radius:10px; display:none; }

    .col-id{ width:70px; min-width:70px; }
    .col-name{ width:320px; min-width:320px; }
    .col-system{ width:180px; min-width:180px; }
    .col-db{ width:180px; min-width:180px; }
    .col-url{ width:280px; min-width:280px; }
    .col-account{ width:220px; min-width:220px; }
    .col-date{ width:120px; min-width:120px; }
    .col-status{ width:120px; min-width:120px; }
    .col-mini{ width:90px; min-width:90px; }

    .sticky-col-1{
        position:sticky;
        left:0;
        background:#fff;
        z-index:3;
    }

    .sticky-col-2{
        position:sticky;
        left:70px;
        background:#fff;
        z-index:3;
    }

    thead .sticky-col-1,
    thead .sticky-col-2{
        background:#212529 !important;
        color:#fff;
        z-index:4;
    }

    #tbl th, #tbl td{ vertical-align:middle; word-break:break-word; }

    /* สีอ่อนแยกตาม Project */
    .project-row-even td {
        background:#f8fafc;
    }

    .project-row-odd td {
        background:#eaf4ff;
    }

    /* sticky column ให้สีตามแถวด้วย */
    .project-row-even .sticky-col-1,
    .project-row-even .sticky-col-2 {
        background:#f8fafc !important;
    }

    .project-row-odd .sticky-col-1,
    .project-row-odd .sticky-col-2 {
        background:#eaf4ff !important;
    }

    .project-row-even:hover td,
    .project-row-odd:hover td,
    .project-row-even:hover .sticky-col-1,
    .project-row-even:hover .sticky-col-2,
    .project-row-odd:hover .sticky-col-1,
    .project-row-odd:hover .sticky-col-2 {
        background:#eef6ff !important;
    }

    .project-report-cards {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .project-report-card {
        background: #fff;
        border: 2px solid #cbd5e1;
        border-radius: 26px;
        padding: 22px 24px;
        transition: .2s ease;
        box-shadow: 0 4px 14px rgba(15,23,42,.05);
    }

    .project-report-card:hover {
        border-color: #93c5fd;
        background: #f8fbff;
    }

    .project-report-header {
        display: block;
        border: 0;
        width: 100%;
        min-width: unset;
        padding: 0;
    }

    .project-report-avatar {
        display: none;
    }

    .project-report-grid {
        display: block;
        margin-top: 8px;
    }

    .project-report-box {
        background: transparent;
        border: 0;
        border-radius: 0;
        padding: 0;
        margin-bottom: 6px;
    }

    .project-label {
        display: inline;
        font-size: 1rem;
        font-weight: 500;
        color: #111827;
        margin-right: 4px;
    }

    .project-value {
        display: inline;
        font-weight: 500;
        color: #1f2937;
    }
</style>
}

<div class="container-fluid py-4">

    <div class="report-toolbar no-print">
        <div>
            <h2 class="fw-bold mb-0">📁 รายงานข้อมูลโครงการ</h2>
            <div class="text-muted">แสดงรายการโครงการ (สำหรับดู/พิมพ์)</div>
        </div>

        <div></div>
    </div>

    <div class="row mb-3 no-print">
        <div class="col-md-5">
            <label class="form-label fw-bold">🔍 ค้นหา Project</label>
            <input type="text" id="search" class="form-control" placeholder="ค้นหาโครงการ..." autocomplete="off" />
        </div>
    </div>

    <div class="table-responsive project-table-wrapper" style="display:none;">
        <table class="table table-bordered table-hover align-middle" id="tbl">
            <thead class="table-dark text-center">
                <tr>
                    <th class="sticky-col-1 col-id">#</th>
                    <th class="sticky-col-2 col-name">Project</th>
                    <th class="col-system">System</th>
                    <th class="col-db">Database</th>
                    <th class="col-url">Remote URL</th>
                    <th class="col-account">Test Account</th>
                    <th class="col-date">Start</th>
                    <th class="col-date">End</th>
                    <th class="col-status">Status</th>
                    <th class="col-mini">Figma</th>
                </tr>
            </thead>
            <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted">— No project data —</td>
                </tr>
            }
            else
            {
                var i = 1;
                foreach (var p in Model
                    .OrderBy(x => x.Status == "IN_PROGRESS" ? 0 : x.Status == "PLAN" ? 1 : 2)
                    .ThenBy(x => x.EndDate ?? DateTime.MaxValue))
                {
                    <tr class="@(i % 2 == 0 ? "project-row-even" : "project-row-odd")">
                        <td class="sticky-col-1 col-id text-center">@i</td>
                        <td class="sticky-col-2 col-name fw-semibold">@p.ProjectName</td>
                        <td class="col-system small">
                            @if (!string.IsNullOrWhiteSpace(p.LinkName))
                            {
                                var parts = p.LinkName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                foreach (var part in parts)
                                {
                                    if (part.StartsWith("https", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a href="@part" target="_blank" rel="noopener noreferrer">@part</a>
                                        <br />
                                    }
                                    else
                                    {
                                        <span>@part </span>
                                    }
                                }
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="col-db">@p.DatabaseName</td>
                        <td class="col-url">
                            @(string.IsNullOrWhiteSpace(p.RemoteUrl) ? "-" : p.RemoteUrl)
                        </td>

                        <td class="col-account">@(string.IsNullOrWhiteSpace(p.TestAccount) ? "-" : p.TestAccount)</td>
                        <td class="text-center col-date">@(p.StartDate?.ToString("dd MMM yyyy", th) ?? "-")</td>
                        <td class="text-center col-date">@(p.EndDate?.ToString("dd MMM yyyy", th) ?? "-")</td>
                        <td class="text-center col-status">@p.Status</td>
                        <td class="text-center col-mini">
                            @if (!string.IsNullOrEmpty(p.FigmaLink))
                            { <a href="@p.FigmaLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">🎨</a> }
                            else { <span class="text-muted">-</span> }
                        </td>
                    </tr>
                    i++;
                }
            }
            </tbody>
        </table>
    </div>

    <div class="project-report-cards">

    @if (Model == null || !Model.Any())
    {
        <div class="text-center text-muted py-5">
            — No project data —
        </div>
    }
    else
    {
        var i = 1;

        foreach (var p in Model
            .OrderBy(x => x.Status == "IN_PROGRESS" ? 0 : x.Status == "PLAN" ? 1 : 2)
            .ThenBy(x => x.EndDate ?? DateTime.MaxValue))
        {
            <div class="project-report-card"
                 data-search="@($"{p.ProjectName} {p.LinkName} {p.DatabaseName} {p.RemoteUrl} {p.TestAccount} {p.Status}".ToLower())">

                <div class="project-report-header">

                    <div class="project-report-title mb-2">
                        @i. @p.ProjectName
                    </div>

                    <span class="badge @(p.Status == "IN_PROGRESS" ? "bg-info" : p.Status == "DONE" ? "bg-success" : "bg-secondary") rounded-pill px-3 py-2 mb-2">
                        @p.Status
                    </span>

                </div>

                <div class="project-report-grid">

                    <div class="project-report-box">
                        <span class="project-label">BA</span>
                        <span class="project-value">@(string.IsNullOrWhiteSpace(p.LinkName) ? "-" : p.LinkName)</span>
                    </div>

                    <div class="project-report-box">
                        <span class="project-label">System</span>

                        <span class="project-value text-break">
                            @if (!string.IsNullOrWhiteSpace(p.LinkName))
                            {
                                var parts = p.LinkName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                foreach (var part in parts)
                                {
                                    if (part.StartsWith("https", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a href="@part"
                                           target="_blank"
                                           rel="noopener noreferrer">
                                            @part
                                        </a>
                                        <br />
                                    }
                                    else
                                    {
                                        <span>@part </span>
                                    }
                                }
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </span>
                    </div>

                    <div class="project-report-box">
                        <span class="project-label">Database</span>
                        <span class="project-value">
                            @(string.IsNullOrWhiteSpace(p.DatabaseName) ? "-" : p.DatabaseName)
                        </span>
                    </div>

                    <div class="project-report-box">
                        <span class="project-label">Remote URL</span>

                        <span class="project-value text-break">
                            @(string.IsNullOrWhiteSpace(p.RemoteUrl) ? "-" : p.RemoteUrl)
                        </span>
                    </div>

                    <div class="project-report-box">
                        <span class="project-label">Test Account</span>
                        <span class="project-value text-break">
                            @(string.IsNullOrWhiteSpace(p.TestAccount) ? "-" : p.TestAccount)
                        </span>
                    </div>

                    <div class="project-report-box">
                        <span class="project-label">Start</span>
                        <span class="project-value">
                            @(p.StartDate?.ToString("dd MMM yyyy", th) ?? "-")
                        </span>
                    </div>

                    <div class="project-report-box">
                        <span class="project-label">End</span>
                        <span class="project-value">
                            @(p.EndDate?.ToString("dd MMM yyyy", th) ?? "-")
                        </span>
                    </div>

                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        @if (!string.IsNullOrEmpty(p.FigmaLink))
                        {
                            <a href="@p.FigmaLink"
                               target="_blank"
                               class="btn btn-outline-primary btn-sm rounded-pill">
                                🎨 Figma
                            </a>
                        }
                    </div>

                </div>
            </div>

            i++;
        }
    }

    </div>

</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('search');
    if (!input) return;

    input.addEventListener('keyup', () => {
        const k = input.value.toLowerCase().trim();

        document.querySelectorAll('#tbl tbody tr').forEach(r => {
            r.style.display = r.innerText.toLowerCase().includes(k) ? '' : 'none';
        });

        document.querySelectorAll('.project-report-card').forEach(card => {
            const text = (card.dataset.search || '').toLowerCase();
            card.style.display = text.includes(k) ? '' : 'none';
        });
    });
});
</script>
}
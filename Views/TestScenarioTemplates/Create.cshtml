@model ProjectTracking.Models.TestScenarioTemplate
@using ProjectTracking.Helpers

@{
    bool lockGroup = ViewBag.LockGroup != null && (bool)ViewBag.LockGroup;
    int? selectedControlId = ViewBag.SelectedControlId as int?;
    var controls = ViewBag.Controls as IEnumerable<ProjectTracking.Models.TestTemplateGroupControl>
                   ?? Enumerable.Empty<ProjectTracking.Models.TestTemplateGroupControl>();
    var groups = ViewBag.Groups as IEnumerable<ProjectTracking.Models.TestTemplateGroup>
                 ?? Enumerable.Empty<ProjectTracking.Models.TestTemplateGroup>();
}

<h2>เพิ่มแม่แบบสถานการณ์ทดสอบ</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Template Groups Control</label>
        @if (lockGroup)
        {
            <select id="controlId" name="controlId" class="form-select" disabled>
                <option value="">-- Select Control --</option>
                @foreach (var control in controls)
                {
                    <option value="@control.control_id" selected="@(selectedControlId == control.control_id)">@control.control_name</option>
                }
            </select>
            <input type="hidden" name="controlId" value="@selectedControlId" />
        }
        else
        {
            <select id="controlId" name="controlId" class="form-select">
                <option value="">-- Select Control --</option>
                @foreach (var control in controls)
                {
                    <option value="@control.control_id" selected="@(selectedControlId == control.control_id)">@control.control_name</option>
                }
            </select>
        }
        @Html.ValidationMessage("controlId", null, new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <label class="form-label">Template Group</label>
        <select asp-for="group_id" id="groupId" class="form-select" disabled="@lockGroup">
            <option value="">-- Select Group --</option>
            @foreach (var g in groups)
            {
                <option value="@g.group_id" data-control-id="@g.control_id">@g.group_name</option>
            }
        </select>
        @if (lockGroup)
        {
            <input type="hidden" asp-for="group_id" />
        }
        <span asp-validation-for="group_id" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">หัวข้อการทดสอบ</label>
        <input asp-for="title" class="form-control" placeholder="เช่น ทดสอบการเข้าสู่ระบบด้วยข้อมูลถูกต้อง" required />
    </div>

    <div class="mb-3">
        <label class="form-label">เงื่อนไขก่อนเริ่มทดสอบ</label>
        <textarea asp-for="precondition" class="form-control" rows="3" placeholder="เช่น ผู้ใช้ต้อง Login เข้าระบบแล้ว"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">ขั้นตอนการทดสอบ</label>
        <textarea asp-for="steps" class="form-control" rows="5" placeholder="1. เปิดหน้า Login&#10;2. กรอก Username และ Password&#10;3. กดปุ่ม Login" required></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">ผลลัพธ์ที่ควรเกิดขึ้น</label>
        <textarea asp-for="expected_result" class="form-control" rows="5" placeholder="เช่น&#10;1. ระบบเข้าสู่หน้า...&#10;2. แสดงข้อความบันทึกสำเร็จ&#10;3. ไม่มี error" required></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">ระดับความสำคัญ</label>
        <select asp-for="priority_default" class="form-select">
            <option value="LOW">LOW</option>
            <option value="MEDIUM">MEDIUM</option>
            <option value="HIGH">HIGH</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">สถานะ</label>
        <select asp-for="status_default" class="form-select">
            <option value="READY">@TestScenarioDisplay.StatusText("READY")</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index"
       asp-route-groupId="@Model.group_id"
       class="btn btn-secondary">Cancel</a>
</form>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var control = document.getElementById("controlId");
        var group = document.getElementById("groupId");
        if (!control || !group) return;

        function applyControl(resetGroup) {
            var controlId = control.value || "";
            if (resetGroup) {
                group.value = "";
            }

            group.disabled = @lockGroup.ToString().ToLower() || !controlId;
            group.querySelectorAll("option[data-control-id]").forEach(function (option) {
                var matches = controlId && option.getAttribute("data-control-id") === controlId;
                option.hidden = !matches;
                option.disabled = !matches;
            });
        }

        control.addEventListener("change", function () {
            applyControl(true);
        });

        applyControl(false);
    });
</script>

@model IEnumerable<ProjectTracking.Models.TestScenarioTemplate>

@using Microsoft.AspNetCore.Http
@using ProjectTracking.Helpers

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@{
    var departments = ViewBag.Departments as IEnumerable<ProjectTracking.Models.ProjectDepartment>
                      ?? Enumerable.Empty<ProjectTracking.Models.ProjectDepartment>();
    var groups = ViewBag.Groups as IEnumerable<ProjectTracking.Models.TestTemplateGroup>
                 ?? Enumerable.Empty<ProjectTracking.Models.TestTemplateGroup>();
    var controls = ViewBag.Controls as IEnumerable<ProjectTracking.Models.TestTemplateGroupControl>
                   ?? Enumerable.Empty<ProjectTracking.Models.TestTemplateGroupControl>();
}
@{
    int? selectedGroupId = null;
    int? selectedControlId = null;
    int? selectedDepartmentId = null;
    if (ViewBag.SelectedDepartmentId != null)
    {
        selectedDepartmentId = (int)ViewBag.SelectedDepartmentId;
    }
    if (ViewBag.SelectedGroupId != null)
    {
        selectedGroupId = (int)ViewBag.SelectedGroupId;
    }
    if (ViewBag.SelectedControlId != null)
    {
        selectedControlId = (int)ViewBag.SelectedControlId;
    }

    var controlSections = (Model ?? Enumerable.Empty<ProjectTracking.Models.TestScenarioTemplate>())
        .GroupBy(x => new
        {
            DepartmentName = x.Group?.Control?.Department?.DepartmentName ?? "ยังไม่กำหนดฝ่าย",
            DepartmentSort = x.Group?.Control?.Department?.SortOrder ?? int.MaxValue,
            ControlId = x.Group?.control_id,
            ControlName = x.Group?.Control?.control_name ?? "ยังไม่กำหนด Control",
            ControlSort = x.Group?.Control?.sort_order ?? int.MaxValue
        })
        .OrderBy(x => x.Key.DepartmentSort)
        .ThenBy(x => x.Key.DepartmentName)
        .ThenBy(x => x.Key.ControlSort)
        .ThenBy(x => x.Key.ControlName);

    string StatusTextClass(string? status)
    {
        return TestScenarioDisplay.NormalizeStatus(status) switch
        {
            "PASSED" => "is-success",
            "FAILED" => "is-danger",
            "READY" => "is-primary",
            _ => "is-muted"
        };
    }

    string PriorityTextClass(string? priority)
    {
        return (priority ?? "").Trim().ToUpperInvariant() switch
        {
            "HIGH" => "is-danger",
            "MEDIUM" => "is-warning",
            "LOW" => "is-success",
            _ => "is-muted"
        };
    }
}

@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

<style>
    /* Colored table header */
    .template-table thead th {
        background-color: #198754 !important; /* green */
        color: #ffffff;
        text-align: center;
        vertical-align: middle;
    }

    /* Center specific columns */
    .text-center-col {
        text-align: center;
        vertical-align: middle;
    }

    /* Make wide tables scroll horizontally without breaking the page */
    .template-table {
        min-width: 1400px; /* forces horizontal scroll inside the wrapper */
    }

    /* Improve readability for long text */
    .template-table td {
        vertical-align: top;
    }

    /* Make dropdown wider */
    #templateFilter {
        width: 100%;
        min-width: 0;
    }

    .page-header-card {
        border: 1px solid #e9ecef;
        border-radius: 10px;
        background: #fff;
    }

    .page-header-card .card-body {
        padding: 16px;
    }

    .template-card-groups {
        display: grid;
        gap: 18px;
    }

    .template-control-section {
        overflow: hidden;
        background: #f8fbff;
        border: 1px solid #cbddeb;
        border-radius: 10px;
    }

    .template-control-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 16px;
        background: #eef7ff;
        border-bottom: 1px solid #cbddeb;
    }

    .template-control-eyebrow {
        margin: 0 0 2px;
        color: #64748b;
        font-size: .78rem;
        font-weight: 400;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .template-control-title {
        margin: 0;
        color: #10233f;
        font-size: 1.05rem;
        font-weight: 500;
        line-height: 1.35;
    }

    .template-control-count {
        flex: 0 0 auto;
        color: #0f766e;
        font-size: .9rem;
        font-weight: 500;
    }

    .template-control-groups {
        display: grid;
        gap: 14px;
        padding: 14px;
    }

    .template-group-card {
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 22px;
        box-shadow: 0 12px 28px rgba(15, 35, 64, .08);
        overflow: hidden;
    }

    .template-group-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 18px;
        background: linear-gradient(180deg, #f8fafc, #eef6fb);
        border-bottom: 1px solid #d8e3ef;
    }

    .template-group-title {
        color: #10233f;
        font-size: 1.02rem;
        font-weight: 900;
        margin: 0;
    }

    .template-group-count {
        color: #0f766e;
        background: rgba(20, 184, 166, .14);
        border-radius: 999px;
        padding: 4px 10px;
        font-weight: 900;
        white-space: nowrap;
    }

    .template-card-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        padding: 16px;
    }

    .template-card {
        background: #fff;
        border: 2px solid #94a3b8;
        border-radius: 14px !important;
        padding: 16px;
        box-shadow: 0 8px 22px rgba(15, 35, 64, .06);
        content-visibility: auto;
        contain-intrinsic-size: auto 320px;
    }

    .template-card.is-success { border-color: #22c55e; }
    .template-card.is-danger { border-color: #ef4444; }
    .template-card.is-primary { border-color: #2563eb; }
    .template-card.is-muted { border-color: #94a3b8; }

    .template-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .template-card-title {
        min-width: 0;
    }

    .template-title {
        color: #10233f;
        font-size: 1.05rem;
        font-weight: 900;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .template-code {
        color: #0f766e;
        font-size: .82rem;
        font-weight: 900;
        letter-spacing: .02em;
    }

    .template-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
    }

    .template-pill {
        color: #334155;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: .84rem;
        font-weight: 800;
    }

    .template-status-text,
    .template-priority-text {
        display: inline;
        min-width: 0;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        font-weight: 900;
        line-height: 1.35;
        white-space: normal;
    }

    .template-status-text {
        flex: 0 0 auto;
        font-size: .96rem;
        text-align: right;
    }

    .template-status-text.is-success,
    .template-priority-text.is-success {
        color: #16a34a;
    }

    .template-status-text.is-danger,
    .template-priority-text.is-danger {
        color: #ef4444;
    }

    .template-status-text.is-primary,
    .template-priority-text.is-primary {
        color: #2563eb;
    }

    .template-status-text.is-warning,
    .template-priority-text.is-warning {
        color: #b7790b;
    }

    .template-status-text.is-muted,
    .template-priority-text.is-muted {
        color: #64748b;
    }

    .template-detail-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .template-detail-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 12px;
        min-width: 0;
    }

    .template-detail-box--precondition {
        background: linear-gradient(180deg, rgba(20, 184, 166, .13), rgba(240, 253, 250, .92));
        border-color: rgba(20, 184, 166, .28);
    }

    .template-detail-box--steps {
        background: linear-gradient(180deg, rgba(37, 99, 235, .11), rgba(239, 246, 255, .92));
        border-color: rgba(37, 99, 235, .24);
    }

    .template-detail-box--expected {
        background: linear-gradient(180deg, rgba(245, 158, 11, .13), rgba(255, 251, 235, .92));
        border-color: rgba(245, 158, 11, .28);
    }

    .template-detail-box--remark {
        grid-column: 1 / -1;
        background: #f8fafc;
        border-color: #cbd5e1;
    }

    .template-detail-box--precondition .template-detail-label {
        color: #0f766e;
    }

    .template-detail-box--steps .template-detail-label {
        color: #2563eb;
    }

    .template-detail-box--expected .template-detail-label {
        color: #b45309;
    }

    .template-detail-box--remark .template-detail-label {
        color: #475569;
    }

    .template-detail-label {
        color: #64748b;
        font-size: .82rem;
        font-weight: 900;
        margin-bottom: 6px;
    }

    .template-detail-text {
        color: #10233f;
        font-weight: 700;
        line-height: 1.45;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .template-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
        padding-top: 12px;
        border-top: 1px solid #e2e8f0;
    }

    @@media (max-width: 992px) {
        .template-detail-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .template-card-head,
        .template-group-header {
            flex-direction: column;
            align-items: stretch;
        }

        .template-actions {
            justify-content: stretch;
        }

    }
</style>

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">Scenario Templates</h2>
        <p class="index-subtitle">จัดการ Template สำหรับสร้าง Test Scenario ตามกลุ่มงาน</p>
    </div>

    <div class="index-actions">
        @if (CanMenu("TestScenarioTemplates.Create"))
        {
            <a id="addTemplateBtn" href="#" class="btn btn-success" title="เพิ่ม Template">
                Add Template
            </a>
        }
        else
        {
            <button class="btn btn-success" disabled title="ไม่มีสิทธิ์เพิ่ม Template">
                Add Template
            </button>
        }
    </div>
</div>

<div class="page-header-card mb-4">
    <div class="card-body">
        <form method="get" id="templateFilterForm">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">ฝ่าย</label>
                    <select id="departmentFilter" name="departmentId" class="form-select" onchange="onDepartmentChange()">
                        <option value="">-- ทุกฝ่าย --</option>
                        @foreach (var department in departments)
                        {
                            <option value="@department.DepartmentId" selected="@(selectedDepartmentId == department.DepartmentId)">@department.DepartmentName</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-lg-6">
                    <label class="form-label">Template Groups Control</label>
                    <select id="controlFilter" name="controlId" class="form-select" onchange="onControlChange()" disabled="@(!selectedDepartmentId.HasValue)">
                        <option value="">-- Select Control --</option>
                        @foreach (var control in controls)
                        {
                            <option value="@control.control_id" selected="@(selectedControlId == control.control_id)">@control.control_name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-lg-6">
                    <label class="form-label">Template Group</label>
                    <select id="templateFilter"
                            name="groupId"
                            class="form-select"
                            data-selected-group="@(selectedGroupId?.ToString() ?? "")"
                            onchange="onGroupChange()"
                            disabled>
                        <option value="">-- Select Group --</option>
                    </select>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!selectedDepartmentId.HasValue)
{
    <div class="alert alert-info">กรุณาเลือกฝ่ายเพื่อแสดง Scenario Template</div>
}
else if (Model == null || !Model.Any())
{
    <div class="alert alert-warning">ไม่พบ Scenario Template</div>
}
else
{
    <div class="template-card-groups">
        @foreach (var controlSection in controlSections)
        {
            <section class="template-control-section">
                <header class="template-control-header">
                    <div>
                        <p class="template-control-eyebrow">ฝ่าย @controlSection.Key.DepartmentName · Template Groups Control</p>
                        <h3 class="template-control-title">@controlSection.Key.ControlName</h3>
                    </div>
                    <span class="template-control-count">@controlSection.Count() Template</span>
                </header>

                <div class="template-control-groups">
                @foreach (var grp in controlSection
                    .GroupBy(x => new
                    {
                        x.group_id,
                        GroupName = x.Group?.group_name ?? "Ungrouped",
                        GroupSort = x.Group?.sort_order ?? int.MaxValue
                    })
                    .OrderBy(x => x.Key.GroupSort)
                    .ThenBy(x => x.Key.GroupName))
                {
                    <section class="template-group-card">
                        <div class="template-group-header">
                            <h4 class="template-group-title">@grp.Key.GroupName</h4>
                            <span class="template-group-count">@grp.Count() รายการ</span>
                        </div>

                        <div class="template-card-list">
                            @{ var groupRowNo = 0; }
                            @foreach (var item in grp.OrderBy(x => x.template_id))
                            {
                                groupRowNo++;
                                <article class="template-card @StatusTextClass(item.status_default)" data-gid="@(item.group_id ?? 0)">
                                    <div class="template-card-head">
                                        <div class="template-card-title">
                                            <div class="template-code">#@groupRowNo · Template</div>
                                            <div class="template-title">@item.title</div>
                                        </div>
                                        <span class="template-status-text @(item.is_active ? "is-success" : "is-muted")">
                                            @(item.is_active ? "Active" : "Inactive")
                                        </span>
                                    </div>

                                    <div class="template-meta">
                                        <span class="template-pill">
                                            Priority:
                                            <span class="template-priority-text @PriorityTextClass(item.priority_default)">
                                                @item.priority_default
                                            </span>
                                        </span>
                                        <span class="template-pill">
                                            สถานะ:
                                            <span class="template-status-text @StatusTextClass(item.status_default)">
                                                @TestScenarioDisplay.StatusText(item.status_default)
                                            </span>
                                        </span>
                                    </div>

                                    <div class="template-detail-grid">
                                        <div class="template-detail-box template-detail-box--precondition">
                                            <div class="template-detail-label">Precondition</div>
                                            <div class="template-detail-text">@(string.IsNullOrWhiteSpace(item.precondition) ? "-" : item.precondition)</div>
                                        </div>
                                        <div class="template-detail-box template-detail-box--steps">
                                            <div class="template-detail-label">Steps</div>
                                            <div class="template-detail-text">@item.steps</div>
                                        </div>
                                        <div class="template-detail-box template-detail-box--expected">
                                            <div class="template-detail-label">Expected Result</div>
                                            <div class="template-detail-text">@item.expected_result</div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.remark))
                                        {
                                            <div class="template-detail-box template-detail-box--remark">
                                                <div class="template-detail-label">Remark</div>
                                                <div class="template-detail-text">@item.remark</div>
                                            </div>
                                        }
                                    </div>

                                    <div class="template-actions">
                                        @if (CanMenu("TestScenarioTemplates.Edit"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.template_id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="แก้ไข">
                                                Edit
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                                Edit
                                            </button>
                                        }

                                        @if (CanMenu("TestScenarioTemplates.Toggle"))
                                        {
                                            <form asp-action="ToggleActive"
                                                  asp-route-id="@item.template_id"
                                                  method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="เปิด/ปิดการใช้งาน">
                                                    Toggle
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์เปลี่ยนสถานะ">
                                                Toggle
                                            </button>
                                        }

                                        @if (CanMenu("TestScenarioTemplates.Delete"))
                                        {
                                            <form asp-action="Delete"
                                                  asp-route-id="@item.template_id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Delete this template?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="ลบ">
                                                    Delete
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                                Delete
                                            </button>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }
                </div>
            </section>
        }
    </div>
}

<script>
    const templateGroups = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        groups.Select(g => new
        {
            id = g.group_id,
            controlId = g.control_id,
            name = g.group_name,
            sort = g.sort_order
        })));

    function buildIndexUrl(parameters) {
        var query = new URLSearchParams(parameters);
        return "/TestScenarioTemplates" + (query.toString() ? "?" + query.toString() : "");
    }

    function applyControlToGroups(resetGroup) {
        var control = document.getElementById("controlFilter");
        var group = document.getElementById("templateFilter");
        if (!control || !group) return;

        var selectedControl = control.value || "";
        var selectedGroup = resetGroup ? "" : (group.value || group.dataset.selectedGroup || "");

        group.replaceChildren(new Option("-- Select Group --", ""));
        templateGroups
            .filter(function (item) {
                return selectedControl && String(item.controlId) === selectedControl;
            })
            .sort(function (left, right) {
                return left.sort - right.sort || left.name.localeCompare(right.name, "th");
            })
            .forEach(function (item) {
                group.add(new Option(item.name, String(item.id)));
            });

        group.disabled = !selectedControl;
        group.value = selectedGroup;
        group.dataset.selectedGroup = "";
        updateAddButtonState();
    }

    function updateAddButtonState() {
        var button = document.getElementById("addTemplateBtn");
        var control = document.getElementById("controlFilter");
        var group = document.getElementById("templateFilter");
        if (!button || !control || !group) return;

        var ready = !!control.value && !!group.value;
        button.classList.toggle("disabled", !ready);
        button.setAttribute("aria-disabled", ready ? "false" : "true");
    }

    function onControlChange() {
        applyControlToGroups(true);
        var department = document.getElementById("departmentFilter").value || "";
        var selectedControl = document.getElementById("controlFilter").value || "";
        var parameters = { departmentId: department };
        if (selectedControl) {
            parameters.controlId = selectedControl;
        }
        window.location.href = buildIndexUrl(parameters);
    }

    function onDepartmentChange() {
        var department = document.getElementById("departmentFilter").value || "";
        window.location.href = buildIndexUrl({ departmentId: department });
    }

    function onGroupChange() {
        var department = document.getElementById("departmentFilter").value || "";
        var control = document.getElementById("controlFilter").value || "";
        var selected = document.getElementById("templateFilter").value || "";
        var parameters = { departmentId: department };
        if (control) {
            parameters.controlId = control;
        }
        if (selected) {
            parameters.groupId = selected;
        }
        window.location.href = buildIndexUrl(parameters);
    }

    function filterTemplates() {
        var selected = document.getElementById("templateFilter").value;
        var rows = document.querySelectorAll("tbody tr");

        rows.forEach(function(row) {
            var gid = row.getAttribute("data-gid");
            if (!selected || gid === selected) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        applyControlToGroups(false);

        // Do not auto-filter on client; server already filtered by groupId

        var btn = document.getElementById("addTemplateBtn");
        if (!btn) return;

        btn.addEventListener("click", function (e) {
            e.preventDefault();

            var selectedControl = document.getElementById("controlFilter").value;
            var selectedGroup = document.getElementById("templateFilter").value;
            var selectedDepartment = document.getElementById("departmentFilter").value;
            if (!selectedDepartment) {
                alert("กรุณาเลือกฝ่ายก่อน");
                return;
            }
            if (!selectedControl) {
                alert("กรุณาเลือก Template Groups Control ก่อน");
                return;
            }
            if (!selectedGroup) {
                alert("กรุณาเลือก Template Group ก่อน");
                return;
            }

            window.location.href = "/TestScenarioTemplates/Create?groupId=" + encodeURIComponent(selectedGroup);
        });
    });
</script>

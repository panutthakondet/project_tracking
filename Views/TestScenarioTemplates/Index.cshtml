@model IEnumerable<ProjectTracking.Models.TestScenarioTemplate>

@using Microsoft.AspNetCore.Http

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@{
    var groups = ViewBag.Groups as IEnumerable<ProjectTracking.Models.TestTemplateGroup>
                 ?? Enumerable.Empty<ProjectTracking.Models.TestTemplateGroup>();
}
@{
    int? selectedGroupId = null;
    if (ViewBag.SelectedGroupId != null)
    {
        selectedGroupId = (int)ViewBag.SelectedGroupId;
    }
}

@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

<style>
    /* Colored table header */
    .template-table thead th {
        background-color: #198754 !important; /* green */
        color: #ffffff;
        text-align: center;
        vertical-align: middle;
    }

    /* Center specific columns */
    .text-center-col {
        text-align: center;
        vertical-align: middle;
    }

    /* Make wide tables scroll horizontally without breaking the page */
    .template-table {
        min-width: 1400px; /* forces horizontal scroll inside the wrapper */
    }

    /* Improve readability for long text */
    .template-table td {
        vertical-align: top;
    }

    /* Make dropdown wider */
    #templateFilter {
        width: 100%;
        min-width: 400px;
    }

    .template-card-groups {
        display: grid;
        gap: 18px;
    }

    .template-group-card {
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 22px;
        box-shadow: 0 12px 28px rgba(15, 35, 64, .08);
        overflow: hidden;
    }

    .template-group-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 18px;
        background: linear-gradient(180deg, #f8fafc, #eef6fb);
        border-bottom: 1px solid #d8e3ef;
    }

    .template-group-title {
        color: #10233f;
        font-size: 1.02rem;
        font-weight: 900;
        margin: 0;
    }

    .template-group-count {
        color: #0f766e;
        background: rgba(20, 184, 166, .14);
        border-radius: 999px;
        padding: 4px 10px;
        font-weight: 900;
        white-space: nowrap;
    }

    .template-card-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
        gap: 14px;
        padding: 16px;
    }

    .template-card {
        background: #fff;
        border: 1px solid #dbeafe;
        border-left: 5px solid #14b8a6;
        border-radius: 18px;
        padding: 16px;
        box-shadow: 0 8px 22px rgba(15, 35, 64, .06);
        min-width: 0;
    }

    .template-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .template-title {
        color: #10233f;
        font-size: 1.02rem;
        font-weight: 900;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .template-code {
        color: #0f766e;
        font-size: .82rem;
        font-weight: 900;
        letter-spacing: .02em;
    }

    .template-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
    }

    .template-pill {
        color: #334155;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: .84rem;
        font-weight: 800;
    }

    .template-detail-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .template-detail-label {
        color: #64748b;
        font-size: .82rem;
        font-weight: 900;
        margin-bottom: 6px;
    }

    .template-detail-text {
        color: #10233f;
        font-weight: 700;
        line-height: 1.45;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .template-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
        padding-top: 12px;
        border-top: 1px solid #e2e8f0;
    }

    @@media (max-width: 575.98px) {
        #templateFilter {
            min-width: 0;
        }

        .template-card-list {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">Scenario Templates</h2>
        <p class="index-subtitle">จัดการ Template สำหรับสร้าง Test Scenario ตามกลุ่มงาน</p>
    </div>

    <div class="index-actions">
        @if (CanMenu("TestScenarioTemplates.Create"))
        {
            <a id="addTemplateBtn" href="#" class="btn btn-success" title="เพิ่ม Template">
                Add Template
            </a>
        }
        else
        {
            <button class="btn btn-success" disabled title="ไม่มีสิทธิ์เพิ่ม Template">
                Add Template
            </button>
        }
    </div>
</div>

<div class="row mb-3">
<div class="col-md-8">
        <label class="form-label">Filter by Group</label>
        <select id="templateFilter" name="groupId" class="form-select" onchange="onGroupChange()">
            <option value="">-- Show All --</option>
            @foreach (var g in groups)
            {
                if (selectedGroupId.HasValue && selectedGroupId.Value == g.group_id)
                {
                    <option value="@g.group_id" selected>@g.group_name</option>
                }
                else
                {
                    <option value="@g.group_id">@g.group_name</option>
                }
            }
        </select>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning">ไม่พบ Scenario Template</div>
}
else
{
    <div class="template-card-groups">
        @foreach (var grp in Model.OrderBy(x => x.group_id ?? 0).ThenBy(x => x.template_id).GroupBy(x => x.Group?.group_name ?? "Ungrouped"))
        {
            <section class="template-group-card">
                <div class="template-group-header">
                    <h3 class="template-group-title">@grp.Key</h3>
                    <span class="template-group-count">@grp.Count() รายการ</span>
                </div>

                <div class="template-card-list">
                    @{ var groupRowNo = 0; }
                    @foreach (var item in grp)
                    {
                        groupRowNo++;
                        <article class="template-card" data-gid="@(item.group_id ?? 0)">
                            <div class="template-card-head">
                                <div>
                                    <div class="template-code">#@groupRowNo · Template</div>
                                    <div class="template-title">@item.title</div>
                                </div>
                                <span class="badge @(item.is_active ? "bg-success" : "bg-secondary")">
                                    @(item.is_active ? "Active" : "Inactive")
                                </span>
                            </div>

                            <div class="template-meta">
                                <span class="template-pill">Priority: @item.priority_default</span>
                                <span class="template-pill">Status: @item.status_default</span>
                            </div>

                            <div class="template-detail-box">
                                <div class="template-detail-label">Precondition</div>
                                <div class="template-detail-text">@(string.IsNullOrWhiteSpace(item.precondition) ? "-" : item.precondition)</div>
                            </div>
                            <div class="template-detail-box">
                                <div class="template-detail-label">Steps</div>
                                <div class="template-detail-text">@item.steps</div>
                            </div>
                            <div class="template-detail-box">
                                <div class="template-detail-label">Expected Result</div>
                                <div class="template-detail-text">@item.expected_result</div>
                            </div>

                            <div class="template-actions">
                                @if (CanMenu("TestScenarioTemplates.Edit"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.template_id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="แก้ไข">
                                        Edit
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">
                                        Edit
                                    </button>
                                }

                                @if (CanMenu("TestScenarioTemplates.Toggle"))
                                {
                                    <form asp-action="ToggleActive"
                                          asp-route-id="@item.template_id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="เปิด/ปิดการใช้งาน">
                                            Toggle
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์เปลี่ยนสถานะ">
                                        Toggle
                                    </button>
                                }

                                @if (CanMenu("TestScenarioTemplates.Delete"))
                                {
                                    <form asp-action="Delete"
                                          asp-route-id="@item.template_id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this template?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="ลบ">
                                            Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">
                                        Delete
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}

<script>
    function onGroupChange() {
        var selected = document.getElementById("templateFilter").value || "";
        var url = "/TestScenarioTemplates";
        if (selected) {
            url += "?groupId=" + encodeURIComponent(selected);
        }
        window.location.href = url;
    }

    function filterTemplates() {
        var selected = document.getElementById("templateFilter").value;
        var rows = document.querySelectorAll("tbody tr");

        rows.forEach(function(row) {
            var gid = row.getAttribute("data-gid");
            if (!selected || gid === selected) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        var serverPreset = "@(selectedGroupId?.ToString() ?? "")";
        var preset = serverPreset;

        var ddl = document.getElementById("templateFilter");
        if (ddl && preset) {
            ddl.value = preset;
        }

        // Do not auto-filter on client; server already filtered by groupId

        var btn = document.getElementById("addTemplateBtn");
        if (!btn) return;

        btn.addEventListener("click", function (e) {
            e.preventDefault();

            var selected = document.getElementById("templateFilter").value;
            if (!selected) {
                alert("กรุณาเลือก Template Group ก่อน");
                return;
            }

            window.location.href = "/TestScenarioTemplates/Create?groupId=" + encodeURIComponent(selected);
        });
    });
</script>

@model ProjectTracking.Models.ProjectIssue
@using ProjectTracking.Models
@using System.Linq

@{
    ViewData["Title"] = "แก้ไข Issue";

    var issue = Model ?? new ProjectIssue();
    var beforeImages = issue.Images?.ToList() ?? new List<ProjectIssueImage>();
    var projectName = (ViewBag.ProjectName as string) ?? issue.Project?.ProjectDisplayName ?? $"Project #{issue.ProjectId}";
    DateTime? startDate = Model?.StartDate;
    DateTime? endDate = Model?.EndDate;

    string ThaiDateText(DateTime? value)
    {
        if (!value.HasValue) return "";
        var year = value.Value.Year;
        while (year > 2200) year -= 543;
        return $"{value.Value:dd/MM/}{year + 543}";
    }

    string startDateText = ThaiDateText(startDate);
    string endDateText = ThaiDateText(endDate);
}

<style>
    .issue-edit-gallery-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .issue-edit-section-title {
        color: #10233f;
        font-size: 1.05rem;
        font-weight: 900;
        margin: 0;
    }

    .issue-edit-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 5px 12px;
        border-radius: 999px;
        color: #0f766e;
        background: rgba(20, 184, 166, .14);
        font-size: .84rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .issue-edit-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .issue-edit-image-card {
        border: 1px solid #d8e3ef;
        background: #f8fafc;
        border-radius: 14px;
        padding: 8px;
        overflow: hidden;
    }

    .issue-edit-image-card img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 10px;
        display: block;
        transition: transform .15s, box-shadow .15s;
    }

    .issue-edit-image-card a:hover img {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(15, 35, 64, .15);
    }

    .issue-edit-delete-check {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
        color: #be123c;
        font-size: 13px;
        font-weight: 900;
    }

    .issue-edit-empty {
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        color: #64748b;
        background: #f8fafc;
        padding: 18px;
        font-weight: 800;
        text-align: center;
        margin-bottom: 14px;
    }

    .issue-edit-note {
        border-radius: 14px;
        background: #eff6ff;
        color: #1e3a8a;
        padding: 12px 14px;
        font-weight: 700;
        line-height: 1.55;
    }
</style>

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">Project Issue #@issue.IssueId</span>
        <h2 class="index-title">แก้ไขปัญหาโครงการ</h2>
        <p class="index-subtitle">@projectName</p>
    </div>

</div>

<div class="card shadow-sm pt-form-card">
    <div class="card-body">
        <form asp-action="Edit"
              asp-route-id="@issue.IssueId"
              method="post"
              enctype="multipart/form-data"
              onsubmit="return confirm('บันทึกการแก้ไข Issue นี้หรือไม่?');">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IssueId" />
            <input type="hidden" asp-for="ProjectId" />
            <input type="hidden" asp-for="DevStatus" />
            <input type="hidden" asp-for="IsReopen" />
            <input type="hidden" asp-for="ReopenCount" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">📁 Project</label>
                    <div class="pt-readonly-field">@projectName</div>
                </div>

                <div class="col-12">
                    <label asp-for="IssueName" class="form-label fw-semibold">หัวข้อปัญหา</label>
                    <input asp-for="IssueName"
                           class="form-control"
                           placeholder="ระบุหัวข้อปัญหา" />
                    <span asp-validation-for="IssueName" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="IssueDetail" class="form-label fw-semibold">รายละเอียดปัญหา</label>
                    <textarea asp-for="IssueDetail"
                              class="form-control"
                              rows="6"
                              placeholder="อธิบายปัญหา เงื่อนไขที่พบ หรือขั้นตอนที่ทำให้เกิดปัญหา"></textarea>
                    <span asp-validation-for="IssueDetail" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="AssignTo" class="form-label fw-semibold">👤 เจ้าของงาน</label>
                    <select asp-for="AssignTo"
                            asp-items="ViewBag.Employees"
                            class="form-select">
                        <option value="">-- เลือกเจ้าของงาน --</option>
                    </select>
                    <span asp-validation-for="AssignTo" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="IssueStatus" class="form-label fw-semibold">📌 สถานะการตรวจ (Tester/BA)</label>
                    <select asp-for="IssueStatus"
                            asp-items="ViewBag.StatusList"
                            class="form-select"></select>
                    <span asp-validation-for="IssueStatus" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="IssuePriority" class="form-label fw-semibold">⚡ ความสำคัญ</label>
                    <select asp-for="IssuePriority"
                            class="form-select">
                        <option value="NORMAL">Normal</option>
                        <option value="URGENT">Urgent</option>
                    </select>
                    <span asp-validation-for="IssuePriority" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="StartDate" class="form-label fw-semibold">📅 วันที่เริ่ม</label>
                    <input asp-for="StartDate"
                           type="text"
                           class="form-control thai-date"
                           value="@startDateText"
                           placeholder="วัน/เดือน/พ.ศ."
                           required />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="EndDate" class="form-label fw-semibold">🏁 วันที่สิ้นสุด</label>
                    <input asp-for="EndDate"
                           type="text"
                           class="form-control thai-date"
                           value="@endDateText"
                           placeholder="วัน/เดือน/พ.ศ."
                           required />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">🔁 Reopen Status</label>
                    <div class="pt-readonly-field">@(issue.IsReopen ? "REOPEN" : "NORMAL")</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">🔢 Reopen Count</label>
                    <div class="pt-readonly-field">@issue.ReopenCount ครั้ง</div>
                </div>

                <div class="col-md-8">
                    <label class="form-label fw-semibold">ℹ️ หมายเหตุการนับ Reopen</label>
                    <div class="issue-edit-note">
                        BA/Tester ใช้ OPEN เมื่อเปิดหรือส่งกลับรอแก้, FAIL เมื่อทดสอบไม่ผ่าน, PASS เมื่อทดสอบผ่าน และ REJECT เมื่อไม่รับเป็นปัญหา ส่วน WIP/FIXED มาจากฝั่งโปรแกรมเมอร์
                    </div>
                </div>

                <div class="col-12">
                    <div class="issue-edit-gallery-head">
                        <h3 class="issue-edit-section-title">รูปประกอบก่อนแก้</h3>
                        <span class="issue-edit-count">@beforeImages.Count รูป</span>
                    </div>

                    @if (beforeImages.Any())
                    {
                        <div class="issue-edit-gallery">
                            @foreach (var img in beforeImages)
                            {
                                <div class="issue-edit-image-card">
                                    <a href="@img.FilePath" target="_blank" rel="noopener">
                                        <img src="@img.FilePath" alt="@img.FileName" />
                                    </a>

                                    <div class="issue-edit-delete-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="deleteImageIds"
                                               value="@img.ImageId"
                                               id="del_@img.ImageId" />
                                        <label for="del_@img.ImageId">ลบรูปนี้</label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="issue-edit-empty">ยังไม่มีรูปประกอบก่อนแก้</div>
                    }
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">📎 เพิ่มรูปประกอบ</label>
                    <input type="file"
                           name="newImages"
                           class="form-control"
                           multiple
                           accept="image/*" />
                    <small class="text-muted d-block mt-2">
                        เลือกได้หลายรูป ระบบจะบันทึกเป็นรูปก่อนแก้ของ Issue นี้
                    </small>
                </div>
            </div>

            <div class="pt-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    💾 Save Changes
                </button>

                <a asp-action="Details"
                   asp-route-id="@issue.IssueId"
                   class="btn btn-outline-secondary">
                    ดูรายละเอียด
                </a>

                <a asp-action="Index"
                   asp-route-projectId="@issue.ProjectId"
                   class="btn btn-outline-secondary">
                    ↩ Back
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function convertThaiDateToIso(value) {
            if (!value || !value.trim()) return '';

            const parts = value.trim().split('/');
            if (parts.length !== 3) return value;

            let [d, m, y] = parts;
            d = d.padStart(2, '0');
            m = m.padStart(2, '0');
            y = parseInt(y, 10);

            while (y > 2200) {
                y -= 543;
            }

            return `${y}-${m}-${d}`;
        }

        function formatThaiDateInput(input) {
            if (!input) return;

            input.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');

                if (value.length > 8) {
                    value = value.substring(0, 8);
                }

                if (value.length >= 5) {
                    value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
                } else if (value.length >= 3) {
                    value = `${value.substring(0, 2)}/${value.substring(2)}`;
                }

                e.target.value = value;
            });
        }

        formatThaiDateInput(document.getElementById('StartDate'));
        formatThaiDateInput(document.getElementById('EndDate'));

        document.querySelector('form').addEventListener('submit', function () {
            document.querySelectorAll('.thai-date').forEach(input => {
                input.value = convertThaiDateToIso(input.value);
            });
        }, true);
    </script>
}

@model ProjectTracking.Models.ProjectIssue
@using ProjectTracking.Models
@using System.Linq

@{
    ViewData["Title"] = "แก้ไข Issue";

    var beforeImages = Model.Images?.ToList() ?? new List<ProjectIssueImage>();
    var projectName = (ViewBag.ProjectName as string) ?? Model.Project?.ProjectName ?? $"Project #{Model.ProjectId}";
}

<style>
    .issue-edit-gallery-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .issue-edit-section-title {
        color: #10233f;
        font-size: 1.05rem;
        font-weight: 900;
        margin: 0;
    }

    .issue-edit-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 5px 12px;
        border-radius: 999px;
        color: #0f766e;
        background: rgba(20, 184, 166, .14);
        font-size: .84rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .issue-edit-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .issue-edit-image-card {
        border: 1px solid #d8e3ef;
        background: #f8fafc;
        border-radius: 14px;
        padding: 8px;
        overflow: hidden;
    }

    .issue-edit-image-card img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 10px;
        display: block;
        transition: transform .15s, box-shadow .15s;
    }

    .issue-edit-image-card a:hover img {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(15, 35, 64, .15);
    }

    .issue-edit-delete-check {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
        color: #be123c;
        font-size: 13px;
        font-weight: 900;
    }

    .issue-edit-empty {
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        color: #64748b;
        background: #f8fafc;
        padding: 18px;
        font-weight: 800;
        text-align: center;
        margin-bottom: 14px;
    }

    .issue-edit-note {
        border-radius: 14px;
        background: #eff6ff;
        color: #1e3a8a;
        padding: 12px 14px;
        font-weight: 700;
        line-height: 1.55;
    }
</style>

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">Project Issue #@Model.IssueId</span>
        <h2 class="index-title">แก้ไขปัญหาโครงการ</h2>
        <p class="index-subtitle">@projectName</p>
    </div>

</div>

<div class="card shadow-sm pt-form-card">
    <div class="card-body">
        <form asp-action="Edit"
              asp-route-id="@Model.IssueId"
              method="post"
              enctype="multipart/form-data"
              onsubmit="return confirm('บันทึกการแก้ไข Issue นี้หรือไม่?');">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IssueId" />
            <input type="hidden" asp-for="ProjectId" />
            <input type="hidden" asp-for="DevStatus" />
            <input type="hidden" asp-for="IsReopen" />
            <input type="hidden" asp-for="ReopenCount" />
            <input type="hidden" asp-for="LastFixedAt" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">📁 Project</label>
                    <div class="pt-readonly-field">@projectName</div>
                </div>

                <div class="col-12">
                    <label asp-for="IssueName" class="form-label fw-semibold">หัวข้อปัญหา</label>
                    <input asp-for="IssueName"
                           class="form-control"
                           placeholder="ระบุหัวข้อปัญหา" />
                    <span asp-validation-for="IssueName" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="IssueDetail" class="form-label fw-semibold">รายละเอียดปัญหา</label>
                    <textarea asp-for="IssueDetail"
                              class="form-control"
                              rows="6"
                              placeholder="อธิบายปัญหา เงื่อนไขที่พบ หรือขั้นตอนที่ทำให้เกิดปัญหา"></textarea>
                    <span asp-validation-for="IssueDetail" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="EmpId" class="form-label fw-semibold">👤 เจ้าของงาน</label>
                    <select asp-for="EmpId"
                            asp-items="ViewBag.Employees"
                            class="form-select">
                        <option value="">-- เลือกเจ้าของงาน --</option>
                    </select>
                    <span asp-validation-for="EmpId" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="IssueStatus" class="form-label fw-semibold">📌 สถานะ Issue</label>
                    <select asp-for="IssueStatus"
                            asp-items="ViewBag.StatusList"
                            class="form-select"></select>
                    <span asp-validation-for="IssueStatus" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="IssuePriority" class="form-label fw-semibold">⚡ ความสำคัญ</label>
                    <select asp-for="IssuePriority"
                            class="form-select">
                        <option value="NORMAL">Normal</option>
                        <option value="URGENT">Urgent</option>
                    </select>
                    <span asp-validation-for="IssuePriority" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CreatedAt" class="form-label fw-semibold">📅 วันที่สร้าง</label>
                    <input asp-for="CreatedAt"
                           type="datetime-local"
                           class="form-control"
                           readonly />
                    <span asp-validation-for="CreatedAt" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">🔁 Reopen Status</label>
                    <div class="pt-readonly-field">@(Model.IsReopen ? "REOPEN" : "NORMAL")</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">🔢 Reopen Count</label>
                    <div class="pt-readonly-field">@Model.ReopenCount ครั้ง</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">🛠 Last Fixed</label>
                    <div class="pt-readonly-field">
                        @(Model.LastFixedAt.HasValue ? Model.LastFixedAt.Value.ToString("dd/MM/yyyy HH:mm") : "ยังไม่เคย Fix")
                    </div>
                </div>

                <div class="col-md-8">
                    <label class="form-label fw-semibold">ℹ️ หมายเหตุการนับ Reopen</label>
                    <div class="issue-edit-note">
                        เมื่อเปลี่ยนสถานะจาก FIXED/PASS กลับเป็น OPEN/WIP ระบบจะนับ Reopen ให้อัตโนมัติ
                    </div>
                </div>

                <div class="col-12">
                    <div class="issue-edit-gallery-head">
                        <h3 class="issue-edit-section-title">รูปประกอบก่อนแก้</h3>
                        <span class="issue-edit-count">@beforeImages.Count รูป</span>
                    </div>

                    @if (beforeImages.Any())
                    {
                        <div class="issue-edit-gallery">
                            @foreach (var img in beforeImages)
                            {
                                <div class="issue-edit-image-card">
                                    <a href="@img.FilePath" target="_blank" rel="noopener">
                                        <img src="@img.FilePath" alt="@img.FileName" />
                                    </a>

                                    <div class="issue-edit-delete-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="deleteImageIds"
                                               value="@img.ImageId"
                                               id="del_@img.ImageId" />
                                        <label for="del_@img.ImageId">ลบรูปนี้</label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="issue-edit-empty">ยังไม่มีรูปประกอบก่อนแก้</div>
                    }
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">📎 เพิ่มรูปประกอบ</label>
                    <input type="file"
                           name="newImages"
                           class="form-control"
                           multiple
                           accept="image/*" />
                    <small class="text-muted d-block mt-2">
                        เลือกได้หลายรูป ระบบจะบันทึกเป็นรูปก่อนแก้ของ Issue นี้
                    </small>
                </div>
            </div>

            <div class="pt-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    💾 Save Changes
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.IssueId"
                   class="btn btn-outline-secondary">
                    ดูรายละเอียด
                </a>

                <a asp-action="Index"
                   asp-route-projectId="@Model.ProjectId"
                   class="btn btn-outline-secondary">
                    ↩ Back
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

@model ProjectTracking.Models.ProjectIssue
@using ProjectTracking.Models
@using System.Linq

@{
    ViewData["Title"] = "แก้ไขข้อมูลปัญหาโครงการ";

    var issue = Model ?? new ProjectIssue();
    var beforeImages = issue.Images?.ToList() ?? new List<ProjectIssueImage>();
    var gitHistories = ViewBag.GitHistories as IEnumerable<ProjectIssueGitHistory> ?? new List<ProjectIssueGitHistory>();
    var projectName = (ViewBag.ProjectName as string) ?? issue.Project?.ProjectDisplayName ?? $"Project #{issue.ProjectId}";
    DateTime? startDate = Model?.StartDate;
    DateTime? endDate = Model?.EndDate;

    string ThaiDateText(DateTime? value)
    {
        if (!value.HasValue) return "";
        var year = value.Value.Year;
        while (year > 2200) year -= 543;
        return $"{value.Value:dd/MM/}{year + 543}";
    }

    string startDateText = ThaiDateText(startDate);
    string endDateText = ThaiDateText(endDate);
    string currentIssueStatus = (ViewBag.CurrentIssueStatus as string) ?? issue.IssueStatus ?? "-";
    string currentDevStatus = (ViewBag.CurrentDevStatus as string) ?? issue.DevStatus ?? "-";

    string StatusTone(string? status)
    {
        return (status ?? "").Trim().ToUpperInvariant() switch
        {
            "OPEN" => "status-field--open",
            "PASS" => "status-field--pass",
            "FAIL" => "status-field--fail",
            "REJECT" => "status-field--reject",
            "WIP" => "status-field--wip",
            "FIXED" => "status-field--fixed",
            _ => "status-field--neutral"
        };
    }
}

<style>
    .issue-edit-gallery-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .issue-edit-section-title {
        color: #10233f;
        font-size: 1.05rem;
        font-weight: 900;
        margin: 0;
    }

    .issue-edit-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 5px 12px;
        border-radius: 999px;
        color: #0f766e;
        background: rgba(20, 184, 166, .14);
        font-size: .84rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .issue-edit-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .issue-edit-image-card {
        border: 1px solid #d8e3ef;
        background: #f8fafc;
        border-radius: 14px;
        padding: 8px;
        overflow: hidden;
    }

    .issue-edit-image-card img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 10px;
        display: block;
        transition: transform .15s, box-shadow .15s;
    }

    .issue-edit-image-card a:hover img {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(15, 35, 64, .15);
    }

    .issue-edit-delete-check {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
        color: #be123c;
        font-size: 13px;
        font-weight: 900;
    }

    .issue-edit-empty {
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        color: #64748b;
        background: #f8fafc;
        padding: 18px;
        font-weight: 800;
        text-align: center;
        margin-bottom: 14px;
    }

    .issue-edit-note {
        border-radius: 14px;
        background: #eff6ff;
        color: #1e3a8a;
        padding: 12px 14px;
        font-weight: 700;
        line-height: 1.55;
    }

    .pt-form-card .status-field {
        font-weight: 900 !important;
        transition: background-color .15s ease, border-color .15s ease, color .15s ease;
    }

    .pt-form-card .status-field.status-field--open {
        color: #9a3412 !important;
        background-color: #ffedd5 !important;
        border-color: #fdba74 !important;
    }

    .pt-form-card .status-field.status-field--pass,
    .pt-form-card .status-field.status-field--fixed {
        color: #166534 !important;
        background-color: #dcfce7 !important;
        border-color: #86efac !important;
    }

    .pt-form-card .status-field.status-field--fail {
        color: #be123c !important;
        background-color: #ffe4e6 !important;
        border-color: #fda4af !important;
    }

    .pt-form-card .status-field.status-field--reject {
        color: #334155 !important;
        background-color: #e2e8f0 !important;
        border-color: #94a3b8 !important;
    }

    .pt-form-card .status-field.status-field--wip {
        color: #854d0e !important;
        background-color: #fef3c7 !important;
        border-color: #fde68a !important;
    }

    .pt-form-card .status-field.status-field--neutral {
        color: #475569 !important;
        background-color: #f8fafc !important;
        border-color: #cbd5e1 !important;
    }

    .issue-git-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
        margin-bottom: 0;
    }

    .issue-git-table th {
        padding: 0 10px;
        color: #475569;
        font-size: .9rem;
        font-weight: 700;
    }

    .issue-git-table td {
        padding: 10px;
        color: #10233f;
        background: #f8fafc;
        border-top: 1px solid #dbe8f5;
        border-bottom: 1px solid #dbe8f5;
        font-weight: 700;
    }

    .issue-git-table td:first-child {
        border-left: 1px solid #dbe8f5;
        border-radius: 12px 0 0 12px;
    }

    .issue-git-table td:last-child {
        border-right: 1px solid #dbe8f5;
        border-radius: 0 12px 12px 0;
    }

    .issue-git-badge {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: 4px 10px;
        border-radius: 999px;
        color: #075985;
        background: #e0f2fe;
        font-size: .86rem;
        font-weight: 900;
    }

    .issue-git-id {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        overflow-wrap: anywhere;
    }
</style>

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">แก้ไขข้อมูลปัญหาโครงการ</h2>
        <p class="index-subtitle">Project Issue #@issue.IssueId · @projectName</p>
    </div>

</div>

<div class="card shadow-sm pt-form-card">
    <div class="card-body">
        <form asp-action="Edit"
              asp-route-id="@issue.IssueId"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IssueId" />
            <input type="hidden" asp-for="ProjectId" />
            <input type="hidden" asp-for="DevStatus" />
            <input type="hidden" asp-for="IsReopen" />
            <input type="hidden" asp-for="ReopenCount" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">โครงการ</label>
                    <div class="pt-readonly-field">@projectName</div>
                </div>

                <div class="col-12">
                    <label asp-for="IssueName" class="form-label fw-semibold">หัวข้อปัญหา</label>
                    <input asp-for="IssueName"
                           class="form-control"
                           placeholder="ระบุหัวข้อปัญหา" />
                    <span asp-validation-for="IssueName" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="IssueDetail" class="form-label fw-semibold">รายละเอียดปัญหา</label>
                    <textarea asp-for="IssueDetail"
                              class="form-control"
                              rows="6"
                              placeholder="อธิบายปัญหา เงื่อนไขที่พบ หรือขั้นตอนที่ทำให้เกิดปัญหา"></textarea>
                    <span asp-validation-for="IssueDetail" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="AssignTo" class="form-label fw-semibold">เจ้าของงาน</label>
                    <select asp-for="AssignTo"
                            asp-items="ViewBag.Employees"
                            class="form-select">
                        <option value="">-- เลือกเจ้าของงาน --</option>
                    </select>
                    <span asp-validation-for="AssignTo" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="IssueStatus" class="form-label fw-semibold">สถานะการตรวจ (Tester/BA)</label>
                    <select asp-for="IssueStatus"
                            asp-items="ViewBag.StatusList"
                            class="form-select status-field @StatusTone(issue.IssueStatus)"
                            data-status-tone></select>
                    <span asp-validation-for="IssueStatus" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Dev Status</label>
                    <input type="text"
                           class="form-control status-field @StatusTone(currentDevStatus)"
                           value="@currentDevStatus"
                           readonly />
                </div>

                <div class="col-md-4">
                    <label asp-for="IssuePriority" class="form-label fw-semibold">ความสำคัญ</label>
                    <select asp-for="IssuePriority"
                            class="form-select">
                        <option value="NORMAL">Normal</option>
                        <option value="URGENT">Urgent</option>
                    </select>
                    <span asp-validation-for="IssuePriority" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="StartDate" class="form-label fw-semibold">วันที่เริ่ม</label>
                    <input asp-for="StartDate"
                           type="text"
                           class="form-control thai-date"
                           value="@startDateText"
                           placeholder="วัน/เดือน/พ.ศ."
                           required />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="EndDate" class="form-label fw-semibold">วันที่สิ้นสุด</label>
                    <input asp-for="EndDate"
                           type="text"
                           class="form-control thai-date"
                           value="@endDateText"
                           placeholder="วัน/เดือน/พ.ศ."
                           required />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">สถานะ FAIL</label>
                    <div class="pt-readonly-field">@(issue.ReopenCount > 0 ? "เคย FAIL" : "ยังไม่เคย FAIL")</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">จำนวน FAIL</label>
                    <div class="pt-readonly-field">@issue.ReopenCount ครั้ง</div>
                </div>

                <div class="col-md-8">
                    <label class="form-label fw-semibold">หมายเหตุการนับจำนวน FAIL</label>
                    <div class="issue-edit-note">
                        จำนวน FAIL จะนับเมื่อ Dev ส่งงานเป็น FIXED แล้ว BA ตรวจไม่ผ่านและบันทึกเป็น FAIL โดย Dev Status จะถูกเปลี่ยนกลับเป็น WIP เพื่อให้แก้อีกรอบ
                    </div>
                </div>

                <div class="col-12">
                    <div class="issue-edit-gallery-head">
                        <h3 class="issue-edit-section-title">ประวัติ Git</h3>
                    </div>

                    @if (gitHistories.Any())
                    {
                        <table class="issue-git-table">
                            <thead>
                                <tr>
                                    <th>ประเภท</th>
                                    <th>Git ID</th>
                                    <th>วันที่บันทึก</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in gitHistories)
                                {
                                    <tr>
                                        <td><span class="issue-git-badge">@row.GitType</span></td>
                                        <td class="issue-git-id">@row.GitId</td>
                                        <td>@row.EntryDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="issue-edit-empty">ยังไม่มีประวัติ Git</div>
                    }
                </div>

                <div class="col-12">
                    <div class="issue-edit-gallery-head">
                        <h3 class="issue-edit-section-title">รูปประกอบก่อนแก้</h3>
                        <span class="issue-edit-count">@beforeImages.Count รูป</span>
                    </div>

                    @if (beforeImages.Any())
                    {
                        <div class="issue-edit-gallery">
                            @foreach (var img in beforeImages)
                            {
                                <div class="issue-edit-image-card">
                                    <a href="@img.FilePath" target="_blank" rel="noopener">
                                        <img src="@img.FilePath" alt="@img.FileName" />
                                    </a>

                                    <div class="issue-edit-delete-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="deleteImageIds"
                                               value="@img.ImageId"
                                               id="del_@img.ImageId" />
                                        <label for="del_@img.ImageId">ลบรูปนี้</label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="issue-edit-empty">ยังไม่มีรูปประกอบก่อนแก้</div>
                    }
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">เพิ่มรูปประกอบ</label>
                    <input type="file"
                           name="newImages"
                           class="form-control"
                           multiple
                           accept="image/*"
                           data-paste-image-upload />
                    <small class="text-muted d-block mt-2">
                        เลือกได้หลายรูป หรือ Copy รูป/Screenshot แล้วกด Ctrl+V / Cmd+V เพื่อวาง
                    </small>
                </div>
            </div>

            <div class="pt-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    บันทึก
                </button>

                <a asp-action="Details"
                   asp-route-id="@issue.IssueId"
                   class="btn btn-outline-secondary">
                    ดูรายละเอียด
                </a>

                <a asp-action="Index"
                   asp-route-projectId="@issue.ProjectId"
                   class="btn btn-outline-secondary">
                    กลับ
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/paste-image-upload.js" asp-append-version="true"></script>
    <script>
        function convertThaiDateToIso(value) {
            if (!value || !value.trim()) return '';

            const parts = value.trim().split('/');
            if (parts.length !== 3) return value;

            let [d, m, y] = parts;
            d = d.padStart(2, '0');
            m = m.padStart(2, '0');
            y = parseInt(y, 10);

            while (y > 2200) {
                y -= 543;
            }

            return `${y}-${m}-${d}`;
        }

        function formatThaiDateInput(input) {
            if (!input) return;

            input.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');

                if (value.length > 8) {
                    value = value.substring(0, 8);
                }

                if (value.length >= 5) {
                    value = `${value.substring(0, 2)}/${value.substring(2, 4)}/${value.substring(4)}`;
                } else if (value.length >= 3) {
                    value = `${value.substring(0, 2)}/${value.substring(2)}`;
                }

                e.target.value = value;
            });
        }

        formatThaiDateInput(document.getElementById('StartDate'));
        formatThaiDateInput(document.getElementById('EndDate'));

        const statusToneClasses = [
            'status-field--open',
            'status-field--pass',
            'status-field--fail',
            'status-field--reject',
            'status-field--wip',
            'status-field--fixed',
            'status-field--neutral'
        ];

        function statusToneClass(value) {
            switch ((value || '').trim().toUpperCase()) {
                case 'OPEN': return 'status-field--open';
                case 'PASS': return 'status-field--pass';
                case 'FAIL': return 'status-field--fail';
                case 'REJECT': return 'status-field--reject';
                case 'WIP': return 'status-field--wip';
                case 'FIXED': return 'status-field--fixed';
                default: return 'status-field--neutral';
            }
        }

        function statusToneTargets(select) {
            const wrapper = select?.nextElementSibling?.classList?.contains('pt-search-select')
                ? select.nextElementSibling
                : null;
            return [
                select,
                wrapper?.querySelector('.pt-search-select__input')
            ].filter(Boolean);
        }

        function applyStatusTone(select) {
            if (!select) return;
            const toneClass = statusToneClass(select.value);
            statusToneTargets(select).forEach(target => {
                target.classList.add('status-field');
                target.classList.remove(...statusToneClasses);
                target.classList.add(toneClass);
            });
        }

        function applyAllStatusTones() {
            document.querySelectorAll('[data-status-tone]').forEach(select => applyStatusTone(select));
        }

        document.querySelectorAll('[data-status-tone]').forEach(select => {
            select.addEventListener('change', () => setTimeout(() => applyStatusTone(select), 0));
        });
        applyAllStatusTones();
        setTimeout(applyAllStatusTones, 0);
        setTimeout(applyAllStatusTones, 100);

        new MutationObserver(applyAllStatusTones)
            .observe(document.body, { childList: true, subtree: true });

        document.querySelector('form').addEventListener('submit', function (event) {
            const currentIssueStatus = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentIssueStatus));
            const currentDevStatus = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentDevStatus));
            const devStatus = (document.getElementById('DevStatus')?.value || '').trim().toUpperCase();
            const issueStatus = (document.getElementById('IssueStatus')?.value || '').trim().toUpperCase();

            if (devStatus !== 'FIXED' && (issueStatus === 'PASS' || issueStatus === 'FAIL')) {
                event.preventDefault();
                event.stopImmediatePropagation();
                alert('ไม่สามารถบันทึกสถานะ PASS หรือ FAIL ได้ เนื่องจาก Dev Status ยังไม่เป็น FIXED');
                return;
            }

            const issueStatusText = currentIssueStatus.toUpperCase() === issueStatus
                ? `${issueStatus} (คงเดิม)`
                : `${currentIssueStatus} -> ${issueStatus}`;
            const devStatusText = currentDevStatus.toUpperCase() === devStatus
                ? `${devStatus} (คงเดิม)`
                : `${currentDevStatus} -> ${devStatus}`;

            const confirmed = confirm([
                'กำลังบันทึกการเปลี่ยนแปลงข้อมูล Project Issue',
                `สถานะ Issue: ${issueStatusText}`,
                `Dev Status: ${devStatusText}`,
                'ยืนยันการบันทึกหรือไม่?'
            ].join('\n'));

            if (!confirmed) {
                event.preventDefault();
                event.stopImmediatePropagation();
                return;
            }

            document.querySelectorAll('.thai-date').forEach(input => {
                input.value = convertThaiDateToIso(input.value);
            });
        }, true);
    </script>
}

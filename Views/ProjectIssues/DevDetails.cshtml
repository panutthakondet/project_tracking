@model ProjectTracking.Models.ProjectIssue
@using System.Linq

@{
    ViewData["Title"] = "รายละเอียด Issue (Dev)";

    var issue = Model;
    var beforeImages = issue.Images?.ToList() ?? new List<ProjectTracking.Models.ProjectIssueImage>();
    var afterImages = issue.FixImages?.ToList() ?? new List<ProjectTracking.Models.ProjectIssueFixImage>();
    var gitHistories = ViewBag.GitHistories as IEnumerable<ProjectTracking.Models.ProjectIssueGitHistory>
        ?? new List<ProjectTracking.Models.ProjectIssueGitHistory>();

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string DateOrDash(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "-";

    string StatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "warning",
        "WIP" => "info",
        "FIXED" => "success",
        "PASS" => "success",
        "FAIL" => "danger",
        "REJECT" => "danger",
        _ => "muted"
    };

    string PriorityClass(string? priority) => (priority ?? "").Trim().ToUpperInvariant() switch
    {
        "URGENT" => "danger",
        "HIGH" => "danger",
        "NORMAL" => "info",
        "LOW" => "success",
        _ => "muted"
    };
}

<style>
    .dev-detail-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
    }

    .dev-issue-hero {
        color: #fff;
        background: linear-gradient(135deg, #10233f, #1f3b63);
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 18px 40px rgba(15, 35, 64, .22);
        margin-bottom: 18px;
    }

    .dev-hero-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .dev-hero-main {
        min-width: 0;
        flex: 1 1 auto;
    }

    .dev-eyebrow {
        color: rgba(216, 230, 247, .86);
        font-size: 12px;
        font-weight: 900 !important;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .dev-title {
        margin: 0;
        color: #fff;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 900 !important;
        line-height: 1.22;
    }

    .dev-subtitle {
        max-width: 820px;
        margin: 8px 0 0;
        color: #d8e6f7;
        font-weight: 700;
        line-height: 1.5;
    }

    .dev-hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        width: 100%;
        margin-top: 14px;
    }

    .dev-hero-actions .btn {
        min-width: max-content;
        max-width: 100%;
        min-height: 42px;
        border-radius: 999px !important;
        font-size: .95rem;
        font-weight: 900;
        line-height: 1.25;
        padding: .58rem 1.35rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        white-space: nowrap;
        box-shadow: 0 8px 18px rgba(20, 184, 166, .14);
    }

    .dev-issue-hero .btn-primary {
        color: #062b2f !important;
        background: linear-gradient(135deg, #8df1e4, #23c7c8) !important;
        border-color: transparent !important;
    }

    .dev-issue-hero .btn-outline-light {
        color: #fff !important;
        background: rgba(255,255,255,.08);
        border-color: rgba(255,255,255,.55) !important;
    }

    .dev-issue-hero .btn-outline-light:hover {
        background: rgba(255,255,255,.18) !important;
    }

    .dev-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .dev-summary-card,
    .dev-panel {
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    }

    .dev-summary-card {
        min-height: 92px;
        padding: 14px 16px;
    }

    .dev-summary-card small {
        display: block;
        margin-bottom: 6px;
        color: #000;
        font-size: 12px;
        font-weight: 900 !important;
        text-transform: uppercase;
    }

    .dev-summary-card b {
        color: #000;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.35;
        word-break: break-word;
    }

    .dev-content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 16px;
        margin-bottom: 18px;
    }

    .dev-bottom-stack {
        display: grid;
        gap: 16px;
        margin-bottom: 18px;
    }

    .dev-panel {
        padding: 18px;
    }

    .dev-panel h3 {
        margin: 0 0 12px;
        color: #000;
        font-size: 18px;
        font-weight: 900;
    }

    .dev-info-block {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 18px;
        padding: 14px;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #f8fafc;
    }

    .dev-info-line {
        min-width: 0;
        color: #000;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .dev-info-line .dev-info-label {
        display: inline-block;
        margin-right: 6px;
        color: #000;
        font-size: inherit;
        font-weight: 700;
        line-height: inherit;
        text-transform: uppercase;
    }

    .dev-info-value {
        color: #000;
        font-size: inherit;
        font-weight: 400 !important;
        line-height: inherit;
    }

    .dev-text-box {
        min-height: 150px;
        color: #000;
        font-weight: 400;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 14px;
        line-height: 1.65;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .dev-detail-text-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 12px;
        margin-top: 12px;
    }

    .dev-detail-text-block h4 {
        margin: 0 0 8px;
        color: #000;
        font-size: 14px;
        font-weight: 900;
    }

    .dev-gallery-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .dev-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 5px 12px;
        border-radius: 999px;
        color: #0f766e;
        background: rgba(20, 184, 166, .14);
        font-size: .84rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .dev-gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
    }

    .dev-image-card {
        display: block;
        width: 100%;
        border: 1px solid #d8e3ef;
        border-radius: 14px;
        padding: 8px;
        background: #f8fafc;
        overflow: hidden;
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .dev-image-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(15, 35, 64, .14);
    }

    .dev-image-card img {
        display: block;
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 10px;
    }

    .dev-empty {
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        color: #000;
        background: #f8fafc;
        padding: 18px;
        text-align: center;
        font-weight: 400;
    }

    .dev-git-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

    .dev-git-table th {
        padding: 0 10px;
        color: #475569;
        font-size: .9rem;
        font-weight: 700;
    }

    .dev-git-table td {
        padding: 10px;
        color: #000;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        font-weight: 400;
    }

    .dev-git-table td:first-child {
        border-left: 1px solid #e2e8f0;
        border-radius: 12px 0 0 12px;
    }

    .dev-git-table td:last-child {
        border-right: 1px solid #e2e8f0;
        border-radius: 0 12px 12px 0;
    }

    .dev-git-badge {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: 4px 10px;
        border-radius: 999px;
        color: #075985;
        background: #e0f2fe;
        font-size: .86rem;
        font-weight: 700;
    }

    .dev-git-id {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        overflow-wrap: anywhere;
    }

    .status-text {
        color: #000;
        font-weight: 400 !important;
        font-size: inherit !important;
        white-space: nowrap;
    }

    .status-text.success,
    .status-text.warning,
    .status-text.info,
    .status-text.danger,
    .status-text.muted { color: #000; }

    .dev-detail-page :is(
        .dev-summary-card,
        .dev-summary-label,
        .dev-summary-value,
        .dev-info-line,
        .dev-info-label,
        .dev-info-value,
        .dev-text-box,
        .dev-count,
        .dev-empty
    ) {
        font-size: 1rem !important;
        line-height: 1.45 !important;
        letter-spacing: 0 !important;
    }

    .dev-detail-page :is(
        .dev-summary-label,
        .dev-info-label,
        .dev-panel h3,
        .dev-gallery-head h3,
        .dev-detail-text-block h4
    ) {
        color: #000 !important;
        font-size: 1rem !important;
        font-weight: 700 !important;
        line-height: 1.45 !important;
        letter-spacing: 0 !important;
        text-transform: none !important;
    }

    .dev-summary-label {
        display: block;
        margin-bottom: 6px;
    }

    .dev-detail-page :is(
        .dev-summary-value,
        .dev-info-value,
        .dev-text-box,
        .status-text
    ) {
        color: #000 !important;
        font-size: 1rem !important;
        font-weight: 400 !important;
        line-height: 1.45 !important;
        letter-spacing: 0 !important;
    }

    @@media (max-width: 991.98px) {
        .dev-hero-top,
        .dev-content-grid {
            grid-template-columns: 1fr;
            display: grid;
        }

        .dev-hero-actions {
            justify-content: flex-start;
        }

        .dev-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dev-info-block,
        .dev-detail-text-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .dev-summary-grid {
            grid-template-columns: 1fr;
        }

        .dev-hero-actions .btn {
            min-width: 0;
            width: 100%;
            white-space: normal;
        }
    }
</style>

<div class="dev-detail-page">
    <section class="dev-issue-hero">
        <div class="dev-hero-top">
            <div class="dev-hero-main">
                <div class="dev-eyebrow">Project Issue Dev #@issue.IssueId</div>
                <h1 class="dev-title">รายละเอียดการแก้ไข Issue</h1>
                <p class="dev-subtitle">ตรวจรายละเอียดปัญหา รูปประกอบ และสถานะการแก้ไขของทีมพัฒนา</p>
            </div>

        </div>

        <div class="dev-hero-actions">
            <a asp-action="DevIndex"
               asp-route-projectId="@issue.ProjectId"
               class="btn btn-outline-light">
                ไปหน้า Issue
            </a>
            <a asp-action="DevEdit"
               asp-route-id="@issue.IssueId"
               asp-route-projectId="@issue.ProjectId"
               class="btn btn-primary">
                ไปหน้าแก้ไข
            </a>
        </div>
    </section>

    <section class="dev-summary-grid">
        <div class="dev-summary-card">
            <span class="dev-summary-label">Issue Status</span>
            <span class="dev-summary-value status-text @StatusClass(issue.IssueStatus)">@TextOrDash(issue.IssueStatus)</span>
        </div>
        <div class="dev-summary-card">
            <span class="dev-summary-label">Dev Status</span>
            <span class="dev-summary-value status-text @StatusClass(issue.DevStatus)">@TextOrDash(issue.DevStatus)</span>
        </div>
        <div class="dev-summary-card">
            <span class="dev-summary-label">Images</span>
            <span class="dev-summary-value">@beforeImages.Count ก่อนแก้ / @afterImages.Count หลังแก้</span>
        </div>
    </section>

    <section class="dev-bottom-stack">
        <article class="dev-panel">
            <h3>ข้อมูล Issue</h3>
            <div class="dev-info-block">
                <div class="dev-info-line"><span class="dev-info-label">Project:</span><span class="dev-info-value">@TextOrDash(issue.Project?.ProjectDisplayName)</span></div>
                <div class="dev-info-line"><span class="dev-info-label">Issue:</span><span class="dev-info-value">@TextOrDash(issue.IssueName)</span></div>
                <div class="dev-info-line"><span class="dev-info-label">Owner:</span><span class="dev-info-value">@TextOrDash(issue.Employee?.EmpName)</span></div>
                <div class="dev-info-line"><span class="dev-info-label">Start Date:</span><span class="dev-info-value">@DateOrDash(issue.StartDate)</span></div>
                <div class="dev-info-line"><span class="dev-info-label">End Date:</span><span class="dev-info-value">@DateOrDash(issue.EndDate)</span></div>
                <div class="dev-info-line">
                    <span class="dev-info-label">Priority:</span><span class="dev-info-value status-text @PriorityClass(issue.IssuePriority)">@TextOrDash(issue.IssuePriority)</span>
                </div>
            </div>
        </article>

        <article class="dev-panel">
            <h3>รายละเอียดปัญหา</h3>
            <div class="dev-text-box">@(string.IsNullOrWhiteSpace(issue.IssueDetail) ? "-" : issue.IssueDetail)</div>
        </article>

        <article class="dev-panel">
            <h3>รายละเอียดการแก้ไข</h3>
            <div class="dev-text-box">@(string.IsNullOrWhiteSpace(issue.DevDetail) ? "-" : issue.DevDetail)</div>
        </article>

        <article class="dev-panel">
            <h3>ประวัติ Git</h3>
            @if (gitHistories.Any())
            {
                <table class="dev-git-table">
                    <thead>
                        <tr>
                            <th>ประเภท</th>
                            <th>Git ID</th>
                            <th>วันที่บันทึก</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in gitHistories)
                        {
                            <tr>
                                <td><span class="dev-git-badge">@row.GitType</span></td>
                                <td class="dev-git-id">@row.GitId</td>
                                <td>@row.EntryDate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="dev-empty">ยังไม่มีประวัติ Git</div>
            }
        </article>
    </section>

    <section class="dev-content-grid">
        <article class="dev-panel">
            <div class="dev-gallery-head">
                <h3>รูปก่อนแก้</h3>
                <span class="dev-count">@beforeImages.Count รูป</span>
            </div>

            @if (beforeImages.Count > 0)
            {
                <div class="dev-gallery-grid">
                    @foreach (var img in beforeImages)
                    {
                        <button type="button"
                                class="dev-image-card"
                                onclick="previewDevImage('@img.FilePath')"
                                aria-label="ดูรูปก่อนแก้">
                            <img src="@img.FilePath" alt="Issue image before fix" />
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="dev-empty">ไม่มีรูปก่อนแก้</div>
            }
        </article>

        <article class="dev-panel">
            <div class="dev-gallery-head">
                <h3>รูปหลังแก้</h3>
                <span class="dev-count">@afterImages.Count รูป</span>
            </div>

            @if (afterImages.Count > 0)
            {
                <div class="dev-gallery-grid">
                    @foreach (var img in afterImages)
                    {
                        <button type="button"
                                class="dev-image-card"
                                onclick="previewDevImage('@img.FilePath')"
                                aria-label="ดูรูปหลังแก้">
                            <img src="@img.FilePath" alt="Issue image after fix" />
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="dev-empty">ไม่มีรูปหลังแก้</div>
            }
        </article>
    </section>
</div>

<div class="modal fade" id="devImagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark">
            <div class="modal-body text-center p-2">
                <img id="devPreviewImage" src="" class="img-fluid rounded" alt="preview" />
            </div>
        </div>
    </div>
</div>

<script>
function prepareDevImagePreviewModal(modalId) {
    const modalEl = document.getElementById(modalId);
    if (!modalEl) return null;

    if (modalEl.parentElement !== document.body) {
        document.body.appendChild(modalEl);
    }

    document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
    document.body.classList.remove('modal-open');
    document.body.style.removeProperty('overflow');
    document.body.style.removeProperty('padding-right');

    modalEl.style.zIndex = '26010';
    return modalEl;
}

function previewDevImage(src) {
    const img = document.getElementById("devPreviewImage");
    img.src = src;

    const modalEl = prepareDevImagePreviewModal("devImagePreviewModal");
    if (!modalEl) return;

    const modal = bootstrap.Modal.getOrCreateInstance(modalEl, {
        backdrop: true,
        keyboard: true
    });
    modal.show();

    window.setTimeout(function () {
        modalEl.style.zIndex = '26010';
        document.querySelectorAll('.modal-backdrop').forEach(function (backdrop) {
            backdrop.style.zIndex = '26000';
        });
    }, 0);
}
</script>

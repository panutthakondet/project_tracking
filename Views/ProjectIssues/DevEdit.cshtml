@using Microsoft.AspNetCore.Mvc.Rendering
@using ProjectTracking.Models
@using System.Collections.Generic
@using System.Linq
@model ProjectTracking.Models.ProjectIssue

@{
    ViewData["Title"] = "อัปเดตการแก้ไขปัญหา";

    var devStatusItems = ViewBag.DevStatusList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var fixImages = Model.FixImages?.ToList() ?? new List<ProjectIssueFixImage>();
    var projectName = Model.Project?.ProjectDisplayName ?? $"Project #{Model.ProjectId}";

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string DateOrDash(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "-";

    string StatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "warning",
        "WIP" => "info",
        "FIXED" => "success",
        "PASS" => "success",
        "FAIL" => "danger",
        "REJECT" => "danger",
        _ => "muted"
    };
}

<style>
    .dev-edit-gallery-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .dev-edit-section-title {
        color: #10233f;
        font-size: 1.05rem;
        font-weight: 900;
        margin: 0;
    }

    .dev-edit-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 5px 12px;
        border-radius: 999px;
        color: #0f766e;
        background: rgba(20, 184, 166, .14);
        font-size: .84rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .dev-edit-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .dev-edit-image-card {
        border: 1px solid #d8e3ef;
        background: #f8fafc;
        border-radius: 14px;
        padding: 8px;
        overflow: hidden;
    }

    .dev-edit-image-card img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 10px;
        display: block;
        transition: transform .15s, box-shadow .15s;
    }

    .dev-edit-image-card a:hover img {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(15, 35, 64, .15);
    }

    .dev-edit-delete-check {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
        color: #be123c;
        font-size: 13px;
        font-weight: 900;
    }

    .dev-edit-empty {
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        color: #64748b;
        background: #f8fafc;
        padding: 18px;
        font-weight: 800;
        text-align: center;
        margin-bottom: 14px;
    }

    .dev-edit-note {
        border-radius: 14px;
        background: #eff6ff;
        color: #1e3a8a;
        padding: 12px 14px;
        font-weight: 700;
        line-height: 1.55;
    }

    .dev-status-text {
        font-weight: 900;
        white-space: nowrap;
    }

    .dev-edit-status-field {
        min-height: 52px;
        padding: .72rem .9rem;
        align-items: center;
        line-height: 1.35;
    }

    .pt-search-select__input {
        height: 52px;
        padding-top: .72rem !important;
        padding-bottom: .72rem !important;
        line-height: 1.35;
    }

    .dev-status-text.success { color: #0f8f5f; }
    .dev-status-text.warning { color: #b7790b; }
    .dev-status-text.info { color: #0f6fa8; }
    .dev-status-text.danger { color: #d6294f; }
    .dev-status-text.muted { color: #64748b; }
</style>

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">อัปเดตการแก้ไขปัญหา</h2>
        <p class="index-subtitle">Project Issue Dev #@Model.IssueId · @projectName</p>
    </div>
</div>

<div class="card shadow-sm pt-form-card">
    <div class="card-body">
        <form asp-action="DevEdit"
              asp-route-id="@Model.IssueId"
              method="post"
              enctype="multipart/form-data"
              onsubmit="return confirm('บันทึกการอัปเดต Dev Issue นี้หรือไม่?');">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IssueId" />
            <input type="hidden" asp-for="ProjectId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">📁 Project</label>
                    <div class="pt-readonly-field">@projectName</div>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">หัวข้อปัญหา</label>
                    <div class="pt-readonly-field">@TextOrDash(Model.IssueName)</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">👤 เจ้าของงาน</label>
                    <div class="pt-readonly-field">@TextOrDash(Model.Employee?.EmpName)</div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">📅 วันที่เริ่ม</label>
                    <div class="pt-readonly-field">@DateOrDash(Model.StartDate)</div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">🏁 วันที่สิ้นสุด</label>
                    <div class="pt-readonly-field">@DateOrDash(Model.EndDate)</div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">📌 สถานะ Issue</label>
                    <div class="pt-readonly-field dev-edit-status-field">
                        <span class="dev-status-text @StatusClass(Model.IssueStatus)">@TextOrDash(Model.IssueStatus)</span>
                    </div>
                </div>

                <div class="col-md-4">
                    <label asp-for="DevStatus" class="form-label fw-semibold">🧑‍💻 สถานะการแก้ไข (Programmer)</label>
                    <select asp-for="DevStatus"
                            asp-items="devStatusItems"
                            class="form-select"
                            data-placeholder="🔍 พิมพ์ค้นหา Dev Status...">
                        <option value="">-- เลือกสถานะการแก้ไข --</option>
                    </select>
                    <span asp-validation-for="DevStatus" class="text-danger"></span>
                </div>

                <div class="col-md-8">
                    <label class="form-label fw-semibold">ℹ️ หมายเหตุ</label>
                    <div class="dev-edit-note">
                        โปรแกรมเมอร์ใช้ WIP เมื่อลงมือแก้ และ FIXED เมื่อแก้เสร็จเพื่อส่งกลับให้ BA/Tester ตรวจ
                    </div>
                </div>

                <div class="col-12">
                    <label asp-for="DevDetail" class="form-label fw-semibold">รายละเอียดการแก้ไข</label>
                    <textarea asp-for="DevDetail"
                              class="form-control"
                              rows="6"
                              placeholder="อธิบายวิธีแก้ไข ผลลัพธ์ หรือสิ่งที่ต้องตรวจต่อ"></textarea>
                    <span asp-validation-for="DevDetail" class="text-danger"></span>
                    <small class="text-muted d-block mt-2">รายละเอียดการแก้ไขของโปรแกรมเมอร์</small>
                </div>

                <div class="col-12">
                    <div class="dev-edit-gallery-head">
                        <h3 class="dev-edit-section-title">รูปประกอบหลังแก้</h3>
                        <span class="dev-edit-count">@fixImages.Count รูป</span>
                    </div>

                    @if (fixImages.Any())
                    {
                        <div class="dev-edit-gallery">
                            @foreach (var img in fixImages)
                            {
                                <div class="dev-edit-image-card">
                                    <a href="@img.FilePath" target="_blank" rel="noopener">
                                        <img src="@img.FilePath" alt="@img.FileName" />
                                    </a>

                                    <div class="dev-edit-delete-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="deleteFixImageIds"
                                               value="@img.ImageId"
                                               id="fixdel_@img.ImageId" />
                                        <label for="fixdel_@img.ImageId">ลบรูปนี้</label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dev-edit-empty">ยังไม่มีรูปประกอบหลังแก้</div>
                    }
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">📎 เพิ่มรูปหลังแก้</label>
                    <input type="file"
                           name="afterImages"
                           class="form-control"
                           multiple
                           accept="image/*" />
                    <small class="text-muted d-block mt-2">
                        เลือกได้หลายรูป ระบบจะบันทึกเป็นรูปหลังแก้ของ Issue นี้
                    </small>
                </div>
            </div>

            <div class="pt-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    💾 Save Changes
                </button>

                <a asp-action="DevDetails"
                   asp-route-id="@Model.IssueId"
                   class="btn btn-outline-secondary">
                    ดูรายละเอียด
                </a>

                <a asp-action="DevIndex"
                   asp-route-projectId="@Model.ProjectId"
                   class="btn btn-outline-secondary">
                    ↩ Back
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

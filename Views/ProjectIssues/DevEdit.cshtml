@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Collections.Generic
@model ProjectTracking.Models.ProjectIssue

@{
    ViewData["Title"] = "Dev Update Issue";
    var devStatusItems = ViewBag.DevStatusList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var fixImages = Model.FixImages?.ToList() ?? new List<ProjectTracking.Models.ProjectIssueFixImage>();
}

<style>
    .dev-edit-page {
        max-width: 1180px;
        margin: 0 auto;
    }

    .dev-edit-hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        color: #fff;
        background:
            radial-gradient(circle at 88% 10%, rgba(20, 184, 166, .28), transparent 28%),
            linear-gradient(135deg, #10233f, #1f3b63);
        border-radius: 22px;
        padding: 22px 24px;
        margin-bottom: 18px;
        box-shadow: 0 18px 40px rgba(15, 35, 64, .18);
    }

    .dev-edit-title {
        margin: 0;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 900;
        line-height: 1.25;
    }

    .dev-edit-subtitle {
        color: #d8e6f7;
        font-weight: 700;
        margin: 8px 0 0;
        word-break: break-word;
    }

    .dev-edit-grid {
        display: grid;
        grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
        gap: 16px;
        align-items: start;
    }

    .dev-edit-panel {
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
        padding: 18px;
    }

    .dev-edit-panel + .dev-edit-panel {
        margin-top: 16px;
    }

    .dev-edit-panel h3 {
        color: #10233f;
        font-size: 18px;
        font-weight: 900;
        margin: 0 0 12px;
    }

    .dev-readonly {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 12px 14px;
        color: #10233f;
        font-weight: 800;
        line-height: 1.45;
        word-break: break-word;
        min-height: 48px;
    }

    .dev-image-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .dev-image-card {
        border: 1px solid #d8e3ef;
        background: #f8fafc;
        border-radius: 14px;
        padding: 8px;
    }

    .dev-image-card img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 10px;
        display: block;
    }

    .dev-delete-check {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
        color: #be123c;
        font-size: 13px;
        font-weight: 900;
    }

    .dev-empty {
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        color: #64748b;
        background: #f8fafc;
        padding: 18px;
        text-align: center;
        font-weight: 800;
        margin-bottom: 14px;
    }

    .dev-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 18px;
    }

    .dev-actions .btn {
        border-radius: 12px;
        font-weight: 900;
        padding-inline: 18px;
    }

    @@media (max-width: 991.98px) {
        .dev-edit-hero,
        .dev-edit-grid {
            grid-template-columns: 1fr;
            display: grid;
        }
    }
</style>

<div class="dev-edit-page">
    <div class="dev-edit-hero">
        <div>
            <h2 class="dev-edit-title">Dev Update Issue</h2>
            <p class="dev-edit-subtitle">@Model.IssueName</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="DevDetails" asp-route-id="@Model.IssueId" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-light">รายละเอียด</a>
            <a asp-action="DevIndex" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-light">Back</a>
        </div>
    </div>

    <div class="dev-edit-grid">
        <div>
            <div class="dev-edit-panel">
                <h3>ข้อมูล Issue</h3>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Issue</label>
                    <div class="dev-readonly">@Model.IssueName</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Project</label>
                    <div class="dev-readonly">@(Model.Project?.ProjectName ?? "-")</div>
                </div>

                <div>
                    <label class="form-label fw-semibold">แจ้งโดย</label>
                    <div class="dev-readonly">@(Model.Employee?.EmpName ?? "-")</div>
                </div>
            </div>

            <div class="dev-edit-panel">
                <h3>สถานะล่าสุด</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Issue Status</label>
                        <div class="dev-readonly">@Model.IssueStatus</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Last Fixed At</label>
                        <div class="dev-readonly">@(Model.LastFixedAt.HasValue ? Model.LastFixedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="dev-edit-panel">
            <h3>อัปเดตการแก้ไข</h3>

            <form asp-action="DevEdit" asp-route-id="@Model.IssueId" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IssueId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Dev Status</label>
                    <select asp-for="DevStatus" class="form-select" asp-items="devStatusItems" required></select>
                    <small class="text-muted">ระบบจะตั้ง Last Fixed At อัตโนมัติเมื่อเลือก FIXED</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Dev Detail</label>
                    <textarea asp-for="DevDetail"
                              class="form-control"
                              rows="5"
                              placeholder="อธิบายวิธีแก้ไข ผลลัพธ์ หรือสิ่งที่ต้องตรวจต่อ"></textarea>
                    <small class="text-muted">รายละเอียดการแก้ไขของโปรแกรมเมอร์</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">รูปหลังแก้ (@fixImages.Count)</label>

                    @if (fixImages.Any())
                    {
                        <div class="dev-image-grid">
                            @foreach (var img in fixImages)
                            {
                                <div class="dev-image-card">
                                    <a href="@img.FilePath" target="_blank" rel="noopener">
                                        <img src="@img.FilePath" alt="@img.FileName" />
                                    </a>
                                    <div class="dev-delete-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="deleteFixImageIds"
                                               value="@img.ImageId"
                                               id="fixdel_@img.ImageId" />
                                        <label for="fixdel_@img.ImageId">ลบรูปนี้</label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dev-empty">ยังไม่มีรูปหลังแก้</div>
                    }

                    <input type="file" name="afterImages" class="form-control" multiple accept="image/*" />
                    <small class="text-muted">อัปโหลดภาพผลลัพธ์หลังจากแก้ไข Issue ได้หลายรูป</small>
                </div>

                <div class="dev-actions">
                    <a asp-action="DevIndex" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-secondary">Back</a>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

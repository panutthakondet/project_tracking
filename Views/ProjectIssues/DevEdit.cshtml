@using Microsoft.AspNetCore.Mvc.Rendering
@using ProjectTracking.Models
@using System.Collections.Generic
@using System.Linq
@model ProjectTracking.Models.ProjectIssue

@{
    ViewData["Title"] = "อัปเดตการแก้ไขปัญหา";

    var devStatusItems = ViewBag.DevStatusList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var fixImages = Model.FixImages?.ToList() ?? new List<ProjectIssueFixImage>();
    var projectName = Model.Project?.ProjectDisplayName ?? $"Project #{Model.ProjectId}";
    var currentDevStatus = (ViewBag.CurrentDevStatus as string) ?? Model.DevStatus ?? "-";

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string DateOrDash(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "-";

    string StatusTone(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "status-field--open",
        "WIP" => "status-field--wip",
        "FIXED" => "status-field--fixed",
        "PASS" => "status-field--pass",
        "FAIL" => "status-field--fail",
        "REJECT" => "status-field--reject",
        _ => "status-field--neutral"
    };
}

<style>
    .dev-edit-gallery-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .dev-edit-section-title {
        color: #10233f;
        font-size: 1.05rem;
        font-weight: 900;
        margin: 0;
    }

    .dev-edit-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 5px 12px;
        border-radius: 999px;
        color: #0f766e;
        background: rgba(20, 184, 166, .14);
        font-size: .84rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .dev-edit-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .dev-edit-image-card {
        border: 1px solid #d8e3ef;
        background: #f8fafc;
        border-radius: 14px;
        padding: 8px;
        overflow: hidden;
    }

    .dev-edit-image-card img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 10px;
        display: block;
        transition: transform .15s, box-shadow .15s;
    }

    .dev-edit-image-card a:hover img {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(15, 35, 64, .15);
    }

    .dev-edit-delete-check {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
        color: #be123c;
        font-size: 13px;
        font-weight: 900;
    }

    .dev-edit-empty {
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        color: #64748b;
        background: #f8fafc;
        padding: 18px;
        font-weight: 800;
        text-align: center;
        margin-bottom: 14px;
    }

    .dev-edit-note {
        border-radius: 14px;
        background: #eff6ff;
        color: #1e3a8a;
        padding: 12px 14px;
        font-weight: 700;
        line-height: 1.55;
    }

    .dev-edit-status-field {
        min-height: 52px;
        padding: .72rem .9rem;
        align-items: center;
        line-height: 1.35;
    }

    .pt-search-select__input {
        height: 52px;
        padding-top: .72rem !important;
        padding-bottom: .72rem !important;
        line-height: 1.35;
    }

    .pt-form-card .status-field {
        font-weight: 900 !important;
        transition: background-color .15s ease, border-color .15s ease, color .15s ease;
    }

    .pt-form-card .status-field.status-field--open {
        color: #9a3412 !important;
        background-color: #ffedd5 !important;
        border-color: #fdba74 !important;
    }

    .pt-form-card .status-field.status-field--pass,
    .pt-form-card .status-field.status-field--fixed {
        color: #166534 !important;
        background-color: #dcfce7 !important;
        border-color: #86efac !important;
    }

    .pt-form-card .status-field.status-field--fail {
        color: #be123c !important;
        background-color: #ffe4e6 !important;
        border-color: #fda4af !important;
    }

    .pt-form-card .status-field.status-field--reject {
        color: #334155 !important;
        background-color: #e2e8f0 !important;
        border-color: #94a3b8 !important;
    }

    .pt-form-card .status-field.status-field--wip {
        color: #854d0e !important;
        background-color: #fef3c7 !important;
        border-color: #fde68a !important;
    }

    .pt-form-card .status-field.status-field--neutral {
        color: #475569 !important;
        background-color: #f8fafc !important;
        border-color: #cbd5e1 !important;
    }
</style>

<div class="index-hero pt-form-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">อัปเดตการแก้ไขปัญหา</h2>
        <p class="index-subtitle">Project Issue Dev #@Model.IssueId · @projectName</p>
    </div>
</div>

<div class="card shadow-sm pt-form-card">
    <div class="card-body">
        <form asp-action="DevEdit"
              asp-route-id="@Model.IssueId"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IssueId" />
            <input type="hidden" asp-for="ProjectId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">📁 Project</label>
                    <div class="pt-readonly-field">@projectName</div>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">หัวข้อปัญหา</label>
                    <div class="pt-readonly-field">@TextOrDash(Model.IssueName)</div>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">รายละเอียดปัญหา</label>
                    <div class="pt-readonly-field">@TextOrDash(Model.IssueDetail)</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">👤 เจ้าของงาน</label>
                    <div class="pt-readonly-field">@TextOrDash(Model.Employee?.EmpName)</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">📌 สถานะ Issue</label>
                    <div class="pt-readonly-field status-field @StatusTone(Model.IssueStatus)">
                        @TextOrDash(Model.IssueStatus)
                    </div>
                </div>

                <div class="col-md-4">
                    <label asp-for="DevStatus" class="form-label fw-semibold">🧑‍💻 สถานะการแก้ไข (Programmer)</label>
                    <select asp-for="DevStatus"
                            asp-items="devStatusItems"
                            class="form-select dev-edit-status-field status-field @StatusTone(Model.DevStatus)"
                            data-status-tone></select>
                    <span asp-validation-for="DevStatus" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">📅 วันที่เริ่ม</label>
                    <div class="pt-readonly-field">@DateOrDash(Model.StartDate)</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">🏁 วันที่สิ้นสุด</label>
                    <div class="pt-readonly-field">@DateOrDash(Model.EndDate)</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">ℹ️ หมายเหตุ</label>
                    <div class="dev-edit-note">
                        เลือก FIXED เพื่อส่งกลับให้ BA/Tester ตรวจ
                    </div>
                </div>

                <div class="col-12">
                    <label asp-for="DevDetail" class="form-label fw-semibold">รายละเอียดการแก้ไข</label>
                    <textarea asp-for="DevDetail"
                              class="form-control"
                              rows="6"
                              placeholder="อธิบายวิธีแก้ไข ผลลัพธ์ หรือสิ่งที่ต้องตรวจต่อ"></textarea>
                    <span asp-validation-for="DevDetail" class="text-danger"></span>
                    <small class="text-muted d-block mt-2">รายละเอียดการแก้ไขของโปรแกรมเมอร์</small>
                </div>

                <div class="col-12">
                    <div class="dev-edit-gallery-head">
                        <h3 class="dev-edit-section-title">รูปประกอบหลังแก้</h3>
                        <span class="dev-edit-count">@fixImages.Count รูป</span>
                    </div>

                    @if (fixImages.Any())
                    {
                        <div class="dev-edit-gallery">
                            @foreach (var img in fixImages)
                            {
                                <div class="dev-edit-image-card">
                                    <a href="@img.FilePath" target="_blank" rel="noopener">
                                        <img src="@img.FilePath" alt="@img.FileName" />
                                    </a>

                                    <div class="dev-edit-delete-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="deleteFixImageIds"
                                               value="@img.ImageId"
                                               id="fixdel_@img.ImageId" />
                                        <label for="fixdel_@img.ImageId">ลบรูปนี้</label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dev-edit-empty">ยังไม่มีรูปประกอบหลังแก้</div>
                    }
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">📎 เพิ่มรูปหลังแก้</label>
                    <input type="file"
                           name="afterImages"
                           class="form-control"
                           multiple
                           accept="image/*"
                           data-paste-image-upload />
                    <small class="text-muted d-block mt-2">
                        เลือกได้หลายรูป หรือ Copy รูป/Screenshot แล้วกด Ctrl+V / Cmd+V เพื่อวาง
                    </small>
                </div>
            </div>

            <div class="pt-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    💾 Save Changes
                </button>

                <a asp-action="DevDetails"
                   asp-route-id="@Model.IssueId"
                   class="btn btn-outline-secondary">
                    ดูรายละเอียด
                </a>

                <a asp-action="DevIndex"
                   asp-route-projectId="@Model.ProjectId"
                   class="btn btn-outline-secondary">
                    ↩ Back
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/paste-image-upload.js" asp-append-version="true"></script>
    <script>
        const statusToneClasses = [
            'status-field--open',
            'status-field--pass',
            'status-field--fail',
            'status-field--reject',
            'status-field--wip',
            'status-field--fixed',
            'status-field--neutral'
        ];

        function statusToneClass(value) {
            switch ((value || '').trim().toUpperCase()) {
                case 'OPEN': return 'status-field--open';
                case 'PASS': return 'status-field--pass';
                case 'FAIL': return 'status-field--fail';
                case 'REJECT': return 'status-field--reject';
                case 'WIP': return 'status-field--wip';
                case 'FIXED': return 'status-field--fixed';
                default: return 'status-field--neutral';
            }
        }

        function statusToneTargets(select) {
            const wrapper = select?.nextElementSibling?.classList?.contains('pt-search-select')
                ? select.nextElementSibling
                : null;
            return [
                select,
                wrapper?.querySelector('.pt-search-select__input')
            ].filter(Boolean);
        }

        function applyStatusTone(select) {
            if (!select) return;
            const toneClass = statusToneClass(select.value);
            statusToneTargets(select).forEach(target => {
                target.classList.add('status-field');
                target.classList.remove(...statusToneClasses);
                target.classList.add(toneClass);
            });
        }

        function applyAllStatusTones() {
            document.querySelectorAll('[data-status-tone]').forEach(select => applyStatusTone(select));
        }

        document.querySelectorAll('[data-status-tone]').forEach(select => {
            select.addEventListener('change', () => setTimeout(() => applyStatusTone(select), 0));
        });
        applyAllStatusTones();
        setTimeout(applyAllStatusTones, 0);
        setTimeout(applyAllStatusTones, 100);

        new MutationObserver(applyAllStatusTones)
            .observe(document.body, { childList: true, subtree: true });

        document.querySelector('form').addEventListener('submit', function (event) {
            const currentDevStatus = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentDevStatus));
            const nextDevStatus = (document.getElementById('DevStatus')?.value || '').trim().toUpperCase();
            if (nextDevStatus === 'WIP') {
                event.preventDefault();
                event.stopImmediatePropagation();
                alert('ไม่สามารถบันทึกสถานะ WIP ได้ กรุณาเลือก FIXED เมื่อแก้ไขเสร็จ');
                return;
            }

            const devStatusText = currentDevStatus.toUpperCase() === nextDevStatus
                ? `${nextDevStatus} (คงเดิม)`
                : `${currentDevStatus} -> ${nextDevStatus}`;

            const confirmed = confirm([
                'กำลังบันทึกการเปลี่ยนแปลงข้อมูล Project Issue Dev',
                `Dev Status: ${devStatusText}`,
                'ยืนยันการบันทึกหรือไม่?'
            ].join('\n'));

            if (!confirmed) {
                event.preventDefault();
                event.stopImmediatePropagation();
            }
        }, true);
    </script>
}

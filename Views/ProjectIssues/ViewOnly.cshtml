@model IEnumerable<ProjectTracking.Models.ProjectIssue>
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = null;
    var th = new CultureInfo("th-TH");
    var selectedProject = ViewBag.SelectedProject as ProjectTracking.Models.Project;
    var selectedBA = ViewBag.SelectedBA is int baId ? baId : (int?)null;
    var selectedEmp = ViewBag.SelectedEmp as string;
    var selectedStatus = ViewBag.SelectedStatus as string ?? "";
    var selectedDevStatus = ViewBag.SelectedDevStatus as string ?? "";
    var baList = ViewBag.BAList as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var empList = ViewBag.EmpList as IEnumerable<string> ?? Enumerable.Empty<string>();
    var statusList = ViewBag.StatusList as IEnumerable<string> ?? Enumerable.Empty<string>();
    var devStatusList = ViewBag.DevStatusList as IEnumerable<string> ?? Enumerable.Empty<string>();
    var projects = ViewBag.Projects as IEnumerable<ProjectTracking.Models.Project> ?? Enumerable.Empty<ProjectTracking.Models.Project>();
    var issues = (Model ?? Enumerable.Empty<ProjectTracking.Models.ProjectIssue>()).ToList();
    var coopList = projects
        .Select(x => x.Coop?.CoopName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    var totalIssues = issues.Count;
    var openCount = issues.Count(x => string.Equals(x.IssueStatus, "OPEN", StringComparison.OrdinalIgnoreCase));
    var devWipCount = issues.Count(x =>
        string.Equals(x.DevStatus, "WIP", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(x.IssueStatus, "PASS", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(x.IssueStatus, "REJECT", StringComparison.OrdinalIgnoreCase));
    var waitBaCount = issues.Count(x =>
        string.Equals(x.DevStatus, "FIXED", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(x.IssueStatus, "PASS", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(x.IssueStatus, "REJECT", StringComparison.OrdinalIgnoreCase));
    var passCount = issues.Count(x => string.Equals(x.IssueStatus, "PASS", StringComparison.OrdinalIgnoreCase));
    var urgentCount = issues.Count(x => string.Equals(x.IssuePriority, "URGENT", StringComparison.OrdinalIgnoreCase));
    var totalReopen = issues.Sum(x => x.ReopenCount);

    string StatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "warning",
        "WIP" => "info",
        "FIXED" => "success",
        "PASS" => "success",
        "FAIL" => "danger",
        "REJECT" => "muted",
        _ => "muted"
    };

    string DevStatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "WIP" => "info",
        "FIXED" => "success",
        _ => "muted"
    };

    string PriorityClass(string? priority) => string.Equals(priority, "URGENT", StringComparison.OrdinalIgnoreCase)
        ? "danger"
        : "muted";

    string PriorityText(string? priority) => string.Equals(priority, "URGENT", StringComparison.OrdinalIgnoreCase)
        ? "URGENT"
        : "NORMAL";
    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string DateText(DateTime? value) => value?.ToString("dd/MM/yyyy", th) ?? "-";
    string SelectedBAText()
    {
        if (!selectedBA.HasValue) return "All BA";
        return baList.FirstOrDefault(x => x.Value == selectedBA.Value.ToString())?.Text ?? $"BA #{selectedBA.Value}";
    }
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>Project Issues Report</title>
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&display=swap");
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 16px;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 11px;
        }
        .report-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 12px;
        }
        .report-btn {
            min-height: 34px;
            padding: 7px 13px;
            border: 1px solid #102443;
            border-radius: 999px;
            color: #102443;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 900;
            line-height: 1.1;
            text-decoration: none;
            cursor: pointer;
        }
        .report-btn.primary {
            color: #fff;
            background: #102443;
        }
        .print-header {
            margin-bottom: 12px;
            padding: 14px 16px;
            color: #fff;
            background: #102443;
        }
        .print-header h1 {
            margin: 0 0 6px;
            font-size: 22px;
        }
        .print-header div {
            color: rgba(255,255,255,.82);
            font-weight: 700;
            line-height: 1.55;
        }
        .filter-panel {
            display: grid;
            grid-template-columns: minmax(260px, 1.35fr) minmax(190px, .9fr) minmax(210px, 1fr) minmax(150px, .7fr) minmax(150px, .7fr) auto;
            align-items: end;
            gap: 10px;
            margin-bottom: 12px;
            padding: 12px;
            border: 1px solid #d8e3ef;
            background: #f8fbff;
        }
        .field label {
            display: block;
            margin-bottom: 5px;
            color: #64748b;
            font-weight: 900;
        }
        .field select {
            width: 100%;
            min-height: 34px;
            padding: 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
        }
        .pt-native-select-hidden {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            min-height: 1px !important;
            opacity: 0 !important;
            pointer-events: none !important;
            clip-path: inset(50%) !important;
        }
        .pt-search-select {
            position: relative;
            width: 100%;
        }
        .pt-search-select__field {
            position: relative;
        }
        .pt-search-select__input {
            width: 100%;
            min-height: 34px;
            padding: 7px 38px 7px 10px;
            border: 1px solid #cbd5e1;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            outline: none;
        }
        .pt-search-select__input:focus {
            border-color: #14b8a6;
            box-shadow: 0 0 0 3px rgba(20, 184, 166, .12);
        }
        .pt-search-select__input:disabled {
            color: #94a3b8;
            background: #f1f5f9;
        }
        .pt-search-select__dropdown {
            position: absolute;
            left: 0;
            right: 0;
            top: calc(100% + 4px);
            z-index: 10;
            width: 100%;
            max-height: 240px;
            overflow-y: auto;
            display: none;
            border: 1px solid #d8e2ef;
            background: #fff;
            box-shadow: 0 12px 26px rgba(15, 35, 64, .14);
        }
        .pt-search-select.is-open .pt-search-select__dropdown {
            display: block;
        }
        .pt-search-select__option {
            width: 100%;
            padding: 8px 10px;
            border: 0;
            color: #10233f;
            background: #fff;
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.35;
            text-align: left;
            cursor: pointer;
        }
        .pt-search-select__option:hover,
        .pt-search-select__option.is-selected {
            color: #062b2f;
            background: rgba(20, 184, 166, .14);
        }
        .pt-search-select__empty {
            padding: 10px;
            color: #64748b;
            font-weight: 800;
            text-align: center;
        }
        .filter-submit {
            width: auto;
            min-width: 88px;
            justify-self: start;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 8px;
            margin-bottom: 12px;
        }
        .kpi {
            padding: 10px;
            border: 1px solid #d8e3ef;
            border-left: 4px solid #14b8a6;
        }
        .kpi.info { border-left-color: #258cfb; }
        .kpi.warning { border-left-color: #f59e0b; }
        .kpi.danger { border-left-color: #f43f5e; }
        .kpi span,
        .kpi small {
            display: block;
            color: #64748b;
            font-weight: 800;
        }
        .kpi strong {
            display: block;
            margin: 5px 0;
            color: #10233f;
            font-size: 20px;
            font-weight: 900;
        }
        h2 {
            margin: 14px 0 8px;
            color: #10233f;
            font-size: 16px;
            font-weight: 900;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin-bottom: 12px;
        }
        .issue-report-table col.col-seq { width: 5%; }
        .issue-report-table col.col-issue { width: 25%; }
        .issue-report-table col.col-detail { width: 27%; }
        .issue-report-table col.col-owner { width: 14%; }
        .issue-report-table col.col-state { width: 15%; }
        .issue-report-table col.col-date { width: 14%; }
        th {
            padding: 7px 6px;
            color: #fff;
            background: #102443;
            border: 1px solid rgba(255,255,255,.18);
            font-weight: 900;
            text-align: center;
        }
        td {
            padding: 7px 6px;
            border: 1px solid #d8e3ef;
            line-height: 1.45;
            vertical-align: top;
            overflow-wrap: anywhere;
        }
        tr:nth-child(even) td { background: #f8fbff; }
        .text-center { text-align: center; }
        .project-group-row td {
            padding: 8px 10px;
            color: #10233f;
            background: transparent !important;
            border-color: #d8e3ef;
            border-top: 2px solid #102443;
            font-size: 12px;
            font-weight: 900;
        }
        .project-group-name {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }
        .project-group-label {
            color: #0f766e;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: .05em;
            text-transform: uppercase;
        }
        .project-group-count {
            flex: 0 0 auto;
            color: #64748b;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }
        .project-group-stats {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 12px;
            margin-top: 5px;
            color: #475569;
            font-size: 10px;
            font-weight: 800;
        }
        .project-group-stats b {
            color: #0f766e;
            font-weight: 900;
        }
        .cell-title {
            color: #10233f;
            font-weight: 900;
        }
        .cell-sub {
            margin-top: 4px;
            color: #465a73;
            font-weight: 700;
        }
        .detail-block {
            display: grid;
            gap: 6px;
        }
        .detail-block div {
            padding: 6px 7px;
            border-radius: 8px;
            background: #f8fbff;
            border: 1px solid #e6edf6;
        }
        .detail-block b {
            display: block;
            margin-bottom: 3px;
            color: #64748b;
            font-size: 10px;
            font-weight: 900;
            text-transform: uppercase;
        }
        .meta-stack {
            display: grid;
            gap: 5px;
        }
        .meta-line {
            display: flex;
            justify-content: space-between;
            gap: 8px;
        }
        .meta-label {
            color: #64748b;
            font-weight: 900;
        }
        .meta-value {
            color: #10233f;
            font-weight: 800;
            text-align: right;
        }
        .status-text {
            font-weight: 900;
            white-space: nowrap;
        }
        .status-text.success { color: #0f8f5f; }
        .status-text.warning { color: #b7790b; }
        .status-text.info { color: #0f6fa8; }
        .status-text.danger { color: #d6294f; }
        .status-text.muted { color: #64748b; }
        .empty {
            padding: 18px;
            border: 1px dashed #cbd5e1;
            color: #64748b;
            text-align: center;
            font-weight: 800;
        }
        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
        @@media print {
            body { padding: 0; }
            .report-actions,
            .filter-panel { display: none !important; }
            h2, h3,
            .project-group-row,
            .scenario-project__header,
            .scenario-group__header,
            .phase-project-group {
                break-after: avoid;
                page-break-after: avoid;
            }
            h2 + table,
            h2 + .empty,
            h2 + .report-table-scroll,
            h2 + .issue-report-table,
            h3 + table,
            h3 + .empty,
            .project-group-row + tr {
                break-before: avoid;
                page-break-before: avoid;
            }
            .report-section,
            .scenario-project,
            .scenario-group,
            .project-group-row,
            .phase-project-group {
                break-inside: avoid-page;
                page-break-inside: avoid;
            }
            thead { display: table-header-group; }
            tr { page-break-inside: avoid; }
        }
        @@media (max-width: 900px) {
            .filter-panel,
            .kpi-grid {
                grid-template-columns: 1fr;
            }
        }
    
        /* Crisp typography normalization for standalone pages. */
        :root { --pt-readable-thai-font: "Noto Sans Thai", "Leelawadee UI", Tahoma, "Segoe UI", Arial, sans-serif; }
        html, body {
            font-family: var(--pt-readable-thai-font) !important;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }
        body :where(*):not(svg):not(svg *) {
            font-family: var(--pt-readable-thai-font) !important;
            font-stretch: normal !important;
            letter-spacing: 0 !important;
            text-shadow: none !important;
        }
        body :is(h1, h2, h3, h4, h5, h6, th, label, strong, b, .report-btn, .btn, .badge, .status-text, .cell-title, .project-group-name, [class*="title"], [class*="heading"], [class*="eyebrow"], [class*="status"], [class*="badge"], [class*="count"], [class*="total"], [class*="value"]) {
            font-weight: 700 !important;
        }
        body :is(p, li, td, small, em, time, .cell-sub, .detail-block div, .meta-label, .meta-value, .empty, [class*="detail"], [class*="meta"], [class*="subtitle"], [class*="description"], [class*="desc"], [class*="remark"], [class*="note"], [class*="empty"]):not(.btn):not(.badge):not(.status-text):not([class*="status-"]):not([class*="Status"]) {
            font-weight: 400 !important;
        }
</style>
@await Html.PartialAsync("_StandaloneTheme")
</head>
<body class="pt-standalone-report">
    <div class="report-actions">
        <button type="button" class="report-btn primary" onclick="window.print()">Print</button>
        <a asp-controller="Reports" asp-action="Index" class="report-btn">Report Center</a>
        <a asp-controller="Home" asp-action="Index" class="report-btn">Dashboard</a>
    </div>

    <header class="print-header">
        <h1>Project Issues Report</h1>
        <div>
            Project: @(selectedProject?.ProjectDisplayName ?? "All Projects")<br />
            BA: @SelectedBAText()<br />
            Employee: @(string.IsNullOrWhiteSpace(selectedEmp) ? "All Employees" : selectedEmp)<br />
            Status: @(string.IsNullOrWhiteSpace(selectedStatus) ? "All Status" : selectedStatus)<br />
            Dev Status: @(string.IsNullOrWhiteSpace(selectedDevStatus) ? "All Dev Status" : selectedDevStatus)<br />
            ข้อมูล ณ @DateTime.Now.ToString("dd MMM yyyy HH:mm", th)
        </div>
    </header>

    <form method="get" id="filterForm" class="filter-panel">
        <div class="field">
            <label for="departmentId">ฝ่าย</label>
            <select id="departmentId" name="departmentId" onchange="this.form.submit()">
                <option value="">ทุกฝ่าย</option>
                @foreach (var department in (IEnumerable<ProjectTracking.Models.ProjectDepartment>)(ViewBag.ProjectDepartments ?? Enumerable.Empty<ProjectTracking.Models.ProjectDepartment>()))
                { <option value="@department.DepartmentId" selected="@(ViewBag.SelectedDepartmentId is int id && id == department.DepartmentId ? "selected" : null)">@department.DepartmentName</option> }
            </select>
        </div>
        <div class="field">
            <label for="coopFilter">Cooperative</label>
            <select id="coopFilter" data-placeholder="🔍 พิมพ์ค้นหาสหกรณ์...">
                <option value="">-- All Cooperatives --</option>
                @foreach (var coop in coopList)
                {
                    <option value="@coop">@coop</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="projectSelect">Project</label>
            <select id="projectSelect" name="projectId" data-placeholder="🔍 พิมพ์ค้นหา Project...">
                <option value="">-- All Projects --</option>
                @foreach (var p in projects)
                {
                    <option value="@p.ProjectId"
                            data-coop-name="@(p.Coop?.CoopName ?? "")"
                            selected="@(selectedProject?.ProjectId == p.ProjectId ? "selected" : null)">
                        @p.ProjectDisplayName
                    </option>
                }
            </select>
        </div>

        <div class="field">
            <label for="baSelect">BA</label>
            <select id="baSelect" name="baEmpId" data-placeholder="🔍 พิมพ์ค้นหา BA...">
                <option value="">-- All BA --</option>
                @foreach (var ba in baList)
                {
                    <option value="@ba.Value" selected="@(selectedBA.HasValue && ba.Value == selectedBA.Value.ToString() ? "selected" : null)">
                        @ba.Text
                    </option>
                }
            </select>
        </div>

        <div class="field">
            <label for="empSelect">Employee</label>
            <select id="empSelect" name="empName" data-placeholder="🔍 พิมพ์ค้นหา Employee...">
                <option value="">-- All Employees --</option>
                @foreach (var emp in empList)
                {
                    <option value="@emp" selected="@(emp == selectedEmp ? "selected" : null)">
                        @emp
                    </option>
                }
            </select>
        </div>

        <div class="field">
            <label for="statusSelect">Status</label>
            <select id="statusSelect" name="status" data-placeholder="🔍 พิมพ์ค้นหา Status...">
                <option value="">-- All Status --</option>
                @foreach (var status in statusList)
                {
                    <option value="@status" selected="@(string.Equals(status, selectedStatus, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                        @status
                    </option>
                }
            </select>
        </div>

        <div class="field">
            <label for="devStatusSelect">Dev Status</label>
            <select id="devStatusSelect" name="devStatus" data-placeholder="🔍 พิมพ์ค้นหา Dev Status...">
                <option value="">-- All Dev Status --</option>
                @foreach (var status in devStatusList)
                {
                    <option value="@status" selected="@(string.Equals(status, selectedDevStatus, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                        @status
                    </option>
                }
            </select>
        </div>

        <button type="submit" class="report-btn primary filter-submit">ค้นหา</button>
    </form>

    <section class="kpi-grid">
        <article class="kpi info">
            <span>Total Issues</span>
            <strong>@totalIssues</strong>
            <small>รายการทั้งหมด</small>
        </article>
        <article class="kpi warning">
            <span>Open</span>
            <strong>@openCount</strong>
            <small>Issue ที่ยังเปิด</small>
        </article>
        <article class="kpi info">
            <span>Dev WIP</span>
            <strong>@devWipCount</strong>
            <small>Dev กำลังแก้</small>
        </article>
        <article class="kpi">
            <span>รอ BA ตรวจ</span>
            <strong>@waitBaCount</strong>
            <small>Dev ส่ง FIXED แล้ว</small>
        </article>
        <article class="kpi">
            <span>Pass</span>
            <strong>@passCount</strong>
            <small>ตรวจผ่านแล้ว</small>
        </article>
        <article class="kpi danger">
            <span>Urgent</span>
            <strong>@urgentCount</strong>
            <small>ความสำคัญเร่งด่วน</small>
        </article>
        <article class="kpi warning">
            <span>จำนวน FAIL</span>
            <strong>@totalReopen</strong>
            <small>จำนวน FAIL รวม</small>
        </article>
    </section>

    <h2>Issue List By Project</h2>
    @if (!issues.Any())
    {
        <div class="empty">ไม่พบรายการ Issue ตามเงื่อนไขที่เลือก</div>
    }
    else
    {
        <table class="issue-report-table">
            <colgroup>
                <col class="col-seq" />
                <col class="col-issue" />
                <col class="col-detail" />
                <col class="col-owner" />
                <col class="col-state" />
                <col class="col-date" />
            </colgroup>
            <thead>
                <tr>
                    <th>Seq</th>
                    <th>Issue</th>
                    <th>Detail</th>
                    <th>Owner</th>
                    <th>สถานะ / จำนวน FAIL</th>
                    <th>Dates / Images</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var projectGroups = issues
                        .GroupBy(issue => new
                        {
                            issue.ProjectId,
                            ProjectName = TextOrDash(issue.Project?.ProjectDisplayName),
                            BAName = TextOrDash(issue.Project?.BA?.EmpName)
                        })
                        .OrderBy(group => group.Key.ProjectName)
                        .ToList();
                }
                @foreach (var projectGroup in projectGroups)
                {
                    var row = 1;
                    var groupOpen = projectGroup.Count(x => string.Equals(x.IssueStatus, "OPEN", StringComparison.OrdinalIgnoreCase));
                    var groupDevWip = projectGroup.Count(x =>
                        string.Equals(x.DevStatus, "WIP", StringComparison.OrdinalIgnoreCase) &&
                        !string.Equals(x.IssueStatus, "PASS", StringComparison.OrdinalIgnoreCase) &&
                        !string.Equals(x.IssueStatus, "REJECT", StringComparison.OrdinalIgnoreCase));
                    var groupWaitBa = projectGroup.Count(x =>
                        string.Equals(x.DevStatus, "FIXED", StringComparison.OrdinalIgnoreCase) &&
                        !string.Equals(x.IssueStatus, "PASS", StringComparison.OrdinalIgnoreCase) &&
                        !string.Equals(x.IssueStatus, "REJECT", StringComparison.OrdinalIgnoreCase));
                    var groupPass = projectGroup.Count(x => string.Equals(x.IssueStatus, "PASS", StringComparison.OrdinalIgnoreCase));
                    var groupDevFixed = projectGroup.Count(x => string.Equals(x.DevStatus, "FIXED", StringComparison.OrdinalIgnoreCase));
                    var groupReopen = projectGroup.Sum(x => x.ReopenCount);
                    <tr class="project-group-row">
                        <td colspan="6">
                            <div class="project-group-name">
                                <div>
                                    <span class="project-group-label">Project</span>
                                    @projectGroup.Key.ProjectName
                                    <div class="cell-sub">BA: @projectGroup.Key.BAName</div>
                                    <div class="project-group-stats">
                                        <span>Open <b>@groupOpen</b></span>
                                        <span>Dev WIP <b>@groupDevWip</b></span>
                                        <span>รอ BA ตรวจ <b>@groupWaitBa</b></span>
                                        <span>Pass <b>@groupPass</b></span>
                                        <span>Dev Fixed <b>@groupDevFixed</b></span>
                                        <span>FAIL <b>@groupReopen</b></span>
                                    </div>
                                </div>
                                <span class="project-group-count">@projectGroup.Count() รายการ</span>
                            </div>
                        </td>
                    </tr>

                    @foreach (var issue in projectGroup)
                    {
                        var beforeCount = issue.Images?.Count ?? 0;
                        var afterCount = issue.FixImages?.Count ?? 0;
                        <tr>
                            <td class="text-center">@row</td>
                            <td>
                                <div class="cell-title">@TextOrDash(issue.IssueName)</div>
                                <div class="cell-sub">#@issue.IssueId</div>
                                <div class="cell-sub">Priority: <span class="status-text @PriorityClass(issue.IssuePriority)">@PriorityText(issue.IssuePriority)</span></div>
                            </td>
                            <td>
                                <div class="detail-block">
                                    <div>
                                        <b>Issue Detail</b>
                                        @TextOrDash(issue.IssueDetail)
                                    </div>
                                    <div>
                                        <b>Dev Detail</b>
                                        @TextOrDash(issue.DevDetail)
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="meta-stack">
                                    <div>
                                        <span class="meta-label">BA</span>
                                        <div class="meta-value">@TextOrDash(issue.Project?.BA?.EmpName)</div>
                                    </div>
                                    <div>
                                        <span class="meta-label">Assign To</span>
                                        <div class="meta-value">@TextOrDash(issue.Employee?.EmpName)</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="meta-stack">
                                    <div class="meta-line">
                                        <span class="meta-label">Issue</span>
                                        <span class="status-text @StatusClass(issue.IssueStatus)">@TextOrDash(issue.IssueStatus)</span>
                                    </div>
                                    <div class="meta-line">
                                        <span class="meta-label">Dev</span>
                                        <span class="status-text @DevStatusClass(issue.DevStatus)">@TextOrDash(issue.DevStatus)</span>
                                    </div>
                                    <div class="meta-line">
                                        <span class="meta-label">Priority</span>
                                        <span class="status-text @PriorityClass(issue.IssuePriority)">@PriorityText(issue.IssuePriority)</span>
                                    </div>
                                    <div class="meta-line">
                                        <span class="meta-label">จำนวน FAIL</span>
                                        <span class="status-text @(issue.ReopenCount > 0 ? "warning" : "success")">
                                            @(issue.ReopenCount > 0 ? issue.ReopenCount.ToString() : "-")
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="meta-stack">
                                    <div class="meta-line">
                                        <span class="meta-label">Start</span>
                                        <span class="meta-value">@DateText(issue.StartDate)</span>
                                    </div>
                                    <div class="meta-line">
                                        <span class="meta-label">End</span>
                                        <span class="meta-value">@DateText(issue.EndDate)</span>
                                    </div>
                                    <div class="meta-line">
                                        <span class="meta-label">Images</span>
                                        <span class="meta-value">@beforeCount / @afterCount</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        row++;
                    }
                }
            </tbody>
        </table>
    }

    <script>
        (function () {
            function normalize(value) {
                return (value || "").toString().trim().toLowerCase();
            }

            function getSelectedOption(select) {
                return select.options[select.selectedIndex] || null;
            }

            function hasEmptyOption(select) {
                return Array.from(select.options).some(option => option.value === "");
            }

            function dispatchSelectChange(select) {
                select.dispatchEvent(new Event("input", { bubbles: true }));
                select.dispatchEvent(new Event("change", { bubbles: true }));
            }

            function enhanceSelect(select) {
                if (!select || select.classList.contains("pt-dropdown-enhanced")) return;

                const wrapper = document.createElement("div");
                wrapper.className = "pt-search-select";
                if (select.disabled) wrapper.classList.add("is-disabled");

                const field = document.createElement("div");
                field.className = "pt-search-select__field";

                const input = document.createElement("input");
                input.type = "text";
                input.className = "pt-search-select__input";
                input.autocomplete = "off";
                input.disabled = select.disabled;
                input.placeholder = select.dataset.placeholder || getSelectedOption(select)?.text || "🔍 พิมพ์ค้นหา...";
                const dropdown = document.createElement("div");
                dropdown.className = "pt-search-select__dropdown";

                field.appendChild(input);
                wrapper.appendChild(field);
                wrapper.appendChild(dropdown);
                select.insertAdjacentElement("afterend", wrapper);
                select.classList.add("pt-dropdown-enhanced", "pt-native-select-hidden");
                select.tabIndex = -1;
                function syncInputFromSelect() {
                    const selected = getSelectedOption(select);
                    input.value = selected ? selected.text : "";
                }

                function closeDropdown() {
                    wrapper.classList.remove("is-open");
                }

                function renderOptions(filter = "") {
                    dropdown.innerHTML = "";
                    const keyword = normalize(filter);
                    const options = Array.from(select.options)
                        .filter(option => !option.disabled)
                        .filter(option => {
                            const haystack = normalize(`${option.text} ${option.value}`);
                            return !keyword || haystack.includes(keyword);
                        });

                    if (options.length === 0) {
                        const empty = document.createElement("div");
                        empty.className = "pt-search-select__empty";
                        empty.textContent = "ไม่พบข้อมูล";
                        dropdown.appendChild(empty);
                        return;
                    }

                    options.forEach(option => {
                        const item = document.createElement("button");
                        item.type = "button";
                        item.className = "pt-search-select__option";
                        if (option.value === select.value) item.classList.add("is-selected");
                        item.textContent = option.text;
                        item.addEventListener("click", function () {
                            select.value = option.value;
                            input.value = option.text;
                            closeDropdown();
                            syncInputFromSelect();
                            dispatchSelectChange(select);
                        });
                        dropdown.appendChild(item);
                    });
                }

                function openDropdown() {
                    if (select.disabled) return;
                    input.value = "";
                    renderOptions(input.value);
                    wrapper.classList.add("is-open");
                }
                input.addEventListener("focus", openDropdown);
                input.addEventListener("click", openDropdown);
                input.addEventListener("input", function () {
                    renderOptions(input.value);
                    wrapper.classList.add("is-open");
                });
                input.addEventListener("keydown", function (event) {
                    if (event.key === "Escape") {
                        closeDropdown();
                        syncInputFromSelect();
                    }
                });                select.addEventListener("change", syncInputFromSelect);
                document.addEventListener("click", function (event) {
                    if (!wrapper.contains(event.target)) {
                        closeDropdown();
                        syncInputFromSelect();
                    }
                });

                syncInputFromSelect();
            }

            // Native dropdowns: custom search-select disabled globally.


            document.querySelectorAll(".filter-panel select").forEach(enhanceSelect);

            const coopFilter = document.getElementById("coopFilter");
            const projectFilter = document.getElementById("projectSelect");

            function syncProjectFilterOptions() {
                if (!projectFilter) return;

                const selectedCoop = normalize(coopFilter?.value || "");
                Array.from(projectFilter.options).forEach(option => {
                    const visible = option.value === "" || !selectedCoop || normalize(option.dataset.coopName || "") === selectedCoop;
                    option.hidden = !visible;
                    option.disabled = !visible;
                });

                const selected = projectFilter.selectedOptions[0];
                if (selected && selected.disabled) projectFilter.value = "";
            }

            coopFilter?.addEventListener("change", function () {
                localStorage.setItem("reports.issues.selectedCoop", normalize(coopFilter.value));
                if (projectFilter) projectFilter.value = "";
                syncProjectFilterOptions();
            });

            const savedCoop = localStorage.getItem("reports.issues.selectedCoop") || "";
            if (savedCoop && coopFilter) {
                const match = Array.from(coopFilter.options).find(option => normalize(option.value) === savedCoop);
                if (match) coopFilter.value = match.value;
            }

            syncProjectFilterOptions();
        })();

    </script>
</body>
</html>

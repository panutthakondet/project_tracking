@model IEnumerable<ProjectTracking.Models.ProjectIssue>
@using System.Globalization

@{
    ViewData["Title"] = "บันทึกข้อมูลปัญหาโครงการ";
    var selectedProject = ViewBag.SelectedProject as ProjectTracking.Models.Project;
    var selectedEmp = ViewBag.SelectedEmp as string;
    var empList = ViewBag.EmpList as IEnumerable<string> ?? Enumerable.Empty<string>();
    var th = new CultureInfo("th-TH");

    string DateOrDash(DateTime? value) => value?.ToString("dd MMM yyyy", th) ?? "-";
    string PeriodText(ProjectTracking.Models.ProjectIssue issue)
    {
        if (!issue.StartDate.HasValue && !issue.EndDate.HasValue) return "-";
        return $"{DateOrDash(issue.StartDate)} - {DateOrDash(issue.EndDate)}";
    }
}

@using Microsoft.AspNetCore.Http
@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

<style>
.issue-card-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.issue-filter-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    width: 100%;
}

.issue-filter-row {
    width: 100%;
    min-width: 0;
}

.issue-card {
    display: flex;
    align-items: stretch;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05), 0 0.5px 1.5px rgba(0,0,0,0.03);
    overflow: hidden;
    transition: box-shadow .15s, transform .15s;
}

.issue-card:hover {
    box-shadow: 0 8px 24px rgba(15, 23, 42, .10);
    transform: translateY(-1px);
}

.issue-card.issue-urgent {
    border-color: #fecaca;
    box-shadow: inset 4px 0 0 #ef4444, 0 2px 8px rgba(0,0,0,0.05);
}

.issue-card-left {
    flex: 1 1 auto;
    min-width: 0;
    padding: 1rem 1.25rem;
}

.issue-card-right {
    width: 300px;
    min-width: 280px;
    padding: 1rem 1.25rem 1rem .75rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    gap: .75rem;
}

.issue-card-top {
    display: flex;
    align-items: flex-start;
    gap: .75rem;
    margin-bottom: .5rem;
}

.issue-card-index {
    flex: 0 0 auto;
    min-width: 2.75rem;
    height: 2rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #eaf2ff;
    color: #0f3b6f;
    font-weight: 800;
}

.issue-title-wrap {
    min-width: 0;
}

.issue-title {
    display: block;
    color: #111827;
    font-size: 1.08rem;
    font-weight: 800;
    line-height: 1.35;
    word-break: break-word;
}

.issue-detail {
    color: #64748b;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: .25rem 0 0;
    line-height: 1.45;
}

.issue-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1rem;
    color: #475569;
    font-size: .92rem;
    font-weight: 600;
}

.issue-status-grid {
    display: grid;
    gap: .45rem;
    width: 100%;
}

.issue-status-item {
    display: grid;
    grid-template-columns: 78px minmax(0, 1fr);
    align-items: center;
    gap: .5rem;
}

.issue-status-item small {
    color: #64748b;
    font-size: .78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .02em;
}

.issue-status-item .badge {
    width: 100%;
    min-height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: normal;
    line-height: 1.15;
    text-align: center;
}

.issue-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    justify-content: flex-end;
}

.reopen-badge {
    font-size: 11px;
    padding: 3px 7px;
    border-radius: 6px;
    margin-left: 6px;
}

@@media (max-width: 768px) {
    .issue-card {
        flex-direction: column;
    }

    .issue-card-right {
        width: auto;
        min-width: 0;
        align-items: stretch;
        padding: 0 1.25rem 1rem;
    }

    .issue-actions {
        justify-content: flex-start;
    }
}
</style>

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">บันทึกข้อมูลปัญหาโครงการ</h2>
        <p class="index-subtitle">ติดตามปัญหา งานค้าง และ Bug ของโครงการ</p>
    </div>

    <div class="index-actions">
        @if (selectedProject != null && CanMenu("ProjectIssues.Create"))
        {
            <a asp-action="Create" asp-route-projectId="@selectedProject.ProjectId" class="btn btn-primary" title="เพิ่ม Issue">
                Add Issue
            </a>
        }
        else if (selectedProject != null)
        {
            <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์เพิ่ม Issue">
                Add Issue
            </button>
        }
    </div>
</div>

<form method="get" id="filterForm" class="issue-filter-form mb-4">
    <div class="issue-filter-row">
        <label class="form-label fw-semibold">📁 โครงการ</label>
        <select id="projectSelect"
                name="projectId"
                class="form-select"
                onchange="document.getElementById('filterForm').submit()">
            <option value="">-- เลือกโครงการ --</option>
            @foreach (var p in ((IEnumerable<ProjectTracking.Models.Project>)ViewBag.Projects ?? Enumerable.Empty<ProjectTracking.Models.Project>())
                                .OrderBy(x => x.Coop?.CoopName ?? "")
                                .ThenBy(x => x.ProjectName))
            {
                <option value="@p.ProjectId" selected="@(selectedProject?.ProjectId == p.ProjectId)">
                    @p.ProjectDisplayName
                </option>
            }
        </select>
    </div>

    @if (selectedProject != null)
    {
        <div class="issue-filter-row">
            <label class="form-label fw-semibold">👤 Owner</label>
            <select name="empName" class="form-select" onchange="document.getElementById('filterForm').submit()">
                <option value="">-- All --</option>
                @foreach (var emp in empList)
                {
                    <option value="@emp" selected="@(emp == selectedEmp)">
                        @emp
                    </option>
                }
            </select>
        </div>
    }
</form>

@if (selectedProject == null)
{
    <div class="alert alert-info">⬆ กรุณาเลือก Project เพื่อดูรายการ Issue</div>
}
else
{
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning">ไม่พบรายการ Issue</div>
        return;
    }

    <div class="issue-card-list">
        @{
            var row = 1;
        }

        @foreach (var i in Model)
        {
            var urgent = i.IssuePriority == "URGENT";
            var reopenCount = i.ReopenCount;

            string reopenClass =
                reopenCount == 0 ? "bg-success" :
                reopenCount == 1 ? "bg-info" :
                reopenCount <= 3 ? "bg-warning text-dark" :
                "bg-danger";

            string reopenText =
                reopenCount == 0 ? "Stable" :
                reopenCount == 1 ? "1 Reopen" :
                reopenCount <= 3 ? $"{reopenCount} Reopens" :
                $"Critical ({reopenCount})";

            string statusClass =
                i.IssueStatus == "OPEN" ? "bg-warning text-dark" :
                i.IssueStatus == "WIP" ? "bg-info text-dark" :
                i.IssueStatus == "FIXED" ? "bg-success" :
                i.IssueStatus == "PASS" ? "bg-primary" :
                i.IssueStatus == "FAIL" ? "bg-danger" :
                i.IssueStatus == "REJECT" ? "bg-dark" :
                "bg-secondary";

            string devStatusClass =
                i.DevStatus == "TODO" ? "bg-secondary" :
                i.DevStatus == "DOING" ? "bg-info text-dark" :
                i.DevStatus == "FIXED" ? "bg-success" :
                i.DevStatus == "BLOCK" ? "bg-danger" :
                "bg-dark";

            <article class="issue-card @(urgent ? "issue-urgent" : "")">
                <div class="issue-card-left">
                    <div class="issue-card-top">
                        <span class="issue-card-index">#@row</span>
                        <div class="issue-title-wrap">
                            <span class="issue-title">
                                @i.IssueName
                                @if (i.IsReopen)
                                {
                                    <span class="badge @reopenClass reopen-badge"
                                          title="ถูกส่งกลับมาแก้ @reopenCount ครั้ง">
                                        🔁 @reopenText
                                    </span>
                                }
                            </span>
                            <p class="issue-detail">
                                @(string.IsNullOrWhiteSpace(i.IssueDetail) ? "ไม่มีรายละเอียดเพิ่มเติม" : i.IssueDetail)
                            </p>
                        </div>
                    </div>

                    <div class="issue-meta">
                        <span>🗓 ช่วงวันที่: @PeriodText(i)</span>
                        <span>👤 Owner: @(i.Employee?.EmpName ?? "-")</span>
                    </div>

                    <div class="issue-status-grid">
                        <div class="issue-status-item">
                            <small>Issue</small>
                            <span class="badge @statusClass">@i.IssueStatus</span>
                        </div>
                        <div class="issue-status-item">
                            <small>Dev</small>
                            <span class="badge @devStatusClass">@i.DevStatus</span>
                        </div>
                        <div class="issue-status-item">
                            <small>Priority</small>
                            <span class="badge @(urgent ? "bg-danger" : "bg-secondary")">
                                @(urgent ? "URGENT" : "NORMAL")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="issue-card-right">
                    <div class="issue-actions">
                        @if (CanMenu("ProjectIssues.View"))
                        {
                            <a asp-controller="ProjectIssues"
                               asp-action="Details"
                               asp-route-id="@i.IssueId"
                               asp-route-projectId="@selectedProject?.ProjectId"
                               class="btn btn-sm btn-outline-secondary"
                               title="ดูรายละเอียด">
                               👁 View
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดู (ต้องมี ProjectIssues.View)">
                                👁 View
                            </button>
                        }

                        @if (CanMenu("ProjectIssues.Edit"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@i.IssueId"
                               asp-route-projectId="@selectedProject?.ProjectId"
                               class="btn btn-sm btn-outline-primary"
                               title="แก้ไข Issue">✏️ Edit</a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข (ต้องมี ProjectIssues.Edit)">✏️ Edit</button>
                        }

                        @if (CanMenu("ProjectIssues.Delete"))
                        {
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete issue นี้ใช่หรือไม่?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@i.IssueId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="ลบ Issue">🗑 Delete</button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ (ต้องมี ProjectIssues.Delete)">🗑 Delete</button>
                        }
                    </div>
                </div>
            </article>

            row++;
        }
    </div>
}

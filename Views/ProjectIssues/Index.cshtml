@model IEnumerable<ProjectTracking.Models.ProjectIssue>
@using System.Globalization

@{
    ViewData["Title"] = "บันทึกข้อมูลปัญหาโครงการ";
    var selectedProject = ViewBag.SelectedProject as ProjectTracking.Models.Project;
    var selectedEmp = ViewBag.SelectedEmp as string;
    var empList = ViewBag.EmpList as IEnumerable<string> ?? Enumerable.Empty<string>();
    var th = new CultureInfo("th-TH");

    string DateOrDash(DateTime? value) => value?.ToString("dd MMM yyyy", th) ?? "-";
    string PeriodText(ProjectTracking.Models.ProjectIssue issue)
    {
        if (!issue.StartDate.HasValue && !issue.EndDate.HasValue) return "-";
        return $"{DateOrDash(issue.StartDate)} - {DateOrDash(issue.EndDate)}";
    }

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    string ProfileImage(ProjectTracking.Models.Employee? employee)
    {
        var path = employee?.LoginUser?.ProfileImagePath;
        if (string.IsNullOrWhiteSpace(path)) return "/images/Profile/profile.png";

        path = path.Trim();
        if (path.StartsWith("~/", StringComparison.Ordinal)) path = path[1..];
        if (!path.StartsWith("/", StringComparison.Ordinal)) path = "/" + path.TrimStart('/');
        return path;
    }
}

@using Microsoft.AspNetCore.Http
@{
    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }
}

<style>
.issue-card-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.issue-filter-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    width: 100%;
}

.issue-filter-row {
    width: 100%;
    min-width: 0;
}

.issue-card {
    display: flex;
    align-items: stretch;
    border: 1px solid #d8e3ef;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    overflow: hidden;
    transition: box-shadow .15s, transform .15s;
}

.issue-card:hover {
    box-shadow: 0 8px 24px rgba(15, 23, 42, .10);
    transform: translateY(-1px);
}

.issue-card.issue-urgent {
    border-color: #fecaca;
    box-shadow: inset 4px 0 0 #ef4444, 0 2px 8px rgba(0,0,0,0.05);
}

.issue-card-left {
    flex: 1 1 auto;
    min-width: 0;
    padding: 18px;
}

.issue-card-right {
    width: 300px;
    min-width: 280px;
    padding: 1rem 1.25rem 1rem .75rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    gap: .75rem;
}

.issue-card-top {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 10px;
}

.issue-card-index {
    flex: 0 0 auto;
    min-width: 2.75rem;
    height: 2rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(20, 184, 166, .18);
    color: #062b2f;
    font-weight: 700;
}

.issue-title-wrap {
    min-width: 0;
}

.issue-title-line {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.issue-title {
    display: block;
    color: #0f172a;
    font-size: .98rem;
    font-weight: 700;
    line-height: 1.35;
    word-break: break-word;
}

.issue-detail {
    color: #0f172a;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: .25rem 0 0;
    line-height: 1.45;
    font-size: .93rem;
    font-weight: 400;
}

.issue-card-people {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    gap: 10px 18px;
    margin: 10px 0 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #0f172a;
    font-size: .95rem;
    font-weight: 400;
}

.issue-card-person {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    color: #0f172a;
    font-weight: 400;
    line-height: 1.25;
}

.issue-card-person img {
    width: 36px;
    height: 36px;
    flex: 0 0 auto;
    border: 1px solid #dbe6f3;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
}

.issue-card-person span {
    overflow-wrap: anywhere;
}

.issue-card-person strong {
    color: #0f172a;
    font-weight: 600;
}

.issue-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    color: #0f172a;
    font-size: .92rem;
    font-weight: 400;
    line-height: 1.35;
    margin-top: 8px;
}

.issue-meta strong {
    color: #0f172a;
    font-weight: 700;
}

.issue-status-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 10px;
    width: 100%;
}

.issue-status-item {
    min-width: 0;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
}

.issue-status-item small {
    color: #0f172a;
    font-size: .92rem;
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
}

.issue-status-item small::after {
    content: ":";
}

.issue-status-item .badge {
    min-height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: normal;
    line-height: 1.15;
    text-align: center;
    font-weight: 700;
}

.issue-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    justify-content: flex-end;
}

.reopen-badge {
    font-size: 11px;
    padding: 3px 7px;
    border-radius: 6px;
    margin-left: 6px;
}

@@media (max-width: 768px) {
    .issue-card {
        flex-direction: column;
    }

    .issue-card-right {
        width: auto;
        min-width: 0;
        align-items: stretch;
        padding: 0 1.25rem 1rem;
    }

    .issue-actions {
        justify-content: flex-start;
    }
}
</style>

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">บันทึกข้อมูลปัญหาโครงการ</h2>
        <p class="index-subtitle">ติดตามปัญหา งานค้าง และ Bug ของโครงการ</p>
    </div>

    <div class="index-actions">
        @if (selectedProject != null && CanMenu("ProjectIssues.Create"))
        {
            <a asp-action="Create" asp-route-projectId="@selectedProject.ProjectId" class="btn btn-primary" title="เพิ่มปัญหา">
                เพิ่มปัญหา
            </a>
        }
        else if (selectedProject != null)
        {
            <button class="btn btn-primary" disabled title="ไม่มีสิทธิ์เพิ่มปัญหา">
                เพิ่มปัญหา
            </button>
        }
    </div>
</div>

<form method="get" id="filterForm" class="issue-filter-form mb-4">
    <div class="issue-filter-row">
        <label class="form-label fw-semibold">โครงการ</label>
        <select id="projectSelect"
                name="projectId"
                class="form-select"
                onchange="document.getElementById('filterForm').submit()">
            <option value="">-- เลือกโครงการ --</option>
            @foreach (var p in ((IEnumerable<ProjectTracking.Models.Project>)ViewBag.Projects ?? Enumerable.Empty<ProjectTracking.Models.Project>())
                                .OrderBy(x => x.Coop?.CoopName ?? "")
                                .ThenBy(x => x.ProjectName))
            {
                <option value="@p.ProjectId" selected="@(selectedProject?.ProjectId == p.ProjectId)">
                    @p.ProjectDisplayName
                </option>
            }
        </select>
    </div>

    @if (selectedProject != null)
    {
        <div class="issue-filter-row">
            <label class="form-label fw-semibold">เจ้าของงาน</label>
            <select name="empName" class="form-select" onchange="document.getElementById('filterForm').submit()">
                <option value="">-- ทั้งหมด --</option>
                @foreach (var emp in empList)
                {
                    <option value="@emp" selected="@(emp == selectedEmp)">
                        @emp
                    </option>
                }
            </select>
        </div>
    }
</form>

@if (selectedProject == null)
{
    <div class="alert alert-info">กรุณาเลือกโครงการเพื่อดูรายการปัญหา</div>
}
else
{
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning">ไม่พบรายการปัญหา</div>
        return;
    }

    <div class="issue-card-list">
        @{
            var row = 1;
        }

        @foreach (var i in Model)
        {
            var urgent = i.IssuePriority == "URGENT";
            var reopenCount = i.ReopenCount;

            string reopenClass =
                reopenCount == 0 ? "bg-success" :
                reopenCount == 1 ? "bg-info" :
                reopenCount <= 3 ? "bg-warning text-dark" :
                "bg-danger";

            string failCountText =
                reopenCount == 0 ? "0 ครั้ง" :
                reopenCount == 1 ? "FAIL 1 ครั้ง" :
                reopenCount <= 3 ? $"FAIL {reopenCount} ครั้ง" :
                $"วิกฤต ({reopenCount})";

            string statusClass =
                i.IssueStatus == "OPEN" ? "bg-warning text-dark" :
                i.IssueStatus == "PASS" ? "bg-primary" :
                i.IssueStatus == "FAIL" ? "bg-danger" :
                i.IssueStatus == "REJECT" ? "bg-dark" :
                "bg-secondary";

            string devStatusClass =
                i.DevStatus == "WIP" ? "bg-info text-dark" :
                i.DevStatus == "FIXED" ? "bg-success" :
                "bg-secondary";

            <article class="issue-card @(urgent ? "issue-urgent" : "")">
                <div class="issue-card-left">
                    <div class="issue-card-top">
                        <div class="issue-title-wrap">
                            <div class="issue-title-line">
                                <span class="issue-card-index">#@row</span>
                            </div>
                            <span class="issue-title"><span class="pt-list-label">หัวข้อปัญหา:</span> <span class="pt-list-value">@TextOrDash(i.IssueName)</span>
                                @if (i.IsReopen)
                                {
                                    <span class="badge @reopenClass reopen-badge pt-list-value"
                                          title="จำนวน FAIL @reopenCount ครั้ง">
                                        @failCountText
                                    </span>
                                }
                            </span>
                            <p class="issue-detail"><span class="pt-list-label">รายละเอียดปัญหา:</span> <span class="pt-list-value">@(string.IsNullOrWhiteSpace(i.IssueDetail) ? "ไม่มีรายละเอียดเพิ่มเติม" : i.IssueDetail)</span></p>
                        </div>
                    </div>

                    <div class="issue-meta">
                        <span><span class="pt-list-label">วันที่กำหนด:</span> <span class="pt-list-value">@PeriodText(i)</span></span>
                    </div>

                    <div class="issue-card-people">
                        <span class="issue-card-person">
                            <img class="pt-owner-avatar"
                                 src="@ProfileImage(i.Employee)"
                                     alt="@(i.Employee?.EmpName ?? "ผู้รับผิดชอบ")"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                            <span><span class="pt-list-label">ผู้รับผิดชอบ:</span> <span class="pt-list-value">@(i.Employee?.EmpName ?? "-")</span></span>
                        </span>
                    </div>

                    <div class="issue-status-grid">
                        <div class="issue-status-item">
                            <small class="pt-list-label">สถานะตรวจ</small>
                            <span class="badge @statusClass pt-list-value">@i.IssueStatus</span>
                        </div>
                        <div class="issue-status-item">
                            <small class="pt-list-label">สถานะ Dev</small>
                            <span class="badge @devStatusClass pt-list-value">@i.DevStatus</span>
                        </div>
                        <div class="issue-status-item">
                            <small class="pt-list-label">ความสำคัญ</small>
                            <span class="badge @(urgent ? "bg-danger" : "bg-secondary") pt-list-value">
                                @(urgent ? "URGENT" : "NORMAL")
                            </span>
                        </div>
                        <div class="issue-status-item">
                            <small class="pt-list-label">จำนวน FAIL</small>
                            <span class="badge @reopenClass pt-list-value">@reopenCount ครั้ง</span>
                        </div>
                    </div>
                </div>

                <div class="issue-card-right">
                    <div class="issue-actions">
                        @if (CanMenu("ProjectIssues.View"))
                        {
                            <a asp-controller="ProjectIssues"
                               asp-action="Details"
                               asp-route-id="@i.IssueId"
                               asp-route-projectId="@selectedProject?.ProjectId"
                               class="btn btn-sm btn-outline-secondary"
                               title="ดูรายละเอียด">
                               ดูรายละเอียด
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ดูรายละเอียด">
                                ดูรายละเอียด
                            </button>
                        }

                        @if (CanMenu("ProjectIssues.Edit"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@i.IssueId"
                               asp-route-projectId="@selectedProject?.ProjectId"
                               class="btn btn-sm btn-outline-primary"
                               title="แก้ไขปัญหา">แก้ไข</a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์แก้ไข">แก้ไข</button>
                        }

                        @if (CanMenu("ProjectIssues.Delete"))
                        {
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('ยืนยันการลบปัญหานี้ใช่หรือไม่?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@i.IssueId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="ลบปัญหา">ลบ</button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="ไม่มีสิทธิ์ลบ">ลบ</button>
                        }
                    </div>
                </div>
            </article>

            row++;
        }
    </div>
}

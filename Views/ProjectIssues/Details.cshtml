@model ProjectTracking.Models.ProjectIssue
@using Microsoft.AspNetCore.Http
@using System.Linq

@{
    ViewData["Title"] = "Issue Details";

    var issue = Model;
    var beforeImages = issue?.Images?.ToList() ?? new List<ProjectTracking.Models.ProjectIssueImage>();
    var afterImages = issue?.FixImages?.ToList() ?? new List<ProjectTracking.Models.ProjectIssueFixImage>();

    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string DateOrDash(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "-";
}

<style>
    .issue-detail-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
    }

    .issue-hero {
        background: linear-gradient(135deg, #10233f, #1f3b63);
        color: #fff;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 18px 40px rgba(15, 35, 64, .22);
        margin-bottom: 18px;
    }

    .issue-hero-top {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        align-items: flex-start;
    }

    .issue-hero-main {
        min-width: 0;
        flex: 1 1 auto;
    }

    .issue-eyebrow {
        color: rgba(216, 230, 247, .86);
        font-size: 12px;
        font-weight: 900;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .issue-title {
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 900;
        line-height: 1.22;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .issue-hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        flex: 0 0 auto;
    }

    .issue-hero-actions .btn {
        min-width: 136px;
        min-height: 42px;
        border-radius: 999px !important;
        font-size: .95rem;
        font-weight: 900;
        padding: .58rem 1.1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        box-shadow: 0 8px 18px rgba(20, 184, 166, .14);
    }

    .issue-hero .btn-primary {
        color: #062b2f !important;
        background: linear-gradient(135deg, #8df1e4, #23c7c8) !important;
        border-color: transparent !important;
    }

    .issue-hero .btn-outline-light {
        color: #fff !important;
        background: rgba(255,255,255,.08);
        border-color: rgba(255,255,255,.55) !important;
    }

    .issue-hero .btn-outline-light:hover {
        background: rgba(255,255,255,.18) !important;
    }

    .issue-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .issue-summary-card,
    .issue-panel {
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    }

    .issue-summary-card {
        padding: 14px 16px;
        min-height: 90px;
    }

    .issue-summary-card small {
        display: block;
        color: #64748b;
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .issue-summary-card b {
        color: #10233f;
        font-size: 16px;
        line-height: 1.35;
        word-break: break-word;
    }

    .issue-summary-card .muted {
        color: #94a3b8;
    }

    .issue-content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 16px;
        margin-bottom: 18px;
    }

    .issue-detail-bottom {
        display: grid;
        gap: 16px;
    }

    .issue-info-grid {
        display: grid;
        gap: 12px;
    }

    .issue-info-row {
        display: grid;
        grid-template-columns: 130px minmax(0, 1fr);
        gap: 12px;
        align-items: start;
        padding: 12px 14px;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #f8fafc;
    }

    .issue-info-label {
        color: #64748b;
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .issue-info-value {
        color: #10233f;
        font-weight: 900;
        line-height: 1.45;
        word-break: break-word;
    }

    .issue-panel {
        padding: 18px;
    }

    .issue-panel h3 {
        color: #10233f;
        font-size: 18px;
        font-weight: 900;
        margin: 0 0 12px;
    }

    .issue-text-box {
        min-height: 150px;
        color: #24364d;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 14px;
        line-height: 1.65;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .issue-gallery-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .issue-gallery-head .badge {
        border-radius: 999px;
    }

    .issue-gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
    }

    .issue-image-card {
        border: 1px solid #d8e3ef;
        background: #f8fafc;
        border-radius: 14px;
        overflow: hidden;
        padding: 8px;
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
    }

    .issue-image-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(15, 35, 64, .14);
    }

    .issue-image-card img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 10px;
        display: block;
    }

    .issue-empty {
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        color: #64748b;
        background: #f8fafc;
        padding: 18px;
        font-weight: 700;
        text-align: center;
    }

    @@media (max-width: 991.98px) {
        .issue-hero-top,
        .issue-content-grid {
            grid-template-columns: 1fr;
            display: grid;
        }

        .issue-hero-actions {
            justify-content: flex-start;
        }

        .issue-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .issue-summary-grid {
            grid-template-columns: 1fr;
        }

        .issue-hero-actions .btn {
            width: 100%;
        }

        .issue-info-row {
            grid-template-columns: 1fr;
            gap: 4px;
        }
    }
</style>

<div class="issue-detail-page">
    <section class="issue-hero">
        <div class="issue-hero-top">
            <div class="issue-hero-main">
                <div class="issue-eyebrow">Project Issue #@(issue?.IssueId ?? 0)</div>
                <h1 class="issue-title">รายละเอียด Issue</h1>
            </div>

            <div class="issue-hero-actions">
                <a asp-action="Index"
                   asp-route-projectId="@issue?.ProjectId"
                   class="btn btn-outline-light">
                    กลับรายการ Issue
                </a>

                @if (issue != null && CanMenu("ProjectIssues.Edit"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@issue.IssueId"
                       asp-route-projectId="@issue.ProjectId"
                       class="btn btn-primary">
                        แก้ไข Issue
                    </a>
                }
            </div>
        </div>
    </section>

    <section class="issue-summary-grid">
        <div class="issue-summary-card">
            <small>Created</small>
            <b>@(issue?.CreatedAt.ToString("dd/MM/yyyy HH:mm") ?? "-")</b>
        </div>
        <div class="issue-summary-card">
            <small>Last Fix</small>
            <b>@(issue?.LastFixedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</b>
        </div>
        <div class="issue-summary-card">
            <small>Reopen</small>
            <b>@(issue?.IsReopen == true ? $"{issue.ReopenCount} ครั้ง" : "ไม่เคย Reopen")</b>
        </div>
        <div class="issue-summary-card">
            <small>Images</small>
            <b>@beforeImages.Count ก่อนแก้ / @afterImages.Count หลังแก้</b>
        </div>
    </section>

    <section class="issue-content-grid">
        <article class="issue-panel">
            <div class="issue-gallery-head">
                <h3>รูปก่อนแก้</h3>
                <span class="badge bg-primary">@beforeImages.Count รูป</span>
            </div>

            @if (beforeImages.Count > 0)
            {
                <div class="issue-gallery-grid">
                    @foreach (var img in beforeImages)
                    {
                        <button type="button"
                                class="issue-image-card"
                                onclick="previewImage('@img.FilePath')"
                                aria-label="ดูรูปก่อนแก้">
                            <img src="@img.FilePath" alt="Issue image before fix" />
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="issue-empty">ไม่มีรูปก่อนแก้</div>
            }
        </article>

        <article class="issue-panel">
            <div class="issue-gallery-head">
                <h3>รูปหลังแก้</h3>
                <span class="badge bg-success">@afterImages.Count รูป</span>
            </div>

            @if (afterImages.Count > 0)
            {
                <div class="issue-gallery-grid">
                    @foreach (var img in afterImages)
                    {
                        <button type="button"
                                class="issue-image-card"
                                onclick="previewImage('@img.FilePath')"
                                aria-label="ดูรูปหลังแก้">
                            <img src="@img.FilePath" alt="Issue image after fix" />
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="issue-empty">ไม่มีรูปหลังแก้</div>
            }
        </article>
    </section>

    <section class="issue-detail-bottom">
        <article class="issue-panel">
            <h3>ข้อมูล Issue</h3>
            <div class="issue-info-grid">
                <div class="issue-info-row">
                    <div class="issue-info-label">Issue</div>
                    <div class="issue-info-value">@(issue?.IssueName ?? "-")</div>
                </div>
                <div class="issue-info-row">
                    <div class="issue-info-label">Project</div>
                    <div class="issue-info-value">@TextOrDash(issue?.Project?.ProjectName)</div>
                </div>
                <div class="issue-info-row">
                    <div class="issue-info-label">Owner</div>
                    <div class="issue-info-value">@TextOrDash(issue?.Employee?.EmpName)</div>
                </div>
                <div class="issue-info-row">
                    <div class="issue-info-label">Start Date</div>
                    <div class="issue-info-value">@DateOrDash(issue?.StartDate)</div>
                </div>
                <div class="issue-info-row">
                    <div class="issue-info-label">End Date</div>
                    <div class="issue-info-value">@DateOrDash(issue?.EndDate)</div>
                </div>
            </div>
        </article>

        <article class="issue-panel">
            <h3>รายละเอียดปัญหา</h3>
            <div class="issue-text-box">@(string.IsNullOrWhiteSpace(issue?.IssueDetail) ? "-" : issue.IssueDetail)</div>
        </article>

        <article class="issue-panel">
            <h3>รายละเอียดการแก้ไข</h3>
            <div class="issue-text-box">@(string.IsNullOrWhiteSpace(issue?.DevDetail) ? "-" : issue.DevDetail)</div>
        </article>
    </section>
</div>

<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark">
            <div class="modal-body text-center p-2">
                <img id="previewImage" src="" class="img-fluid rounded" alt="preview" />
            </div>
        </div>
    </div>
</div>

<script>
function prepareImagePreviewModal(modalId) {
    const modalEl = document.getElementById(modalId);
    if (!modalEl) return null;

    if (modalEl.parentElement !== document.body) {
        document.body.appendChild(modalEl);
    }

    document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
    document.body.classList.remove('modal-open');
    document.body.style.removeProperty('overflow');
    document.body.style.removeProperty('padding-right');

    modalEl.style.zIndex = '26010';
    return modalEl;
}

function previewImage(src){
    const img = document.getElementById("previewImage");
    img.src = src;

    const modalEl = prepareImagePreviewModal("imagePreviewModal");
    if (!modalEl) return;

    const modal = bootstrap.Modal.getOrCreateInstance(modalEl, {
        backdrop: true,
        keyboard: true
    });
    modal.show();

    window.setTimeout(function () {
        modalEl.style.zIndex = '26010';
        document.querySelectorAll('.modal-backdrop').forEach(function (backdrop) {
            backdrop.style.zIndex = '26000';
        });
    }, 0);
}
</script>

@model ProjectTracking.Models.ProjectIssue
@using Microsoft.AspNetCore.Http
@using System.Linq

@{
    ViewData["Title"] = "Issue Details";

    var issue = Model;
    var beforeImages = issue?.Images?.ToList() ?? new List<ProjectTracking.Models.ProjectIssueImage>();
    var afterImages = issue?.FixImages?.ToList() ?? new List<ProjectTracking.Models.ProjectIssueFixImage>();
    var gitHistories = ViewBag.GitHistories as IEnumerable<ProjectTracking.Models.ProjectIssueGitHistory>
        ?? new List<ProjectTracking.Models.ProjectIssueGitHistory>();

    bool CanMenu(string key)
    {
        var role = (Context.Session.GetString("Role") ?? "").Trim();
        if (role.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) return true;

        var menus = Context.Session.GetString("Menus") ?? "";
        return menus.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(x => string.Equals(x.Trim(), key, StringComparison.OrdinalIgnoreCase));
    }

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string DateOrDash(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "-";
}

<style>
    .issue-detail-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
    }

    .issue-hero {
        background: linear-gradient(135deg, #10233f, #1f3b63);
        color: #fff;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 18px 40px rgba(15, 35, 64, .22);
        margin-bottom: 18px;
    }

    .issue-hero-top {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        align-items: flex-start;
    }

    .issue-hero-main {
        min-width: 0;
        flex: 1 1 auto;
    }

    .issue-eyebrow {
        color: rgba(216, 230, 247, .86);
        font-size: 12px;
        font-weight: 900 !important;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .issue-title {
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 900 !important;
        line-height: 1.22;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .issue-hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        width: 100%;
        margin-top: 14px;
    }

    .issue-hero-actions .btn {
        min-width: max-content;
        max-width: 100%;
        min-height: 42px;
        border-radius: 999px !important;
        font-size: .95rem;
        font-weight: 900;
        line-height: 1.25;
        padding: .58rem 1.35rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        white-space: nowrap;
        box-shadow: 0 8px 18px rgba(20, 184, 166, .14);
    }

    .issue-hero .btn-primary {
        color: #062b2f !important;
        background: linear-gradient(135deg, #8df1e4, #23c7c8) !important;
        border-color: transparent !important;
    }

    .issue-hero .btn-outline-light {
        color: #fff !important;
        background: rgba(255,255,255,.08);
        border-color: rgba(255,255,255,.55) !important;
    }

    .issue-hero .btn-outline-light:hover {
        background: rgba(255,255,255,.18) !important;
    }

    .issue-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .issue-summary-card,
    .issue-panel {
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    }

    .issue-summary-card {
        padding: 14px 16px;
        min-height: 90px;
    }

    .issue-summary-card small {
        display: block;
        color: #000;
        font-size: 12px;
        font-weight: 900 !important;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .issue-summary-card b {
        color: #000;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.35;
        word-break: break-word;
    }

    .issue-summary-card .muted {
        color: #94a3b8;
    }

    .issue-content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 16px;
        margin-bottom: 18px;
    }

    .issue-detail-bottom {
        display: grid;
        gap: 16px;
        margin-bottom: 18px;
    }

    .issue-info-block {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 18px;
        padding: 14px;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #f8fafc;
    }

    .issue-info-line {
        min-width: 0;
        color: #000;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .issue-info-line .issue-info-label {
        display: inline-block;
        margin-right: 6px;
        color: #000;
        font-size: inherit;
        font-weight: 700;
        line-height: inherit;
        text-transform: uppercase;
    }

    .issue-info-value {
        color: #000;
        font-size: inherit;
        font-weight: 400 !important;
        line-height: inherit;
    }

    .issue-panel {
        padding: 18px;
    }

    .issue-panel h3 {
        color: #000;
        font-size: 18px;
        font-weight: 900;
        margin: 0 0 12px;
    }

    .issue-text-box {
        min-height: 150px;
        color: #000;
        font-weight: 400;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 14px;
        line-height: 1.65;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .issue-detail-text-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 12px;
        margin-top: 12px;
    }

    .issue-detail-text-block h4 {
        margin: 0 0 8px;
        color: #000;
        font-size: 14px;
        font-weight: 900;
    }

    .issue-gallery-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .issue-gallery-head .badge {
        border-radius: 999px;
    }

    .issue-gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
    }

    .issue-image-card {
        border: 1px solid #d8e3ef;
        background: #f8fafc;
        border-radius: 14px;
        overflow: hidden;
        padding: 8px;
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
    }

    .issue-image-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(15, 35, 64, .14);
    }

    .issue-image-card img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 10px;
        display: block;
    }

    .issue-empty {
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        color: #000;
        background: #f8fafc;
        padding: 18px;
        font-weight: 400;
        text-align: center;
    }

    .issue-git-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

    .issue-git-table th {
        padding: 0 10px;
        color: #475569;
        font-size: .9rem;
        font-weight: 700;
    }

    .issue-git-table td {
        padding: 10px;
        color: #000;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        font-weight: 400;
    }

    .issue-git-table td:first-child {
        border-left: 1px solid #e2e8f0;
        border-radius: 12px 0 0 12px;
    }

    .issue-git-table td:last-child {
        border-right: 1px solid #e2e8f0;
        border-radius: 0 12px 12px 0;
    }

    .issue-git-badge {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: 4px 10px;
        border-radius: 999px;
        color: #075985;
        background: #e0f2fe;
        font-size: .86rem;
        font-weight: 700;
    }

    .issue-git-id {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        overflow-wrap: anywhere;
    }

    .issue-detail-page :is(
        .issue-summary-card,
        .issue-summary-label,
        .issue-summary-value,
        .issue-info-line,
        .issue-info-label,
        .issue-info-value,
        .issue-text-box,
        .issue-empty
    ) {
        font-size: 1rem !important;
        line-height: 1.45 !important;
        letter-spacing: 0 !important;
    }

    .issue-detail-page :is(
        .issue-summary-label,
        .issue-info-label,
        .issue-panel h3,
        .issue-gallery-head h3,
        .issue-detail-text-block h4
    ) {
        color: #000 !important;
        font-size: 1rem !important;
        font-weight: 700 !important;
        line-height: 1.45 !important;
        letter-spacing: 0 !important;
        text-transform: none !important;
    }

    .issue-summary-label {
        display: block;
        margin-bottom: 6px;
    }

    .issue-detail-page :is(
        .issue-summary-value,
        .issue-info-value,
        .issue-text-box
    ) {
        color: #000 !important;
        font-size: 1rem !important;
        font-weight: 400 !important;
        line-height: 1.45 !important;
        letter-spacing: 0 !important;
    }

    @@media (max-width: 991.98px) {
        .issue-hero-top,
        .issue-content-grid {
            grid-template-columns: 1fr;
            display: grid;
        }

        .issue-hero-actions {
            justify-content: flex-start;
        }

        .issue-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .issue-info-block,
        .issue-detail-text-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .issue-summary-grid {
            grid-template-columns: 1fr;
        }

        .issue-hero-actions .btn {
            min-width: 0;
            width: 100%;
            white-space: normal;
        }

    }
</style>

<div class="issue-detail-page">
    <section class="issue-hero">
        <div class="issue-hero-top">
            <div class="issue-hero-main">
                <div class="issue-eyebrow">Project Issue #@(issue?.IssueId ?? 0)</div>
                <h1 class="issue-title">รายละเอียด Issue</h1>
            </div>

        </div>

        <div class="issue-hero-actions">
            <a asp-action="Index"
               asp-route-projectId="@issue?.ProjectId"
               class="btn btn-outline-light">
                ไปหน้า Issue
            </a>

            @if (issue != null && CanMenu("ProjectIssues.Edit"))
            {
                <a asp-action="Edit"
                   asp-route-id="@issue.IssueId"
                   asp-route-projectId="@issue.ProjectId"
                   class="btn btn-primary">
                    ไปหน้าแก้ไข
                </a>
            }
        </div>
    </section>

    <section class="issue-summary-grid">
        <div class="issue-summary-card">
            <span class="issue-summary-label">จำนวน FAIL</span>
            <span class="issue-summary-value">@((issue?.ReopenCount ?? 0) > 0 ? $"{issue?.ReopenCount} ครั้ง" : "0 ครั้ง")</span>
        </div>
        <div class="issue-summary-card">
            <span class="issue-summary-label">Images</span>
            <span class="issue-summary-value">@beforeImages.Count ก่อนแก้ / @afterImages.Count หลังแก้</span>
        </div>
    </section>

    <section class="issue-detail-bottom">
        <article class="issue-panel">
            <h3>ข้อมูล Issue</h3>
            <div class="issue-info-block">
                <div class="issue-info-line"><span class="issue-info-label">Project:</span><span class="issue-info-value">@TextOrDash(issue?.Project?.ProjectDisplayName)</span></div>
                <div class="issue-info-line"><span class="issue-info-label">Issue:</span><span class="issue-info-value">@(issue?.IssueName ?? "-")</span></div>
                <div class="issue-info-line"><span class="issue-info-label">Owner:</span><span class="issue-info-value">@TextOrDash(issue?.Employee?.EmpName)</span></div>
                <div class="issue-info-line"><span class="issue-info-label">Start Date:</span><span class="issue-info-value">@DateOrDash(issue?.StartDate)</span></div>
                <div class="issue-info-line"><span class="issue-info-label">End Date:</span><span class="issue-info-value">@DateOrDash(issue?.EndDate)</span></div>
                <div class="issue-info-line"><span class="issue-info-label">Issue Status:</span><span class="issue-info-value">@TextOrDash(issue?.IssueStatus)</span></div>
                <div class="issue-info-line"><span class="issue-info-label">Dev Status:</span><span class="issue-info-value">@TextOrDash(issue?.DevStatus)</span></div>
                <div class="issue-info-line"><span class="issue-info-label">Priority:</span><span class="issue-info-value">@TextOrDash(issue?.IssuePriority)</span></div>
            </div>
        </article>

        <article class="issue-panel">
            <h3>รายละเอียดปัญหา</h3>
            <div class="issue-text-box">@(string.IsNullOrWhiteSpace(issue?.IssueDetail) ? "-" : issue.IssueDetail)</div>
        </article>

        <article class="issue-panel">
            <h3>รายละเอียดการแก้ไข</h3>
            <div class="issue-text-box">@(string.IsNullOrWhiteSpace(issue?.DevDetail) ? "-" : issue.DevDetail)</div>
        </article>

        <article class="issue-panel">
            <h3>ประวัติ Git</h3>
            @if (gitHistories.Any())
            {
                <table class="issue-git-table">
                    <thead>
                        <tr>
                            <th>ประเภท</th>
                            <th>Git ID</th>
                            <th>วันที่บันทึก</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in gitHistories)
                        {
                            <tr>
                                <td><span class="issue-git-badge">@row.GitType</span></td>
                                <td class="issue-git-id">@row.GitId</td>
                                <td>@row.EntryDate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="issue-empty">ยังไม่มีประวัติ Git</div>
            }
        </article>
    </section>

    <section class="issue-content-grid">
        <article class="issue-panel">
            <div class="issue-gallery-head">
                <h3>รูปก่อนแก้</h3>
                <span class="badge bg-primary">@beforeImages.Count รูป</span>
            </div>

            @if (beforeImages.Count > 0)
            {
                <div class="issue-gallery-grid">
                    @foreach (var img in beforeImages)
                    {
                        <button type="button"
                                class="issue-image-card"
                                onclick="previewImage('@img.FilePath')"
                                aria-label="ดูรูปก่อนแก้">
                            <img src="@img.FilePath" alt="Issue image before fix" />
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="issue-empty">ไม่มีรูปก่อนแก้</div>
            }
        </article>

        <article class="issue-panel">
            <div class="issue-gallery-head">
                <h3>รูปหลังแก้</h3>
                <span class="badge bg-success">@afterImages.Count รูป</span>
            </div>

            @if (afterImages.Count > 0)
            {
                <div class="issue-gallery-grid">
                    @foreach (var img in afterImages)
                    {
                        <button type="button"
                                class="issue-image-card"
                                onclick="previewImage('@img.FilePath')"
                                aria-label="ดูรูปหลังแก้">
                            <img src="@img.FilePath" alt="Issue image after fix" />
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="issue-empty">ไม่มีรูปหลังแก้</div>
            }
        </article>
    </section>
</div>

<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark">
            <div class="modal-body text-center p-2">
                <img id="previewImage" src="" class="img-fluid rounded" alt="preview" />
            </div>
        </div>
    </div>
</div>

<script>
function prepareImagePreviewModal(modalId) {
    const modalEl = document.getElementById(modalId);
    if (!modalEl) return null;

    if (modalEl.parentElement !== document.body) {
        document.body.appendChild(modalEl);
    }

    document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
    document.body.classList.remove('modal-open');
    document.body.style.removeProperty('overflow');
    document.body.style.removeProperty('padding-right');

    modalEl.style.zIndex = '26010';
    return modalEl;
}

function previewImage(src){
    const img = document.getElementById("previewImage");
    img.src = src;

    const modalEl = prepareImagePreviewModal("imagePreviewModal");
    if (!modalEl) return;

    const modal = bootstrap.Modal.getOrCreateInstance(modalEl, {
        backdrop: true,
        keyboard: true
    });
    modal.show();

    window.setTimeout(function () {
        modalEl.style.zIndex = '26010';
        document.querySelectorAll('.modal-backdrop').forEach(function (backdrop) {
            backdrop.style.zIndex = '26000';
        });
    }, 0);
}
</script>

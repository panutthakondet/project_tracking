@model IEnumerable<ProjectTracking.Models.ProjectIssue>
@using System.Globalization

@{
    ViewData["Title"] = "แก้ไขสถานะปัญหาโครงการ";
    var selectedProject = ViewBag.SelectedProject as ProjectTracking.Models.Project;
    var selectedEmp = ViewBag.SelectedEmp as string;
    var empList = ViewBag.EmpList as IEnumerable<string> ?? Enumerable.Empty<string>();
    var projects = ViewBag.Projects as IEnumerable<ProjectTracking.Models.Project> ?? Enumerable.Empty<ProjectTracking.Models.Project>();
    var issueList = (Model ?? Enumerable.Empty<ProjectTracking.Models.ProjectIssue>()).ToList();
    var selectedStatus = ViewBag.SelectedStatus as string ?? "";
    var statusList = ViewBag.StatusList as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var th = new CultureInfo("th-TH");

    string DateOrDash(DateTime? value) => value?.ToString("dd MMM yyyy", th) ?? "-";
    string PeriodText(ProjectTracking.Models.ProjectIssue issue)
    {
        if (!issue.StartDate.HasValue && !issue.EndDate.HasValue) return "-";
        return $"{DateOrDash(issue.StartDate)} - {DateOrDash(issue.EndDate)}";
    }

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    string StatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "OPEN" => "bg-warning text-dark",
        "WIP" => "bg-info text-dark",
        "FIXED" => "bg-success",
        "PASS" => "bg-primary",
        "FAIL" => "bg-danger",
        "REJECT" => "bg-dark",
        _ => "bg-secondary"
    };

    string DevStatusClass(string? status) => (status ?? "").Trim().ToUpperInvariant() switch
    {
        "WIP" => "bg-info text-dark",
        "FIXED" => "bg-success",
        _ => "bg-secondary"
    };

    string ProfileImage(ProjectTracking.Models.Employee? employee)
    {
        var path = employee?.LoginUser?.ProfileImagePath;
        if (string.IsNullOrWhiteSpace(path)) return "/images/Profile/profile.png";

        path = path.Trim();
        if (path.StartsWith("~/", StringComparison.Ordinal)) path = path[1..];
        if (!path.StartsWith("/", StringComparison.Ordinal)) path = "/" + path.TrimStart('/');
        return path;
    }
}

<style>
    .dev-issue-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
    }

    .dev-issue-hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        color: #fff;
        background:
            radial-gradient(circle at 88% 10%, rgba(20, 184, 166, .28), transparent 28%),
            linear-gradient(135deg, #10233f, #1f3b63);
        border-radius: 22px;
        padding: 22px 24px;
        margin-bottom: 18px;
        box-shadow: 0 18px 40px rgba(15, 35, 64, .18);
    }

    .dev-issue-title {
        margin: 0;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 900;
        line-height: 1.25;
    }

    .dev-issue-subtitle {
        color: #d8e6f7;
        font-weight: 700;
        margin: 6px 0 0;
    }

    .dev-filter-card,
    .dev-issue-card,
    .dev-empty-card {
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15, 35, 64, .08);
    }

    .dev-filter-card {
        padding: 18px;
        margin-bottom: 16px;
    }

    .dev-issue-list {
        display: grid;
        gap: 14px;
    }

    .dev-issue-card {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(300px, .6fr);
        overflow: hidden;
        border-left: 5px solid #14b8a6;
    }

    .dev-issue-card.is-urgent {
        border-left-color: #ef4444;
    }

    .dev-issue-main,
    .dev-issue-side {
        padding: 18px;
        min-width: 0;
    }

    .dev-issue-side {
        border-left: 0;
        background: transparent;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-end;
        gap: 14px;
    }

    .dev-issue-head {
        display: block;
        margin-bottom: 10px;
    }

    .dev-issue-no {
        flex: 0 0 auto;
        min-width: 2.75rem;
        height: 2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        color: #062b2f;
        background: rgba(20, 184, 166, .18);
        font-weight: 700;
    }

    .dev-title-wrap {
        min-width: 0;
    }

    .dev-title-line {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 8px;
    }

    .dev-issue-name {
        display: block;
        color: #0f172a;
        font-size: .98rem;
        font-weight: 700;
        line-height: 1.35;
        word-break: break-word;
    }

    .dev-issue-detail {
        color: #0f172a;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: .93rem;
        font-weight: 400;
        line-height: 1.45;
        margin: .25rem 0 0;
        word-break: break-word;
    }

    .dev-issue-name strong,
    .dev-issue-detail strong {
        color: #0f172a;
        font-weight: 700;
    }

    .dev-issue-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 16px;
        color: #0f172a;
        font-size: .92rem;
        font-weight: 400;
        line-height: 1.35;
        margin-top: 8px;
    }

    .dev-issue-meta strong {
        color: #0f172a;
        font-weight: 700;
    }

    .dev-issue-people {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        align-items: center;
        gap: 10px 18px;
        margin: 10px 0 0;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: #0f172a;
        font-size: .95rem;
        font-weight: 400;
    }

    .dev-issue-person {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        color: #0f172a;
        font-weight: 400;
        line-height: 1.25;
    }

    .dev-issue-person img {
        width: 36px;
        height: 36px;
        flex: 0 0 auto;
        border: 1px solid #dbe6f3;
        border-radius: 50%;
        object-fit: cover;
        background: #fff;
    }

    .dev-issue-person span {
        overflow-wrap: anywhere;
    }

    .dev-issue-person strong {
        color: #0f172a;
        font-weight: 600;
    }

    .dev-status-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin-top: 10px;
        width: 100%;
    }

    .dev-status-row {
        min-width: 0;
        display: inline-flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
    }

    .dev-status-row small {
        color: #0f172a;
        font-size: .92rem;
        font-weight: 700;
        text-transform: none;
    }

    .dev-status-row small::after {
        content: ":";
    }

    .dev-status-row .badge {
        min-height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: normal;
        line-height: 1.15;
    }

    .dev-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
    }

    .dev-empty-card {
        color: #64748b;
        padding: 28px;
        text-align: center;
        font-weight: 800;
    }

    @@media (max-width: 991.98px) {
        .dev-issue-card {
            grid-template-columns: 1fr;
        }

        .dev-issue-side {
            border-left: 0;
            border-top: 0;
            align-items: stretch;
            padding-top: 0;
        }
    }
</style>

<div class="dev-issue-page">
    <div class="dev-issue-hero">
        <div>
            <h2 class="dev-issue-title">แก้ไขสถานะปัญหาโครงการ</h2>
            <p class="dev-issue-subtitle">โปรแกรมเมอร์อัปเดต Dev Status และผลการแก้ไข</p>
        </div>
    </div>

    <form method="get" id="filterForm" class="dev-filter-card">
        <div class="row g-3">
            <div class="@(selectedProject != null ? "col-md-4" : "col-md-6")">
                <label class="form-label fw-semibold">โครงการ</label>
                <select id="projectSelect" name="projectId" class="form-select" onchange="document.getElementById('filterForm').submit()">
                    <option value="">-- เลือกโครงการ --</option>
                    @foreach (var p in projects.OrderBy(x => x.Coop?.CoopName ?? "").ThenBy(x => x.ProjectName))
                    {
                        <option value="@p.ProjectId" selected="@(selectedProject?.ProjectId == p.ProjectId)">@p.ProjectDisplayName</option>
                    }
                </select>
            </div>

            @if (selectedProject != null)
            {
                <div class="col-md-4">
                    <label class="form-label fw-semibold">เจ้าของงาน</label>
                    <select name="empName" class="form-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (var emp in empList)
                        {
                            <option value="@emp" selected="@(emp == selectedEmp)">@emp</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">สถานะ</label>
                    <select name="status" class="form-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="">-- ทุกสถานะ --</option>
                        @foreach (var status in statusList)
                        {
                            <option value="@status.Value" selected="@(string.Equals(status.Value, selectedStatus, StringComparison.OrdinalIgnoreCase))">
                                @status.Text
                            </option>
                        }
                    </select>
                </div>
            }
        </div>
    </form>

    @if (selectedProject == null)
    {
        <div class="dev-empty-card">กรุณาเลือก Project เพื่อดูรายการ Issue</div>
    }
    else if (!issueList.Any())
    {
        <div class="dev-empty-card">ไม่พบรายการ Issue</div>
    }
    else
    {
        <div class="dev-issue-list">
            @{
                var row = 1;
            }

            @foreach (var i in issueList)
            {
                var urgent = string.Equals(i.IssuePriority, "URGENT", StringComparison.OrdinalIgnoreCase);

                <article class="dev-issue-card @(urgent ? "is-urgent" : "")">
                    <div class="dev-issue-main">
                        <div class="dev-issue-head">
                            <div class="dev-title-wrap">
                                <div class="dev-title-line">
                                    <span class="dev-issue-no">#@row</span>
                                </div>
                                <span class="dev-issue-name"><span class="pt-list-label">หัวข้อปัญหา:</span> <span class="pt-list-value">@TextOrDash(i.IssueName)</span></span>
                                <p class="dev-issue-detail"><span class="pt-list-label">รายละเอียดปัญหา:</span> <span class="pt-list-value">@(string.IsNullOrWhiteSpace(i.IssueDetail) ? "ไม่มีรายละเอียดเพิ่มเติม" : i.IssueDetail)</span></p>
                            </div>
                        </div>

                        <div class="dev-issue-meta">
                            <span><span class="pt-list-label">วันที่กำหนด:</span> <span class="pt-list-value">@PeriodText(i)</span></span>
                        </div>

                        <div class="dev-issue-people">
                            <span class="dev-issue-person">
                                <img class="pt-owner-avatar"
                                     src="@ProfileImage(i.Employee)"
                                     alt="@(i.Employee?.EmpName ?? "ผู้รับผิดชอบ")"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                                <span><span class="pt-list-label">ผู้รับผิดชอบ:</span> <span class="pt-list-value">@(i.Employee?.EmpName ?? "-")</span></span>
                            </span>
                        </div>

                        <div class="dev-status-grid">
                            <div class="dev-status-row">
                                <small class="pt-list-label">สถานะตรวจ</small>
                                <span class="badge @StatusClass(i.IssueStatus) pt-list-value">@i.IssueStatus</span>
                            </div>
                            <div class="dev-status-row">
                                <small class="pt-list-label">สถานะ Dev</small>
                                <span class="badge @DevStatusClass(i.DevStatus) pt-list-value">@i.DevStatus</span>
                            </div>
                            <div class="dev-status-row">
                                <small class="pt-list-label">ความสำคัญ</small>
                                <span class="badge @(urgent ? "bg-danger" : "bg-secondary") pt-list-value">
                                    @(urgent ? "URGENT" : "NORMAL")
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="dev-issue-side">
                        <div class="dev-actions">
                            <a asp-controller="ProjectIssues"
                               asp-action="DevDetails"
                               asp-route-id="@i.IssueId"
                               asp-route-projectId="@selectedProject.ProjectId"
                               class="btn btn-sm btn-outline-secondary">
                                ดูรายละเอียด
                            </a>
                            <a asp-action="DevEdit"
                               asp-route-id="@i.IssueId"
                               asp-route-projectId="@selectedProject.ProjectId"
                               class="btn btn-sm btn-outline-primary">
                                แก้ไข Dev
                            </a>
                        </div>
                    </div>
                </article>

                row++;
            }
        </div>
    }
</div>

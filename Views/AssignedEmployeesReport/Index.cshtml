@model IEnumerable<ProjectTracking.Models.PhaseAssign>
@using System.Globalization
@using System.Linq

@{
    ViewData["Title"] = "Assigned Employees Report";
    var th = new CultureInfo("th-TH");

    // 🎨 สีตาม Employee
    var empColorMap = new Dictionary<int, string>();
    var colors = new[]
    {
        "#f8f9fa", "#e9f5ff", "#eafaf1",
        "#fff4e6", "#f3e8ff", "#e7f1ff"
    };
    int colorIndex = 0;

    var menus = Context.Session.GetString("Menus") ?? "";
    var allowedMenus = menus.Split(',').Select(x => x.Trim()).ToList();

    bool HasMenu(string key)
    {
        return allowedMenus.Contains(key);
    }
}

<div class="index-hero">
    <div class="index-hero__content">
        <span class="index-eyebrow">ProjectTracking</span>
        <h2 class="index-title">Assigned Employees Report</h2>
        <p class="index-subtitle">รายงานพนักงานที่ถูกมอบหมายในแต่ละโครงการ</p>
    </div>
</div>

<!-- ================= FILTER ================= -->
<form method="get" class="row g-3 mb-4 no-print">

    <!-- PROJECT -->
    <div class="col-md-4">
        <label class="form-label fw-bold">📁 โครงการ</label>
        <select name="projectId" class="form-select" onchange="this.form.submit()">
            <option value="">-- เลือกโครงการ --</option>
            @foreach (var p in ViewBag.Projects)
            {
                <option value="@p.ProjectId"
                        selected="@(ViewBag.SelectedProjectId == p.ProjectId)">
                    @p.ProjectDisplayName
                </option>
            }
        </select>
    </div>

    <!-- EMPLOYEE -->
    <div class="col-md-4">
        <label class="form-label fw-bold">👤 Employee</label>
        <select name="empId" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Employees --</option>
            @foreach (var e in ViewBag.EmployeeList)
            {
                <option value="@e.EmpId"
                        selected="@(ViewBag.SelectedEmpId == e.EmpId)">
                    @e.EmpName
                </option>
            }
        </select>
    </div>

    <!-- ACTION -->
    <div class="col-md-4 align-self-end text-end">
        @if (HasMenu("AssignedEmployeesReport.Export"))
        {
            <a asp-action="Print"
               asp-route-projectId="@ViewBag.SelectedProjectId"
               asp-route-empId="@ViewBag.SelectedEmpId"
               target="_blank"
               class="btn btn-outline-secondary"
               title="พิมพ์รายงาน">
                🖨 Print
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary" disabled title="ไม่มีสิทธิ์พิมพ์รายงาน">
                🖨 Print
            </button>
        }
    </div>
</form>

<!-- ================= TABLE ================= -->
<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>Employee</th>
                <th>Role</th>
                <th>Plan Period</th>
                <th>Status</th>
                <th>Remark</th>
            </tr>
        </thead>

        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    — No assignment —
                </td>
            </tr>
        }
        else
        {
            foreach (var a in Model)
            {
                if (!empColorMap.ContainsKey(a.EmpId))
                {
                    empColorMap[a.EmpId] = colors[colorIndex % colors.Length];
                    colorIndex++;
                }

                var bg = empColorMap[a.EmpId];

                <tr style="background-color:@bg;">
                    <td class="fw-semibold">👤 @a.Employee?.EmpName</td>
                    <td style="white-space:normal;">@a.Role</td>
                    <td class="text-center">
                        @(a.PlanStart?.ToString("dd MMM yyyy", th) ?? "-")
                        –
                        @(a.PlanEnd?.ToString("dd MMM yyyy", th) ?? "-")
                    </td>
                    <td class="text-center">
                        <span class="badge @(a.WorkStatus == "DONE" ? "bg-success" : "bg-warning text-dark")">@a.StatusDescription</span>
                    </td>
                    <td style="white-space:normal;">@a.Remark</td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

<style>
@@media print {
    .no-print {
        display: none !important;
    }
    h2, h3,
    .project-group-row,
    .scenario-project__header,
    .scenario-group__header,
    .phase-project-group {
        break-after: avoid;
        page-break-after: avoid;
    }
    h2 + table,
    h2 + .empty,
    h2 + .report-table-scroll,
    h3 + table,
    h3 + .empty,
    .project-group-row + tr {
        break-before: avoid;
        page-break-before: avoid;
    }
    .report-section,
    .scenario-project,
    .scenario-group,
    .project-group-row,
    .phase-project-group {
        break-inside: avoid-page;
        page-break-inside: avoid;
    }
    thead {
        display: table-header-group;
    }
    tr {
        page-break-inside: avoid;
    }
}
</style>

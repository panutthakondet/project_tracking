@model IEnumerable<ProjectTracking.Models.PhaseAssign>
@using System.Globalization

@{
    Layout = null;
    var th = new CultureInfo("th-TH");

    var empColorMap = new Dictionary<int, string>();
    var colors = new[]
    {
        "#f8f9fa", "#e9f5ff", "#eafaf1",
        "#fff4e6", "#f3e8ff"
    };
    int colorIndex = 0;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Assigned Employees - Print</title>
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&display=swap");
        body {
            font-family: 'Prompt', Tahoma, Arial, sans-serif;
            font-size: 13px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            border: 1px solid #444;
            padding: 6px;
        }
        th {
            background: #222;
            color: #fff;
        }
        @@media print {
            @@page { margin: 1cm; }
            h2, h3,
            .project-group-row,
            .scenario-project__header,
            .scenario-group__header,
            .phase-project-group {
                break-after: avoid;
                page-break-after: avoid;
            }
            h2 + table,
            h2 + .empty,
            h2 + .report-table-scroll,
            h3 + table,
            h3 + .empty,
            .project-group-row + tr {
                break-before: avoid;
                page-break-before: avoid;
            }
            .report-section,
            .scenario-project,
            .scenario-group,
            .project-group-row,
            .phase-project-group {
                break-inside: avoid-page;
                page-break-inside: avoid;
            }
            thead { display: table-header-group; }
            tr { page-break-inside: avoid; }
        }
    
        /* Crisp typography normalization for standalone pages. */
        :root { --pt-readable-thai-font: "Noto Sans Thai", "Leelawadee UI", Tahoma, "Segoe UI", Arial, sans-serif; }
        html, body {
            font-family: var(--pt-readable-thai-font) !important;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }
        body :where(*):not(svg):not(svg *) {
            font-family: var(--pt-readable-thai-font) !important;
            font-stretch: normal !important;
            letter-spacing: 0 !important;
            text-shadow: none !important;
        }
        body :is(h1, h2, h3, h4, h5, h6, th, label, strong, b, .report-btn, .btn, .badge, .status-text, .cell-title, .project-group-name, [class*="title"], [class*="heading"], [class*="eyebrow"], [class*="status"], [class*="badge"], [class*="count"], [class*="total"], [class*="value"]) {
            font-weight: 700 !important;
        }
        body :is(p, li, td, small, em, time, .cell-sub, .detail-block div, .meta-label, .meta-value, .empty, [class*="detail"], [class*="meta"], [class*="subtitle"], [class*="description"], [class*="desc"], [class*="remark"], [class*="note"], [class*="empty"]):not(.btn):not(.badge):not(.status-text):not([class*="status-"]):not([class*="Status"]) {
            font-weight: 400 !important;
        }
</style>
</head>
<body>

<h2>📊 Assigned Employees Report</h2>
<p>Printed at : @DateTime.Now.ToString("dd MMM yyyy HH:mm", th)</p>

<table>
    <thead>
        <tr>
            <th>Employee</th>
            <th>Role</th>
            <th>Plan</th>
            <th>Status</th>
            <th>Remark</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var a in Model)
    {
        if (!empColorMap.ContainsKey(a.EmpId))
        {
            empColorMap[a.EmpId] = colors[colorIndex % colors.Length];
            colorIndex++;
        }

        var bg = empColorMap[a.EmpId];

        <tr style="background-color:@bg;">
            <td>@a.Employee?.EmpName</td>
            <td>@a.Role</td>
            <td>
                @(a.PlanStart?.ToString("dd MMM yyyy", th) ?? "-")
                –
                @(a.PlanEnd?.ToString("dd MMM yyyy", th) ?? "-")
            </td>
            <td class="text-center">
                @if (a.WorkStatus == "DONE")
                {
                    <span>
                        ✅ เสร็จสิ้น
                    </span>
                }
                else
                {
                    <span>
                        🟡 กำลังดำเนินการ
                    </span>
                }
            </td>
            <td>@a.Remark</td>
        </tr>
    }
    </tbody>
</table>

</body>
</html>

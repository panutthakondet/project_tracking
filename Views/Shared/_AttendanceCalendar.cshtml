<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" />
<section class="attendance-calendar-card" aria-labelledby="attendanceHolidayTitle">
    <div class="attendance-calendar-head">
        <div>
            <span class="attendance-eyebrow">วันหยุดและกำหนดการของฉัน</span>
            <h3 id="attendanceHolidayTitle">ปฏิทินวันหยุด การประชุม และงานเข้าไซต์</h3>
        </div>
        <div class="attendance-calendar-legends" aria-label="คำอธิบายสีปฏิทิน">
            <span class="attendance-holiday-legend"><span aria-hidden="true"></span> วันหยุด</span>
            <span class="attendance-meeting-legend"><span aria-hidden="true"></span> การประชุมของฉัน</span>
            <span class="attendance-field-service-legend"><span aria-hidden="true"></span> งานเข้าไซต์ของฉัน</span>
        </div>
    </div>
    <div id="attendanceHolidayCalendar"></div>
</section>
<style>
    .attendance-calendar-card { margin-top:8px; padding:22px; border:1px solid var(--pt-border,#d8e3ef); border-radius:22px; color:var(--pt-surface-contrast,#10233f); background:var(--pt-surface,#fff); box-shadow:0 14px 32px var(--pt-shadow,rgba(15,35,64,.08)); }
    .attendance-calendar-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:18px; }
    .attendance-calendar-head h3 { margin:4px 0 0; color:var(--pt-surface-contrast,#10233f); font-size:1.35rem; font-weight:700; line-height:1.25; }
    .attendance-calendar-head p { margin:6px 0 0; color:var(--pt-surface-contrast-muted,#64748b); font-weight:400; }
    .attendance-calendar-card .attendance-eyebrow { color:var(--pt-surface-contrast-muted,#64748b); font-size:.82rem; font-weight:600; }
    .attendance-calendar-legends { display:flex; align-items:center; justify-content:flex-end; flex-wrap:wrap; gap:14px; }
    .attendance-holiday-legend { display:inline-flex; align-items:center; gap:7px; color:var(--pt-surface-contrast-muted,#64748b); font-size:.9rem; white-space:nowrap; }
    .attendance-holiday-legend span { width:12px; height:12px; border:2px solid #ef4444; background:#fff7f7; }
    .attendance-meeting-legend { display:inline-flex; align-items:center; gap:7px; color:var(--pt-surface-contrast-muted,#64748b); font-size:.9rem; white-space:nowrap; }
    .attendance-meeting-legend span { width:12px; height:12px; border:2px solid var(--pt-accent,#2563eb); background:var(--pt-accent-soft,#eff6ff); }
    .attendance-field-service-legend { display:inline-flex; align-items:center; gap:7px; color:var(--pt-surface-contrast-muted,#64748b); font-size:.9rem; white-space:nowrap; }
    .attendance-field-service-legend span { width:12px; height:12px; border:2px solid #0d9488; background:#ccfbf1; }
    #attendanceHolidayCalendar { min-height:570px; }
    #attendanceHolidayCalendar .fc { color:var(--pt-surface-contrast,#10233f); font-family:inherit; font-size:.9rem; }
    #attendanceHolidayCalendar .fc-theme-standard td,
    #attendanceHolidayCalendar .fc-theme-standard th,
    #attendanceHolidayCalendar .fc-theme-standard .fc-scrollgrid { border-color:var(--pt-border,#dbe5ef); }
    #attendanceHolidayCalendar .fc-col-header-cell { padding:8px 4px; background:var(--pt-surface-soft,#f8fafc); }
    #attendanceHolidayCalendar .fc-col-header-cell-cushion,
    #attendanceHolidayCalendar .fc-daygrid-day-number { color:var(--pt-surface-contrast,#10233f); text-decoration:none; font-weight:500; }
    #attendanceHolidayCalendar .fc-day-today { background:var(--pt-accent-soft,rgba(20,184,166,.08)) !important; }
    #attendanceHolidayCalendar .fc-button-primary { border-color:var(--pt-accent,#14b8a6); background:var(--pt-accent-dark,#0f766e); box-shadow:none; font-weight:500; }
    #attendanceHolidayCalendar .fc-button-primary:hover,
    #attendanceHolidayCalendar .fc-button-primary:not(:disabled).fc-button-active { border-color:var(--pt-accent-dark,#0f766e); background:var(--pt-accent,#14b8a6); }
    #attendanceHolidayCalendar .fc-toolbar-title { color:var(--pt-surface-contrast,#10233f); font-size:1.2rem; font-weight:700; text-shadow:none; }
    #attendanceHolidayCalendar .fc-daygrid-event,
    #attendanceHolidayCalendar .fc-list-event { padding:3px 6px; border-width:2px !important; border-radius:4px; box-shadow:none; font-weight:500; }
    #attendanceHolidayCalendar .fc-daygrid-event,
    #attendanceHolidayCalendar .fc-daygrid-event .fc-event-main-frame,
    #attendanceHolidayCalendar .fc-daygrid-event .fc-event-title-container,
    #attendanceHolidayCalendar .fc-daygrid-event .fc-event-title {
        min-width:0;
        overflow:visible;
        white-space:normal !important;
    }
    #attendanceHolidayCalendar .fc-daygrid-event .fc-event-main-frame { display:block; }
    #attendanceHolidayCalendar .fc-daygrid-event .fc-event-title {
        line-height:1.3;
        overflow-wrap:anywhere;
        word-break:break-word;
    }
    #attendanceHolidayCalendar .attendance-meeting-event {
        border-color:var(--pt-accent,#2563eb) !important;
        color:var(--pt-surface-contrast,#10233f) !important;
        background:var(--pt-accent-soft,#eff6ff) !important;
    }
    #attendanceHolidayCalendar .attendance-meeting-event .fc-event-main { color:inherit !important; }
    #attendanceHolidayCalendar .attendance-field-service-event {
        border-color:#0d9488 !important;
        color:#111827 !important;
        background:#ccfbf1 !important;
    }
    #attendanceHolidayCalendar .attendance-field-service-event .fc-event-main { color:inherit !important; }
    #attendanceHolidayCalendar .fc-list { border-color:var(--pt-border,#dbe5ef); }
    #attendanceHolidayCalendar .fc-list-day-cushion,
    #attendanceHolidayCalendar .fc-list-event:hover td { background:var(--pt-surface-soft,#f8fafc); }
    .attendance-calendar-card { --pt-local-text:var(--pt-surface-contrast,#10233f); --pt-local-muted:var(--pt-surface-contrast-muted,#64748b); }
    @@media (max-width:768px) {
        .attendance-calendar-head { flex-direction:column; }
        .attendance-calendar-card { padding:14px; }
        #attendanceHolidayCalendar { min-height:500px; }
        #attendanceHolidayCalendar .fc-header-toolbar { align-items:stretch; flex-direction:column; gap:10px; }
        #attendanceHolidayCalendar .fc-toolbar-chunk { display:flex; justify-content:center; }
    }
</style>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/locales-all.global.min.js"></script>
<script>
(() => {
    function initializeHolidayCalendar() {
        const element = document.getElementById('attendanceHolidayCalendar');
        if (!element || typeof FullCalendar === 'undefined') return;

        const thaiMonths = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน', 'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'];
        const calendar = new FullCalendar.Calendar(element, {
            locale: 'th',
            initialView: window.matchMedia('(max-width: 767.98px)').matches ? 'listMonth' : 'dayGridMonth',
            firstDay: 0,
            height: 'auto',
            fixedWeekCount: false,
            dayMaxEvents: true,
            displayEventTime: true,
            eventTimeFormat: {
                hour: '2-digit',
                minute: '2-digit',
                hour12: false
            },
            eventDisplay: 'block',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,listMonth'
            },
            buttonText: {
                today: 'วันนี้',
                month: 'เดือน',
                list: 'รายการ'
            },
            events: '@Url.Action("HolidayEvents", "Attendance")',
            eventDidMount: function (info) {
                info.el.title = info.event.title;
            },
            datesSet: function () {
                window.requestAnimationFrame(function () {
                    const title = element.querySelector('.fc-toolbar-title');
                    if (!title) return;
                    const current = calendar.getDate();
                    title.textContent = `${thaiMonths[current.getMonth()]} ${current.getFullYear() + 543}`;
                });
            }
        });

        calendar.render();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeHolidayCalendar);
    else initializeHolidayCalendar();
})();
</script>

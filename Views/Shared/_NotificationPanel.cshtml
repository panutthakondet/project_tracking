<section id="notificationPanel" class="notification-panel" role="dialog" aria-modal="false" aria-labelledby="notificationPanelTitle" hidden
         data-list-url="@Url.Action("List","WorkNotifications")" data-read-url="@Url.Action("Read","WorkNotifications")"
         data-push-key-url="@Url.Action("PushKey","WorkNotifications")" data-subscribe-url="@Url.Action("Subscribe","WorkNotifications")" data-unsubscribe-url="@Url.Action("Unsubscribe","WorkNotifications")">
    <div class="notification-panel-head"><h2 id="notificationPanelTitle">การแจ้งเตือน</h2><button type="button" data-notification-close aria-label="ปิดการแจ้งเตือน">×</button></div>
    <div class="notification-actions"><button type="button" data-notification-read-all>อ่านทั้งหมด</button><button type="button" data-push-enable>เปิดแจ้งเตือนบนอุปกรณ์</button><button type="button" data-push-disable hidden>ปิดแจ้งเตือนอุปกรณ์นี้</button></div>
    <p class="notification-status" data-notification-status role="status" aria-live="polite"></p>
    <div class="notification-list" data-notification-list></div>
    <button type="button" class="notification-more" data-notification-more hidden>โหลดเพิ่มเติม</button>
</section>
<form id="notificationsAntiforgery" hidden>@Html.AntiForgeryToken()</form>

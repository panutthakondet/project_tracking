<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectTracking</title>

    <!-- ✅ Google Font (Thai): Sarabun -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- ✅ SELECT2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)

    <style>
        /* ✅ Global Font */
        :root {
            --pt-accent: #14b8a6;
            --pt-accent-dark: #0f766e;
            --pt-accent-deep: #0d5f59;
            --pt-accent-soft: rgba(20, 184, 166, .18);
            --pt-accent-glow: rgba(20, 184, 166, .30);
        }

        body {
            font-family: 'Sarabun', system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif;
            overflow-x: hidden;
        }
        .navbar {
            background: linear-gradient(135deg, #1f2933, #111827);
            box-shadow: 0 6px 18px rgba(0,0,0,.35);
            padding: 10px 18px;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 20px;
            letter-spacing: .4px;
            color: #ffb347 !important;
        }

        .navbar-brand:hover { color: #ffd27f !important; }

        /* ===== MENU STYLE ===== */
        .navbar-dark .navbar-nav .nav-link{
            font-weight:600;
            font-size: 14px;
            color:#e5e7eb !important;
            padding:6px 10px !important;
            border-radius:10px;
            transition:all .18s ease-in-out;
            line-height: 1.2;
        }

        /* ✅ Keep top-level nav compact (avoid ugly wrapping) */
        .navbar-dark .navbar-nav .nav-link,
        .navbar-dark .navbar-nav .dropdown-toggle{
            white-space: nowrap;
        }

        /* ✅ If label is long, truncate with ellipsis (still readable on hover) */
        .navbar-dark .navbar-nav .dropdown-toggle{
            max-width: 230px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* ✅ Dropdown items can wrap normally */
        .dropdown-item{
            white-space: normal;
            line-height: 1.25;
        }

        /* ✅ Make dropdown a bit wider for Thai labels */
        .nav-item.dropdown .dropdown-menu{
            min-width: 280px;
        }

        /* ✅ Slightly tighter navbar on small screens */
        @@media (max-width: 992px){
            .navbar { padding: 8px 12px; }
            .navbar-dark .navbar-nav .nav-link{ padding:8px 10px !important; }
            .navbar-dark .navbar-nav .dropdown-toggle{ max-width: none; }
        }

        /* ===== HOVER (แก้ Bootstrap override) ===== */
        .navbar.navbar-dark .navbar-nav .nav-link:hover,
        .navbar.navbar-dark .navbar-nav .nav-link:focus,
        .navbar.navbar-dark .navbar-nav .show > .nav-link{
            background:rgba(20,184,166,.18) !important;
            color:#fff !important;
            transform:translateY(-1px);
        }

        /* ===== ACTIVE PAGE ===== */
        .navbar.navbar-dark .navbar-nav .nav-link.active-menu{
            background:linear-gradient(135deg,var(--pt-accent),var(--pt-accent-dark)) !important;
            color:#fff !important;
            font-weight:700;
        }

        /* ===== DROPDOWN ===== */
        .nav-item.dropdown .dropdown-menu {
            background: #1f2933;
            border-radius: 14px;
            border: 1px solid #2d3748;
            box-shadow: 0 12px 30px rgba(0,0,0,.4);
            padding: 8px;
        }

        .dropdown-item {
            color: #e5e7eb;
            border-radius: 10px;
            padding: 10px 14px;
            transition: all .18s;
        }

        .dropdown-item:hover {
            background: rgba(20,184,166,.18);
            color: #fff;
            font-weight: 600;
        }

        .navbar-text {
            background: rgba(255,255,255,.08);
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 600;
        }

        .btn-logout {
            border-radius: 20px;
            padding: 6px 14px;
            font-weight: 600;
            border: 1px solid var(--pt-accent);
            color: var(--pt-accent);
            transition: all .2s;
        }

        .btn-logout:hover {
            background: var(--pt-accent);
            color: #062b2f;
        }

        footer.footer-modern {
            margin-top: 40px;
            background: linear-gradient(135deg, #1f2933, #111827);
            color: #cbd5e1;
            border-top: 1px solid rgba(255,255,255,.08);
            box-shadow: 0 -6px 18px rgba(0,0,0,.12);
        }

        .footer-modern .footer-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 18px 8px;
            flex-wrap: wrap;
        }

        .footer-modern .footer-brand {
            font-size: 14px;
            font-weight: 700;
            color: var(--pt-accent);
        }

        .footer-modern .footer-text {
            font-size: 13px;
            color: #cbd5e1;
        }

        .footer-modern .footer-version {
            background: rgba(255,255,255,.08);
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 12px;
            color: #e5e7eb;
        }

        @@media (max-width:768px){
            .footer-modern .footer-content {
                justify-content: center;
                text-align: center;
            }
        }

        /* ===== Select2: FIX WRAP + ALIGN (เหมาะกับข้อความยาว/หน้า Print) ===== */

        /* ให้ container เต็ม */
        .select2-container { width: 100% !important; }

        /* กล่องเลือก: ให้สูงขั้นต่ำ 38 แต่ยืดได้ */
        .select2-container--default .select2-selection--single{
            min-height: 38px !important;
            height: auto !important;
            border: 1px solid #cbd5e1;
            border-radius: .375rem;
            display: flex !important;
            align-items: center !important;
            padding: 6px 40px 6px 12px !important;  /* กันพื้นที่ให้ arrow + clear */
            box-sizing: border-box;
            position: relative; /* ✅ สำคัญ: ให้ arrow/clear absolute อิงกล่องนี้ */
        }

        /* ข้อความที่เลือก: wrap ได้ */
        .select2-container--default .select2-selection--single .select2-selection__rendered{
            white-space: normal !important;
            line-height: 1.35 !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* ลูกศร: จัดให้อยู่กลาง */
        .select2-container--default .select2-selection--single .select2-selection__arrow{
            position: absolute !important;
            top: 50% !important;
            transform: translateY(-50%) !important;
            right: 10px !important;
            height: 20px !important;
        }

        /* ปุ่ม clear (x): จัดให้อยู่กลาง และไม่ทับข้อความ */
        .select2-container--default .select2-selection--single .select2-selection__clear{
            position: absolute !important;
            top: 50% !important;
            transform: translateY(-50%) !important;
            right: 32px !important; /* อยู่ซ้ายลูกศร */
            margin: 0 !important;
            font-size: 22px !important;
            line-height: 1 !important;
        }

        /* dropdown รายการ: ให้ wrap เหมือนเดิม */
        .select2-results__option{
            white-space: normal !important;
            line-height: 1.35 !important;
            padding-top: .45rem;
            padding-bottom: .45rem;
        }

        /* custom search: ให้เข้าธีมและขนาดพอดี */
        .s2-custom-search-wrap{
            padding: 8px !important;
            border-bottom: 1px solid #e5e7eb !important;
            background: #fff !important;
        }
        .s2-custom-search{
            width: 100% !important;
            height: 36px !important;
            padding: 6px 10px !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: .375rem !important;
            box-sizing: border-box !important;
        }

        .select2-container--default.select2-container--focus .select2-selection--single,
        .select2-container--default.select2-container--open .select2-selection--single,
        .s2-custom-search:focus {
            border-color: var(--pt-accent) !important;
            box-shadow: 0 0 0 4px var(--pt-accent-soft) !important;
            outline: none !important;
        }

        .select2-container--default .select2-results__option--highlighted[aria-selected],
        .select2-container--default .select2-results__option--selected {
            background: var(--pt-accent) !important;
            color: #062b2f !important;
        }

        .nav-count-badge{
            float:right;
            min-width:20px;
            height:20px;
            border-radius:999px;
            display:inline-flex;
            align-items:center;
            justify-content:center;
            margin-left:8px;
            padding:0 7px;
            background:#dc3545;
            color:#fff;
            font-size:11px;
            line-height:20px;
            font-weight:800;
        }
        /* ===== V2 DASHBOARD LAYOUT ===== */
.v2-shell{
    display:flex;
    min-height:100vh;
    background:#eef3f9;
}

.v2-sidebar{
    width:280px;
    background:linear-gradient(180deg,#02173c 0%, #062356 55%, #03132d 100%);
    position:fixed;
    left:0;
    top:0;
    height:100vh;
    overflow:hidden;
    color:#fff;
    z-index:1000;
    border-top-right-radius:34px;
    border-bottom-right-radius:34px;
    box-shadow:10px 0 30px rgba(0,0,0,.22);
    padding-bottom:0;
}

.v2-sidebar .container-fluid{
    display:flex !important;
    flex-direction:column !important;
    align-items:stretch !important;
    width:100%;
    padding:0 !important;
}

.v2-profile-card{
    text-align:center;
    padding:22px 24px 18px;
}

.v2-avatar{
    width:150px;
    height:150px;
    border-radius:50%;
    margin:0 auto 18px;
    border:5px solid rgba(255,255,255,.18);
    box-shadow:0 16px 36px rgba(0,0,0,.35);
    overflow:hidden;
    background:#0f172a;
}

.v2-profile-name{
    font-size:20px;
    font-weight:800;
    color:#fff;
    line-height:1.35;
    margin-bottom:4px;
}

.v2-profile-role{
    color:#d8e2f1;
    font-size:16px;
    font-weight:500;
}

.v2-online-badge{
    margin-top:10px;
    display:inline-block;
    background:rgba(16,185,129,.18);
    color:#86efac;
    padding:8px 16px;
    border-radius:999px;
    font-size:14px;
    font-weight:700;
}

.sidebar-logo{
    display:flex;
    align-items:center;
    gap:14px;
    margin:8px 18px 26px;
    padding:0 12px;
    color:white;
}

.sidebar-logo-icon{
    width:58px;
    height:58px;
    border-radius:18px;
    background:linear-gradient(135deg,#22d3ee,#14b8a6);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:28px;
    box-shadow:0 10px 24px rgba(20,184,166,.28);
}

.sidebar-logo-text{
    font-size:22px;
    font-weight:800;
    white-space:nowrap;
}

.v2-sidebar header{
    padding-top:8px;
}

.v2-page{
    flex:1;
    margin-left:280px;
    width:calc(100% - 280px);
    max-width:calc(100vw - 280px);
    min-width:0;
    padding:16px 24px;
}

.v2-page .container{
    max-width:100%;
    min-width:0;
    padding:0;
}

.navbar{
    background:transparent !important;
    box-shadow:none !important;
    display:block !important;
    padding:18px !important;
}

.navbar-collapse{
    display:block !important;
    width:100%;
}

/* ===== LEFT MENU LIKE REFERENCE ===== */
.navbar-nav{
    display:flex !important;
    flex-direction:column !important;
    width:100%;
    gap:6px;
    margin:0 !important;
    padding:8px 14px 18px !important;
}

.nav-item{
    width:100%;
}

.navbar-dark .navbar-nav .nav-link,
.navbar-dark .navbar-nav .dropdown-toggle{
    width:100%;
    min-height:52px;
    display:flex;
    align-items:center;
    justify-content:flex-start;
    padding:13px 18px !important;
    border-radius:18px;
    font-size:15px;
    font-weight:600;
    color:#ffffff !important;
    background:transparent;
    transition:all .2s ease;
}

.navbar-dark .navbar-nav .nav-link:hover,
.navbar-dark .navbar-nav .show > .nav-link{
    background:rgba(255,255,255,.06) !important;
    color:#fff !important;
}

.navbar-dark .navbar-nav .nav-link.active-menu{
    background:linear-gradient(135deg,var(--pt-accent),var(--pt-accent-dark)) !important;
    color:#fff !important;
    box-shadow:0 12px 26px var(--pt-accent-glow);
}

.dropdown-toggle::after{
    margin-left:auto !important;
    opacity:.8;
}

.dropdown-menu{
    position:relative !important;
    inset:auto !important;
    transform:none !important;
    width:100%;
    background:transparent !important;
    border:none !important;
    border-radius:0 !important;
    margin:0 !important;
    padding:4px 0 8px 18px !important;
}

.dropdown-item{
    color:#cfd9ea !important;
    font-size:13px;
    font-weight:500;
    border-radius:12px;
    padding:8px 14px;
}

.dropdown-item:hover{
    background:rgba(255,255,255,.06) !important;
    color:#fff !important;
}

.navbar-nav::after{
    content:'';
    display:block;
    height:1px;
    background:rgba(255,255,255,.08);
    margin:18px 10px 14px;
    flex-shrink:0;
}

/* ===== DASHBOARD REFERENCE SIDEBAR POLISH ===== */
.v2-shell{
    background:#eaf1fa;
}

.v2-sidebar{
    width:286px;
    border-radius:0;
    overflow-y:auto;
    overflow-x:hidden;
    background:
        radial-gradient(circle at 50% 118%, rgba(17,213,205,.2) 0 34%, transparent 35%),
        linear-gradient(180deg,#032245 0%, #062b57 48%, #031934 100%);
    box-shadow:10px 0 34px rgba(3,18,42,.24);
    scrollbar-width: thin;
    scrollbar-color: var(--pt-accent-dark) rgba(3,25,52,.9);
}

.v2-sidebar::-webkit-scrollbar {
    width: 8px;
}

.v2-sidebar::-webkit-scrollbar-track {
    background: rgba(3,25,52,.9);
}

.v2-sidebar::-webkit-scrollbar-thumb {
    background: var(--pt-accent-dark);
    border-radius: 999px;
    border: 2px solid rgba(3,25,52,.9);
}

.v2-sidebar::-webkit-scrollbar-thumb:hover {
    background: var(--pt-accent);
}

.v2-sidebar::before{
    content:"";
    position:absolute;
    inset:0;
    pointer-events:none;
    background:
        radial-gradient(circle at 50% 7%, rgba(16,211,209,.14), transparent 28%),
        linear-gradient(90deg, rgba(255,255,255,.05), transparent 20%, transparent 80%, rgba(0,0,0,.18));
}

.v2-profile-card{
    position:relative;
    z-index:1;
    padding:16px 22px 14px;
}

.v2-avatar{
    width:162px;
    height:162px;
    border:3px solid #18e4d8;
    box-shadow:0 0 0 4px rgba(24,228,216,.13), 0 18px 34px rgba(0,0,0,.36);
    position:relative;
}

.v2-avatar img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
}

.v2-profile-upload-form{
    margin:0;
}

.v2-profile-input{
    position:absolute;
    width:1px;
    height:1px;
    opacity:0;
    pointer-events:none;
}

.v2-avatar-upload{
    position:absolute;
    right:10px;
    bottom:10px;
    width:36px;
    height:36px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#06224a;
    background:rgba(255,255,255,.92);
    border:1px solid rgba(255,255,255,.8);
    box-shadow:0 10px 18px rgba(0,0,0,.22);
    cursor:pointer;
    z-index:2;
    transition:all .18s ease;
}

.v2-avatar-upload:hover{
    transform:translateY(-1px);
    background:#fff;
}

.v2-avatar-upload svg{
    width:19px;
    height:19px;
    fill:none;
    stroke:currentColor;
    stroke-width:2;
    stroke-linecap:round;
    stroke-linejoin:round;
}

.profile-crop-modal{
    position:fixed;
    inset:0;
    z-index:20000;
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
    background:rgba(3,12,30,.72);
    backdrop-filter:blur(8px);
}

.profile-crop-modal.is-open{
    display:flex;
}

.profile-crop-dialog{
    width:min(520px, 100%);
    border-radius:22px;
    padding:22px;
    color:#eaf5ff;
    background:linear-gradient(180deg, rgba(15,35,75,.98), rgba(8,22,49,.98));
    border:1px solid rgba(255,255,255,.14);
    box-shadow:0 28px 70px rgba(0,0,0,.42);
}

.profile-crop-head{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:14px;
    margin-bottom:16px;
}

.profile-crop-head h3{
    margin:0;
    color:#fff;
    font-size:20px;
    font-weight:900;
}

.profile-crop-head p{
    margin:4px 0 0;
    color:#a9bad8;
    font-size:13px;
    font-weight:700;
}

.profile-crop-close{
    width:34px;
    height:34px;
    border:0;
    border-radius:50%;
    color:#dbeafe;
    background:rgba(255,255,255,.1);
    font-size:24px;
    line-height:1;
}

.profile-crop-stage{
    position:relative;
    width:min(320px, 80vw);
    height:min(320px, 80vw);
    margin:0 auto 16px;
    overflow:hidden;
    border-radius:50%;
    cursor:grab;
    touch-action:none;
    background:#07162f;
    box-shadow:0 0 0 6px rgba(20,184,166,.18), 0 18px 44px rgba(0,0,0,.35);
}

.profile-crop-stage:active{
    cursor:grabbing;
}

.profile-crop-stage img{
    position:absolute;
    left:0;
    top:0;
    max-width:none;
    user-select:none;
    -webkit-user-drag:none;
}

.profile-crop-stage::after{
    content:"";
    position:absolute;
    inset:0;
    border-radius:50%;
    border:3px solid rgba(255,255,255,.9);
    box-shadow:inset 0 0 0 999px rgba(255,255,255,.03);
    pointer-events:none;
}

.profile-crop-controls{
    display:grid;
    gap:8px;
    margin:0 auto 18px;
    max-width:360px;
}

.profile-crop-controls label{
    color:#cbd5e1;
    font-size:13px;
    font-weight:800;
}

.profile-crop-controls input{
    accent-color:var(--pt-accent);
}

.profile-crop-actions{
    display:flex;
    justify-content:flex-end;
    gap:10px;
}

.profile-crop-actions .btn{
    min-width:92px;
    border-radius:999px !important;
    font-weight:800;
}


                                    <span class="nav-ico" aria-hidden="true"><img src="/images/menu-icons/projects.svg" alt="" /></span>
                                    <span class="nav-label">Projects</span>
                                </a>
                                <ul class="dropdown-menu">
                                    @if (CanMenu("Projects.Index"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Projects" asp-action="Index">บันทึกข้อมูลโครงการ</a></li>
                                    }
                                    @if (CanMenu("Projects.ViewOnly"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Projects" asp-action="ViewOnly">รายงานข้อมูลโครงการ</a></li>
                                    }
                                    @if (CanMenu("ProjectDocuments.Index"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="ProjectDocuments" asp-action="Index">เอกสารโครงการ (BRD / TOR)</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (CanMenu("ProjectPhases.Index") || CanMenu("PhaseStatusReport.Index") || CanMenu("PhaseStatusReport.Timeline") || CanMenu("PhaseCalendar.Index"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(
                                    controller=="ProjectPhases" 
                                    || controller=="PhaseStatusReport"
                                    || controller=="PhaseCalendar"
                                    ? "active-menu" : "")"
                                   href="#" role="button" data-bs-toggle="dropdown">
                                    <span class="nav-ico" aria-hidden="true"><img src="/images/menu-icons/phases.svg" alt="" /></span>
                                    <span class="nav-label">Project Phases</span>
                                </a>
                                <ul class="dropdown-menu">
                                    @if (CanMenu("ProjectPhases.Index"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="ProjectPhases" asp-action="Index">บันทึกข้อมูลงวดงาน</a></li>
                                    }
                                    @if (CanMenu("PhaseStatusReport.Index"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="PhaseStatusReport" asp-action="Index">รายงานสถานะงานค้าง</a></li>
                                    }
                                    @if (CanMenu("PhaseStatusReport.Timeline"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="PhaseStatusReport" asp-action="Timeline">Timeline / Gantt</a></li>
                                    }
                                    @if (CanMenu("PhaseCalendar.Index"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="PhaseCalendar" asp-action="Index">ปฏิทินกำหนดส่งงาน</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (CanMenu("PhaseAssigns.Index"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller=="PhaseAssigns" && action!="Print" ? "active-menu" : "")" asp-controller="PhaseAssigns" asp-action="Index">
                                    <span class="nav-ico" aria-hidden="true"><img src="/images/menu-icons/assign.svg" alt="" /></span>
                                    <span class="nav-label">Assign Phase</span>
                                </a>
                            </li>
                        }

                        @if (CanMenu("Meetings.Index"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller=="Meetings" ? "active-menu" : "")" asp-controller="Meetings" asp-action="Index">
                                    <span class="nav-ico" aria-hidden="true"><img src="/images/menu-icons/meetings.svg" alt="" /></span>
                                    <span class="nav-label">Meetings</span>
                                </a>
                            </li>
                        }

                        @if (canIssues)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(controller=="ProjectIssues" ? "active-menu" : "")"
                                   href="#" role="button" data-bs-toggle="dropdown">
                                    <span class="nav-ico" aria-hidden="true"><img src="/images/menu-icons/issues.svg" alt="" /></span>
                                    <span class="nav-label">Issues</span>
                                </a>
                                <ul class="dropdown-menu">
                                    @if (CanMenu("ProjectIssues.Index"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="ProjectIssues" asp-action="Index">บันทึกข้อมูลปัญหาโครงการ</a></li>
                                    }
                                    @if (CanMenu("ProjectIssues.ViewOnly"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="ProjectIssues" asp-action="ViewOnly">รายงานปัญหาและสถานะโครงการ</a></li>
                                    }
                                    @if (CanMenu("ProjectIssues.DevIndex"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="ProjectIssues" asp-action="DevIndex">แก้ไขสถานะปัญหาโครงการ</a></li>
                                    }
                                    @if (CanMenu("SupportOrders.Index"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="SupportOrders" asp-action="Index">งานแก้ไขช่วงรับประกัน</a></li>
                                    }
                                    @if (CanMenu("SupportOrdersDev.Index"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="SupportOrdersDev" asp-action="Index">งานแก้ไขช่วงรับประกัน (Dev)</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (CanMenu("Attendance.Index") || CanMenu("Attendance.Map"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(controller=="Attendance" ? "active-menu" : "")"
                                   href="#" role="button" data-bs-toggle="dropdown">
                                    <span class="nav-ico" aria-hidden="true"><img src="/images/menu-icons/attendance.svg" alt="" /></span>
                                    <span class="nav-label">Attendance</span>
                                </a>
                                <ul class="dropdown-menu">
                                    @if (CanMenu("Attendance.Index"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Attendance" asp-action="Index">เช็คเข้าออกงาน</a></li>
                                    }
                                    @if (CanMenu("Attendance.Map"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Attendance" asp-action="Map">รายงาน Check-in/Check-out</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (canFollowups)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(controller=="Followups" ? "active-menu" : "")"
                                   href="#" role="button" data-bs-toggle="dropdown">
                                    <span class="nav-ico" aria-hidden="true"><img src="/images/menu-icons/followups.svg" alt="" /></span>
                                    <span class="nav-label">Followups</span>
                                </a>
                                <ul class="dropdown-menu">
                                    @if (CanMenu("Followups.Dashboard"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Followups" asp-action="Dashboard">
                                                ติดตามงาน Followups
                                                @if (followupAlertCount > 0)
                                                {
                                                    <span class="nav-count-badge">@followupAlertCount</span>
                                                }
                                            </a>
                                        </li>
                                    }
                                    @if (CanMenu("Followups.DashboardDone"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Followups" asp-action="DashboardDone">
                                                ติดตามงานเสร็จแล้ว
                                                @if (followupDoneCount > 0)
                                                {
                                                    <span class="nav-count-badge">@followupDoneCount</span>
                                                }
                                            </a>
                                        </li>
                                    }
                                    @if (CanMenu("Followups.DashboardACK"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Followups" asp-action="DashboardACK">
                                                ติดตามงานรับทราบแล้ว
                                                @if (followupAckCount > 0)
                                                {
                                                    <span class="nav-count-badge">@followupAckCount</span>
                                                }
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (canReports)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(
                                    ((controller=="PhaseAssigns" && action=="Print") || controller=="PhaseStatusReport" || controller=="PhaseWorkload")
                                        ? "active-menu" : "")"
                                   href="#" role="button" data-bs-toggle="dropdown">
                                    <span class="nav-ico" aria-hidden="true"><img src="/images/menu-icons/reports.svg" alt="" /></span>
                                    <span class="nav-label">Reports</span>
                                </a>
                                <ul class="dropdown-menu">
                                    @if (CanMenu("PhaseAssigns.Print"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="PhaseAssigns" asp-action="Print">รายงานการมอบหมายงาน</a></li>
                                    }
                                    @if (CanMenu("PhaseStatusReport.Index"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="PhaseStatusReport" asp-action="Index">รายงานสถานะงานค้าง</a></li>
                                    }
                                    @if (CanMenu("PhaseStatusReport.Timeline"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="PhaseStatusReport" asp-action="Timeline">Timeline / Gantt</a></li>
                                    }
                                    @if (CanMenu("Projects.ViewOnly"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Projects" asp-action="ViewOnly">รายงานข้อมูลโครงการ</a></li>
                                    }
                                    @if (CanMenu("PhaseWorkload.Index"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="PhaseWorkload" asp-action="Index">ปริมาณงานทีม</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (CanMenu("UserManagement.Index"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller=="UserManagement" ? "active-menu" : "")" asp-controller="UserManagement" asp-action="Index">
                                    <span class="nav-ico" aria-hidden="true"><img src="/images/menu-icons/settings.svg" alt="" /></span>
                                    <span class="nav-label">Settings</span>
                                </a>
                            </li>
                        }

                        <li class="nav-spacer" aria-hidden="true"></li>
                        <li class="nav-item">
                            <a class="nav-link nav-logout" asp-controller="Auth" asp-action="Logout">
                                <span class="nav-ico" aria-hidden="true"><img src="/images/menu-icons/logout.svg" alt="" /></span>
                                <span class="nav-label">Logout</span>
                            </a>
                        </li>

                    </ul>

                }
                else
                {
                    <ul class="navbar-nav mb-2 mb-lg-0" style="width:100%;">
                        <li class="nav-item">
                            <a class="nav-link @(controller=="Home" || controller=="ProjectStatus" ? "active-menu":"")" asp-controller="Home" asp-action="Index">
                                <span class="nav-ico" aria-hidden="true"><img src="/images/menu-icons/dashboard.svg" alt="" /></span>
                                <span class="nav-label">Dashboard</span>
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a class="btn btn-logout btn-sm" asp-controller="Auth" asp-action="Login">Login</a>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>
</header>
</aside>

<div id="profileCropModal" class="profile-crop-modal" aria-hidden="true">
    <div class="profile-crop-dialog" role="dialog" aria-modal="true" aria-labelledby="profileCropTitle">
        <div class="profile-crop-head">
            <div>
                <h3 id="profileCropTitle">จัดตำแหน่งรูปโปรไฟล์</h3>
                <p>ลากรูปเพื่อขยับตำแหน่ง และปรับซูมให้ได้ส่วนที่ต้องการ</p>
            </div>
            <button type="button" class="profile-crop-close" onclick="closeProfileCropper()" aria-label="ปิด">×</button>
        </div>
        <div id="profileCropStage" class="profile-crop-stage">
            <img id="profileCropImage" alt="" />
        </div>
        <div class="profile-crop-controls">
            <label for="profileCropZoom">ซูมรูป</label>
            <input id="profileCropZoom" type="range" min="1" max="3" step="0.01" value="1" />
        </div>
        <div class="profile-crop-actions">
            <button type="button" class="btn btn-outline-light" onclick="closeProfileCropper()">ยกเลิก</button>
            <button type="button" class="btn btn-primary" onclick="submitProfileCrop()">บันทึก</button>
        </div>
    </div>
</div>

<div class="v2-page">

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

 </div>

<footer class="footer-modern">
    <div class="container">
        <div class="footer-content">

            <div>
                <div class="footer-brand">ProjectTracking</div>
                <div class="footer-text">
                    © 2026 <strong>#C</strong> By <strong>SO-AT SOLUTION</strong>
                </div>
            </div>

            <div class="footer-version">
                Version 1.0
            </div>

        </div>
    </div>
</footer>


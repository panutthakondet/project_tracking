<script>
function closeLoginFollowupModal() {
    const modal = document.getElementById('loginFollowupModal');
    if (modal) modal.remove();
}

document.addEventListener('DOMContentLoaded', function () {
    const modal = document.getElementById('loginFollowupModal');
    if (!modal) return;

    modal.addEventListener('click', function (event) {
        if (event.target === modal) closeLoginFollowupModal();
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeLoginFollowupModal();
    });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const sidebar = document.querySelector('.v2-sidebar');
    const responsiveSidebar = window.matchMedia('(max-width: 1100px) and (min-width: 721px)');

    if (!sidebar) return;

    function shouldUseOverlayMenu() {
        return responsiveSidebar.matches;
    }

    function expandSidebar() {
        if (shouldUseOverlayMenu()) {
            sidebar.classList.add('sidebar-expanded');
        }
    }

    function collapseSidebar() {
        sidebar.classList.remove('sidebar-expanded');
    }

    sidebar.querySelectorAll('.nav-item.dropdown').forEach(function (item) {
        item.addEventListener('show.bs.dropdown', expandSidebar);
        item.addEventListener('hidden.bs.dropdown', function () {
            window.setTimeout(function () {
                if (!sidebar.querySelector('.dropdown-menu.show')) {
                    collapseSidebar();
                }
            }, 0);
        });
    });

    sidebar.querySelectorAll('.dropdown-item').forEach(function (item) {
        item.addEventListener('click', collapseSidebar);
    });

    document.addEventListener('pointerdown', function (event) {
        if (!shouldUseOverlayMenu()) return;
        if (!sidebar.classList.contains('sidebar-expanded')) return;
        if (!sidebar.contains(event.target)) collapseSidebar();
    });

    responsiveSidebar.addEventListener('change', function () {
        if (!shouldUseOverlayMenu()) collapseSidebar();
    });
});
</script>

<script>
(function () {
    const modal = document.getElementById('profileCropModal');
    const stage = document.getElementById('profileCropStage');
    const cropImage = document.getElementById('profileCropImage');
    const zoomInput = document.getElementById('profileCropZoom');
    const croppedInput = document.getElementById('croppedProfileImageInput');

    const cropState = {
        input: null,
        naturalWidth: 0,
        naturalHeight: 0,
        baseScale: 1,
        zoom: 1,
        x: 0,
        y: 0,
        dragging: false,
        startX: 0,
        startY: 0,
        originX: 0,
        originY: 0
    };

    function stageSize() {
        return stage ? stage.clientWidth : 320;
    }

    function currentScale() {
        return cropState.baseScale * cropState.zoom;
    }

    function clampPosition() {
        const size = stageSize();
        const scale = currentScale();
        const width = cropState.naturalWidth * scale;
        const height = cropState.naturalHeight * scale;

        cropState.x = width <= size
            ? (size - width) / 2
            : Math.min(0, Math.max(size - width, cropState.x));

        cropState.y = height <= size
            ? (size - height) / 2
            : Math.min(0, Math.max(size - height, cropState.y));
    }

    function renderCropImage() {
        if (!cropImage) return;

        const scale = currentScale();
        cropImage.style.width = `${cropState.naturalWidth * scale}px`;
        cropImage.style.height = `${cropState.naturalHeight * scale}px`;
        cropImage.style.transform = `translate(${cropState.x}px, ${cropState.y}px)`;
    }

    function setupCropImage() {
        const size = stageSize();
        cropState.naturalWidth = cropImage.naturalWidth;
        cropState.naturalHeight = cropImage.naturalHeight;
        cropState.baseScale = Math.max(size / cropState.naturalWidth, size / cropState.naturalHeight);
        cropState.zoom = 1;
        cropState.x = (size - cropState.naturalWidth * cropState.baseScale) / 2;
        cropState.y = (size - cropState.naturalHeight * cropState.baseScale) / 2;
        if (zoomInput) zoomInput.value = '1';
        clampPosition();
        renderCropImage();
    }

    window.openProfileCropper = function (input) {
        if (!input || !input.files || input.files.length === 0) return;

        const file = input.files[0];
        if (!file.type || !file.type.startsWith('image/')) {
            input.form.submit();
            return;
        }

        cropState.input = input;
        if (croppedInput) croppedInput.value = '';

        const reader = new FileReader();
        reader.onload = function (event) {
            cropImage.onload = setupCropImage;
            cropImage.src = event.target.result;
            modal.classList.add('is-open');
            modal.setAttribute('aria-hidden', 'false');
        };
        reader.readAsDataURL(file);
    };

    window.closeProfileCropper = function () {
        if (modal) {
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
        }
        if (cropState.input) cropState.input.value = '';
        if (croppedInput) croppedInput.value = '';
        cropState.input = null;
    };

    window.submitProfileCrop = function () {
        if (!cropState.input || !cropImage || cropState.naturalWidth <= 0) return;

        const size = stageSize();
        const scale = currentScale();
        const sourceSize = size / scale;
        const sourceX = Math.max(0, -cropState.x / scale);
        const sourceY = Math.max(0, -cropState.y / scale);

        const canvas = document.createElement('canvas');
        canvas.width = 512;
        canvas.height = 512;
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(cropImage, sourceX, sourceY, sourceSize, sourceSize, 0, 0, canvas.width, canvas.height);

        if (croppedInput) {
            croppedInput.value = canvas.toDataURL('image/jpeg', 0.92);
        }

        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        cropState.input.disabled = true;
        cropState.input.form.submit();
    };

    if (stage) {
        stage.addEventListener('pointerdown', function (event) {
            event.preventDefault();
            cropState.dragging = true;
            cropState.startX = event.clientX;
            cropState.startY = event.clientY;
            cropState.originX = cropState.x;
            cropState.originY = cropState.y;
            stage.setPointerCapture(event.pointerId);
        });

        stage.addEventListener('pointermove', function (event) {
            if (!cropState.dragging) return;
            cropState.x = cropState.originX + event.clientX - cropState.startX;
            cropState.y = cropState.originY + event.clientY - cropState.startY;
            clampPosition();
            renderCropImage();
        });

        stage.addEventListener('pointerup', function (event) {
            cropState.dragging = false;
            stage.releasePointerCapture(event.pointerId);
        });

        stage.addEventListener('pointercancel', function () {
            cropState.dragging = false;
        });
    }

    if (zoomInput) {
        zoomInput.addEventListener('input', function () {
            const size = stageSize();
            const oldScale = currentScale();
            const centerX = (size / 2 - cropState.x) / oldScale;
            const centerY = (size / 2 - cropState.y) / oldScale;

            cropState.zoom = parseFloat(zoomInput.value || '1');
            const newScale = currentScale();
            cropState.x = size / 2 - centerX * newScale;
            cropState.y = size / 2 - centerY * newScale;
            clampPosition();
            renderCropImage();
        });
    }

    window.addEventListener('resize', function () {
        if (!modal || !modal.classList.contains('is-open') || cropState.naturalWidth <= 0) return;
        setupCropImage();
    });
})();
</script>



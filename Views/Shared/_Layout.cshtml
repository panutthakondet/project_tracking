    color:#fff !important;
}

.navbar.navbar-dark .navbar-nav .nav-link.active-menu{
    color:#fff !important;
    background:linear-gradient(135deg,var(--pt-accent),var(--pt-accent-dark)) !important;
    box-shadow:0 12px 24px var(--pt-accent-glow);
}

.nav-ico{
    width:28px;
    height:28px;
    flex:0 0 28px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    color:currentColor;
    font-size:26px;
}

.nav-ico svg,
.nav-ico img{
    width:28px;
    height:28px;
}

.nav-ico img{
    display:block;
    object-fit:contain;
}

.nav-ico svg{
    fill:none;
    stroke:currentColor;
    stroke-width:2;
    stroke-linecap:round;
    stroke-linejoin:round;
}

.nav-label{
    min-width:0;
    overflow:hidden;
    text-overflow:ellipsis;
}

.dropdown-toggle::after{
    border:solid currentColor;
    border-width:0 2px 2px 0;
    width:8px;
    height:8px;
    transform:rotate(45deg);
    opacity:.9;
}

.dropdown-menu{
    padding:3px 0 7px 43px !important;
}

.dropdown-item{
    padding:7px 13px;
    color:#d6e4fb !important;
    font-size:13px;
    font-weight:800;
}

.dropdown-item:hover{
    transform:translateX(2px);
    background:rgba(255,255,255,.08) !important;
}

.nav-spacer{
    flex:1 1 auto;
    min-height:20px;
    margin:10px 10px 8px;
    border-top:1px solid rgba(255,255,255,.18);
}

.nav-logout{
    margin-top:2px;
}

@@media (max-width: 1100px){
    .v2-sidebar{
        width:92px;
    }

    .v2-page{
        margin-left:92px;
        width:calc(100% - 92px);
        max-width:calc(100vw - 92px);
        padding:16px 16px 24px;
    }

    .v2-profile-card{
        padding:18px 12px 12px;
    }

    .v2-avatar{
        width:58px;
        height:58px;
        border-width:2px;
    }

    .v2-avatar-upload,
    .v2-profile-name,
    .v2-profile-role-row,
    .nav-label,
    .dropdown-toggle::after{
        display:none;
    }

    .navbar{
        padding:0 10px 14px !important;
    }

    .navbar-dark .navbar-nav .nav-link,
    .navbar-dark .navbar-nav .dropdown-toggle{
        justify-content:center;
        border-radius:18px;
        padding:12px !important;
        gap:0;
    }

    .dropdown-menu{
        padding:4px 0 8px !important;
    }

    .dropdown-item{
        text-align:center;
        font-size:11px;
        padding:8px 4px;
    }
}

@@media (max-width: 720px){
    .v2-shell{
        display:block;
    }

    .v2-sidebar{
        position:relative;
        width:100%;
        height:auto;
        min-height:0;
    }

    .v2-page{
        margin-left:0;
        width:100%;
        max-width:100vw;
        padding:14px 12px 22px;
    }

    .v2-profile-card{
        display:none;
    }

    .navbar{
        padding:10px !important;
    }

    .navbar-nav{
        min-height:0;
        display:grid !important;
        grid-template-columns:repeat(5, minmax(0, 1fr));
        gap:6px;
        padding:0 !important;
    }

    .nav-spacer{
        display:none;
    }
}


        /* ===== PRINT ONLY: ซ่อน navbar/footer ตอนสั่งพิมพ์จริง (ยังแสดงบนหน้าจอ) ===== */
        @@media print {
            header, .navbar, footer { display: none !important; }
        }
    </style>
</head>
<body>
<div class="v2-shell">

@{
    var userId = Context.Session.GetInt32("UserId");
    var username = Context.Session.GetString("Username");
    var profileImagePath = Context.Session.GetString("ProfileImagePath");
    if (string.IsNullOrWhiteSpace(profileImagePath))
    {
        profileImagePath = "/images/Profile/profile.png";
    }
    var currentReturnUrl = Context.Request.Path + Context.Request.QueryString;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    // ✅ หน้า Print: ซ่อนเมนูเฉพาะตอนสั่งพิมพ์จริง (ใช้ @media print) ไม่ซ่อนตอนดูบนหน้าจอ
    var isPrint = (controller == "PhaseAssigns" && action == "Print");

    // ✅ Permission for navbar (same logic as Home)
    var role = (Context?.Session?.GetString("Role") ?? "").Trim().ToUpperInvariant();
    var isAdmin = role == "ADMIN";

    var menuRaw = (Context?.Session?.GetString("Menus") ?? "").Trim();
    var allowedMenus = new HashSet<string>(
        menuRaw.Split(',', StringSplitOptions.RemoveEmptyEntries)
               .Select(x => x.Trim()),
        StringComparer.OrdinalIgnoreCase
    );

    bool CanMenu(string key) => isAdmin || allowedMenus.Contains(key);

    // ✅ Group visibility (show dropdown when there is at least 1 allowed item)
    var canDashboards = CanMenu("IssueDashboard.Index") || CanMenu("Dashboard.Workload") || CanMenu("Dashboard.Index");

    var canManagement = CanMenu("Employees.Index")
                     || CanMenu("Projects.Index")
                     || CanMenu("ProjectPhases.Index")
                     || CanMenu("PhaseAssigns.Index")
                     || CanMenu("Meetings.Index")
                     || CanMenu("TestScenarios.Index")
                     || CanMenu("TestScenarioTemplates.Index")
                     || CanMenu("TestTemplateGroups.Index")
                     || CanMenu("ProjectDocuments.Index");

    var canIssues = CanMenu("ProjectIssues.Index")
                 || CanMenu("ProjectIssues.ViewOnly")
                 || CanMenu("ProjectIssues.DevIndex")
                 || CanMenu("ProjectIssues.Details")
                 || CanMenu("ProjectIssues.DevDetails")
                 || CanMenu("SupportOrders.Index")
                 || CanMenu("SupportOrdersDev.Index");

    var canReports = CanMenu("PhaseAssigns.Print")
                  || CanMenu("PhaseStatusReport.Index")
                  || CanMenu("PhaseStatusReport.Timeline")
                  || CanMenu("Projects.ViewOnly")
                  || CanMenu("PhaseWorkload.Index");

    var canFollowups = CanMenu("Followups.Dashboard")
                    || CanMenu("Followups.DashboardDone")
                    || CanMenu("Followups.DashboardACK");

    var followupAlertCount = Convert.ToInt32(ViewBag?.FollowupAlertCount ?? 0);
    var followupDoneCount = Convert.ToInt32(ViewBag?.FollowupDoneCount ?? 0);
    var followupAckCount = Convert.ToInt32(ViewBag?.FollowupAckCount ?? 0);
}

<aside class="v2-sidebar">
    <div class="v2-profile-card">
        <form asp-controller="Auth"
              asp-action="UpdateProfileImage"
              method="post"
              enctype="multipart/form-data"
              class="v2-profile-upload-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
            <input type="hidden" id="croppedProfileImageInput" name="croppedProfileImage" />

            <div class="v2-avatar">
                <img src="@profileImagePath"
                     alt="profile"
                     onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                @if (userId != null)
                {
                    <label class="v2-avatar-upload" for="profileImageInput" title="เปลี่ยนรูปโปรไฟล์" aria-label="เปลี่ยนรูปโปรไฟล์">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 7h3l2-3h6l2 3h3v13H4z" />
                            <path d="M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                        </svg>
                    </label>
                    <input id="profileImageInput"
                           class="v2-profile-input"
                           type="file"
                           name="profileImage"
                           accept="image/png,image/jpeg,image/webp"
                           onchange="openProfileCropper(this)" />
                }
            </div>
        </form>
        <div class="v2-profile-name">@(string.IsNullOrWhiteSpace(username) ? "ผู้ใช้งาน" : username)</div>
        <div class="v2-profile-role-row">
            <span class="v2-profile-role">@(role == "ADMIN" ? "Administrator" : "Developer")</span>
        </div>
        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="v2-profile-flash">@TempData["ProfileSuccess"]</div>
        }
        @if (TempData["ProfileError"] != null)
        {
            <div class="v2-profile-flash error">@TempData["ProfileError"]</div>
        }
    </div>

<header>
    <nav class="navbar navbar-expand-lg navbar-dark mb-3">
        <div class="container-fluid">




            <div class="navbar-collapse show" id="navbarMain" style="display:block !important;">
                @if (userId != null)
                {
                    <ul class="navbar-nav mb-2 mb-lg-0" style="width:100%;">

                        <li class="nav-item">
                            <a class="nav-link @(controller=="Home" || controller=="ProjectStatus" ? "active-menu":"")" asp-controller="Home" asp-action="Index">
                                <span class="nav-ico" aria-hidden="true"><img src="/images/menu-icons/dashboard.svg" alt="" /></span>
                                <span class="nav-label">Dashboard</span>
                            </a>
                        </li>

                        @if (CanMenu("Projects.Index") || CanMenu("Projects.ViewOnly") || CanMenu("ProjectDocuments.Index"))
                        {
                            <li class="nav-item dropdown">

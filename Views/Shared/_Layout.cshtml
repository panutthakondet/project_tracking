@if (systemUpdateAnnouncements.Count > 0)
{
    <div id="systemUpdateModal" class="system-update-backdrop is-open" role="dialog" aria-modal="true" aria-labelledby="systemUpdateTitle">
        <div class="system-update-dialog">
            <div class="system-update-head">
                <div class="system-update-eyebrow">ProjectTracking Update</div>
                <h2 id="systemUpdateTitle">มีอะไรใหม่</h2>
                <p>ระบบได้รับการอัปเดตให้ใช้งานดีขึ้น ดูว่ามีอะไรใหม่ กดรับทราบเพื่อไม่ให้ประกาศนี้แสดงซ้ำ</p>
            </div>

            <div class="system-update-list">
                @foreach (var update in systemUpdateAnnouncements)
                {
                    var detailLines = (update.Details ?? "")
                        .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
                        .Select(line => line.Trim())
                        .Where(line => !string.IsNullOrWhiteSpace(line))
                        .ToList();

                    <article class="system-update-item">
                        <div class="system-update-meta">
                            @if (!string.IsNullOrWhiteSpace(update.Version))
                            {
                                <span class="system-update-chip">@update.Version</span>
                            }
                            <span class="system-update-chip muted">@update.PublishedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <h3>@update.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(update.Summary))
                        {
                            <p class="system-update-summary">@update.Summary</p>
                        }
                        @if (detailLines.Count > 0)
                        {
                            <ul class="system-update-details">
                                @foreach (var line in detailLines)
                                {
                                    <li>@line.TrimStart('-', '•', ' ')</li>
                                }
                            </ul>
                        }
                    </article>
                }
            </div>

            <form class="system-update-actions" asp-controller="SystemUpdates" asp-action="Acknowledge" method="post">
                @Html.AntiForgeryToken()
                @foreach (var update in systemUpdateAnnouncements)
                {
                    <input type="hidden" name="updateIds" value="@update.UpdateId" />
                }
                <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                <button type="submit" class="system-update-ack">รับทราบแล้ว</button>
            </form>
        </div>
    </div>
}

@if (loginFollowups.Count > 0)
{
    var today = DateTime.Today;
    var overdueCount = loginFollowups.Count(followup => followup.NextFollowupDate?.Date < today);
    var todayCount = loginFollowups.Count(followup => followup.NextFollowupDate?.Date == today);
    var upcomingCount = loginFollowups.Count - overdueCount - todayCount;

    string FollowupDateText(DateTime? date)
    {
        if (date == null) return "ยังไม่กำหนดวัน";
        return date.Value.ToString("dd/MM/yyyy");
    }

    string FollowupItemClass(DateTime? date)
    {
        if (date?.Date < today) return "is-overdue";
        if (date?.Date == today) return "is-today";
        return "";
    }

    string FollowupChipClass(DateTime? date)
    {
        if (date?.Date < today) return "danger";
        if (date?.Date == today) return "warning";
        return "";
    }

    <div id="loginFollowupModal" class="login-followup-backdrop" role="dialog" aria-modal="true" aria-labelledby="loginFollowupTitle">
        <div class="login-followup-dialog">
            <div class="login-followup-head">
                <div>
                    <div class="login-followup-eyebrow">Followups Reminder</div>
                    <h2 id="loginFollowupTitle">งาน Followup ของคุณ</h2>
                    <p>
                        @(string.IsNullOrWhiteSpace(loginFollowupOwnerName) ? "รายการงานติดตามที่ยังต้องดำเนินการ" : loginFollowupOwnerName)
                    </p>
                </div>
                <button type="button" class="login-followup-close" onclick="closeLoginFollowupModal()" aria-label="ปิด">×</button>
            </div>

            <div class="login-followup-summary">
                <span><strong>@overdueCount</strong>เลยกำหนด</span>
                <span><strong>@todayCount</strong>วันนี้</span>
                <span><strong>@upcomingCount</strong>รอติดตาม</span>
            </div>

            <div class="login-followup-list">
                @foreach (var followup in loginFollowups)
                {
                    <a class="login-followup-item @FollowupItemClass(followup.NextFollowupDate)"
                       asp-controller="Followups"
                       asp-action="Details"
                       asp-route-id="@followup.FollowupId">
                        <span class="login-followup-content">
                            <h3 class="login-followup-title">@followup.TaskTitle</h3>
                            <span class="login-followup-meta">
                                <span>@(followup.Project?.ProjectName ?? "ไม่ระบุโครงการ")</span>
                                @if (!string.IsNullOrWhiteSpace(followup.PartnerName))
                                {
                                    <span>คู่ติดต่อ: @followup.PartnerName</span>
                                }
                            </span>
                        </span>
                        <span class="login-followup-chip @FollowupChipClass(followup.NextFollowupDate)">
                            @FollowupDateText(followup.NextFollowupDate)
                        </span>
                    </a>
                }
            </div>

            <div class="login-followup-actions">
                <button type="button" class="btn btn-outline-secondary" onclick="closeLoginFollowupModal()">ปิด</button>
                <a class="btn btn-primary"
                   asp-controller="Followups"
                   asp-action="Dashboard"
                   asp-route-owner="@loginFollowupOwnerName">ดู Followups</a>
            </div>
        </div>
    </div>
}


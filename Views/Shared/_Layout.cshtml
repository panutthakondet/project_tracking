</head>
<body>
@{
    var layoutController = ViewContext.RouteData.Values["controller"]?.ToString();
    var layoutAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isStandaloneCalendarPage =
        (string.Equals(layoutController, "Meetings", StringComparison.OrdinalIgnoreCase) && string.Equals(layoutAction, "Index", StringComparison.OrdinalIgnoreCase)) ||
        (string.Equals(layoutController, "PhaseCalendar", StringComparison.OrdinalIgnoreCase) && string.Equals(layoutAction, "Index", StringComparison.OrdinalIgnoreCase)) ||
        (string.Equals(layoutController, "PhaseWorkload", StringComparison.OrdinalIgnoreCase) && string.Equals(layoutAction, "Index", StringComparison.OrdinalIgnoreCase));
}
<div class="v2-shell @(isStandaloneCalendarPage ? "v2-shell-standalone" : "")">

@{
    var userId = Context.Session.GetInt32("UserId");
    var username = Context.Session.GetString("Username");
    var profileImagePath = Context.Session.GetString("ProfileImagePath");
    if (string.IsNullOrWhiteSpace(profileImagePath))
    {
        profileImagePath = "/images/Profile/profile.png";
    }
    var currentReturnUrl = Context.Request.Path + Context.Request.QueryString;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var systemUpdateAnnouncements = new List<ProjectTracking.Models.SystemUpdateAnnouncement>();
    var showLoginFollowupPopup = Context.Session.GetString("ShowLoginFollowupPopup") == "1";
    var loginFollowups = new List<ProjectTracking.Models.ProjectFollowup>();
    var loginFollowupOwnerName = "";
    var unreadNotificationCount = 0;

    if (userId != null)
    {
        try
        {
            systemUpdateAnnouncements = await LayoutDb.SystemUpdateAnnouncements
                .AsNoTracking()
                .Where(update => update.IsActive
                    && !LayoutDb.SystemUpdateReads.Any(read =>
                        read.UpdateId == update.UpdateId &&
                        read.UserId == userId.Value))
                .OrderByDescending(update => update.PublishedAt)
                .ThenByDescending(update => update.UpdateId)
                .Take(5)
                .ToListAsync();
        }
        catch
        {
            systemUpdateAnnouncements = new List<ProjectTracking.Models.SystemUpdateAnnouncement>();
        }

        if (showLoginFollowupPopup && systemUpdateAnnouncements.Count == 0)
        {
            try
            {
                var loginEmployee = await LayoutDb.Employees
                    .AsNoTracking()
                    .FirstOrDefaultAsync(emp => emp.LoginUserId == userId.Value);

                if (loginEmployee != null)
                {
                    loginFollowupOwnerName = loginEmployee.EmpName ?? "";
                    loginFollowups = await LayoutDb.ProjectFollowups
                        .AsNoTracking()
                        .Include(followup => followup.Project)
                        .Where(followup => followup.OwnerEmpId == loginEmployee.EmpId
                            && (followup.Status == null ||
                                (followup.Status.ToUpper() != "DONE" && followup.Status.ToUpper() != "ACK")))
                        .OrderBy(followup => followup.NextFollowupDate == null)
                        .ThenBy(followup => followup.NextFollowupDate)
                        .ThenByDescending(followup => followup.CreatedAt)
                        .Take(12)
                        .ToListAsync();
                }
            }
            catch
            {
                loginFollowups = new List<ProjectTracking.Models.ProjectFollowup>();
            }
            finally
            {
                Context.Session.Remove("ShowLoginFollowupPopup");
            }
        }
    }

    // ✅ หน้า Print: ซ่อนเมนูเฉพาะตอนสั่งพิมพ์จริง (ใช้ @media print) ไม่ซ่อนตอนดูบนหน้าจอ
    var isPrint = (controller == "PhaseAssigns" && action == "Print");

    // ✅ Permission for navbar (same logic as Home)
    var role = (Context?.Session?.GetString("Role") ?? "").Trim().ToUpperInvariant();
    var isAdmin = role == "ADMIN" || role == "ADMINISTRATOR";

    if (userId != null)
    {
        try
        {
            var notificationQuery = LayoutDb.UserNotifications
                .AsNoTracking()
                .Where(notification => !notification.IsResolved && !notification.IsRead);

            if (!isAdmin)
            {
                notificationQuery = notificationQuery.Where(notification => notification.RecipientUserId == userId.Value);
            }

            unreadNotificationCount = await notificationQuery.CountAsync();
        }
        catch
        {
            unreadNotificationCount = 0;
        }
    }

    var menuRaw = (Context?.Session?.GetString("Menus") ?? "").Trim();
    var allowedMenus = new HashSet<string>(
        menuRaw.Split(',', StringSplitOptions.RemoveEmptyEntries)
               .Select(x => x.Trim()),
        StringComparer.OrdinalIgnoreCase
    );

	    bool CanMenu(string key) => isAdmin || allowedMenus.Contains(key);
	    var canProjectStatus = CanMenu("Home.Index");

    // ✅ Group visibility (show dropdown when there is at least 1 allowed item)
    var canManagement = CanMenu("Employees.Index")
                     || CanMenu("Projects.Index")
                     || CanMenu("ProjectPhases.Index")
                     || CanMenu("PhaseAssigns.Index")
                     || CanMenu("Meetings.Index")
                     || CanMenu("TestScenarios.Index")
                     || CanMenu("TestScenarioTemplates.Index")
                     || CanMenu("TestTemplateGroups.Index")
                     || CanMenu("ProjectDocuments.Index");

    var canIssues = CanMenu("ProjectIssues.Index")
                 || CanMenu("ProjectIssues.DevIndex");

    var canSupport = CanMenu("SupportOrders.Index")
                  || CanMenu("SupportOrdersDev.Index");

	    var canTestScenarios = CanMenu("TestScenarios.Index")
	                         || CanMenu("TestScenarioTemplates.Index")
	                         || CanMenu("TestTemplateGroups.Index");

	    var canAssignPhase = CanMenu("PhaseAssigns.Index")
	                        || CanMenu("PhaseWorkload.Index");

	    var canReports = CanMenu("Reports.Index");

    var canFollowups = CanMenu("Followups.Index")
                    || CanMenu("Followups.Dashboard")
                    || CanMenu("Followups.DashboardDone")
                    || CanMenu("Followups.DashboardACK");

    var followupAlertCount = Convert.ToInt32(ViewBag?.FollowupAlertCount ?? 0);
    var followupDoneCount = Convert.ToInt32(ViewBag?.FollowupDoneCount ?? 0);
    var followupAckCount = Convert.ToInt32(ViewBag?.FollowupAckCount ?? 0);
}

<aside class="v2-sidebar">
    <div class="v2-profile-card">
        <form asp-controller="Auth"
              asp-action="UpdateProfileImage"
              method="post"
              enctype="multipart/form-data"
              class="v2-profile-upload-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
            <input type="hidden" id="croppedProfileImageInput" name="croppedProfileImage" />

            <div class="v2-avatar">
                <img src="@profileImagePath"
                     alt="profile"
                     onerror="this.onerror=null;this.src='/images/Profile/profile.png';" />
                @if (userId != null)
                {
                    <label class="v2-avatar-upload" for="profileImageInput" title="เปลี่ยนรูปโปรไฟล์" aria-label="เปลี่ยนรูปโปรไฟล์">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 7h3l2-3h6l2 3h3v13H4z" />
                            <path d="M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                        </svg>
                    </label>
                    <input id="profileImageInput"
                           class="v2-profile-input"
                           type="file"

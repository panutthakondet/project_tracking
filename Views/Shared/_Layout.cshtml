@using Microsoft.EntityFrameworkCore
@inject ProjectTracking.Data.AppDbContext LayoutDb
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectTracking</title>

    <!-- ✅ Google Font (Thai): Sarabun -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- ✅ SELECT2 CSS -->
    @RenderSection("Styles", required: false)

    <style>
        /* ✅ Global Font */
        :root {
            --pt-accent: #14b8a6;
            --pt-accent-dark: #0f766e;
            --pt-accent-deep: #0d5f59;
            --pt-accent-soft: rgba(20, 184, 166, .18);
            --pt-accent-glow: rgba(20, 184, 166, .30);
            --pt-font-family: 'Sarabun', system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans Thai", "Noto Sans", "Liberation Sans", sans-serif;
            --pt-control-font-size: 1rem;
            --bs-body-font-family: var(--pt-font-family);
            --bs-font-sans-serif: var(--pt-font-family);
        }

        body {
            font-family: var(--pt-font-family);
            overflow-x: hidden;
        }

        select,
        option,
        optgroup,
        input,
        textarea,
        button,
        .btn,
        .form-control,
        .form-select,
        .dropdown-menu,
        .dropdown-item,
        .list-group,
        .list-group-item,
        .list-group-item-action,
        .pt-search-select,
        .pt-search-select *,
        .select2-container,
        .select2-container *,
        .select2-dropdown,
        .select2-dropdown * {
            font-family: var(--pt-font-family) !important;
        }

        select,
        option,
        optgroup,
        .form-select,
        .form-control,
        .pt-search-select__input,
        .pt-search-select__option,
        .pt-search-select__empty,
        .search-dropdown-field .form-control,
        .list-group-item,
        .list-group-item-action,
        .select2-container .select2-selection--single .select2-selection__rendered,
        .select2-container .select2-selection--multiple .select2-selection__choice,
        .select2-results__option,
        .select2-search__field {
            font-size: var(--pt-control-font-size) !important;
            line-height: 1.35 !important;
        }

        .navbar {
            background: linear-gradient(135deg, #1f2933, #111827);
            box-shadow: 0 6px 18px rgba(0,0,0,.35);
            padding: 10px 18px;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 20px;
            letter-spacing: .4px;
            color: #ffb347 !important;
        }

        .navbar-brand:hover { color: #ffd27f !important; }

        /* ===== MENU STYLE ===== */
        .navbar-dark .navbar-nav .nav-link{
            font-weight:600;
            font-size: 14px;
            color:#e5e7eb !important;
            padding:6px 10px !important;
            border-radius:10px;
            transition:all .18s ease-in-out;
            line-height: 1.2;
        }

        /* ✅ Keep top-level nav compact (avoid ugly wrapping) */
        .navbar-dark .navbar-nav .nav-link,
        .navbar-dark .navbar-nav .dropdown-toggle{
            white-space: nowrap;
        }

        /* ✅ If label is long, truncate with ellipsis (still readable on hover) */
        .navbar-dark .navbar-nav .dropdown-toggle{
            max-width: 230px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* ✅ Dropdown items can wrap normally */
        .dropdown-item{
            white-space: normal;
            line-height: 1.25;
        }

        /* ✅ Make dropdown a bit wider for Thai labels */
        .nav-item.dropdown .dropdown-menu{
            min-width: 280px;
        }

        /* ✅ Slightly tighter navbar on small screens */
        @@media (max-width: 992px){
            .navbar { padding: 8px 12px; }
            .navbar-dark .navbar-nav .nav-link{ padding:8px 10px !important; }
            .navbar-dark .navbar-nav .dropdown-toggle{ max-width: none; }
        }

        /* ===== HOVER (แก้ Bootstrap override) ===== */
        .navbar.navbar-dark .navbar-nav .nav-link:hover,
        .navbar.navbar-dark .navbar-nav .nav-link:focus,
        .navbar.navbar-dark .navbar-nav .show > .nav-link{
            background:rgba(20,184,166,.18) !important;
            color:#fff !important;
            transform:translateY(-1px);
        }

        /* ===== ACTIVE PAGE ===== */
        .navbar.navbar-dark .navbar-nav .nav-link.active-menu{
            background:linear-gradient(135deg,var(--pt-accent),var(--pt-accent-dark)) !important;
            color:#fff !important;
            font-weight:700;
        }

        /* ===== DROPDOWN ===== */
        .nav-item.dropdown .dropdown-menu {
            background: #1f2933;
            border-radius: 14px;
            border: 1px solid #2d3748;
            box-shadow: 0 12px 30px rgba(0,0,0,.4);
            padding: 8px;
        }

        .dropdown-item {
            color: #e5e7eb;
            border-radius: 10px;
            padding: 10px 14px;
            transition: all .18s;
        }

        .dropdown-item:hover {
            background: rgba(20,184,166,.18);
            color: #fff;
            font-weight: 600;
        }

        .dropdown-group-title {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px 5px;
            color: #8df1e4;
            font-size: 12px;
            font-weight: 900;
            letter-spacing: .02em;
            text-transform: uppercase;
            opacity: .92;
        }

        .dropdown-group-title:not(:first-child) {
            margin-top: 6px;
            border-top: 1px solid rgba(255, 255, 255, .08);
        }

        .navbar-text {
            background: rgba(255,255,255,.08);
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 600;
        }

        .btn-logout {
            border-radius: 20px;
            padding: 6px 14px;
            font-weight: 600;
            border: 1px solid var(--pt-accent);
            color: var(--pt-accent);
            transition: all .2s;
        }

        .btn-logout:hover {
            background: var(--pt-accent);
            color: #062b2f;
        }

        footer.footer-modern {
            margin-top: 40px;
            background: linear-gradient(135deg, #1f2933, #111827);
            color: #cbd5e1;
            border-top: 1px solid rgba(255,255,255,.08);
            box-shadow: 0 -6px 18px rgba(0,0,0,.12);
        }

        .footer-modern .footer-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 18px 8px;
            flex-wrap: wrap;
        }

        .footer-modern .footer-brand {
            font-size: 14px;
            font-weight: 700;
            color: var(--pt-accent);
        }

        .footer-modern .footer-text {
            font-size: 13px;
            color: #cbd5e1;
        }

        .footer-modern .footer-version {
            background: rgba(255,255,255,.08);
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 12px;
            color: #e5e7eb;
        }

        .system-update-backdrop {
            position: fixed;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 22px;
            background: rgba(2, 12, 32, .68);
            backdrop-filter: blur(10px);
            z-index: 22000;
        }

        .system-update-backdrop.is-open {
            display: flex;
        }

        .system-update-dialog {
            width: min(760px, 100%);
            max-height: min(82vh, 780px);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            border-radius: 30px;
            background: #eef5fb;
            color: #0f1d35;
            box-shadow: 0 28px 70px rgba(0, 0, 0, .38);
            border: 1px solid rgba(255, 255, 255, .55);
        }

        .system-update-head {
            padding: 28px 30px 24px;
            background: linear-gradient(135deg, #102847 0%, #1f4668 52%, #0f766e 100%);
            color: #fff;
        }

        .system-update-eyebrow {
            color: #9bf4e6;
            font-size: 13px;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .system-update-head h2 {
            margin: 6px 0 6px;
            font-size: clamp(28px, 4vw, 42px);
            font-weight: 900;
            letter-spacing: 0;
        }

        .system-update-head p {
            margin: 0;
            max-width: 640px;
            color: rgba(255, 255, 255, .82);
            font-size: 17px;
            font-weight: 700;
            line-height: 1.45;
        }

        .system-update-list {
            padding: 22px;
            overflow: auto;
            display: grid;
            gap: 14px;
        }

        .system-update-item {
            background: #fff;
            border: 1px solid rgba(123, 151, 184, .28);
            border-radius: 20px;
            padding: 18px 20px;
            box-shadow: 0 16px 32px rgba(15, 32, 55, .08);
        }

        .system-update-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 8px;
        }

        .system-update-chip {
            display: inline-flex;
            align-items: center;
            min-height: 28px;
            padding: 4px 12px;
            border-radius: 999px;
            background: rgba(20, 184, 166, .14);
            color: #0f766e;
            font-size: 13px;
            font-weight: 900;
        }

        .system-update-chip.muted {
            background: rgba(100, 116, 139, .12);
            color: #64748b;
        }

        .system-update-item h3 {
            margin: 0 0 6px;
            color: #0f1d35;
            font-size: 22px;
            font-weight: 900;
            line-height: 1.25;
        }

        .system-update-summary {
            margin: 0 0 10px;
            color: #51637a;
            font-weight: 700;
            line-height: 1.5;
        }

        .system-update-details {
            margin: 10px 0 0;
            padding-left: 22px;
            color: #22324a;
            font-size: 16px;
            font-weight: 700;
            line-height: 1.55;
        }

        .system-update-details li + li {
            margin-top: 5px;
        }

        .system-update-actions {
            padding: 0 22px 22px;
        }

        .system-update-ack {
            width: 100%;
            min-height: 58px;
            border: 0;
            border-radius: 18px;
            background: linear-gradient(135deg, var(--pt-accent), var(--pt-accent-dark));
            color: #fff;
            font-size: 20px;
            font-weight: 900;
            box-shadow: 0 18px 34px rgba(20, 184, 166, .24);
        }

        .system-update-ack:hover {
            filter: brightness(1.03);
        }

        .login-followup-backdrop {
            position: fixed;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 22px;
            background: rgba(2, 12, 32, .58);
            backdrop-filter: blur(8px);
            z-index: 21000;
        }

        .login-followup-dialog {
            width: min(860px, 100%);
            max-height: min(84vh, 780px);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            border-radius: 30px;
            background: #eef5fb;
            color: #0f1d35;
            box-shadow: 0 28px 70px rgba(0, 0, 0, .34);
            border: 1px solid rgba(255, 255, 255, .55);
        }

        .login-followup-head {
            display: flex;
            justify-content: space-between;
            gap: 18px;
            padding: 26px 30px 22px;
            background: linear-gradient(135deg, #102847 0%, #1f4668 52%, #0f766e 100%);
            color: #fff;
        }

        .login-followup-eyebrow {
            color: #9bf4e6;
            font-size: 13px;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .login-followup-head h2 {
            margin: 6px 0 6px;
            font-size: clamp(26px, 4vw, 38px);
            font-weight: 900;
            letter-spacing: 0;
        }

        .login-followup-head p {
            margin: 0;
            color: rgba(255, 255, 255, .82);
            font-size: 16px;
            font-weight: 700;
            line-height: 1.45;
        }

        .login-followup-close {
            flex: 0 0 auto;
            width: 46px;
            height: 46px;
            border: 1px solid rgba(255,255,255,.36);
            border-radius: 999px;
            color: #fff;
            background: rgba(255,255,255,.12);
            font-size: 26px;
            line-height: 1;
        }

        .login-followup-summary {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            padding: 16px 22px 0;
        }

        .login-followup-summary span {
            min-height: 66px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2px;
            border-radius: 18px;
            padding: 10px 14px;
            background: #fff;
            border: 1px solid rgba(123, 151, 184, .24);
            box-shadow: 0 10px 22px rgba(15, 32, 55, .06);
            color: #64748b;
            font-weight: 800;
            text-align: center;
        }

        .login-followup-summary strong {
            color: #10233f;
            font-size: 24px;
            font-weight: 900;
            line-height: 1;
        }

        .login-followup-list {
            padding: 16px 22px 22px;
            overflow: auto;
            display: grid;
            gap: 12px;
        }

        .login-followup-item {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 14px;
            align-items: center;
            padding: 16px 18px;
            border-radius: 20px;
            background: #fff;
            border: 1px solid rgba(123, 151, 184, .28);
            border-left: 6px solid #14b8a6;
            box-shadow: 0 16px 32px rgba(15, 32, 55, .08);
            color: #0f1d35;
            text-decoration: none;
        }

        .login-followup-item:hover {
            color: #0f1d35;
            transform: translateY(-1px);
            box-shadow: 0 20px 38px rgba(15, 32, 55, .12);
        }

        .login-followup-item.is-overdue {
            border-left-color: #f43f5e;
        }

        .login-followup-item.is-today {
            border-left-color: #f59e0b;
        }

        .login-followup-content {
            min-width: 0;
        }

        .login-followup-title {
            margin: 0;
            font-size: 18px;
            font-weight: 900;
            line-height: 1.35;
        }

        .login-followup-meta {
            display: grid;
            gap: 3px;
            margin-top: 8px;
            color: #64748b;
            font-size: 14px;
            font-weight: 800;
            line-height: 1.35;
        }

        .login-followup-meta > span {
            display: block;
            overflow-wrap: anywhere;
        }

        .login-followup-chip {
            display: inline-flex;
            align-items: center;
            justify-content: flex-end;
            min-width: 104px;
            padding: 0;
            border-radius: 0;
            background: transparent;
            color: #0f766e;
            font-size: 15px;
            font-weight: 900;
            text-align: right;
            white-space: nowrap;
        }

        .login-followup-chip.danger {
            background: transparent;
            color: #be123c;
        }

        .login-followup-chip.warning {
            background: transparent;
            color: #b45309;
        }

        .login-followup-empty {
            margin: 16px 22px 22px;
            padding: 28px 18px;
            border: 1px dashed #cbd5e1;
            border-radius: 20px;
            background: #fff;
            color: #64748b;
            text-align: center;
            font-weight: 900;
        }

        .login-followup-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            justify-content: flex-end;
            padding: 16px 22px 22px;
            border-top: 1px solid rgba(123, 151, 184, .16);
            background: rgba(238, 245, 251, .92);
        }

        .login-followup-actions .btn {
            min-height: 44px;
            min-width: 138px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            padding: 0 20px;
            font-weight: 900;
            line-height: 1;
        }

        .login-followup-actions .btn-outline-secondary {
            border-color: #94a3b8;
            color: #10233f;
            background: rgba(255,255,255,.72);
        }

        .login-followup-actions .btn-primary {
            min-width: 164px;
            border: 0;
            color: #fff;
            background: linear-gradient(135deg, #14b8a6, #0f766e);
            box-shadow: 0 12px 22px rgba(20, 184, 166, .2);
        }

        @@media (max-width: 640px) {
            .system-update-backdrop {
                padding: 12px;
            }

            .system-update-dialog,
            .login-followup-dialog {
                border-radius: 24px;
                max-height: 90vh;
            }

            .system-update-head,
            .system-update-list,
            .system-update-actions,
            .login-followup-head,
            .login-followup-list,
            .login-followup-actions {
                padding-left: 16px;
                padding-right: 16px;
            }

            .system-update-item h3,
            .login-followup-title {
                font-size: 19px;
            }

            .login-followup-backdrop {
                padding: 12px;
            }

            .login-followup-summary {
                grid-template-columns: 1fr;
                padding-left: 16px;
                padding-right: 16px;
            }

            .login-followup-item {
                grid-template-columns: 1fr;
            }

            .login-followup-actions {
                flex-direction: column-reverse;
            }

            .login-followup-actions .btn {
                width: 100%;
            }
        }

        @@media (max-width:768px){
            .footer-modern .footer-content {
                justify-content: center;
                text-align: center;
            }
        }

        .nav-count-badge{
            float:right;
            min-width:20px;
            height:20px;
            border-radius:999px;
            display:inline-flex;
            align-items:center;
            justify-content:center;
            margin-left:8px;
            padding:0 7px;
            background:#dc3545;
            color:#fff;
            font-size:11px;
            line-height:20px;
            font-weight:800;
        }
        /* ===== V2 DASHBOARD LAYOUT ===== */
.v2-shell{
    display:flex;
    min-height:100vh;
    background:#eef3f9;
}

.v2-sidebar{
    width:280px;
    background:linear-gradient(180deg,#02173c 0%, #062356 55%, #03132d 100%);
    position:fixed;
    left:0;
    top:0;
    height:100vh;
    overflow:hidden;
    color:#fff;
    z-index:1000;
    border-top-right-radius:34px;
    border-bottom-right-radius:34px;
    box-shadow:10px 0 30px rgba(0,0,0,.22);
    padding-bottom:0;
}

.v2-sidebar .container-fluid{
    display:flex !important;
    flex-direction:column !important;
    align-items:stretch !important;
    width:100%;
    padding:0 !important;
}

.v2-profile-card{
    text-align:center;
    padding:22px 24px 18px;
}

.v2-avatar{
    width:150px;
    height:150px;
    border-radius:50%;
    margin:0 auto 18px;
    border:5px solid rgba(255,255,255,.18);
    box-shadow:0 16px 36px rgba(0,0,0,.35);
    overflow:hidden;
    background:#0f172a;
}

.v2-profile-name{
    font-size:20px;
    font-weight:800;
    color:#fff;
    line-height:1.35;
    margin-bottom:4px;
}

.v2-profile-role{
    color:#d8e2f1;
    font-size:16px;
    font-weight:500;
}

.v2-online-badge{
    margin-top:10px;
    display:inline-block;
    background:rgba(16,185,129,.18);
    color:#86efac;
    padding:8px 16px;
    border-radius:999px;
    font-size:14px;
    font-weight:700;
}

.sidebar-logo{
    display:flex;
    align-items:center;
    gap:14px;
    margin:8px 18px 26px;
    padding:0 12px;
    color:white;
}

.sidebar-logo-icon{
    width:58px;
    height:58px;
    border-radius:18px;
    background:linear-gradient(135deg,#22d3ee,#14b8a6);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:28px;
    box-shadow:0 10px 24px rgba(20,184,166,.28);
}

.sidebar-logo-text{
    font-size:22px;
    font-weight:800;
    white-space:nowrap;
}

.v2-sidebar header{
    padding-top:8px;
}

.v2-page{
    flex:1;
    margin-left:280px;
    width:calc(100% - 280px);
    max-width:calc(100vw - 280px);
    min-width:0;
    padding:10px 24px 16px;
}

.v2-page .container{
    max-width:100%;
    min-width:0;
    padding:0;
}

.navbar{
    background:transparent !important;
    box-shadow:none !important;
    display:block !important;
    padding:18px !important;
}

.navbar-collapse{
    display:block !important;
    width:100%;
}

/* ===== LEFT MENU LIKE REFERENCE ===== */
.navbar-nav{
    display:flex !important;
    flex-direction:column !important;
    width:100%;
    gap:6px;
    margin:0 !important;
    padding:8px 14px 18px !important;
}

.nav-item{
    width:100%;
}

.navbar-dark .navbar-nav .nav-link,
.navbar-dark .navbar-nav .dropdown-toggle{
    width:100%;
    min-height:52px;
    display:flex;
    align-items:center;
    justify-content:flex-start;
    padding:13px 18px !important;
    border-radius:18px;
    font-size:15px;
    font-weight:600;
    color:#ffffff !important;
    background:transparent;
    transition:all .2s ease;
}

.navbar-dark .navbar-nav .nav-link:hover,
.navbar-dark .navbar-nav .show > .nav-link{
    background:rgba(255,255,255,.06) !important;
    color:#fff !important;
}

.navbar-dark .navbar-nav .nav-link.active-menu{
    background:linear-gradient(135deg,var(--pt-accent),var(--pt-accent-dark)) !important;
    color:#fff !important;
    box-shadow:0 12px 26px var(--pt-accent-glow);
}

.dropdown-toggle::after{
    margin-left:auto !important;
    opacity:.8;
}

.dropdown-menu{
    position:relative !important;
    z-index:3;
    inset:auto !important;
    transform:none !important;
    width:100%;
    background:transparent !important;
    border:none !important;
    border-radius:0 !important;
    margin:0 !important;
    padding:4px 0 8px 18px !important;
}

.dropdown-item{
    color:#cfd9ea !important;
    font-size:13px;
    font-weight:500;

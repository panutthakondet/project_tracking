<aside class="requirement-card-popup requirement-card-note" id="RequirementCardDetailModal" aria-hidden="true">
    <div class="requirement-card-note__panel">
        <div class="requirement-card-popup__header" id="RequirementCardDetailHeader">
            <div class="requirement-card-popup__heading">
                <div class="requirement-card-popup__eyebrow" id="RequirementCardDetailEyebrow">Project Card</div>
                <h5 class="requirement-card-popup__title" id="RequirementCardDetailTitle">-</h5>
                <div class="requirement-card-popup__meta" id="RequirementCardDetailMeta">-</div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-requirement-card-close aria-label="Close"></button>
        </div>
        <div class="requirement-card-popup__body requirement-card-note__body">
            <section class="requirement-card-popup__section">

                    <h6 class="requirement-card-popup__label mb-0">ส่วนงาน/งวดงาน</h6>
                    <span class="requirement-card-popup__count" id="RequirementCardPhaseCount">0</span>
                </div>
                <div class="requirement-card-popup__phases" id="RequirementCardPhaseList"></div>
            </section>

            <section class="requirement-card-popup__section">
                <div class="requirement-card-popup__section-head">
                    <h6 class="requirement-card-popup__label mb-0">ไฟล์แนบ</h6>
                    <span class="requirement-card-popup__count" id="RequirementCardAttachmentCount">0</span>
                </div>

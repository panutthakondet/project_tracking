# Security worker build: allow only source files required by deploy/security/Dockerfile.
# Environment files, credentials, uploads, reports and repository metadata never enter the context.
**
!SecurityWorker/
!SecurityWorker/*.cs
!SecurityWorker/SecurityWorker.csproj
!Services/
!Services/Security/
!Services/Security/SecurityContracts.cs
!deploy/
!deploy/security/
!deploy/security/Dockerfile
# macOS AppleDouble metadata can match the source allowlist above.
**/._*
**/.DS_Store

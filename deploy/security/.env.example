SECURITY_APP_URL=https://tracking.example.com/
SECURITY_WORKER_KEY=REPLACE_WITH_RANDOM_KEY_AT_LEAST_32_CHARACTERS
ZAP_API_KEY=REPLACE_WITH_ANOTHER_RANDOM_KEY
MOBSF_API_KEY=REPLACE_WITH_ANOTHER_RANDOM_KEY
# Legacy API fallback only; new workers use project-approved hosts supplied with each job.
SECURITY_ALLOWED_HOSTS=
SECURITY_ALLOW_PRIVATE_TARGETS=false
SECURITY_ALLOW_ACTIVE=false
# Pin tested tags or image digests before production use:
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
MOBSF_IMAGE=opensecurity/mobile-security-framework-mobsf:latest
